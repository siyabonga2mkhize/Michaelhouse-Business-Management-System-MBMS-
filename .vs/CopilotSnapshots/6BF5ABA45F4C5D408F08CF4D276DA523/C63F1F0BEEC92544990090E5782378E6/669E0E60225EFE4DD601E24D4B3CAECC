        /// <summary>
        /// Creates a new assessment. Validates:
        ///   1. Teacher is assigned to this subject+grade.
        ///   2. Total weighting for subject+grade+term does not exceed 100%.
        /// </summary>
        public (bool Success, string Error, Assessment Assessment) CreateAssessment(
            int teacherId,
            int subjectId,
            int grade,
            AcademicStream stream,
            string title,
            string assessmentType,
            int term,
            int academicYear,
            DateTime scheduledDate,
            decimal totalMarks,
            decimal weightingPercent,
            string notes)
        {
            using (var db = new DBContextClass())
            {
                // 1. Verify teacher owns this subject+grade assignment
                var assignment = db.TeacherSubjectGrades.FirstOrDefault(tsg =>
                    tsg.TeacherId == teacherId &&
                    tsg.SubjectId == subjectId &&
                    tsg.Grade == grade);

                if (assignment == null)
                    return (false, "You are not assigned to teach this subject and grade.", null);

                // 2. Check weighting cap for the term
                var existingWeighting = db.Assessments
                    .Where(a =>
                        a.SubjectId == subjectId &&
                        a.Grade == grade &&
                        a.Term == term &&
                        a.AcademicYear == academicYear &&
                        a.Stream == stream)
                    .Sum(a => (decimal?)a.WeightingPercent) ?? 0m;

                if (existingWeighting + weightingPercent > 100m)
                    return (false,
                        $"Adding {weightingPercent}% would exceed 100% for Term {term}. " +
                        $"Currently used: {existingWeighting}%.", null);

                var assessment = new Assessment
                {
                    TeacherId = teacherId,
                    SubjectId = subjectId,
                    Grade = grade,
                    Stream = stream,
                    Title = title,
                    AssessmentType = assessmentType,
                    Term = term,
                    AcademicYear = academicYear,
                    ScheduledDate = scheduledDate,
                    TotalMarks = totalMarks,
                    WeightingPercent = weightingPercent,
                    Notes = notes,
                    CreatedAt = DateTime.Now
                };

                db.Assessments.Add(assessment);
                db.SaveChanges();

                return (true, null, assessment);
            }
        }

        /// <summary>
        /// Returns all assessments for the subjects+grades a teacher is assigned to.
        /// </summary>
        public List<Assessment> GetAssessmentsForTeacher(int teacherId, int? year = null)
        {
            int targetYear = year ?? DateTime.Now.Year;

            using (var db = new DBContextClass())
            {
                // Get all subject+grade combos this teacher teaches
                var assignments = db.TeacherSubjectGrades
                    .Where(tsg => tsg.TeacherId == teacherId)
                    .Select(tsg => new { tsg.SubjectId, tsg.Grade })
                    .ToList();

                var subjectIds = assignments.Select(a => a.SubjectId).ToList();
                var grades = assignments.Select(a => a.Grade).ToList();

                return db.Assessments
                    .Include("Subject")
                    .Where(a =>
                        a.TeacherId == teacherId &&
                        a.AcademicYear == targetYear)
                    .OrderBy(a => a.Term)
                    .ThenBy(a => a.ScheduledDate)
                    .ToList();
            }
        }


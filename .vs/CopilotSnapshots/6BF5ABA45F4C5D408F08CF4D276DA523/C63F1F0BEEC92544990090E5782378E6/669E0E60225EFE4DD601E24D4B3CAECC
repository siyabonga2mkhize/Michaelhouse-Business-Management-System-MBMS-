        public List<StudentMarkEntry> GetMarkSheet(int assessmentId)
        {
            using (var db = new DBContextClass())
            {
                // 1. Eager load the Subject and ensure we don't track for speed
                var assessment = db.Assessments
                    .Include("Subject")
                    .AsNoTracking()
                    .FirstOrDefault(a => a.AssessmentId == assessmentId);

                if (assessment == null) return new List<StudentMarkEntry>();

                // 2. Find students taking this subject in this grade using Student.GradeLevel
                var studentSubjects = db.StudentSubjects
                    .Include(ss => ss.Student)
                    .Where(ss => ss.SubjectId == assessment.SubjectId && ss.Student.GradeLevel == assessment.Grade)
                    .ToList();

                // 4. Filter by stream if the assessment is stream-specific
                if (assessment.Stream != AcademicStream.None)
                {
                    studentSubjects = studentSubjects
                        .Where(ss => ss.Stream == assessment.Stream)
                        .ToList();
                }

                // 5. Load existing marks to a dictionary for O(1) lookup
                var existingMarks = db.StudentMarks
                    .AsNoTracking()
                    .Where(sm => sm.AssessmentmentId == assessmentId)
                    .ToDictionary(sm => sm.StudentId);

                // 6. Map to DTO
                return studentSubjects.Select(ss =>
                {
                    existingMarks.TryGetValue(ss.StudentId, out var mark);
                    return new StudentMarkEntry
                    {
                        StudentId = ss.StudentId,
                        // FIX: Use FirstName/LastName explicitly to bypass Proxy issues
                        StudentName = $"{ss.Student.FirstName} {ss.Student.LastName}".Trim(),
                        MarksObtained = mark?.MarksObtained,
                        IsAbsent = mark?.IsAbsent ?? false,
                        TeacherComment = mark?.TeacherComment,
                        AlreadyCaptured = mark != null
                    };
                })
                .OrderBy(e => e.StudentName)
                .ToList();
            }
        }

        /// <summary>
        /// Saves a batch of marks for an assessment.
        /// Only the teacher assigned to this assessment may call this.
        /// </summary>
        public (bool Success, string Error) SaveMarks(
            int assessmentId,
            int teacherId,
            List<MarkInput> inputs,
            bool closeCaptrue = false)
        {
            using (var db = new DBContextClass())
            {
                var assessment = db.Assessments.Find(assessmentId);
                if (assessment == null) return (false, "Assessment not found.");
                if (assessment.TeacherId != teacherId)
                    return (false, "You are not authorised to capture marks for this assessment.");
                if (assessment.MarksCaptureClosed)
                    return (false, "Mark capture for this assessment has been closed.");

                foreach (var input in inputs)
                {
                    // Validate mark range
                    if (input.MarksObtained.HasValue &&
                        (input.MarksObtained < 0 || input.MarksObtained > assessment.TotalMarks))
                        return (false,
                            $"Mark {input.MarksObtained} for student {input.StudentId} " +
                            $"is out of range (0 – {assessment.TotalMarks}).");

                    var existing = db.StudentMarks.FirstOrDefault(sm =>
                        sm.AssessmentmentId == assessmentId &&
                        sm.StudentId == input.StudentId);

                    if (existing == null)
                    {
                        db.StudentMarks.Add(new StudentMark
                        {
                            AssessmentmentId = assessmentId,
                            StudentId = input.StudentId,
                            MarksObtained = input.IsAbsent ? (decimal?)null : input.MarksObtained,
                            IsAbsent = input.IsAbsent,
                            TeacherComment = input.Comment,
                            CapturedAt = DateTime.Now
                        });
                    }
                    else
                    {
                        existing.MarksObtained = input.IsAbsent ? (decimal?)null : input.MarksObtained;
                        existing.IsAbsent = input.IsAbsent;
                        existing.TeacherComment = input.Comment;
                        existing.CapturedAt = DateTime.Now;
                    }
                }

                if (closeCaptrue)
                    assessment.MarksCaptureClosed = true;

                db.SaveChanges();
                return (true, null);
            }
        }

        // ─── Term Mark Calculation ────────────────────────────────────────────────

        /// <summary>
        /// Calculates and persists the term mark for every student in
        /// a given subject+grade+term. Returns a summary of results.
        /// Call after all mark capture for the term is complete.
        /// </summary>
        public List<TermResult> CalculateTermResults(
            int subjectId, int grade, int term, int academicYear,
            AcademicStream stream = AcademicStream.None)
        {
            using (var db = new DBContextClass())
            {
                // All closed assessments for this subject+grade+term
                var assessments = db.Assessments
                    .Where(a =>
                        a.SubjectId == subjectId &&
                        a.Grade == grade &&
                        a.Term == term &&
                        a.AcademicYear == academicYear &&
                        a.Stream == stream)
                    .ToList();

                if (!assessments.Any()) return new List<TermResult>();

                var assessmentIds = assessments.Select(a => a.AssessmentId).ToList();

                // All marks for these assessments
                var allMarks = db.StudentMarks
                    .Where(sm => assessmentIds.Contains(sm.AssessmentmentId))
                    .ToList();

                // Distinct students who have at least one mark
                var studentIds = allMarks.Select(m => m.StudentId).Distinct().ToList();

                var results = new List<TermResult>();

                foreach (var studentId in studentIds)
                {
                    decimal weightedSum = 0m;
                    decimal weightUsed = 0m;

                    foreach (var assessment in assessments)
                    {
                        var mark = allMarks.FirstOrDefault(m =>
                            m.StudentId == studentId &&
                            m.AssessmentmentId == assessment.AssessmentId);

                        // Absent students: exclude this assessment's weighting
                        if (mark == null || mark.IsAbsent) continue;
                        if (!mark.MarksObtained.HasValue) continue;

                        // Convert raw mark to percentage, then apply weighting
                        decimal pct = (mark.MarksObtained.Value / assessment.TotalMarks) * 100m;
                        weightedSum += pct * (assessment.WeightingPercent / 100m);
                        weightUsed += assessment.WeightingPercent;
                    }

                    // Re-normalise if student missed some assessments
                    decimal termMark = weightUsed > 0
                        ? Math.Round((weightedSum / weightUsed) * 100m, 2)
                        : 0m;

                    // Upsert TermResult
                    var termResult = db.TermResults.FirstOrDefault(tr =>
                        tr.StudentId == studentId &&
                        tr.SubjectId == subjectId &&
                        tr.Grade == grade &&
                        tr.Term == term &&
                        tr.AcademicYear == academicYear);

                    if (termResult == null)
                    {
                        termResult = new TermResult
                        {
                            StudentId = studentId,
                            SubjectId = subjectId,
                            Grade = grade,
                            Term = term,
                            AcademicYear = academicYear
                        };
                        db.TermResults.Add(termResult);
                    }

                    termResult.TermMarkPercent = termMark;
                    termResult.Symbol = GetSymbol(termMark);
                    termResult.Passed = termMark >= 40m;
                    termResult.CalculatedAt = DateTime.Now;

                    results.Add(termResult);
                }

                db.SaveChanges();
                return results;
            }
        }

        // ─── Year-End Promotion ───────────────────────────────────────────────────

        /// <summary>
        /// Calculates the year-end result for a student and saves a YearResult.
        /// Promotion rule: student must pass (≥ 40%) in at least 5 of their subjects
        /// across all 4 terms (average of the 4 term marks per subject).
        /// Admin can override the decision with notes.
        /// </summary>
        public YearResult CalculateYearResult(int studentId, int grade, int academicYear)
        {
            using (var db = new DBContextClass())
            {
                var termResults = db.TermResults
                    .Where(tr =>
                        tr.StudentId == studentId &&
                        tr.Grade == grade &&
                        tr.AcademicYear == academicYear)
                    .ToList();

                if (!termResults.Any()) return null;

                // Group by subject — average across all 4 terms
                var subjectAverages = termResults
                    .GroupBy(tr => tr.SubjectId)
                    .Select(g => new
                    {
                        SubjectId = g.Key,
                        Average = g.Average(tr => tr.TermMarkPercent)
                    })
                    .ToList();

                int subjectsPassed = subjectAverages.Count(s => s.Average >= 40m);
                decimal overallAvg = subjectAverages.Any()
                    ? Math.Round(subjectAverages.Average(s => s.Average), 2)
                    : 0m;

                // Standard SA promotion: must pass ≥ 5 subjects
                bool promoted = subjectsPassed >= 5;

                var yearResult = db.YearResults.FirstOrDefault(yr =>
                    yr.StudentId == studentId &&
                    yr.Grade == grade &&
                    yr.AcademicYear == academicYear);

                if (yearResult == null)
                {
                    yearResult = new YearResult
                    {
                        StudentId = studentId,
                        Grade = grade,
                        AcademicYear = academicYear
                    };
                    db.YearResults.Add(yearResult);
                }

                yearResult.OverallPercent = overallAvg;
                yearResult.PromotionStatus = promoted ? "Promoted" : "Retained";
                yearResult.CalculatedAt = DateTime.Now;

                db.SaveChanges();
                return yearResult;
            }
        }

        // ─── Student-facing queries ───────────────────────────────────────────────

        /// <summary>
        /// Returns all assessments and marks for a student, grouped by term.
        /// Used by the student dashboard.
        /// </summary>
        public StudentProgressReport GetStudentProgress(
            int studentId, int academicYear)
        {
            using (var db = new DBContextClass())
            {
                var student = db.Students.Find(studentId);
                if (student == null) return null;

                // Subjects this student is enrolled in
                var subjectIds = db.StudentSubjects
                    .Where(ss => ss.StudentId == studentId)
                    .Select(ss => ss.SubjectId)
                    .ToList();

                int grade = 0;
                int.TryParse(student.CurrentGrade, out grade);

                // Assessments for this student's grade+subjects
                var assessments = db.Assessments
                    .Include("Subject")
                    .Where(a =>
                        a.AcademicYear == academicYear &&
                        a.Grade == grade &&
                        subjectIds.Contains(a.SubjectId))
                    .OrderBy(a => a.Term)
                    .ThenBy(a => a.ScheduledDate)
                    .ToList();

                var assessmentIds = assessments.Select(a => a.AssessmentId).ToList();

                var marks = db.StudentMarks
                    .Where(sm =>
                        sm.StudentId == studentId &&
                        assessmentIds.Contains(sm.AssessmentmentId))
                    .ToDictionary(sm => sm.AssessmentmentId);

                var termResults = db.TermResults
                    .Include("Subject")
                    .Where(tr =>
                        tr.StudentId == studentId &&
                        tr.AcademicYear == academicYear)
                    .ToList();

                return new StudentProgressReport
                {
                    Student = student,
                    AcademicYear = academicYear,
                    Assessments = assessments,
                    Marks = marks,
                    TermResults = termResults
                };
            }
        }

        // ─── Helpers ─────────────────────────────────────────────────────────────

        private static string GetSymbol(decimal percent)
        {
            if (percent >= 80) return "A";
            if (percent >= 70) return "B";
            if (percent >= 60) return "C";
            if (percent >= 50) return "D";
            if (percent >= 40) return "E";
            return "F";
        }
    }


<?xml version="1.0" encoding="utf-8" ?>
<!-- UC18 — My Events: the events the logged-in student / parent / staff
     member is invited to (web: Rsvp/MyEvents). Tap one to RSVP
     (EventRsvpPage). Built in RsvpPage.xaml.cs. -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MhmsMobileApp.Views.RsvpPage"
             Title="My Events">

    <RefreshView x:Name="Refresher" Refreshing="OnRefreshing">
        <ScrollView>
            <VerticalStackLayout x:Name="Root" Padding="16,20,16,24" Spacing="14">
                <ActivityIndicator IsRunning="True" Margin="0,40,0,0" />
            </VerticalStackLayout>
        </ScrollView>
    </RefreshView>

</ContentPage>

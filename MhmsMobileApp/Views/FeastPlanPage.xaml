<?xml version="1.0" encoding="utf-8" ?>
<!-- Feast Plan — same look as the web's Event/FeastPlan: eyebrow header,
     stat tiles, dietary notes, timeline, dishes and ingredient totals.
     Cards sit 2–3 per row on wide screens (AdaptiveGrid). -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MhmsMobileApp.Views.FeastPlanPage"
             Title="Feast Plan">

    <Grid RowDefinitions="Auto,*">

        <ActivityIndicator x:Name="LoadingSpinner"
                           Grid.Row="0"
                           IsRunning="True"
                           IsVisible="True"
                           Margin="0,40,0,0" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout x:Name="ContentStack" Spacing="14" IsVisible="False">

                <ContentView x:Name="HeaderHost" />
                <ContentView x:Name="ErrorHost" IsVisible="False" />
                <ContentView x:Name="StatsHost" />
                <ContentView x:Name="DietaryHost" />

                <Label Text="Production timeline" Style="{StaticResource FieldLabel}" Margin="0,6,0,0" />
                <ContentView x:Name="TimelineHost" />

                <Label Text="Dishes" Style="{StaticResource FieldLabel}" Margin="0,6,0,0" />
                <ContentView x:Name="DishesHost" />

                <ContentView x:Name="IngredientsHost" Margin="0,6,0,0" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>

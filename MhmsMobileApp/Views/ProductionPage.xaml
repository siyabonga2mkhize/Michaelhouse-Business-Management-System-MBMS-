<?xml version="1.0" encoding="utf-8" ?>
<!-- Kitchen Plan — same look as the web's Cafeteria/ProductionPlan:
     eyebrow header, stat tiles, a black-bar section per day, ingredient
     totals. Days sit side by side on wide screens (AdaptiveGrid). -->
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MhmsMobileApp.Views.ProductionPage"
             Title="Kitchen Plan">

    <Grid RowDefinitions="Auto,*">

        <ActivityIndicator x:Name="LoadingSpinner"
                           Grid.Row="0"
                           IsRunning="True"
                           IsVisible="True"
                           Margin="0,40,0,0" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout x:Name="ContentStack" Spacing="14" IsVisible="False">

                <ContentView x:Name="ErrorHost" IsVisible="False" />

                <ContentView x:Name="HeaderHost" />

                <ContentView x:Name="StatsHost" />

                <Label Text="Daily schedule" Style="{StaticResource FieldLabel}" Margin="0,6,0,0" />

                <ContentView x:Name="DaysHost" />

                <ContentView x:Name="IngredientsHost" Margin="0,6,0,0" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>

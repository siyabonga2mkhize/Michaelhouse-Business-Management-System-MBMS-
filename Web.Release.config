<?xml version="1.0"?>
<!-- Release publish transform. Local runs use LocalDB (Web.config); published builds use the Azure database below. -->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <connectionStrings>
    <add name="MichaelHouse"
         connectionString="Server=tcp:michealhouseserver.database.windows.net,1433;Initial Catalog=michealhousedatabase;Persist Security Info=False;User ID=michealAdmin;Password=4thVisionIV;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
         providerName="System.Data.SqlClient"
         xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
  </connectionStrings>
  <system.web>
    <compilation xdt:Transform="RemoveAttributes(debug)" />
    <!-- customErrors stays Off (from Web.config) so a failing page shows the real error text -->
  </system.web>
</configuration>
@using Michaelhouse.Services
@using Michaelhouse.Models.Cafeteria
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Cafeteria Inventory";

    var summary = ViewBag.Summary as InventorySummary ?? new InventorySummary();
    var low = ViewBag.LowStock as List<IngredientStockLine> ?? new List<IngredientStockLine>();
    var upcoming = ViewBag.Upcoming as List<UpcomingRequirement> ?? new List<UpcomingRequirement>();
    var orders = ViewBag.Orders as List<IngredientPurchaseOrder> ?? new List<IngredientPurchaseOrder>();
    bool isManager = ViewBag.IsManager == true;
}

@Html.Partial("_InventoryStyles")

<div class="container-fluid py-4">
    <div class="inv-shell">

        <div class="inv-header">
            <div>
                <h1>Cafeteria Inventory</h1>
                <div class="inv-meta">Ingredient stock, upcoming kitchen needs and purchase orders.</div>
            </div>
            @if (isManager)
            {
                <div class="inv-actions">
                    <a href="@Url.Action("Create", "IngredientOrder")" class="btn btn-primary">Place Stock Order</a>
                    <a href="@Url.Action("Record", "IngredientDelivery")" class="btn btn-outline-secondary">Record Delivery</a>
                </div>
            }
        </div>

        <!-- SUMMARY -->
        <div class="inv-stats">
            <a class="inv-stat" href="@Url.Action("Stock", "CafeteriaInventory")">
                <div class="label">Ingredients</div>
                <div class="value">@summary.TotalIngredients</div>
            </a>
            <a class="inv-stat @(summary.LowStock > 0 ? "warn" : "")" href="@Url.Action("Stock", "CafeteriaInventory", new { filter = "low" })">
                <div class="label">Low stock</div>
                <div class="value">@summary.LowStock</div>
            </a>
            <a class="inv-stat @(summary.OutOfStock > 0 ? "bad" : "")" href="@Url.Action("Stock", "CafeteriaInventory", new { filter = "out" })">
                <div class="label">Out of stock</div>
                <div class="value">@summary.OutOfStock</div>
            </a>
            <a class="inv-stat @(summary.UpcomingShortages > 0 ? "bad" : "")" href="#upcoming">
                <div class="label">Upcoming shortages</div>
                <div class="value">@summary.UpcomingShortages</div>
            </a>
            <a class="inv-stat" href="@Url.Action("Index", "IngredientOrder")">
                <div class="label">Open orders</div>
                <div class="value">@summary.PendingOrders</div>
            </a>
            <a class="inv-stat" href="@Url.Action("Index", "IngredientDelivery")">
                <div class="label">Expected deliveries</div>
                <div class="value">@summary.ExpectedDeliveries</div>
            </a>
        </div>

        <!-- UPCOMING KITCHEN SHORTAGES -->
        <div class="inv-card" id="upcoming">
            <h2>Upcoming kitchen shortages (next 14 days)</h2>
            <div class="inv-help" style="margin:-.4rem 0 .75rem 0;">
                From kitchen plans built on students' meal choices and closed event RSVPs, not yet issued — compared with what's in stock now.
                This is separate from low stock: an ingredient can be above its reorder level and still not cover what's planned.
            </div>
            @if (upcoming.Count == 0)
            {
                <div class="inv-note ok">✓ Stock covers every upcoming kitchen plan.</div>
            }
            else
            {
                <div class="inv-table-wrap">
                    <table class="inv-table">
                        <thead>
                            <tr>
                                <th>Ingredient</th>
                                <th class="num">Required</th>
                                <th class="num">Available</th>
                                <th class="num">Shortfall</th>
                                <th class="num inv-hide-sm">On order</th>
                                <th class="inv-hide-sm">Needed for</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var u in upcoming)
                            {
                                <tr>
                                    <td><a href="@Url.Action("Ingredient", "CafeteriaInventory", new { id = u.Ingredient.Id })">@u.Ingredient.Name</a></td>
                                    <td class="num">@IngredientUnits.Format(u.Required, u.Ingredient.Unit)</td>
                                    <td class="num">@IngredientUnits.Format(u.Available, u.Ingredient.Unit)</td>
                                    <td class="num"><span class="inv-badge bad">@IngredientUnits.Format(u.Shortfall, u.Ingredient.Unit)</span></td>
                                    <td class="num inv-hide-sm">
                                        @IngredientUnits.Format(u.OnOrder, u.Ingredient.Unit)
                                        @if (u.OnOrder > 0m && u.ShortfallAfterOrders <= 0m)
                                        {
                                            <div class="inv-help">covered once delivered</div>
                                        }
                                    </td>
                                    <td class="inv-hide-sm inv-muted" style="font-size:.78rem;">@string.Join(", ", u.NeededFor)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

        <!-- LOW STOCK -->
        <div class="inv-card">
            <h2>Low stock (at or below reorder level)</h2>
            @if (low.Count == 0)
            {
                <div class="inv-note ok">✓ No ingredient is at or below its reorder level.</div>
            }
            else
            {
                <div class="inv-table-wrap">
                    <table class="inv-table">
                        <thead>
                            <tr>
                                <th>Ingredient</th>
                                <th class="num">Current</th>
                                <th class="num">Reorder level</th>
                                <th>Status</th>
                                <th class="num inv-hide-sm">On order</th>
                                <th class="inv-hide-sm">Supplier</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var l in low)
                            {
                                <tr>
                                    <td><a href="@Url.Action("Ingredient", "CafeteriaInventory", new { id = l.Ingredient.Id })">@l.Ingredient.Name</a></td>
                                    <td class="num">@IngredientUnits.Format(l.Available, l.Ingredient.Unit)</td>
                                    <td class="num">@IngredientUnits.Format(l.ReorderLevel, l.Ingredient.Unit)</td>
                                    <td><span class="inv-badge @(l.IsOutOfStock ? "bad" : "low")">@l.Status</span></td>
                                    <td class="num inv-hide-sm">@IngredientUnits.Format(l.OnOrder, l.Ingredient.Unit)</td>
                                    <td class="inv-hide-sm">@(l.PreferredSupplier ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                if (isManager)
                {
                    <div class="inv-actions" style="margin-top:.75rem;">
                        <a href="@Url.Action("Create", "IngredientOrder")" class="btn btn-sm btn-primary">Order these</a>
                    </div>
                }
            }
        </div>

        <!-- PURCHASE ORDERS -->
        <div class="inv-card">
            <h2>Open purchase orders</h2>
            @if (orders.Count == 0)
            {
                <div class="inv-muted" style="font-size:.85rem;">No open orders.</div>
            }
            else
            {
                <div class="inv-table-wrap">
                    <table class="inv-table">
                        <thead>
                            <tr>
                                <th>Order</th>
                                <th>Supplier</th>
                                <th class="inv-hide-sm">Order date</th>
                                <th>Status</th>
                                <th>Expected</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var o in orders)
                            {
                                <tr>
                                    <td>
                                        @if (isManager)
                                        {
                                            <a href="@Url.Action("Details", "IngredientOrder", new { id = o.Id })">@o.PoNumber</a>
                                        }
                                        else
                                        {
                                            @o.PoNumber
                                        }
                                    </td>
                                    <td>@(o.Supplier != null ? o.Supplier.Name : "")</td>
                                    <td class="inv-hide-sm">@o.OrderDate.ToString("dd MMM yyyy")</td>
                                    <td>@Html.Partial("_OrderStatusBadge", o.Status)</td>
                                    <td>@(o.RequestedDeliveryDate.HasValue ? o.RequestedDeliveryDate.Value.ToString("ddd dd MMM") : "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>

    </div>
</div>

@model List<Michaelhouse.Models.TripSchedule>
@{
    ViewBag.Title = "Assigned Excursions";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

@* --- FULL SCREEN VIEWPORT CONTAINER --- *@
<div class="flex flex-col h-full w-full overflow-hidden">

    @* --- INSTITUTIONAL HEADER --- *@
    <div class="mb-8 d-flex justify-content-between align-items-end border-b border-gray-100 pb-6 flex-shrink-0 px-8 pt-8">
        <div>
            <div class="flex items-center gap-2 mb-3">
                <div class="h-[2px] w-8 bg-[#C21E2E]"></div>
                <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Personnel Portal</h5>
            </div>
            <h2 class="text-5xl font-serif font-bold text-gray-900 tracking-tight">Assigned Excursions</h2>
            <p class="text-[11px] font-mono text-gray-400 uppercase tracking-widest mt-2 mb-0">Active Logistical Deployments</p>
        </div>
        <div class="flex gap-3">
            <a href="@Url.Action("Dashboard", "Driver")" class="inline-block bg-white border border-gray-200 px-6 py-2 text-[9px] font-bold uppercase tracking-[2px] hover:bg-gray-50 transition-all shadow-sm text-gray-600">
                <i class="bi bi-arrow-left me-2"></i> Portal Home
            </a>
        </div>
    </div>

    @* --- SCROLLABLE DATA SECTION --- *@
    <div class="bg-white shadow-sm border border-gray-100 overflow-hidden relative flex flex-col flex-grow min-h-0 mx-8 mb-8">

        @* Archival Dot Grid Header *@
        <div class="p-8 border-b border-gray-100 d-flex justify-content-between align-items-center relative bg-white overflow-hidden flex-shrink-0">
            <div class="absolute inset-0 opacity-[0.05] pointer-events-none"
                 style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 20px 20px;"></div>

            <div class="relative z-10">
                <h5 class="text-[11px] uppercase tracking-[4px] font-bold text-gray-900 mb-1">Official Route Ledger</h5>
            </div>

            <div class="relative z-10">
                <span class="text-[10px] font-bold text-gray-400 font-mono uppercase tracking-widest">Active Assignments: @Model.Count</span>
            </div>
        </div>

        @* Table Container (Scrolls Internally) *@
        <div class="table-responsive flex-grow overflow-y-auto custom-scrollbar">
            <table class="table table-hover mb-0 align-middle w-full" id="driverTripsTable">
                <thead class="sticky top-0 z-10 bg-white">
                    <tr class="text-[9px] uppercase tracking-[4px] font-bold text-gray-400 border-b bg-gray-50/50">
                        <th class="ps-8 py-5">Excursion Objective</th>
                        <th>Routing Coordinates</th>
                        <th>Target Date</th>
                        <th class="text-center">Status</th>
                        <th class="pe-8 text-end">Administrative</th>
                    </tr>
                </thead>
                <tbody class="text-gray-700">
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="5" class="py-20 text-center">
                                <i class="bi bi-journal-x text-gray-100 text-6xl d-block mb-4"></i>
                                <h4 class="text-serif font-bold text-gray-300 uppercase tracking-[3px]">Ledger Empty</h4>
                                <p class="text-[11px] font-mono text-gray-400 mt-2">No logistical deployments are currently assigned to your profile.</p>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var schedule in Model)
                        {
                            var request = schedule.TripRequest;
                            string statusColor = schedule.Status == "Confirmed" ? "#10b981"
                                               : schedule.Status == "Cancelled" ? "#ef4444"
                                               : "#f59e0b"; // Draft

                            string statusText = schedule.Status == "Draft" ? "AWAITING CLEARANCE" : schedule.Status.ToUpper();

                            <tr class="group hover:bg-gray-50/50 transition-all border-b border-gray-50 last:border-0">
                                <td class="ps-8 py-5">
                                    <div class="fw-bold text-gray-900 text-sm group-hover:text-[#C21E2E] transition-colors">@(request?.Title ?? "Unknown Requisition")</div>
                                    <div class="text-[10px] font-mono text-gray-400 uppercase tracking-widest mt-1">Ref: SCH-@schedule.Id</div>
                                </td>
                                <td>
                                    @if (request != null && !string.IsNullOrEmpty(request.Destination))
                                    {
                                        <a href="#" class="view-map-link inline-flex items-center gap-2 text-[10px] font-bold uppercase tracking-widest text-blue-600 hover:text-blue-800 transition-colors"
                                           data-lat="@(request.DestinationLat?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                                           data-lng="@(request.DestinationLng?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                                           data-address="@request.Destination">
                                            <i class="bi bi-geo-alt-fill"></i> View Route
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-[10px] font-bold text-gray-300 uppercase tracking-widest">Unspecified</span>
                                    }
                                </td>
                                <td>
                                    <span class="font-mono text-[11px] font-bold text-gray-800 bg-gray-50 px-2 py-1 border border-gray-100">
                                        @schedule.ScheduledDate.ToString("dd MMM yyyy")
                                    </span>
                                </td>
                                <td class="text-center">
                                    <span class="px-3 py-1 text-[8px] font-bold uppercase tracking-widest border"
                                          style="color: @statusColor; border-color: @statusColor;">
                                        @statusText
                                    </span>
                                </td>
                                <td class="pe-8 text-end">
                                    <a href="@Url.Action("Manifest", "Trip", new { scheduleId = schedule.Id })" class="inline-block bg-black text-white px-5 py-2 text-[9px] font-bold uppercase tracking-[2px] hover:bg-[#C21E2E] transition-all shadow-sm">
                                        <i class="bi bi-clipboard-check me-1"></i> Verify Manifest
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* --- MODALS --- *@
@Html.Partial("_TripMapModal")

<style>
    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }

    .font-mono {
        font-family: 'Source Code Pro', monospace !important;
    }

    /* Institutional Table Aesthetics */
    .table thead th {
        border-bottom: 2px solid #f8f9fa !important;
    }

    .table tbody tr {
        transition: all 0.2s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    /* Internal scrollbar custom styling */
    .custom-scrollbar::-webkit-scrollbar {
        width: 5px;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #eee;
        border-radius: 10px;
    }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #C21E2E;
        }
</style>

@section Scripts {
    <script>
        let currentMap = null;

        document.querySelectorAll('.view-map-link').forEach(function (link) {
            link.addEventListener('click', function (e) {
                e.preventDefault();
                var lat = parseFloat(this.dataset.lat);
                var lng = parseFloat(this.dataset.lng);
                var address = this.dataset.address;
                document.getElementById('modalAddress').innerText = address;

                var mapModal = new bootstrap.Modal(document.getElementById('tripMapModal'));
                mapModal.show();

                document.getElementById('tripMapModal').addEventListener('shown.bs.modal', function () {
                    if (currentMap) currentMap.remove();
                    if (!isNaN(lat) && !isNaN(lng)) {
                        currentMap = L.map('mapModal').setView([lat, lng], 14);
                    } else {
                        currentMap = L.map('mapModal').setView([-29.85, 31.01], 12);
                    }
                    L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
                        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OSM</a>'
                    }).addTo(currentMap);

                    if (!isNaN(lat) && !isNaN(lng)) {
                        L.marker([lat, lng]).addTo(currentMap).bindPopup(address).openPopup();
                    } else {
                        L.marker([-29.85, 31.01]).addTo(currentMap).bindPopup(address).openPopup();
                    }
                }, { once: true });
            });
        });
    </script>
}
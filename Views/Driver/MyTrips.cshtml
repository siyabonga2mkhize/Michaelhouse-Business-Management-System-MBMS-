@model List<Michaelhouse.Models.TripSchedule>
@{
    ViewBag.Title = "My Assigned Trips";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="driver-dashboard-header" style="margin-bottom:18px;">
    <h2 class="mb-1"><i class="fa fa-road text-danger"></i> My Assigned Trips</h2>
    <p class="text-muted small">Overview and manifests for your scheduled trips.</p>

    <div class="dashboard-cards" style="display:flex; gap:12px; margin-top:12px;">
        <div class="card" style="padding:12px; border-radius:8px; box-shadow:0 6px 18px rgba(0,0,0,0.04); min-width:160px;">
            <div style="font-size:12px; color:#777;">Assigned Trips</div>
            <div style="font-size:22px; font-weight:700; color:#c21e2e;">@ViewBag.ActiveTripsCount</div>
            <div style="font-size:12px; color:#999;">Trips not yet completed</div>
        </div>
        <div class="card" style="padding:12px; border-radius:8px; box-shadow:0 6px 18px rgba(0,0,0,0.04); min-width:160px;">
            <div style="font-size:12px; color:#777;">Completed Trips</div>
            <div style="font-size:22px; font-weight:700; color:#2d862d;">@ViewBag.CompletedTripsCount</div>
            <div style="font-size:12px; color:#999;">Trips marked completed</div>
        </div>
        <div class="card" style="padding:12px; border-radius:8px; box-shadow:0 6px 18px rgba(0,0,0,0.04); min-width:160px;">
            <div style="font-size:12px; color:#777;">Total Trips</div>
            <div style="font-size:22px; font-weight:700; color:#333;">@ViewBag.TotalTripsCount</div>
            <div style="font-size:12px; color:#999;">All assigned trips</div>
        </div>
        <div class="card" style="padding:12px; border-radius:8px; box-shadow:0 6px 18px rgba(0,0,0,0.04); min-width:160px;">
            <div style="font-size:12px; color:#777;">Today</div>
            <div style="font-size:22px; font-weight:700; color:#0a58ca;">@ViewBag.TodayTripsCount</div>
            <div style="font-size:12px; color:#999;">Trips scheduled for today</div>
        </div>
    </div>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <i class="fa fa-check-circle"></i> @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <i class="fa fa-exclamation-circle"></i> @TempData["Error"]
    </div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="fa fa-info-circle"></i> You have no active trips assigned to you at the moment.
    </div>
}
else
{

    <div class="row" style="display:flex; gap:18px; flex-wrap:wrap;">
        @foreach (var trip in Model)
        {
            var tripDate = trip.ScheduledDate;
            var isToday = tripDate.Date == DateTime.Today;
            var studentCount = trip.TripStudents?.Count ?? 0;

            string statusClass = trip.Status == "Confirmed" ? "success"
                               : trip.Status == "InProgress" ? "warning"
                               : trip.Status == "Draft" ? "default"
                               : "info";

            <div style="width:320px;">
                <div class="trip-card" style="background:#fff; border-radius:10px; padding:14px;">
                    <div style="display:flex; justify-content:space-between; align-items:center;">
                        <div>
                            <div style="font-size:14px; font-weight:700;">@(trip.TripRequest?.Title ?? "—")</div>
                            <div style="font-size:12px; color:#777; margin-top:6px;">@(trip.TripRequest?.Description ?? "")</div>
                        </div>
                        <div style="text-align:right;">
                            <span class="badge badge-pill" style="background:@(isToday ? "#c21e2e" : "#eee"); color:@(isToday ? "#fff" : "#333"); font-weight:700; padding:6px 8px;">@trip.Status</span>
                            @if (isToday)
                            {<div style="font-size:11px; color:#c21e2e; margin-top:6px;">TODAY</div>}
                        </div>
                    </div>

                    <hr style="margin:12px 0; border-color:#f0f0f0;" />

                    <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; font-size:13px; color:#444;">
                        <div><strong>Date</strong><div style="color:#777;">@tripDate.ToString("dddd, dd MMM yyyy")</div></div>
                        <div><strong>Vehicle</strong><div style="color:#777;">@(trip.Vehicle?.VehicleNumber ?? "Not assigned")</div></div>

                        <div><strong>Departure</strong><div style="color:#777;">@(trip.TripRequest != null ? trip.TripRequest.DepartureTime.ToString("HH:mm") : "—")</div></div>
                        <div><strong>Return</strong><div style="color:#777;">@(trip.TripRequest != null ? trip.TripRequest.ReturnTime.ToString("HH:mm") : "—")</div></div>

                        <div style="grid-column:1 / -1;"><strong>Destination</strong><div style="color:#777;">@(trip.TripRequest?.Destination ?? "N/A")</div></div>

                        <div><strong>Students</strong><div style="color:#777;">@studentCount</div></div>
                        <div><strong>Seats</strong><div style="color:#777;">@((trip.Vehicle != null) ? trip.Vehicle.Capacity.ToString() : "—")</div></div>
                    </div>

                    <div style="margin-top:12px; display:flex; gap:8px;">
                        <a href="@Url.Action("TripManifest", "Driver", new { scheduleId = trip.Id })" class="btn btn-sm btn-primary" style="flex:1;" @(isToday ? "" : "onclick=\"return false;\"")>
                            <i class="fa fa-list-ul"></i> View Manifest
                        </a>
                        <a href="@Url.Action("TripManifest", "Driver", new { scheduleId = trip.Id })" class="btn btn-sm btn-outline-primary" style="flex:1;" @(isToday ? "" : "onclick=\"return false;\"")>
                            Mark Attendance
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
    }

    <style>
        .trip-card {
            border-radius: 6px;
            margin-bottom: 20px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.08);
            transition: box-shadow 0.2s;
        }

            .trip-card:hover {
                box-shadow: 0 4px 14px rgba(0,0,0,0.14);
            }

            .trip-card .panel-heading {
                border-radius: 6px 6px 0 0;
                padding: 12px 16px;
            }

            .trip-card .panel-footer {
                background: #f9f9f9;
                border-radius: 0 0 6px 6px;
                padding: 10px 16px;
            }

        .page-header {
            border-bottom: 2px solid #e2e2e2;
            margin-bottom: 24px;
        }
    </style>

@model Michaelhouse.Models.DriverAvailability
@{
    ViewBag.Title = "Add Unavailability Period";
}

<h2>Add Unavailability Period</h2>

@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()

    <div class="row">
        <div class="col-md-6">
            <div class="form-group mb-3">
                @Html.LabelFor(m => m.StartDate, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.StartDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                @Html.ValidationMessageFor(m => m.StartDate, "", new { @class = "text-danger" })
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group mb-3">
                @Html.LabelFor(m => m.EndDate, new { @class = "form-label" })
                @Html.TextBoxFor(m => m.EndDate, "{0:yyyy-MM-dd}", new { @class = "form-control", type = "date" })
                @Html.ValidationMessageFor(m => m.EndDate, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>

    <div class="form-group mb-3">
        @Html.LabelFor(m => m.Reason, new { @class = "form-label" })
        @Html.TextAreaFor(m => m.Reason, new { @class = "form-control", rows = 3, placeholder = "Optional – e.g., 'Medical appointment', 'Leave'" })
        @Html.ValidationMessageFor(m => m.Reason, "", new { @class = "text-danger" })
    </div>

    <div class="form-group">
        <button type="submit" class="btn btn-primary">Save</button>
        <a href="@Url.Action("Availabilities", "Driver")" class="btn btn-secondary">Cancel</a>
    </div>
}
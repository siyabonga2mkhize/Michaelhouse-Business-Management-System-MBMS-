@{
    ViewBag.Title = "Driver Dashboard";
}

<div class="container mt-4">
    <div class="row">
        <div class="col-md-8">
            <h2>Welcome, @ViewBag.DriverName</h2>
            <p class="lead">Here's what's happening with your trips.</p>
        </div>
        <div class="col-md-4 text-end">
            <img src="~/Content/logo.svg.png" alt="Michaelhouse" style="height: 60px;" />
        </div>
    </div>

    <div class="row mt-4">
        <div class="col-md-6 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-calendar-check"></i> My Assigned Trips
                    </h5>
                    <p class="card-text">View and mark attendance for trips assigned to you.</p>
                    <a href="@Url.Action("MyTrips", "Driver")" class="btn btn-primary">View Trips</a>
                </div>
            </div>
        </div>
        <div class="col-md-6 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">
                        <i class="bi bi-calendar-x"></i> Unavailability
                    </h5>
                    <p class="card-text">Manage dates when you are not available for trips.</p>
                    <a href="@Url.Action("Availabilities", "Driver")" class="btn btn-secondary">Manage Availability</a>
                </div>
            </div>
        </div>
    </div>
</div>

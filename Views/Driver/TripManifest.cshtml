@model List<Michaelhouse.Models.ManifestStudentViewModel>
@{
   var schedule = ViewBag.Schedule as Michaelhouse.Models.TripSchedule;
    ViewBag.Title = "Trip Manifest";
    Layout = "~/Views/Shared/_Layout.cshtml";

    bool preTripDone = Model.Any(s => s.AlreadyPresentBefore.HasValue && s.AlreadyPresentBefore == true);
    bool postTripDone = Model.Any(s => s.AlreadyPresentAfter.HasValue && s.AlreadyPresentAfter == true);

    bool canMark = schedule != null && System.DateTime.Today == schedule.ScheduledDate.Date;
}

<div class="page-header clearfix">
    <a href="@Url.Action("MyTrips", "Driver")" class="btn btn-default btn-sm pull-right" style="margin-top:6px;">
        <i class="fa fa-arrow-left"></i> Back to My Trips
    </a>
    <h2 style="margin-bottom:4px;">
        <i class="fa fa-list-ul"></i> Trip Manifest
    </h2>
    <p class="text-muted" style="margin:0;">
        @(schedule?.TripRequest != null ? schedule.TripRequest.Title : "—") &mdash;
        @(schedule != null ? schedule.ScheduledDate.ToString("dddd, dd MMM yyyy") : "—")
    </p>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <i class="fa fa-check-circle"></i> @TempData["Success"]
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger alert-dismissible">
        <button type="button" class="close" data-dismiss="alert">&times;</button>
        <i class="fa fa-exclamation-circle"></i> @TempData["Error"]
    </div>
}

@* Trip summary strip *@
<div class="panel panel-default" style="margin-bottom:24px;">
    <div class="panel-body">
        <div class="row text-center">
            <div class="col-sm-3 col-xs-6 trip-stat">
                <div class="stat-num">@Model.Count</div>
                <div class="stat-label">Students</div>
            </div>
            <div class="col-sm-3 col-xs-6 trip-stat">
                <div class="stat-num">@(schedule?.TripRequest != null ? schedule.TripRequest.DepartureTime.ToString("HH:mm") : "—")</div>
                <div class="stat-label">Departure</div>
            </div>
            <div class="col-sm-3 col-xs-6 trip-stat">
                <div class="stat-num">@(schedule?.TripRequest != null ? schedule.TripRequest.ReturnTime.ToString("HH:mm") : "—")</div>
                <div class="stat-label">Return</div>
            </div>
            <div class="col-sm-3 col-xs-6 trip-stat">
                <div class="stat-num" style="font-size:16px; font-weight:600;">
                    @(schedule?.Vehicle?.VehicleNumber ?? "—")
                </div>
                <div class="stat-label">Vehicle</div>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(schedule?.TripRequest?.Destination))
        {
            <p class="text-center text-muted" style="margin-top:12px; margin-bottom:0;">
                <i class="fa fa-map-marker"></i> <strong>Destination:</strong> @schedule.TripRequest.Destination
            </p>
        }
    </div>
</div>

@* Tabs *@
<ul class="nav nav-tabs manifest-tabs" role="tablist">
    <li role="presentation" class="@(!preTripDone ? "active" : "")">
        <a href="#pre-trip" aria-controls="pre-trip" role="tab" data-toggle="tab">
            <i class="fa fa-sign-out"></i> Pre-Trip Attendance
            @if (preTripDone)
            {
                <span class="label label-success" style="margin-left:6px;">Done</span>
            }
        </a>
    </li>
    <li role="presentation" class="@(preTripDone ? "active" : "")">
        <a href="#post-trip" aria-controls="post-trip" role="tab" data-toggle="tab">
            <i class="fa fa-sign-in"></i> Post-Trip Attendance
            @if (postTripDone)
            {
                <span class="label label-success" style="margin-left:6px;">Done</span>
            }
        </a>
    </li>
</ul>

<div class="tab-content manifest-tab-content">

    @* PRE-TRIP TAB *@
    <div role="tabpanel" class="tab-pane @(!preTripDone ? "active" : "")" id="pre-trip">
        <div class="tab-inner">
            <div class="clearfix" style="margin-bottom:14px;">
                <h4 class="pull-left" style="margin:0;">
                    <i class="fa fa-sign-out text-warning"></i> Mark students present before departure
                </h4>
                <div class="pull-right">
                    <button type="button" class="btn btn-xs btn-default" onclick="selectAll('pre', true)">Check All</button>
                    <button type="button" class="btn btn-xs btn-default" onclick="selectAll('pre', false)">Uncheck All</button>
                </div>
            </div>

                @if (preTripDone)
            {
                <div class="alert alert-info">
                    <i class="fa fa-info-circle"></i> Pre-trip attendance has already been saved. You can update it below if needed.
                </div>
            }
                @if (!canMark)
                {
                    <div class="alert alert-warning">
                        <i class="fa fa-clock-o"></i> Attendance can only be marked on the scheduled trip date.
                    </div>
                }

            @using (Html.BeginForm("MarkManifest", "Driver", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="scheduleId" value="@schedule?.Id" />
                <input type="hidden" name="markType" value="before" />

                <div class="table-responsive">
                    <table class="table table-hover manifest-table">
                        <thead>
                            <tr>
                                <th style="width:50px;" class="text-center">Present</th>
                                <th>#</th>
                                <th>Student Name</th>
                                <th>Parent / Guardian</th>
                                <th>Emergency Contact</th>
                                <th class="text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Count; i++)
                            {
                                var s = Model[i];
                                <tr class="student-row @(s.IsPresentBefore ? "row-present" : "")">
                                    <td class="text-center">
                                        <input type="hidden" name="students[@i].StudentId" value="@s.StudentId" />
                                        <input type="hidden" name="students[@i].IsPresentAfter" value="@s.IsPresentAfter.ToString().ToLower()" />
                                        <input type="checkbox"
                                               name="students[@i].IsPresentBefore"
                                               value="true"
                                               class="pre-check attendance-check"
                                               @(s.IsPresentBefore ? "checked" : "")
                                               onchange="toggleRow(this)" />
                                    </td>
                                    <td>@(i + 1)</td>
                                    <td><strong>@s.StudentName</strong></td>
                                    <td>@s.ParentName</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(s.EmergencyContactPhone))
                                        {
                                            <span>@s.EmergencyContactName</span><br />
                                            <a href="tel:@s.EmergencyContactPhone" class="text-muted small">
                                                <i class="fa fa-phone"></i> @s.EmergencyContactPhone
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">@s.EmergencyContactName</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (s.AlreadyPresentBefore == true)
                                        {
                                            <span class="label label-success"><i class="fa fa-check"></i> Marked</span>
                                        }
                                        else if (s.AlreadyPresentBefore == false)
                                        {
                                            <span class="label label-danger"><i class="fa fa-times"></i> Absent</span>
                                        }
                                        else
                                        {
                                            <span class="label label-default">Pending</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="attendance-summary" id="pre-summary">
                    <span class="summary-present">0 present</span> of <strong>@Model.Count</strong> students
                </div>

                <div style="margin-top:16px;">
                    <button type="submit" class="btn btn-warning btn-lg"
                            onclick="return confirmMark('pre-trip')"
                            @(canMark ? "" : "disabled")>
                        <i class="fa fa-save"></i> Save Pre-Trip Attendance
                    </button>
                </div>
            }
        </div>
    </div>

    @* POST-TRIP TAB *@
    <div role="tabpanel" class="tab-pane @(preTripDone ? "active" : "")" id="post-trip">
        <div class="tab-inner">
            <div class="clearfix" style="margin-bottom:14px;">
                <h4 class="pull-left" style="margin:0;">
                    <i class="fa fa-sign-in text-success"></i> Mark students present on return
                </h4>
                <div class="pull-right">
                    <button type="button" class="btn btn-xs btn-default" onclick="selectAll('post', true)">Check All</button>
                    <button type="button" class="btn btn-xs btn-default" onclick="selectAll('post', false)">Uncheck All</button>
                </div>
            </div>

            @if (!preTripDone)
            {
                <div class="alert alert-warning">
                    <i class="fa fa-exclamation-triangle"></i>
                    <strong>Note:</strong> Pre-trip attendance has not been saved yet. You should complete that first.
                </div>
            }
            @if (postTripDone)
            {
                <div class="alert alert-info">
                    <i class="fa fa-info-circle"></i> Post-trip attendance has already been saved.
                </div>
            }

            @using (Html.BeginForm("MarkManifest", "Driver", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="scheduleId" value="@schedule?.Id" />
                <input type="hidden" name="markType" value="after" />

                <div class="table-responsive">
                    <table class="table table-hover manifest-table">
                        <thead>
                            <tr>
                                <th style="width:50px;" class="text-center">Present</th>
                                <th>#</th>
                                <th>Student Name</th>
                                <th>Parent / Guardian</th>
                                <th>Emergency Contact</th>
                                <th class="text-center">Pre-Trip</th>
                                <th class="text-center">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.Count; i++)
                            {
                                var s = Model[i];
                                <tr class="student-row @(s.IsPresentAfter ? "row-present" : "")">
                                    <td class="text-center">
                                        <input type="hidden" name="students[@i].StudentId" value="@s.StudentId" />
                                        <input type="hidden" name="students[@i].IsPresentBefore" value="@s.IsPresentBefore.ToString().ToLower()" />
                                        <input type="checkbox"
                                               name="students[@i].IsPresentAfter"
                                               value="true"
                                               class="post-check attendance-check"
                                               @(s.IsPresentAfter ? "checked" : "")
                                               onchange="toggleRow(this)" />
                                    </td>
                                    <td>@(i + 1)</td>
                                    <td><strong>@s.StudentName</strong></td>
                                    <td>@s.ParentName</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(s.EmergencyContactPhone))
                                        {
                                            <span>@s.EmergencyContactName</span><br />
                                            <a href="tel:@s.EmergencyContactPhone" class="text-muted small">
                                                <i class="fa fa-phone"></i> @s.EmergencyContactPhone
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted">@s.EmergencyContactName</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (s.AlreadyPresentBefore == true)
                                        {
                                            <span class="label label-success"><i class="fa fa-check"></i></span>
                                        }
                                        else
                                        {
                                            <span class="label label-danger"><i class="fa fa-times"></i></span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (s.AlreadyPresentAfter == true)
                                        {
                                            <span class="label label-success"><i class="fa fa-check"></i> Returned</span>
                                        }
                                        else if (s.AlreadyPresentAfter == false)
                                        {
                                            <span class="label label-danger"><i class="fa fa-times"></i> Absent</span>
                                        }
                                        else
                                        {
                                            <span class="label label-default">Pending</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="attendance-summary" id="post-summary">
                    <span class="summary-present">0 present</span> of <strong>@Model.Count</strong> students
                </div>

                <div class="alert alert-danger" style="margin-top:16px;">
                    <i class="fa fa-exclamation-triangle"></i>
                    <strong>Important:</strong> Saving post-trip attendance will mark this trip as
                    <strong>Completed</strong>. Parents will be notified. This cannot be undone.
                </div>

                <div>
                    <button type="submit" class="btn btn-success btn-lg"
                            onclick="return confirmMark('post-trip')"
                            @(canMark ? "" : "disabled")>
                        <i class="fa fa-check-circle"></i> Save Post-Trip Attendance &amp; Complete Trip
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .page-header {
        border-bottom: 2px solid #e2e2e2;
        margin-bottom: 24px;
    }

    .trip-stat {
        padding: 12px 0;
    }

        .trip-stat + .trip-stat {
            border-left: 1px solid #eee;
        }

    .stat-num {
        font-size: 24px;
        font-weight: 700;
        color: #333;
    }

    .stat-label {
        font-size: 12px;
        color: #888;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-top: 2px;
    }

    .manifest-tabs {
        margin-top: 24px;
        border-bottom: 2px solid #ddd;
    }

        .manifest-tabs > li > a {
            font-size: 15px;
            font-weight: 600;
            padding: 10px 20px;
        }

    .manifest-tab-content {
        border: 1px solid #ddd;
        border-top: none;
        border-radius: 0 0 6px 6px;
    }

    .tab-inner {
        padding: 24px;
    }

    .manifest-table thead th {
        background: #f5f5f5;
        font-size: 13px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .manifest-table .attendance-check {
        width: 18px;
        height: 18px;
        cursor: pointer;
    }

    .row-present {
        background-color: #f0fff0 !important;
    }

    .attendance-summary {
        background: #f9f9f9;
        border: 1px solid #e5e5e5;
        border-radius: 4px;
        padding: 10px 16px;
        margin-top: 12px;
        font-size: 14px;
        color: #555;
    }

        .attendance-summary .summary-present {
            font-weight: 700;
            color: #2d862d;
            font-size: 16px;
        }
</style>

<script>
    function toggleRow(checkbox) {
        var row = checkbox.closest('tr');
        checkbox.checked ? row.classList.add('row-present') : row.classList.remove('row-present');
        updateSummary();
    }

    function selectAll(prefix, checked) {
        var selector = prefix === 'pre' ? '.pre-check' : '.post-check';
        document.querySelectorAll(selector).forEach(function (cb) {
            cb.checked = checked;
            checked ? cb.closest('tr').classList.add('row-present')
                    : cb.closest('tr').classList.remove('row-present');
        });
        updateSummary();
    }

    function updateSummary() {
        var preChecked  = document.querySelectorAll('.pre-check:checked').length;
        var postChecked = document.querySelectorAll('.post-check:checked').length;
        var preSummary  = document.getElementById('pre-summary');
        var postSummary = document.getElementById('post-summary');
        if (preSummary)  preSummary.querySelector('.summary-present').textContent  = preChecked  + ' present';
        if (postSummary) postSummary.querySelector('.summary-present').textContent = postChecked + ' present';
    }

    function confirmMark(tab) {
        if (tab === 'post-trip')
            return confirm('Save post-trip attendance? This will mark the trip as COMPLETED and notify parents. This cannot be undone.');
        return confirm('Save pre-trip attendance? Checked students will be marked present for departure.');
    }


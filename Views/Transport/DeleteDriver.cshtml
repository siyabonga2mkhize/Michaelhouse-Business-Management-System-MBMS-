@model Michaelhouse.Models.Driver
@{
    ViewBag.Title = "Delete Driver";
}

<h2>Delete Driver</h2>
<p>Are you sure you want to delete <strong>@Model.FullName</strong>?</p>
@using (Html.BeginForm("DeleteDriver", "Transport", new { id = Model.Id }, FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Delete</button>
    <a href="@Url.Action("Drivers", "Transport")" class="btn btn-default">Cancel</a>
}
@model Michaelhouse.Models.TripSchedule
@{
    var drivers = ViewBag.Drivers as List<Michaelhouse.Models.Driver>;
    var vehicles = ViewBag.Vehicles as List<Michaelhouse.Models.Vehicle>;
    ViewBag.Title = "Assign Driver and Vehicle";
}

@if (Model == null || Model.TripRequest == null)
{
    <div class="alert alert-danger">Trip schedule not found.</div>
    <a href="@Url.Action("UnassignedSchedules", "Transport")" class="btn btn-primary">Back to Unassigned Schedules</a>
    return;
}

<h2>Assign Driver & Vehicle for Trip: @Model.TripRequest.Title</h2>

@using (Html.BeginForm("AssignDriverVehicle", "Transport", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <input type="hidden" name="scheduleId" value="@Model.Id" />

    <div class="form-group">
        <label>Select Driver</label>
        <select name="driverId" class="form-select" required>
            <option value="">-- Choose Driver --</option>
            @if (drivers != null)
            {
                foreach (var driver in drivers)
                {
                    <option value="@driver.Id">@driver.FullName - @driver.Email</option>
                }
            }
        </select>
    </div>

    <div class="form-group mt-3">
        <label>Select Vehicle</label>
        <select name="vehicleId" class="form-select" required>
            <option value="">-- Choose Vehicle --</option>
            @if (vehicles != null)
            {
                foreach (var vehicle in vehicles)
                {
                    <option value="@vehicle.Id">@vehicle.VehicleNumber - @vehicle.Model (Capacity: @vehicle.Capacity)</option>
                }
            }
        </select>
    </div>

    <button type="submit" class="btn btn-primary mt-3">Assign</button>
    <a href="@Url.Action("UnassignedSchedules", "Transport")" class="btn btn-secondary mt-3">Cancel</a>
}
@{
    ViewBag.Title = "Fleet Command Center";
}

@* --- FULL SCREEN VIEWPORT CONTAINER --- *@
<div class="flex flex-col h-full w-full overflow-hidden">

    @* --- INSTITUTIONAL HEADER --- *@
    <div class="mb-8 d-flex justify-content-between align-items-end border-b border-gray-100 pb-6 flex-shrink-0 px-8 pt-8">
        <div>
            <div class="flex items-center gap-2 mb-3">
                <div class="h-[2px] w-8 bg-[#C21E2E]"></div>
                <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Logistics & Transport</h5>
            </div>
            <h2 class="text-5xl font-serif font-bold text-gray-900 tracking-tight">Fleet Command</h2>
        </div>
        <div class="flex gap-3">
            <a href="@Url.Action("Vehicles", "Transport")" class="inline-block bg-white border border-gray-200 px-6 py-2 text-[9px] font-bold uppercase tracking-[2px] hover:bg-gray-50 transition-all shadow-sm">
                <i class="bi bi-truck-front me-2"></i> Manage Vehicles
            </a>
            <a href="@Url.Action("Drivers", "Transport")" class="inline-block bg-gray-900 text-white px-6 py-2 text-[9px] font-bold uppercase tracking-[2px] hover:bg-[#C21E2E] transition-all shadow-sm">
                <i class="bi bi-person-badge me-2"></i> Manage Personnel
            </a>
        </div>
    </div>

    @* --- SCROLLABLE DASHBOARD CONTENT --- *@
    <div class="flex-grow min-h-0 overflow-y-auto custom-scrollbar px-8 pb-10">

        @* --- HERO STATS --- *@
        <div class="row g-4 mb-10">
            <div class="col-md">
                <div class="bg-white border-t-4 border-[#f59e0b] p-6 shadow-sm relative overflow-hidden group h-full">
                    <p class="text-[9px] uppercase tracking-widest font-bold text-amber-600 mb-2">Pending Requests</p>
                    <h3 class="text-4xl font-mono font-bold text-gray-900 mb-4">@ViewBag.PendingRequests</h3>
                    <a href="@Url.Action("PendingRequests", "Transport")" class="text-[9px] uppercase tracking-[2px] font-bold text-gray-400 hover:text-amber-600 transition-colors">
                        View Registry <i class="bi bi-arrow-right ml-1"></i>
                    </a>
                </div>
            </div>
            <div class="col-md">
                <div class="bg-white border-t-4 border-[#10b981] p-6 shadow-sm relative overflow-hidden group h-full">
                    <p class="text-[9px] uppercase tracking-widest font-bold text-green-600 mb-2">Approved Trips</p>
                    <h3 class="text-4xl font-mono font-bold text-gray-900 mb-4">@ViewBag.ApprovedTrips</h3>
                    <span class="text-[9px] uppercase tracking-[2px] font-bold text-gray-300">Awaiting Schedule</span>
                </div>
            </div>
            <div class="col-md">
                <div class="bg-[#1a1a1a] border-t-4 border-[#C21E2E] p-6 shadow-xl relative overflow-hidden group h-full">
                    <p class="text-[9px] uppercase tracking-widest font-bold text-gray-400 mb-2">Unassigned Schedules</p>
                    <h3 class="text-4xl font-mono font-bold text-white mb-4">@ViewBag.UnassignedSchedules</h3>
                    <a href="@Url.Action("UnassignedSchedules", "Transport")" class="text-[9px] uppercase tracking-[2px] font-bold text-[#C21E2E] hover:text-white transition-colors">
                        Assign Logistics <i class="bi bi-arrow-right ml-1"></i>
                    </a>
                </div>
            </div>
            <div class="col-md">
                <div class="bg-white border-t-4 border-gray-800 p-6 shadow-sm relative overflow-hidden group h-full">
                    <p class="text-[9px] uppercase tracking-widest font-bold text-gray-500 mb-2">Active Fleet</p>
                    <h3 class="text-4xl font-mono font-bold text-gray-900 mb-4">@ViewBag.TotalVehicles</h3>
                    <a href="@Url.Action("Vehicles", "Transport")" class="text-[9px] uppercase tracking-[2px] font-bold text-gray-400 hover:text-gray-900 transition-colors">
                        Fleet Status <i class="bi bi-arrow-right ml-1"></i>
                    </a>
                </div>
            </div>
        </div>

        <div class="row g-6">
            @* --- RECENT TRIP REQUESTS (LEFT) --- *@
            <div class="col-xl-6">
                <div class="bg-white shadow-sm border border-gray-100 overflow-hidden relative h-full flex flex-col">
                    <div class="p-6 border-b border-gray-100 bg-gray-50/50 relative overflow-hidden flex-shrink-0">
                        <div class="absolute inset-0 opacity-[0.05] pointer-events-none" style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 20px 20px;"></div>
                        <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-900 mb-0 relative z-10">Pending Requisitions</h5>
                    </div>
                    <div class="table-responsive flex-grow">
                        <table class="table table-hover mb-0 align-middle w-full">
                            <thead class="bg-white">
                                <tr class="text-[8px] uppercase tracking-[3px] font-bold text-gray-400 border-b">
                                    <th class="ps-6 py-4">Excursion Title</th>
                                    <th>Faculty Requestor</th>
                                    <th>Target Date</th>
                                    <th class="pe-6 text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var req in ViewBag.RecentRequests as List<Michaelhouse.Models.TripRequest>)
                                {
                                    <tr class="group hover:bg-gray-50/50 transition-all border-b border-gray-50 last:border-0">
                                        <td class="ps-6 py-4">
                                            <div class="fw-bold text-gray-900 text-sm group-hover:text-[#C21E2E] transition-colors">@req.Title</div>
                                            @if (req.Status == "Pending")
                                            {
                                                <span class="text-[8px] font-bold text-amber-500 uppercase tracking-widest mt-1 d-block">Awaiting Auth</span>
                                            }
                                        </td>
                                        <td class="text-xs font-serif italic text-gray-600">
                                            @(req.Teacher?.FirstName) @(req.Teacher?.LastName)
                                        </td>
                                        <td class="font-mono text-xs text-gray-500">
                                            @req.DepartureTime.ToString("dd MMM yyyy")
                                        </td>
                                        <td class="pe-6 text-end">
                                            <a href="@Url.Action("PendingRequests", "Transport", new { id = req.Id })" class="inline-block bg-white border border-gray-200 px-4 py-2 text-[8px] font-bold uppercase tracking-[2px] text-gray-600 hover:border-[#C21E2E] hover:text-[#C21E2E] transition-all">
                                                Review
                                            </a>
                                        </td>
                                    </tr>
                                }
                                @if (!(ViewBag.RecentRequests as List<Michaelhouse.Models.TripRequest>).Any())
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-10 text-[9px] uppercase tracking-[2px] font-bold text-gray-300">
                                            No Pending Requisitions
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            @* --- UPCOMING SCHEDULES (RIGHT) --- *@
            <div class="col-xl-6">
                <div class="bg-white shadow-sm border border-gray-100 overflow-hidden relative h-full flex flex-col">
                    <div class="p-6 border-b border-gray-100 bg-gray-50/50 relative overflow-hidden flex-shrink-0">
                        <div class="absolute inset-0 opacity-[0.05] pointer-events-none" style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 20px 20px;"></div>
                        <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-900 mb-0 relative z-10">Logistics Roster</h5>
                    </div>
                    <div class="table-responsive flex-grow">
                        <table class="table table-hover mb-0 align-middle w-full">
                            <thead class="bg-white">
                                <tr class="text-[8px] uppercase tracking-[3px] font-bold text-gray-400 border-b">
                                    <th class="ps-6 py-4">Excursion</th>
                                    <th>Target Date</th>
                                    <th>Logistics Unit</th>
                                    <th class="pe-6 text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sched in ViewBag.UpcomingSchedules as List<Michaelhouse.Models.TripSchedule>)
                                {
                                    <tr class="group hover:bg-gray-50/50 transition-all border-b border-gray-50 last:border-0">
                                        <td class="ps-6 py-4">
                                            <div class="fw-bold text-gray-900 text-sm">@(sched.TripRequest?.Title ?? "Unknown")</div>
                                            <div class="text-[10px] font-serif italic text-gray-500">@(sched.Teacher?.LastName)</div>
                                        </td>
                                        <td class="font-mono text-xs text-gray-500">
                                            @sched.ScheduledDate.ToString("dd MMM yyyy")
                                        </td>
                                        <td>
                                            @if (sched.DriverId.HasValue || (sched.VehicleAssignments != null && sched.VehicleAssignments.Any()))
                                            {
                                                <span class="text-[9px] font-bold uppercase tracking-widest text-green-600"><i class="bi bi-check2-circle me-1"></i> Assigned</span>
                                            }
                                            else
                                            {
                                                <span class="text-[9px] font-bold uppercase tracking-widest text-[#C21E2E]"><i class="bi bi-exclamation-circle me-1"></i> Pending</span>
                                            }
                                        </td>
                                        <td class="pe-6 text-end">
                                            @if (!sched.DriverId.HasValue && (sched.VehicleAssignments == null || !sched.VehicleAssignments.Any()))
                                            {
                                                <a href="@Url.Action("AssignDriverVehicle", "Transport", new { scheduleId = sched.Id })" class="inline-block bg-[#1a1a1a] text-white px-4 py-2 text-[8px] font-bold uppercase tracking-[2px] hover:bg-[#C21E2E] transition-all">
                                                    Assign Fleet
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-[9px] font-bold uppercase tracking-widest text-gray-300">Locked</span>
                                            }
                                        </td>
                                    </tr>
                                }
                                @if (!(ViewBag.UpcomingSchedules as List<Michaelhouse.Models.TripSchedule>).Any())
                                {
                                    <tr>
                                        <td colspan="4" class="text-center py-10 text-[9px] uppercase tracking-[2px] font-bold text-gray-300">
                                            No Upcoming Rosters
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

    </div>
</div>

<style>
    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }

    .font-mono {
        font-family: 'Source Code Pro', monospace !important;
    }

    /* Institutional Table Aesthetics */
    .table thead th {
        border-bottom: 2px solid #f8f9fa !important;
    }

    .table tbody tr {
        transition: all 0.2s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    /* Internal scrollbar custom styling */
    .custom-scrollbar::-webkit-scrollbar {
        width: 5px;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #eee;
        border-radius: 10px;
    }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #C21E2E;
        }
</style>
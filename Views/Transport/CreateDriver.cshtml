@model Michaelhouse.Models.Driver
@{
    ViewBag.Title = "Add Driver";
}

<h2>Add New Driver</h2>

@using (Html.BeginForm("CreateDriver", "Transport", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div class="form-group">
        @Html.LabelFor(m => m.FullName)
        @Html.TextBoxFor(m => m.FullName, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.FullName)
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.Email)
        @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.Email)
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.PhoneNumber)
        @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "form-control" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.IDNumber)
        @Html.TextBoxFor(m => m.IDNumber, new { @class = "form-control" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.LicenceNumber)
        @Html.TextBoxFor(m => m.LicenceNumber, new { @class = "form-control" })
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.LicenceExpiryDate)
        <input type="date" name="LicenceExpiryDate" class="form-control" value="@(Model.LicenceExpiryDate?.ToString("yyyy-MM-dd"))" />
    </div>
    <div class="form-group">
        @Html.LabelFor(m => m.HasPDP)
        @Html.CheckBoxFor(m => m.HasPDP)
    </div>
    <div class="form-group">
        @Html.Label("Driver Image")
        <input type="file" name="imageFile" class="form-control" accept="image/*" />
        @Html.ValidationMessageFor(m => m.ImageUrl)
    </div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a href="@Url.Action("Drivers", "Transport")" class="btn btn-default">Cancel</a>
}
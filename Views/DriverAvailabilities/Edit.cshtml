@model Michaelhouse.Models.DriverAvailability

@{
    ViewBag.Title = "Edit Availability";
}

<div class="container">
    <div class="card shadow-sm mt-4">
        <div class="card-header bg-white">
            <h3 class="mb-0">Edit Driver Availability</h3>
        </div>
        <div class="card-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                @Html.HiddenFor(m => m.Id)

                <div class="mb-3 row">
                    <label class="col-sm-3 col-form-label">Driver</label>
                    <div class="col-sm-9">
                        @* show driver name when possible; controller should populate ViewBag.DriverName *@
                        @if (ViewBag.DriverName != null)
                        {
                            <p class="form-control-plaintext">@ViewBag.DriverName</p>
                            <input type="hidden" name="DriverId" value="@ViewBag.DriverId" />
                        }
                        else
                        {
                            @Html.DisplayForModel()
                            @Html.HiddenFor(m => m.DriverId)
                        }
                    </div>
                </div>

                <div class="mb-3 row">
                    @Html.LabelFor(model => model.StartDate, new { @class = "col-sm-3 col-form-label" })
                    <div class="col-sm-9">
                        @Html.TextBoxFor(m => m.StartDate, "", new { @class = "form-control", type = "date" })
                        @Html.ValidationMessageFor(model => model.StartDate, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="mb-3 row">
                    @Html.LabelFor(model => model.EndDate, new { @class = "col-sm-3 col-form-label" })
                    <div class="col-sm-9">
                        @Html.TextBoxFor(m => m.EndDate, "", new { @class = "form-control", type = "date" })
                        @Html.ValidationMessageFor(model => model.EndDate, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="mb-3 row">
                    @Html.LabelFor(model => model.Reason, new { @class = "col-sm-3 col-form-label" })
                    <div class="col-sm-9">
                        @Html.TextAreaFor(m => m.Reason, 4, 0, new { @class = "form-control" })
                        @Html.ValidationMessageFor(model => model.Reason, "", new { @class = "text-danger" })
                    </div>
                </div>

                <div class="d-flex justify-content-between">
                    <a href="@Url.Action("Index")" class="btn btn-outline-secondary">Back to List</a>
                    <button type="submit" class="btn btn-primary">Save Changes</button>
                </div>
            }
        </div>
    </div>
</div>

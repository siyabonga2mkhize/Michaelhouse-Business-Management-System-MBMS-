@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Collection Terminal";

    int todayCount = ViewBag.TodayCount != null ? (int)ViewBag.TodayCount : 0;
    string currentSlot = ViewBag.CurrentSlot as string;
    string currentSlotHours = ViewBag.CurrentSlotHours as string;
    string collectionHours = ViewBag.CollectionHours as string;
    bool isManualOpening = ViewBag.IsManualOpening == true;
    bool canOpenCollection = ViewBag.CanOpenCollection == true;
    int[] durationOptions = ViewBag.DurationOptions as int[] ?? new int[0];
}

@* --- FULL SCREEN VIEWPORT CONTAINER --- *@
<div class="flex flex-col h-full w-full overflow-hidden bg-gray-50/30" id="mc-root">
    @Html.AntiForgeryToken()

    @* --- INSTITUTIONAL HEADER --- *@
    <div class="mb-6 d-flex justify-content-between align-items-end border-b border-gray-200 pb-6 flex-shrink-0 px-8 pt-8 bg-white shadow-sm relative z-10">
        <div>
            <div class="flex items-center gap-2 mb-3">
                <div class="h-[2px] w-8 bg-[#C21E2E]"></div>
                <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Culinary Operations</h5>
            </div>
            <h2 class="text-5xl font-serif font-bold text-gray-900 tracking-tight mb-0">Collection Terminal</h2>
            <p class="text-[11px] font-mono text-gray-500 uppercase tracking-widest mt-2 mb-0">
                <span class="text-[#C21E2E] font-bold">Authorized Kitchen Staff Only</span>
                <span class="mx-2 text-gray-300">|</span>
                <strong id="todayCount" class="text-gray-900 font-bold text-sm">@todayCount</strong> meals collected today
            </p>
        </div>
        <div class="flex gap-3">
            <a href="@Url.Action("ChefIndex", "Cafeteria")" class="inline-flex items-center justify-center bg-white border border-gray-300 text-gray-700 px-6 py-3 text-[10px] font-bold uppercase tracking-[2px] hover:bg-gray-50 hover:border-gray-400 transition-all duration-300 shadow-sm text-decoration-none">
                <i class="bi bi-arrow-left me-2 text-sm"></i> Dashboard
            </a>
        </div>
    </div>

    @* --- SCROLLABLE DATA SECTION --- *@
    <div class="flex-grow min-h-0 overflow-y-auto custom-scrollbar px-8 pb-10 pt-2 flex flex-col gap-6 w-full">

        @* --- SYSTEM STATUS RIBBONS --- *@
        @if (currentSlot != null)
        {
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 p-5 shadow-sm border-l-4 @(isManualOpening ? "bg-amber-50 border-amber-500" : "bg-red-50 border-[#C21E2E]")">
                <div class="flex items-center gap-3">
                    <i class="bi @(isManualOpening ? "bi-exclamation-triangle-fill text-amber-600" : "bi-clock-fill text-[#C21E2E]") text-xl"></i>
                    <div>
                        <span class="text-[11px] font-mono font-bold uppercase tracking-[3px] @(isManualOpening ? "text-amber-800" : "text-[#C21E2E]") block">Now Serving: @currentSlot</span>
                    </div>
                </div>
                <div class="text-xs font-mono uppercase tracking-widest @(isManualOpening ? "text-amber-700" : "text-red-800") font-bold">
                    <i class="bi bi-stopwatch me-1"></i> @currentSlotHours
                </div>
            </div>
        }
        else
        {
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 p-5 shadow-sm border-l-4 bg-gray-100 border-gray-400">
                <div class="flex items-center gap-3">
                    <i class="bi bi-clock text-gray-500 text-xl"></i>
                    <div>
                        <span class="text-[11px] font-mono font-bold uppercase tracking-[3px] text-gray-600 block">No meal is being served right now</span>
                    </div>
                </div>
                <div class="text-xs font-mono uppercase tracking-widest text-gray-500 font-bold">
                    Standard Hours: @collectionHours
                </div>
            </div>
        }

        @* --- MANUAL OVERRIDE (MANAGER ONLY) --- *@
        @if (canOpenCollection)
        {
            <div class="bg-white border border-gray-200 p-4 shadow-sm">
                @if (isManualOpening)
                {
                    using (Html.BeginForm("CloseCollection", "MealCollection", FormMethod.Post, new { @class = "flex flex-wrap items-center gap-4 m-0" }))
                    {
                        @Html.AntiForgeryToken()
                        <span class="font-serif font-bold text-sm text-gray-900"><i class="bi bi-unlock me-1.5 text-[#C21E2E]"></i> @currentSlot collection is open manually.</span>
                        <button type="submit" class="bg-gray-100 border border-gray-300 text-gray-800 px-4 py-1.5 text-[9px] font-bold uppercase tracking-[1px] hover:bg-gray-200 transition-colors shadow-2xs">Close Now</button>
                        <span class="text-[9px] font-mono uppercase tracking-widest text-gray-500 ms-auto">Normal hours: @collectionHours</span>
                    }
                }
                else
                {
                    using (Html.BeginForm("OpenCollection", "MealCollection", FormMethod.Post, new { @class = "flex flex-wrap items-center gap-3 m-0" }))
                    {
                        @Html.AntiForgeryToken()
                        <span class="font-serif font-bold text-sm text-gray-900"><i class="bi bi-key me-1.5 text-gray-400"></i> Override: Open collection for today's</span>

                        <select name="slot" class="border border-gray-300 py-1 px-2 font-mono text-xs outline-none focus:border-[#C21E2E]">
                            <option value="Breakfast">Breakfast</option>
                            <option value="Lunch" selected>Lunch</option>
                            <option value="Dinner">Dinner</option>
                        </select>

                        <span class="font-serif font-bold text-sm text-gray-900">for</span>

                        <select name="minutes" class="border border-gray-300 py-1 px-2 font-mono text-xs outline-none focus:border-[#C21E2E]">
                            @foreach (var m in durationOptions)
                            {
                                <option value="@m" @(m == 60 ? "selected" : "")>@(m < 60 ? m + " minutes" : (m / 60) + (m == 60 ? " hour" : " hours"))</option>
                            }
                        </select>

                        <button type="submit" class="bg-transparent border border-[#C21E2E] text-[#C21E2E] px-4 py-1.5 text-[9px] font-bold uppercase tracking-[1px] hover:bg-red-50 transition-colors shadow-2xs">Authorize Opening</button>
                        <p class="w-full text-[9px] font-mono uppercase tracking-widest text-gray-400 mt-2 mb-0">Overrides normal hours (@collectionHours) for testing/late arrivals. All dietary protocols still apply.</p>
                    }
                }
            </div>
        }

        @* --- TWO COLUMN TERMINAL GRID --- *@
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mt-2">

            @* 1. BIOMETRIC CAPTURE MODULE *@
            <div class="bg-white border-2 border-gray-200 shadow-sm flex flex-col relative overflow-hidden h-fit">
                <div class="p-4 bg-[#1a1a1a] text-white flex justify-between items-center border-b-2 border-b-[#C21E2E]">
                    <span class="text-[10px] font-mono font-bold uppercase tracking-[4px] text-gray-300">
                        <i class="bi bi-camera-video me-2 text-[#C21E2E]"></i> Biometric Terminal
                    </span>
                    <span class="flex h-2 w-2 relative">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#C21E2E] opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-[#C21E2E]"></span>
                    </span>
                </div>

                <div class="p-6">
                    <div class="relative bg-black aspect-[4/3] rounded-sm overflow-hidden mb-5 shadow-inner border border-gray-300">
                        <video id="video" autoplay playsinline class="w-full h-full object-cover block"></video>
                        <div id="placeholder" class="absolute inset-0 flex items-center justify-center text-gray-400 font-mono text-xs uppercase tracking-widest text-center p-4 bg-gray-900/90 z-10">
                            <div>
                                <i class="bi bi-webcam text-4xl block mb-3 text-gray-500"></i>
                                Click "Start Camera" to initialize optical feed
                            </div>
                        </div>
                    </div>

                    <div class="flex gap-4 mb-4">
                        <button type="button" id="startBtn" class="flex-1 bg-[#1a1a1a] text-white px-6 py-3.5 text-[10px] font-bold uppercase tracking-[2px] hover:bg-black transition-all shadow-sm">
                            <i class="bi bi-power me-2"></i> Start Camera
                        </button>
                        <button type="button" id="captureBtn" class="flex-1 bg-blue-600 text-white px-6 py-3.5 text-[10px] font-bold uppercase tracking-[2px] hover:bg-blue-700 transition-all shadow-sm" style="display:none;">
                            <i class="bi bi-viewfinder me-2"></i> Capture & Verify
                        </button>
                    </div>

                    <div id="status" class="mc-status" style="display:none;"></div>
                </div>
            </div>

            @* 2. RESULTS & CONFIRMATION MODULE *@
            <div id="resultCard" class="mc-result-card relative h-fit hidden">
                <div class="p-6">
                    <div id="resultLabel" class="text-[10px] font-mono font-bold uppercase tracking-[4px] mb-2"></div>
                    <div id="resultName" class="font-serif font-bold text-3xl text-gray-900 mb-1 leading-none"></div>
                    <div id="resultMeta" class="text-xs font-mono uppercase tracking-widest text-gray-500 mb-5 border-b border-gray-100 pb-5"></div>

                    <div id="resultMessage" class="font-serif text-lg text-gray-800 mb-5"></div>

                    <div id="warningBox" class="bg-red-50 border-l-4 border-[#C21E2E] p-4 text-[#C21E2E] shadow-sm mb-5 text-sm font-serif hidden"></div>

                    <div id="mealBox" class="bg-gray-50 border border-gray-200 p-5 shadow-xs mb-6">
                        <div class="flex justify-between items-center mb-3">
                            <h6 class="text-[9px] uppercase tracking-[3px] font-bold text-gray-500 mb-0">Authorized Allocation</h6>
                            <span id="mealSlotLabel" class="inline-flex items-center text-[8px] font-bold uppercase tracking-widest bg-white border border-gray-300 text-gray-700 px-2 py-0.5 shadow-2xs"></span>
                        </div>
                        <div id="mealName" class="font-serif font-bold text-xl text-gray-900 mb-3"></div>
                        <div id="allergenInfo" class="text-[10px] font-mono text-gray-500 uppercase tracking-wider flex flex-col gap-1.5 border-t border-gray-200 pt-3"></div>
                    </div>

                    <div class="flex gap-4">
                        <button type="button" id="confirmBtn" class="flex-1 bg-[#10b981] border border-[#10b981] text-white px-6 py-4 text-[10px] font-bold uppercase tracking-[2px] hover:bg-green-600 hover:shadow-[0_0_15px_rgba(16,185,129,0.3)] transition-all shadow-sm">
                            <i class="bi bi-check2-circle me-1.5"></i> Confirm Collection
                        </button>
                        <button type="button" id="cancelBtn" class="flex-1 bg-white border-2 border-gray-300 text-gray-700 px-6 py-4 text-[10px] font-bold uppercase tracking-[2px] hover:bg-gray-50 transition-all shadow-sm">
                            <i class="bi bi-x-lg me-1.5"></i> Cancel
                        </button>
                    </div>
                </div>
            </div>

        </div>

    </div>
</div>

<style>
    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }

    .font-mono {
        font-family: 'Source Code Pro', monospace !important;
    }

    .custom-scrollbar::-webkit-scrollbar {
        width: 5px;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #d1d5db;
        border-radius: 10px;
    }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #C21E2E;
        }

    /* Dynamic JS Classes */
    .mc-status {
        padding: 1rem;
        font-family: 'Source Code Pro', monospace;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        border-radius: 4px;
        border-left-width: 4px;
        box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
    }

        .mc-status.ok {
            background-color: #f0fdf4;
            color: #166534;
            border-left-color: #10b981;
        }

        .mc-status.err {
            background-color: #fef2f2;
            color: #991b1b;
            border-left-color: #C21E2E;
        }

        .mc-status.info {
            background-color: #eff6ff;
            color: #1e40af;
            border-left-color: #3b82f6;
        }

    .mc-result-card.ok {
        background-color: #ffffff;
        border: 2px solid #10b981;
    }

        .mc-result-card.ok #resultLabel {
            color: #059669;
        }

    .mc-result-card.warn {
        background-color: #fffbeb;
        border: 2px solid #f59e0b;
    }

        .mc-result-card.warn #resultLabel {
            color: #d97706;
        }

    .mc-result-card.err {
        background-color: #fef2f2;
        border: 2px solid #C21E2E;
    }

        .mc-result-card.err #resultLabel {
            color: #C21E2E;
        }
</style>

@section Scripts {
    <script>
    (function () {
        // ── State ──────────────────────────────────────────────────
        var stream = null;
        var pendingToken = null;
        var video = document.getElementById("video");
        var placeholder = document.getElementById("placeholder");
        var startBtn = document.getElementById("startBtn");
        var captureBtn = document.getElementById("captureBtn");
        var statusBox = document.getElementById("status");
        var resultCard = document.getElementById("resultCard");
        var resultLabel = document.getElementById("resultLabel");
        var resultName = document.getElementById("resultName");
        var resultMeta = document.getElementById("resultMeta");
        var resultMessage = document.getElementById("resultMessage");
        var warningBox = document.getElementById("warningBox");
        var mealBox = document.getElementById("mealBox");
        var mealSlotLabel = document.getElementById("mealSlotLabel");
        var mealName = document.getElementById("mealName");
        var allergenInfo = document.getElementById("allergenInfo");
        var confirmBtn = document.getElementById("confirmBtn");
        var cancelBtn = document.getElementById("cancelBtn");

        var tokenInput = document.querySelector('#mc-root input[name="__RequestVerificationToken"]');
        var antiForgery = tokenInput ? tokenInput.value : "";

        // ── Camera ─────────────────────────────────────────────────
        startBtn.addEventListener("click", function () {
            if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
                showStatus("This browser does not support camera access.", "err");
                return;
            }

            navigator.mediaDevices.getUserMedia({ video: { facingMode: "user", width: { ideal: 640 }, height: { ideal: 480 } } })
                .then(function (s) {
                    stream = s;
                    video.srcObject = s;
                    video.play();
                    placeholder.style.display = "none";
                    startBtn.style.display = "none";
                    captureBtn.style.display = "inline-flex";
                    showStatus("Camera active. Position student face in the frame.", "info");
                })
                .catch(function (err) {
                    showStatus("Camera initialization failed: " + err.message, "err");
                });
        });

        // ── Capture & Verify ───────────────────────────────────────
        captureBtn.addEventListener("click", function () {
            if (!stream) {
                showStatus("Camera feed unavailable.", "err");
                return;
            }

            var canvas = document.createElement("canvas");
            canvas.width = video.videoWidth || 640;
            canvas.height = video.videoHeight || 480;
            canvas.getContext("2d").drawImage(video, 0, 0, canvas.width, canvas.height);

            showStatus("Executing biometric verification...", "info");
            captureBtn.disabled = true;
            hideResult();

            post('@Url.Action("Verify", "MealCollection")', { imageBase64: canvas.toDataURL("image/jpeg", 0.85) })
                .then(function (data) {
                    captureBtn.disabled = false;

                    if (data.success) {
                        pendingToken = data.token;
                        showStatus("Verification successful. Authorize collection.", "ok");
                    } else {
                        showStatus(data.title + ".", "err");
                    }

                    showResult(data);
                })
                .catch(function (err) {
                    captureBtn.disabled = false;
                    showStatus("System Exception: " + err.message, "err");
                });
        });

        // ── Confirm collection ─────────────────────────────────────
        confirmBtn.addEventListener("click", function () {
            if (!pendingToken) return;

            confirmBtn.disabled = true;

            post('@Url.Action("Record", "MealCollection")', { token: pendingToken })
                .then(function (data) {
                    confirmBtn.disabled = false;
                    pendingToken = null;

                    showResult(data);

                    if (!data.success) {
                        showStatus("Transaction Failed: " + data.title + ".", "err");
                        return;
                    }

                    showStatus("✓ " + data.studentName + " collected " + data.mealSlot + " at " + data.collectedAt + ".", "ok");

                    var counter = document.getElementById("todayCount");
                    if (counter) counter.textContent = ((parseInt(counter.textContent, 10) || 0) + 1).toString();
                })
                .catch(function (err) {
                    confirmBtn.disabled = false;
                    showStatus("System Exception: " + err.message, "err");
                });
        });

        // ── Cancel ─────────────────────────────────────────────────
        cancelBtn.addEventListener("click", function () {
            hideResult();
            showStatus("Terminal ready. Awaiting next subject.", "info");
        });

        // ── Result card ────────────────────────────────────────────
        function showResult(data) {
            var ready = data.outcome === "ReadyForCollection";
            var collected = data.outcome === "Collected";

            resultCard.classList.remove("hidden", "ok", "warn", "err");
            resultCard.classList.add((ready || collected) ? "ok" : "err");

            resultLabel.textContent = data.title || "";
            resultName.textContent = data.studentName || "";
            resultName.style.display = data.studentName ? "block" : "none";
            resultMeta.textContent = data.studentNumber ? "Student ID: " + data.studentNumber : "";
            resultMessage.textContent = ready ? "Identity verified. Authorized for collection." : (data.message || "");

            // The meal
            mealBox.style.display = data.mealName ? "block" : "none";
            mealSlotLabel.textContent = data.mealDate || data.mealSlot || "";
            mealName.textContent = data.mealName || "";

            allergenInfo.textContent = "";
            addInfoLine("Contains", data.allergens);
            addInfoLine("Student Allergies", data.studentAllergies);
            addInfoLine("Dietary Preference", data.dietaryPreference);
            addInfoLine("Medical Restrictions", data.medicalDietaryRestrictions);
            addInfoLine("Dietary Notes", data.dietaryNotes);

            // Dietary warnings
            warningBox.classList.add("hidden");
            warningBox.textContent = "";
            if (data.hasDietaryConflict) {
                var heading = document.createElement("div");
                heading.style.fontWeight = "700";
                heading.style.marginBottom = "0.5rem";
                heading.textContent = "⚠ DIETARY CONFLICT DETECTED";
                warningBox.appendChild(heading);

                var list = document.createElement("ul");
                list.className = "list-disc pl-5 m-0";
                (data.dietaryConflicts || []).forEach(function (msg) {
                    var line = document.createElement("li");
                    line.textContent = msg;
                    list.appendChild(line);
                });
                warningBox.appendChild(list);

                warningBox.classList.remove("hidden");
                if (ready) resultCard.classList.replace("ok", "warn");
            }

            confirmBtn.style.display = ready ? "" : "none";
            cancelBtn.textContent = ready ? "Cancel" : "Next Student";
        }

        function addInfoLine(label, value) {
            if (!value) return;
            var line = document.createElement("div");
            var strong = document.createElement("strong");
            strong.className = "text-gray-700";
            strong.textContent = label + ": ";
            line.appendChild(strong);
            line.appendChild(document.createTextNode(value));
            allergenInfo.appendChild(line);
        }

        function hideResult() {
            resultCard.classList.add("hidden");
            pendingToken = null;
        }

        function showStatus(msg, kind) {
            statusBox.textContent = msg;
            statusBox.className = "mc-status mt-4 " + (kind || "info");
            statusBox.style.display = "block";
        }

        function post(url, fields) {
            var form = new FormData();
            form.append("__RequestVerificationToken", antiForgery);
            Object.keys(fields).forEach(function (k) { form.append(k, fields[k]); });

            return fetch(url, { method: "POST", body: form, credentials: "same-origin" })
                .then(function (r) {
                    if (!r.ok) throw new Error("Server returned HTTP " + r.status);
                    return r.json();
                });
        }

    })();
    </script>
}
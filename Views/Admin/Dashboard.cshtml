@{
    ViewBag.Title = "Admin Dashboard";
}

<div class="mb-4">
    <h2 style="font-family:'Playfair Display',serif; color:#C21E2E;">Administration Dashboard</h2>
    <p class="text-muted" style="font-size:0.82rem; text-transform:uppercase; letter-spacing:1px;">
        @DateTime.Now.ToString("dddd, dd MMMM yyyy")
    </p>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #C21E2E !important;">
            <div class="card-body d-flex align-items-center gap-3">
                <div style="background:#fff5f5; border-radius:12px; padding:14px;">
                    <i class="bi bi-mortarboard fs-4" style="color:#C21E2E;"></i>
                </div>
                <div>
                    @{
                        int applicationCount = 0;
                        try {
                            using (var db = new Michaelhouse.Models.DBContextClass()) {
                                applicationCount = db.Applications.Count();
                            }
                        } catch { }
                    }
                    <div class="fw-bold fs-4">@applicationCount</div>
                    <div class="text-muted" style="font-size:0.75rem; text-transform:uppercase; letter-spacing:1px;">Applications</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #0d6efd !important;">
            <div class="card-body d-flex align-items-center gap-3">
                <div style="background:#f0f5ff; border-radius:12px; padding:14px;">
                    <i class="bi bi-people fs-4" style="color:#0d6efd;"></i>
                </div>
                <div>
                    @{
                        int teacherCount = 0;
                        try {
                            using (var db = new Michaelhouse.Models.DBContextClass()) {
                                teacherCount = db.Teachers.Count();
                            }
                        } catch { }
                    }
                    <div class="fw-bold fs-4">@teacherCount</div>
                    <div class="text-muted" style="font-size:0.75rem; text-transform:uppercase; letter-spacing:1px;">Teachers</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #198754 !important;">
            <div class="card-body d-flex align-items-center gap-3">
                <div style="background:#f0fff4; border-radius:12px; padding:14px;">
                    <i class="bi bi-person-badge fs-4" style="color:#198754;"></i>
                </div>
                <div>
                    @{
                        int studentCount = 0;
                        try {
                            using (var db = new Michaelhouse.Models.DBContextClass()) {
                                studentCount = db.Students.Count();
                            }
                        } catch { }
                    }
                    <div class="fw-bold fs-4">@studentCount</div>
                    <div class="text-muted" style="font-size:0.75rem; text-transform:uppercase; letter-spacing:1px;">Students</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-sm-6 col-lg-3">
        <div class="card border-0 shadow-sm h-100" style="border-left: 4px solid #ffc107 !important;">
            <div class="card-body d-flex align-items-center gap-3">
                <div style="background:#fffbf0; border-radius:12px; padding:14px;">
                    <i class="bi bi-person-lines-fill fs-4" style="color:#ffc107;"></i>
                </div>
                <div>
                    @{
                        int parentCount = 0;
                        try {
                            using (var db = new Michaelhouse.Models.DBContextClass()) {
                                parentCount = db.Parents.Count();
                            }
                        } catch { }
                    }
                    <div class="fw-bold fs-4">@parentCount</div>
                    <div class="text-muted" style="font-size:0.75rem; text-transform:uppercase; letter-spacing:1px;">Parents</div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3 px-4">
                <span style="font-family:'Playfair Display',serif; font-size:1rem;">Quick Links</span>
            </div>
            <div class="card-body d-flex flex-wrap gap-2 p-4">
                <a href="@Url.Action("Applications", "Admin")" class="btn btn-outline-danger btn-sm"
                   style="text-transform:uppercase; font-size:0.72rem; letter-spacing:1px;">
                    <i class="bi bi-file-earmark-text me-1"></i>Applications
                </a>
                <a href="@Url.Action("Registrations", "Admin")" class="btn btn-outline-secondary btn-sm"
                   style="text-transform:uppercase; font-size:0.72rem; letter-spacing:1px;">
                    <i class="bi bi-mortarboard me-1"></i>Registrations
                </a>
                <a href="@Url.Action("Index", "Teacher")" class="btn btn-outline-primary btn-sm"
                   style="text-transform:uppercase; font-size:0.72rem; letter-spacing:1px;">
                    <i class="bi bi-people me-1"></i>Staff Ledger
                </a>
                <a href="@Url.Action("Generate", "Timetable")" class="btn btn-outline-success btn-sm"
                   style="text-transform:uppercase; font-size:0.72rem; letter-spacing:1px;">
                    <i class="bi bi-calendar3 me-1"></i>Timetable
                </a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3 px-4">
                <span style="font-family:'Playfair Display',serif; font-size:1rem;">System Info</span>
            </div>
            <div class="card-body p-4" style="font-size:0.84rem;">
                <div class="d-flex justify-content-between border-bottom pb-2 mb-2">
                    <span class="text-muted">Academic Year</span>
                    <span class="fw-semibold">@DateTime.Now.Year</span>
                </div>
                <div class="d-flex justify-content-between border-bottom pb-2 mb-2">
                    <span class="text-muted">System</span>
                    <span class="fw-semibold">Michaelhouse MBMS</span>
                </div>
                <div class="d-flex justify-content-between">
                    <span class="text-muted">Logged in as</span>
                    <span class="fw-semibold">@Session["UserName"]</span>
                </div>
            </div>
        </div>
    </div>
</div>

@using Michaelhouse.Models.Enums
@using Michaelhouse.Services
@model List<Michaelhouse.Models.StreamEnrolment>
@{
    ViewBag.Title = "Academic Streams";
    var enrolments = Model;

    var streams = new[]
    {
        AcademicStream.Sciences,
        AcademicStream.Commerce,
        AcademicStream.EngineeringAndTechnology,
        AcademicStream.ArtsAndCulture,
        AcademicStream.HumanAndSocialStudies
    };

    var grades = new[] { 10, 11, 12 };
}

<div class="mb-10 d-flex justify-content-between align-items-end border-b border-gray-100 pb-8">
    <div>
        <div class="flex items-center gap-2 mb-3">
            <div class="h-1 w-8 bg-[#C21E2E]"></div>
            <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Academic Planning</h5>
        </div>
        <h2 class="text-4xl font-serif font-bold text-gray-900 tracking-tight">Stream Groups</h2>
        <p class="text-xs text-gray-400 mt-2 uppercase tracking-widest font-bold">Faculty Distribution Analysis</p>
    </div>

    <div class="flex gap-2">
        @foreach (var g in grades)
        {
            <a href="#grade-@g" class="px-4 py-2 border border-gray-200 text-[10px] font-bold uppercase tracking-widest text-gray-500 hover:border-[#C21E2E] hover:text-[#C21E2E] transition-all">
                Grade @g
            </a>
        }
    </div>
</div>

@if (!enrolments.Any())
{
    <div class="bg-gray-50 border border-gray-100 p-16 text-center shadow-inner relative overflow-hidden">
        <i class="bi bi-diagram-3 absolute -right-10 -bottom-10 text-black/5 text-9xl"></i>
        <div class="relative z-10">
            <h4 class="font-serif text-2xl text-gray-800 mb-2">No Allocations Found</h4>
            <p class="text-gray-400 text-sm italic">Stream populations will generate once student subject selections are finalized.</p>
        </div>
    </div>
}
else
{
    foreach (var grade in grades)
    {
        var gradeEnrolments = enrolments.Where(e => e.Grade == grade).ToList();
        if (!gradeEnrolments.Any()) { continue; }

        <div id="grade-@grade" class="pt-8 mb-12 scroll-mt-24">

            <div class="flex items-center gap-4 mb-8">
                <div class="h-12 w-12 bg-gray-900 text-white flex items-center justify-center font-serif text-xl font-bold">
                    @grade
                </div>
                <div>
                    <h3 class="text-2xl font-bold tracking-tight text-gray-900">Grade @grade Cohort</h3>
                    <p class="text-[10px] font-bold uppercase tracking-widest text-gray-400">Total Enrollment: @gradeEnrolments.Count</p>
                </div>
            </div>

            <div class="row g-4">
                @foreach (var stream in streams)
                {
                    var streamStudents = gradeEnrolments.Where(e => e.Stream == stream).ToList();
                    string icon = RegistrationService.GetStreamIcon(stream);
                    string name = RegistrationService.GetStreamName(stream);

                    // Faculty Theming
                    string themeColor = stream == AcademicStream.Sciences ? "border-blue-500"
                                      : stream == AcademicStream.Commerce ? "border-emerald-500"
                                      : stream == AcademicStream.EngineeringAndTechnology ? "border-gray-800"
                                      : stream == AcademicStream.ArtsAndCulture ? "border-amber-500"
                                      : "border-purple-500";

                    string iconColor = stream == AcademicStream.Sciences ? "text-blue-600"
                                     : stream == AcademicStream.Commerce ? "text-emerald-600"
                                     : stream == AcademicStream.EngineeringAndTechnology ? "text-gray-900"
                                     : stream == AcademicStream.ArtsAndCulture ? "text-amber-600"
                                     : "text-purple-600";

                    <div class="col-md-6 col-xl-4">
                        <div class="bg-white border border-gray-100 border-t-4 @themeColor shadow-sm h-full flex flex-col">

                            <div class="p-6 border-b border-gray-50 flex justify-between items-start bg-gray-50/50">
                                <div>
                                    <i class="bi @icon @iconColor text-2xl mb-2 block"></i>
                                    <h6 class="text-sm font-bold uppercase tracking-widest text-gray-900 mb-1">@name</h6>
                                </div>
                                <div class="bg-white border border-gray-200 px-3 py-1 text-xs font-bold text-gray-900 shadow-sm">
                                    @streamStudents.Count
                                </div>
                            </div>

                            <div class="flex-grow p-0">
                                @if (streamStudents.Any())
                                {
                                    <div class="divide-y divide-gray-50">
                                        @foreach (var enr in streamStudents.OrderBy(e => e.Student?.LastName))
                                        {
                                            <div class="p-4 hover:bg-gray-50 transition-colors flex justify-between items-center group">
                                                <div>
                                                    <p class="text-xs font-bold text-gray-800 mb-0 group-hover:text-[#C21E2E] transition-colors">@enr.Student?.Name</p>
                                                    <p class="text-[9px] text-gray-400 truncate w-40 tracking-tighter">@enr.Student?.User?.Email</p>
                                                </div>
                                                <div>
                                                    @if (enr.TakesMathematics)
                                                    {
                                                        <span class="text-[8px] font-bold uppercase tracking-widest text-gray-900 border border-gray-900 px-2 py-1">Core Math</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-[8px] font-bold uppercase tracking-widest text-gray-400 border border-gray-200 px-2 py-1">Math Lit</span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center p-8 text-gray-300">
                                        <i class="bi bi-person-x text-3xl mb-2 block opacity-50"></i>
                                        <p class="text-[10px] uppercase tracking-widest font-bold mb-0">No Candidates</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
}

<style>
    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }
    /* Smooth scrolling for the Grade anchors */
    html {
        scroll-behavior: smooth;
    }
</style>


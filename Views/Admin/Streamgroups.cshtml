@using Michaelhouse.Models.Enums
@using Michaelhouse.Services
@model List<Michaelhouse.Models.StreamEnrolment>
@{
    ViewBag.Title = "Academic Streams";
    var enrolments = Model ?? new List<Michaelhouse.Models.StreamEnrolment>();

    var streams = new[]
    {
        AcademicStream.Sciences,
        AcademicStream.Commerce,
        AcademicStream.EngineeringAndTechnology,
        AcademicStream.ArtsAndCulture,
        AcademicStream.HumanAndSocialStudies
    };

    var grades = new[] { 10, 11, 12 };
}

<link rel="stylesheet" href="~/Content/academic.css" />

<div class="ac-header relative overflow-hidden mb-12" style="background: linear-gradient(to right, #ffffff, #fafafa); border-bottom: 3px solid var(--mh-red); padding: 80px 0 50px;">
    
    <div class="absolute inset-0 opacity-[0.15] pointer-events-none"
         style="background-image: radial-gradient(var(--mh-red) 1px, transparent 1px); background-size: 32px 32px;"></div>

    <i class="bi bi-diagram-3 absolute -right-20 -bottom-20 text-red-600/[0.03] text-[30rem] rotate-12 pointer-events-none"></i>

    <div class="max-w-7xl mx-auto px-4 relative z-10 d-flex justify-content-between align-items-end">
        <div>
            <div class="flex items-center gap-3 mb-4">
                <div class="h-[2px] w-12 bg-[#C21E2E]"></div>
                <h5 class="text-[11px] uppercase tracking-[5px] font-bold text-red-700/60">Faculty Analytics</h5>
            </div>
            <h2 class="text-5xl font-serif font-bold text-gray-900 tracking-tight">Stream Groups</h2>
            <p class="text-sm text-gray-500 mt-2 uppercase tracking-[4px] font-medium">Cohort Distribution & Subject Mapping</p>
        </div>

        <div class="flex gap-3 mb-2">
            @foreach (var g in grades)
            {
                <a href="#grade-@g" class="px-5 py-2.5 border-2 border-gray-100 text-[11px] font-bold uppercase tracking-widest text-gray-400 hover:border-[#C21E2E] hover:text-[#C21E2E] transition-all bg-white/80 backdrop-blur-sm shadow-sm">
                    Grade @g
                </a>
            }
        </div>
    </div>
</div>

<div class="max-w-7xl mx-auto px-4 pb-32">

    @foreach (var grade in grades)
    {
        var gradeEnrolments = enrolments.Where(e => e.Grade == grade).ToList();
        if (!gradeEnrolments.Any()) { continue; }

        <div id="grade-@grade" class="pt-10 mb-24 scroll-mt-32">

            <div class="flex items-center gap-6 mb-12">
                <div class="h-16 w-16 bg-gray-900 text-white flex items-center justify-center font-serif text-3xl font-bold shadow-xl border-b-4 border-[#C21E2E]">
                    @grade
                </div>
                <div class="flex-grow border-b border-gray-100 pb-2">
                    <h3 class="text-3xl font-serif font-bold tracking-tight text-gray-900 mb-0">Grade @grade Cohort</h3>
                    <div class="flex items-center gap-4 mt-1">
                        <span class="text-[10px] font-bold uppercase tracking-widest text-red-600">Total Enrolled: @gradeEnrolments.Count</span>
                        <div class="h-1 w-1 rounded-full bg-gray-300"></div>
                        <span class="text-[10px] font-bold uppercase tracking-widest text-gray-400">Academic Year 2026</span>
                    </div>
                </div>
            </div>

            <div class="row g-5">
                @foreach (var stream in streams)
                {
                    var streamStudents = gradeEnrolments.Where(e => e.Stream == stream).ToList();
                    string icon = RegistrationService.GetStreamIcon(stream);
                    string name = RegistrationService.GetStreamName(stream);

                    // COLOR THEME LOGIC
                    string accentColor = stream == AcademicStream.Sciences ? "text-blue-600"
                                      : stream == AcademicStream.Commerce ? "text-emerald-600"
                                      : stream == AcademicStream.EngineeringAndTechnology ? "text-orange-600"
                                      : stream == AcademicStream.ArtsAndCulture ? "text-pink-600"
                                      : "text-purple-600";
                    
                    string bgAccent = stream == AcademicStream.Sciences ? "bg-blue-50/30"
                                    : stream == AcademicStream.Commerce ? "bg-emerald-50/30"
                                    : stream == AcademicStream.EngineeringAndTechnology ? "bg-orange-50/30"
                                    : stream == AcademicStream.ArtsAndCulture ? "bg-pink-50/30"
                                    : "bg-purple-50/30";

                    <div class="col-md-6 col-xl-4">
                        <div class="ac-card h-full flex flex-col relative overflow-hidden border-t-0 shadow-lg group hover:shadow-2xl transition-all duration-500">
                            
                            <i class="bi @icon absolute -right-8 -top-8 @accentColor opacity-[0.07] text-[12rem] rotate-12 transition-transform duration-700 group-hover:rotate-0 group-hover:scale-110"></i>

                            <div class="p-6 border-b border-gray-100 flex justify-between items-center @bgAccent relative z-10">
                                <div class="flex items-center gap-3">
                                    <div class="p-2 bg-white shadow-sm border border-gray-100">
                                        <i class="bi @icon @accentColor fs-5"></i>
                                    </div>
                                    <div>
                                        <h6 class="text-[12px] font-bold uppercase tracking-[2px] text-gray-900 mb-0">@name</h6>
                                        <div class="h-0.5 w-6 mt-1 @(accentColor.Replace("text", "bg"))"></div>
                                    </div>
                                </div>
                                <div class="text-right">
                                    <div class="text-2xl font-serif font-bold text-gray-900">@streamStudents.Count.ToString("D2")</div>
                                    <div class="text-[8px] font-bold text-gray-400 uppercase tracking-widest">Candidates</div>
                                </div>
                            </div>

                            <div class="flex-grow p-0 relative z-10 bg-white/60 backdrop-blur-sm">
                                @if (streamStudents.Any())
                                {
                                    <div class="divide-y divide-gray-50">
                                        @foreach (var enr in streamStudents.OrderBy(e => e.Student?.LastName))
                                        {
                                            string sName = enr.Student?.Name?.ToString() ?? "Record Unresolved";
                                            string sEmail = enr.Student?.User?.Email?.ToString() ?? "No Email";

                                            <div class="p-4 hover:bg-gray-50/80 transition-colors flex justify-between items-center group/item">
                                                <div class="max-w-[200px]">
                                                    <p class="text-xs font-bold text-gray-800 mb-0 group-hover/item:text-[#C21E2E] transition-colors truncate">@sName</p>
                                                    <p class="text-[10px] text-gray-400 font-monospace tracking-tighter uppercase opacity-70">@sEmail</p>
                                                </div>
                                                <div class="flex flex-col items-end gap-1">
                                                    @if (enr.TakesMathematics)
                                                    {
                                                        <span class="text-[7px] font-bold uppercase tracking-widest text-white bg-gray-900 px-2 py-1">Core Math</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-[7px] font-bold uppercase tracking-widest text-gray-400 border border-gray-200 px-2 py-1">Math Lit</span>
                                                    }
                                                </div>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <div class="text-center p-16">
                                        <i class="bi bi-slash-circle text-gray-100 text-6xl mb-2 block"></i>
                                        <p class="text-[10px] uppercase tracking-widest font-bold text-gray-300">Vacant Stream</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<style>
    .font-serif { font-family: 'Playfair Display', serif !important; }
    html { scroll-behavior: smooth; }
    
    .ac-card {
        background: #fff;
        border: 1px solid #f0f0f0;
        border-radius: 0;
        transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .ac-card:hover {
        transform: translateY(-10px);
    }

    /* Red thread detail on the dossier cards */
    .ac-card::after {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 2px;
        background: var(--mh-red);
        transform: scaleX(0);
        transition: transform 0.4s ease;
        transform-origin: left;
    }

    .ac-card:hover::after {
        transform: scaleX(1);
    }
</style>
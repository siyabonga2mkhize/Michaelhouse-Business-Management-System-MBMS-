@model List<Michaelhouse.Models.AttendanceRecordViewModel>
@{
    ViewBag.Title = "Student Attendance Register";
    var summary = ViewBag.AttendanceSummary as List<Michaelhouse.Models.ViewModels.AttendanceSummaryViewModel>;
}

<div class="container mx-auto px-4 py-6">
    <div class="flex justify-between items-center mb-6">
        <h2 class="text-2xl font-bold">Student Attendance Register</h2>
        <a href="@Url.Action("Dashboard", "Admin")" class="bg-gray-500 hover:bg-gray-600 text-white px-4 py-2 rounded text-sm">Back to Dashboard</a>
    </div>

    @* Filter form *@
    @using (Html.BeginForm("StudentAttendanceHistory", "Admin", FormMethod.Get, new { @class = "grid grid-cols-1 md:grid-cols-5 gap-4 mb-6 items-end" }))
    {
        <div>
            <label class="block text-sm font-medium text-gray-700">Subject</label>
            <select name="subjectId" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
                <option value="">All Subjects</option>
                @foreach (var s in ViewBag.Subjects as List<Michaelhouse.Models.Subject>)
                {
                    <option value="@s.SubjectId"  @((Context.Request.Query["subjectId"] == s.SubjectId.ToString()) ? "selected=\"selected\"" : "")>
                        @s.Name (Gr @s.GradeLevel)
                    </option>
                }
            </select>
        </div>
        <div>
            <label class="block text-sm font-medium text-gray-700">Student</label>
            <select name="studentId" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
                <option value="">All Students</option>
                @foreach (var st in ViewBag.Students as List<Michaelhouse.Models.Student>)
                {
                    <option value="@st.StudentId"  @((Context.Request.Query["studentId"] == st.StudentId.ToString()) ? "selected=\"selected\"" : "")>
                        @st.FirstName @st.LastName (Gr @st.GradeLevel)
                    </option>
                }
            </select>
        </div>
        <div>
            <label class="block text-sm font-medium text-gray-700">From Date</label>
            <input type="date" name="fromDate" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" value="@(Context.Request.Query["fromDate"])" />
        </div>
        <div>
            <label class="block text-sm font-medium text-gray-700">To Date</label>
            <input type="date" name="toDate" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" value="@(Context.Request.Query["toDate"])" />
        </div>
        <div class="flex gap-2">
            <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded text-sm w-full">Filter</button>
            <a href="@Url.Action("StudentAttendanceHistory", "Admin")" class="bg-gray-300 hover:bg-gray-400 text-gray-800 px-4 py-2 rounded text-sm text-center w-full">Reset</a>
        </div>
    }

    @* Summary Table with clickable subjects *@
    <div class="bg-white shadow overflow-hidden rounded-lg mb-8">
        <div class="px-4 py-5 sm:px-6 bg-gray-50 border-b">
            <h3 class="text-lg leading-6 font-medium text-gray-900">Attendance Summary by Subject</h3>
            <p class="mt-1 text-sm text-gray-500">Click on a subject name to see detailed records</p>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Student</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Grade</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Subject</th>
                        <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Total Classes</th>
                        <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase tracking-wider">Present/Late</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Attendance %</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @if (summary != null && summary.Any())
                    {
                        foreach (var item in summary)
                        {
                            <tr>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@item.StudentName</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@item.GradeLevel</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-blue-600 hover:text-blue-800 cursor-pointer">
                                    <a href="#" class="subject-detail-link"
                                       data-studentid="@item.StudentId"
                                       data-subjectid="@item.SubjectId"
                                       data-studentname="@item.StudentName"
                                       data-subjectname="@item.SubjectName">
                                        @item.SubjectName
                                    </a>
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-center text-gray-900">@item.TotalClasses</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-center text-gray-900">@item.PresentCount</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm">
                                    <div class="w-full bg-gray-200 rounded-full h-2.5">
                                        <div class="h-2.5 rounded-full @(item.AttendancePercentage >= 75 ? "bg-green-600" : item.AttendancePercentage >= 50 ? "bg-yellow-500" : "bg-red-600")" style="width: @item.AttendancePercentage%"></div>
                                    </div>
                                    <span class="text-xs text-gray-500 ml-2">@item.AttendancePercentage%</span>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="px-6 py-4 text-center text-gray-500">No data for selected filters.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* Detailed log table (unchanged except Tailwind classes) *@
    <div class="bg-white shadow overflow-hidden rounded-lg">
        <div class="px-4 py-5 sm:px-6 bg-gray-50 border-b">
            <h3 class="text-lg leading-6 font-medium text-gray-900">Detailed Attendance Log</h3>
        </div>
        <div class="overflow-x-auto">
            <table class="min-w-full divide-y divide-gray-200">
                <thead class="bg-gray-50">
                    <tr>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Date</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Student</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Grade</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Subject</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                        <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Recorded By</th>
                    </tr>
                </thead>
                <tbody class="bg-white divide-y divide-gray-200">
                    @if (Model != null && Model.Any())
                    {
                        foreach (var att in Model)
                        {
                            <tr>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@att.Date.ToString("dd MMM yyyy")</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@att.StudentName</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@att.StudentGrade</td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@att.SubjectName</td>
                                <td class="px-6 py-4 whitespace-nowrap">
                                    @if (att.Status == Michaelhouse.Models.AttendanceStatus.Present)
                                    {
                                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">Present</span>
                                    }
                                    else if (att.Status == Michaelhouse.Models.AttendanceStatus.Absent)
                                    {
                                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">Absent</span>
                                    }
                                    else if (att.Status == Michaelhouse.Models.AttendanceStatus.Late)
                                    {
                                        <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">Late</span>
                                    }
                                </td>
                                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@att.RecordedBy</td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="px-6 py-4 text-center text-gray-500">No attendance records found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* Custom Tailwind Modal *@
<div id="attendanceModal" class="fixed inset-0 z-50 hidden overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
        <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" aria-hidden="true"></div>
        <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>
        <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
            <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
                <div class="sm:flex sm:items-start">
                    <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left w-full">
                        <h3 class="text-lg leading-6 font-medium text-gray-900" id="modalTitle">Attendance Details</h3>
                        <div class="mt-2" id="modalContent">
                            <p class="text-sm text-gray-500">Loading...</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="bg-gray-50 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse">
                <button type="button" class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm" id="closeModalBtn">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Modal handling with vanilla JS
        const modal = document.getElementById('attendanceModal');
        const modalTitle = document.getElementById('modalTitle');
        const modalContent = document.getElementById('modalContent');
        const closeModalBtn = document.getElementById('closeModalBtn');

        function openModal() {
            modal.classList.remove('hidden');
        }

        function closeModal() {
            modal.classList.add('hidden');
            modalContent.innerHTML = '<p class="text-sm text-gray-500">Loading...</p>';
        }

        closeModalBtn.addEventListener('click', closeModal);
        // Click outside to close
        modal.addEventListener('click', (e) => {
            if (e.target === modal) closeModal();
        });

        // Attach click handlers to subject links
        document.querySelectorAll('.subject-detail-link').forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                const studentId = this.dataset.studentid;
                const subjectId = this.dataset.subjectid;
                const studentName = this.dataset.studentname;
                const subjectName = this.dataset.subjectname;

                modalTitle.innerText = `Attendance: ${studentName} - ${subjectName}`;
                modalContent.innerHTML = '<div class="flex justify-center"><div class="animate-spin rounded-full h-8 w-8 border-b-2 border-gray-900"></div></div>';
                openModal();

                fetch(`@Url.Action("GetSubjectAttendanceDetails", "Admin")?studentId=${studentId}&subjectId=${subjectId}`)
                    .then(response => response.text())
                    .then(html => {
                        modalContent.innerHTML = html;
                    })
                    .catch(() => {
                        modalContent.innerHTML = '<p class="text-red-500">Error loading data.</p>';
                    });
            });
        });
    </script>
}
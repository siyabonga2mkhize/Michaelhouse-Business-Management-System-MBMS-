@model Michaelhouse.Models.Application
@using Michaelhouse.Models.Enums
@{
    ViewBag.Title = "Application Status";
    var adminReview = Model.AdminReviews?.OrderByDescending(r => r.Date).FirstOrDefault();

    // Percentage for the refined progress bar
    int pct = Model.Status == ApplicationStatus.Pending ? 5
            : Model.Status == ApplicationStatus.UnderAiReview ? 35
            : Model.Status == ApplicationStatus.AwaitingAdminDecision ? 70
            : Model.Status == ApplicationStatus.Flagged ? 70 : 100;

    // Helper for display
    string studentName = Model.Student != null ? Model.Student.Name : "Student";

    // Outcome Logic
    bool isApproved = Model.Status == ApplicationStatus.Approved;
    bool isRejected = Model.Status == ApplicationStatus.Rejected;
    bool isFlagged = Model.Status == ApplicationStatus.Flagged;
    bool isPending = !isApproved && !isRejected && !isFlagged;
}

<div class="mb-12 d-flex justify-content-between align-items-end border-b border-gray-100 pb-8">
    <div>
        <div class="flex items-center gap-2 mb-3">
            <div class="h-1 w-8 bg-[#C21E2E]"></div>
            <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Application Tracking</h5>
        </div>
        <h2 class="text-4xl font-serif font-bold text-gray-900 tracking-tight">Status of MH-@Model.AppId</h2>
        <p class="text-xs text-gray-400 mt-1 uppercase tracking-widest font-bold">Submitted @Model.Date.ToString("dd MMM yyyy")</p>
    </div>
    <a href="@Url.Action("Index", "Applications")" class="text-[10px] uppercase font-bold tracking-widest text-gray-400 hover:text-[#C21E2E] transition-all">
        <i class="bi bi-arrow-left me-1"></i> Back to List
    </a>
</div>

<div class="mb-16 relative px-4">
    <div class="absolute top-5 left-0 w-full h-[2px] bg-gray-100"></div>
    <div class="absolute top-5 left-0 h-[2px] bg-[#C21E2E] transition-all duration-1000" style="width: @pct%"></div>

    <div class="row relative z-10">
        @{
            var steps = new[] {
                new { Label = "Submission", Sub = "Received", Icon = "bi-send", Val = 0 },
                new { Label = "Neural Scan", Sub = "AI Analysis", Icon = "bi-cpu", Val = 1 },
                new { Label = "Review", Sub = "Admissions Board", Icon = "bi-shield-check", Val = 2 },
                new { Label = "Outcome", Sub = "Final Decision", Icon = "bi-mortarboard", Val = 3 }
            };
        }
        @foreach (var step in steps)
        {
            bool isActive = (int)Model.Status >= step.Val;
            <div class="col-3 text-center">
                <div class="w-10 h-10 mx-auto rounded-full flex items-center justify-center border-2 transition-all duration-500 @(isActive ? "bg-[#C21E2E] border-[#C21E2E] text-white shadow-lg shadow-red-200" : "bg-white border-gray-100 text-gray-300")">
                    <i class="bi @step.Icon text-sm"></i>
                </div>
                <h6 class="mt-4 text-[10px] uppercase font-bold tracking-widest @(isActive ? "text-gray-900" : "text-gray-300")">@step.Label</h6>
                <p class="text-[9px] text-gray-400 italic">@step.Sub</p>
            </div>
        }
    </div>
</div>

<div class="row g-5">
    <div class="col-lg-4">
        <div class="space-y-6 sticky top-24">
            <div class="bg-[#FBFBFB] p-8 border border-gray-100 relative overflow-hidden">
                <i class="bi bi-person absolute -right-4 -top-4 text-black/5 text-7xl"></i>
                <h5 class="text-[10px] uppercase tracking-[3px] font-bold text-gray-400 mb-6">Student File</h5>
                <div class="space-y-4">
                    <div>
                        <label class="block text-[9px] uppercase font-bold text-gray-300 tracking-widest">Candidate</label>
                        <p class="text-sm font-bold">@studentName</p>
                    </div>
                    <div>
                        <label class="block text-[9px] uppercase font-bold text-gray-300 tracking-widest">Applying For</label>
                        <p class="text-sm font-bold font-serif">Grade @Model.GradeApplying, @Model.ApplicationYear</p>
                    </div>
                </div>
            </div>

            <div class="ps-4 border-l border-gray-100">
                <h5 class="text-[10px] uppercase tracking-[3px] font-bold text-gray-400 mb-4">Verification Docs</h5>
                <ul class="space-y-3">
                    @foreach (var d in Model.Documents)
                    {
                        <li class="flex items-center gap-3">
                            <i class="bi bi-file-earmark-check text-[#C21E2E]"></i>
                            <span class="text-[11px] font-bold uppercase text-gray-600">@d.Type</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        @if (isApproved)
        {
            <div class="bg-white border border-green-100 p-10 shadow-2xl shadow-green-900/5 relative overflow-hidden text-center">
                <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: radial-gradient(#10b981 1px, transparent 1px); background-size: 20px 20px;"></div>
                <i class="bi bi-stars absolute -right-4 -top-4 text-green-500/10 text-8xl"></i>

                <div class="relative z-10">
                    <div class="w-20 h-20 bg-green-500 rounded-full flex items-center justify-center text-white mx-auto mb-6 shadow-xl">
                        <i class="bi bi-check-lg text-4xl"></i>
                    </div>
                    <h3 class="text-4xl font-serif font-bold text-gray-900 mb-4">Welcome to Michaelhouse</h3>
                    <p class="text-gray-500 italic font-serif leading-relaxed max-w-lg mx-auto mb-8">
                        Congratulations. We are pleased to inform you that @studentName's application has been successful.
                    </p>
                    <a href="@Url.Action("Index", "Registration", new { appId = Model.AppId })" class="bg-[#C21E2E] text-white px-12 py-4 font-bold uppercase tracking-[4px] text-[11px] hover:bg-black transition-all d-inline-block shadow-lg active:scale-95">
                        Begin Formal Registration
                    </a>
                </div>
            </div>
        }
        else if (isRejected)
        {
            <div class="bg-white border border-gray-200 p-12 text-center shadow-sm">
                <i class="bi bi-x-circle text-red-100 text-6xl mb-6 d-block"></i>
                <h4 class="font-serif text-2xl text-gray-800">Application Update</h4>
                <p class="text-gray-400 text-sm mt-4 italic leading-relaxed">
                    We regret to inform you that we are unable to proceed with this application at this time.
                    Official correspondence has been sent to your registered email.
                </p>
            </div>
        }
        else if (isFlagged)
        {
            <div class="bg-amber-50 border border-amber-200 p-10 relative overflow-hidden">
                <i class="bi bi-exclamation-triangle absolute -right-6 -bottom-6 text-amber-500/10 text-9xl rotate-12"></i>
                <div class="relative z-10">
                    <span class="bg-amber-500 text-white text-[9px] font-bold uppercase tracking-widest px-3 py-1 mb-4 d-inline-block">Action Required</span>
                    <h4 class="text-2xl font-serif text-amber-900 mb-2">Further Information Required</h4>
                    <p class="text-amber-800 text-sm italic">Our board has flagged this application for further clarification. Please check the message below.</p>
                </div>
            </div>
        }
        else
        {
            <div class="bg-white border border-gray-100 p-12 text-center shadow-sm relative overflow-hidden">
                <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 24px 24px;"></div>
                <div class="spinner-border text-[#C21E2E] mb-6" style="width: 3rem; height: 3rem; border-width: .2em;"></div>
                <h4 class="text-xl font-serif font-bold text-gray-900 mb-2">Review in Progress</h4>
                <p class="text-gray-400 text-[10px] uppercase tracking-[3px] font-bold">Secure Processing Environment</p>
                <div class="mt-8">
                    <a href="@Url.Action("Status", "Applications", new { id = Model.AppId })" class="text-[9px] font-bold text-gray-400 uppercase tracking-widest border-b border-gray-100 hover:text-[#C21E2E] transition-all">
                        <i class="bi bi-arrow-clockwise me-1"></i> Force Refresh
                    </a>
                </div>
            </div>
        }

        @if (adminReview != null && !string.IsNullOrEmpty(adminReview.AdminNotes))
        {
            <div class="mt-10 pt-10 border-t border-gray-100">
                <div class="flex items-center gap-2 mb-6">
                    <i class="bi bi-chat-left-quote text-[#C21E2E]"></i>
                    <h5 class="text-[10px] uppercase tracking-[3px] font-bold text-gray-900">Official Correspondence</h5>
                </div>
                <div class="ps-8 border-l-2 border-gray-100">
                    <p class="text-md font-serif italic text-gray-600 leading-relaxed mb-4">"@adminReview.AdminNotes"</p>
                    <p class="text-[9px] uppercase font-bold text-gray-400 tracking-widest">Admissions Office &mdash; @adminReview.Date.ToString("dd MMM yyyy")</p>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }
</style>
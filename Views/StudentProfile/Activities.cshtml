@model Michaelhouse.Models.StudentProfileActivitiesViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Student Profile - Activities";
}

<section class="p-8 max-w-4xl mx-auto">

    <h1 class="text-3xl font-serif font-bold mb-2">
        Student Profile
    </h1>

    <p class="text-sm text-gray-500 mb-6">
        Step 3 of 5 - Activities for @Model.StudentName
    </p>

    <div class="bg-white rounded shadow p-6">

        @using (Html.BeginForm("Activities", "StudentProfile", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.HiddenFor(m => m.AppId)
            @Html.HiddenFor(m => m.StudentId)


            <div class="space-y-6">

                <!-- SPORT -->
                <div>

                    <label class="block">
                        <span class="text-sm font-semibold text-gray-600">
                            Main Sport
                        </span>

                        @Html.DropDownListFor(
                            m => m.Sports,
                            new SelectList(
                                new[]
                                {
                                    "Athletics",
                                    "Cricket",
                                    "Hockey",
                                    "Rugby",
                                    "Football",
                                    "Tennis",
                                    "Swimming",
                                    "Water Polo",
                                    "Basketball",
                                    "Golf",
                                    "Squash",
                                    "Rowing",
                                    "Cross Country",
                                    "None"
                                },
                                Model.Sports
                            ),
                            "Select a sport",
                            new
                            {
                                @class = "w-full px-4 py-2 border rounded mt-1"
                            }
                        )

                    </label>

                </div>


                <!-- CLUBS -->
                <div>

                    <span class="text-sm font-semibold text-gray-600 block mb-3">
                        Clubs & Societies
                    </span>

                    <p class="text-sm text-gray-500 mb-4">
                        Select all clubs and societies that interest you.
                    </p>


                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">

                        @{
                            var clubs = new[]
                            {
                                "Chess",
                                "Debate",
                                "Coding & Robotics",
                                "Music",
                                "Drama",
                                "Art",
                                "Photography",
                                "Community Service",
                                "Entrepreneurship",
                                "Christian Fellowship",
                                "Environmental Club",
                                "Public Speaking"
                            };
                        }

                        @foreach (var club in clubs)
                        {
                            var isSelected =
                                Model.ClubsSelected != null &&
                                Model.ClubsSelected.Contains(club);

                            <label class="flex items-center gap-3 p-3 border rounded hover:bg-gray-50 cursor-pointer">

                                <input type="checkbox"
                                       name="ClubsSelected"
                                       value="@club"
                                       @(isSelected ? "checked" : "")
                                       class="w-4 h-4" />

                                <span class="text-sm">
                                    @club
                                </span>

                            </label>
                        }

                    </div>

                </div>


                <!-- LEADERSHIP -->
                <div>

                    <label class="block">

                        <span class="text-sm font-semibold text-gray-600">
                            Leadership Roles
                        </span>

                        @Html.TextAreaFor(
                            m => m.LeadershipRoles,
                            new
                            {
                                @class = "w-full px-4 py-2 border rounded mt-1",
                                rows = 3,
                                placeholder = "e.g. Prefect, Team Captain, Class Representative"
                            }
                        )

                    </label>

                </div>


                <!-- CULTURAL -->
                <div>

                    <label class="block">

                        <span class="text-sm font-semibold text-gray-600">
                            Cultural Activities
                        </span>

                        @Html.TextAreaFor(
                            m => m.CulturalActivities,
                            new
                            {
                                @class = "w-full px-4 py-2 border rounded mt-1",
                                rows = 3,
                                placeholder = "e.g. Choir, Drama, Traditional Dance"
                            }
                        )

                    </label>

                </div>

            </div>


            <!-- NAVIGATION -->

            <div class="flex justify-between mt-6">

                <a href="@Url.Action("Academic", new { appId = Model.AppId })"
                   class="px-5 py-2 border rounded">
                    Back
                </a>

                <button type="submit"
                        class="px-5 py-2 bg-[#C21E2E] text-white rounded hover:opacity-90">
                    Next
                </button>

            </div>
        }

    </div>

</section>
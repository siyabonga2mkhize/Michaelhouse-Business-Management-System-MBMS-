@model Michaelhouse.Models.StudentProfileMedicalViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Student Profile - Medical And Accessibility";
}

@* --- INSTITUTIONAL HEADER --- *@
<div class="mb-6 d-flex justify-content-between align-items-end border-b border-gray-200 pb-6 flex-shrink-0 px-8 pt-8 bg-white shadow-sm relative z-10">

    <div>

        <div class="flex items-center gap-2 mb-3">
            <div class="h-[2px] w-8 bg-[#C21E2E]"></div>

            <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">
                Institutional Registry
            </h5>
        </div>

        <h2 class="text-5xl font-serif font-bold text-gray-900 tracking-tight">
            Student Profile
        </h2>

        <p class="text-[11px] font-mono text-gray-400 uppercase tracking-widest mt-2 mb-0">
            Phase 4 of 5: Health & Accessibility Parameters for @Model.StudentName
        </p>

    </div>


    @* Phase Tracking Indicator *@
    <div class="flex gap-2 pb-2">

        <div class="h-1 w-10 bg-gray-300"></div>

        <div class="h-1 w-10 bg-gray-300"></div>

        <div class="h-1 w-10 bg-gray-300"></div>

        <div class="h-1 w-10 bg-[#C21E2E] shadow-[0_0_8px_rgba(194,30,46,0.5)]"></div>

        <div class="h-1 w-10 bg-gray-200"></div>

    </div>

</div>


@* --- SCROLLABLE FORM SECTION --- *@
<div class="flex-grow min-h-0 overflow-y-auto custom-scrollbar px-8 pb-10 pt-4 flex justify-center">

    <div class="w-full max-w-4xl">

        @* --- OFFICIAL ONBOARDING FORM --- *@
        @using (Html.BeginForm(
            "Medical",
            "StudentProfile",
            FormMethod.Post,
            new
            {
                @class = "bg-white shadow-sm border border-gray-100 flex flex-col relative overflow-hidden group/form"
            }))
        {

            @Html.AntiForgeryToken()

            @Html.HiddenFor(m => m.AppId)

            @Html.HiddenFor(m => m.StudentId)

            @Html.HiddenFor(m => m.Step)

            @Html.HiddenFor(m => m.StudentName)


            @* Ghost Watermark *@
            <i class="bi bi-heart-pulse absolute -right-8 -bottom-12 text-9xl text-black opacity-[0.02] transition-transform duration-1000 group-hover/form:-rotate-12 group-hover/form:scale-[1.2] pointer-events-none z-0"></i>


            @* Archival Dot Grid Header *@
            <div class="p-6 border-b border-gray-100 bg-gray-50/50 flex justify-between items-center relative z-10">

                <div class="absolute inset-0 opacity-[0.05] pointer-events-none"
                     style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 20px 20px;">
                </div>

                <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-900 mb-0 relative z-10">

                    <i class="bi bi-shield-plus me-2 text-gray-400"></i>

                    Clinical & Welfare Initialization

                </h5>

            </div>


            @* --- FORM CONTENT --- *@
            <div class="p-8 space-y-10 relative z-10">


                @* ====================================================== *@
                @* SECTION 1 - CLINICAL RECORDS *@
                @* ====================================================== *@

                <div>

                    <h6 class="text-[9px] uppercase tracking-[3px] font-bold text-[#C21E2E] border-b border-gray-100 pb-2 mb-6">
                        Clinical Records
                    </h6>


                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">


                        @* Medical Conditions *@
                        <div>

                            <label class="block text-[9px] uppercase tracking-[2px] font-bold text-gray-400 mb-2">

                                Medical Conditions

                            </label>

                            @Html.TextAreaFor(
                                m => m.MedicalConditions,
                                new
                                {
                                    @class = "w-full border-b-2 border-gray-200 py-3 outline-none focus:border-[#C21E2E] font-serif italic text-sm text-gray-900 transition-colors bg-transparent resize-y",
                                    rows = 3,
                                    placeholder = "List any chronic or significant medical conditions..."
                                }
                            )

                        </div>


                        @* Allergies *@
                        <div>

                            <label class="block text-[9px] uppercase tracking-[2px] font-bold text-gray-400 mb-2">

                                Critical Allergies

                            </label>

                            @Html.TextAreaFor(
                                m => m.Allergies,
                                new
                                {
                                    @class = "w-full border-b-2 border-gray-200 py-3 outline-none focus:border-[#C21E2E] font-serif italic text-sm text-gray-900 transition-colors bg-transparent resize-y",
                                    rows = 3,
                                    placeholder = "Specify food, environmental, or medication allergies..."
                                }
                            )

                        </div>


                        @* Emergency Medication *@
                        <div>

                            <label class="block text-[9px] uppercase tracking-[2px] font-bold text-gray-400 mb-2">

                                Emergency Medication

                            </label>

                            @Html.TextAreaFor(
                                m => m.EmergencyMedication,
                                new
                                {
                                    @class = "w-full border-b-2 border-gray-200 py-3 outline-none focus:border-[#C21E2E] font-serif italic text-sm text-gray-900 transition-colors bg-transparent resize-y",
                                    rows = 3,
                                    placeholder = "e.g., EpiPen, Asthma Inhaler, Insulin protocol..."
                                }
                            )

                        </div>


                        @* Disabilities *@
                        <div>

                            <label class="block text-[9px] uppercase tracking-[2px] font-bold text-gray-400 mb-2">

                                Registered Disabilities

                            </label>

                            @Html.TextAreaFor(
                                m => m.Disabilities,
                                new
                                {
                                    @class = "w-full border-b-2 border-gray-200 py-3 outline-none focus:border-[#C21E2E] font-serif italic text-sm text-gray-900 transition-colors bg-transparent resize-y",
                                    rows = 3,
                                    placeholder = "List physical, learning, or sensory disabilities..."
                                }
                            )

                        </div>

                    </div>

                </div>



                @* ====================================================== *@
                @* SECTION 2 - ACCESSIBILITY & ACCOMMODATIONS *@
                @* ====================================================== *@

                <div>

                    <h6 class="text-[9px] uppercase tracking-[3px] font-bold text-gray-500 border-b border-gray-100 pb-2 mb-6">

                        Accessibility & Accommodations

                    </h6>


                    @* Requirement Checkboxes *@
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">


                        @* Accessibility Required *@
                        <label class="flex items-center gap-4 bg-gray-50/50 border border-gray-200 p-4 cursor-pointer hover:bg-gray-50 transition-colors shadow-sm">

                            @Html.CheckBoxFor(
                                m => m.AccessibilityRequired,
                                new
                                {
                                    @class = "w-4 h-4 text-[#C21E2E] border-gray-300 rounded focus:ring-[#C21E2E] cursor-pointer"
                                }
                            )

                            <span class="text-[10px] uppercase tracking-[2px] font-bold text-gray-700">

                                Physical Accessibility Required

                            </span>

                        </label>


                        @* Medical Accommodation Required *@
                        <label class="flex items-center gap-4 bg-gray-50/50 border border-gray-200 p-4 cursor-pointer hover:bg-gray-50 transition-colors shadow-sm">

                            @Html.CheckBoxFor(
                                m => m.MedicalAccommodationRequired,
                                new
                                {
                                    @class = "w-4 h-4 text-[#C21E2E] border-gray-300 rounded focus:ring-[#C21E2E] cursor-pointer"
                                }
                            )

                            <span class="text-[10px] uppercase tracking-[2px] font-bold text-gray-700">

                                Medical Accommodation Required

                            </span>

                        </label>

                    </div>



                    @* Mobility Requirements *@
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">


                        <div class="md:col-span-2">

                            <label class="block text-[9px] uppercase tracking-[2px] font-bold text-gray-400 mb-2">

                                Mobility Requirements

                            </label>

                            @Html.TextAreaFor(
                                m => m.MobilityRequirements,
                                new
                                {
                                    @class = "w-full border-b-2 border-gray-200 py-3 outline-none focus:border-[#C21E2E] font-serif italic text-sm text-gray-900 transition-colors bg-transparent resize-y",
                                    rows = 2,
                                    placeholder = "Detail specific mobility constraints or equipment..."
                                }
                            )

                        </div>


                        @* Accessibility Notes *@
                        <div>

                            <label class="block text-[9px] uppercase tracking-[2px] font-bold text-gray-400 mb-2">

                                Accessibility Notes

                            </label>

                            @Html.TextAreaFor(
                                m => m.AccessibilityNotes,
                                new
                                {
                                    @class = "w-full border-b-2 border-gray-200 py-3 outline-none focus:border-[#C21E2E] font-serif italic text-sm text-gray-900 transition-colors bg-transparent resize-y",
                                    rows = 3,
                                    placeholder = "Expand on accessibility requests..."
                                }
                            )

                        </div>


                        @* Medical Accommodation Notes *@
                        <div>

                            <label class="block text-[9px] uppercase tracking-[2px] font-bold text-gray-400 mb-2">

                                Medical Accommodation Notes

                            </label>

                            @Html.TextAreaFor(
                                m => m.MedicalAccommodationNotes,
                                new
                                {
                                    @class = "w-full border-b-2 border-gray-200 py-3 outline-none focus:border-[#C21E2E] font-serif italic text-sm text-gray-900 transition-colors bg-transparent resize-y",
                                    rows = 3,
                                    placeholder = "Expand on medical accommodation parameters..."
                                }
                            )

                        </div>

                    </div>

                </div>

            </div>



            @* ====================================================== *@
            @* INSTITUTIONAL FOOTER ACTIONS *@
            @* ====================================================== *@

            <div class="bg-[#1a1a1a] p-6 flex justify-between items-center relative z-10 mt-4">


                <a href="@Url.Action("Activities", new { appId = Model.AppId })"
                   class="inline-block bg-transparent border border-white/10 text-gray-400 px-6 py-3 text-[10px] font-bold uppercase tracking-[2px] hover:bg-white/5 hover:text-white hover:border-white/40 transition-all duration-300">

                    <i class="bi bi-arrow-left me-2"></i>

                    Previous Phase

                </a>


                <button type="submit"
                        class="bg-[#C21E2E] text-white px-8 py-3 text-[10px] font-bold uppercase tracking-[3px] hover:bg-red-700 hover:shadow-[0_0_15px_rgba(194,30,46,0.4)] transition-all duration-300">

                    Save & Advance Phase

                    <i class="bi bi-arrow-right ms-2"></i>

                </button>

            </div>

        }

    </div>

</div>
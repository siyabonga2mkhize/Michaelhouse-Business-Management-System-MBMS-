@model Michaelhouse.Models.StudentProfilePersonalityViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Student Profile - Personality Assessment";
}

<section class="p-8 max-w-4xl mx-auto">

    <h1 class="text-3xl font-serif font-bold mb-2">
        Student Profile
    </h1>

    <p class="text-sm text-gray-500 mb-6">
        Step 5 of 5 - Personality Assessment for @Model.StudentName
    </p>

    <div class="bg-white rounded shadow p-6">

        @using (Html.BeginForm("Personality", "StudentProfile", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            @Html.HiddenFor(m => m.AppId)
            @Html.HiddenFor(m => m.StudentId)


            <div class="space-y-6">

                <!-- ENVIRONMENT -->

                <div>

                    <div class="font-semibold mb-3">
                        I prefer
                    </div>

                    <div class="flex flex-wrap gap-4">

                        <label class="flex items-center gap-2">
                            @Html.RadioButtonFor(
                                m => m.EnvironmentPreference,
                                "Quiet"
                            )
                            Quiet environments
                        </label>

                        <label class="flex items-center gap-2">
                            @Html.RadioButtonFor(
                                m => m.EnvironmentPreference,
                                "Busy"
                            )
                            Busy environments
                        </label>

                    </div>

                </div>


                <!-- ROUTINE -->

                <div>

                    <div class="font-semibold mb-3">
                        I usually
                    </div>

                    <div class="flex flex-wrap gap-4">

                        <label class="flex items-center gap-2">
                            @Html.RadioButtonFor(
                                m => m.RoutinePreference,
                                "WakeEarly"
                            )
                            Wake early
                        </label>

                        <label class="flex items-center gap-2">
                            @Html.RadioButtonFor(
                                m => m.RoutinePreference,
                                "SleepLate"
                            )
                            Sleep late
                        </label>

                    </div>

                </div>


                <!-- ACTIVITIES -->

                <div>

                    <div class="font-semibold mb-3">
                        I enjoy
                    </div>

                    <div class="flex flex-wrap gap-4">

                        <label class="flex items-center gap-2">
                            @Html.RadioButtonFor(
                                m => m.ActivityPreference,
                                "Team"
                            )
                            Team activities
                        </label>

                        <label class="flex items-center gap-2">
                            @Html.RadioButtonFor(
                                m => m.ActivityPreference,
                                "Independent"
                            )
                            Independent activities
                        </label>

                    </div>

                </div>


                <!-- STUDY -->

                <div>

                    <div class="font-semibold mb-3">
                        I study best
                    </div>

                    <div class="flex flex-wrap gap-4">

                        <label class="flex items-center gap-2">
                            @Html.RadioButtonFor(
                                m => m.StudyPreference,
                                "Alone"
                            )
                            Alone
                        </label>

                        <label class="flex items-center gap-2">
                            @Html.RadioButtonFor(
                                m => m.StudyPreference,
                                "SmallGroup"
                            )
                            Small group
                        </label>

                        <label class="flex items-center gap-2">
                            @Html.RadioButtonFor(
                                m => m.StudyPreference,
                                "LargeGroup"
                            )
                            Large group
                        </label>

                    </div>

                </div>


                <!-- SOCIAL -->

                <div>

                    <div class="font-semibold mb-3">
                        I describe myself as
                    </div>

                    <div class="flex flex-wrap gap-4">

                        <label class="flex items-center gap-2">
                            @Html.RadioButtonFor(
                                m => m.SocialPreference,
                                "Introverted"
                            )
                            Introverted
                        </label>

                        <label class="flex items-center gap-2">
                            @Html.RadioButtonFor(
                                m => m.SocialPreference,
                                "Balanced"
                            )
                            Balanced
                        </label>

                        <label class="flex items-center gap-2">
                            @Html.RadioButtonFor(
                                m => m.SocialPreference,
                                "Extroverted"
                            )
                            Extroverted
                        </label>

                    </div>

                </div>

            </div>


            @Html.ValidationSummary(
                false,
                "",
                new { @class = "text-sm text-red-600 mt-4" }
            )


            <!-- NAVIGATION -->

            <div class="flex justify-between mt-6">

                <a href="@Url.Action("Medical", new { appId = Model.AppId })"
                   class="px-5 py-2 border rounded">
                    Back
                </a>

                <button type="submit"
                        class="px-5 py-2 bg-[#C21E2E] text-white rounded hover:opacity-90">
                    Complete Profile
                </button>

            </div>

        }

    </div>

</section>
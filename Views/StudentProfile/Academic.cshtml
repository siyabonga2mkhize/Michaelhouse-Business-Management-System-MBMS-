@model Michaelhouse.Models.StudentProfileAcademicViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Student Profile - Academic Information";
}

<section class="p-8 max-w-4xl mx-auto">
    <h1 class="text-3xl font-serif font-bold mb-2">Student Profile</h1>
    <p class="text-sm text-gray-500 mb-6">Step 2 of 5 - Academic Information for @Model.StudentName</p>

    <div class="bg-white rounded shadow p-6">
        @using (Html.BeginForm("Academic", "StudentProfile", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.AppId)
            @Html.HiddenFor(m => m.StudentId)
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <label class="block"><span class="text-sm font-semibold text-gray-600">Grade/Form</span>@Html.TextBoxFor(m => m.Grade, new { @class = "w-full px-4 py-2 border rounded mt-1" })@Html.ValidationMessageFor(m => m.Grade, "", new { @class = "text-sm text-red-600" })</label>
                <label class="block"><span class="text-sm font-semibold text-gray-600">Learning Style</span>@Html.DropDownListFor(m => m.LearningStyle, new SelectList(new[] { "Visual", "Practical", "Reading", "Mixed" }), "Select learning style", new { @class = "w-full px-4 py-2 border rounded mt-1" })@Html.ValidationMessageFor(m => m.LearningStyle, "", new { @class = "text-sm text-red-600" })</label>
                <label class="block md:col-span-2"><span class="text-sm font-semibold text-gray-600">Subjects</span>@Html.TextAreaFor(m => m.Subjects, new { @class = "w-full px-4 py-2 border rounded mt-1", rows = 3 })</label>
                <label class="block"><span class="text-sm font-semibold text-gray-600">Academic Interests</span>@Html.TextAreaFor(m => m.AcademicInterests, new { @class = "w-full px-4 py-2 border rounded mt-1", rows = 3 })</label>
                <label class="block"><span class="text-sm font-semibold text-gray-600">Academic Stream</span>@Html.TextBoxFor(m => m.AcademicStream, new { @class = "w-full px-4 py-2 border rounded mt-1" })</label>
            </div>
            <div class="flex justify-between mt-6"><a href="@Url.Action("Basic", new { appId = Model.AppId })" class="px-5 py-2 border rounded">Back</a><button type="submit" class="px-5 py-2 bg-[#C21E2E] text-white rounded">Next</button></div>
        }
    </div>
</section>

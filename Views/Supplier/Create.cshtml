@model Michaelhouse.Models.Supplier
@{
    bool isEdit = Model?.SupplierId > 0;
    ViewBag.Title = isEdit ? "Modify Vendor Registry" : "Vendor Enrollment";
}

<link rel="stylesheet" href="~/Content/academic.css" />

<div class="ac-page">
    @* --- INSTITUTIONAL HEADER (Refined Spacing) --- *@
    <div class="mb-10 d-flex justify-content-between align-items-end border-b border-gray-100 pb-8">
        <div>
            <div class="flex items-center gap-2 mb-3">
                <div class="h-[2px] w-8 bg-[#C21E2E]"></div>
                <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Logistics & Supply Division</h5>
            </div>
            <h1 class="text-5xl font-serif font-bold text-gray-900 tracking-tight">@ViewBag.Title</h1>
        </div>
        <div class="text-right">
            <a href="@Url.Action("Index")" class="inline-block bg-white border border-gray-200 px-6 py-2 text-[9px] font-bold uppercase tracking-[2px] hover:bg-gray-50 transition-all shadow-sm">
                <i class="bi bi-arrow-left me-2"></i> Return to Registry
            </a>
        </div>
    </div>

    @using (Html.BeginForm(isEdit ? "Edit" : "Create", "Supplier", FormMethod.Post, new { @class = "animate-form" }))
    {
        @Html.AntiForgeryToken()

        if (!ViewData.ModelState.IsValid)
        {
            <div class="bg-red-50 text-red-700 p-4 border-l-4 border-red-600 text-xs mb-8 font-bold uppercase tracking-wider">
                <i class="bi bi-exclamation-octagon-fill me-2"></i>
                @Html.ValidationSummary(true, "Registry Validation Error:")
            </div>
        }

        if (isEdit)
        { @Html.HiddenFor(m => m.SupplierId) }

    <div class="row g-5">
        @* --- LEFT COLUMN: COMPANY DOSSIER --- *@
        <div class="col-lg-6">
            <div class="bg-white shadow-sm border border-gray-100 overflow-hidden relative h-full">
                @* Archival Dot Grid Header *@
                <div class="p-6 border-b border-gray-100 relative bg-white overflow-hidden">
                    <div class="absolute inset-0 opacity-[0.05] pointer-events-none"
                         style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 20px 20px;"></div>
                    <div class="relative z-10 flex items-center">
                        <i class="bi bi-building-fill me-3 text-gray-400"></i>
                        <h5 class="text-xs uppercase tracking-[4px] font-bold text-gray-900 mb-0">01. Corporate Identity</h5>
                    </div>
                </div>

                <div class="p-10 space-y-8">
                    <div class="ac-field">
                        <label class="ac-label">Company Legal Name <span class="text-[#C21E2E]">*</span></label>
                        @Html.TextBoxFor(m => m.Name, new { @class = "ac-input-line", placeholder = "As per Registry" })
                        @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-[#C21E2E] text-[10px] font-bold uppercase mt-1" })
                    </div>

                    <div class="ac-field">
                        <label class="ac-label">Designated Contact Person</label>
                        @Html.TextBoxFor(m => m.ContactPerson, new { @class = "ac-input-line font-serif italic", placeholder = "Full Name" })
                    </div>

                    <div class="ac-field">
                        <label class="ac-label">Official Communication Email</label>
                        @Html.TextBoxFor(m => m.Email, new { @class = "ac-input-line font-mono", type = "email", placeholder = "orders@vendor.co.za" })
                        <p class="text-[9px] text-gray-400 mt-2 italic font-serif">Automated Procurement Orders (POs) will be routed to this address.</p>
                    </div>

                    <div class="grid grid-cols-2 gap-8">
                        <div class="ac-field">
                            <label class="ac-label">Phone Registry</label>
                            @Html.TextBoxFor(m => m.Phone, new { @class = "ac-input-line font-mono", placeholder = "+27 ..." })
                        </div>
                        <div class="ac-field">
                            <label class="ac-label">Digital Presence (URL)</label>
                            @Html.TextBoxFor(m => m.Website, new { @class = "ac-input-line text-blue-600", placeholder = "https://..." })
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* --- RIGHT COLUMN: TERMS & LOGISTICS --- *@
        <div class="col-lg-6">
            <div class="bg-white shadow-sm border border-gray-100 overflow-hidden relative h-full">
                @* Archival Dot Grid Header *@
                <div class="p-6 border-b border-gray-100 relative bg-white overflow-hidden">
                    <div class="absolute inset-0 opacity-[0.05] pointer-events-none"
                         style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 20px 20px;"></div>
                    <div class="relative z-10 flex items-center">
                        <i class="bi bi-geo-alt-fill me-3 text-[#C21E2E]"></i>
                        <h5 class="text-xs uppercase tracking-[4px] font-bold text-gray-900 mb-0">02. Logistics & Credit Terms</h5>
                    </div>
                </div>

                <div class="p-10 space-y-8">
                    <div class="ac-field">
                        <label class="ac-label">Physical Distribution Address</label>
                        @Html.TextAreaFor(m => m.Address, new { @class = "ac-input-line italic font-serif", rows = "4", placeholder = "Full street address..." })
                    </div>

                    <div class="ac-field">
                        <label class="ac-label">Standard Payment Terms (Days)</label>
                        @Html.TextBoxFor(m => m.PaymentTermsDays, new { @class = "ac-input-line font-mono text-2xl", type = "number", min = "0" })
                        <p class="text-[9px] text-gray-400 mt-2 uppercase tracking-widest font-bold">Determines net-payment cycles for the bursary.</p>
                    </div>

                    @if (isEdit)
                    {
                        <div class="pt-6 border-t border-gray-50">
                            <label class="flex items-center gap-3 cursor-pointer group">
                                <div class="relative">
                                    @Html.CheckBoxFor(m => m.IsActive, new { @class = "sr-only peer" })
                                    <div class="w-10 h-5 bg-gray-100 rounded-full peer peer-checked:bg-[#C21E2E] transition-all"></div>
                                    <div class="absolute left-1 top-1 bg-white w-3 h-3 rounded-full peer-checked:translate-x-5 transition-all shadow-sm"></div>
                                </div>
                                <span class="text-[10px] font-bold uppercase tracking-widest text-gray-400 group-hover:text-gray-900 transition-colors">Vendor Authorization Status</span>
                            </label>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* --- SUBMIT ACTION (Institutional Style) --- *@
        <div class="col-12 mt-12">
            <button type="submit" class="w-full bg-gray-900 text-white py-5 font-bold uppercase tracking-[5px] text-[11px] hover:bg-[#C21E2E] transition-all shadow-xl active:scale-[0.98]">
                <i class="bi bi-shield-check me-3"></i> Authorize & Seal Registry Entry
            </button>
            <p class="text-center mt-6 text-gray-300 text-[9px] uppercase tracking-[3px]">
                Logistics & Supply Division • Michaelhouse Institutional Archive
            </p>
        </div>
    </div>
}
</div>

<style>
    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }

    .font-mono {
        font-family: 'Source Code Pro', monospace !important;
    }

    /* Registry Input Styling */
    .ac-input-line {
        width: 100%;
        border: none;
        border-bottom: 1px solid #f0f0f0;
        background: transparent;
        padding: 12px 0;
        font-size: 14px;
        font-weight: 600;
        transition: all 0.3s ease;
        outline: none !important;
        border-radius: 0;
    }

        .ac-input-line:focus {
            border-bottom-color: #C21E2E;
        }

    .ac-label {
        display: block;
        font-size: 9px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 2px;
        color: #bbb;
        margin-bottom: 4px;
    }
</style>
@using Michaelhouse.Services
@using Michaelhouse.Models.Cafeteria
@model IngredientPurchaseOrder
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Model.PoNumber;

    var deliveries = ViewBag.Deliveries as List<IngredientDelivery> ?? new List<IngredientDelivery>();
    var shortfallOrders = ViewBag.ShortfallOrders as List<IngredientPurchaseOrder> ?? new List<IngredientPurchaseOrder>();
    var otherSuppliers = ViewBag.OtherSuppliers as List<Michaelhouse.Models.Supplier> ?? new List<Michaelhouse.Models.Supplier>();

    var s = Model.Status;
    bool isDraft = s == IngredientOrderStatus.Draft;
    bool isOpen = s == IngredientOrderStatus.Pending || s == IngredientOrderStatus.Confirmed || s == IngredientOrderStatus.PartiallyFulfilled;
    bool anyReceived = Model.Lines.Any(l => l.QuantityReceived > 0m);
    var lines = Model.Lines.OrderBy(l => l.Ingredient.Name).ToList();
    var openShortfalls = lines.Where(l => l.Shortfall > 0m && l.ShortfallAction == ShortfallAction.None).ToList();
    Func<decimal, string, string> shown = (q, unit) => IngredientUnits.ToDisplay(q, unit).ToString("0.###", System.Globalization.CultureInfo.InvariantCulture);
}

@* --- FULL SCREEN VIEWPORT CONTAINER --- *@
<div class="flex flex-col h-full w-full overflow-hidden bg-gray-50/30">

    @* --- INSTITUTIONAL HEADER --- *@
    <div class="mb-6 d-flex justify-content-between align-items-end border-b border-gray-200 pb-6 flex-shrink-0 px-8 pt-8 bg-white shadow-sm relative z-10">
        <div>
            <div class="flex items-center gap-2 mb-3">
                <div class="h-[2px] w-8 bg-[#C21E2E]"></div>
                <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Logistics & Supply</h5>
            </div>
            <div class="flex items-center gap-4 mb-2">
                <h2 class="text-5xl font-mono font-bold text-gray-900 tracking-tight mb-0">@Model.PoNumber</h2>
                <div class="mt-2">
                    @Html.Partial("_OrderStatusBadge", Model.Status)
                </div>
            </div>
            <p class="text-[11px] font-mono text-gray-500 uppercase tracking-widest mt-3 mb-0 leading-relaxed">
                <strong class="font-serif text-gray-900 font-bold text-sm">@(Model.Supplier != null ? Model.Supplier.Name : "Unassigned Vendor")</strong>
                <span class="mx-2 text-gray-300">|</span>
                Ordered: @Model.OrderDate.ToString("dd MMM yyyy")

                @if (Model.RequestedDeliveryDate.HasValue)
                {
                    <span class="mx-2 text-gray-300">|</span>
                    <span class="text-[#C21E2E] font-bold">Req: @Model.RequestedDeliveryDate.Value.ToString("ddd dd MMM")</span>
                }

                @if (!string.IsNullOrEmpty(ViewBag.CreatedBy as string))
                {
                    <span class="mx-2 text-gray-300">|</span>
                    <span>By: @ViewBag.CreatedBy</span>
                }
            </p>

            @if (Model.ShortfallOfOrderId.HasValue)
            {
                <div class="mt-2 text-[9px] font-mono uppercase tracking-widest text-amber-700 bg-amber-50 border border-amber-200 px-3 py-1.5 inline-block shadow-2xs">
                    <i class="bi bi-link-45deg me-1"></i> Re-order of a shortfall on <a href="@Url.Action("Details", "IngredientOrder", new { id = Model.ShortfallOfOrderId })" class="font-bold underline hover:text-amber-900">Original Order</a>
                </div>
            }
        </div>

        <div class="flex gap-3">
            @if (isDraft)
            {
                <a href="@Url.Action("Edit", "IngredientOrder", new { id = Model.Id })" class="inline-flex items-center justify-center bg-white border border-gray-300 text-gray-700 px-6 py-3 text-[10px] font-bold uppercase tracking-[2px] hover:bg-gray-50 hover:border-gray-400 transition-all duration-300 shadow-sm text-decoration-none">
                    <i class="bi bi-pencil-square me-2 text-sm"></i> Edit Draft
                </a>
                <form method="post" action="@Url.Action("Send", "IngredientOrder", new { id = Model.Id })" onsubmit="return confirm('Send this order to @(Model.Supplier != null ? Model.Supplier.Name : "the supplier")?');" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="inline-flex items-center justify-center bg-[#1a1a1a] text-white px-8 py-3 text-[10px] font-bold uppercase tracking-[3px] hover:bg-black hover:shadow-[0_0_15px_rgba(0,0,0,0.3)] transition-all duration-300">
                        <i class="bi bi-send me-2 text-sm"></i> Send To Supplier
                    </button>
                </form>
            }
            @if (isOpen)
            {
                <a href="@Url.Action("Record", "IngredientDelivery", new { orderId = Model.Id })" class="inline-flex items-center justify-center bg-[#C21E2E] text-white px-8 py-3 text-[10px] font-bold uppercase tracking-[3px] hover:bg-red-700 hover:shadow-[0_0_15px_rgba(194,30,46,0.3)] transition-all duration-300 text-decoration-none">
                    <i class="bi bi-box-arrow-in-down me-2 text-sm"></i> Record Delivery
                </a>
            }
        </div>
    </div>

    @* --- SCROLLABLE DATA SECTION --- *@
    <div class="flex-grow min-h-0 overflow-y-auto custom-scrollbar px-8 pb-10 pt-2 flex flex-col gap-6">

        @* --- SYSTEM ALERTS --- *@
        @if (isDraft)
        {
            <div class="bg-blue-50 border-l-4 border-blue-500 p-4 shadow-sm flex items-center">
                <i class="bi bi-info-circle-fill text-blue-600 text-xl me-3"></i>
                <span class="text-xs font-mono uppercase tracking-widest text-blue-900">Review the order below. It isn't dispatched until you execute <strong>Send to supplier</strong>.</span>
            </div>
        }
        else if (s == IngredientOrderStatus.Pending)
        {
            <div class="bg-blue-50 border-l-4 border-blue-500 p-4 shadow-sm flex items-center">
                <i class="bi bi-info-circle-fill text-blue-600 text-xl me-3"></i>
                <span class="text-xs font-mono uppercase tracking-widest text-blue-900">A test invoice is generated once the supplier's confirmed quantities are recorded below.</span>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.TestInvoiceFilePath))
        {
            <div class="bg-gray-50 border border-gray-300 p-4 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-4">
                <div class="flex items-center gap-4">
                    <i class="bi bi-file-earmark-pdf text-3xl text-[#C21E2E]"></i>
                    <div>
                        <div class="font-serif font-bold text-gray-900 text-base">Test Invoice: @Model.TestInvoiceNumber</div>
                        @if (Model.TestInvoiceGeneratedAt.HasValue)
                        {
                            <span class="text-[9px] font-mono uppercase tracking-widest text-gray-500">Updated @SchoolClock.FromUtc(Model.TestInvoiceGeneratedAt.Value).ToString("dd MMM yyyy HH:mm")</span>
                        }
                    </div>
                </div>
                <div class="flex flex-col md:flex-row items-start md:items-center gap-4">
                    <span class="text-[9px] font-mono uppercase tracking-widest text-gray-500 max-w-sm leading-relaxed">
                        Generated for testing: lists what the supplier still has to deliver. Print or photograph it, then scan it in the Record Delivery module.
                    </span>
                    <a href="@Url.Action("TestInvoice", "IngredientOrder", new { id = Model.Id })" class="inline-flex items-center bg-white border border-gray-300 text-gray-700 px-4 py-2 text-[9px] font-bold uppercase tracking-[2px] hover:bg-gray-100 transition-colors shadow-2xs whitespace-nowrap text-decoration-none">
                        <i class="bi bi-download me-1.5"></i> Download PDF
                    </a>
                </div>
            </div>
        }

        @if (openShortfalls.Count > 0)
        {
            <div class="bg-red-50 border border-[#C21E2E] p-5 shadow-sm">
                <div class="flex items-center gap-3 text-[#C21E2E] mb-2">
                    <i class="bi bi-exclamation-octagon-fill text-xl"></i>
                    <strong class="font-serif text-lg">Supply Chain Shortfall Detected</strong>
                </div>
                <p class="text-xs font-mono uppercase tracking-widest text-red-900 mb-0 leading-relaxed ps-8">
                    The supplier cannot fulfill the complete manifest: <strong class="font-bold">@string.Join(", ", openShortfalls.Select(l => l.Ingredient.Name + " short by " + IngredientUnits.Format(l.Shortfall, l.Ingredient.Unit)))</strong>. <br>Choose an operational resolution below.
                </p>
            </div>
        }

        @if (!string.IsNullOrEmpty(Model.Notes))
        {
            <div class="bg-white border-l-4 border-gray-400 p-4 shadow-sm text-sm font-serif text-gray-700 whitespace-pre-line italic">
                @Model.Notes
            </div>
        }

        @* --- 1. ORDER MANIFEST & CONFIRMATION LEDGER --- *@
        <form method="post" action="@Url.Action("Confirm", "IngredientOrder", new { id = Model.Id })" class="bg-white shadow-sm border border-gray-100 flex flex-col relative overflow-hidden group">
            @Html.AntiForgeryToken()
            <div class="p-5 border-b border-gray-100 bg-[#1a1a1a] flex justify-between items-center relative z-10 flex-shrink-0">
                <div>
                    <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-white mb-0">Procurement Manifest & Supplier Confirmations</h5>
                </div>
            </div>

            <div class="table-responsive flex-grow overflow-x-auto relative z-10">
                <table class="table align-middle mb-0 w-full border-collapse">
                    <thead class="bg-gray-50/90 backdrop-blur-sm">
                        <tr class="text-[9px] uppercase tracking-[3px] font-bold text-gray-500 border-b border-gray-200">
                            <th class="ps-6 py-4">Ingredient Asset</th>
                            <th class="text-end border-l border-gray-100 ps-4">Ordered</th>
                            <th class="text-end border-l border-gray-100 ps-4 bg-blue-50/50">Supplier Confirmed</th>
                            <th class="text-end border-l border-gray-100 ps-4">Received</th>
                            <th class="text-end border-l border-gray-100 ps-4 text-[#C21E2E]">Outstanding</th>
                            <th class="pe-6 border-l border-gray-100 ps-4">Shortfall Status</th>
                        </tr>
                    </thead>
                    <tbody class="text-gray-700">
                        @foreach (var l in lines)
                        {
                            string unit = l.Ingredient.Unit;
                            <tr class="hover:bg-gray-50/50 transition-colors border-b border-gray-50 last:border-0 h-16">
                                <td class="ps-6 py-2">
                                    <a href="@Url.Action("Ingredient", "CafeteriaInventory", new { id = l.IngredientId })" class="font-serif font-bold text-sm text-gray-900 hover:text-[#C21E2E] transition-colors text-decoration-none">
                                        @l.Ingredient.Name
                                    </a>
                                </td>

                                <td class="text-end border-l border-gray-50 ps-4 font-mono font-bold text-gray-900">
                                    @IngredientUnits.Format(l.QuantityOrdered, unit)
                                </td>

                                <td class="text-end border-l border-gray-50 ps-4 bg-blue-50/30">
                                    @if (isOpen && l.ShortfallAction != ShortfallAction.Reordered)
                                    {
                                        <div class="flex items-center justify-end gap-2">
                                            <input name="confirmed_@l.Id" class="border border-gray-300 py-1.5 px-2 font-mono text-xs font-bold text-gray-900 w-24 text-right outline-none focus:border-[#C21E2E] shadow-inner" inputmode="decimal"
                                                   value="@(l.QuantityConfirmed.HasValue ? shown(l.QuantityConfirmed.Value, unit) : "")"
                                                   placeholder="@shown(l.QuantityOrdered, unit)" />
                                            <span class="text-[9px] font-mono text-gray-400 uppercase tracking-widest w-8 text-left">@IngredientUnits.DisplayUnit(unit)</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="font-mono text-gray-600 text-xs">
                                            @(l.QuantityConfirmed.HasValue ? IngredientUnits.Format(l.QuantityConfirmed.Value, unit) : "—")
                                        </span>
                                    }
                                </td>

                                <td class="text-end border-l border-gray-50 ps-4 font-mono text-xs text-gray-500">
                                    @IngredientUnits.Format(l.QuantityReceived, unit)
                                </td>

                                <td class="text-end border-l border-gray-50 ps-4 font-mono font-bold text-[#C21E2E]">
                                    @(l.Outstanding > 0m ? IngredientUnits.Format(l.Outstanding, unit) : "—")
                                </td>

                                <td class="pe-6 border-l border-gray-50 ps-4">
                                    @if (l.Shortfall > 0m)
                                    {
                                        <div class="flex flex-col gap-1 items-start">
                                            <span class="inline-flex items-center text-[8px] font-bold uppercase tracking-widest px-2 py-0.5 border shadow-2xs @(l.ShortfallAction == ShortfallAction.None ? "bg-red-50 text-[#C21E2E] border-red-200" : "bg-gray-100 text-gray-500 border-gray-200")">
                                                @IngredientUnits.Format(l.Shortfall, unit) Short
                                            </span>

                                            @if (l.ShortfallAction == ShortfallAction.Accepted)
                                            {
                                                <span class="text-[8px] font-mono text-gray-500 uppercase tracking-widest">
                                                    Accepted@(string.IsNullOrEmpty(l.ShortfallNote) ? "" : ": " + l.ShortfallNote)
                                                </span>
                                            }
                                            else if (l.ShortfallAction == ShortfallAction.Reordered)
                                            {
                                                <a href="@Url.Action("Details", "IngredientOrder", new { id = l.ShortfallReorderedOnOrderId })" class="text-[8px] font-mono text-blue-600 uppercase tracking-widest hover:underline">
                                                    Re-Ordered: @l.ShortfallNote
                                                </a>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-gray-300 font-mono text-xs">—</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (isOpen)
            {
                <div class="bg-gray-50 border-t border-gray-100 p-5 flex justify-between items-center relative z-10 flex-shrink-0">
                    <span class="text-[9px] font-mono text-gray-500 uppercase tracking-widest"><i class="bi bi-info-circle me-1"></i> Enter quantities the supplier confirms they can fulfill. Less than ordered generates a shortfall.</span>
                    <button type="submit" class="bg-white border border-gray-300 text-gray-800 px-6 py-2.5 text-[9px] font-bold uppercase tracking-[2px] hover:bg-gray-100 transition-colors shadow-sm">
                        <i class="bi bi-save me-1.5"></i> Save Confirmations
                    </button>
                </div>
            }
        </form>

        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">

            @* --- 2. SHORTFALL RESOLUTION MODULE --- *@
            @if (openShortfalls.Count > 0)
            {
                <form method="post" action="@Url.Action("Shortfall", "IngredientOrder", new { id = Model.Id })" class="bg-white border-2 border-red-200 shadow-sm flex flex-col relative overflow-hidden h-fit">
                    @Html.AntiForgeryToken()
                    <div class="p-4 border-b border-red-100 bg-red-50 flex justify-between items-center relative z-10">
                        <h5 class="text-[10px] uppercase tracking-[3px] font-bold text-[#C21E2E] mb-0">Supplier Shortfall Resolution</h5>
                    </div>

                    <div class="p-6 flex flex-col gap-5">
                        <div class="flex flex-col gap-2">
                            @foreach (var l in openShortfalls)
                            {
                                <label class="flex items-center gap-3 cursor-pointer bg-white border border-gray-200 p-3 shadow-xs">
                                    <input type="checkbox" name="lineIds" value="@l.Id" checked class="w-4 h-4 text-[#C21E2E] border-gray-300 rounded focus:ring-[#C21E2E]" />
                                    <div>
                                        <div class="font-serif font-bold text-sm text-gray-900">
                                            @l.Ingredient.Name <span class="text-[#C21E2E] ml-2">Short by @IngredientUnits.Format(l.Shortfall, l.Ingredient.Unit)</span>
                                        </div>
                                        <div class="text-[9px] font-mono uppercase tracking-widest text-gray-500 mt-1">
                                            (Ordered @IngredientUnits.Format(l.QuantityOrdered, l.Ingredient.Unit), Confirmed @IngredientUnits.Format(l.QuantityConfirmed ?? 0m, l.Ingredient.Unit))
                                        </div>
                                    </div>
                                </label>
                            }
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5 mt-2">
                            <div>
                                <label class="block text-[9px] uppercase tracking-[2px] font-bold text-gray-500 mb-1.5">Route Shortfall To</label>
                                <select name="supplierId" class="w-full border-b-2 border-gray-200 py-2 outline-none focus:border-[#C21E2E] font-serif text-sm bg-transparent">
                                    <option value="">Automatic (Next Linked Vendor)</option>
                                    @foreach (var sup in otherSuppliers)
                                    {
                                        <option value="@sup.SupplierId">@sup.Name</option>
                                    }
                                </select>
                            </div>
                            <div>
                                <label class="block text-[9px] uppercase tracking-[2px] font-bold text-gray-500 mb-1.5">Acceptance Note</label>
                                <input name="note" class="w-full border-b-2 border-gray-200 py-2 outline-none focus:border-[#C21E2E] font-serif text-sm bg-transparent" maxlength="300" placeholder="e.g. Existing stock sufficient" />
                            </div>
                        </div>
                    </div>

                    <div class="p-4 bg-gray-50 border-t border-gray-100 mt-auto flex flex-col gap-3">
                        <div class="flex gap-3">
                            <button name="shortfallAction" value="reorder" class="flex-1 bg-[#1a1a1a] text-white px-4 py-2.5 text-[9px] font-bold uppercase tracking-[2px] hover:bg-black transition-colors shadow-sm">
                                <i class="bi bi-arrow-repeat me-1.5"></i> Re-Order Shortfall
                            </button>
                            <button name="shortfallAction" value="accept" class="flex-1 bg-white border border-gray-300 text-gray-700 px-4 py-2.5 text-[9px] font-bold uppercase tracking-[2px] hover:bg-gray-50 transition-colors shadow-sm">
                                Accept Lower Qty
                            </button>
                        </div>
                        <span class="text-[8px] font-mono text-gray-400 uppercase tracking-widest text-center">
                            Re-ordering generates secondary draft POs for your review.
                        </span>
                    </div>
                </form>
            }

            @* --- 3. MANUAL AMENDMENT MODULE --- *@
            @if (isOpen && lines.Any(x => x.ShortfallAction != ShortfallAction.Reordered))
            {
                <form method="post" action="@Url.Action("Amend", "IngredientOrder", new { id = Model.Id })" class="bg-white border-2 border-gray-200 shadow-sm flex flex-col relative overflow-hidden h-fit">
                    @Html.AntiForgeryToken()
                    <div class="p-4 border-b border-gray-100 bg-gray-50 flex justify-between items-center relative z-10">
                        <h5 class="text-[10px] uppercase tracking-[3px] font-bold text-gray-900 mb-0">Manual Line Amendment</h5>
                    </div>

                    <div class="p-6 flex flex-col gap-5">
                        <div>
                            <label class="block text-[9px] uppercase tracking-[2px] font-bold text-gray-500 mb-1.5">Target Line Item</label>
                            <select name="lineId" class="w-full border-b-2 border-gray-200 py-2 outline-none focus:border-[#C21E2E] font-serif text-sm bg-transparent" required>
                                <option value="">— Select Line —</option>
                                @foreach (var l in lines.Where(x => x.ShortfallAction != ShortfallAction.Reordered))
                                {
                                    <option value="@l.Id">@l.Ingredient.Name (Ordered: @IngredientUnits.Format(l.QuantityOrdered, l.Ingredient.Unit))</option>
                                }
                            </select>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                            <div>
                                <label class="block text-[9px] uppercase tracking-[2px] font-bold text-gray-500 mb-1.5">New Ordered Qty</label>
                                <input name="quantity" class="w-full border-b-2 border-gray-200 py-2 outline-none focus:border-[#C21E2E] font-mono font-bold text-sm bg-transparent" inputmode="decimal" required />
                            </div>
                            <div>
                                <label class="block text-[9px] uppercase tracking-[2px] font-bold text-gray-500 mb-1.5">Amendment Reason</label>
                                <input name="note" class="w-full border-b-2 border-gray-200 py-2 outline-none focus:border-[#C21E2E] font-serif text-sm bg-transparent" maxlength="300" placeholder="e.g. Phone agreement" required />
                            </div>
                        </div>
                    </div>

                    <div class="p-4 bg-gray-50 border-t border-gray-100 mt-auto">
                        <button class="w-full bg-white border border-gray-300 text-gray-700 px-4 py-2.5 text-[9px] font-bold uppercase tracking-[2px] hover:bg-gray-100 transition-colors shadow-sm">
                            <i class="bi bi-pencil-square me-1.5"></i> Commit Amendment
                        </button>
                    </div>
                </form>
            }

            @* --- SECONDARY DATA CARDS --- *@
            <div class="flex flex-col gap-6">
                @if (shortfallOrders.Count > 0)
                {
                    <div class="bg-white border-2 border-amber-200 shadow-sm p-5 relative overflow-hidden">
                        <h5 class="text-[10px] uppercase tracking-[3px] font-bold text-amber-800 mb-4">Generated Shortfall Re-Orders</h5>
                        <div class="flex flex-col gap-3">
                            @foreach (var so in shortfallOrders)
                            {
                                <div class="flex items-center gap-3 bg-amber-50/50 border border-amber-100 p-3">
                                    <a href="@Url.Action("Details", "IngredientOrder", new { id = so.Id })" class="font-mono text-sm font-bold text-amber-900 hover:underline">@so.PoNumber</a>
                                    <span class="text-xs font-serif text-gray-700 mx-1">@(so.Supplier != null ? so.Supplier.Name : "")</span>
                                    @Html.Partial("_OrderStatusBadge", so.Status)
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (deliveries.Count > 0)
                {
                    <div class="bg-white border-2 border-gray-200 shadow-sm p-5 relative overflow-hidden">
                        <h5 class="text-[10px] uppercase tracking-[3px] font-bold text-gray-900 mb-4">Linked Deliveries Log</h5>
                        <div class="flex flex-col gap-3">
                            @foreach (var d in deliveries)
                            {
                                <div class="flex items-center gap-3 bg-gray-50 border border-gray-100 p-3">
                                    <i class="bi bi-truck text-gray-400"></i>
                                    <a href="@Url.Action("Details", "IngredientDelivery", new { id = d.Id })" class="font-mono text-xs font-bold text-gray-900 hover:text-[#C21E2E] transition-colors">
                                        @SchoolClock.FromUtc(d.ReceivedAt).ToString("ddd dd MMM yyyy, HH:mm")
                                    </a>
                                    <span class="text-[9px] font-mono uppercase tracking-widest text-gray-500">
                                        — @d.Lines.Count item(s) processed@(string.IsNullOrEmpty(d.InvoiceNumber) ? "" : ", INV: " + d.InvoiceNumber)
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>

        </div>

        @* --- 4. TERMINAL ACTIONS (CLOSE / CANCEL) --- *@
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-4">
            @if (isOpen && anyReceived)
            {
                <form method="post" action="@Url.Action("Close", "IngredientOrder", new { id = Model.Id })" class="bg-white border-2 border-gray-200 shadow-sm p-6 flex flex-col gap-4">
                    @Html.AntiForgeryToken()
                    <div>
                        <h5 class="font-serif font-bold text-lg text-gray-900 mb-1">Finalize & Close Order</h5>
                        <p class="text-[10px] font-mono text-gray-500 uppercase tracking-widest mb-0">No further deliveries will be accepted against this PO.</p>
                    </div>
                    <input name="reason" class="w-full border-b border-gray-300 py-2 outline-none focus:border-[#C21E2E] font-serif text-sm bg-transparent" required maxlength="300" placeholder="Required justification for closure..." />
                    <button class="bg-gray-100 hover:bg-gray-200 text-gray-800 px-4 py-2.5 text-[9px] font-bold uppercase tracking-[2px] transition-colors mt-auto">Close Order</button>
                </form>
            }

            @if ((isDraft || isOpen) && !anyReceived)
            {
                <form method="post" action="@Url.Action("Cancel", "IngredientOrder", new { id = Model.Id })" class="bg-white border-2 border-red-200 shadow-sm p-6 flex flex-col gap-4" onsubmit="return confirm('WARNING: Permanently cancel PO @Model.PoNumber?');">
                    @Html.AntiForgeryToken()
                    <div>
                        <h5 class="font-serif font-bold text-lg text-[#C21E2E] mb-1">Cancel Order</h5>
                        <p class="text-[10px] font-mono text-red-700 uppercase tracking-widest mb-0">Terminate this PO. It has no received inventory.</p>
                    </div>
                    <input name="reason" class="w-full border-b border-red-200 py-2 outline-none focus:border-[#C21E2E] font-serif text-sm bg-transparent placeholder-red-300" maxlength="300" placeholder="Optional cancellation reason..." />
                    <button class="bg-red-50 border border-red-200 hover:bg-red-100 text-[#C21E2E] px-4 py-2.5 text-[9px] font-bold uppercase tracking-[2px] transition-colors mt-auto">Cancel Order</button>
                </form>
            }
        </div>

    </div>
</div>


@model Michaelhouse.Models.LeaveRequest
@{
    ViewBag.Title = "Request Permission to Leave Residence";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.css" rel="stylesheet" />
    <style>
        /* --- HIGH-END INSTITUTIONAL CALENDAR OVERRIDES --- */
        .fc {
            font-family: 'Montserrat', sans-serif !important;
            --fc-border-color: #f3f4f6;
            --fc-button-bg-color: #1a1a1a;
            --fc-button-border-color: #1a1a1a;
            --fc-button-hover-bg-color: #C21E2E;
            --fc-button-hover-border-color: #C21E2E;
            --fc-button-active-bg-color: #C21E2E;
            --fc-button-active-border-color: #C21E2E;
            --fc-today-bg-color: #fef2f2;
            --fc-page-bg-color: #ffffff;
        }

        /* Sharp Buttons */
        .fc-button {
            border-radius: 0 !important;
            text-transform: uppercase !important;
            letter-spacing: 2px !important;
            font-size: 9px !important;
            font-weight: 700 !important;
            padding: 8px 16px !important;
            box-shadow: none !important;
        }

        /* Header Title */
        .fc-toolbar-title {
            font-family: 'Playfair Display', serif !important;
            font-weight: 700 !important;
            color: #1a1a1a;
            font-size: 1.5rem !important;
            text-transform: uppercase;
            letter-spacing: 2px;
        }

        /* Day Columns */
        .fc-col-header-cell-cushion {
            padding: 12px 0 !important;
            text-transform: uppercase;
            font-size: 10px;
            letter-spacing: 2px;
            font-weight: 700;
            color: #9ca3af !important;
        }

        /* Day Numbers */
        .fc-daygrid-day-number {
            font-family: 'Source Code Pro', monospace !important;
            font-size: 12px !important;
            font-weight: 700 !important;
            color: #1a1a1a !important;
            padding: 8px !important;
        }

        /* Current Day Highlight */
        .fc-day-today {
            border-top: 3px solid #C21E2E !important;
        }

        /* Event Ledger Styling (Allowing Backend Colors to show) */
        .fc-event {
            border-radius: 0 !important;
            border: none !important;
            font-size: 9px !important;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 700;
            padding: 3px 6px;
            margin: 2px !important;
            box-shadow: 0 1px 2px rgba(0,0,0,0.1);
        }

        .fc-event-main {
            color: #ffffff !important; /* Ensure text is readable against the colored backgrounds */
        }
    </style>
}

@* --- FULL SCREEN VIEWPORT CONTAINER --- *@
<div class="flex flex-col h-full w-full overflow-hidden bg-gray-50/30">

    @* --- INSTITUTIONAL HEADER --- *@
    <div class="mb-6 d-flex justify-content-between align-items-end border-b border-gray-200 pb-6 flex-shrink-0 px-8 pt-8 bg-white shadow-sm relative z-10">
        <div>
            <div class="flex items-center gap-2 mb-3">
                <div class="h-[2px] w-8 bg-[#C21E2E]"></div>
                <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Boarding & Residence</h5>
            </div>
            <h2 class="text-5xl font-serif font-bold text-gray-900 tracking-tight">Leave Request</h2>
            <p class="text-[11px] font-mono text-gray-400 uppercase tracking-widest mt-2 mb-0">Submit permission to depart campus</p>
        </div>
        <div class="flex gap-3">
            <a href="@Url.Action("MyRequests", "VisitorAccess")" class="inline-flex items-center justify-center bg-white border border-gray-300 text-gray-700 px-6 py-3 text-[10px] font-bold uppercase tracking-[2px] hover:bg-gray-50 hover:border-gray-400 transition-all duration-300 shadow-sm">
                <i class="bi bi-arrow-left me-2 text-sm"></i> Return to Registry
            </a>
        </div>
    </div>

    @* --- SCROLLABLE DATA SECTION --- *@
    <div class="flex-grow min-h-0 overflow-y-auto custom-scrollbar px-8 pb-10 pt-4 flex flex-col gap-6">

        @* --- SYSTEM ALERTS --- *@
        <div class="bg-blue-50 border-l-4 border-blue-500 p-4 shadow-sm relative z-10">
            <p class="text-xs font-mono text-blue-900 m-0 leading-relaxed uppercase tracking-widest">
                <i class="bi bi-info-circle-fill text-blue-500 me-2 text-lg align-middle"></i>
                Request will be routed to your parent/guardian for authorization, then forwarded to <strong>@ViewBag.HouseMasterName</strong> (@ViewBag.ResidenceName).
            </p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="bg-red-50 border-l-4 border-[#C21E2E] p-4 text-[#C21E2E] shadow-sm relative z-10 text-sm font-serif">
                <i class="bi bi-exclamation-triangle-fill me-2 text-lg align-middle"></i>
                @Html.ValidationSummary(false, "", new { @class = "inline-block mb-0" })
            </div>
        }

        <div class="grid grid-cols-1 xl:grid-cols-12 gap-8 flex-grow">

            @* --- LEFT: LEAVE REQUEST FORM --- *@
            <div class="xl:col-span-7 flex flex-col">
                <div class="bg-white shadow-sm border border-gray-100 flex flex-col relative overflow-hidden group h-full">

                    @* Ghost Watermark *@
                    <i class="bi bi-box-arrow-right absolute -right-8 -bottom-8 text-9xl text-black opacity-[0.02] transition-transform duration-1000 group-hover:-rotate-6 group-hover:scale-[1.1] pointer-events-none z-0"></i>

                    <div class="p-6 border-b border-gray-100 bg-[#1a1a1a] relative z-10">
                        <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-white mb-0"><i class="bi bi-geo-alt me-2 text-gray-500"></i> Departure Logistics</h5>
                    </div>

                    <div class="p-8 relative z-10">
                        @using (Html.BeginForm("Create", "LeaveRequest", FormMethod.Post, new { @class = "flex flex-col gap-6" }))
                        {
                            @Html.AntiForgeryToken()

                            @* Destination *@
                            <div>
                                <label class="block text-[9px] uppercase tracking-[2px] font-bold text-gray-500 mb-2">Destination *</label>
                                @Html.TextBoxFor(m => m.Destination, new { @class = "w-full border-b-2 border-gray-200 py-3 outline-none focus:border-[#C21E2E] font-serif text-lg text-gray-900 transition-colors bg-transparent", placeholder = "e.g. Home - 12 Musgrave Rd, Durban", id = "destinationInput" })
                                @Html.ValidationMessageFor(m => m.Destination, "", new { @class = "text-[#C21E2E] text-[9px] font-bold uppercase mt-2 block tracking-widest" })
                                <p class="text-[10px] font-mono text-gray-400 mt-2 uppercase tracking-widest"><i class="bi bi-info-circle me-1"></i> Specify address or landmark for geographic plotting.</p>
                            </div>

                            @* Map Integration *@
                            <div class="border-t border-gray-100 pt-6 mt-2">
                                <label class="block text-[9px] uppercase tracking-[2px] font-bold text-gray-500 mb-4">Geographic Plotting</label>

                                <div id="mapPlaceholder" class="bg-gray-50 border-2 border-dashed border-gray-300 p-8 text-center flex flex-col items-center justify-center min-h-[280px]">
                                    <i class="bi bi-map text-4xl text-gray-300 mb-2"></i>
                                    <span class="text-[10px] font-mono text-gray-500 uppercase tracking-widest">Start typing destination to preview coordinates</span>
                                </div>

                                <iframe id="destinationMap" class="w-full h-[280px] border border-gray-200 shadow-sm hidden" style="display:none;" loading="lazy"></iframe>

                                <a id="destinationMapLink" href="#" target="_blank" rel="noopener" class="text-[9px] font-bold uppercase tracking-[2px] text-[#C21E2E] mt-3 hover:underline hidden" style="display:none;">
                                    <i class="bi bi-box-arrow-up-right me-1"></i> Open in Google Maps
                                </a>
                            </div>

                            @* Chronology *@
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 border-t border-gray-100 pt-6 mt-2">
                                <div>
                                    <label class="block text-[9px] uppercase tracking-[2px] font-bold text-gray-500 mb-2">Departure Date & Time *</label>
                                    @Html.TextBoxFor(m => m.DepartureDateTime, "{0:yyyy-MM-ddTHH:mm}", new { @class = "w-full border-b-2 border-gray-200 py-3 outline-none focus:border-[#C21E2E] font-mono text-sm text-gray-900 transition-colors bg-transparent", type = "datetime-local", id = "DepartureDateTime" })
                                    @Html.ValidationMessageFor(m => m.DepartureDateTime, "", new { @class = "text-[#C21E2E] text-[9px] font-bold uppercase mt-2 block tracking-widest" })
                                </div>
                                <div>
                                    <label class="block text-[9px] uppercase tracking-[2px] font-bold text-gray-500 mb-2">Expected Return Date & Time *</label>
                                    @Html.TextBoxFor(m => m.ExpectedReturnDateTime, "{0:yyyy-MM-ddTHH:mm}", new { @class = "w-full border-b-2 border-gray-200 py-3 outline-none focus:border-[#C21E2E] font-mono text-sm text-gray-900 transition-colors bg-transparent", type = "datetime-local", id = "ExpectedReturnDateTime" })
                                    @Html.ValidationMessageFor(m => m.ExpectedReturnDateTime, "", new { @class = "text-[#C21E2E] text-[9px] font-bold uppercase mt-2 block tracking-widest" })
                                </div>
                            </div>

                            @* Diagnostic Warnings injected via JS *@
                            <div id="conflictWarning" class="bg-yellow-50 border-l-4 border-yellow-500 p-4 text-yellow-800 text-sm font-serif shadow-sm mt-4" style="display:none;"></div>

                            <div id="acknowledgeWrapper" class="bg-gray-50 border border-gray-200 p-4 mt-2 shadow-inner" style="display:none;">
                                <label class="flex items-center gap-3 cursor-pointer m-0">
                                    <input type="checkbox" id="acknowledgeConflict" name="acknowledgeConflict" value="true" class="w-4 h-4 text-[#C21E2E] focus:ring-[#C21E2E] border-gray-300 rounded" />
                                    <span class="text-[10px] font-bold uppercase tracking-widest text-gray-700">I acknowledge the scheduling conflict and wish to proceed.</span>
                                </label>
                            </div>

                            @* Reason *@
                            <div class="border-t border-gray-100 pt-6 mt-2">
                                <label class="block text-[9px] uppercase tracking-[2px] font-bold text-gray-500 mb-2">Reason for Leave *</label>
                                @Html.TextAreaFor(m => m.Reason, new { @class = "w-full border border-gray-200 p-4 outline-none focus:border-[#C21E2E] font-serif text-sm text-gray-900 transition-colors bg-gray-50/50 resize-y", rows = 4, placeholder = "Detail your reason for leaving the residence..." })
                                @Html.ValidationMessageFor(m => m.Reason, "", new { @class = "text-[#C21E2E] text-[9px] font-bold uppercase mt-2 block tracking-widest" })
                            </div>

                            @* Actions *@
                            <div class="flex flex-col sm:flex-row gap-3 mt-4">
                                <button type="submit" id="submitBtn" class="flex-grow bg-[#1a1a1a] text-white px-8 py-4 text-[11px] font-bold uppercase tracking-[3px] hover:bg-black hover:shadow-[0_0_20px_rgba(0,0,0,0.3)] transition-all duration-300">
                                    <i class="bi bi-send me-2"></i> Submit Request
                                </button>
                                @Html.ActionLink("Cancel", "MyRequests", "VisitorAccess", null, new { @class = "flex-grow sm:flex-grow-0 text-center bg-transparent border border-gray-300 text-gray-600 px-8 py-4 text-[11px] font-bold uppercase tracking-[3px] hover:bg-gray-50 hover:text-gray-900 transition-all duration-300" })
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* --- RIGHT: SCHEDULING CALENDAR --- *@
            <div class="xl:col-span-5 flex flex-col">
                <div class="bg-white shadow-sm border border-gray-100 flex flex-col flex-grow relative overflow-hidden">
                    <div class="p-5 border-b border-gray-100 bg-[#1a1a1a] flex justify-between items-center relative z-10">
                        <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-white mb-0"><i class="bi bi-calendar3 me-2 text-gray-500"></i> Institutional Calendar</h5>
                    </div>
                    <div class="p-6 relative z-10">
                        <div class="bg-yellow-50 border-l-4 border-yellow-500 p-3 mb-6">
                            <p class="text-[10px] font-mono text-yellow-800 m-0 uppercase tracking-widest leading-relaxed">
                                <i class="bi bi-exclamation-triangle-fill text-yellow-600 me-1"></i> Events mapped in red/orange denote testing and examinations. Departure during these periods requires extraordinary authorization.
                            </p>
                        </div>

                        <div id="schoolCalendar" class="w-full"></div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<style>
    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }

    .font-mono {
        font-family: 'Source Code Pro', monospace !important;
    }

    .custom-scrollbar::-webkit-scrollbar {
        width: 5px;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #eee;
        border-radius: 10px;
    }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #C21E2E;
        }
</style>

@section Scripts {
    <!-- Added back the required FullCalendar CDN script -->
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
    <script>
        // ── Map Plotting Integration ─────────────────────────────────────────
        (function () {
            var input = document.getElementById("destinationInput");
            var map = document.getElementById("destinationMap");
            var link = document.getElementById("destinationMapLink");
            var placeholder = document.getElementById("mapPlaceholder");
            var debounceTimer = null;

            function updateMap() {
                var value = input.value.trim();

                if (value.length < 3) {
                    map.style.display = "none";
                    link.style.display = "none";
                    placeholder.style.display = "flex";
                    return;
                }

                var encoded = encodeURIComponent(value);
                map.src = "https://maps.google.com/maps?q=" + encoded + "&output=embed";
                link.href = "https://www.google.com/maps/search/?api=1&query=" + encoded;

                placeholder.style.display = "none";
                map.style.display = "block";
                link.style.display = "inline-flex";
            }

            input.addEventListener("input", function () {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(updateMap, 600);
            });

            if (input.value.trim().length >= 3) {
                updateMap();
            }
        })();

        // ── School Calendar Widget ──────────────────────────────────────────
        document.addEventListener("DOMContentLoaded", function () {
            var calendarEl = document.getElementById("schoolCalendar");
            if (calendarEl) {
                var calendar = new FullCalendar.Calendar(calendarEl, {
                    initialView: "dayGridMonth",
                    height: "auto", /* Allows the calendar to be dynamic instead of cramped */
                    contentHeight: "auto",
                    headerToolbar: {
                        left: 'prev,next',
                        center: 'title',
                        right: 'today'
                    },
                    events: function (info, successCallback, failureCallback) {
                        fetch("@Url.Action("Events", "SchoolCalendar")?start=" + info.startStr + "&end=" + info.endStr)
                            .then(function (r) { return r.json(); })
                            .then(successCallback)
                            .catch(failureCallback);
                    },
                    eventDidMount: function (arg) {
                        if (arg.event.extendedProps.description) {
                            arg.el.setAttribute("title", arg.event.extendedProps.description);
                        }
                    }
                });
                calendar.render();
            }

            // ── Live Date-Conflict Diagnostic ───────────────────────────────
            var departureInput = document.getElementById("DepartureDateTime");
            var returnInput = document.getElementById("ExpectedReturnDateTime");
            var warningBox = document.getElementById("conflictWarning");
            var ackWrapper = document.getElementById("acknowledgeWrapper");
            var ackCheckbox = document.getElementById("acknowledgeConflict");
            var submitBtn = document.getElementById("submitBtn");

            function checkConflicts() {
                var dep = departureInput.value;
                var ret = returnInput.value;
                if (!dep || !ret) return;

                fetch("@Url.Action("CheckDateConflicts", "LeaveRequest")?start=" + encodeURIComponent(dep) + "&end=" + encodeURIComponent(ret))
                    .then(function (r) { return r.json(); })
                    .then(function (data) {
                        if (data.hasConflict) {
                            warningBox.style.display = "block";
                            warningBox.innerHTML = "<i class='bi bi-shield-exclamation me-2 text-lg align-middle'></i><strong>Diagnostic Flag:</strong> " + data.message;
                            ackWrapper.style.display = "block";
                            ackCheckbox.checked = false;
                            submitBtn.disabled = true;
                            submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
                        } else {
                            warningBox.style.display = "none";
                            ackWrapper.style.display = "none";
                            ackCheckbox.checked = false;
                            submitBtn.disabled = false;
                            submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                        }
                    })
                    .catch(function () {
                        // Fail gracefully
                        submitBtn.disabled = false;
                        submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                    });
            }

            departureInput.addEventListener("change", checkConflicts);
            returnInput.addEventListener("change", checkConflicts);

            ackCheckbox.addEventListener("change", function () {
                if (ackWrapper.style.display !== "none" && !this.checked) {
                    submitBtn.disabled = true;
                    submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
                } else {
                    submitBtn.disabled = false;
                    submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                }
            });
        });
    </script>
}
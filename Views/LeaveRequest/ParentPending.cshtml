@model IEnumerable<Michaelhouse.Models.LeaveRequest>
@{
    ViewBag.Title = "Leave Requests Awaiting Your Approval";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* --- FULL SCREEN VIEWPORT CONTAINER --- *@
<div class="flex flex-col h-full w-full overflow-hidden bg-gray-50/30">

    @* --- INSTITUTIONAL HEADER --- *@
    <div class="mb-6 d-flex justify-content-between align-items-end border-b border-gray-200 pb-6 flex-shrink-0 px-8 pt-8 bg-white shadow-sm relative z-10">
        <div>
            <div class="flex items-center gap-2 mb-3">
                <div class="h-[2px] w-8 bg-[#C21E2E]"></div>
                <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Boarding & Residence</h5>
            </div>
            <h2 class="text-5xl font-serif font-bold text-gray-900 tracking-tight">Leave Approval Queue</h2>
            <p class="text-[11px] font-mono text-gray-400 uppercase tracking-widest mt-2 mb-0">Awaiting Parent/Guardian Authorization</p>
        </div>
        <div class="flex gap-3">
            <span class="inline-flex items-center bg-yellow-50 border border-yellow-200 px-4 py-2 shadow-sm text-[10px] font-bold uppercase tracking-[2px] text-yellow-800">
                @Model.Count() Pending
            </span>
        </div>
    </div>

    @* --- SCROLLABLE DATA SECTION --- *@
    <div class="flex-grow min-h-0 overflow-y-auto custom-scrollbar px-8 pb-10 pt-4 flex flex-col">

        <div class="w-full mx-auto flex flex-col gap-6">

            @* --- ALERTS --- *@
            @if (TempData["Success"] != null)
            {
                <div class="bg-green-50 border-l-4 border-green-500 p-4 text-green-700 shadow-sm flex items-center">
                    <i class="bi bi-check-circle-fill me-3 text-xl"></i>
                    <span class="text-xs font-bold uppercase tracking-widest">@TempData["Success"]</span>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="bg-red-50 border-l-4 border-[#C21E2E] p-4 text-[#C21E2E] shadow-sm flex items-center">
                    <i class="bi bi-x-circle-fill me-3 text-xl"></i>
                    <span class="text-xs font-bold uppercase tracking-widest">@TempData["Error"]</span>
                </div>
            }

            @* --- QUEUE LEDGER --- *@
            @if (!Model.Any())
            {
                <div class="bg-white border border-gray-100 p-20 text-center shadow-sm w-full mt-3 flex flex-col items-center justify-center">
                    <i class="bi bi-check2-circle text-[#10b981] text-6xl d-block mb-4"></i>
                    <h4 class="font-serif font-bold text-gray-800 text-2xl tracking-[1px] mb-2">Queue Clear</h4>
                    <p class="text-sm font-mono text-gray-500 mt-2 mb-0 uppercase tracking-widest">No leave requests are currently awaiting your approval.</p>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 xl:grid-cols-2 gap-8">
                    @foreach (var item in Model)
                    {
                        <div class="bg-white border border-gray-200 shadow-sm relative flex flex-col transition-all duration-500 hover:-translate-y-1 hover:shadow-[0_10px_20px_rgba(0,0,0,0.05)] hover:border-gray-300 group overflow-hidden h-full">

                            @* Ghost Watermark *@
                            <i class="bi bi-box-arrow-right absolute -right-6 -bottom-8 text-9xl text-black opacity-[0.02] transition-transform duration-1000 group-hover:-rotate-6 group-hover:scale-[1.1] pointer-events-none z-0"></i>

                            @* Card Header (FIXED DYNAMIC PROXY BUG HERE) *@
                            <div class="p-5 border-b border-gray-100 bg-[#1a1a1a] flex justify-between items-center relative z-10">
                                <strong class="font-serif text-xl text-white tracking-wide">@(item.Student != null ? item.Student.Name : "Unknown Student")</strong>
                                <span class="inline-flex items-center text-[9px] font-bold uppercase tracking-[2px] text-gray-400">
                                    <i class="bi bi-building me-1"></i> @(item.Residence != null ? item.Residence.Name : "Unknown Residence")
                                </span>
                            </div>

                            @* Card Body *@
                            <div class="p-6 relative z-10 flex-grow flex flex-col gap-4">

                                @if (item.HasCalendarConflict)
                                {
                                    <div class="bg-yellow-50 border-l-4 border-yellow-500 p-3 mb-2 shadow-sm">
                                        <span class="text-[10px] font-bold text-yellow-800 uppercase tracking-widest block mb-1">
                                            <i class="bi bi-calendar-x me-1"></i> Calendar Conflict Detected
                                        </span>
                                        <p class="text-xs font-mono text-yellow-700 m-0">@item.CalendarConflictSummary</p>
                                    </div>
                                }

                                <div class="grid grid-cols-3 gap-2 items-center border-b border-gray-50 pb-3">
                                    <div class="col-span-1 text-[9px] uppercase tracking-[2px] font-bold text-gray-400">Destination:</div>
                                    <div class="col-span-2 font-serif text-sm text-gray-800">
                                        <div class="mb-1 font-bold">@item.Destination</div>
                                        <a href="https://www.google.com/maps/search/?api=1&query=@Uri.EscapeDataString(item.Destination)" target="_blank" rel="noopener" class="text-[9px] font-bold uppercase tracking-[2px] text-[#C21E2E] hover:underline">
                                            <i class="bi bi-geo-alt me-1"></i> Open in Maps
                                        </a>
                                    </div>
                                </div>

                                <div class="grid grid-cols-3 gap-2 items-center border-b border-gray-50 pb-3">
                                    <div class="col-span-1 text-[9px] uppercase tracking-[2px] font-bold text-gray-400">Departure:</div>
                                    <div class="col-span-2 font-mono text-sm font-bold text-[#C21E2E]">@item.DepartureDateTime.ToString("dd MMM yyyy HH:mm")</div>
                                </div>

                                <div class="grid grid-cols-3 gap-2 items-center border-b border-gray-50 pb-3">
                                    <div class="col-span-1 text-[9px] uppercase tracking-[2px] font-bold text-gray-400">Expected Return:</div>
                                    <div class="col-span-2 font-mono text-sm font-bold text-[#10b981]">@item.ExpectedReturnDateTime.ToString("dd MMM yyyy HH:mm")</div>
                                </div>

                                <div class="grid grid-cols-3 gap-2 items-start mt-1">
                                    <div class="col-span-1 text-[9px] uppercase tracking-[2px] font-bold text-gray-400 mt-1">Reason:</div>
                                    <div class="col-span-2 font-serif italic text-sm text-gray-600 bg-gray-50 p-3 border-l-2 border-gray-300">
                                        @item.Reason
                                    </div>
                                </div>
                            </div>

                            @* Action Footer *@
                            <div class="bg-gray-50 border-t border-gray-100 p-5 relative z-10 mt-auto">
                                @using (Html.BeginForm("ParentDecision", "LeaveRequest", FormMethod.Post, new { @class = "flex flex-col gap-3 m-0" }))
                                {
                                    @Html.AntiForgeryToken()
                                    @Html.Hidden("id", item.LeaveRequestId)

                                    <div>
                                        <textarea name="comments" class="w-full border border-gray-200 p-3 outline-none focus:border-[#C21E2E] font-serif text-sm text-gray-900 transition-colors bg-white resize-y" rows="2" placeholder="Comments (optional)..."></textarea>
                                    </div>

                                    <div class="flex flex-wrap gap-2">
                                        <button type="submit" name="approve" value="true" class="flex-grow bg-[#10b981] text-white px-4 py-3 text-[10px] font-bold uppercase tracking-[2px] hover:bg-green-600 hover:shadow-[0_0_10px_rgba(16,185,129,0.3)] transition-all shadow-sm">
                                            <i class="bi bi-check-lg me-1"></i> Approve
                                        </button>
                                        <button type="submit" name="approve" value="false" class="flex-grow bg-transparent border border-[#C21E2E] text-[#C21E2E] px-4 py-3 text-[10px] font-bold uppercase tracking-[2px] hover:bg-red-50 transition-all shadow-sm">
                                            <i class="bi bi-x-lg me-1"></i> Reject
                                        </button>
                                        <a href="@Url.Action("Details", new { id = item.LeaveRequestId })" class="flex-grow text-center bg-[#1a1a1a] text-white px-4 py-3 text-[10px] font-bold uppercase tracking-[2px] hover:bg-black transition-all shadow-sm">
                                            <i class="bi bi-card-text me-1"></i> Details
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<style>
    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }

    .font-mono {
        font-family: 'Source Code Pro', monospace !important;
    }

    .custom-scrollbar::-webkit-scrollbar {
        width: 5px;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #eee;
        border-radius: 10px;
    }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #C21E2E;
        }
</style>
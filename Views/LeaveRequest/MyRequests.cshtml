@model IEnumerable<Michaelhouse.Models.LeaveRequest>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Leave Request History";
}

@* --- FULL SCREEN VIEWPORT CONTAINER --- *@
<div class="flex flex-col h-full w-full overflow-hidden bg-gray-50/30">

    @* --- INSTITUTIONAL HEADER --- *@
    <div class="mb-6 d-flex justify-content-between align-items-end border-b border-gray-200 pb-6 flex-shrink-0 px-8 pt-8 bg-white shadow-sm relative z-10">
        <div>
            <div class="flex items-center gap-2 mb-3">
                <div class="h-[2px] w-8 bg-[#C21E2E]"></div>
                <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Pastoral Care & Residency</h5>
            </div>
            <h2 class="text-5xl font-serif font-bold text-gray-900 tracking-tight">Authorization History</h2>
            <p class="text-[11px] font-mono text-gray-400 uppercase tracking-widest mt-2 mb-0">Leave Requests</p>
        </div>
        <div class="flex gap-3">
            <a href="@Url.Action("Create")" class="inline-block bg-[#C21E2E] text-white px-8 py-3 text-[10px] font-bold uppercase tracking-[3px] hover:bg-black transition-all shadow-xl">
                <i class="bi bi-plus-lg me-2"></i> Create New Request
            </a>
        </div>
    </div>

    @* --- SCROLLABLE DATA SECTION --- *@
    <div class="flex-grow min-h-0 overflow-y-auto custom-scrollbar px-8 pb-10 pt-4 flex flex-col">

        @* --- ALERTS --- *@
        @if (TempData["Success"] != null)
        {
            <div class="bg-green-50 border-l-4 border-green-500 p-4 text-green-700 mb-6 shadow-sm flex items-center">
                <i class="bi bi-check-circle-fill me-3 text-xl"></i>
                <span class="text-xs font-bold uppercase tracking-widest">@TempData["Success"]</span>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="bg-red-50 border-l-4 border-[#C21E2E] p-4 text-[#C21E2E] mb-6 shadow-sm flex items-center">
                <i class="bi bi-exclamation-triangle-fill me-3 text-xl"></i>
                <span class="text-xs font-bold uppercase tracking-widest">@TempData["Error"]</span>
            </div>
        }

        @* --- ARCHIVAL LEDGER TABLE --- *@
        <div class="bg-white shadow-sm border border-gray-100 flex flex-col flex-grow min-h-0 relative overflow-hidden group">

            @* Ghost Watermark *@
            <i class="bi bi-clock-history absolute -right-12 -bottom-12 text-9xl text-black opacity-[0.02] transition-transform duration-1000 group-hover:-rotate-12 group-hover:scale-[1.2] pointer-events-none z-0"></i>

            @* Archival Dot Grid Header *@
            <div class="p-6 border-b border-gray-100 bg-gray-50/50 flex justify-between items-center relative z-10 flex-shrink-0">
                <div class="absolute inset-0 opacity-[0.05] pointer-events-none" style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 20px 20px;"></div>
                <div class="relative z-10">
                    <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-900 mb-1"><i class="bi bi-journal-text me-2 text-gray-400"></i> Official Authorization Ledger</h5>
                    <p class="text-[8px] text-gray-400 font-bold uppercase tracking-widest mb-0 font-mono">Status: Personal Records Active</p>
                </div>
            </div>

            @* Table Container (Scrolls Internally) *@
            <div class="table-responsive flex-grow overflow-y-auto custom-scrollbar relative z-10">
                <table class="table table-hover mb-0 align-middle w-full">
                    <thead class="sticky top-0 z-20 bg-white shadow-sm">
                        <tr class="text-[9px] uppercase tracking-[4px] font-bold text-gray-400 border-b border-gray-200 bg-gray-50/80">
                            <th class="ps-8 py-5">Destination Address</th>
                            <th class="border-l border-gray-100 ps-6">Proposed Timeframe</th>
                            <th class="text-center border-l border-gray-100">Clearance Status</th>
                            <th class="pe-8 text-end border-l border-gray-100">Administrative</th>
                        </tr>
                    </thead>
                    <tbody class="text-gray-700">
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="4" class="py-20 text-center">
                                    <i class="bi bi-file-earmark-x text-gray-200 text-6xl d-block mb-4"></i>
                                    <h4 class="text-serif font-bold text-gray-400 uppercase tracking-[3px]">Ledger Empty</h4>
                                    <p class="text-[11px] font-mono text-gray-400 mt-2">You haven't submitted any leave requests yet.</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                string badgeBg = item.Status == "Approved" ? "bg-green-50 border-green-200 text-green-700" :
                                                 item.Status == "Rejected" ? "bg-red-50 border-[#C21E2E]/30 text-[#C21E2E]" :
                                                 "bg-yellow-50 border-yellow-200 text-yellow-700";

                                <tr class="group/row hover:bg-gray-50/80 transition-all duration-300 border-b border-gray-50 last:border-0">

                                    <td class="ps-8 py-5 w-1/3">
                                        <div class="font-serif font-bold text-gray-900 text-lg group-hover/row:text-[#C21E2E] transition-colors leading-tight">
                                            @item.Destination
                                        </div>
                                    </td>

                                    <td class="border-l border-gray-50 ps-6">
                                        <div class="grid grid-cols-1 gap-1">
                                            <div class="text-[10px] font-bold uppercase tracking-widest text-gray-500">
                                                <i class="bi bi-box-arrow-right me-1 text-[#C21E2E]"></i>
                                                <span class="font-mono text-gray-800">@item.DepartureDateTime.ToString("dd MMM yyyy HH:mm")</span>
                                            </div>
                                            <div class="text-[10px] font-bold uppercase tracking-widest text-gray-500">
                                                <i class="bi bi-box-arrow-in-right me-1 text-[#10b981]"></i>
                                                <span class="font-mono text-gray-800">@item.ExpectedReturnDateTime.ToString("dd MMM yyyy HH:mm")</span>
                                            </div>
                                        </div>
                                    </td>

                                    <td class="text-center border-l border-gray-50">
                                        <span class="font-mono text-[10px] font-bold uppercase tracking-widest border px-3 py-1 shadow-sm @badgeBg">
                                            @item.StatusLabel
                                        </span>
                                    </td>

                                    <td class="pe-8 text-end border-l border-gray-50">
                                        <a href="@Url.Action("Details", new { id = item.LeaveRequestId })" class="inline-block bg-transparent border border-gray-300 text-gray-500 px-5 py-2 text-[9px] font-bold uppercase tracking-[2px] hover:border-[#C21E2E] hover:text-[#C21E2E] hover:bg-red-50/50 hover:shadow-[0_0_15px_rgba(194,30,46,0.15)] transition-all duration-300">
                                            View Details <i class="bi bi-arrow-right ms-1"></i>
                                        </a>
                                    </td>

                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @* Institutional Footer *@
            <div class="p-4 bg-[#1a1a1a] border-t border-gray-800 flex justify-between items-center flex-shrink-0 relative z-10">
                <div class="text-[9px] uppercase tracking-[2px] font-bold text-gray-400 font-mono">
                    <i class="bi bi-shield-lock me-2 text-gray-500"></i> Cryptographic Audit Trail Verified
                </div>
            </div>
        </div>

    </div>
</div>

<style>
    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }

    .font-mono {
        font-family: 'Source Code Pro', monospace !important;
    }

    /* Institutional Table Aesthetics */
    .table thead th {
        border-bottom: 2px solid #f8f9fa !important;
    }

    .table tbody tr {
        transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    /* Internal scrollbar custom styling */
    .custom-scrollbar::-webkit-scrollbar {
        width: 5px;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #eee;
        border-radius: 10px;
    }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #C21E2E;
        }
</style>
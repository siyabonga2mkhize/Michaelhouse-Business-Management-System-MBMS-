@model Michaelhouse.Models.ResidenceAssignment
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Assignment Details";
}
<div class="container py-4">
    <h2>Assignment Details</h2>
    <dl class="dl-horizontal">
        <dt>Student</dt><dd>@Model.Student.Name</dd>
        <dt>Residence</dt><dd>@Model.Residence.Name</dd>
        <dt>Room</dt><dd>@Model.Room.RoomNumber</dd>
        <dt>Bed</dt><dd>@Model.Bed.BedNumber</dd>
        <dt>Status</dt><dd>@Model.Status</dd>
        <dt>Move In</dt><dd>@Model.MoveInDate.ToString("g")</dd>
        <dt>Vacated</dt><dd>@(Model.VacatedDate?.ToString("g") ?? "Active")</dd>
    </dl>
    <a class="btn btn-primary" href="@Url.Action("Edit", new { id = Model.ResidenceAssignmentId })">Edit</a>
    <a class="btn btn-danger" href="@Url.Action("Archive", new { id = Model.ResidenceAssignmentId })">Archive</a>
    <a class="btn btn-default" href="@Url.Action("Index")">Back</a>
</div>

@model IEnumerable<Michaelhouse.Models.ResidenceAssignment>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Residence Assignments";
}
<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Residence Assignments</h2>
        <a class="btn btn-primary" href="@Url.Action("Create")">Create</a>
    </div>
    @using (Html.BeginForm("Index", "ResidenceAssignment", FormMethod.Get)) {
        <input name="search" value="@ViewBag.Search" class="form-control mb-3" placeholder="Search student, residence or room" />
    }
    <p><a href="@Url.Action("Index", new { archived = !(ViewBag.Archived ?? false) })">@((ViewBag.Archived ?? false) ? "View Active" : "View Archived")</a></p>
    <table class="table table-striped"><thead><tr><th>Student</th><th>Residence</th><th>Room</th><th>Bed</th><th>Status</th><th></th></tr></thead><tbody>
    @foreach (var item in Model) {
        <tr><td>@item.Student.Name</td><td>@item.Residence.Name</td><td>@item.Room.RoomNumber</td><td>@item.Bed.BedNumber</td><td>@item.Status</td><td class="text-right"><a href="@Url.Action("Details", new { id = item.ResidenceAssignmentId })">Details</a></td></tr>
    }
    </tbody></table>
    @if (!Model.Any()) { <div class="alert alert-info">No assignments found.</div> }
</div>

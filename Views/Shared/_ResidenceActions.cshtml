@* Archive/Restore action buttons partial *@
@* Usage: @await Html.PartialAsync("_ResidenceActions", new { id = item.Id, isArchived = item.IsArchived, controller = "Residences" }) *@
@{
    int itemId = ViewData["id"] != null ? (int)ViewData["id"] : 0;
    bool itemIsArchived = ViewData["isArchived"] != null && (bool)ViewData["isArchived"];
    string itemController = ViewData["controller"]?.ToString() ?? "Residences";
}
@if (!itemIsArchived)
{
    <form method="post" asp-action="Archive" asp-controller="@itemController" asp-antiforgery="true">
        <input type="hidden" name="id" value="@itemId" />
        <button type="submit" class="px-3 py-1 bg-red-600 text-white rounded">Archive</button>
    </form>
}
else
{
    <form method="post" asp-action="Restore" asp-controller="@itemController" asp-antiforgery="true">
        <input type="hidden" name="id" value="@itemId" />
        <button type="submit" class="px-3 py-1 bg-green-600 text-white rounded">Restore</button>
    </form>
}

@helper ArchiveRestoreButtons(int id, bool isArchived, string controller)
{
    if (!isArchived)
    {
        <form method="post" action="@Url.Action("Archive", controller)">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@id" />
            <button type="submit" class="px-3 py-1 bg-red-600 text-white rounded">Archive</button>
        </form>
    }
    else
    {
        <form method="post" action="@Url.Action("Restore", controller)">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@id" />
            <button type="submit" class="px-3 py-1 bg-green-600 text-white rounded">Restore</button>
        </form>
    }
}
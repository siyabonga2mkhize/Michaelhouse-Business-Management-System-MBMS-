    <script>
        document.addEventListener("DOMContentLoaded", function () {

            const btn = document.getElementById("sidebarCollapse");
            const sidebar = document.getElementById("sidebar");

            if (!btn || !sidebar) {
                return;
            }

            btn.addEventListener("click", function () {

                sidebar.classList.toggle("collapsed");

            });

        });
        // --- 1. EXISTING NOTIFICATION LOGIC ---
        function loadNotifications() {
            $.get('@Url.Action("GetNotificationsPartial", "Notification")', function(data) {
                $('#notificationList').html(data);
                updateBadge();
            });
        }

        function updateBadge() {
            $.get('@Url.Action("GetUnreadCount", "Notification")', function(count) {
                if (count > 0) {
                    $('#notificationBadge').text(count).show();
                } else {
                    $('#notificationBadge').hide();
                }
            });
        }

        // --- 2. NEW: EMERGENCY OVERRIDE LOGIC (CRITICAL) ---
        function checkEmergencyStatus() {
            // Only perform this check if the user is logged in (to save server resources)
            var isLoggedIn = @(Session["UserId"] != null ? "true" : "false");
            if (!isLoggedIn) return;

            $.ajax({
                url: '@Url.Action("GetActiveAlertForStudent", "Emergency")',
                type: 'GET',
                cache: false,
                success: function (data) {
                    // If there is an ACTIVE alert AND they haven't confirmed it yet:
                    if (data.hasActiveAlert && !data.alreadyConfirmed) {
                        // BAM! Immediate screen takeover
                        window.location.href = '@Url.Action("ConfirmSafety", "Emergency")';
                    }
                },
                error: function() {
                    // Silently fail - we don't want error pop-ups for students.
                }
            });
        }

        // --- 3. TRIGGER THE CHECKS ---
        $(function() {
            // Start the notification listener
            loadNotifications();
            setInterval(loadNotifications, 30000); // 30 seconds

            // Start the Emergency Override listener
            // It runs IMMEDIATELY on page load, and repeats every 5 seconds while they browse.
            checkEmergencyStatus();
            setInterval(checkEmergencyStatus, 5000); // 5 seconds
        });
        // --- 2. NEW: EMERGENCY OVERRIDE LOGIC (CRITICAL) ---
function checkEmergencyStatus() {
    var isLoggedIn = @(Session["UserId"] != null ? "true" : "false");
    if (!isLoggedIn) return;

    // Only run for Students (to prevent redirects for teachers, admins, etc.)
    var role = '@Session["UserRole"]';
    if (role !== 'Student') return;

    $.ajax({
        url: '@Url.Action("GetActiveAlertForStudent", "Emergency")',
        type: 'GET',
        cache: false,
        success: function (data) {
            if (data.hasActiveAlert && !data.alreadyConfirmed) {
                window.location.href = '@Url.Action("ConfirmSafety", "Emergency")';
            }
        },
        error: function() { /* silent fail */ }
    });
}
    </script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>


    @RenderSection("Scripts", required: false)

</body>


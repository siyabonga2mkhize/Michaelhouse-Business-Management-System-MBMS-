    <style>
        :root {
            --mh-red: #C21E2E;
            --mh-dark: #1a1a1a;
            --sidebar-width: 260px;
            --sidebar-collapsed-width: 70px;
        }

        body {
            background: #ffffff;
            font-family: 'Montserrat', sans-serif;
            margin: 0;
            overflow-x: hidden;
        }

        h1, h2, h3, .navbar-brand, .sidebar-label {
            font-family: 'Playfair Display', serif !important;
        }

        /* Navbar */
        .navbar {
            background: #ffffff !important;
            border-bottom: 3px solid var(--mh-red);
            padding: 0.5rem 1.5rem;
            z-index: 1050;
            position: sticky;
            top: 0;
        }

        .navbar-brand {
            color: var(--mh-red) !important;
            font-size: 1.5rem;
            font-weight: 700;
            letter-spacing: -0.5px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .nav-logo {
            height: 40px;
            width: auto;
            object-fit: contain;
            image-rendering: -webkit-optimize-contrast;
        }

        /* Sidebar Base */
        #sidebar {
            background: #fdfdfd;
            min-height: calc(100vh - 70px);
            width: var(--sidebar-width);
            border-right: 1px solid #eee;
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            overflow-x: hidden;
            white-space: nowrap;

        }

            /* Sidebar Collapsed State */
            #sidebar.collapsed {
                width: var(--sidebar-collapsed-width);
            }

                #sidebar.collapsed .sidebar-label,
                #sidebar.collapsed .link-text {
                    display: none;
                }

        /* Sidebar Links */
        .sidebar .nav-link {
            color: #555 !important;
            padding: 12px 22px;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 600;
            margin: 4px 10px;
            border-radius: 6px;
            display: flex;
            align-items: center;
        }

            .sidebar .nav-link i {
                font-size: 1.2rem;
                margin-right: 15px;
                min-width: 25px;
            }

            .sidebar .nav-link:hover {
                background: #fff5f5;
                color: var(--mh-red) !important;
            }

            .sidebar .nav-link.active {
                background: var(--mh-red);
                color: #fff !important;
                box-shadow: 0 4px 12px rgba(194, 30, 46, 0.15);
            }

        .sidebar-label {
            color: #bbb;
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            padding: 25px 25px 10px;
            font-weight: 700;
        }

        /* Content Area */
        .main-content {
            flex: 1;
            min-width: 0; /* Ensures content doesn't push out the sidebar */
            transition: all 0.3s;
            background: #fff;
            position: relative;
            z-index: 1;
        }

        .full-width {
            padding: 0 !important;
        }

        /* Custom Toggle Button */
        #sidebarCollapse {
            background: none;
            border: none;
            color: var(--mh-red);
            font-size: 1.5rem;
            cursor: pointer;
            padding: 0 15px;
        }

        .user-pill {
            background: #f8f9fa;
            border-radius: 50px;
            padding: 5px 15px;
            border: 1px solid #eee;
        }

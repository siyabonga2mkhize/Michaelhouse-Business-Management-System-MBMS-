<!DOCTYPE html>

<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewBag.Title - Michaelhouse</title>



    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,700;1,400&family=Montserrat:wght@400;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />



    @RenderSection("Styles", required: false)

    <script src="https://cdn.tailwindcss.com"></script>



    <style>

        :root {
            --mh-red: #C21E2E;
            --mh-dark: #1a1a1a;
            --sidebar-width: 260px;
        }

        html,
        body {
            width: 100%;
            height: 100%;
            margin: 0;
            padding: 0;
        }

        body {
            width: 100%;
            min-width: 0;
            background: #ffffff;
            font-family: 'Montserrat', sans-serif;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
            overflow-y: auto;
        }

        h1, h2, h3, .navbar-brand, .sidebar-label {
            font-family: 'Playfair Display', serif !important;
        }



        .navbar {
            background: #ffffff !important;
            border-bottom: 3px solid var(--mh-red);
            padding: 0.5rem 1.5rem;
            z-index: 1050;
            position: sticky;
            top: 0;
        }



        .navbar-brand {
            color: var(--mh-red) !important;
            font-size: 1.5rem;
            font-weight: 700;
            letter-spacing: -0.5px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .app-shell {
            display: flex;
            width: 100%;
            max-width: none !important;
            flex: 1 1 auto;
            min-width: 0;
            overflow: visible;
            box-sizing: border-box;
        }

        .nav-logo {
            height: 40px;
            width: auto;
            object-fit: contain;
        }


        #sidebar {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            box-shadow: 5px 0 25px rgba(0,0,0,0.08);
            width: var(--sidebar-width);
            min-width: var(--sidebar-width);
            flex: 0 0 var(--sidebar-width);
            height: calc(100vh - 73px);
            position: sticky;
            top: 73px;
            border-right: 1px solid rgba(238, 238, 238, 0.5);
            overflow-x: hidden;
            overflow-y: auto;
            white-space: nowrap;
            box-sizing: border-box;
            transition: width 0.25s ease, min-width 0.25s ease, flex-basis 0.25s ease;
            z-index: 1040;
        }

            #sidebar.collapsed {
                width: 78px !important;
                min-width: 78px !important;
                flex-basis: 78px !important;
            }

                #sidebar.collapsed .sidebar-label,
                #sidebar.collapsed .sidebar-divider,
                #sidebar.collapsed .link-text,
                #sidebar.collapsed .nav-link-content span,
                #sidebar.collapsed .nav-badge,
                #sidebar.collapsed .cart-badge {
                    display: none !important;
                }

                #sidebar.collapsed .nav-link {
                    justify-content: center;
                    padding: 12px 8px;
                    margin-left: 8px;
                    margin-right: 8px;
                    font-size: 0;
                }

                    #sidebar.collapsed .nav-link i {
                        margin-right: 0;
                        min-width: 0;
                        font-size: 1.25rem;
                    }

                #sidebar.collapsed .nav-link-content {
                    display: flex;
                    justify-content: center;
                    align-items: center;
                    width: 100%;
                }

                    #sidebar.collapsed .nav-link-content i {
                        margin-right: 0;
                    }


        .sidebar .nav-link {
            color: #555 !important;
            padding: 12px 22px;
            font-size: 0.8rem;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 600;
            margin: 4px 10px;
            border-radius: 6px;
            display: flex;
            align-items: center;
        }



            .sidebar .nav-link i {
                font-size: 1.2rem;
                margin-right: 15px;
                min-width: 25px;
            }



            .sidebar .nav-link:hover {
                background: #fff5f5;
                color: var(--mh-red) !important;
            }



            .sidebar .nav-link.active {
                background: var(--mh-red);
                color: #fff !important;
                box-shadow: 0 4px 12px rgba(194, 30, 46, 0.15);
            }



        .sidebar-label {
            color: #bbb;
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 0.15em;
            padding: 25px 25px 10px;
            font-weight: 700;
        }



        .main-content {
            flex: 1 1 0%;
            width: 100%;
            max-width: none !important;
            min-width: 0;
            background: #fff;
            position: relative;
            z-index: 1;
            overflow-x: auto;
            box-sizing: border-box;
            animation: smoothFadeIn 0.6s cubic-bezier(0.22, 1, 0.36, 1) forwards;
        }


        #sidebarCollapse {
            background: none;
            border: none;
            color: var(--mh-red);
            font-size: 1.6rem;
            cursor: pointer;
            padding: 5px 15px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

            #sidebarCollapse:hover {
                color: #8f1622;
            }



        .user-pill {
            background: #f8f9fa;
            border-radius: 50px;
            padding: 5px 15px;
            border: 1px solid #eee;
        }



        .cart-badge {
            background: #C21E2E;
            color: #fff;
            font-size: 0.7rem;
            font-weight: 700;
            padding: 1px 6px;
            border-radius: 10px;
            margin-left: 8px;
        }

        .clickable-link {
            color: #0d6efd;
            text-decoration: underline;
            cursor: pointer;
        }

            .clickable-link:hover {
                color: #0a58ca;
            }

        body, #sidebar, .main-content, .app-shell {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

            body::-webkit-scrollbar,
            #sidebar::-webkit-scrollbar,
            .main-content::-webkit-scrollbar,
            .app-shell::-webkit-scrollbar {
                display: none;
            }
    </style>

</head>

<body>

    @{
        string currentController = (ViewContext.RouteData.Values["controller"] ?? "").ToString();
        string currentAction = (ViewContext.RouteData.Values["action"] ?? "").ToString();

        string userRole = "";
        if (Session["UserRole"] != null) { userRole = Session["UserRole"].ToString(); }

        string userName = "";
        if (Session["UserName"] != null) { userName = Session["UserName"].ToString(); }

        bool isLoggedIn = (Session["UserId"] != null);

        string ctrl = ViewContext.RouteData.Values["controller"].ToString() ?? "";

        int lowStockCount = 0;
        if (ViewBag.LowStockCount != null)
        {
            try { lowStockCount = Convert.ToInt32(ViewBag.LowStockCount); } catch { lowStockCount = 0; }
        }

        bool isHomePage = (currentController == "Home" && currentAction == "Index");

        int cartCount = 0;
        if (isLoggedIn)
        {
            try
            {
                var cartService = new Michaelhouse.Services.SessionCartService(new HttpContextWrapper(HttpContext.Current));
                var cart = cartService.GetCart();
                if (cart != null) { cartCount = cart.TotalItems; }
            }
            catch { }
        }
    }


    <nav class="navbar navbar-expand-lg">

        <div class="container-fluid">

            @if (isLoggedIn)

            {

                <button type="button" id="sidebarCollapse" aria-label="Toggle sidebar" aria-controls="sidebar" aria-expanded="true">

                    <i class="bi bi-list"></i>

                </button>

            }



            <a class="navbar-brand position-absolute start-50 translate-middle-x" href="@Url.Action("Index", "Home")">
                <img src="@Url.Content("~/Content/logo.svg.png")" alt="Michaelhouse" class="nav-logo" style="height: 40px;" />
                <span class="d-none d-sm-inline">Michaelhouse</span>
            </a>

            <div class="ms-auto d-flex align-items-center gap-3">
                @Html.Action("NotificationBadge", "Notification")

                @if (isLoggedIn)

                {

                    <div class="user-pill d-none d-md-block">

                        <i class="bi bi-person-circle me-1"></i>

                        <span class="fw-bold">@userName</span>

                        <span class="ms-2 badge bg-danger text-white rounded-pill small">@userRole</span>

                    </div>
                }

                @if (isLoggedIn)
                {
                    <a href="@Url.Action("Logout", "Account")" class="text-secondary hover:text-danger">

                        <i class="bi bi-box-arrow-right fs-5"></i>

                    </a>

                }

                else if (!isHomePage)

                {

                    <a href="@Url.Action("Login", "Account")" class="btn btn-sm btn-outline-danger px-4 rounded-0 fw-bold small">Login</a>

                }

            </div>

        </div>

    </nav>



    <div class="app-shell">

        @if (isLoggedIn)

        {

            <div id="sidebar" class="sidebar shadow-sm">

                <nav class="nav flex-column mt-2">



                    @if (userRole == "Parent")

                    {

                        <div class="sidebar-label">My Portal</div>

                        <a class="nav-link @(currentController == "Parents" && currentAction == "Dashboard" ? "active" : "")"
                           href="@Url.Action("Dashboard", "Parents")">

                            <i class="bi bi-house"></i> <span class="link-text">Dashboard</span>

                        </a>

                        <a class="nav-link @(currentController == "Applications" && currentAction == "Index" ? "active" : "")"
                           href="@Url.Action("Index", "Applications")">

                            <i class="bi bi-grid-1x2"></i> <span class="link-text">My Applications</span>

                        </a>

                        <a class="nav-link @(currentController == "Applications" && currentAction == "Create" ? "active" : "")"
                           href="@Url.Action("Create", "Applications")">

                            <i class="bi bi-plus-circle"></i> <span class="link-text">New Application</span>

                        </a>

                        <a class="nav-link @(currentController == "Applications" && currentAction == "AddStudent" ? "active" : "")"
                           href="@Url.Action("AddStudent", "Applications")">

                            <i class="bi bi-person-plus"></i> <span class="link-text">Add Student</span>

                        </a>

                        <a class="nav-link @(currentController == "Payment" ? "active" : "")"
                           href="@Url.Action("Index", "Payment")">

                            <i class="bi bi-credit-card"></i> <span class="link-text">Payments</span>

                        </a>

                        <a class="nav-link" href="@Url.Action("ChildrenAttendance", "Parents")">

                            <i class="bi bi-people"></i> Children's Attendance

                        </a>
                        <a class="nav-link" href="@Url.Action("ParentPending", "LeaveRequest")">

                            <i class="bi bi-people"></i> Children's Leave Requests

                        </a>



                        <hr class="sidebar-divider" />

                        <div class="sidebar-label">School Store</div>

                        <a class="nav-link @(currentController == "Store" ? "active" : "")"
                           href="@Url.Action("Index", "Store")">

                            <i class="bi bi-shop"></i> <span class="link-text">Browse Products</span>

                        </a>

                        <a class="nav-link @(currentController == "Cart" ? "active" : "")"
                           href="@Url.Action("Index", "Cart")">

                            <i class="bi bi-cart3"></i> <span class="link-text">My Cart</span>

                            @if (cartCount > 0)

                            {

                                <span class="cart-badge">@cartCount</span>

                            }

                        </a>
                        <a class="nav-link @(currentAction == "TrackOrder" ? "active" : "")"
                           href="@Url.Action("TrackOrder", "Order")">
                            <i class="bi bi-search"></i> <span class="link-text">Track Order</span>
                        </a>



                        <hr class="sidebar-divider" />

                        <div class="sidebar-label">Settings</div>

                        <a class="nav-link @(currentController == "Account" && currentAction == "Profile" ? "active" : "")"
                           href="@Url.Action("Profile", "Account")">

                            <i class="bi bi-person-gear"></i> <span class="link-text">My Profile</span>

                        </a>

                    }

                    else if (userRole == "Admin")

                    {

                        <div class="sidebar-label">Administration</div>

                        <a class="nav-link @(currentController == "Admin" && currentAction == "Dashboard" ? "active" : "")"
                           href="@Url.Action("Dashboard", "Admin")">

                            <i class="bi bi-speedometer2"></i> <span class="link-text">Dashboard</span>

                        </a>

                        <a class="nav-link @(currentController == "Admin" && currentAction == "Applications" ? "active" : "")"
                           href="@Url.Action("Applications", "Admin")">

                            <i class="bi bi-file-earmark-text"></i> <span class="link-text">Applications</span>

                        </a>

                        <a class="nav-link @(currentController == "Admin" && currentAction == "Registrations" ? "active" : "")"
                           href="@Url.Action("Registrations", "Admin")">

                            <i class="bi bi-mortarboard"></i> <span class="link-text">Registrations</span>

                        </a>

                        <a class="nav-link @(currentController == "Admin" && currentAction == "StreamGroups" ? "active" : "")"
                           href="@Url.Action("StreamGroups", "Admin")">

                            <i class="bi bi-diagram-3"></i> <span class="link-text">Stream Groups</span>

                        </a>



                        <hr class="sidebar-divider" />

                        <div class="sidebar-label">Staff</div>

                        <a class="nav-link @(currentController == "Teacher" ? "active" : "")"
                           href="@Url.Action("Index", "Teacher")">

                            <i class="bi bi-people me-2"></i><span class="link-text text-truncate">Teachers</span>

                        </a>

                        <a class="nav-link @(currentController == "Timetable" ? "active" : "")"
                           href="@Url.Action("Generate", "Timetable")">

                            <i class="bi bi-calendar3"></i> <span class="link-text">Timetable</span>

                        </a>



                        <hr class="sidebar-divider" />

                        <div class="sidebar-label">Attendance Logs</div>

                        <a class="nav-link @(currentController == "Admin" && currentAction == "TeacherAttendanceHistory" ? "active" : "")"
                           href="@Url.Action("TeacherAttendanceHistory", "Admin")">

                            <i class="bi bi-clock-history"></i> <span class="link-text">Teacher Check‑In/Out</span>

                        </a>

                        <a class="nav-link @(currentController == "Admin" && currentAction == "StudentAttendanceHistory" ? "active" : "")"
                           href="@Url.Action("StudentAttendanceHistory", "Admin")">

                            <i class="bi bi-journal-bookmark-fill"></i> <span class="link-text">Student Register</span>

                        </a>

                        <hr class="sidebar-divider" />
                        <a class="nav-link @(currentController == "DriverApplications" && currentAction == "Index" ? "active" : "")"
                           href="@Url.Action("Index", "DriverApplications")">
                            <i class="bi bi-person-badge"></i> <span class="link-text">Driver Applications</span>
                        </a>
                        <hr class="sidebar-divider" />

                        <div class="sidebar-label">Emergency Management</div>

                        <a class="nav-link @(currentController == "Emergency" && currentAction == "TriggerAlert" ? "active" : "")"
                           href="@Url.Action("TriggerAlert", "Emergency")">

                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <span class="link-text">Trigger Emergency</span>

                        </a>

                        <a class="nav-link @(currentController == "Emergency" && currentAction == "LatestAlertStatus" ? "active" : "")"
                           href="@Url.Action("LatestAlertStatus", "Emergency")">

                            <i class="bi bi-shield-check"></i>
                            <span class="link-text">Emergency Accountability</span>

                        </a>

                        <hr class="sidebar-divider" />

                        <div class="sidebar-label">Boarding House</div>

                        <a class="nav-link @(currentController == "Residence" ? "active" : "")"
                           href="@Url.Action("Index", "Residence")">
                            <i class="bi bi-building"></i> <span class="link-text">Residences</span>
                        </a>

                        <a class="nav-link @(currentController == "Room" ? "active" : "")"
                           href="@Url.Action("Index", "Room")">
                            <i class="bi bi-door-open"></i> <span class="link-text">Rooms</span>
                        </a>

                        <a class="nav-link @(currentController == "Bed" ? "active" : "")"
                           href="@Url.Action("Index", "Bed")">
                            <i class="bi bi-grid-3x3-gap"></i> <span class="link-text">Beds</span>
                        </a>

                        <a class="nav-link @(currentController == "HouseMaster" && currentAction == "Index" ? "active" : "")"
                           href="@Url.Action("Index", "HouseMaster")">
                            <i class="bi bi-people"></i> <span class="link-text">House Masters</span>
                        </a>

                        <a class="nav-link @(currentController == "HouseMaster" ? "active" : "")"
                           href="@Url.Action("Dashboard", "HouseMaster")">
                            <i class="bi bi-person-workspace"></i> <span class="link-text">House Master Dashboard</span>
                        </a>

                        <a class="nav-link @(currentController == "ResidenceAssignment" ? "active" : "")"
                           href="@Url.Action("Index", "ResidenceAssignment")">
                            <i class="bi bi-person-check"></i> <span class="link-text">Student Assignments</span>
                        </a>

                        <a class="nav-link @(currentController == "ResidenceAllocation" && currentAction == "Dashboard" ? "active" : "")"
                           href="@Url.Action("Dashboard", "ResidenceAllocation")">
                            <i class="bi bi-diagram-3"></i> <span class="link-text">Allocation Dashboard</span>
                        </a>

                        <a class="nav-link @(currentController == "ResidenceAllocation" && currentAction == "Index" ? "active" : "")"
                           href="@Url.Action("Index", "ResidenceAllocation")">
                            <i class="bi bi-list-check"></i> <span class="link-text">Allocation Records</span>
                        </a>

                        <a class="nav-link @(currentController == "ResidenceMovement" ? "active" : "")"
                           href="@Url.Action("Index", "ResidenceMovement")">
                            <i class="bi bi-arrow-left-right"></i> <span class="link-text">Movements</span>
                        </a>

                        <a class="nav-link @(currentController == "StudentQRCode" ? "active" : "")"
                           href="@Url.Action("Index", "StudentQRCode")">
                            <i class="bi bi-qr-code"></i> <span class="link-text">Student QR Codes</span>
                        </a>

                        <a class="nav-link @(currentController == "QRScanRecord" ? "active" : "")"
                           href="@Url.Action("Index", "QRScanRecord")">
                            <i class="bi bi-clock-history"></i> <span class="link-text">QR Scan History</span>
                        </a>

                        <a class="nav-link @(currentController == "ResidenceAllocation" && currentAction == "AIDashboard" ? "active" : "")"
                           href="@Url.Action("AIDashboard", "ResidenceAllocation")">
                            <i class="bi bi-graph-up-arrow"></i> <span class="link-text">Residence Analytics</span>
                        </a>

                        <hr class="sidebar-divider" />
                        <div class="sidebar-label">Visitor Management</div>

                        <a class="nav-link @(currentController == "VisitorAnalytics" && currentAction == "Index" ? "active" : "")"
                           href="@Url.Action("Index", "VisitorAnalytics")">
                            <i class="bi bi-bar-chart-fill"></i>
                            <span class="link-text">Visitor Analytics</span>
                        </a>

                        <a class="nav-link @(currentController == "VisitorAnalytics" && currentAction == "ActiveVisitors" ? "active" : "")"
                           href="@Url.Action("ActiveVisitors", "VisitorAnalytics")">
                            <i class="bi bi-person-walking"></i>
                            <span class="link-text">Active Visitors</span>
                        </a>

                    }
                    else if (userRole == "InventoryManager")
                    {
                        <hr class="sidebar-divider" />



                        <div class="sidebar-label">Logistics & Supply</div>



                        <a class="nav-link @(ctrl == "Inventory" ? "active" : "")"
                           href="@Url.Action("Index", "Inventory")">

                            <div class="nav-link-content">

                                <i class="bi bi-boxes"></i>

                                <span>Inventory </span>

                            </div>

                            @if (lowStockCount > 0)

                            {

                                <span class="nav-badge danger animate-pulse">@lowStockCount</span>

                            }

                        </a>



                        <a class="nav-link @(ctrl == "Supplier" ? "active" : "")"
                           href="@Url.Action("Index", "Supplier")">

                            <div class="nav-link-content">

                                <i class="bi bi-truck-flatbed"></i>

                                <span>Supplier Registry</span>

                            </div>

                        </a>



                        <a class="nav-link @(ctrl == "PurchaseOrder" ? "active" : "")"
                           href="@Url.Action("Index", "PurchaseOrder")">

                            <div class="nav-link-content">

                                <i class="bi bi-file-earmark-medical"></i>

                                <span>Purchase Orders</span>

                            </div>

                        </a>



                    }

                    else if (userRole == "HouseMaster" || userRole == "Housemaster")
                    {
                        <div class="sidebar-label">Boarding House</div>

                        <a class="nav-link @(currentController == "HouseMaster" && currentAction == "Dashboard" ? "active" : "")"
                           href="@Url.Action("Dashboard", "HouseMaster")">
                            <i class="bi bi-speedometer2"></i> <span class="link-text">Dashboard</span>
                        </a>

                        <a class="nav-link @(currentController == "HouseMaster" && currentAction == "ScanQRCode" ? "active" : "")"
                           href="@Url.Action("ScanQRCode", "HouseMaster")">
                            <i class="bi bi-qr-code-scan"></i> <span class="link-text">Scan QR</span>
                        </a>

                        <hr class="sidebar-divider" />
                        <div class="sidebar-label">Emergency Management</div>

                        <a class="nav-link @(currentController == "Emergency" && currentAction == "TriggerAlert" ? "active" : "")"
                           href="@Url.Action("TriggerAlert", "Emergency")">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <span class="link-text">Trigger Emergency</span>
                        </a>

                        <a class="nav-link @(currentController == "Emergency" && currentAction == "LatestAlertStatus" ? "active" : "")"
                           href="@Url.Action("LatestAlertStatus", "Emergency")">
                            <i class="bi bi-shield-check"></i>
                            <span class="link-text">Emergency Accountability</span>
                        </a>


                        <hr class="sidebar-divider" />
                        <div class="sidebar-label">Residence Management</div>
                        <a class="nav-link @(currentController == "Residence" ? "active" : "")"
                           href="@Url.Action("Index", "Residence")">
                            <i class="bi bi-building"></i> <span class="link-text">Residences</span>
                        </a>

                        <a class="nav-link @(currentController == "Room" ? "active" : "")"
                           href="@Url.Action("Index", "Room")">
                            <i class="bi bi-door-open"></i> <span class="link-text">Rooms</span>
                        </a>

                        <a class="nav-link @(currentController == "Bed" ? "active" : "")"
                           href="@Url.Action("Index", "Bed")">
                            <i class="bi bi-grid-3x3-gap"></i> <span class="link-text">Beds</span>
                        </a>

                        <a class="nav-link @(currentController == "ResidenceAssignment" ? "active" : "")"
                           href="@Url.Action("Index", "ResidenceAssignment")">
                            <i class="bi bi-person-check"></i> <span class="link-text">Assignments</span>
                        </a>

                        <a class="nav-link @(currentController == "ResidenceAllocation" && currentAction == "Dashboard" ? "active" : "")"
                           href="@Url.Action("Dashboard", "ResidenceAllocation")">
                            <i class="bi bi-diagram-3"></i> <span class="link-text">Allocations</span>
                        </a>

                        <a class="nav-link @(currentController == "ResidenceMovement" ? "active" : "")"
                           href="@Url.Action("Index", "ResidenceMovement")">
                            <i class="bi bi-arrow-left-right"></i> <span class="link-text">Movements</span>
                        </a>

                        <a class="nav-link @(currentController == "QRScanRecord" ? "active" : "")"
                           href="@Url.Action("Index", "QRScanRecord")">
                            <i class="bi bi-clock-history"></i> <span class="link-text">QR History</span>
                        </a>

                        <hr class="sidebar-divider" />
                        <a class="nav-link" href="@Url.Action("HouseMasterPending", "LeaveRequest")">
                            <i class="bi bi-qr-code-scan"></i> <span class="link-text">Leave Requests</span>
                        </a>

                        <a class="nav-link @(currentController == "VisitorAccess" && currentAction == "HousemasterQueue" ? "active" : "")"
                           href="@Url.Action("HousemasterQueue", "VisitorAccess")">
                            <i class="bi bi-person-check"></i>

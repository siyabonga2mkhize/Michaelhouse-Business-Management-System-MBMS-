                        </a>
                        <a class="nav-link @(currentController == "MealCollection" && currentAction == "ServedToday" ? "active" : "")"
                           href="@Url.Action("ServedToday", "MealCollection")">
                            <i class="bi bi-graph-up"></i> <span class="link-text">Served Today</span>
                        </a>

                        <hr class="sidebar-divider" />
                        <div class="sidebar-label">Inventory</div>

                        <a class="nav-link @(currentController == "CafeteriaInventory" ? "active" : "")"
                           href="@Url.Action("Index", "CafeteriaInventory")">
                            <i class="bi bi-box-seam"></i> <span class="link-text">Stock</span>
                        </a>

                        <hr class="sidebar-divider" />
                        <div class="sidebar-label">Settings</div>

                        <a class="nav-link @(currentController == "Account" && currentAction == "Profile" ? "active" : "")"
                           href="@Url.Action("Profile", "Account")">
                            <i class="bi bi-person-gear"></i> <span class="link-text">My Profile</span>
                        </a>
                    }
                    else if (userRole == "Coach")
                    {
                        <div class="sidebar-label">Coach Portal</div>

                        <a class="nav-link @(currentController == "CoachSquad" && currentAction == "Index" ? "active" : "")"
                           href="@Url.Action("Index", "CoachSquad")">
                            <i class="bi bi-people"></i> <span class="link-text">My Sports</span>
                        </a>
                        <a class="nav-link @(currentController == "CoachSquad" && currentAction == "Priorities" ? "active" : "")"
                           href="@Url.Action("Priorities", "CoachSquad")">
                            <i class="bi bi-flag"></i> <span class="link-text">Weekly Priorities</span>
                        </a>

                        <hr class="sidebar-divider" />
                        <div class="sidebar-label">Fixtures</div>

                        <a class="nav-link @(currentController == "Coach" && currentAction == "Index" ? "active" : "")"
                           href="@Url.Action("Index", "Coach")">
                            <i class="bi bi-calendar-event"></i> <span class="link-text">My Fixtures</span>
                        </a>
                        <a class="nav-link @(currentController == "Coach" && currentAction == "Create" ? "active" : "")"
                           href="@Url.Action("Create", "Coach")">
                            <i class="bi bi-plus-circle"></i> <span class="link-text">Add Fixture</span>
                        </a>

                        <hr class="sidebar-divider" />
                        <div class="sidebar-label">Settings</div>

                        <a class="nav-link @(currentController == "Account" && currentAction == "Profile" ? "active" : "")"
                           href="@Url.Action("Profile", "Account")">
                            <i class="bi bi-person-gear"></i> <span class="link-text">My Profile</span>
                        </a>
                    }
                    else if (userRole == "Dietitian")
                    {
                        <div class="sidebar-label">Dietitian</div>

                        <a class="nav-link @(currentController == "MealLibrary" ? "active" : "")"
                           href="@Url.Action("Index", "MealLibrary")">
                            <i class="bi bi-journal-bookmark"></i> <span class="link-text">Meals</span>
                        </a>

                        <hr class="sidebar-divider" />
                        <div class="sidebar-label">Settings</div>

                        <a class="nav-link @(currentController == "Account" && currentAction == "Profile" ? "active" : "")"
                           href="@Url.Action("Profile", "Account")">
                            <i class="bi bi-person-gear"></i> <span class="link-text">My Profile</span>
                        </a>
                    }

                    @* Event invitations — students, parents and staff RSVP here,
                       whether or not they saw the notification *@
                    @if (userRole == "Student" || userRole == "Parent" || Michaelhouse.Services.EventRsvpService.IsStaffRole(userRole))
                    {
                        <hr class="sidebar-divider" />
                        <div class="sidebar-label">Invitations</div>
                        <a class="nav-link @(currentController == "Rsvp" ? "active" : "")"
                           href="@Url.Action("MyEvents", "Rsvp")">
                            <i class="bi bi-calendar-event"></i> <span class="link-text">My Event Invitations</span>
                        </a>
                    }

                </nav>
            </div>
        }

        <div class="main-content @(isHomePage ? "full-width" : "p-4")" style="width: 100%; max-width: none;">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show mb-4">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show mb-4">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()

        </div>

    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        // SIDEBAR TOGGLE
        document.addEventListener("DOMContentLoaded", function () {
            var btn = document.getElementById("sidebarCollapse");
            var sidebar = document.getElementById("sidebar");

            if (btn && sidebar) {
                var collapsed = localStorage.getItem("mhSidebarCollapsed") === "true";

                if (collapsed) {
                    sidebar.classList.add("collapsed");
                    btn.setAttribute("aria-expanded", "false");
                }

                // Phones: hidden until the menu button opens it
                var phone = window.matchMedia("(max-width: 767.98px)");
                if (phone.matches) {
                    sidebar.classList.remove("collapsed");
                    btn.setAttribute("aria-expanded", "false");
                }

                btn.addEventListener("click", function (event) {
                    event.preventDefault();
                    if (phone.matches) {
                        var open = sidebar.classList.toggle("mobile-open");
                        btn.setAttribute("aria-expanded", open.toString());
                        return;
                    }
                    var isCollapsed = sidebar.classList.toggle("collapsed");
                    btn.setAttribute("aria-expanded", (!isCollapsed).toString());
                    localStorage.setItem("mhSidebarCollapsed", isCollapsed.toString());
                });
            }
        });

        // NOTIFICATIONS
        function loadNotifications() {
            if (typeof $ === "undefined") return;

            $.get('@Url.Action("GetNotificationsPartial", "Notification")', function(data) {
                $('#notificationList').html(data);
                updateBadge();
            });
        }

        function updateBadge() {
            if (typeof $ === "undefined") return;

            $.get('@Url.Action("GetUnreadCount", "Notification")', function(count) {
                if (count > 0) {
                    $('#notificationBadge').text(count).show();
                } else {
                    $('#notificationBadge').hide();
                }
            });
        }

        // SIREN CONTROL
        var sirenAudio = null;
        var sirenStarted = false;

        function playSiren() {
            if (sirenStarted) return;
            if (!sirenAudio) {
                sirenAudio = new Audio('@Url.Content("~/Content/siren.mp3")');
                sirenAudio.loop = true;
            }
            sirenAudio.play()
                .then(() => {
                    sirenStarted = true;
                    hideSirenButton();
                })
                .catch(function(error) {
                    showSirenButton();
                });
        }

        function stopSiren() {
            if (sirenAudio) {
                sirenAudio.pause();
                sirenAudio.currentTime = 0;
                sirenStarted = false;
            }
            hideSirenButton();
        }

        function showSirenButton() {
            var btn = document.getElementById('sirenPlayBtn');
            if (!btn) {
                btn = document.createElement('button');
                btn.id = 'sirenPlayBtn';
                btn.innerHTML = '🔊 Play Alert Siren';
                btn.style.position = 'fixed';
                btn.style.bottom = '30px';
                btn.style.right = '30px';
                btn.style.zIndex = '9999';
                btn.style.padding = '12px 24px';
                btn.style.backgroundColor = '#C21E2E';
                btn.style.color = '#fff';
                btn.style.border = 'none';
                btn.style.borderRadius = '4px';
                btn.style.cursor = 'pointer';
                btn.style.fontWeight = 'bold';
                btn.style.boxShadow = '0 4px 12px rgba(0,0,0,0.3)';
                btn.onclick = function() {
                    playSiren();
                };
                document.body.appendChild(btn);
            }
            btn.style.display = 'block';
        }

        function hideSirenButton() {
            var btn = document.getElementById('sirenPlayBtn');
            if (btn) btn.style.display = 'none';
        }

        // EMERGENCY STATUS + SIREN
        function checkEmergencyStatus() {
            var isLoggedIn = @(Session["UserId"] != null ? "true" : "false");
            if (!isLoggedIn || typeof $ === "undefined") return;

            var role = '@Session["UserRole"]';
            if (role !== 'Student') return;

            $.ajax({
                url: '@Url.Action("GetActiveAlertForStudent", "Emergency")',
                type: 'GET',
                cache: false,
                success: function (data) {
                    if (data.hasActiveAlert && !data.alreadyConfirmed) {
                        window.location.href = '@Url.Action("ConfirmSafety", "Emergency")';
                        return;
                    }

                    if (data.hasActiveAlert && !data.sirenStopped) {
                        playSiren();
                    } else {
                        stopSiren();
                    }
                },
                error: function () {
                }
            });
        }

        $(function () {
            loadNotifications();
            setInterval(loadNotifications, 30000);

            checkEmergencyStatus();
            setInterval(checkEmergencyStatus, 5000);
        });
    </script>
    @RenderSection("Scripts", required: false)

</body>
</html>
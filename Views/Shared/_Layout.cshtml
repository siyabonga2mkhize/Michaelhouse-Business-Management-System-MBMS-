<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Michaelhouse</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        :root {
            --primary: #1a3c5e;
            --accent: #e8a020;
        }

        body {
            background: #f4f6f9;
            font-family: 'Segoe UI', sans-serif;
            margin: 0;
        }

        .navbar {
            background: var(--primary) !important;
        }

        .navbar-brand {
            color: #fff !important;
            font-weight: 700;
            letter-spacing: 0.03em;
        }

        .nav-link {
            color: rgba(255,255,255,0.85) !important;
        }

            .nav-link:hover {
                color: var(--accent) !important;
            }

        .sidebar {
            background: var(--primary);
            min-height: calc(100vh - 56px);
            padding-top: 16px;
            width: 220px;
            min-width: 220px;
        }

            .sidebar .nav-link {
                color: rgba(255,255,255,0.72);
                padding: 10px 20px;
                border-radius: 6px;
                margin: 2px 8px;
                font-size: 0.9rem;
            }

                .sidebar .nav-link:hover,
                .sidebar .nav-link.active {
                    background: rgba(255,255,255,0.15);
                    color: #fff !important;
                }

                .sidebar .nav-link i {
                    width: 20px;
                }

        .sidebar-label {
            color: rgba(255,255,255,0.4);
            font-size: 0.68rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            padding: 8px 20px 4px;
        }

        .sidebar-divider {
            border-color: rgba(255,255,255,0.1);
            margin: 8px 16px;
        }

        .main-content {
            padding: 28px 32px;
            flex: 1;
            min-width: 0;
        }

        .card {
            border: none;
            border-radius: 12px;
            box-shadow: 0 2px 14px rgba(0,0,0,0.07);
        }

        .card-header {
            border-radius: 12px 12px 0 0 !important;
            font-weight: 600;
        }

        .btn-primary {
            background: var(--primary);
            border-color: var(--primary);
        }

            .btn-primary:hover {
                background: #14304d;
                border-color: #14304d;
            }

        .page-header {
            border-bottom: 2px solid var(--accent);
            padding-bottom: 12px;
            margin-bottom: 26px;
        }

        .user-pill {
            background: rgba(255,255,255,0.12);
            border-radius: 20px;
            padding: 4px 12px;
            font-size: 0.82rem;
            color: #fff;
        }

            .user-pill .role-badge {
                background: var(--accent);
                color: #000;
                font-size: 0.7rem;
                font-weight: 700;
                padding: 1px 7px;
                border-radius: 10px;
                margin-left: 6px;
            }
    </style>
</head>
<body>
    @{
        string currentController = (ViewContext.RouteData.Values["controller"] ?? "").ToString();
        string currentAction = (ViewContext.RouteData.Values["action"] ?? "").ToString();
        string userRole = Session["UserRole"]?.ToString() ?? "";
        string userName = Session["UserName"]?.ToString() ?? "";
        bool isLoggedIn = Session["UserId"] != null;
    }

    <nav class="navbar navbar-expand-lg px-3">
        <a class="navbar-brand" href="@Url.Action("Login", "Account")">
            <i class="bi bi-mortarboard-fill me-2"></i>Michaelhouse
        </a>

        @if (isLoggedIn)
        {
            <div class="ms-auto d-flex align-items-center gap-3">
                <div class="user-pill">
                    <i class="bi bi-person-circle me-1"></i>@userName
                    <span class="role-badge">@userRole</span>
                </div>
                <a href="@Url.Action("Logout", "Account")" class="btn btn-sm btn-outline-light">
                    <i class="bi bi-box-arrow-right me-1"></i>Logout
                </a>
            </div>
        }
    </nav>

    <div class="d-flex">

        @if (isLoggedIn)
        {
            <div class="sidebar d-none d-md-block">
                <nav class="nav flex-column">

                    @if (userRole == "Parent")
                    {
                        <div class="sidebar-label">My Portal</div>
                        <a class="nav-link @(currentAction == "Index"      ? "active" : "")"
                           href="@Url.Action("Index", "Applications")">
                            <i class="bi bi-grid-1x2 me-2"></i>My Applications
                        </a>

                        <a class="nav-link @(currentAction == "Create"     ? "active" : "")"
                           href="@Url.Action("Create", "Applications")">
                            <i class="bi bi-plus-circle me-2"></i>New Application
                        </a>
                        <a class="nav-link @(currentAction == "AddStudent" ? "active" : "")"
                           href="@Url.Action("AddStudent", "Applications")">
                            <i class="bi bi-person-plus me-2"></i>Add Student
                        </a>
                        <hr class="sidebar-divider" />
                        <div class="sidebar-label">Account</div>
                        <a class="nav-link @(currentAction == "Profile"    ? "active" : "")"
                           href="@Url.Action("Profile", "Account")">
                            <i class="bi bi-person-gear me-2"></i>My Profile
                        </a>
                    }
                    else if (userRole == "Admin")
                    {
                        <div class="sidebar-label">Administration</div>
                        <a class="nav-link @(currentAction == "Dashboard"  ? "active" : "")"
                           href="@Url.Action("Dashboard", "Admin")">
                            <i class="bi bi-speedometer2 me-2"></i>Dashboard
                        </a>
                        <a class="nav-link @(currentController == "Admin" && currentAction == "Review" ? "active" : "")"
                           href="@Url.Action("Dashboard", "Admin")">
                            <i class="bi bi-files me-2"></i>All Applications
                        </a>
                        <a class="nav-link @(currentAction == "Registrations" ? "active" : "")"
                           href="@Url.Action("Registrations", "Admin")">
                            <i class="bi bi-mortarboard me-2"></i>Registrations
                        </a>
                    }
                    else if (userRole == "Teacher")
                    {
                        <div class="sidebar-label">Teacher Portal</div>

                        <a class="nav-link @(currentController == "Teacher" && currentAction == "Dashboard" ? "active" : "")"
                           href="@Url.Action("Dashboard", "Teacher")">
                            <i class="bi bi-house-door me-2"></i>Dashboard
                        </a>

                        <a class="nav-link @(currentController == "TeacherAttendance" && currentAction == "Index" ? "active" : "")"
                           href="@Url.Action("Index", "TeacherAttendance")">
                            <i class="bi bi-clipboard-check me-2"></i>Check In/Out
                        </a>

                        <a class="nav-link @(currentController == "Attendances" && currentAction == "Index" ? "active" : "")"
                           href="@Url.Action("Index", "Attendances")">
                            <i class="bi bi-list-check me-2"></i>Mark Register
                        </a>

                        <a class="nav-link @(currentController == "Attendances" && currentAction == "History" ? "active" : "")"
                           href="@Url.Action("History", "Attendances")">
                            <i class="bi bi-clock-history me-2"></i>Attendance History
                        </a>
                    }


                </nav>
            </div>
        }

        <div class="main-content">

            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }
            @if (TempData["Info"] != null)
            {
                <div class="alert alert-info alert-dismissible fade show">
                    <i class="bi bi-info-circle-fill me-2"></i>@TempData["Info"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            @RenderBody()
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>

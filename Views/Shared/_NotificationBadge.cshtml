@{
    var count = ViewBag.Count ?? 0;
}

<div class="dropdown me-3">
    @* --- INSTITUTIONAL BELL TRIGGER --- *@
    <a href="#" class="text-gray-500 hover:text-[#C21E2E] transition-colors relative flex items-center justify-center p-2" data-bs-toggle="dropdown" id="notificationBell" data-bs-auto-close="outside">
        <i class="bi bi-bell text-xl"></i>

        @* Technical Alert Badge *@
        @if (count > 0)
        {
            <span class="absolute top-0 right-0 transform translate-x-1 -translate-y-1 bg-[#C21E2E] text-white font-mono text-[9px] font-bold px-1.5 py-0.5 shadow-sm border border-white" id="notificationBadge">
                @count
            </span>
        }
        else
        {
            <span class="absolute top-0 right-0 transform translate-x-1 -translate-y-1 bg-[#C21E2E] text-white font-mono text-[9px] font-bold px-1.5 py-0.5 shadow-sm border border-white" id="notificationBadge" style="display: none;">
                0
            </span>
        }
    </a>

    @* --- DROPDOWN SHELL --- *@
    <div class="dropdown-menu dropdown-menu-end shadow-2xl border border-gray-100 rounded-none p-0 mt-3" style="width: 360px; border-radius: 0 !important;">

        @* Note: The Dark Institutional Header and the scrollable list
            are generated inside the _NotificationList Partial View
        *@
        <div id="notificationList" class="bg-white">
            @await Html.PartialAsync("_NotificationsList")
        </div>

        @* --- INSTITUTIONAL FOOTER LINK --- *@
        <div class="p-0 border-t border-gray-100 bg-gray-50/50">
            <a href="@Url.Action("Index", "Notification")" class="block w-full text-center px-4 py-4 text-[9px] font-bold uppercase tracking-[3px] text-gray-500 hover:text-[#C21E2E] hover:bg-gray-100 transition-colors">
                Access Master Ledger <i class="bi bi-arrow-right ml-1"></i>
            </a>
        </div>
    </div>
</div>

<style>
    .font-serif { font-family: 'Playfair Display', serif !important; }
    .font-mono { font-family: 'Source Code Pro', monospace !important; }

    /* Override Bootstrap dropdown defaults to match the sharp aesthetic */
    .dropdown-menu {
        border-radius: 0 !important;
        animation: dropFade 0.2s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    keyframes dropFade {
        0% { opacity: 0; transform: translateY(-10px); }
        100% { opacity: 1; transform: translateY(0); }
    }
</style>
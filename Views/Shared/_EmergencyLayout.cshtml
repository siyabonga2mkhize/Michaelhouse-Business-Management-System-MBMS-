<!DOCTYPE html>
<html lang="en" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Michaelhouse Emergency</title>

    @* --- TAILWIND CSS & BOOTSTRAP ICONS --- *@
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    @* --- INSTITUTIONAL FONTS --- *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Source+Code+Pro:wght@400;600;700&family=Montserrat:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        .font-serif {
            font-family: 'Playfair Display', serif !important;
        }

        .font-mono {
            font-family: 'Source Code Pro', monospace !important;
        }

        .font-sans {
            font-family: 'Montserrat', sans-serif !important;
        }

        /* Custom smooth scrollbars */
        ::-webkit-scrollbar {
            width: 5px;
            height: 5px;
        }

        ::-webkit-scrollbar-thumb {
            background: #d1d5db;
            border-radius: 10px;
        }

            ::-webkit-scrollbar-thumb:hover {
                background: #C21E2E;
            }
    </style>
</head>
<body class="bg-gray-100 text-gray-900 font-sans h-full flex flex-col overflow-hidden antialiased">

    @* --- TOP NAVIGATION & INSTITUTIONAL BRANDING HEADER --- *@
    <header class="bg-[#1a1a1a] text-white border-b-2 border-[#C21E2E] flex-shrink-0 z-50">
        <div class="px-6 py-3 flex justify-between items-center">

            @* Left: Brand / System Identity *@
            <div class="flex items-center gap-4">
                <div class="flex items-center gap-2">
                    <div class="h-6 w-[3px] bg-[#C21E2E]"></div>
                    <span class="font-serif font-bold text-lg tracking-wider text-white">MICHAELHOUSE</span>
                </div>
                <div class="h-4 w-[1px] bg-gray-700 hidden sm:block"></div>
                <span class="text-[9px] font-mono text-gray-400 uppercase tracking-[3px] hidden sm:block">
                    Emergency & Risk Management System
                </span>
            </div>

            @* Right: Active System Status & Navigation *@
            <div class="flex items-center gap-4">
                <div class="hidden md:flex items-center gap-2 px-3 py-1 bg-gray-900 border border-gray-800 text-[9px] font-mono text-emerald-400">
                    <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                    <span>SYSTEM ONLINE</span>
                </div>

                <a href="@Url.Action("Logout", "Account")" class="inline-flex items-center gap-2 bg-[#C21E2E] hover:bg-red-700 text-white px-4 py-1.5 text-[9px] font-bold uppercase tracking-[2px] font-mono transition-all shadow-sm">
                    <i class="bi bi-box-arrow-right"></i>
                    <span>Logout</span>
                </a>
            </div>
        </div>
    </header>

    @* --- MAIN VIEWPORT BODY WRAPPER --- *@
    <main class="flex-grow min-h-0 flex flex-col w-full bg-gray-50/50 relative overflow-hidden">
        @RenderBody()
    </main>

    @* --- REQUIRED SCRIPTS --- *@
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    @RenderSection("Scripts", required: false)
</body>
</html>
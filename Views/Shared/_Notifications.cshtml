@model List<Michaelhouse.Models.Notification>

@if (Model.Any())
{
    @* Institutional Dropdown Header *@
    <div class="px-4 py-3 bg-[#1a1a1a] text-white border-b border-gray-800 flex justify-between items-center sticky top-0 z-10">
        <h6 class="text-[9px] uppercase tracking-[3px] font-bold mb-0"><i class="bi bi-bell me-2 text-gray-400"></i> Active Alerts</h6>
        <span class="text-[9px] font-mono font-bold bg-[#C21E2E] px-2 py-0.5">@Model.Count</span>
    </div>

    @* Scrollable Alert Ledger *@
    <div class="max-h-80 overflow-y-auto custom-scrollbar bg-white">
        @foreach (var notif in Model)
        {
            string href = "#";
            string iconClass = "";
            string iconColour = "text-gray-400";

            if (notif.RelatedEntityType == "CafeteriaEvent" && notif.RelatedEntityId > 0)
            {
                href = Url.Action("Event", "Rsvp", new { id = notif.RelatedEntityId });
                iconClass = "bi-calendar-event";
                iconColour = "text-[#C21E2E]";
            }
            else if (notif.RelatedEntityType == "FeastPlan" && notif.RelatedEntityId > 0)
            {
                href = Url.Action("FeastPlan", "Event", new { id = notif.RelatedEntityId });
                iconClass = "bi-egg-fried";
                iconColour = "text-[#C21E2E]";
            }

            <a href="@href"
               class="block px-4 py-4 border-b border-gray-50 hover:bg-gray-50 transition-all group notification-item relative"
               data-id="@notif.Id"
               data-href="@href">
                <div class="flex gap-3">
                    <div class="flex-shrink-0 mt-1">
                        @if (!string.IsNullOrEmpty(iconClass))
                        {
                            <i class="bi @iconClass @iconColour" style="font-size:.9rem;"></i>
                        }
                        else
                        {
                            <div class="w-1.5 h-1.5 rounded-full bg-[#C21E2E] group-hover:scale-150 transition-transform"></div>
                        }
                    </div>
                    <div>
                        <div class="text-[9px] font-mono text-gray-400 uppercase tracking-widest mb-1 group-hover:text-[#C21E2E] transition-colors">
                            @notif.CreatedAt.ToString("dd MMM yyyy • HH:mm")
                        </div>
                        <div class="text-xs font-serif text-gray-800 leading-snug pe-4">
                            @notif.Message
                        </div>

                        @* Hover Action Indicator *@
                        <div class="text-[8px] font-bold uppercase tracking-[2px] text-gray-400 mt-2 opacity-0 group-hover:opacity-100 transition-opacity">
                            @if (!string.IsNullOrEmpty(iconClass))
                            {
                                <i class="bi bi-arrow-right me-1"></i> <text>Open</text>
                            }
                            else
                            {
                                <i class="bi bi-check2-all me-1"></i> <text>Acknowledge</text>
                            }
                        </div>
                    </div>
                </div>
            </a>
        }
    </div>
}
else
{
    @* Empty State *@
    <div class="px-4 py-8 text-center bg-white">
        <i class="bi bi-bell-slash text-gray-200 text-4xl d-block mb-3"></i>
        <h6 class="text-[9px] uppercase tracking-[3px] font-bold text-gray-400 mb-0">No Active Alerts</h6>
    </div>
}

<style>
    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }

    .font-mono {
        font-family: 'Source Code Pro', monospace !important;
    }

    .custom-scrollbar::-webkit-scrollbar {
        width: 4px;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #eee;
        border-radius: 10px;
    }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #C21E2E;
        }
</style>

<script>
    $(function () {
        $('.notification-item').click(function (e) {
            e.preventDefault();

            var $item = $(this);
            var id = $item.data('id');
            var targetUrl = $item.data('href');

            $item.css('opacity', '0.4');

            $.post('@Url.Action("MarkAsRead", "Notification")', { id: id }, function () {
                if (targetUrl && targetUrl !== '#') {
                    window.location.href = targetUrl;
                    return;
                }

                $item.slideUp(250, function () {
                    $(this).remove();

                    if (typeof updateBadge === "function") {
                        updateBadge();
                    }

                    var badgeSpan = $('#notificationBadge');
                    var current = parseInt(badgeSpan.text()) || 0;
                    var newCount = current - 1;

                    if (newCount > 0) {
                        badgeSpan.text(newCount).show();
                    } else {
                        badgeSpan.hide();
                        location.reload();
                    }
                });
            }).fail(function () {
                $item.css('opacity', '1');
            });
        });
    });
</script>
@model Michaelhouse.Models.VisitorAccessRequest

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Request Visitor Access";
}

<div class="flex flex-col h-full w-full overflow-hidden bg-gray-50/30">

    <div class="mb-6 d-flex justify-content-between align-items-end border-b border-gray-200 pb-6 flex-shrink-0 px-8 pt-8 bg-white shadow-sm relative z-10">
        <div>
            <div class="flex items-center gap-2 mb-3">
                <div class="h-[2px] w-8 bg-[#C21E2E]"></div>
                <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Visitor Management</h5>
            </div>
            <h2 class="text-5xl font-serif font-bold text-gray-900 tracking-tight">Request Campus Access</h2>
        </div>
    </div>

    <div class="flex-grow min-h-0 overflow-y-auto custom-scrollbar px-8 pb-10 pt-4 flex justify-center">
        <div class="w-full max-w-4xl">

            @using (Html.BeginForm("Create", "VisitorAccess", FormMethod.Post, new { @class = "bg-white shadow-sm border border-gray-100 flex flex-col relative overflow-hidden group/form" }))
            {
                @Html.AntiForgeryToken()

                <div class="p-6 border-b border-gray-100 bg-gray-50/50 flex justify-between items-center relative z-10">
                    <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-900 mb-0"><i class="bi bi-ui-checks-grid me-2 text-gray-400"></i> Public Visitor Application</h5>
                </div>

                <div class="p-8 space-y-10 relative z-10">

                    @* Validation Summary Box *@
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="bg-red-50 border-l-4 border-[#C21E2E] p-4 mb-6">
                            <div class="flex items-center mb-2">
                                <i class="bi bi-exclamation-triangle-fill text-[#C21E2E] me-2"></i>
                                <span class="font-bold text-xs uppercase tracking-wider text-[#C21E2E]">Please correct the following errors:</span>
                            </div>
                            @Html.ValidationSummary(false, "", new { @class = "text-xs font-semibold text-red-700 list-disc list-inside space-y-1" })
                        </div>
                    }

                    @* Host Student & House Details *@
                    <div class="border-b border-gray-100 pb-6">
                        <h6 class="text-[11px] uppercase tracking-[2px] font-bold text-[#C21E2E] mb-4">1. Host Student Details</h6>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                            <div>
                                <label class="block text-[9px] uppercase tracking-[2px] font-bold text-gray-400 mb-2">Student Full Name</label>
                                <input type="text" name="studentSearch" value="@ViewBag.StudentSearch" required class="w-full border-b-2 border-gray-200 py-3 outline-none focus:border-[#C21E2E] font-serif text-sm text-gray-900 transition-colors bg-transparent" placeholder="e.g. Thabo Nkosi" />
                            </div>

                            <div>
                                <label class="block text-[9px] uppercase tracking-[2px] font-bold text-gray-400 mb-2">Boarding House</label>
                                @Html.EditorFor(m => m.BoardingHouseName, new { htmlAttributes = new { @class = "w-full border-b-2 border-gray-200 py-3 outline-none focus:border-[#C21E2E] font-serif text-sm text-gray-900 transition-colors bg-transparent", @placeholder = "e.g. Founders House", @required = "required" } })
                                @Html.ValidationMessageFor(m => m.BoardingHouseName, "", new { @class = "text-[#C21E2E] text-[9px] font-bold uppercase mt-2 block tracking-widest" })
                            </div>
                        </div>
                    </div>

                    @* Visitor Information *@
                    <div>
                        <h6 class="text-[11px] uppercase tracking-[2px] font-bold text-[#C21E2E] mb-4">2. Visitor Information</h6>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                            <div>
                                <label class="block text-[9px] uppercase tracking-[2px] font-bold text-gray-400 mb-2">Visitor Full Name</label>
                                @Html.EditorFor(m => m.VisitorFullName, new { htmlAttributes = new { @class = "w-full border-b-2 border-gray-200 py-3 outline-none focus:border-[#C21E2E] font-serif text-sm text-gray-900 transition-colors bg-transparent", @required = "required" } })
                                @Html.ValidationMessageFor(m => m.VisitorFullName, "", new { @class = "text-[#C21E2E] text-[9px] font-bold uppercase mt-2 block tracking-widest" })
                            </div>

                            <div>
                                <label class="block text-[9px] uppercase tracking-[2px] font-bold text-gray-400 mb-2">Visitor Phone</label>
                                @Html.EditorFor(m => m.VisitorPhone, new { htmlAttributes = new { @class = "w-full border-b-2 border-gray-200 py-3 outline-none focus:border-[#C21E2E] font-mono text-sm text-gray-900 transition-colors bg-transparent", @required = "required" } })
                                @Html.ValidationMessageFor(m => m.VisitorPhone, "", new { @class = "text-[#C21E2E] text-[9px] font-bold uppercase mt-2 block tracking-widest" })
                            </div>

                            <div>
                                <label class="block text-[9px] uppercase tracking-[2px] font-bold text-gray-400 mb-2">Visitor Email</label>
                                @Html.EditorFor(m => m.VisitorEmail, new { htmlAttributes = new { @class = "w-full border-b-2 border-gray-200 py-3 outline-none focus:border-[#C21E2E] font-mono text-sm text-gray-900 transition-colors bg-transparent", @type = "email", @required = "required" } })
                                @Html.ValidationMessageFor(m => m.VisitorEmail, "", new { @class = "text-[#C21E2E] text-[9px] font-bold uppercase mt-2 block tracking-widest" })
                            </div>

                            <div>
                                <label class="block text-[9px] uppercase tracking-[2px] font-bold text-gray-400 mb-2">Relationship to Student</label>
                                @Html.EditorFor(m => m.RelationshipToBoy, new { htmlAttributes = new { @class = "w-full border-b-2 border-gray-200 py-3 outline-none focus:border-[#C21E2E] font-serif text-sm text-gray-900 transition-colors bg-transparent", @required = "required" } })
                                @Html.ValidationMessageFor(m => m.RelationshipToBoy, "", new { @class = "text-[#C21E2E] text-[9px] font-bold uppercase mt-2 block tracking-widest" })
                            </div>
                        </div>

                        <div class="mt-6">
                            <label class="flex items-center gap-4 bg-gray-50/50 border border-gray-200 p-4 cursor-pointer hover:bg-gray-50 transition-colors shadow-sm">
                                @Html.CheckBoxFor(m => m.IsParentOrGuardian, new { @class = "w-4 h-4 text-[#C21E2E] border-gray-300 focus:ring-[#C21E2E] cursor-pointer" })
                                <span class="text-[10px] uppercase tracking-[2px] font-bold text-gray-700">I am a Parent or Legal Guardian</span>
                            </label>
                        </div>
                    </div>

                    @* Date and Time Schedule *@
                    <div>
                        <h6 class="text-[11px] uppercase tracking-[2px] font-bold text-[#C21E2E] mb-4">3. Visit Schedule</h6>
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                            <div>
                                <label class="block text-[9px] uppercase tracking-[2px] font-bold text-gray-400 mb-2">Visit Date</label>
                                @Html.TextBoxFor(m => m.VisitDate, "{0:yyyy-MM-dd}", new { @class = "w-full border-b-2 border-gray-200 py-3 outline-none focus:border-[#C21E2E] font-mono text-sm text-gray-900 transition-colors bg-transparent cursor-pointer", @type = "date", @required = "required" })
                                @Html.ValidationMessageFor(m => m.VisitDate, "", new { @class = "text-[#C21E2E] text-[9px] font-bold uppercase mt-2 block tracking-widest" })
                            </div>

                            <div>
                                <label class="block text-[9px] uppercase tracking-[2px] font-bold text-gray-400 mb-2">Start Time</label>
                                @Html.TextBoxFor(m => m.StartTime, @"{0:hh\:mm}", new { @class = "w-full border-b-2 border-gray-200 py-3 outline-none focus:border-[#C21E2E] font-mono text-sm text-gray-900 transition-colors bg-transparent cursor-pointer", @type = "time", @required = "required" })
                                @Html.ValidationMessageFor(m => m.StartTime, "", new { @class = "text-[#C21E2E] text-[9px] font-bold uppercase mt-2 block tracking-widest" })
                            </div>

                            <div>
                                <label class="block text-[9px] uppercase tracking-[2px] font-bold text-gray-400 mb-2">End Time</label>
                                @Html.TextBoxFor(m => m.EndTime, @"{0:hh\:mm}", new { @class = "w-full border-b-2 border-gray-200 py-3 outline-none focus:border-[#C21E2E] font-mono text-sm text-gray-900 transition-colors bg-transparent cursor-pointer", @type = "time", @required = "required" })
                                @Html.ValidationMessageFor(m => m.EndTime, "", new { @class = "text-[#C21E2E] text-[9px] font-bold uppercase mt-2 block tracking-widest" })
                            </div>
                        </div>
                    </div>

                    @* Zone & Purpose *@
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <div>
                            <label class="block text-[9px] uppercase tracking-[2px] font-bold text-gray-400 mb-2">Requested Access Zone</label>
                            <div class="relative">
                                @Html.EnumDropDownListFor(m => m.RequestedZone, "Select Access Area", new { @class = "w-full border-b-2 border-gray-200 py-3 outline-none focus:border-[#C21E2E] font-serif text-sm text-gray-900 transition-colors bg-transparent appearance-none cursor-pointer pr-10", @required = "required" })
                                <i class="bi bi-chevron-down absolute right-2 top-1/2 -translate-y-1/2 text-gray-400 pointer-events-none"></i>
                            </div>
                        </div>

                        <div>
                            <label class="block text-[9px] uppercase tracking-[2px] font-bold text-gray-400 mb-2">Purpose of Visit</label>
                            @Html.TextAreaFor(m => m.PurposeOfVisit, new { @class = "w-full border-b-2 border-gray-200 py-3 outline-none focus:border-[#C21E2E] font-serif text-sm text-gray-900 transition-colors bg-transparent resize-y", rows = 3, @required = "required" })
                        </div>
                    </div>
                </div>

                <div class="bg-[#1a1a1a] p-6 flex justify-between items-center relative z-10 mt-4 flex-col sm:flex-row gap-4">
                    <button type="submit" class="w-full sm:w-auto bg-[#C21E2E] text-white px-8 py-3 text-[10px] font-bold uppercase tracking-[3px] hover:bg-red-700 transition-all duration-300">
                        Submit Access Request <i class="bi bi-arrow-right ms-2"></i>
                    </button>
                </div>
            }
        </div>
    </div>
</div>
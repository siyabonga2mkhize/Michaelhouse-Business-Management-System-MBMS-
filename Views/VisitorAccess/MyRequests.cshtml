@model IEnumerable<Michaelhouse.Models.VisitorAccessRequest>
@using Michaelhouse.Models

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "My Incoming Visitors";
}

<div class="flex flex-col h-full w-full overflow-hidden bg-gray-50/30">

    <div class="mb-6 d-flex justify-content-between align-items-end border-b border-gray-200 pb-6 flex-shrink-0 px-8 pt-8 bg-white shadow-sm relative z-10">
        <div>
            <div class="flex items-center gap-2 mb-3">
                <div class="h-[2px] w-8 bg-[#C21E2E]"></div>
                <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Visitor Management</h5>
            </div>
            <h2 class="text-5xl font-serif font-bold text-gray-900 tracking-tight">My Incoming Visitors</h2>
        </div>
    </div>

    <div class="flex-grow min-h-0 overflow-y-auto custom-scrollbar px-8 pb-10 pt-4 flex flex-col">

        @if (TempData["StudentNotification"] != null)
        {
            <div class="bg-blue-50/80 border-l-4 border-[#C21E2E] p-5 shadow-sm flex flex-col mb-4 relative">
                <div class="flex items-center mb-2">
                    <i class="bi bi-bell-fill me-3 text-lg text-[#C21E2E]"></i>
                    <span class="text-xs font-bold uppercase tracking-widest text-[#C21E2E]">House Notification</span>
                </div>
                <p class="mb-1 font-serif text-sm ms-8 text-blue-900">@TempData["StudentNotification"]</p>
            </div>
        }

        <div class="bg-white shadow-sm border border-gray-100 flex flex-col flex-grow min-h-0 relative overflow-hidden group">
            <div class="p-6 border-b border-gray-100 bg-gray-50/50 flex justify-between items-center relative z-10 flex-shrink-0">
                <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-900 mb-1"><i class="bi bi-card-list me-2 text-gray-400"></i> Approved & Pending Guest Registry</h5>
            </div>

            <div class="table-responsive flex-grow overflow-y-auto custom-scrollbar relative z-10">
                <table class="table table-hover mb-0 align-middle w-full">
                    <thead class="sticky top-0 z-20 bg-white shadow-sm">
                        <tr class="text-[9px] uppercase tracking-[4px] font-bold text-gray-400 border-b border-gray-200 bg-gray-50/80">
                            <th class="ps-8 py-5">Visitor Name</th>
                            <th class="border-l border-gray-100 ps-6">Relationship</th>
                            <th class="border-l border-gray-100 ps-6">Scheduled Date</th>
                            <th class="border-l border-gray-100 ps-6">Approved Zone</th>
                            <th class="pe-8 border-l border-gray-100 ps-6">Status</th>
                        </tr>
                    </thead>
                    <tbody class="text-gray-700">
                        @if (Model == null || !Model.Any())
                        {
                            <tr>
                                <td colspan="5" class="py-20 text-center">
                                    <i class="bi bi-inbox text-gray-200 text-6xl d-block mb-4"></i>
                                    <h4 class="text-serif font-bold text-gray-400 uppercase tracking-[3px]">No Scheduled Visits</h4>
                                    <p class="text-[11px] font-mono text-gray-400 mt-2">There are currently no registered visits linked to your profile.</p>
                                </td>
                            </tr>
                        }
                        else
                        {
                            foreach (var item in Model)
                            {
                                <tr class="group/row hover:bg-gray-50/80 transition-all duration-300 border-b border-gray-50 last:border-0">
                                    <td class="ps-8 py-5">
                                        <div class="font-serif font-bold text-gray-900 text-lg group-hover/row:text-[#C21E2E] transition-colors">@item.VisitorFullName</div>
                                    </td>
                                    <td class="border-l border-gray-50 ps-6 font-serif text-sm">
                                        @item.RelationshipToBoy
                                    </td>
                                    <td class="border-l border-gray-50 ps-6">
                                        <span class="font-mono text-sm font-bold text-blue-700">@item.VisitDate.ToString("dd MMM yyyy")</span>
                                        <span class="block text-xs text-gray-500 font-mono">@item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm")</span>
                                    </td>
                                    <td class="border-l border-gray-50 ps-6 font-serif text-sm font-bold text-[#C21E2E]">
                                        @item.FinalAssignedZone
                                    </td>
                                    <td class="pe-8 border-l border-gray-50 ps-6">
                                        @if (item.Status == VisitorRequestStatus.AutoApprovedWeekend || item.Status == VisitorRequestStatus.Approved)
                                        {
                                            <span class="inline-flex items-center text-[9px] font-bold uppercase tracking-widest bg-green-100 text-green-800 px-3 py-1 border border-green-200 shadow-sm">
                                                Approved
                                            </span>
                                        }
                                        else if (item.Status == VisitorRequestStatus.PendingHousemaster)
                                        {
                                            <span class="inline-flex items-center text-[9px] font-bold uppercase tracking-widest bg-yellow-100 text-yellow-800 px-3 py-1 border border-yellow-200 shadow-sm">
                                                Pending Review
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center text-[9px] font-bold uppercase tracking-widest bg-red-100 text-[#C21E2E] px-3 py-1 border border-red-200 shadow-sm">
                                                Declined
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

    </div>
</div>
@model Michaelhouse.Models.DriverApplication
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Active = "queue";
}
<div class="row">
    <div class="col-md-3">
        @Html.Partial("_TransportSidebar")
    </div>
    <div class="col-md-9">
        <h2>Application Details</h2>

        <dl class="row">
            <dt class="col-sm-3">Full Name</dt>
            <dd class="col-sm-9">@Model.FullName</dd>
            <dt class="col-sm-3">Email</dt>
            <dd class="col-sm-9">@Model.Email</dd>
            <dt class="col-sm-3">Phone</dt>
            <dd class="col-sm-9">@Model.PhoneNumber</dd>
            <dt class="col-sm-3">ID Number</dt>
            <dd class="col-sm-9">@Model.IDNumber</dd>
            <dt class="col-sm-3">Licence</dt>
            <dd class="col-sm-9">@Model.LicenceNumber</dd>
            <dt class="col-sm-3">Status</dt>
            <dd class="col-sm-9">@Model.Status</dd>
            <dt class="col-sm-3">Submitted</dt>
            <dd class="col-sm-9">@Model.DateSubmitted</dd>
        </dl>

        <hr />
        <a name="actions"></a>
        @using (Html.BeginForm("UpdateStatus", "Transport", FormMethod.Post, new { @class = "form-inline" }))
        {
            @Html.AntiForgeryToken()
            @Html.Hidden("id", Model.Id)
            <div class="form-group mb-2">
                <label class="sr-only">Decision</label>
                <select name="decision" class="form-control">
                    <option value="MoreInfo">Request More Info</option>
                    <option value="Shortlist">Shortlist (Schedule Interview)</option>
                    <option value="Reject">Reject</option>
                </select>
            </div>
            <div class="form-group mx-sm-2 mb-2">
                <input type="datetime-local" name="interviewDate" class="form-control" />
            </div>
            <div class="form-group mx-sm-2 mb-2">
                <input type="text" name="notes" class="form-control" placeholder="Admin notes" />
            </div>
            <button type="submit" class="btn btn-primary mb-2">Apply</button>
        }

        @using (Html.BeginForm("RecordInterviewResult", "Transport", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.Hidden("id", Model.Id)
            <div class="btn-group mt-3" role="group">
                <button type="submit" name="result" value="Passed" class="btn btn-success">Mark Interview Passed</button>
                <button type="submit" name="result" value="Failed" class="btn btn-danger">Mark Interview Failed</button>
            </div>
        }

        @if (Model.Status == "InterviewPassed")
        {
            using (Html.BeginForm("Approve", "Transport", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.Hidden("id", Model.Id)
                <button type="submit" class="btn btn-success mt-3">Approve & Create Driver</button>
            }
        }
    </div>
</div>

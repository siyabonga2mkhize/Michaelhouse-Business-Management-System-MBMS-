@model Michaelhouse.Models.EnrollmentViewModel

@{
    ViewData["Title"] = "Register Student for Subject";
}

<div class="container mt-4">
    <div class="card border-primary">
        <div class="card-header bg-primary text-white">
            <h4>Student Subject Registration</h4>
        </div>
        <div class="card-body">
            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()

                <div class="form-group mb-3">
                    <label>Select Student</label>
                    @Html.DropDownListFor(m => m.SelectedStudentId, Model.StudentList, "-- Select Student --", new { @class = "form-control" })
                </div>

                <div class="form-group mb-3">
                    <label>Select Subject</label>
                    @Html.DropDownListFor(m => m.SelectedSubjectId, Model.SubjectList, "-- Select Subject --", new { @class = "form-control" })
                </div>

                <div class="form-group mb-3">
                    <label>Academic Year</label>
                    @Html.TextBoxFor(m => m.AcademicYear, new { @class = "form-control", @readonly = "readonly" })
                </div>

                <button type="submit" class="btn btn-success">Register Student</button>
                @Html.ActionLink("Cancel", "Index", "Home", null, new { @class = "btn btn-secondary" })
            }
        </div>
    </div>
</div>
@using System.Linq
@using Michaelhouse.Models.Cafeteria
@{
    ViewBag.Title = "Dashboard";

    var pendingMenus = ViewBag.PendingMenus as List<MealMenu> ?? new List<MealMenu>();
    var acceptedMenus = ViewBag.AcceptedMenus as List<MealMenu> ?? new List<MealMenu>();

    var latestAccepted = acceptedMenus.FirstOrDefault();
}

<div class="container-fluid py-4">

    <div class="mb-4">
        <h1 class="h3 mb-1">Meal Coordinator</h1>
        <p class="text-muted mb-0">
            Overview of weekly menus awaiting review and recently published.
        </p>
    </div>

    <!-- SUMMARY CARDS -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="small text-muted text-uppercase">Pending Review</div>
                    <div class="display-6 text-warning">@pendingMenus.Count</div>
                    <div class="small text-muted mt-1">
                        @(pendingMenus.Count == 1 ? "menu awaiting review" : "menus awaiting review")
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="small text-muted text-uppercase">Latest Published</div>
                    @if (latestAccepted != null)
                    {
                        <div class="fw-bold fs-5 mt-2">
                            @latestAccepted.StartDate.ToString("dd MMM") - @latestAccepted.EndDate.ToString("dd MMM")
                        </div>
                        <div class="small text-muted mt-1">
                            @latestAccepted.StartDate.Year
                        </div>
                    }
                    else
                    {
                        <div class="text-muted mt-2">No menus published yet</div>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="small text-muted text-uppercase">Next Week</div>
                    <div class="fw-bold fs-5 mt-2">Not generated</div>
                    <div class="small text-muted mt-1">Create a proposal when ready</div>
                </div>
            </div>
        </div>

    </div>

    <!-- SCHEDULE BUTTON -->
    <div class="card shadow-sm mb-4">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <strong>Schedule a new menu</strong>
                <div class="small text-muted">
                    Enter requirements and generate a proposed menu for a week.
                </div>
            </div>
            <a href="@Url.Action("Schedule", "Cafeteria")"
               class="btn btn-primary">
                + Schedule Menu
            </a>
        </div>
    </div>

    <!-- PENDING MENUS -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white">
            <strong>Awaiting Review</strong>
            <span class="badge bg-warning text-dark ms-2">@pendingMenus.Count</span>
        </div>
        <div class="card-body p-0">
            @if (!pendingMenus.Any())
            {
                <div class="p-4 text-muted">No menus pending review.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Period</th>
                                <th>Created</th>
                                <th>Chef Status</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var menu in pendingMenus)
                            {
                                <tr>
                                    <td class="fw-bold">
                                        @menu.StartDate.ToString("dd MMM") - @menu.EndDate.ToString("dd MMM yyyy")
                                    </td>
                                    <td class="small text-muted">
                                        @menu.CreatedDate.ToString("dd MMM HH:mm")
                                    </td>
                                    <td>
                                        @if (menu.IsKitchenReady)
                                        {
                                            <span class="badge bg-success">Kitchen Ready</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Awaiting Chef</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a href="@Url.Action("Review", "Cafeteria", new { id = menu.Id })"
                                           class="btn btn-sm btn-outline-primary">
                                            Open Review
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- RECENTLY PUBLISHED -->
    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <strong>Recently Published</strong>
        </div>
        <div class="card-body p-0">
            @if (!acceptedMenus.Any())
            {
                <div class="p-4 text-muted">No published menus yet.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Period</th>
                                <th>Published</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var menu in acceptedMenus)
                            {
                                <tr>
                                    <td class="fw-bold">
                                        @menu.StartDate.ToString("dd MMM") - @menu.EndDate.ToString("dd MMM yyyy")
                                    </td>
                                    <td class="small text-muted">
                                        @(menu.LastModifiedDate.HasValue ? menu.LastModifiedDate.Value.ToString("dd MMM HH:mm") : "-")
                                    </td>
                                    <td class="text-end">
                                        <a href="@Url.Action("Review", "Cafeteria", new { id = menu.Id })"
                                           class="btn btn-sm btn-outline-primary">
                                            View
                                        </a>
                                        <a href="@Url.Action("KitchenRequirements", "Cafeteria", new { id = menu.Id })"
                                           class="btn btn-sm btn-outline-success">
                                            Kitchen List
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

</div>


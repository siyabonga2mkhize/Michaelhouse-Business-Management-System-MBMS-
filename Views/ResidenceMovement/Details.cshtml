@model Michaelhouse.Models.ResidenceMovement
@{ Layout = "~/Views/Shared/_Layout.cshtml"; ViewBag.Title = "Movement Details"; }
<div class="container py-4">
    <h2>Movement Details</h2>
    <dl class="dl-horizontal"><dt>Student</dt><dd>@Model.Student.Name</dd><dt>From</dt><dd>@(Model.FromResidence?.Name ?? "-") @(Model.FromRoom?.RoomNumber)</dd><dt>To</dt><dd>@(Model.ToResidence?.Name ?? "-") @(Model.ToRoom?.RoomNumber)</dd><dt>Performed By</dt><dd>@Model.PerformedByName</dd><dt>Date</dt><dd>@Model.PerformedAt.ToString("g")</dd><dt>Reason</dt><dd>@Model.Reason</dd></dl>
    <a class="btn btn-primary" href="@Url.Action("Edit", new { id = Model.ResidenceMovementId })">Edit</a>
    <a class="btn btn-danger" href="@Url.Action("Archive", new { id = Model.ResidenceMovementId })">Archive</a>
    <a class="btn btn-default" href="@Url.Action("Index")">Back</a>
</div>

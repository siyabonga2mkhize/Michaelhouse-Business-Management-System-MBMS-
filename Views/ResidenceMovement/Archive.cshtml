@model Michaelhouse.Models.ResidenceMovement
@{ Layout = "~/Views/Shared/_Layout.cshtml"; ViewBag.Title = "Archive Movement"; }
<div class="container py-4"><h2>Archive Movement</h2><div class="alert alert-warning">Archive this movement record?</div>
@using (Html.BeginForm("Archive", "ResidenceMovement", FormMethod.Post)) { @Html.AntiForgeryToken() <input type="hidden" name="id" value="@Model.ResidenceMovementId" /><button class="btn btn-danger" type="submit">Archive</button> <a class="btn btn-default" href="@Url.Action("Details", new { id = Model.ResidenceMovementId })">Cancel</a> }
</div>

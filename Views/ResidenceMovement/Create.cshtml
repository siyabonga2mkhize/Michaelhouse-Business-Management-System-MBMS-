@model Michaelhouse.Models.ResidenceMovement

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Move Student";
}

<!-- HEADER -->
<div class="bg-white border-b border-gray-200 px-8 py-8">

    <div class="flex items-center gap-2 mb-3">
        <div class="h-[2px] w-8 bg-[#C21E2E]"></div>

        <span class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">
            Residence Management
        </span>
    </div>

    <div class="flex justify-between items-end">

        <div>
            <h1 class="text-4xl font-serif font-bold text-gray-900">
                Move Student
            </h1>

            <p class="text-sm text-gray-500 mt-2">
                Transfer a student to a different residence and room.
                An available bed will be assigned automatically.
            </p>
        </div>

        <a href="@Url.Action("Index")"
           class="px-5 py-3 border border-gray-300 bg-white text-gray-600
                  text-[10px] font-bold uppercase tracking-[2px]
                  hover:bg-gray-50 transition">

            <i class="bi bi-arrow-left me-2"></i>
            Back to Movements

        </a>

    </div>

</div>


<!-- FORM AREA -->
<div class="px-8 py-8">

    <div class="max-w-5xl mx-auto">

        @using (Html.BeginForm(
            "Create",
            "ResidenceMovement",
            FormMethod.Post,
            new { id = "movementForm" }))
        {
            @Html.AntiForgeryToken()

            @Html.ValidationSummary(
                true,
                "",
                new
                {
                    @class =
                        "mb-6 bg-red-50 border-l-4 border-[#C21E2E] " +
                        "text-[#C21E2E] p-4 text-sm"
                })


            <!-- ================================================= -->
            <!-- STUDENT SEARCH -->
            <!-- ================================================= -->

            <div class="bg-white border border-gray-200 shadow-sm mb-6">

                <div class="px-6 py-5 border-b border-gray-100 bg-gray-50">

                    <div class="flex items-center gap-3">

                        <div class="w-9 h-9 bg-[#C21E2E] text-white
                                    flex items-center justify-center">

                            <i class="bi bi-person-search"></i>

                        </div>

                        <div>

                            <h2 class="text-xs uppercase tracking-[3px]
                                       font-bold text-gray-900">
                                Student
                            </h2>

                            <p class="text-[11px] text-gray-400 mt-1">
                                Search by student name or student number.
                            </p>

                        </div>

                    </div>

                </div>


                <div class="p-6">

                    <label class="block text-[10px] uppercase
                                  tracking-[2px] font-bold
                                  text-gray-500 mb-2">

                        Search Student

                    </label>


                    <div class="relative">

                        <input type="text"
                               id="studentSearch"
                               autocomplete="off"
                               placeholder="Start typing a name or student number..."
                               class="w-full border border-gray-300
                                      px-4 py-3 text-sm
                                      focus:border-[#C21E2E]
                                      focus:ring-1
                                      focus:ring-[#C21E2E]
                                      outline-none" />


                        <div id="studentResults"
                             class="absolute left-0 right-0
                                    bg-white border border-gray-200
                                    shadow-lg z-50 hidden">
                        </div>

                    </div>


                    @Html.HiddenFor(
                        m => m.StudentId,
                        new { id = "StudentId" }
                    )


                    <!-- SELECTED STUDENT -->

                    <div id="selectedStudent"
                         class="hidden mt-4 bg-gray-50
                                border border-gray-200 p-4">

                        <div class="flex justify-between items-center">

                            <div>

                                <div class="text-[9px] uppercase
                                            tracking-[2px]
                                            text-gray-400 font-bold">

                                    Selected Student

                                </div>

                                <div id="selectedStudentName"
                                     class="text-sm font-bold
                                            text-gray-900 mt-1">
                                </div>

                                <div id="selectedStudentNumber"
                                     class="text-[11px] text-gray-500 mt-1">
                                </div>

                            </div>


                            <button type="button"
                                    id="clearStudent"
                                    class="text-[#C21E2E]
                                           text-[10px]
                                           uppercase tracking-[2px]
                                           font-bold">

                                Change

                            </button>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- CURRENT ASSIGNMENT -->
            <!-- ================================================= -->

            <div id="currentAssignment"
                 class="bg-white border border-gray-200
                        shadow-sm mb-6 hidden">

                <div class="px-6 py-5 border-b border-gray-100
                            bg-gray-50">

                    <div class="flex items-center gap-3">

                        <div class="w-9 h-9 bg-gray-800 text-white
                                    flex items-center justify-center">

                            <i class="bi bi-house-check"></i>

                        </div>

                        <div>

                            <h2 class="text-xs uppercase tracking-[3px]
                                       font-bold text-gray-900">

                                Current Assignment

                            </h2>

                            <p class="text-[11px] text-gray-400 mt-1">

                                Automatically loaded from the student's
                                active residence assignment.

                            </p>

                        </div>

                    </div>

                </div>


                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 p-6">

                    <!-- Residence -->

                    <div class="bg-gray-50 border border-gray-200 p-4">

                        <div class="text-[9px] uppercase tracking-[2px]
                                    font-bold text-gray-400">

                            Residence

                        </div>

                        <div id="currentResidence"
                             class="font-bold text-gray-900 mt-2">

                            —

                        </div>

                    </div>


                    <!-- Room -->

                    <div class="bg-gray-50 border border-gray-200 p-4">

                        <div class="text-[9px] uppercase tracking-[2px]
                                    font-bold text-gray-400">

                            Room

                        </div>

                        <div id="currentRoom"
                             class="font-bold text-gray-900 mt-2">

                            —

                        </div>

                    </div>


                    <!-- Bed -->

                    <div class="bg-gray-50 border border-gray-200 p-4">

                        <div class="text-[9px] uppercase tracking-[2px]
                                    font-bold text-gray-400">

                            Bed

                        </div>

                        <div id="currentBed"
                             class="font-bold text-gray-900 mt-2">

                            —

                        </div>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- DESTINATION -->
            <!-- ================================================= -->

            <div id="destinationSection"
                 class="bg-white border border-gray-200
                        shadow-sm mb-6 hidden">

                <div class="px-6 py-5 border-b border-gray-100
                            bg-gray-50">

                    <div class="flex items-center gap-3">

                        <div class="w-9 h-9 bg-[#C21E2E] text-white
                                    flex items-center justify-center">

                            <i class="bi bi-arrow-right"></i>

                        </div>

                        <div>

                            <h2 class="text-xs uppercase tracking-[3px]
                                       font-bold text-gray-900">

                                New Assignment

                            </h2>

                            <p class="text-[11px] text-gray-400 mt-1">

                                Choose the destination residence and room.
                                An available bed will be assigned automatically.

                            </p>

                        </div>

                    </div>

                </div>


                <div class="p-6 space-y-6">


                    <!-- DESTINATION RESIDENCE -->

                    <div>

                        <label class="block text-[10px] uppercase
                                      tracking-[2px] font-bold
                                      text-gray-500 mb-2">

                            Destination Residence

                        </label>


                        @Html.DropDownListFor(
                            m => m.ToResidenceId,
                            (SelectList)ViewBag.Residences,
                            "Select residence...",
                            new
                            {
                                id = "ToResidenceId",
                                @class =
                                    "w-full border border-gray-300 " +
                                    "px-4 py-3 text-sm bg-white " +
                                    "focus:border-[#C21E2E] " +
                                    "focus:ring-1 " +
                                    "focus:ring-[#C21E2E] outline-none"
                            }
                        )

                    </div>


                    <!-- DESTINATION ROOM -->

                    <div>

                        <label class="block text-[10px] uppercase
                                      tracking-[2px] font-bold
                                      text-gray-500 mb-2">

                            Destination Room

                        </label>


                        <select id="ToRoomId"
                                name="ToRoomId"
                                disabled
                                class="w-full border border-gray-300
                                       px-4 py-3 text-sm bg-gray-100
                                       outline-none">

                            <option value="">
                                Select a residence first...
                            </option>

                        </select>

                    </div>


                    <!-- AUTOMATIC BED -->

                    <div class="bg-blue-50 border-l-4 border-blue-500 p-4">

                        <div class="flex items-start gap-3">

                            <i class="bi bi-magic text-blue-600 mt-1"></i>

                            <div>

                                <div class="text-[10px] uppercase
                                            tracking-[2px]
                                            font-bold text-blue-700">

                                    Automatic Bed Allocation

                                </div>

                                <p class="text-[11px] text-blue-600 mt-1">

                                    Once the destination room is selected,
                                    the system will automatically assign the
                                    first available bed in that room.

                                </p>

                            </div>

                        </div>

                    </div>


                    <!-- AVAILABILITY -->

                    <div id="availabilityMessage"
                         class="hidden p-4 text-[11px]
                                font-bold uppercase tracking-wider">

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- REASON -->
            <!-- ================================================= -->

            <div id="reasonSection"
                 class="bg-white border border-gray-200
                        shadow-sm mb-6 hidden">

                <div class="px-6 py-5 border-b border-gray-100
                            bg-gray-50">

                    <h2 class="text-xs uppercase tracking-[3px]
                               font-bold text-gray-900">

                        Movement Details

                    </h2>

                </div>


                <div class="p-6">

                    <label class="block text-[10px] uppercase
                                  tracking-[2px] font-bold
                                  text-gray-500 mb-2">

                        Reason for Movement

                    </label>


                    @Html.TextAreaFor(
                        m => m.Reason,
                        4,
                        1,
                        new
                        {
                            @class =
                                "w-full border border-gray-300 " +
                                "px-4 py-3 text-sm resize-none " +
                                "focus:border-[#C21E2E] " +
                                "focus:ring-1 " +
                                "focus:ring-[#C21E2E] outline-none",

                            placeholder =
                                "Enter the reason for this movement..."
                        }
                    )

                </div>

            </div>


            <!-- ================================================= -->
            <!-- ACTIONS -->
            <!-- ================================================= -->

            <div id="actionSection"
                 class="hidden bg-[#1a1a1a] px-6 py-5
                        flex justify-between items-center">

                <a href="@Url.Action("Index")"
                   class="text-gray-400 text-[10px]
                          uppercase tracking-[2px]
                          font-bold hover:text-white">

                    Cancel

                </a>


                <button type="submit"
                        id="submitButton"
                        disabled
                        class="bg-green-600 text-white
                               px-8 py-3
                               text-[10px] font-bold
                               uppercase tracking-[3px]
                               hover:bg-green-500
                               disabled:opacity-40
                               disabled:cursor-not-allowed
                               transition">

                    <i class="bi bi-arrow-left-right me-2"></i>

                    Move Student

                </button>

            </div>

        }

    </div>

</div>


@section Scripts {

    <script>

    $(document).ready(function () {

        let searchTimer = null;


        // =====================================================
        // STUDENT SEARCH
        // =====================================================

        $("#studentSearch").on("input", function () {

            const search = $(this).val().trim();

            clearTimeout(searchTimer);

            if (search.length < 2) {

                $("#studentResults")
                    .addClass("hidden")
                    .empty();

                return;
            }


            searchTimer = setTimeout(function () {

                $.getJSON(
                    '@Url.Action("SearchStudents", "ResidenceMovement")',
                    { search: search }
                )
                .done(function (students) {

                    const results = $("#studentResults");

                    results.empty();


                    if (!students || students.length === 0) {

                        results
                            .append(
                                '<div class="p-4 text-sm text-gray-500">' +
                                'No students found.' +
                                '</div>'
                            )
                            .removeClass("hidden");

                        return;
                    }


                    students.forEach(function (student) {

                        const item = $(
                            '<button type="button" ' +
                            'class="block w-full text-left px-4 py-3 ' +
                            'hover:bg-gray-50 border-b border-gray-100">' +

                            '<div class="text-sm font-bold text-gray-900">' +
                            student.Name +
                            '</div>' +

                            '<div class="text-[11px] text-gray-500 mt-1">' +
                            'Student #' + student.StudentId +
                            '</div>' +

                            '</button>'
                        );


                        item.on("click", function () {

                            selectStudent(student);

                        });


                        results.append(item);

                    });


                    results.removeClass("hidden");

                })
                .fail(function () {

                    $("#studentResults")
                        .html(
                            '<div class="p-4 text-sm text-red-600">' +
                            'Unable to search students.' +
                            '</div>'
                        )
                        .removeClass("hidden");

                });

            }, 300);

        });


        // =====================================================
        // SELECT STUDENT
        // =====================================================

        function selectStudent(student) {

            $("#StudentId").val(student.StudentId);

            $("#selectedStudentName")
                .text(student.Name);

            $("#selectedStudentNumber")
                .text("Student #" + student.StudentId);

            $("#selectedStudent")
                .removeClass("hidden");

            $("#studentSearch")
                .val("")
                .addClass("hidden");

            $("#studentResults")
                .addClass("hidden")
                .empty();


            loadCurrentAssignment(student.StudentId);

        }


        // =====================================================
        // CLEAR STUDENT
        // =====================================================

        $("#clearStudent").on("click", function () {

            $("#StudentId").val("");

            $("#selectedStudent")
                .addClass("hidden");

            $("#studentSearch")
                .removeClass("hidden")
                .focus();

            $("#currentAssignment")
                .addClass("hidden");

            $("#destinationSection")
                .addClass("hidden");

            $("#reasonSection")
                .addClass("hidden");

            $("#actionSection")
                .addClass("hidden");

            $("#ToResidenceId").val("");

            $("#ToRoomId")
                .prop("disabled", true)
                .html(
                    '<option value="">Select a residence first...</option>'
                );

            $("#submitButton")
                .prop("disabled", true);

        });


        // =====================================================
        // LOAD CURRENT ASSIGNMENT
        // =====================================================

        function loadCurrentAssignment(studentId) {

            $.getJSON(
                '@Url.Action("GetCurrentAssignment", "ResidenceMovement")',
                { studentId: studentId }
            )
            .done(function (data) {

                if (!data || !data.success) {

                    $("#currentAssignment")
                        .removeClass("hidden");

                    $("#currentResidence").text("No active assignment");
                    $("#currentRoom").text("—");
                    $("#currentBed").text("—");

                }
                else {

                    $("#currentResidence")
                        .text(data.residenceName);

                    $("#currentRoom")
                        .text(data.roomNumber);

                    $("#currentBed")
                        .text(data.bedNumber);

                    $("#currentAssignment")
                        .removeClass("hidden");

                }


                $("#destinationSection")
                    .removeClass("hidden");

            })
            .fail(function () {

                alert("Unable to load the student's current assignment.");

            });

        }


        // =====================================================
        // LOAD ROOMS WHEN RESIDENCE CHANGES
        // =====================================================

        $("#ToResidenceId").on("change", function () {

            const residenceId = $(this).val();

            $("#ToRoomId")
                .empty()
                .prop("disabled", true)
                .append(
                    '<option value="">Loading rooms...</option>'
                );


            $("#availabilityMessage")
                .addClass("hidden")
                .empty();


            $("#reasonSection")
                .addClass("hidden");

            $("#actionSection")
                .addClass("hidden");

            $("#submitButton")
                .prop("disabled", true);


            if (!residenceId) {

                $("#ToRoomId")
                    .html(
                        '<option value="">Select a residence first...</option>'
                    );

                return;

            }


            $.getJSON(
                '@Url.Action("GetAvailableRooms", "ResidenceMovement")',
                { residenceId: residenceId }
            )
            .done(function (rooms) {

                $("#ToRoomId")
                    .empty();


                if (!rooms || rooms.length === 0) {

                    $("#ToRoomId")
                        .append(
                            '<option value="">No available rooms</option>'
                        );

                    showAvailability(
                        "No available rooms in this residence.",
                        false
                    );

                    return;

                }


                $("#ToRoomId")
                    .append(
                        '<option value="">Select room...</option>'
                    );


                rooms.forEach(function (room) {

                    $("#ToRoomId").append(

                        $("<option>", {

                            value: room.RoomId,

                            text:
                                "Room " +
                                room.RoomNumber +
                                " — " +
                                room.AvailableBeds +
                                " bed(s) available"

                        })

                    );

                });


                $("#ToRoomId")
                    .prop("disabled", false);

            })
            .fail(function () {

                $("#ToRoomId")
                    .html(
                        '<option value="">Unable to load rooms</option>'
                    );

            });

        });


        // =====================================================
        // ROOM SELECTED
        // =====================================================

        $("#ToRoomId").on("change", function () {

            const roomId = $(this).val();

            $("#actionSection")
                .addClass("hidden");

            $("#reasonSection")
                .addClass("hidden");

            $("#submitButton")
                .prop("disabled", true);


            if (!roomId) {

                $("#availabilityMessage")
                    .addClass("hidden");

                return;

            }


            $.getJSON(
                '@Url.Action("CheckRoomAvailability", "ResidenceMovement")',
                { roomId: roomId }
            )
            .done(function (data) {

                if (data.available) {

                    showAvailability(
                        "Room available — an available bed will be assigned automatically.",
                        true
                    );

                    $("#reasonSection")
                        .removeClass("hidden");

                    $("#actionSection")
                        .removeClass("hidden");

                    $("#submitButton")
                        .prop("disabled", false);

                }
                else {

                    showAvailability(
                        data.message ||
                        "This room has no available beds.",
                        false
                    );

                }

            })
            .fail(function () {

                showAvailability(
                    "Unable to check room availability.",
                    false
                );

            });

        });


        // =====================================================
        // AVAILABILITY MESSAGE
        // =====================================================

        function showAvailability(message, available) {

            const box = $("#availabilityMessage");

            box
                .removeClass(
                    "hidden bg-green-50 border-green-600 text-green-700 " +
                    "bg-red-50 border-red-600 text-red-700"
                );


            if (available) {

                box.addClass(
                    "bg-green-50 border-l-4 border-green-600 text-green-700"
                );

                box.html(
                    '<i class="bi bi-check-circle me-2"></i>' +
                    message
                );

            }
            else {

                box.addClass(
                    "bg-red-50 border-l-4 border-red-600 text-red-700"
                );

                box.html(
                    '<i class="bi bi-x-circle me-2"></i>' +
                    message
                );

            }

        }


        // =====================================================
        // CLOSE SEARCH RESULTS WHEN CLICKING OUTSIDE
        // =====================================================

        $(document).on("click", function (event) {

            if (!$(event.target).closest("#studentSearch, #studentResults").length) {

                $("#studentResults")
                    .addClass("hidden");

            }

        });

    });

    </script>

}
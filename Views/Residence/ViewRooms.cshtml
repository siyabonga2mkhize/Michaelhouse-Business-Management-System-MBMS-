@model IEnumerable<Michaelhouse.Models.Room>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Residence Rooms";
}

<section class="p-8 max-w-6xl mx-auto">
    <h1 class="text-3xl font-serif font-bold mb-4">Rooms - @ViewBag.Residence</h1>
    <div class="bg-white rounded shadow overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Room</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Capacity</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Occupied</th>
                    <th class="px-6 py-3"></th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                @foreach (var room in Model)
                {
                    <tr>
                        <td class="px-6 py-4 font-semibold">@room.RoomNumber</td>
                        <td class="px-6 py-4">@room.Capacity</td>
                        <td class="px-6 py-4">@room.OccupiedBeds</td>
                        <td class="px-6 py-4 text-right"><a class="text-[#C21E2E] font-bold" href="@Url.Action("ViewBeds", new { roomId = room.RoomId })">Beds</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

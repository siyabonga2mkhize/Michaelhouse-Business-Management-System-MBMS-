@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Residences";
}

<section class="p-8">
    <header class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-4xl font-serif font-bold">Residences</h1>
            <p class="text-sm text-gray-500 mt-1">Manage boarding houses and overview</p>
        </div>
        <div class="flex items-center gap-3">
            <input type="search" placeholder="Search residences..." class="px-4 py-2 border rounded shadow-sm w-64" />
            <a href="@Url.Action("Create")" class="bg-[#C21E2E] text-white px-4 py-2 rounded shadow hover:opacity-95">New Residence</a>
        </div>
    </header>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
        <div class="bg-white p-6 rounded-lg shadow hover:shadow-lg transition">
            <div class="text-sm text-gray-500 uppercase tracking-wider">Total Residences</div>
            <div class="mt-2 text-3xl font-bold">@ViewBag.TotalResidences ?? "-"</div>
        </div>
        <div class="bg-white p-6 rounded-lg shadow">
            <div class="text-sm text-gray-500 uppercase tracking-wider">Average Occupancy</div>
            <div class="mt-2 text-3xl font-bold">@ViewBag.AverageOccupancy ?? "-"</div>
        </div>
        <div class="bg-white p-6 rounded-lg shadow">
            <div class="text-sm text-gray-500 uppercase tracking-wider">Available Beds</div>
            <div class="mt-2 text-3xl font-bold">@ViewBag.TotalAvailableBeds ?? "-"</div>
        </div>
    </div>

    <div class="bg-white rounded-lg shadow">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Name</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Capacity</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Occupied</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Available</th>
                    <th class="px-6 py-3"></th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-100">
                @* Placeholder rows - server should provide model *@
                <tr>
                    <td class="px-6 py-4">Founders House</td>
                    <td class="px-6 py-4">120</td>
                    <td class="px-6 py-4">102</td>
                    <td class="px-6 py-4"><span class="px-2 py-1 bg-green-100 text-green-800 rounded">18</span></td>
                    <td class="px-6 py-4 text-right"><a class="text-[#C21E2E] font-bold" href="#">Details</a></td>
                </tr>
            </tbody>
        </table>
    </div>
</section>
@model Michaelhouse.Models.Residence
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Archive Residence";
}

<section class="p-8 max-w-2xl mx-auto">
    <div class="bg-white p-6 rounded shadow">
        <h1 class="text-2xl font-serif font-bold">Archive Residence</h1>
        <p class="mt-2 text-sm text-gray-600">Are you sure you want to archive <strong>@Model.Name</strong>? This will hide it from normal lists but keep the data for audit.</p>

        <div class="mt-4">
            @using (Html.BeginForm("Archive", "Residence", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.ResidenceId)
                <label class="block text-sm text-gray-600">Please provide a reason (optional)</label>
                <textarea name="reason" class="w-full border rounded px-3 py-2 mt-1" rows="3"></textarea>

                <div class="mt-4 flex gap-3">
                    <button type="submit" class="bg-red-600 text-white px-4 py-2 rounded">Confirm Archive</button>
                    <a href="@Url.Action("Index")" class="px-4 py-2 border rounded">Cancel</a>
                </div>
            }
        </div>
    </div>
</section>
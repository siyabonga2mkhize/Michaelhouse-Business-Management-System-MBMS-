@model IEnumerable<Michaelhouse.Models.VisitorScanLog>
@{
    ViewBag.Title = "Active Visitors";
}

<div class="container mt-4">
    <h2 class="text-uppercase" style="color: #C21E2E;">
        <i class="bi bi-person-walking"></i> Active Visitors
    </h2>
    <hr />
    <p class="text-muted">Visitors currently on campus (entered today, not yet exited).</p>

    @if (!Model.Any())
    {
        <div class="alert alert-success mt-3">
            <h4>All clear</h4>
            <p>There are no visitors currently on campus.</p>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>Visitor</th>
                        <th>Entry Time</th>
                        <th>Zone</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var log in Model)
                    {
                        <tr>
                            <td><strong>@log.Request?.VisitorFullName</strong></td>
                            <td>@log.ScannedAt.ToString("HH:mm")</td>
                            <td>@log.Request?.FinalAssignedZone</td>
                            <td>
                                <span class="badge bg-success">
                                    <i class="bi bi-circle-fill me-1"></i> On Campus
                                </span>
                            </td>
                            <td>
                                <!-- Optional: Manual checkout button for testing -->
                                <form method="post" action="@Url.Action("ManualCheckout", "VisitorAnalytics")" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="requestId" value="@log.RequestId" />
                                    <button type="submit" class="btn btn-sm btn-outline-secondary" onclick="return confirm('Check out @log.Request?.VisitorFullName?')">
                                        <i class="bi bi-box-arrow-right"></i> Check Out
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="mt-3">
            <small class="text-muted">
                <i class="bi bi-info-circle"></i> Total active visitors: <strong>@Model.Count()</strong>
            </small>
        </div>
    }
</div>


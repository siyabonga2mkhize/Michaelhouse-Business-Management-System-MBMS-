@using Michaelhouse.Models.ViewModels
@model List<SportSquadViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "My Sports";

    int upcomingDays = ViewBag.UpcomingDays ?? 14;
}

<style>
    .sq-shell {
        max-width: 1000px;
        margin: 0 auto;
    }

    .sq-header {
        padding-bottom: 1.25rem;
        margin-bottom: 1.5rem;
        border-bottom: 1px solid #eaeaea;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
    }

        .sq-header h1 {
            font-size: 1.9rem;
            margin: 0 0 .35rem 0;
        }

    .sq-meta {
        color: #888;
        font-size: .82rem;
    }

    .sq-sport {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        margin-bottom: 1.25rem;
        overflow: hidden;
    }

    .sq-sport-header {
        padding: .85rem 1.25rem;
        background: #f9fafb;
        border-bottom: 1px solid #e5e7eb;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .sq-sport-name {
        font-weight: 700;
        font-size: .95rem;
    }

    .sq-sport-count {
        font-size: .8rem;
        color: #6b7280;
    }

    .sq-row {
        display: grid;
        grid-template-columns: minmax(150px, 1fr) 120px 100px minmax(120px, 1fr) auto;
        gap: 1rem;
        padding: .85rem 1.25rem;
        border-bottom: 1px solid #f3f4f6;
        align-items: center;
        font-size: .88rem;
    }

        .sq-row:last-child {
            border-bottom: none;
        }

    .sq-player {
        font-weight: 600;
        color: #111827;
    }

    .sq-number {
        font-size: .75rem;
        color: #9ca3af;
    }

    .sq-badge {
        font-size: .72rem;
        padding: .2rem .6rem;
        border-radius: 4px;
        font-weight: 600;
    }

        .sq-badge.ok {
            background: #d1fae5;
            color: #065f46;
        }

        .sq-badge.out {
            background: #fee2e2;
            color: #991b1b;
        }

    .sq-reason {
        font-size: .75rem;
        color: #6b7280;
        font-style: italic;
    }

    .sq-btn {
        font-size: .78rem;
        padding: .3rem .7rem;
        border-radius: 4px;
        border: 1px solid;
        cursor: pointer;
        background: #fff;
        font-weight: 600;
    }

        .sq-btn.mark-out {
            border-color: #fca5a5;
            color: #991b1b;
        }

            .sq-btn.mark-out:hover {
                background: #fef2f2;
            }

        .sq-btn.mark-in {
            border-color: #86efac;
            color: #065f46;
        }

            .sq-btn.mark-in:hover {
                background: #f0fdf4;
            }

    .sq-fixtures {
        padding: .75rem 1.25rem;
        border-bottom: 1px solid #e5e7eb;
        background: #fcfcfd;
        font-size: .82rem;
    }

    .sq-fixture {
        display: flex;
        flex-wrap: wrap;
        gap: .75rem;
        align-items: baseline;
        padding: .2rem 0;
    }

    .sq-fixture-type {
        font-size: .68rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .05em;
        padding: .1rem .45rem;
        border-radius: 4px;
        background: #e5e7eb;
        color: #374151;
    }

        .sq-fixture-type.match {
            background: #fee2e2;
            color: #991b1b;
        }

    @@media (max-width: 1280px) {
        .sq-row {
            grid-template-columns: 1fr 1fr;
        }

            .sq-row > .text-end {
                grid-column: 1 / -1;
                text-align: left !important;
            }
    }

    .sq-empty {
        padding: 2rem;
        text-align: center;
        color: #9ca3af;
        font-size: .9rem;
    }
</style>

<div class="container-fluid py-4">
    <div class="sq-shell">

        <div class="sq-header">
            <div>
                <h1>My Sports</h1>
                <div class="sq-meta">
                    Players come from the sports parents select on their children's profiles &mdash; you don't keep a list.
                    Mark a player unavailable (injury, leave, suspension) and they're left out of that sport's match and training
                    meal recommendations until they're available again. They still get their normal meals.
                </div>
            </div>
            <a href="@Url.Action("Create", "Coach")" class="btn btn-primary btn-sm">+ Add Fixture</a>
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="sq-sport sq-empty">
                No students have a sport on their profile yet.
            </div>
        }
        else
        {
            foreach (var sport in Model)
            {
                <div class="sq-sport">
                    <div class="sq-sport-header">
                        <span class="sq-sport-name">@sport.Sport</span>
                        <span class="sq-sport-count">@sport.AvailableCount of @sport.Players.Count available today</span>
                    </div>

                    <div class="sq-fixtures">
                        <div class="fw-semibold mb-1">Upcoming (next @upcomingDays days)</div>
                        @if (!sport.Upcoming.Any())
                        {
                            <div class="text-muted">
                                Nothing scheduled.
                                <a href="@Url.Action("Create", "Coach")">Add a training or match</a>
                            </div>
                        }
                        else
                        {
                            foreach (var f in sport.Upcoming)
                            {
                                <div class="sq-fixture">
                                    <span class="sq-fixture-type @(f.EventType == "Match" ? "match" : "")">@f.EventType</span>
                                    <span class="fw-semibold">@f.Date.ToString("ddd dd MMM")</span>
                                    <span>@f.StartTime.ToString(@"hh\:mm")&ndash;@f.EndTime.ToString(@"hh\:mm")</span>
                                    <span>@f.Label</span>
                                    <span class="text-muted">
                                        &middot; @f.Players player@(f.Players == 1 ? "" : "s")@(f.House != null ? " in " + f.House : "")
                                    </span>
                                    <a class="ms-auto small" href="@Url.Action("Edit", "Coach", new { id = f.Id })">Edit</a>
                                </div>
                            }
                        }
                    </div>

                    @if (!sport.Players.Any())
                    {
                        <div class="sq-empty">No students have @sport.Sport on their profile.</div>
                    }

                    @foreach (var player in sport.Players)
                    {
                        <div class="sq-row">
                            <div>
                                <div class="sq-player">@player.Name</div>
                                <div class="sq-number">@player.StudentNumber</div>
                            </div>

                            <div class="small">
                                <div>@(player.Grade ?? "-")</div>
                                <div class="sq-number">@(player.House ?? "No house")</div>
                            </div>

                            <div>
                                @if (player.IsAvailableToday)
                                {
                                    <span class="sq-badge ok">Available</span>
                                }
                                else
                                {
                                    <span class="sq-badge out">Unavailable</span>
                                }
                            </div>

                            <div class="sq-reason">
                                @if (!player.IsAvailableToday && !string.IsNullOrEmpty(player.StatusReason))
                                {
                                    <span>@player.StatusReason</span>
                                    if (player.UnavailableUntil.HasValue)
                                    {
                                        <span> &middot; until @player.UnavailableUntil.Value.ToString("dd MMM")</span>
                                    }
                                }
                            </div>

                            <div class="text-end">
                                @if (player.IsAvailableToday)
                                {
                                    <form action="@Url.Action("MarkUnavailable", "CoachSquad")" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@player.StatusId" />

                                        <input type="text"
                                               name="reason"
                                               placeholder="Reason (e.g. Injured)"
                                               style="font-size:.75rem; padding:.25rem .5rem; border:1px solid #e5e7eb; border-radius:4px; width:120px;"
                                               required />

                                        <input type="date"
                                               name="until"
                                               title="Available again on (optional)"
                                               style="font-size:.75rem; padding:.25rem .5rem; border:1px solid #e5e7eb; border-radius:4px; width:120px;" />

                                        <button type="submit" class="sq-btn mark-out">Unavailable</button>
                                    </form>
                                }
                                else
                                {
                                    <form action="@Url.Action("MarkAvailable", "CoachSquad", new { id = player.StatusId })" method="post" style="display:inline;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="sq-btn mark-in">Mark Available</button>
                                    </form>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        }

    </div>
</div>

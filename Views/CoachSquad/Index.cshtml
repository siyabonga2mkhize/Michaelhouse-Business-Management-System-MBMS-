@using Michaelhouse.Models.ViewModels
@model List<SportSquadViewModel>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "My Sports";

    int upcomingDays = ViewBag.UpcomingDays ?? 14;
    var sports = Model ?? new List<SportSquadViewModel>();
    int players = sports.Sum(s => s.Players.Count);
    int unavailable = sports.Sum(s => s.Players.Count(p => !p.IsAvailableToday));
}

@* --- FULL SCREEN VIEWPORT CONTAINER --- *@
<div class="flex flex-col h-full w-full overflow-hidden bg-gray-50/30">

    @* --- INSTITUTIONAL HEADER --- *@
    <div class="mb-6 d-flex justify-content-between align-items-end border-b border-gray-200 pb-6 flex-shrink-0 px-8 pt-8 bg-white shadow-sm relative z-10 flex-wrap gap-4">
        <div>
            <div class="flex items-center gap-2 mb-3">
                <div class="h-[2px] w-8 bg-[#C21E2E]"></div>
                <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Sport & Fixtures</h5>
            </div>
            <h2 class="text-5xl font-serif font-bold text-gray-900 tracking-tight mb-0">My Sports</h2>
            <p class="text-[11px] font-mono text-gray-500 uppercase tracking-widest mt-2 mb-0">
                Squads from students' profiles. Mark injured or absent players unavailable.
            </p>
        </div>
        <div class="flex flex-wrap gap-3">
            <a href="@Url.Action("Index", "Coach")" class="inline-flex items-center justify-center bg-white border border-gray-300 text-gray-700 px-6 py-3 text-[10px] font-bold uppercase tracking-[2px] hover:bg-gray-50 hover:border-gray-400 transition-all duration-300 shadow-sm text-decoration-none">
                <i class="bi bi-calendar-event me-2 text-sm"></i> My Fixtures
            </a>
            <a href="@Url.Action("Create", "Coach")" class="inline-flex items-center justify-center bg-[#1a1a1a] text-white px-8 py-3 text-[10px] font-bold uppercase tracking-[3px] hover:bg-black hover:shadow-[0_0_15px_rgba(0,0,0,0.3)] transition-all duration-300 text-decoration-none">
                <i class="bi bi-plus-lg me-2 text-sm align-middle"></i> Add Fixture
            </a>
        </div>
    </div>

    @* --- SCROLLABLE DATA SECTION --- *@
    <div class="flex-grow min-h-0 overflow-y-auto custom-scrollbar px-8 pb-16 pt-2 flex flex-col gap-8">

        @* --- SUMMARY TILES --- *@
        <div class="grid grid-cols-3 gap-3 sm:gap-4">
            <div class="bg-white border border-gray-200 p-3 sm:p-5 shadow-sm">
                <span class="block text-[8px] sm:text-[9px] uppercase tracking-[2px] sm:tracking-[3px] font-bold text-gray-400 mb-2">Sports</span>
                <span class="font-mono text-2xl sm:text-3xl font-bold text-gray-900">@sports.Count</span>
            </div>
            <div class="bg-white border border-gray-200 p-3 sm:p-5 shadow-sm">
                <span class="block text-[8px] sm:text-[9px] uppercase tracking-[2px] sm:tracking-[3px] font-bold text-gray-400 mb-2">Players</span>
                <span class="font-mono text-2xl sm:text-3xl font-bold text-gray-900">@players</span>
            </div>
            <div class="bg-white border border-gray-200 p-3 sm:p-5 shadow-sm">
                <span class="block text-[8px] sm:text-[9px] uppercase tracking-[2px] sm:tracking-[3px] font-bold text-gray-400 mb-2">Unavailable</span>
                <span class="font-mono text-2xl sm:text-3xl font-bold @(unavailable > 0 ? "text-[#C21E2E]" : "text-gray-900")">@unavailable</span>
            </div>
        </div>

        @* --- HOW THIS WORKS --- *@
        <div class="bg-blue-50/60 border-l-4 border-[#1a1a1a] p-5 shadow-sm">
            <span class="block text-[9px] uppercase tracking-[3px] font-bold text-gray-900 mb-2"><i class="bi bi-info-circle me-1"></i> How this works</span>
            <p class="font-serif text-sm text-gray-700 mb-0">
                Players come from the sports parents select on their children's profiles &mdash; you don't keep a list.
                An unavailable player (injury, leave, suspension) is left out of that sport's match and training meal
                recommendations until they're available again. They still get their normal meals.
            </p>
        </div>

        @if (!sports.Any())
        {
            <div class="bg-white border-2 border-gray-200 shadow-sm p-20 text-center">
                <i class="bi bi-people text-gray-200 text-6xl d-block mb-3"></i>
                <h4 class="font-serif font-bold text-gray-400 uppercase tracking-[3px] mb-2">No Squads Yet</h4>
                <span class="text-[10px] font-mono text-gray-400 uppercase tracking-widest">No students have a sport on their profile yet.</span>
            </div>
        }

        @foreach (var sport in sports)
        {
            <div class="bg-white border-2 border-gray-200 shadow-sm flex flex-col relative overflow-hidden">

                @* Sport Header *@
                <div class="p-5 border-b border-gray-200 bg-[#1a1a1a] flex justify-between items-center flex-wrap gap-2">
                    <div>
                        <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-white mb-0">
                            <i class="bi bi-trophy me-2 text-gray-400"></i> @sport.Sport
                        </h5>
                        <span class="text-[8px] font-mono text-gray-400 uppercase tracking-widest mt-1 block">@sport.Players.Count player@(sport.Players.Count == 1 ? "" : "s") on profile</span>
                    </div>
                    <span class="text-[9px] font-mono font-bold uppercase tracking-widest text-white border border-gray-600 px-3 py-1">
                        @sport.AvailableCount / @sport.Players.Count available today
                    </span>
                </div>

                @* Upcoming fixtures *@
                <div class="p-5 bg-gray-50 border-b border-gray-200">
                    <span class="block text-[9px] uppercase tracking-[3px] font-bold text-gray-500 mb-3">Upcoming &middot; next @upcomingDays days</span>
                    @if (!sport.Upcoming.Any())
                    {
                        <span class="text-[10px] font-mono uppercase tracking-widest text-gray-400">
                            Nothing scheduled &middot;
                            <a href="@Url.Action("Create", "Coach")" class="text-[#C21E2E] font-bold hover:underline">Add a training or match</a>
                        </span>
                    }
                    else
                    {
                        <div class="flex flex-col gap-2">
                            @foreach (var f in sport.Upcoming)
                            {
                                bool isMatch = f.EventType == "Match";
                                <div class="flex flex-wrap items-center gap-3 bg-white border border-gray-200 px-4 py-2">
                                    <span class="inline-flex items-center text-[8px] font-bold uppercase tracking-widest px-2 py-1 @(isMatch ? "bg-[#C21E2E] text-white" : "bg-gray-100 text-gray-700 border border-gray-200")">@f.EventType</span>
                                    <span class="font-serif font-bold text-sm text-gray-900">@f.Date.ToString("ddd, dd MMM")</span>
                                    <span class="font-mono text-xs text-gray-500">@f.StartTime.ToString(@"hh\:mm")&ndash;@f.EndTime.ToString(@"hh\:mm")</span>
                                    <span class="font-serif text-sm text-gray-700">@f.Label</span>
                                    <span class="text-[9px] font-mono uppercase tracking-widest text-gray-400">
                                        @f.Players player@(f.Players == 1 ? "" : "s")@(f.House != null ? " · " + f.House : "")
                                    </span>
                                    <a href="@Url.Action("Edit", "Coach", new { id = f.Id })" class="ms-auto text-[9px] font-bold uppercase tracking-[2px] text-gray-700 hover:text-[#C21E2E] text-decoration-none">
                                        <i class="bi bi-pencil me-1"></i> Edit
                                    </a>
                                </div>
                            }
                        </div>
                    }
                </div>

                @* Squad *@
                @if (!sport.Players.Any())
                {
                    <div class="p-12 text-center text-[10px] font-mono uppercase tracking-widest text-gray-400">
                        No students have @sport.Sport on their profile.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle mb-0 w-full whitespace-nowrap">
                            <thead class="bg-gray-50/90">
                                <tr class="text-[9px] uppercase tracking-[4px] font-bold text-gray-500 border-b-2 border-gray-200">
                                    <th class="ps-6 py-3">Player</th>
                                    <th class="border-l border-gray-100 ps-4">Grade / House</th>
                                    <th class="border-l border-gray-100 ps-4 text-center">Status</th>
                                    <th class="border-l border-gray-100 ps-4">Reason</th>
                                    <th class="pe-6 border-l border-gray-100 text-end">Action</th>
                                </tr>
                            </thead>
                            <tbody class="text-gray-700">
                                @foreach (var player in sport.Players)
                                {
                                    <tr class="hover:bg-gray-50/80 transition-colors border-b border-gray-50 last:border-0 h-16">
                                        <td class="ps-6 py-3">
                                            <span class="font-serif font-bold text-gray-900 block">@player.Name</span>
                                            <span class="font-mono text-[10px] text-gray-400 uppercase tracking-widest">@player.StudentNumber</span>
                                        </td>
                                        <td class="border-l border-gray-50 ps-4">
                                            <span class="font-mono text-xs text-gray-900 block">@(player.Grade ?? "—")</span>
                                            <span class="font-mono text-[10px] text-gray-400 uppercase tracking-widest">@(player.House ?? "No house")</span>
                                        </td>
                                        <td class="border-l border-gray-50 ps-4 text-center">
                                            @if (player.IsAvailableToday)
                                            {
                                                <span class="inline-flex items-center text-[8px] font-bold uppercase tracking-widest bg-emerald-50 text-emerald-700 border border-emerald-200 px-2 py-1">Available</span>
                                            }
                                            else
                                            {
                                                <span class="inline-flex items-center text-[8px] font-bold uppercase tracking-widest bg-red-50 text-[#C21E2E] border border-red-200 px-2 py-1">Unavailable</span>
                                            }
                                        </td>
                                        <td class="border-l border-gray-50 ps-4 font-serif text-sm italic text-gray-500">
                                            @if (!player.IsAvailableToday && !string.IsNullOrEmpty(player.StatusReason))
                                            {
                                                @player.StatusReason
                                                if (player.UnavailableUntil.HasValue)
                                                {
                                                    <span class="block not-italic font-mono text-[10px] uppercase tracking-widest text-gray-400">Until @player.UnavailableUntil.Value.ToString("dd MMM")</span>
                                                }
                                            }
                                        </td>
                                        <td class="pe-6 border-l border-gray-50 text-end">
                                            @if (player.IsAvailableToday)
                                            {
                                                <form action="@Url.Action("MarkUnavailable", "CoachSquad")" method="post" class="inline-flex flex-wrap items-center justify-end gap-2 m-0">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@player.StatusId" />
                                                    <input type="text" name="reason" placeholder="Reason (e.g. Injured)" maxlength="200" required
                                                           class="w-36 border-b-2 border-gray-200 py-1.5 outline-none focus:border-[#C21E2E] font-serif text-xs text-gray-900 bg-transparent" />
                                                    <input type="date" name="until" title="Available again on (optional)"
                                                           class="w-36 border-b-2 border-gray-200 py-1.5 outline-none focus:border-[#C21E2E] font-mono text-xs text-gray-900 bg-transparent" />
                                                    <button type="submit" class="inline-flex items-center justify-center bg-white border border-[#C21E2E] text-[#C21E2E] px-4 py-2 text-[9px] font-bold uppercase tracking-[2px] hover:bg-red-50 transition-colors">
                                                        Unavailable
                                                    </button>
                                                </form>
                                            }
                                            else
                                            {
                                                <form action="@Url.Action("MarkAvailable", "CoachSquad", new { id = player.StatusId })" method="post" class="inline m-0">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="inline-flex items-center justify-center bg-white border border-emerald-500 text-emerald-700 px-4 py-2 text-[9px] font-bold uppercase tracking-[2px] hover:bg-emerald-50 transition-colors">
                                                        <i class="bi bi-check2 me-1.5"></i> Mark Available
                                                    </button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }

    </div>
</div>

<style>
    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }

    .font-mono {
        font-family: 'Source Code Pro', monospace !important;
    }

    .table thead th {
        border-bottom: 2px solid #e5e7eb !important;
        vertical-align: middle;
        padding-top: .9rem;
        padding-bottom: .9rem;
    }

    .custom-scrollbar::-webkit-scrollbar {
        width: 5px;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #d1d5db;
        border-radius: 10px;
    }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #C21E2E;
        }
</style>

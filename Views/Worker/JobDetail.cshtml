@model Michaelhouse.Models.JobCard
@{
    ViewBag.Title = "Job Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="mb-10 d-flex justify-content-between align-items-end border-b border-gray-100 pb-8">
    <div>
        <div class="flex items-center gap-2 mb-3">
            <div class="h-1 w-8 bg-[#C21E2E]"></div>
            <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Worker Portal</h5>
        </div>
        <h2 class="text-4xl font-serif font-bold text-gray-900 tracking-tight">@Model.Title</h2>
        <p class="text-gray-400 text-[10px] uppercase tracking-widest font-bold mt-2">
            <code class="text-danger">@Model.JobReference</code> · @Model.Priority Priority
        </p>
    </div>
    @if (Model.Status != "Completed" && Model.Status != "Cancelled")
    {
        <a href="#completeSection" class="btn btn-success"><i class="bi bi-check-circle me-1"></i> Complete This Job</a>
    }
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0">
                <h5 class="mb-0 fw-bold"><i class="bi bi-info-circle me-2"></i>Job Information</h5>
            </div>
            <div class="card-body">
                <ul class="list-unstyled">
                    <li class="d-flex justify-content-between border-bottom py-2"><span class="text-muted">Priority</span><span class="badge bg-@(Model.Priority=="Emergency"?"danger":Model.Priority=="High"?"warning":Model.Priority=="Medium"?"info":"secondary")">@Model.Priority</span></li>
                    <li class="d-flex justify-content-between border-bottom py-2"><span class="text-muted">Asset</span>@(Model.Asset != null ? Model.Asset.AssetName : "—")</li>
                    <li class="d-flex justify-content-between border-bottom py-2"><span class="text-muted">Location</span>@(Model.Asset != null ? Model.Asset.LocationBuilding : "—")</li>
                    <li class="d-flex justify-content-between border-bottom py-2"><span class="text-muted">Status</span><span class="badge bg-@(Model.Status=="Completed"?"success":Model.Status=="Assigned"?"info":"warning")">@Model.Status</span></li>
                    @if (Model.DueDate.HasValue)
                    {
                        var overdue = Model.DueDate.Value < DateTime.Now && Model.Status != "Completed";
                        <li class="d-flex justify-content-between border-bottom py-2">
                            <span class="text-muted">Due Date</span>
                            <span class="@(overdue ? "text-danger fw-bold" : "")">
                                @Model.DueDate.Value.ToString("dd MMM yyyy HH:mm") @if (overdue)
                                {<text>⚠️ OVERDUE</text>}
                            </span>
                        </li>
                    }
                    <li class="d-flex justify-content-between py-2"><span class="text-muted">Time Open</span><span id="timeOpen" class="fw-bold text-danger">—</span></li>
                </ul>
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <div class="alert alert-secondary mt-3"><i class="bi bi-quote me-1"></i> @Model.Description</div>
                }
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Model.PhotoBefore))
        {
            <div class="card border-0 shadow-sm mt-3">
                <div class="card-header bg-white border-0">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-camera me-2"></i>Fault Photo</h5>
                </div>
                <div class="card-body p-0">
                    <div class="bg-light p-2 small text-muted text-uppercase fw-bold">Before — Fault Evidence</div>
                    <img src="~/Content/JobPhotos/@Model.PhotoBefore" class="img-fluid" />
                </div>
            </div>
        }
    </div>

    <div class="col-lg-7">
        @if (Model.Status != "Completed" && Model.Status != "Cancelled")
        {
            <div class="card border-0 shadow-sm" id="completeSection">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-clipboard-check me-2"></i>Complete This Job</h5>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("CompleteJob", "Worker", new { id = Model.Id }, FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <!-- After Photo -->
                            <div class="col-12">
                                <label class="form-label small fw-bold text-uppercase text-muted">After Photo (Proof) *</label>
                                <div class="border p-3 text-center" style="cursor:pointer; background:#f8f9fa;" onclick="document.getElementById('photoInput').click();">
                                    <input type="file" name="photoAfter" id="photoInput" accept="image/*" style="display:none" onchange="previewPhoto(this)" />
                                    <div id="uploadPlaceholder">
                                        <i class="bi bi-camera fs-2 d-block mb-2 text-secondary"></i>
                                        <span class="text-muted">Click to upload a photo</span>
                                    </div>
                                    <img id="photoPreview" src="#" alt="Preview" style="display:none;max-width:100%;border-radius:8px;margin-top:10px;" />
                                </div>
                            </div>

                            <!-- Parts Used Container -->
                            <div class="col-12">
                                <label class="form-label small fw-bold text-uppercase text-muted">Parts Used</label>
                                <div id="partsContainer">
                                    <p class="text-muted" id="noPartsMessage">No parts added yet. Click "Add Part" below.</p>
                                </div>
                                <div class="mt-2 d-flex gap-2 flex-wrap">
                                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="addPartRow()">
                                        <i class="bi bi-plus-circle me-1"></i> Add Inventory Part
                                    </button>
                                    <button type="button" class="btn btn-sm btn-outline-info" onclick="addManualPartRow()">
                                        <i class="bi bi-pencil me-1"></i> Add Custom Part
                                    </button>
                                </div>
                                <small class="text-muted">Select inventory part, or add custom parts manually.</small>
                            </div>

                            <!-- Labour Cost -->
                            <div class="col-12">
                                <label class="form-label small fw-bold text-uppercase text-muted">Labour Cost (R)</label>
                                <input type="number" name="labourCost" id="labourCost" value="0" min="0" step="0.01" class="form-control" />
                            </div>

                            <!-- Cost Summary -->
                            <div class="col-12">
                                <div class="bg-light p-3 rounded">
                                    <div class="d-flex justify-content-between">
                                        <span class="fw-bold">Parts Cost:</span>
                                        <span id="partsCostDisplay">R0.00</span>
                                    </div>
                                    <div class="d-flex justify-content-between">
                                        <span class="fw-bold">Labour Cost:</span>
                                        <span id="labourCostDisplay">R0.00</span>
                                    </div>
                                    <div class="d-flex justify-content-between border-top pt-2 mt-2">
                                        <span class="fw-bold text-success">Total Cost:</span>
                                        <span id="totalCostDisplay" class="fw-bold text-success">R0.00</span>
                                    </div>
                                    <input type="hidden" id="totalPartsCost" name="partsCost" value="0" />
                                    <input type="hidden" id="totalCost" name="totalCost" value="0" />
                                </div>
                            </div>

                            <!-- Receipt Upload -->
                            <div class="col-12">
                                <label class="form-label small fw-bold text-uppercase text-muted">Receipt (optional)</label>
                                <div class="border p-3 text-center" style="cursor:pointer; background:#f8f9fa;" onclick="document.getElementById('receiptInput').click();">
                                    <input type="file" name="receipt" id="receiptInput" accept="image/*,application/pdf" style="display:none" onchange="previewReceipt(this)" />
                                    <div id="receiptPlaceholder">
                                        <i class="bi bi-receipt fs-2 d-block mb-2 text-secondary"></i>
                                        <span class="text-muted">Click to attach a receipt (image or PDF)</span>
                                    </div>
                                    <div id="receiptPreview" style="display:none; margin-top:10px;">
                                        <span id="receiptFileName"></span>
                                        <button type="button" class="btn btn-sm btn-outline-danger ms-2" onclick="clearReceipt()">Remove</button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-success mt-3">
                            <i class="bi bi-info-circle me-2"></i> Completing will: update asset health, adjust inventory, and set your status to Available.
                        </div>
                        <button type="submit" class="btn btn-success w-100"><i class="bi bi-check-circle me-1"></i> Mark Job as Complete</button>
                    }
                </div>
            </div>
        }
        else
        {
            <!-- Completed Job View -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-check-circle me-2"></i>Job Completed</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-4 text-center"><span class="text-muted small">Completed On</span><br />@(Model.DateCompleted.HasValue ? Model.DateCompleted.Value.ToString("dd MMM HH:mm") : "—")</div>
                        <div class="col-4 text-center"><span class="text-muted small">Condition</span><br /><span class="badge bg-secondary">@Model.FinalCondition</span></div>
                        <div class="col-4 text-center"><span class="text-muted small">Response Time</span><br /><span class="fw-bold text-success">@(Model.ResponseTimeMinutes.HasValue ? Model.ResponseTimeMinutes + " mins" : "—")</span></div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.CompletionNotes))
                    {
                        <div class="alert alert-success mt-3"><i class="bi bi-quote me-1"></i> @Model.CompletionNotes</div>
                    }
                    @if (!string.IsNullOrEmpty(Model.PhotoAfter))
                    {
                        <div class="mt-3">
                            <div class="bg-light p-2 small text-muted text-uppercase fw-bold">After — Repair Complete</div>
                            <img src="~/Content/JobPhotos/@Model.PhotoAfter" class="img-fluid" />
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function previewPhoto(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('photoPreview').src = e.target.result;
                    document.getElementById('photoPreview').style.display = 'block';
                    document.getElementById('uploadPlaceholder').style.display = 'none';
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        var created = new Date('@Model.DateCreated.ToString("yyyy-MM-ddTHH:mm:ss")');
        function updateTime() {
            var diff = Math.floor((new Date() - created) / 60000);
            var hours = Math.floor(diff / 60);
            var mins = diff % 60;
            document.getElementById('timeOpen').textContent = hours > 0 ? hours + 'h ' + mins + 'm' : mins + ' mins';
        }
        updateTime();
        setInterval(updateTime, 30000);

        // ─── Inventory Data ──────────────────────────────────────────
        var inventoryItems = @Html.Raw(Json.Encode(ViewBag.Inventory));

        // ─── Add Inventory Part Row ─────────────────────────────────
        function addPartRow() {
            var container = document.getElementById('partsContainer');
            var noMsg = document.getElementById('noPartsMessage');
            if (noMsg) noMsg.style.display = 'none';

            var row = document.createElement('div');
            row.className = 'part-row d-flex align-items-center gap-2 mb-2';
            row.innerHTML = `
                <select name="inventoryIds" class="form-select form-select-sm part-select" style="flex:1;">
                    <option value="">-- Select Part --</option>
                    ${inventoryItems.map(item => `<option value="${item.Id}" data-unitcost="${item.UnitCost}">${item.ItemName} (${item.StockLevel} ${item.Unit} · R${item.UnitCost.toFixed(2)} each)</option>`).join('')}
                </select>
                <input type="number" name="quantities" value="1" min="1" max="999" class="form-control form-control-sm qty-input" style="width:70px;" />
                <button type="button" class="btn btn-sm btn-outline-danger" onclick="removePartRow(this)"><i class="bi bi-x-lg"></i></button>
            `;
            container.appendChild(row);

            var select = row.querySelector('.part-select');
            var qtyInput = row.querySelector('.qty-input');
            select.addEventListener('change', calculateCost);
            qtyInput.addEventListener('input', calculateCost);
            calculateCost();
        }

        // ─── Add Custom (Manual) Part Row ──────────────────────────
        function addManualPartRow() {
            var container = document.getElementById('partsContainer');
            var noMsg = document.getElementById('noPartsMessage');
            if (noMsg) noMsg.style.display = 'none';

            var row = document.createElement('div');
            row.className = 'part-row d-flex align-items-center gap-2 mb-2';
            row.innerHTML = `
                <input type="text" name="manualPartNames" placeholder="Part name" class="form-control form-control-sm" style="flex:2;" />
                <input type="number" name="manualPartPrices" placeholder="Price" min="0" step="0.01" class="form-control form-control-sm" style="width:100px;" />
                <input type="number" name="manualQuantities" value="1" min="1" class="form-control form-control-sm qty-input" style="width:70px;" />
                <button type="button" class="btn btn-sm btn-outline-danger" onclick="removePartRow(this)"><i class="bi bi-x-lg"></i></button>
            `;
            container.appendChild(row);

            row.querySelector('.qty-input').addEventListener('input', calculateCost);
            row.querySelector('input[name="manualPartPrices"]').addEventListener('input', calculateCost);
            calculateCost();
        }

        // ─── Remove Part Row ─────────────────────────────────────────
        function removePartRow(btn) {
            var row = btn.closest('.part-row');
            row.remove();
            calculateCost();
            var container = document.getElementById('partsContainer');
            if (container.children.length === 0) {
                var noMsg = document.getElementById('noPartsMessage');
                if (noMsg) noMsg.style.display = 'block';
            }
        }

        // ─── Calculate Total Cost ──────────────────────────────────
        function calculateCost() {
            let partsCost = 0;
            var rows = document.querySelectorAll('.part-row');
            rows.forEach(function (row) {
                // Internal part (dropdown)
                var select = row.querySelector('.part-select');
                if (select && select.value) {
                    var unitCost = parseFloat(select.options[select.selectedIndex].dataset.unitcost) || 0;
                    var qty = parseFloat(row.querySelector('.qty-input').value) || 0;
                    partsCost += qty * unitCost;
                }
                // Manual part (price input)
                var manualPrice = row.querySelector('input[name="manualPartPrices"]');
                if (manualPrice) {
                    var unitCost = parseFloat(manualPrice.value) || 0;
                    var qty = parseFloat(row.querySelector('.qty-input').value) || 0;
                    partsCost += qty * unitCost;
                }
            });

            var labourCost = parseFloat(document.getElementById('labourCost').value) || 0;
            var total = partsCost + labourCost;

            document.getElementById('partsCostDisplay').textContent = 'R' + partsCost.toFixed(2);
            document.getElementById('labourCostDisplay').textContent = 'R' + labourCost.toFixed(2);
            document.getElementById('totalCostDisplay').textContent = 'R' + total.toFixed(2);
            document.getElementById('totalPartsCost').value = partsCost.toFixed(2);
            document.getElementById('totalCost').value = total.toFixed(2);
        }

        // ─── Receipt Preview ────────────────────────────────────────
        function previewReceipt(input) {
            if (input.files && input.files[0]) {
                var file = input.files[0];
                document.getElementById('receiptFileName').textContent = file.name;
                document.getElementById('receiptPlaceholder').style.display = 'none';
                document.getElementById('receiptPreview').style.display = 'block';
            }
        }

        function clearReceipt() {
            document.getElementById('receiptInput').value = '';
            document.getElementById('receiptPlaceholder').style.display = 'block';
            document.getElementById('receiptPreview').style.display = 'none';
        }

        // ─── Attach Events ──────────────────────────────────────────
        document.addEventListener('DOMContentLoaded', function () {
            document.getElementById('labourCost').addEventListener('input', calculateCost);
            calculateCost(); // initial
        });
    </script>
}

@section Styles {
    <style>
        .font-serif {
            font-family: 'Playfair Display', serif !important;
        }
    </style>
}
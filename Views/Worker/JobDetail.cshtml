@model Michaelhouse.Models.JobCard
@{
    ViewBag.Title = "Job Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="mb-10 d-flex justify-content-between align-items-end border-b border-gray-100 pb-8">
    <div>
        <div class="flex items-center gap-2 mb-3">
            <div class="h-1 w-8 bg-[#C21E2E]"></div>
            <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Worker Portal</h5>
        </div>
        <h2 class="text-4xl font-serif font-bold text-gray-900 tracking-tight">@Model.Title</h2>
        <p class="text-gray-400 text-[10px] uppercase tracking-widest font-bold mt-2">
            <code class="text-danger">@Model.JobReference</code> · @Model.Priority Priority
        </p>
    </div>
    @if (Model.Status != "Completed" && Model.Status != "Cancelled")
    {
        <a href="#completeSection" class="btn btn-success"><i class="bi bi-check-circle me-1"></i> Complete This Job</a>
    }
</div>

<div class="row g-4">
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0">
                <h5 class="mb-0 fw-bold"><i class="bi bi-info-circle me-2"></i>Job Information</h5>
            </div>
            <div class="card-body">
                <ul class="list-unstyled">
                    <li class="d-flex justify-content-between border-bottom py-2"><span class="text-muted">Priority</span><span class="badge bg-@(Model.Priority=="Emergency"?"danger":Model.Priority=="High"?"warning":Model.Priority=="Medium"?"info":"secondary")">@Model.Priority</span></li>
                    <li class="d-flex justify-content-between border-bottom py-2"><span class="text-muted">Asset</span>@(Model.Asset != null ? Model.Asset.AssetName : "—")</li>
                    <li class="d-flex justify-content-between border-bottom py-2"><span class="text-muted">Location</span>@(Model.Asset != null ? Model.Asset.LocationBuilding : "—")</li>
                    <li class="d-flex justify-content-between border-bottom py-2"><span class="text-muted">Status</span><span class="badge bg-@(Model.Status=="Completed"?"success":Model.Status=="Assigned"?"info":"warning")">@Model.Status</span></li>
                    @if (Model.DueDate.HasValue)
                    {
                        var overdue = Model.DueDate.Value < DateTime.Now && Model.Status != "Completed";
                        <li class="d-flex justify-content-between border-bottom py-2"><span class="text-muted">Due Date</span><span class="@(overdue ? "text-danger fw-bold" : "")">@Model.DueDate.Value.ToString("dd MMM yyyy HH:mm") @if (overdue)
                        {<text>⚠️ OVERDUE</text>}</span></li>
                    }
                    <li class="d-flex justify-content-between py-2"><span class="text-muted">Time Open</span><span id="timeOpen" class="fw-bold text-danger">—</span></li>
                </ul>
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <div class="alert alert-secondary mt-3"><i class="bi bi-quote me-1"></i> @Model.Description</div>
                }
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Model.PhotoBefore))
        {
            <div class="card border-0 shadow-sm mt-3">
                <div class="card-header bg-white border-0">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-camera me-2"></i>Fault Photo</h5>
                </div>
                <div class="card-body p-0">
                    <div class="bg-light p-2 small text-muted text-uppercase fw-bold">Before — Fault Evidence</div>
                    <img src="~/Content/JobPhotos/@Model.PhotoBefore" class="img-fluid" />
                </div>
            </div>
        }
    </div>
    <div class="col-lg-7">
        @if (Model.Status != "Completed" && Model.Status != "Cancelled")
        {
            <div class="card border-0 shadow-sm" id="completeSection">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-clipboard-check me-2"></i>Complete This Job</h5>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm("CompleteJob", "Worker", new { id = Model.Id }, FormMethod.Post, new { enctype = "multipart/form-data" }))
                    {
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-12">
                                <label class="form-label small fw-bold text-uppercase text-muted">After Photo (Proof) *</label>
                                <div class="border p-3 text-center" style="cursor:pointer; background:#f8f9fa;" onclick="document.getElementById('photoInput').click();">
                                    <input type="file" name="photoAfter" id="photoInput" accept="image/*" style="display:none" onchange="previewPhoto(this)" />
                                    <div id="uploadPlaceholder">
                                        <i class="bi bi-camera fs-2 d-block mb-2 text-secondary"></i>
                                        <span class="text-muted">Click to upload a photo</span>
                                    </div>
                                    <img id="photoPreview" src="#" alt="Preview" style="display:none;max-width:100%;border-radius:8px;margin-top:10px;" />
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-bold text-uppercase text-muted">Parts Used</label>
                                @if (ViewBag.Inventory != null && ((List<Michaelhouse.Models.MaintenanceInventory>)ViewBag.Inventory).Any())
                                {
                                    <div class="border p-2" style="max-height:200px;overflow-y:auto;">
                                        @foreach (var item in (List<Michaelhouse.Models.MaintenanceInventory>)ViewBag.Inventory)
                                        {
                                            <div class="d-flex align-items-center justify-content-between border-bottom py-1">
                                                <span class="small">@item.ItemName <span class="text-muted">(@item.StockLevel @item.Unit in stock)</span></span>
                                                <input type="number" name="quantities" value="0" min="0" max="@item.StockLevel" class="form-control form-control-sm" style="width:70px;" />
                                                <input type="hidden" name="inventoryIds" value="@item.Id" />
                                            </div>
                                        }
                                    </div>
                                    <small class="text-muted">Enter 0 if not used.</small>
                                }
                                else
                                {
                                    <p class="text-muted">No inventory items available.</p>
                                }
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-bold text-uppercase text-muted">Completion Notes *</label>
                                <textarea name="completionNotes" class="form-control" rows="3" placeholder="Describe exactly what you did..." required></textarea>
                            </div>
                            <div class="col-12">
                                <label class="form-label small fw-bold text-uppercase text-muted">Final Condition *</label>
                                <div class="row g-2">
                                    @foreach (var opt in new[] {
                                        ("Fixed", "Fully repaired and working", "success"),
                                        ("Repaired Temporarily", "Short fix — needs permanent repair", "warning"),
                                        ("Needs Further Work", "Bigger problem — more help needed", "danger"),
                                        ("Replaced", "Old part replaced with new one", "info")
                                    })
                                    {
                                        <div class="col-md-6">
                                            <div class="border rounded p-2" style="background:#f8f9fa;">
                                                <label class="d-block">
                                                    <input type="radio" name="finalCondition" value="@opt.Item1" required />
                                                    <strong class="text-@opt.Item3">@opt.Item1</strong>
                                                    <span class="text-muted small d-block ms-3">@opt.Item2</span>
                                                </label>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="alert alert-success mt-3">
                            <i class="bi bi-info-circle me-2"></i> Completing will: update asset health, adjust inventory, and set your status to Available.
                        </div>
                        <button type="submit" class="btn btn-success w-100"><i class="bi bi-check-circle me-1"></i> Mark Job as Complete</button>
                    }
                </div>
            </div>
        }
        else
        {
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-check-circle me-2"></i>Job Completed</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-4 text-center"><span class="text-muted small">Completed On</span><br />@(Model.DateCompleted.HasValue ? Model.DateCompleted.Value.ToString("dd MMM HH:mm") : "—")</div>
                        <div class="col-4 text-center"><span class="text-muted small">Condition</span><br /><span class="badge bg-secondary">@Model.FinalCondition</span></div>
                        <div class="col-4 text-center"><span class="text-muted small">Response Time</span><br /><span class="fw-bold text-success">@(Model.ResponseTimeMinutes.HasValue ? Model.ResponseTimeMinutes + " mins" : "—")</span></div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.CompletionNotes))
                    {
                        <div class="alert alert-success mt-3"><i class="bi bi-quote me-1"></i> @Model.CompletionNotes</div>
                    }
                    @if (!string.IsNullOrEmpty(Model.PhotoAfter))
                    {
                        <div class="mt-3">
                            <div class="bg-light p-2 small text-muted text-uppercase fw-bold">After — Repair Complete</div>
                            <img src="~/Content/JobPhotos/@Model.PhotoAfter" class="img-fluid" />
                        </div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function previewPhoto(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('photoPreview').src = e.target.result;
                    document.getElementById('photoPreview').style.display = 'block';
                    document.getElementById('uploadPlaceholder').style.display = 'none';
                };
                reader.readAsDataURL(input.files[0]);
            }
        }
        var created = new Date('@Model.DateCreated.ToString("yyyy-MM-ddTHH:mm:ss")');
        function updateTime() {
            var diff = Math.floor((new Date() - created) / 60000);
            var hours = Math.floor(diff / 60);
            var mins = diff % 60;
            document.getElementById('timeOpen').textContent = hours > 0 ? hours + 'h ' + mins + 'm' : mins + ' mins';
        }
        updateTime();
        setInterval(updateTime, 30000);
    </script>
}
@section Styles {
    <style>
        .font-serif {
            font-family: 'Playfair Display', serif !important;
        }
    </style>
}
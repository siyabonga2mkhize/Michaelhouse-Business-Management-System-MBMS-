@model Michaelhouse.Models.TrackOrderViewModel
@{
    ViewBag.Title = "Track Order";
}

<div class="page-header">
    <h3 class="mb-0"><i class="bi bi-search me-2 text-primary"></i>Track Your Order</h3>
    <small class="text-muted">Enter your order number to check status</small>
</div>

<div class="card">
    <div class="card-body">
        @using (Html.BeginForm())
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(true, "", new { @class = "text-danger mb-3" })

            <div class="row g-3">
                <div class="col-md-8">
                    @Html.LabelFor(m => m.OrderNumber, new { @class = "form-label fw-semibold" })
                    @Html.TextBoxFor(m => m.OrderNumber, new { @class = "form-control", placeholder = "e.g. SS-20250405123456-1234" })
                    @Html.ValidationMessageFor(m => m.OrderNumber, "", new { @class = "text-danger small" })
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Track Order
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<div class="mt-4 text-muted small">
    <i class="bi bi-info-circle me-1"></i> Order number was sent to your email after purchase.
</div>
@using Michaelhouse.Models
@model Michaelhouse.Models.ViewModels.CheckoutViewModel
@{
    ViewBag.Title = "Checkout";
    var cart = ViewBag.Cart as Michaelhouse.Models.CartDto;
}

<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h3 class="mb-0"><i class="bi bi-bag-check me-2 text-primary"></i>Checkout</h3>
        <small class="text-muted">Complete your purchase by providing your details</small>
    </div>
    <a href="@Url.Action("Index", "Cart")" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left me-1"></i> Back to Cart
    </a>
</div>

@if (cart == null || cart.IsEmpty)
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-cart-x display-1 text-muted"></i>
            <h4 class="mt-3 text-muted">Your cart is empty</h4>
            <p class="text-muted mb-4">Please add items before checking out</p>
            <a href="@Url.Action("Index", "Store")" class="btn btn-primary">
                <i class="bi bi-shop me-2"></i>Start Shopping
            </a>
        </div>
    </div>
}
else
{
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card">
                <div class="card-header">
                    <span><i class="bi bi-person me-2"></i>Customer Details</span>
                </div>
                <div class="card-body">
                    <form method="post" action="@Url.Action("PlaceOrder", "Order")">
                        @Html.AntiForgeryToken()

                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger">
                                @Html.ValidationSummary(true, "Please correct the following errors:")
                            </div>
                        }

                        <div class="mb-3">
                            <label for="CustomerName" class="form-label fw-semibold">Full Name</label>
                            <input type="text" name="CustomerName" id="CustomerName" class="form-control"
                                   value="@Model.CustomerName" placeholder="Enter your full name" />
                            @Html.ValidationMessage("CustomerName", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-3">
                            <label for="CustomerEmail" class="form-label fw-semibold">Email Address</label>
                            <input type="email" name="CustomerEmail" id="CustomerEmail" class="form-control"
                                   value="@Model.CustomerEmail" placeholder="you@example.com" />
                            @Html.ValidationMessage("CustomerEmail", new { @class = "text-danger small" })
                        </div>

                        <div class="mb-3">
                            <label for="Notes" class="form-label fw-semibold">Notes (Optional)</label>
                            <textarea name="Notes" id="Notes" class="form-control" rows="4"
                                      placeholder="Any special instructions or delivery notes...">@Model.Notes</textarea>
                        </div>

                        <button type="submit" class="btn btn-success w-100">
                            <i class="bi bi-check-circle me-2"></i>Place Order
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card">
                <div class="card-header">
                    <span><i class="bi bi-receipt me-2"></i>Order Summary</span>
                </div>
                <div class="card-body">
                    @foreach (var item in cart.Items)
                    {
                        <div class="d-flex justify-content-between mb-3">
                            <div>
                                <span class="fw-semibold">@item.ProductName</span>
                                <br />
                                <small class="text-muted">@item.Quantity x R @item.UnitPrice.ToString("N2")</small>
                            </div>
                            <span class="fw-bold">R @item.Subtotal.ToString("N2")</span>
                        </div>
                    }
                    <hr />
                    <div class="d-flex justify-content-between mb-3">
                        <span class="fw-bold fs-5">Total</span>
                        <span class="fw-bold fs-4 text-primary">R @cart.TotalAmount.ToString("N2")</span>
                    </div>
                    <div class="alert alert-secondary small mb-0">
                        <i class="bi bi-info-circle me-1"></i>
                        By placing your order, you agree to our terms and conditions
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.19.5/jquery.validate.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validation-unobtrusive/3.2.12/jquery.validate.unobtrusive.min.js"></script>
    <script>
        console.log('Checkout page loaded');
    </script>
}
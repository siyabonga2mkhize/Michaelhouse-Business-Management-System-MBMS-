@model List<Michaelhouse.Models.TimetableSlot>
@using Michaelhouse.Models.Enums
@using Michaelhouse.Services
@{
    ViewBag.Title = "Student Timetable";

    // FIX: Safely cast to Student model
    var student = ViewBag.Student as Michaelhouse.Models.Student;
    var periods = ViewBag.Periods as List<Michaelhouse.Models.Period>;

    int grade = (int)(ViewBag.Grade ?? 0);
    int academicYear = (int)(ViewBag.AcademicYear ?? DateTime.Now.Year);
    AcademicStream stream = (AcademicStream)(ViewBag.Stream ?? AcademicStream.None);

    var days = new[] {
        new { Num = 1, Name = "Monday" },
        new { Num = 2, Name = "Tuesday" },
        new { Num = 3, Name = "Wednesday" },
        new { Num = 4, Name = "Thursday" },
        new { Num = 5, Name = "Friday" }
    };
}

<link rel="stylesheet" href="~/Content/academic.css" />

<div class="ac-page" style="background: #fbfbfb;">

    @* --- CENTERED INSTITUTIONAL HEADER --- *@
    <div class="text-center py-12 mb-8 relative overflow-hidden border-b-2 border-gray-900 bg-white">
        <div class="absolute inset-0 opacity-[0.03] pointer-events-none"
             style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 24px 24px;"></div>

        <img src="~/Content/logo.svg.png" class="mb-4" style="height: 80px;" alt="Michaelhouse Crest" />
        <h1 class="text-4xl font-serif font-bold text-gray-900 tracking-tight uppercase">Academic Timetable</h1>

        <p class="text-[10px] uppercase tracking-[4px] font-bold text-[#C21E2E] mt-2">
            @if (student != null)
            {
                var fName = student.FirstName ?? "Record";
                var lName = student.LastName ?? "Pending";
                @($"{fName} {lName} • Grade {grade} • {academicYear} Session")
            }
            else
            {
                @:Institutional Archive Identity Pending
            }
        </p>
    </div>

    @* --- SUB-INFO DOSSIER BAR --- *@
    <div class="row g-0 border border-gray-900 mb-10 bg-white d-print-none shadow-sm">
        <div class="col-md-4 p-5 border-r border-gray-100 text-left">
            <div class="text-[9px] font-bold text-gray-400 uppercase tracking-widest mb-1">Assigned Stream</div>
            <div class="text-sm font-bold text-gray-900 uppercase">@RegistrationService.GetStreamName(stream)</div>
        </div>
        <div class="col-md-4 p-5 border-r border-gray-100 text-left">
            <div class="text-[9px] font-bold text-gray-400 uppercase tracking-widest mb-1">Status</div>
            <div class="flex items-center gap-2">
                <div class="h-2 w-2 rounded-full bg-green-500"></div>
                <div class="text-sm font-bold text-gray-900 uppercase">Active Enrollment</div>
            </div>
        </div>
        <div class="col-md-4 p-5 text-left">
            <div class="text-[9px] font-bold text-gray-400 uppercase tracking-widest mb-1">Academic Year</div>
            <div class="text-sm font-bold text-gray-900 uppercase">@academicYear Archive</div>
        </div>
    </div>

    @* --- THE ARCHITECTURAL GRID --- *@
    <div class="ac-card border-2 border-gray-900 bg-[#f4f4f4] p-1 shadow-2xl">
        <div class="table-responsive" style="overflow-x: hidden;">
            <table class="table table-bordered mb-0 border-gray-300" style="table-layout: fixed; width: 100%;">
                <thead>
                    <tr class="bg-gray-900 text-white">
                        <th class="py-4 text-center border-gray-800" style="width: 12%;">
                            <i class="bi bi-clock text-gray-500"></i>
                        </th>
                        @foreach (var day in days)
                        {
                            <th class="text-center py-4 border-gray-800 text-[9px] uppercase tracking-[4px] font-bold">@day.Name</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (periods != null && periods.Any())
                    {
                        foreach (var period in periods)
                        {
                            <tr style="height: 120px;">
                                <td class="bg-gray-800 text-white p-3 flex flex-col justify-center items-center border-gray-700">
                                    <div class="text-[10px] font-bold text-gray-400 uppercase">@period.Label</div>
                                    <div class="text-[9px] font-monospace mt-1 text-[#C21E2E]">@period.StartTime.ToString(@"hh\:mm")</div>
                                </td>
                                @foreach (var day in days)
                                {
                                    var slot = Model?.FirstOrDefault(ts => ts.DayOfWeek == day.Num && ts.PeriodId == period.PeriodId);

                                    <td class="p-1 relative align-middle @(period.IsBreak ? "bg-gray-200/50" : "bg-blueprint")">
                                        @if (period.IsBreak)
                                        {
                                            <div class="text-center text-[7px] font-bold uppercase tracking-[3px] text-gray-400 rotate-[-90deg] opacity-50">@period.Label</div>
                                        }
                                        else if (slot != null)
                                        {
                                            <div class="h-full w-full bg-white border-l-4 border-l-[#C21E2E] p-3 shadow-sm flex flex-col justify-between group hover:bg-black transition-all duration-300 text-left">
                                                <div>
                                                    <div class="text-[10px] font-bold text-gray-900 group-hover:text-white leading-tight uppercase tracking-tighter">
                                                        @(slot.Subject?.Name ?? "Institutional Module")
                                                    </div>
                                                    <div class="text-[8px] font-bold text-gray-400 group-hover:text-gray-500 uppercase tracking-widest mt-2">
                                                        @if (slot.Teacher != null)
                                                        {
                                                            @($"{slot.Teacher.FirstName} {slot.Teacher.LastName}")
                                                        }
                                                        else
                                                        {
                                                            @:Faculty Pending
                                                        }
                                                    </div>
                                                </div>
                                                <div class="flex justify-between items-end">
                                                    <span class="text-[7px] font-bold text-gray-300 uppercase">Michaelhouse</span>
                                                    <i class="bi @RegistrationService.GetStreamIcon(slot.Stream) text-[10px] opacity-20 group-hover:opacity-100 group-hover:text-[#C21E2E]"></i>
                                                </div>
                                            </div>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="py-20 text-center bg-white">
                                <p class="text-[10px] uppercase tracking-[3px] font-bold text-gray-400">Timetable configuration not found for the current cycle.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .bg-blueprint {
        background-color: #ffffff;
        background-image: linear-gradient(#f0f0f0 1.1px, transparent 1.1px), linear-gradient(90deg, #f0f0f0 1.1px, transparent 1.1px);
        background-size: 20px 20px;
    }

    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }

    .font-monospace {
        font-family: 'Source Code Pro', monospace;
    }

    .table-bordered > :not(caption) > * > * {
        border-width: 1px !important;
        border-color: #dee2e6 !important;
    }

    .group:hover * {
        transition: color 0.3s ease;
    }

    @@media print {
        .ac-page {
            padding: 0 !important;
            background: white !important;
        }

        .bg-blueprint {
            background: none !important;
        }

        .d-print-none {
            display: none !important;
        }

        .ac-card {
            border: 1px solid #000 !important;
            box-shadow: none !important;
        }
    }
</style>
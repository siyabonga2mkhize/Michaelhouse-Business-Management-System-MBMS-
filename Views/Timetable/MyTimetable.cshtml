@model List<Michaelhouse.Models.TimetableSlot>
@using Michaelhouse.Models.Enums
@using Michaelhouse.Services
@{
    ViewBag.Title = "My Timetable";
    var teacher = (Michaelhouse.Models.Teacher)ViewBag.Teacher;
    var periods = (List<Michaelhouse.Models.Period>)ViewBag.Periods;
    int academicYear = (int)ViewBag.AcademicYear;

    var days = new[] {
        new { Num = 1, Name = "Monday" },
        new { Num = 2, Name = "Tuesday" },
        new { Num = 3, Name = "Wednesday" },
        new { Num = 4, Name = "Thursday" },
        new { Num = 5, Name = "Friday" }
    };
}

<link rel="stylesheet" href="~/Content/academic.css" />

<div class="ac-page" style="background: #fbfbfb;">

    @* --- GHOST HEADER (Registry Blueprint) --- *@
    <div class="ac-header relative overflow-hidden mb-8"
         style="background-image: radial-gradient(rgba(0,0,0,0.08) 1px, transparent 1px); background-size: 20px 20px; padding: 50px 0 30px; border-bottom: 3px solid #1a1a1a;">

        <i class="bi bi-calendar3 absolute -right-20 -bottom-20 text-black/[0.03] text-[25rem] rotate-12 pointer-events-none"></i>

        <div class="ac-header-left relative z-10">
            <div class="flex items-center gap-2 mb-2">
                <div class="h-[3px] w-10 bg-[#C21E2E]"></div>
                <h5 class="text-[10px] uppercase tracking-[5px] font-bold text-gray-400">Faculty Ledger</h5>
            </div>
            <h1 class="text-4xl font-serif font-bold text-gray-900 tracking-tight uppercase">Weekly Schedule</h1>
            <p class="text-[10px] text-gray-400 mt-1 uppercase tracking-[3px] font-bold">
                Session @academicYear &bull; <span class="text-[#C21E2E]">@teacher?.Name</span>
            </p>
        </div>

        <div class="ac-header-actions relative z-10">
            <button onclick="window.print()" class="bg-black text-white px-6 py-2 text-[10px] font-bold uppercase tracking-widest hover:bg-[#C21E2E] transition-all shadow-xl d-print-none">
                <i class="bi bi-printer me-2"></i> Print Master
            </button>
        </div>
    </div>

    <div class="row g-0 mb-8 border border-gray-900 d-print-none bg-white">
        @foreach (var stat in new[] {
            new { Lbl = "Weekly Load", Val = Model.Count + " Periods", Color = "border-r" },
            new { Lbl = "Active Grades", Val = Model.Select(ts => ts.Grade).Distinct().Count().ToString(), Color = "border-r" },
            new { Lbl = "Faculty Status", Val = "Active", Color = "" }
        })
        {
            <div class="col-4 p-6 @stat.Color border-gray-100">
                <div class="text-[9px] font-bold uppercase tracking-[3px] text-gray-400 mb-1">@stat.Lbl</div>
                <div class="text-xl font-serif font-bold text-gray-900">@stat.Val</div>
            </div>
        }
    </div>

    <div class="ac-card border-2 border-gray-900 bg-[#f4f4f4] p-1 shadow-2xl">
        <div class="table-responsive" style="overflow-x: hidden;">
            @* Forces no scroll *@
            <table class="table table-bordered mb-0 border-gray-300" style="table-layout: fixed; width: 100%;">
                <thead>
                    <tr class="bg-gray-900 text-white">
                        <th class="py-4 text-center border-gray-800" style="width: 12%;">
                            <i class="bi bi-clock text-gray-500"></i>
                        </th>
                        @foreach (var day in days)
                        {
                            <th class="text-center py-4 border-gray-800 text-[10px] uppercase tracking-[4px] font-bold">@day.Name</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var period in periods)
                    {
                        <tr style="height: 100px;">
                            <td class="bg-gray-800 text-white p-3 flex flex-col justify-center items-center border-gray-700">
                                <div class="text-[10px] font-bold text-gray-400">@period.Label</div>
                                <div class="text-[9px] font-monospace mt-1 text-[#C21E2E]">@period.StartTime.ToString(@"hh\:mm")</div>
                            </td>
                            @foreach (var day in days)
                            {
                                var slot = Model.FirstOrDefault(ts => ts.DayOfWeek == day.Num && ts.PeriodId == period.PeriodId);

                                @* Empty cells get a "Blueprint" pattern to break up white space *@
                                <td class="p-1 relative align-middle @(period.IsBreak ? "bg-gray-200/50" : "bg-blueprint")">
                                    @if (period.IsBreak)
                                    {
                                        <div class="text-center text-[8px] font-bold uppercase tracking-[2px] text-gray-400 rotate-[-45deg] opacity-40">Break</div>
                                    }
                                    else if (slot != null)
                                    {
                                        <div class="h-full w-full bg-white border-l-4 border-l-[#C21E2E] p-3 shadow-sm flex flex-col justify-between group hover:invert transition-all duration-300">
                                            <div>
                                                <div class="text-[10px] font-bold text-gray-900 leading-tight uppercase tracking-tighter">@slot.Subject?.Name</div>
                                                <div class="h-[1px] w-4 bg-gray-200 mt-2"></div>
                                            </div>
                                            <div class="flex justify-between items-end">
                                                <span class="text-[9px] font-bold text-gray-400">GR @slot.Grade</span>
                                                <i class="bi @RegistrationService.GetStreamIcon(slot.Stream) text-[10px] opacity-20"></i>
                                            </div>
                                        </div>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    /* THE BLUEPRINT EFFECT - Breaks up the white space in empty cells */
    .bg-blueprint {
        background-color: #fdfdfd;
        background-image: linear-gradient(#f0f0f0 1.1px, transparent 1.1px), linear-gradient(90deg, #f0f0f0 1.1px, transparent 1.1px);
        background-size: 15px 15px;
    }

    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }

    .font-monospace {
        font-family: 'Source Code Pro', monospace;
    }

    /* Table Fixes */
    .table-bordered > :not(caption) > * > * {
        border-width: 1px;
    }

    /* Hover Invert Effect for high contrast */
    .group:hover {
        background: #1a1a1a !important;
        border-l-color: #fff !important;
    }

        .group:hover * {
            color: #fff !important;
        }

    @@media print {
        .ac-page {
            padding: 0 !important;
            background: white !important;
        }

        .bg-blueprint {
            background: none !important;
        }

        .ac-stat-card, .d-print-none {
            display: none !important;
        }
    }
</style>
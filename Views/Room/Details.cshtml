@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Room Details";
}

<section class="p-8 max-w-4xl mx-auto">
    <div class="flex items-start justify-between mb-6">
        <div>
            <h1 class="text-3xl font-serif font-bold">Room 14 — Founders House</h1>
            <p class="text-sm text-gray-500 mt-1">Room overview and bed allocation</p>
        </div>
        <div class="flex items-center gap-2">
            <a href="@Url.Action("Edit")" class="px-4 py-2 border rounded">Edit</a>
            <a href="@Url.Action("Archive")" class="px-4 py-2 bg-red-600 text-white rounded">Archive</a>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
        <div class="bg-white p-6 rounded shadow">
            <div class="text-sm text-gray-500 uppercase">Capacity</div>
            <div class="mt-2 text-2xl font-bold">6</div>
        </div>
        <div class="bg-white p-6 rounded shadow">
            <div class="text-sm text-gray-500 uppercase">Occupied</div>
            <div class="mt-2 text-2xl font-bold">5</div>
        </div>
        <div class="bg-white p-6 rounded shadow">
            <div class="text-sm text-gray-500 uppercase">Status</div>
            <div class="mt-2"><span class="px-2 py-1 bg-yellow-100 text-yellow-800 rounded">Available</span></div>
        </div>
    </div>

    <div class="bg-white p-6 rounded shadow">
        <h3 class="font-bold mb-4">Beds</h3>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <div class="p-3 border rounded">Bed 1 — Occupied</div>
            <div class="p-3 border rounded">Bed 2 — Occupied</div>
            <div class="p-3 border rounded">Bed 3 — Available</div>
        </div>
    </div>
</section>
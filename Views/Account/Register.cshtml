@model Michaelhouse.Models.ViewModels.RegisterViewModel
@{
    ViewBag.Title = "Create Account";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Register — Michaelhouse</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <style>
        body {
            background: linear-gradient(135deg, #1a3c5e 0%, #2d6a9f 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Segoe UI', sans-serif;
            padding: 30px 0;
        }

        .register-card {
            background: #fff;
            border-radius: 16px;
            box-shadow: 0 20px 60px rgba(0,0,0,0.3);
            width: 100%;
            max-width: 520px;
            overflow: hidden;
        }

        .register-header {
            background: #1a3c5e;
            color: #fff;
            padding: 24px 32px;
        }

            .register-header i {
                font-size: 1.8rem;
                color: #e8a020;
            }

        .register-body {
            padding: 32px;
        }

        .btn-register {
            background: #1a3c5e;
            color: #fff;
            width: 100%;
            padding: 12px;
            border-radius: 8px;
            font-weight: 600;
            border: none;
        }

            .btn-register:hover {
                background: #14304d;
                color: #fff;
            }

        .section-label {
            font-size: 0.72rem;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: #888;
            font-weight: 600;
            margin-bottom: 12px;
            margin-top: 20px;
        }
    </style>
</head>
<body>
    <div class="register-card">
        <div class="register-header d-flex align-items-center gap-3">
            <i class="bi bi-person-plus-fill"></i>
            <div>
                <h5 class="mb-0">Create Parent Account</h5>
                <small class="opacity-75">Michaelhouse Enrollment System</small>
            </div>
        </div>
        <div class="register-body">
            @using (Html.BeginForm("Register", "Account", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.ValidationSummary(true, "", new { @class = "alert alert-danger small" })

                <div class="section-label">Account Details</div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Full Name</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                        @Html.TextBoxFor(m => m.Name, new { @class = "form-control", placeholder = "Your full name" })
                    </div>
                    @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-danger small" })
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                        @Html.TextBoxFor(m => m.Email, new { @class = "form-control", placeholder = "you@example.com", type = "email" })
                    </div>
                    @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label class="form-label fw-semibold">Password</label>
                        @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Min. 6 characters" })
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-semibold">Confirm Password</label>
                        @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Repeat password" })
                        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger small" })
                    </div>
                </div>

                <div class="section-label">Contact Information</div>

                <div class="row g-3 mb-3">
                    <div class="col-6">
                        <label class="form-label fw-semibold">Cell Phone <span class="text-danger">*</span></label>
                        @Html.TextBoxFor(m => m.CellPhone, new { @class = "form-control", placeholder = "0821234567" })
                        @Html.ValidationMessageFor(m => m.CellPhone, "", new { @class = "text-danger small" })
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-semibold">Relationship to Student</label>
                        @Html.DropDownListFor(m => m.Relationship,
                            new SelectList(new[] { "Father", "Mother", "Guardian", "Other" }),
                            "-- Select --",
                            new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.Relationship, "", new { @class = "text-danger small" })
                    </div>
                </div>

                <button type="submit" class="btn-register mt-2">
                    <i class="bi bi-check-circle me-2"></i>Create Account
                </button>
            }

            <div class="text-center mt-3">
                <small class="text-muted">
                    Already have an account?
                    <a href="@Url.Action("Login", "Account")">Sign in</a>
                </small>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>

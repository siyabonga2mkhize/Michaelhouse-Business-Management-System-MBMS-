@model Michaelhouse.Models.ViewModels.RegisterViewModel
@{
    ViewBag.Title = "Create Account";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Register — Michaelhouse</title>

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,400&family=Montserrat:wght@400;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        :root {
            --mh-red: #C21E2E;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #fff;
        }

        h1, h2, h5, .font-serif {
            font-family: 'Playfair Display', serif !important;
        }

        .bg-image {
            background-image: url('https://images.unsplash.com/photo-1523050853064-850450000a60?auto=format&fit=crop&q=80&w=1500');
            background-size: cover;
            background-position: center;
        }

        .form-input-focus:focus {
            border-color: var(--mh-red) !important;
            outline: none;
            box-shadow: none;
        }

        /* Styling the scrollbar for the form side */
        .form-container::-webkit-scrollbar {
            width: 4px;
        }

        .form-container::-webkit-scrollbar-thumb {
            background: #eee;
        }
    </style>
</head>
<body class="antialiased">

    <div class="flex flex-col md:flex-row min-h-screen">

        <div class="hidden md:flex md:w-5/12 bg-image relative items-center justify-center p-16 sticky top-0 h-screen">
            <div class="absolute inset-0 bg-[#C21E2E]/10 mix-blend-multiply"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-transparent"></div>

            <div class="relative z-10 text-white">
                <div class="mb-8">
                    <i class="bi bi-person-plus text-6xl"></i>
                </div>
                <h1 class="text-5xl font-bold mb-6 leading-tight">Join the <br />Community.</h1>
                <p class="text-xl text-white/80 italic font-serif leading-relaxed border-l-2 border-white/30 pl-6">
                    "Our distinctive location and architecture... cultivate the fundamental building blocks for navigating a world dominated by ambiguity."
                </p>
            </div>
        </div>

        <div class="w-full md:w-7/12 flex items-center justify-center p-8 lg:p-20 bg-white form-container">
            <div class="w-full max-w-xl">

                <div class="mb-10">
                    <img src="@Url.Content("~/Content/logo.svg.png")" alt="Michaelhouse Crest" class="h-20 mb-8 object-contain" />
                    <h2 class="text-3xl text-gray-900 font-bold">Create Parent Account</h2>
                    <div class="h-1 w-12 bg-[#C21E2E] mt-4"></div>
                </div>

                @using (Html.BeginForm("Register", "Account", FormMethod.Post, new { @class = "space-y-8" }))
                {
                    @Html.AntiForgeryToken()

                    if (!ViewData.ModelState.IsValid)
                    {
                        <div class="bg-red-50 text-red-700 p-4 border-l-4 border-red-600 text-xs mb-6 font-bold uppercase tracking-wider">
                            @Html.ValidationSummary(true, "")
                        </div>
                    }

                    <div>
                        <p class="text-[10px] uppercase tracking-[3px] font-bold text-[#C21E2E] mb-6 border-b border-gray-100 pb-2">01. Account Details</p>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div class="col-span-2">
                                <label class="block text-[10px] uppercase tracking-[2px] font-bold text-gray-400 mb-2">Full Name</label>
                                @Html.TextBoxFor(m => m.Name, new { @class = "w-full p-3 border border-gray-200 rounded-none form-input-focus text-sm", placeholder = "As it appears on ID" })
                                @Html.ValidationMessageFor(m => m.Name, "", new { @class = "text-red-500 text-[10px] mt-1 font-bold uppercase" })
                            </div>

                            <div class="col-span-2">
                                <label class="block text-[10px] uppercase tracking-[2px] font-bold text-gray-400 mb-2">Email Address</label>
                                @Html.TextBoxFor(m => m.Email, new { @class = "w-full p-3 border border-gray-200 rounded-none form-input-focus text-sm", placeholder = "you@example.com", type = "email" })
                                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-red-500 text-[10px] mt-1 font-bold uppercase" })
                            </div>

                            <div>
                                <label class="block text-[10px] uppercase tracking-[2px] font-bold text-gray-400 mb-2">Password</label>
                                @Html.PasswordFor(m => m.Password, new { @class = "w-full p-3 border border-gray-200 rounded-none form-input-focus text-sm", placeholder = "••••••••" })
                                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-red-500 text-[10px] mt-1 font-bold uppercase" })
                            </div>

                            <div>
                                <label class="block text-[10px] uppercase tracking-[2px] font-bold text-gray-400 mb-2">Confirm Password</label>
                                @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "w-full p-3 border border-gray-200 rounded-none form-input-focus text-sm", placeholder = "••••••••" })
                                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-red-500 text-[10px] mt-1 font-bold uppercase" })
                            </div>
                        </div>
                    </div>

                    <div class="pt-4">
                        <p class="text-[10px] uppercase tracking-[3px] font-bold text-[#C21E2E] mb-6 border-b border-gray-100 pb-2">02. Contact Information</p>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <label class="block text-[10px] uppercase tracking-[2px] font-bold text-gray-400 mb-2">Cell Phone</label>
                                @Html.TextBoxFor(m => m.CellPhone, new { @class = "w-full p-3 border border-gray-200 rounded-none form-input-focus text-sm", placeholder = "082 123 4567" })
                                @Html.ValidationMessageFor(m => m.CellPhone, "", new { @class = "text-red-500 text-[10px] mt-1 font-bold uppercase" })
                            </div>

                            <div>
                                <label class="block text-[10px] uppercase tracking-[2px] font-bold text-gray-400 mb-2">Relationship to Student</label>
                                @Html.DropDownListFor(m => m.Relationship,
                                    new SelectList(new[] { "Father", "Mother", "Guardian", "Other" }),
                                    "-- Select --",
                                    new { @class = "w-full p-3 border border-gray-200 rounded-none form-input-focus text-sm bg-white" })
                                @Html.ValidationMessageFor(m => m.Relationship, "", new { @class = "text-red-500 text-[10px] mt-1 font-bold uppercase" })
                            </div>
                        </div>
                    </div>

                    <div class="pt-6">
                        <button type="submit" class="w-full bg-[#C21E2E] text-white py-4 font-bold uppercase tracking-[3px] text-[11px] hover:bg-[#a01826] transition-all shadow-lg shadow-red-900/10 active:scale-[0.98]">
                            Finalize Registration
                        </button>

                        <p class="text-center mt-6 text-gray-400 text-[11px]">
                            Already have an account?
                            <a href="@Url.Action("Login", "Account")" class="text-[#C21E2E] font-bold uppercase tracking-widest ml-2 hover:underline">Sign In</a>
                        </p>
                    </div>
                }

                <footer class="mt-20 text-gray-300 text-[9px] uppercase tracking-[3px] text-center md:text-left">
                    &copy; @DateTime.Now.Year Michaelhouse School. <br class="md:hidden" /> All Rights Reserved.
                </footer>
            </div>
        </div>
    </div>

</body>
</html>
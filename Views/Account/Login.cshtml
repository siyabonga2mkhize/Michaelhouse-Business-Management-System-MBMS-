@model Michaelhouse.Models.ViewModels.LoginViewModel
@{
    ViewBag.Title = "Login";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Login — Michaelhouse</title>

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,400&family=Montserrat:wght@400;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        :root {
            --mh-red: #C21E2E;
        }

        body {
            font-family: 'Montserrat', sans-serif;
        }

        h1, h2, .font-serif {
            font-family: 'Playfair Display', serif !important;
        }

        .bg-image {
            background-image: url('https://images.unsplash.com/photo-1541339907198-e08756defeec?auto=format&fit=crop&q=80&w=1500');
            background-size: cover;
            background-position: center;
        }

        /* Ensure the logo renders as sharp as possible */
        .mh-crest {
            image-rendering: -webkit-optimize-contrast;
            image-rendering: crisp-edges;
            max-width: 100%;
        }

        .heading-accent::after {
            content: '';
            display: block;
            width: 40px;
            height: 3px;
            background: var(--mh-red);
            margin-top: 12px;
        }

        .form-input-focus:focus {
            border-color: var(--mh-red) !important;
            outline: none;
            box-shadow: none;
        }
    </style>
</head>
<body class="bg-white antialiased">

    <div class="flex flex-col md:flex-row min-h-screen">

        <div class="hidden md:flex md:w-1/2 bg-image relative items-center justify-center p-16">
            <div class="absolute inset-0 bg-[#C21E2E]/15 mix-blend-multiply"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/40 to-transparent"></div>

            <div class="relative z-10 text-white max-w-lg">
                <h1 class="text-6xl font-bold mb-6 leading-[1.1] tracking-tight">
                    Men of Principle <br /><span class="italic font-normal">Tomorrow.</span>
                </h1>
                <p class="text-xl text-white/80 italic font-serif leading-relaxed border-l-2 border-white/30 pl-6">
                    "Our aim is to make, not accountants, not clerks, not clergymen, but men; men of understanding, thought and culture."
                </p>
                <div class="mt-12 text-[10px] uppercase tracking-[4px] font-bold text-white/50">
                    Established 1896
                </div>
            </div>
        </div>

        <div class="w-full md:w-1/2 flex items-center justify-center p-8 lg:p-24 bg-white">
            <div class="w-full max-w-md">

                <div class="mb-10 text-center md:text-left">
                    <img src="@Url.Content("~/Content/logo.svg.png")"
                         alt="Michaelhouse Crest"
                         class="mh-crest h-32 md:h-40 mx-auto md:mx-0 object-contain mb-6" />

                    <header>
                        <h2 class="text-3xl text-gray-900 font-bold heading-accent inline-block md:block">Portal Login</h2>
                        <p class="text-gray-400 mt-4 text-[10px] uppercase tracking-[3px] font-bold">
                            Management Information System
                        </p>
                    </header>
                </div>

                @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { @class = "space-y-6" }))
                {
                    @Html.AntiForgeryToken()

                    if (!ViewData.ModelState.IsValid)
                    {
                        <div class="bg-red-50 text-red-700 p-4 border-l-4 border-red-600 text-xs mb-6">
                            @Html.ValidationSummary(true, "")
                        </div>
                    }

                    <div>
                        <label class="block text-[10px] uppercase tracking-[2px] font-bold text-gray-400 mb-2">Email Address</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-gray-400">
                                <i class="bi bi-envelope text-sm"></i>
                            </span>
                            @Html.TextBoxFor(m => m.Email, new
                            {
                                @class = "w-full pl-11 pr-4 py-4 border border-gray-200 rounded-none form-input-focus transition-all text-sm",
                                placeholder = "name@michaelhouse.org",
                                type = "email"
                            })
                        </div>
                        @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-red-500 text-[10px] mt-1 font-bold uppercase" })
                    </div>

                    <div>
                        <div class="flex justify-between items-center mb-2">
                            <label class="text-[10px] uppercase tracking-[2px] font-bold text-gray-400">Password</label>
                            <a href="#" class="text-[9px] uppercase tracking-wider font-bold text-gray-400 hover:text-[#C21E2E] transition-colors">Forgot Password?</a>
                        </div>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 flex items-center pl-4 text-gray-400">
                                <i class="bi bi-lock text-sm"></i>
                            </span>
                            @Html.PasswordFor(m => m.Password, new
                            {
                                @class = "w-full pl-11 pr-4 py-4 border border-gray-200 rounded-none form-input-focus transition-all text-sm",
                                placeholder = "••••••••"
                            })
                        </div>
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-red-500 text-[10px] mt-1 font-bold uppercase" })
                    </div>

                    <button type="submit" class="w-full bg-[#C21E2E] text-white py-4 font-bold uppercase tracking-[3px] text-[11px] hover:bg-[#a01826] transition-all duration-300 active:scale-[0.98] shadow-lg shadow-red-900/10">
                        Sign Into Portal
                    </button>
                }

            <div class="mt-12 pt-8 border-t border-gray-100 flex flex-col sm:flex-row items-center justify-between gap-4">
                <div class="text-center sm:text-left">
                    <p class="text-gray-400 text-[11px] font-medium uppercase tracking-wider">New Parent?</p>
                    <a href="@Url.Action("Register", "Account")" class="text-[11px] font-bold text-[#C21E2E] uppercase tracking-widest hover:underline">
                        Apply for Admission
                    </a>
                </div>
                <div style="margin-top:15px;">
                    <p class="text-gray-400 text-[11px] font-medium uppercase tracking-wider">New Driver?</p>
                    <a href="@Url.Action("Create", "DriverApplications")" class="text-[11px] font-bold text-[#C21E2E] uppercase tracking-widest hover:underline">
                        Apply as Driver
                      </a>
                </div>
            </div>

                <footer class="mt-16 text-gray-300 text-[9px] uppercase tracking-[3px] text-center md:text-left">
                    &copy; @DateTime.Now.Year Michaelhouse School.
                </footer>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
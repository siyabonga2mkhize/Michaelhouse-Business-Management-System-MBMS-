@model IEnumerable<Michaelhouse.Models.Allergen>
@{
    ViewBag.Title = "Allergens";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var list = Model.ToList();
}

<div class="relative mb-8 border-b border-gray-100 bg-gray-50/30 py-8 px-4 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none"
         style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 24px 24px;"></div>
    <i class="bi bi-exclamation-triangle absolute -right-8 -bottom-10 text-black/5 text-[12rem] rotate-12"></i>

    <div class="max-w-4xl mx-auto relative z-10">
        <div class="flex items-center gap-2 mb-3">
            <div class="h-1 w-8 bg-[#C21E2E]"></div>
            <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Dietitian Portal</h5>
        </div>
        <h2 class="text-3xl font-serif font-bold text-gray-900 tracking-tight">Allergens Catalogue</h2>
        <p class="text-gray-400 text-[10px] uppercase tracking-widest font-bold mt-2">@list.Count allergen(s)</p>
    </div>
</div>

<div class="max-w-4xl mx-auto px-4 pb-20">

    <div class="bg-white border border-gray-100 shadow-sm overflow-hidden mb-6">
        <div class="divide-y divide-gray-50">
            @foreach (var a in list)
            {
                <div class="p-4">
                    <div class="flex justify-between items-center">
                        <div>
                            <strong class="text-sm text-gray-900">@a.Name</strong>
                            @if (!string.IsNullOrEmpty(a.Description))
                            {
                                <p class="text-xs text-gray-500 mt-1 mb-0">@a.Description</p>
                            }
                        </div>
                        <span class="text-[9px] font-bold uppercase tracking-widest px-2 py-0.5 @(a.IsActive ? "bg-green-500" : "bg-gray-300") text-white">
                            @(a.IsActive ? "Active" : "Inactive")
                        </span>
                    </div>
                </div>
            }
        </div>
    </div>

    <div class="bg-white border border-gray-100 shadow-sm overflow-hidden">
        <div class="p-4 border-b border-gray-100 bg-gray-50/50">
            <h6 class="text-[10px] uppercase tracking-[3px] font-bold text-gray-900 mb-0">
                <i class="bi bi-plus-circle me-2 text-[#C21E2E]"></i>Add Allergen
            </h6>
        </div>

        @using (Html.BeginForm("AddAllergen", "Dietitian", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="p-6 space-y-4">
                <div>
                    <label class="block text-[9px] uppercase tracking-widest font-bold text-gray-400 mb-2">Name *</label>
                    <input type="text" name="name" required class="w-full border border-gray-200 py-3 px-4 text-sm" />
                </div>
                <div>
                    <label class="block text-[9px] uppercase tracking-widest font-bold text-gray-400 mb-2">Description</label>
                    <input type="text" name="description" class="w-full border border-gray-200 py-3 px-4 text-sm" />
                </div>
                <div class="flex justify-end">
                    <button type="submit" class="bg-[#C21E2E] text-white px-8 py-3 text-[10px] font-bold uppercase tracking-widest hover:bg-black">
                        <i class="bi bi-check2-circle me-2"></i>Add Allergen
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }

    .divide-y > * + * {
        border-top-width: 1px;
    }
</style>
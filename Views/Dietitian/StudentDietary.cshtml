@model IEnumerable<Michaelhouse.Models.StudentDietaryRecord>
@{
    ViewBag.Title = "Student Dietary Profile";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var student = ViewBag.Student as Michaelhouse.Models.Student;
    var pending = ViewBag.PendingRequests as List<Michaelhouse.Models.DietaryChangeRequest> ?? new List<Michaelhouse.Models.DietaryChangeRequest>();
    var allergens = ViewBag.Allergens as List<Michaelhouse.Models.Allergen> ?? new List<Michaelhouse.Models.Allergen>();
    var categories = ViewBag.Categories as List<Michaelhouse.Models.DietaryCategory> ?? new List<Michaelhouse.Models.DietaryCategory>();
    var list = Model.ToList();
}

<div class="relative mb-8 border-b border-gray-100 bg-gray-50/30 py-8 px-4 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none"
         style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 24px 24px;"></div>
    <i class="bi bi-person-badge absolute -right-8 -bottom-10 text-black/5 text-[12rem] rotate-12"></i>

    <div class="max-w-5xl mx-auto relative z-10">
        <div class="flex items-center gap-2 mb-3">
            <div class="h-1 w-8 bg-[#C21E2E]"></div>
            <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Dietitian Portal</h5>
        </div>
        <h2 class="text-3xl font-serif font-bold text-gray-900 tracking-tight">
            @(student != null ? student.FirstName + " " + student.LastName : "Student")
        </h2>
        <p class="text-gray-400 text-[10px] uppercase tracking-widest font-bold mt-2">
            @(student != null ? "Grade " + student.GradeLevel : "") @(student != null && student.StudentNumber != null ? " • " + student.StudentNumber : "") &bull; @list.Count record(s)
        </p>
    </div>
</div>

<div class="max-w-5xl mx-auto px-4 pb-20">

    @* ─── PENDING REQUESTS ─────────────────────────────────── *@
    @if (pending.Any())
    {
        <div class="bg-amber-50 border-l-4 border-amber-500 p-4 mb-6">
            <h6 class="text-[10px] uppercase tracking-widest font-bold text-amber-700 mb-2">
                <i class="bi bi-clock-history me-1"></i>@pending.Count Pending Request(s)
            </h6>
            @foreach (var p in pending)
            {
                <div class="flex justify-between items-center py-2">
                    <div>
                        <span class="text-[8px] font-bold uppercase tracking-widest px-2 py-0.5 bg-gray-700 text-white">@p.RecordType</span>
                        <span class="text-sm text-gray-700 ms-2">@(p.RequestedDescription ?? "—")</span>
                    </div>
                    <a href="@Url.Action("ReviewRequest", new { id = p.Id })"
                       class="text-[10px] font-bold uppercase tracking-widest text-[#C21E2E] hover:text-black">
                        Review →
                    </a>
                </div>
            }
        </div>
    }

    @* ─── ACTIVE RECORDS ───────────────────────────────────── *@
    <div class="bg-white border border-gray-100 shadow-sm overflow-hidden mb-6">
        <div class="p-4 border-b border-gray-100 bg-gray-50/50">
            <h6 class="text-[10px] uppercase tracking-[3px] font-bold text-gray-900 mb-0">Dietary Records</h6>
        </div>

        @if (!list.Any())
        {
            <div class="p-8 text-center text-gray-400 text-sm">No dietary records.</div>
        }
        else
        {
            <div class="divide-y divide-gray-50">
                @foreach (var r in list)
                {
                    <div class="p-4 flex justify-between items-start">
                        <div>
                            <div class="flex items-center gap-2 mb-1">
                                <span class="text-[8px] font-bold uppercase tracking-widest px-2 py-0.5 @(r.IsActive ? "bg-green-500" : "bg-gray-300") text-white">
                                    @(r.IsActive ? "Active" : "Inactive")
                                </span>
                                <span class="text-[8px] font-bold uppercase tracking-widest px-2 py-0.5 bg-gray-700 text-white">@r.RecordType</span>
                            </div>
                            <p class="text-sm text-gray-900 font-bold mb-0">
                                @(r.Allergen != null ? r.Allergen.Name : (r.DietaryCategory != null ? r.DietaryCategory.Name : r.CustomDescription))
                            </p>
                            @if (!string.IsNullOrEmpty(r.ReviewNotes))
                            {
                                <p class="text-xs text-gray-500 mt-1 mb-0"><em>@r.ReviewNotes</em></p>
                            }
                        </div>
                        <div class="text-right">
                            <p class="text-[9px] text-gray-400 mb-1">
                                @(r.ApprovedAt.HasValue ? "Approved " + r.ApprovedAt.Value.ToString("dd MMM yyyy") : "Requested " + r.RequestedAt.ToString("dd MMM yyyy"))
                            </p>
                            @if (r.IsActive)
                            {
                                using (Html.BeginForm("DeactivateRecord", "Dietitian", new { id = r.Id }, FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="text-[9px] font-bold uppercase tracking-widest text-red-600 hover:text-red-800"
                                            onclick="return confirm('Deactivate this record?');">
                                        Deactivate
                                    </button>
                                }
                            }
                        </div>
                    </div>
                }
            </div>
        }
    </div>

    @* ─── ADD RECORD DIRECTLY ──────────────────────────────── *@
    <div class="bg-white border border-gray-100 shadow-sm overflow-hidden">
        <div class="p-4 border-b border-gray-100 bg-gray-50/50">
            <h6 class="text-[10px] uppercase tracking-[3px] font-bold text-gray-900 mb-0">
                <i class="bi bi-plus-circle me-2 text-[#C21E2E]"></i>Add Record Directly (Dietitian Override)
            </h6>
        </div>

        @using (Html.BeginForm("AddRecordDirect", "Dietitian", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="studentId" value="@(student != null ? student.StudentId : 0)" />
            <div class="p-6 space-y-4">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-[9px] uppercase tracking-widest font-bold text-gray-400 mb-2">Record Type *</label>
                        <select name="recordType" class="w-full border border-gray-200 py-3 px-4 text-sm" required>
                            <option value="0">Allergy</option>
                            <option value="1">Medical Restriction</option>
                            <option value="2">Dietary Preference</option>
                            <option value="3">Religious / Cultural</option>
                            <option value="4">Dislike</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-[9px] uppercase tracking-widest font-bold text-gray-400 mb-2">Allergen (if allergy)</label>
                        <select name="allergenId" class="w-full border border-gray-200 py-3 px-4 text-sm">
                            <option value="">— None —</option>
                            @foreach (var a in allergens)
                            {
                                <option value="@a.Id">@a.Name</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-[9px] uppercase tracking-widest font-bold text-gray-400 mb-2">Dietary Category (if preference)</label>
                        <select name="categoryId" class="w-full border border-gray-200 py-3 px-4 text-sm">
                            <option value="">— None —</option>
                            @foreach (var c in categories)
                            {
                                <option value="@c.Id">@c.Name</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label class="block text-[9px] uppercase tracking-widest font-bold text-gray-400 mb-2">Custom Description</label>
                        <input type="text" name="customDescription" class="w-full border border-gray-200 py-3 px-4 text-sm" />
                    </div>
                </div>
                <div>
                    <label class="block text-[9px] uppercase tracking-widest font-bold text-gray-400 mb-2">Notes</label>
                    <textarea name="notes" rows="2" class="w-full border border-gray-200 py-3 px-4 text-sm"></textarea>
                </div>
                <div class="flex justify-end">
                    <button type="submit" class="bg-[#C21E2E] text-white px-8 py-3 text-[10px] font-bold uppercase tracking-widest hover:bg-black">
                        <i class="bi bi-check2-circle me-2"></i>Add Record
                    </button>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }

    .divide-y > * + * {
        border-top-width: 1px;
    }
</style>
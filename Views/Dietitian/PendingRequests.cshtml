@model IEnumerable<Michaelhouse.Models.DietaryChangeRequest>
@{
    ViewBag.Title = "Pending Requests";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var list = Model.ToList();
    var statusFilter = ViewBag.StatusFilter as string ?? "Pending";
}

<div class="relative mb-8 border-b border-gray-100 bg-gray-50/30 py-8 px-4 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none"
         style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 24px 24px;"></div>
    <i class="bi bi-inbox absolute -right-8 -bottom-10 text-black/5 text-[12rem] rotate-12"></i>

    <div class="max-w-5xl mx-auto relative z-10">
        <div class="flex items-center gap-2 mb-3">
            <div class="h-1 w-8 bg-[#C21E2E]"></div>
            <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Dietitian Portal</h5>
        </div>
        <h2 class="text-3xl font-serif font-bold text-gray-900 tracking-tight">Dietary Change Requests</h2>
    </div>
</div>

<div class="max-w-5xl mx-auto px-4 pb-20">

    @* ─── FILTER TABS ────────────────────────────────────────── *@
    <div class="flex gap-2 mb-6">
        <a href="@Url.Action("PendingRequests", new { status = "Pending" })"
           class="px-5 py-2 text-[10px] font-bold uppercase tracking-widest @(statusFilter == "Pending" ? "bg-[#C21E2E] text-white" : "bg-white border border-gray-200 text-gray-700 hover:border-[#C21E2E]")">
            Pending
        </a>
        <a href="@Url.Action("PendingRequests", new { status = "UnderReview" })"
           class="px-5 py-2 text-[10px] font-bold uppercase tracking-widest @(statusFilter == "UnderReview" ? "bg-[#C21E2E] text-white" : "bg-white border border-gray-200 text-gray-700 hover:border-[#C21E2E]")">
            Under Review
        </a>
        <a href="@Url.Action("PendingRequests", new { status = "Approved" })"
           class="px-5 py-2 text-[10px] font-bold uppercase tracking-widest @(statusFilter == "Approved" ? "bg-[#C21E2E] text-white" : "bg-white border border-gray-200 text-gray-700 hover:border-[#C21E2E]")">
            Approved
        </a>
        <a href="@Url.Action("PendingRequests", new { status = "Rejected" })"
           class="px-5 py-2 text-[10px] font-bold uppercase tracking-widest @(statusFilter == "Rejected" ? "bg-[#C21E2E] text-white" : "bg-white border border-gray-200 text-gray-700 hover:border-[#C21E2E]")">
            Rejected
        </a>
    </div>

    @if (!list.Any())
    {
        <div class="bg-white border border-gray-100 p-12 text-center">
            <i class="bi bi-inbox text-5xl block mb-3 text-gray-300"></i>
            <p class="text-gray-500 mb-0">No requests with status <strong>@statusFilter</strong>.</p>
        </div>
    }
    else
    {
        <div class="bg-white border border-gray-100 shadow-sm overflow-hidden">
            <div class="divide-y divide-gray-50">
                @foreach (var r in list)
                {
                    <a href="@Url.Action("ReviewRequest", new { id = r.Id })"
                       class="block p-5 hover:bg-gray-50 transition-all">
                        <div class="flex justify-between items-start mb-2">
                            <div>
                                <strong class="text-base text-gray-900 block">
                                    @(r.Student != null ? r.Student.FirstName + " " + r.Student.LastName : "Student")
                                </strong>
                                <span class="text-[10px] uppercase tracking-widest font-bold text-gray-400">
                                    @(r.Student != null ? "Grade " + r.Student.GradeLevel : "")
                                </span>
                            </div>
                            <div class="text-right">
                                <div class="flex items-center gap-2 justify-end mb-1">
                                    @if (r.SafetyReviewRequired)
                                    {<span class="text-[8px] font-bold uppercase tracking-widest px-2 py-0.5 bg-red-600 text-white">Safety Review</span>}
                                    <span class="text-[8px] font-bold uppercase tracking-widest px-2 py-0.5 bg-gray-700 text-white">@r.RecordType</span>
                                </div>
                                <span class="text-[9px] text-gray-400">@r.SubmittedAt.ToString("dd MMM yyyy HH:mm")</span>
                            </div>
                        </div>
                        <p class="text-sm text-gray-700 mb-0">
                            @(r.RequestedDescription ?? "—")
                        </p>
                        @if (!string.IsNullOrEmpty(r.Reason))
                        {
                            <p class="text-xs text-gray-500 mt-1 mb-0"><em>Reason: @r.Reason</em></p>
                        }
                    </a>
                }
            </div>
        </div>
    }
</div>

<style>
    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }

    .divide-y > * + * {
        border-top-width: 1px;
    }
</style>
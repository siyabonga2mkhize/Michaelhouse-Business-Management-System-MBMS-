@using System.Linq
@using Michaelhouse.Models.Cafeteria
@using Michaelhouse.Services
@model CafeteriaEvent
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = Model.EventName;

    string rsvpLink = Url.Action("Event", "Rsvp", new { id = Model.Id }, Request.Url.Scheme);

    string inviteText = string.Format(
        "You're invited to {0}\r\n\r\n{1}\r\n{2} – {3}\r\n{4}\r\n\r\nRSVP by {5}:\r\n{6}",
        Model.EventName,
        Model.EventDate.ToString("dddd, dd MMMM yyyy"),
        Model.StartTime.ToString(@"hh\:mm"),
        Model.EndTime.ToString(@"hh\:mm"),
        Model.Venue != null ? Model.Venue.Name : "",
        Model.RsvpDeadline.HasValue ? Model.RsvpDeadline.Value.ToString("dddd, dd MMMM") : "the deadline",
        rsvpLink);

    var rsvps = Model.Rsvps != null ? Model.Rsvps.ToList() : new List<EventRsvp>();
    var attending = rsvps.Where(r => r.ResponseStatus == "Attending").ToList();
    var declined = rsvps.Where(r => r.ResponseStatus == "Declined").ToList();
    var maybe = rsvps.Where(r => r.ResponseStatus == "Maybe").ToList();

    int totalAttendees = attending.Sum(r => r.TotalAttendees);
    int standard = attending.Sum(r => r.StandardCount);
    int vegetarian = attending.Sum(r => r.VegetarianCount);
    int other = attending.Sum(r => r.OtherDietCount);

    var dietaryNotes = attending
        .Where(r => !string.IsNullOrWhiteSpace(r.DietaryNotes))
        .Select(r => new { r.ResponderName, r.DietaryNotes })
        .ToList();

    string statusClass = "draft";
    switch (Model.Status)
    {
        case EventStatus.Confirmed: statusClass = "confirmed"; break;
        case EventStatus.RsvpOpen: statusClass = "rsvp-open"; break;
        case EventStatus.RsvpClosed: statusClass = "rsvp-closed"; break;
        case EventStatus.FeastPlanGenerated: statusClass = "plan-done"; break;
        case EventStatus.Completed: statusClass = "completed"; break;
        case EventStatus.Cancelled: statusClass = "cancelled"; break;
    }

    var rsvpStatus = ViewBag.RsvpStatus as RsvpStatusInfo;
    var coverage = ViewBag.Coverage as BuffetCoverageReport ?? new BuffetCoverageReport();
    bool usesTemplateMenu = ViewBag.UsesTemplateMenu == true;
    bool canEdit = ViewBag.CanEdit == true;
    var houseNames = ViewBag.Houses as Dictionary<int, string> ?? new Dictionary<int, string>();
    var attendance = ViewBag.Attendance as EventAttendance ?? new EventAttendance();
    var invited = ViewBag.Invited as InvitedSummary ?? new InvitedSummary();
    var requirements = ViewBag.Requirements as EventRequirements ?? new EventRequirements();
    var mealNames = ViewBag.MealNames as Dictionary<int, string> ?? new Dictionary<int, string>();

    Func<string, string, string> audience = (csv, everyone) =>
    {
        var ids = EventRsvpService.ParseIds(csv);
        return ids.Count == 0
            ? everyone
            : "Only " + string.Join(", ", ids.Select(i => houseNames.ContainsKey(i) ? houseNames[i] : "house " + i));
    };

    string rsvpClass = "draft";
    if (rsvpStatus != null)
    {
        switch (rsvpStatus.State)
        {
            case RsvpState.ScheduledToOpen: rsvpClass = "confirmed"; break;
            case RsvpState.Open: rsvpClass = "rsvp-open"; break;
            case RsvpState.Closed: rsvpClass = "rsvp-closed"; break;
        }
    }

    bool isConfirmed = rsvpStatus != null && rsvpStatus.CanOpenNow;
    bool isRsvpOpen = Model.Status == EventStatus.RsvpOpen;
    bool isRsvpClosed = Model.Status == EventStatus.RsvpClosed;
    bool isFeastPlanReady = Model.Status == EventStatus.FeastPlanGenerated;
}

<style>
    .ed-shell {
        max-width: 1000px;
        margin: 0 auto;
    }

    .ed-header {
        padding-bottom: 1.25rem;
        margin-bottom: 1.5rem;
        border-bottom: 1px solid #eaeaea;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

        .ed-header h1 {
            font-size: 1.9rem;
            margin: 0 0 .35rem 0;
        }

    .ed-meta {
        color: #888;
        font-size: .85rem;
    }

    .ed-status {
        display: inline-block;
        padding: .3rem .7rem;
        border-radius: 6px;
        font-size: .75rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

        .ed-status.draft {
            background: #f3f4f6;
            color: #6b7280;
        }

        .ed-status.confirmed {
            background: #dbeafe;
            color: #1e40af;
        }

        .ed-status.rsvp-open {
            background: #fef3c7;
            color: #92400e;
        }

        .ed-status.rsvp-closed {
            background: #ede9fe;
            color: #5b21b6;
        }

        .ed-status.plan-done {
            background: #d1fae5;
            color: #065f46;
        }

        .ed-status.completed {
            background: #e5e7eb;
            color: #374151;
        }

        .ed-status.cancelled {
            background: #fee2e2;
            color: #991b1b;
        }

    .ed-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 1.25rem;
        margin-bottom: 1rem;
    }

    .ed-card-title {
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: #6b7280;
        margin: 0 0 .85rem 0;
    }

    .ed-info-row {
        display: grid;
        grid-template-columns: 130px 1fr;
        gap: 1rem;
        padding: .35rem 0;
        font-size: .88rem;
    }

    .ed-info-label {
        color: #6b7280;
    }

    .ed-info-value {
        color: #111827;
        font-weight: 500;
    }

    .ed-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: .75rem;
    }

    @@media (max-width: 600px) {
        .ed-stats {
            grid-template-columns: repeat(2, 1fr) !important;
        }
    }

    .ed-stat {
        background: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: .85rem .95rem;
    }

    .ed-stat-label {
        font-size: .65rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: #6b7280;
    }

    .ed-stat-value {
        font-size: 1.5rem;
        font-weight: 700;
        color: #111827;
        line-height: 1.1;
        margin-top: .2rem;
    }

        .ed-stat-value.green {
            color: #065f46;
        }

        .ed-stat-value.amber {
            color: #92400e;
        }

    .ed-diet-list {
        font-size: .82rem;
        color: #4b5563;
        line-height: 1.6;
    }

        .ed-diet-list .who {
            color: #9ca3af;
        }

    .ed-btn-row {
        display: flex;
        gap: .5rem;
        margin-top: 1rem;
        flex-wrap: wrap;
    }

    .ed-link-box {
        background: #fffbeb;
        border: 1px solid #fde68a;
        border-radius: 8px;
        padding: .85rem 1rem;
        margin-top: .75rem;
        font-family: 'Courier New', monospace;
        font-size: .78rem;
        color: #78350f;
        word-break: break-all;
    }

    .ed-tag {
        display: inline-block;
        font-size: .65rem;
        font-weight: 700;
        padding: .1rem .4rem;
        border-radius: 4px;
        margin-right: .25rem;
        background: #d1fae5;
        color: #065f46;
    }

    .ed-warning {
        background: #fef3c7;
        color: #92400e;
        border: 1px solid #fde68a;
        border-radius: 6px;
        padding: .55rem .8rem;
        font-size: .84rem;
        margin-bottom: .4rem;
    }

    .ed-ok {
        background: #d1fae5;
        color: #065f46;
        border-radius: 6px;
        padding: .55rem .8rem;
        font-size: .84rem;
        margin-bottom: .75rem;
    }

    .ed-sub {
        font-size: .8rem;
        color: #4b5563;
        margin-bottom: .6rem;
    }

    .ed-none {
        color: #b91c1c;
        font-weight: 600;
    }

    .ed-table-wrap {
        overflow-x: auto;
    }

    .ed-rsvp-table {
        width: 100%;
        border-collapse: collapse;
        font-size: .85rem;
    }

        .ed-rsvp-table th {
            text-align: left;
            padding: .5rem .65rem;
            font-size: .68rem;
            font-weight: 700;
            letter-spacing: .06em;
            text-transform: uppercase;
            color: #6b7280;
            border-bottom: 1px solid #e5e7eb;
        }

        .ed-rsvp-table td {
            padding: .6rem .65rem;
            border-bottom: 1px solid #f3f4f6;
        }

        .ed-rsvp-table tr:last-child td {
            border-bottom: none;
        }
</style>

<div class="container-fluid py-4">
    <div class="ed-shell">

        <div class="ed-header">
            <div>
                <h1>@Model.EventName</h1>
                <div class="ed-meta">
                    @Model.EventDate.ToString("dddd, dd MMMM yyyy")
                    &nbsp;·&nbsp;
                    @Model.StartTime.ToString(@"hh\:mm")–@Model.EndTime.ToString(@"hh\:mm")
                    &nbsp;·&nbsp;
                    @(Model.Venue != null ? Model.Venue.Name : "—")
                </div>
            </div>
            <div style="text-align:right;">
                <span class="ed-status @statusClass">@Model.Status</span>
                @if (rsvpStatus != null)
                {
                    <div style="margin-top:.4rem;">
                        <span class="ed-status @rsvpClass">RSVP: @rsvpStatus.Label</span>
                    </div>
                    <div class="ed-meta" style="margin-top:.25rem;">@rsvpStatus.Detail</div>
                }
                @if (canEdit)
                {
                    <a href="@Url.Action("Edit", "Event", new { id = Model.Id })" class="btn btn-sm btn-outline-secondary" style="margin-top:.5rem;">Edit event</a>
                }
            </div>
        </div>

        <!-- EVENT INFO -->
        <div class="ed-card">
            <div class="ed-card-title">Event Details</div>

            <div class="ed-info-row">
                <div class="ed-info-label">Type</div>
                <div class="ed-info-value">@System.Text.RegularExpressions.Regex.Replace(Model.EventType.ToString(), "([a-z])([A-Z])", "$1 $2")</div>
            </div>
            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <div class="ed-info-row">
                    <div class="ed-info-label">About</div>
                    <div class="ed-info-value">@Model.Description</div>
                </div>
            }
            <div class="ed-info-row">
                <div class="ed-info-label">Invited</div>
                <div class="ed-info-value">
                    @if (Model.InviteStudents)
                    {
                        <div>Students — @audience(Model.InviteStudentResidenceIds, "all registered students")
                            <span style="color:#6b7280;">(@invited.Students invited, @invited.StudentsWithLogin with a login)</span></div>
                    }
                    @if (Model.InviteParents)
                    {
                        <div>Parents — @audience(Model.InviteParentResidenceIds, "all parents")
                            <span style="color:#6b7280;">(@invited.Parents invited, @invited.ParentsWithLogin with a login)</span></div>
                    }
                    @if (Model.InviteStaff)
                    {
                        <div>All staff <span style="color:#6b7280;">(@invited.StaffWithLogin with a login)</span></div>
                    }
                    @if (invited.CanBeNotified == 0)
                    {
                        <div class="ed-warning" style="margin-top:.5rem;">
                            ⚠ Nobody invited can be notified or RSVP with a login.
                            @if ((Model.InviteStudents && !string.IsNullOrEmpty(Model.InviteStudentResidenceIds)) || (Model.InviteParents && !string.IsNullOrEmpty(Model.InviteParentResidenceIds)))
                            {
                                <text>No students are allocated to the houses chosen — check Residence Allocations, or invite all students / parents.</text>
                            }
                        </div>
                    }
                </div>
            </div>
            <div class="ed-info-row">
                <div class="ed-info-label">Meals</div>
                <div class="ed-info-value">
                    @(Model.OffersMealChoice ? "Attendees choose a meal when they RSVP" : "Self-service buffet")
                    @if (Model.AllowGuests)
                    {
                        <text> · parents and staff may bring up to @Model.MaxGuestsPerInvitee guest@(Model.MaxGuestsPerInvitee == 1 ? "" : "s")</text>
                    }
                </div>
            </div>
            <div class="ed-info-row">
                <div class="ed-info-label">RSVP</div>
                <div class="ed-info-value">
                    @if (Model.RsvpOpenedAt.HasValue)
                    {
                        <text>Opened @SchoolClock.FromUtc(Model.RsvpOpenedAt.Value).ToString("ddd dd MMM yyyy 'at' HH:mm")</text>
                    }
                    else if (Model.RsvpOpensAt.HasValue)
                    {
                        <text>Opens @Model.RsvpOpensAt.Value.ToString("ddd dd MMM yyyy 'at' HH:mm")</text>
                    }
                    else
                    {
                        <text>No opening time set</text>
                    }
                    @if (Model.RsvpDeadline.HasValue)
                    {
                        <text> · deadline @Model.RsvpDeadline.Value.ToString("ddd dd MMM yyyy")</text>
                    }
                </div>
            </div>
            <div class="ed-info-row">
                <div class="ed-info-label">Expected</div>
                <div class="ed-info-value">
                    ~@Model.ExpectedHeadcount guests
                    @if (Model.GuaranteedHeadcount.HasValue)
                    {
                        <span style="color:#065f46;"> · confirmed @Model.GuaranteedHeadcount</span>
                    }
                </div>
            </div>
            @if (Model.MenuTemplate != null)
            {
                <div class="ed-info-row">
                    <div class="ed-info-label">Menu</div>
                    <div class="ed-info-value">@Model.MenuTemplate.Name</div>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(Model.SpecialInstructions))
            {
                <div class="ed-info-row">
                    <div class="ed-info-label">Special</div>
                    <div class="ed-info-value">@Model.SpecialInstructions</div>
                </div>
            }
        </div>

        <!-- NOT OPEN / SCHEDULED → Open RSVPs now -->
        @if (isConfirmed)
        {
            <div class="ed-card" style="border-color:#bfdbfe; background:#eff6ff;">
                <div class="ed-card-title">
                    @(rsvpStatus.State == RsvpState.ScheduledToOpen ? "RSVPs — Scheduled to Open" : "RSVPs — Not Open")
                </div>
                <p style="font-size:.88rem; color:#1e40af; margin-bottom:.85rem;">
                    @if (rsvpStatus.State == RsvpState.ScheduledToOpen)
                    {
                        <text>RSVPs will open automatically on <strong>@Model.RsvpOpensAt.Value.ToString("dddd dd MMMM 'at' HH:mm")</strong>
                        and invitations will be sent then. You can open them earlier here.</text>
                    }
                    else
                    {
                        <text>No opening time is set. Open RSVPs when you're ready, or edit the event to schedule the opening.</text>
                    }
                </p>

                <form action="@Url.Action("OpenRsvp", "Event", new { id = Model.Id })" method="post"
                      class="d-flex gap-2 align-items-end flex-wrap"
                      onsubmit="return confirm('Open RSVPs now and send the invitations?');">
                    @Html.AntiForgeryToken()
                    <div>
                        <label style="font-size:.75rem; font-weight:600; display:block; margin-bottom:.35rem;">
                            RSVP Deadline
                        </label>
                        <input type="date" name="rsvpDeadline"
                               value="@(Model.RsvpDeadline.HasValue ? Model.RsvpDeadline.Value.ToString("yyyy-MM-dd") : "")"
                               min="@SchoolClock.Today.ToString("yyyy-MM-dd")"
                               max="@Model.EventDate.ToString("yyyy-MM-dd")"
                               class="form-control form-control-sm" />
                    </div>
                    <button type="submit" class="btn btn-primary">
                        Open RSVPs now
                    </button>
                </form>
            </div>
        }

        <!-- RsvpOpen → Public link card -->
        @if (isRsvpOpen)
        {
            <div class="ed-card" style="border-color:#fde68a; background:#fffbeb;">
                <div class="ed-card-title">Public RSVP Link</div>
                <p style="font-size:.85rem; color:#78350f; margin-bottom:.5rem;">
                    Share this link with parents, staff, or the invited group.
                    They don't need to log in.
                </p>
                <div class="ed-link-box">@rsvpLink</div>

                <button type="button" class="btn btn-sm btn-outline-warning mt-2" onclick="copyInvite(this)">
                    📋 Copy invitation text
                </button>

                @if (Model.RsvpDeadline.HasValue)
                {
                    <div style="font-size:.8rem; color:#78350f; margin-top:.5rem;">
                        Deadline: <strong>@Model.RsvpDeadline.Value.ToString("dddd, dd MMM yyyy")</strong>
                        @if (rsvpStatus != null && !rsvpStatus.AcceptingResponses)
                        {
                            <text> — passed; the form no longer takes responses. Close RSVPs to confirm the headcount.</text>
                        }
                    </div>
                }
                @if (Model.InviteStudents)
                {
                    <div style="font-size:.8rem; color:#78350f; margin-top:.5rem;">
                        Students respond by logging in and opening the link — their dietary needs come from their profile.
                    </div>
                }
            </div>
        }

        <!-- RsvpOpen → Live dashboard card -->
        @if (isRsvpOpen)
        {
            <div class="ed-card">
                <div class="ed-card-title">Live RSVP Dashboard</div>

                <div class="ed-stats" style="margin-bottom:1rem;">
                    <div class="ed-stat">
                        <div class="ed-stat-label">Accepted</div>
                        <div class="ed-stat-value">@attending.Count</div>
                    </div>
                    <div class="ed-stat">
                        <div class="ed-stat-label">Total Attendees</div>
                        <div class="ed-stat-value green">@attendance.Total</div>
                    </div>
                    <div class="ed-stat">
                        <div class="ed-stat-label">Declined</div>
                        <div class="ed-stat-value">@declined.Count</div>
                    </div>
                    <div class="ed-stat">
                        <div class="ed-stat-label">Maybe</div>
                        <div class="ed-stat-value amber">@maybe.Count</div>
                    </div>
                </div>

                @AttendanceStats(attendance)

                @if (Model.OffersMealChoice && requirements.Meals.Count > 0)
                {
                    <div style="margin-top:1rem;">
                        <div class="ed-card-title" style="margin-bottom:.5rem;">Meals chosen so far</div>
                        <div class="ed-diet-list">
                            @foreach (var m in requirements.Meals)
                            {
                                <div>
                                    <span class="who">@m.MenuItem.Name:</span> @m.Selected
                                    @if (m.Selected > 0)
                                    {
                                        <span style="color:#6b7280;">(@m.TypeSummary)</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (dietaryNotes.Count > 0)
                {
                    <div style="margin-top:1rem;">
                        <div class="ed-card-title" style="margin-bottom:.5rem;">Dietary Notes</div>
                        <div class="ed-diet-list">
                            @foreach (var note in dietaryNotes)
                            {
                                <div>
                                    <span class="who">@note.ResponderName:</span>
                                    @note.DietaryNotes
                                </div>
                            }
                        </div>
                    </div>
                }

                <div class="ed-btn-row">
                    <form action="@Url.Action("CloseRsvp", "Event", new { id = Model.Id })" method="post"
                          onsubmit="return confirm('Close RSVPs now, fix the headcount at @attendance.Total and send the plan to the kitchen?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-warning">
                            Close RSVPs &amp; send to kitchen (@attendance.Total attending)
                        </button>
                    </form>
                </div>
            </div>
        }

        <!-- RsvpOpen → Guest list card -->
        @if (isRsvpOpen && attending.Count > 0)
        {
            <div class="ed-card">
                <div class="ed-card-title">Guest List (@attending.Count responses)</div>
                <table class="ed-rsvp-table">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Type</th>
                            <th style="text-align:right;">Party</th>
                            <th>Meal</th>
                            <th>Dietary</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in attending.OrderBy(x => x.ResponderName))
                        {
                            <tr>
                                <td><strong>@r.ResponderName</strong></td>
                                <td style="color:#6b7280;">@r.ResponderGroup@(r.RespondedByUserId.HasValue ? "" : " (public form)")</td>
                                <td style="text-align:right;">@r.TotalAttendees</td>
                                <td>@(r.MenuItemId.HasValue && mealNames.ContainsKey(r.MenuItemId.Value) ? mealNames[r.MenuItemId.Value] : "—")@(r.GuestCount > 0 ? " + " + r.GuestCount + " guest meal" + (r.GuestCount == 1 ? "" : "s") : "")</td>
                                <td style="color:#6b7280; font-size:.8rem;">
                                    @(r.ResponderGroup == "Student" ? "From student profile" : string.Join("; ", new[] { r.DietaryPreference != null && r.DietaryPreference != "None" ? r.DietaryPreference : null, r.Allergies, r.DietaryNotes }.Where(x => !string.IsNullOrWhiteSpace(x))))
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <!-- RsvpClosed → frozen state -->
        @if (isRsvpClosed)
        {
            <div class="ed-card" style="border-color:#c7d2fe; background:#eef2ff;">
                <div class="ed-card-title">RSVPs Closed</div>
                @AttendanceStats(attendance)
                <div style="margin-top:1rem;">
                    <a href="@Url.Action("FeastPlan", "Event", new { id = Model.Id })"
                       class="btn btn-primary">
                        🍽 Generate Feast Plan
                    </a>
                </div>
            </div>
        }

        <!-- FeastPlanGenerated → link back to plan -->
        @if (isFeastPlanReady)
        {
            <div class="ed-card" style="border-color:#bbf7d0; background:#f0fdf4;">
                <div class="ed-card-title">RSVPs Closed — Kitchen Plan Sent</div>
                <p style="font-size:.85rem; color:#065f46; margin-bottom:.75rem;">
                    The kitchen has the plan, built from the accepted RSVPs@(Model.RsvpClosedAt.HasValue ? " on " + SchoolClock.FromUtc(Model.RsvpClosedAt.Value).ToString("dd MMM 'at' HH:mm") : "").
                </p>
                @AttendanceStats(attendance)
                <div style="margin-top:1rem;">
                    <a href="@Url.Action("FeastPlan", "Event", new { id = Model.Id })"
                       class="btn btn-success">
                        🍽 View Kitchen Plan
                    </a>
                </div>
            </div>
        }

        <!-- BUFFET MEALS + DIETARY COVERAGE -->
        <div class="ed-card">
            <div class="ed-card-title">Buffet &amp; Dietary Coverage</div>

            @if (usesTemplateMenu)
            {
                <div class="ed-sub">Using the meals from the <strong>@(Model.MenuTemplate != null ? Model.MenuTemplate.Name : "menu")</strong> template. Edit the event to choose buffet meals.</div>
            }

            @if (coverage.Meals.Count > 0)
            {
                <div class="ed-table-wrap">
                    <table class="ed-rsvp-table" style="margin-bottom:1rem;">
                        <thead>
                            <tr>
                                <th>Buffet meal</th>
                                <th>Suits</th>
                                <th>Allergens</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var meal in coverage.Meals)
                            {
                                <tr>
                                    <td>
                                        <strong>@meal.Name</strong>
                                        @if (!meal.IsActive)
                                        {
                                            <span class="ed-none"> (inactive)</span>
                                        }
                                    </td>
                                    <td>
                                        @foreach (var tag in meal.SuitableFor)
                                        {
                                            <span class="ed-tag">@tag</span>
                                        }
                                    </td>
                                    <td style="color:#6b7280; font-size:.8rem;">@(string.IsNullOrEmpty(meal.Allergens) ? "—" : meal.Allergens)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <div class="ed-sub">
                Checked against: <strong>@coverage.Basis</strong>@(coverage.StudentCount > 0 ? " (" + coverage.StudentCount + " " + (coverage.Noun ?? "student") + (coverage.StudentCount == 1 ? "" : "s") + ")" : "")
            </div>

            @if (coverage.Warnings.Count == 0)
            {
                <div class="ed-ok">✓ Every dietary group has at least one suitable buffet meal.</div>
            }
            @foreach (var w in coverage.Warnings)
            {
                <div class="ed-warning">⚠ @w</div>
            }

            @if (coverage.Groups.Count > 0)
            {
                <div class="ed-table-wrap">
                    <table class="ed-rsvp-table" style="margin-top:.75rem;">
                        <thead>
                            <tr>
                                <th>Dietary group</th>
                                <th style="text-align:right;">Students</th>
                                <th>Suitable buffet meals</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var g in coverage.Groups)
                            {
                                <tr>
                                    <td>@g.Label</td>
                                    <td style="text-align:right;">@g.StudentCount</td>
                                    @if (g.IsCovered)
                                    {
                                        <td>@string.Join(", ", g.SuitableMeals)</td>
                                    }
                                    else
                                    {
                                        <td class="ed-none">None</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (coverage.AttendingStudentCount > 0)
            {
                <div class="ed-card-title" style="margin-top:1.25rem;">Accepted so far — students, parents, staff and guests (@coverage.AttendingStudentCount)</div>
                <div class="ed-diet-list">
                    @foreach (var g in coverage.AttendingGroups)
                    {
                        <div>
                            <span class="who">@g.Label:</span> @g.StudentCount
                            @if (!g.IsCovered)
                            {
                                <span class="ed-none"> — no suitable meal</span>
                            }
                        </div>
                    }
                </div>
            }

            @if (coverage.GuestAttendees > 0)
            {
                <div class="ed-sub" style="margin-top:1rem;">
                    Parents, staff and guests attending: <strong>@coverage.GuestAttendees</strong>
                    (@coverage.GuestVegetarian vegetarian / vegan, @coverage.GuestOtherDiets with other requirements — see their dietary notes).
                </div>
            }
        </div>

        <div style="margin-top:1.5rem;">
            <a href="@Url.Action("Index", "Event")" class="btn btn-outline-secondary">
                ← Back to Events
            </a>
        </div>

    </div>
</div>

<script>
    function copyInvite(btn) {
        var text = @Html.Raw(System.Web.Helpers.Json.Encode(inviteText));

        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(text).then(function () {
                var orig = btn.innerHTML;
                btn.innerHTML = "✓ Copied to clipboard";
                setTimeout(function () { btn.innerHTML = orig; }, 2000);
            });
        } else {
            var ta = document.createElement("textarea");
            ta.value = text;
            ta.style.position = "fixed";
            ta.style.opacity = "0";
            document.body.appendChild(ta);
            ta.select();
            try { document.execCommand("copy"); } catch (e) { }
            document.body.removeChild(ta);
            var orig = btn.innerHTML;
            btn.innerHTML = "✓ Copied to clipboard";
            setTimeout(function () { btn.innerHTML = orig; }, 2000);
        }
    }
</script>

@helper AttendanceStats(EventAttendance a)
{
    <div class="ed-stats" style="grid-template-columns: repeat(5, 1fr); margin-top:.75rem;">
        <div class="ed-stat">
            <div class="ed-stat-label">Students</div>
            <div class="ed-stat-value">@a.Students</div>
        </div>
        <div class="ed-stat">
            <div class="ed-stat-label">Parents</div>
            <div class="ed-stat-value">@a.Parents</div>
        </div>
        <div class="ed-stat">
            <div class="ed-stat-label">Staff</div>
            <div class="ed-stat-value">@a.Staff</div>
        </div>
        <div class="ed-stat">
            <div class="ed-stat-label">Guests</div>
            <div class="ed-stat-value">@a.Guests</div>
        </div>
        <div class="ed-stat">
            <div class="ed-stat-label">Total</div>
            <div class="ed-stat-value green">@a.Total</div>
        </div>
    </div>
}

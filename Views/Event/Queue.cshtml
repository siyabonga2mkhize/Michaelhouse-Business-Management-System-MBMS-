@using Michaelhouse.Models.Cafeteria
@model List<CafeteriaEvent>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Kitchen Queue";

    // Event id -> approved UC19 feast plan id; events already issued
    var approvedPlans = ViewBag.ApprovedPlans as Dictionary<int, int> ?? new Dictionary<int, int>();
    var issuedIds = ViewBag.IssuedEventIds as List<int> ?? new List<int>();
    bool canOpenEvent = User.IsInRole("CafeteriaManager") || User.IsInRole("Admin");
}

<div class="flex flex-col h-full w-full overflow-hidden bg-gray-50/30">

    @* --- HEADER --- *@
    <div class="mb-6 border-b border-gray-200 pb-6 flex-shrink-0 px-8 pt-8 bg-white shadow-sm relative z-10">
        <div class="flex items-center gap-2 mb-3">
            <div class="h-[2px] w-8 bg-[#C21E2E]"></div>
            <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Hospitality &amp; Catering</h5>
        </div>
        <h2 class="text-5xl font-serif font-bold text-gray-900 tracking-tight mb-0">Kitchen Queue</h2>
        <p class="text-[11px] font-mono text-gray-500 uppercase tracking-widest mt-2 mb-0">
            Upcoming events whose RSVPs have closed: what to cook and which ingredients to issue.
        </p>
    </div>

    <div class="flex-grow min-h-0 overflow-y-auto custom-scrollbar px-8 pb-16 pt-2 flex flex-col gap-8">

        @if (TempData["Success"] != null)
        {
            <div class="bg-green-50 border-l-4 border-green-500 p-4 text-green-700 shadow-sm flex items-center">
                <i class="bi bi-check-circle-fill me-3 text-xl"></i>
                <span class="text-xs font-bold uppercase tracking-widest">@TempData["Success"]</span>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="bg-red-50 border-l-4 border-red-500 p-4 text-red-700 shadow-sm flex items-center">
                <i class="bi bi-exclamation-triangle-fill me-3 text-xl"></i>
                <span class="text-xs font-bold uppercase tracking-widest">@TempData["Error"]</span>
            </div>
        }

        @* --- COUNTS --- *@
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-white border border-gray-200 shadow-sm p-6">
                <h6 class="text-[9px] uppercase tracking-[3px] font-bold text-gray-400 mb-2">Events in the queue</h6>
                <h3 class="font-serif text-4xl font-bold text-gray-900 mb-0">@Model.Count</h3>
            </div>
            <div class="bg-white border border-gray-200 shadow-sm p-6">
                <h6 class="text-[9px] uppercase tracking-[3px] font-bold text-gray-400 mb-2">With an approved feast plan</h6>
                <h3 class="font-serif text-4xl font-bold text-gray-900 mb-0">@Model.Count(e => approvedPlans.ContainsKey(e.Id))</h3>
            </div>
            <div class="bg-white border border-gray-200 shadow-sm p-6">
                <h6 class="text-[9px] uppercase tracking-[3px] font-bold text-gray-400 mb-2">Ingredients still to issue</h6>
                <h3 class="font-serif text-4xl font-bold text-[#C21E2E] mb-0">@Model.Count(e => !issuedIds.Contains(e.Id))</h3>
            </div>
        </div>

        @* --- QUEUE --- *@
        <div class="bg-white border border-gray-200 shadow-sm">
            @if (Model.Count == 0)
            {
                <div class="p-10 text-center">
                    <i class="bi bi-inbox text-4xl text-gray-300"></i>
                    <p class="font-serif text-xl text-gray-700 mt-3 mb-1">Nothing in the queue</p>
                    <p class="text-sm text-gray-500 mb-0">An event appears here once its RSVPs have closed and it hands its kitchen plan over.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="bg-white border-b-2 border-gray-100">
                            <tr class="text-[9px] uppercase tracking-[2px] text-gray-500">
                                <th class="ps-6 py-4" style="width:170px;">Date &amp; Time</th>
                                <th>Event</th>
                                <th>Venue</th>
                                <th class="text-center">Guests</th>
                                <th>Dishes and portions from</th>
                                <th>Ingredients</th>
                                <th class="pe-6 text-end">Kitchen</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var evt in Model)
                            {
                                bool hasPlan = approvedPlans.ContainsKey(evt.Id);
                                bool issued = issuedIds.Contains(evt.Id);
                                <tr>
                                    <td class="ps-6 py-4">
                                        <div class="font-mono text-xs text-gray-900">@evt.EventDate.ToString("ddd dd MMM yyyy")</div>
                                        <div class="font-mono text-[11px] text-gray-500">@evt.StartTime.ToString(@"hh\:mm") &ndash; @evt.EndTime.ToString(@"hh\:mm")</div>
                                    </td>
                                    <td>
                                        <div class="font-serif font-bold text-gray-900">@evt.EventName</div>
                                        @if (evt.Status == EventStatus.InProgress)
                                        {
                                            <span class="text-[9px] uppercase tracking-[2px] font-bold text-amber-700">In progress</span>
                                        }
                                    </td>
                                    <td class="text-sm text-gray-600">@(evt.Venue != null ? evt.Venue.Name : "")</td>
                                    <td class="text-center font-mono">@(evt.GuaranteedHeadcount ?? evt.ExpectedHeadcount)</td>
                                    <td>
                                        @if (hasPlan)
                                        {
                                            <span class="badge bg-success">Approved feast plan</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border">RSVP estimate</span>
                                        }
                                    </td>
                                    <td>
                                        @if (issued)
                                        {
                                            <span class="text-green-700 text-sm"><i class="bi bi-check-circle-fill me-1"></i>Issued</span>
                                        }
                                        else
                                        {
                                            <span class="text-gray-500 text-sm">Not issued yet</span>
                                        }
                                    </td>
                                    <td class="pe-6 text-end" style="white-space:nowrap;">
                                        <a href="@Url.Action("FeastPlan", "Event", new { id = evt.Id })" class="btn btn-sm btn-dark">Kitchen plan</a>
                                        @if (!issued)
                                        {
                                            <a href="@Url.Action("IssueIngredients", "Event", new { id = evt.Id })" class="btn btn-sm btn-outline-dark">Issue ingredients</a>
                                        }
                                        @if (canOpenEvent)
                                        {
                                            <a href="@Url.Action("Details", "Event", new { id = evt.Id })" class="btn btn-sm btn-link">Event</a>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

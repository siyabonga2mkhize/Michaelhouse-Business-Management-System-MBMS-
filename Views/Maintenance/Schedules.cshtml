@model List<Michaelhouse.Models.PreventiveSchedule>
@{
    ViewBag.Title = "Preventive Schedules";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* --- FULL SCREEN VIEWPORT CONTAINER --- *@
<div class="flex flex-col h-full w-full overflow-hidden bg-gray-50/30">

    @* --- INSTITUTIONAL HEADER --- *@
    <div class="mb-6 d-flex justify-content-between align-items-end border-b border-gray-200 pb-6 flex-shrink-0 px-8 pt-8 bg-white shadow-sm relative z-10">
        <div>
            <div class="flex items-center gap-2 mb-3">
                <div class="h-[2px] w-8 bg-[#C21E2E]"></div>
                <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Maintenance</h5>
            </div>
            <h2 class="text-5xl font-serif font-bold text-gray-900 tracking-tight">Preventive Schedules</h2>
            <p class="text-[11px] font-mono text-gray-400 uppercase tracking-widest mt-2 mb-0">Recurring maintenance tasks</p>
        </div>
        <div class="flex gap-3 items-center">
            <form method="post" action="@Url.Action("RunScheduledJobs", "Maintenance")" class="m-0" onsubmit="return confirm('Run all due jobs now?')">
                @Html.AntiForgeryToken()
                <button type="submit" class="inline-flex items-center justify-center bg-yellow-500 text-yellow-900 px-6 py-3 text-[10px] font-bold uppercase tracking-[2px] hover:bg-yellow-400 transition-all duration-300 shadow-sm">
                    <i class="bi bi-play-circle me-2 text-sm align-middle"></i> Run Due Jobs Now
                </button>
            </form>
            <a href="@Url.Action("AddSchedule", "Maintenance")" class="inline-flex items-center justify-center bg-[#C21E2E] text-white px-8 py-3 text-[10px] font-bold uppercase tracking-[3px] hover:bg-red-700 hover:shadow-[0_0_15px_rgba(194,30,46,0.4)] transition-all duration-300">
                <i class="bi bi-plus-square me-2 text-sm align-middle"></i> Add Schedule
            </a>
        </div>
    </div>

    @* --- SCROLLABLE DATA SECTION --- *@
    <div class="flex-grow min-h-0 overflow-y-auto custom-scrollbar px-8 pb-10 pt-4 flex flex-col gap-6">

        @* --- STATS ROW --- *@
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
            <div class="bg-white border border-gray-200 shadow-sm p-6 relative overflow-hidden group hover:border-gray-400 transition-colors duration-300">
                <i class="bi bi-calendar3 absolute -right-4 -bottom-4 text-7xl text-gray-50 opacity-50 group-hover:scale-110 transition-transform"></i>
                <div class="relative z-10">
                    <h6 class="text-[9px] uppercase tracking-[3px] font-bold text-gray-400 mb-2">Active Schedules</h6>
                    <h3 class="font-mono text-4xl font-bold text-gray-900 mb-0">@ViewBag.TotalSchedules</h3>
                </div>
            </div>
            <div class="bg-white border border-gray-200 shadow-sm p-6 relative overflow-hidden group border-b-4 border-b-yellow-500 hover:border-gray-400 transition-colors duration-300">
                <i class="bi bi-clock absolute -right-4 -bottom-4 text-7xl text-yellow-50 opacity-50 group-hover:scale-110 transition-transform"></i>
                <div class="relative z-10">
                    <h6 class="text-[9px] uppercase tracking-[3px] font-bold text-yellow-700 mb-2">Due Within 7 Days</h6>
                    <h3 class="font-mono text-4xl font-bold text-yellow-600 mb-0">@ViewBag.DueSoon</h3>
                </div>
            </div>
            <div class="bg-white border border-gray-200 shadow-sm p-6 relative overflow-hidden group border-b-4 border-b-[#C21E2E] hover:border-gray-400 transition-colors duration-300">
                <i class="bi bi-exclamation-triangle absolute -right-4 -bottom-4 text-7xl text-red-50 opacity-50 group-hover:scale-110 transition-transform"></i>
                <div class="relative z-10">
                    <h6 class="text-[9px] uppercase tracking-[3px] font-bold text-[#C21E2E] mb-2">Overdue</h6>
                    <h3 class="font-mono text-4xl font-bold text-[#C21E2E] mb-0">@ViewBag.Overdue</h3>
                </div>
            </div>
            <div class="bg-white border border-gray-200 shadow-sm p-6 relative overflow-hidden group border-b-4 border-b-gray-400 hover:border-gray-400 transition-colors duration-300">
                <i class="bi bi-pause-circle absolute -right-4 -bottom-4 text-7xl text-gray-50 opacity-50 group-hover:scale-110 transition-transform"></i>
                <div class="relative z-10">
                    <h6 class="text-[9px] uppercase tracking-[3px] font-bold text-gray-500 mb-2">Paused</h6>
                    <h3 class="font-mono text-4xl font-bold text-gray-700 mb-0">@ViewBag.Paused</h3>
                </div>
            </div>
        </div>

        @* --- SCHEDULES TABLE --- *@
        <div class="bg-white shadow-sm border border-gray-100 flex flex-col flex-grow min-h-0 relative overflow-hidden group">

            @* Ghost Watermark *@
            <i class="bi bi-calendar-check absolute -right-12 -bottom-12 text-9xl text-black opacity-[0.02] transition-transform duration-1000 group-hover:-rotate-12 group-hover:scale-[1.2] pointer-events-none z-0"></i>

            @* Table Header *@
            <div class="p-6 border-b border-gray-100 bg-gray-50/50 flex justify-between items-center relative z-10 flex-shrink-0">
                <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-900 mb-0"><i class="bi bi-calendar3 me-2 text-gray-400"></i> All Schedules</h5>
                <span class="text-[10px] font-mono text-gray-500 uppercase tracking-widest">@Model.Count schedule(s)</span>
            </div>

            @* Table Container *@
            <div class="table-responsive flex-grow overflow-y-auto custom-scrollbar relative z-10">
                @if (Model.Any())
                {
                    <table class="table table-hover mb-0 align-middle w-full">
                        <thead class="sticky top-0 z-20 bg-white shadow-sm">
                            <tr class="text-[9px] uppercase tracking-[4px] font-bold text-gray-400 border-b border-gray-200 bg-gray-50/80">
                                <th class="ps-6 py-4 w-12 text-center">Status</th>
                                <th class="border-l border-gray-100 ps-4">Schedule Name</th>
                                <th class="border-l border-gray-100 ps-4">Asset</th>
                                <th class="border-l border-gray-100 ps-4">Frequency</th>
                                <th class="border-l border-gray-100 ps-4">Skill</th>
                                <th class="border-l border-gray-100 ps-4">Next Due</th>
                                <th class="border-l border-gray-100 ps-4">Last Done</th>
                                <th class="border-l border-gray-100 ps-4">State</th>
                                <th class="pe-6 border-l border-gray-100 text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody class="text-gray-700">
                            @foreach (var s in Model)
                            {
                                string complianceColor = s.ComplianceStatus == "Green" ? "text-[#10b981]" :
                                                         s.ComplianceStatus == "Yellow" ? "text-yellow-500" :
                                                         "text-[#C21E2E]";

                                string stateColor = s.Status == "Active" ? "bg-green-50 text-green-700 border-green-200" :
                                                    s.Status == "Paused" ? "bg-yellow-50 text-yellow-700 border-yellow-200" :
                                                    "bg-gray-50 text-gray-600 border-gray-200";

                                <tr class="hover:bg-gray-50/80 transition-all duration-300 border-b border-gray-50 last:border-0 group/row">
                                    <td class="ps-6 py-4 text-center">
                                        <i class="bi bi-circle-fill @complianceColor text-[10px] shadow-sm rounded-full"></i>
                                    </td>

                                    <td class="border-l border-gray-50 ps-4">
                                        <strong class="font-serif text-sm text-gray-900 group-hover/row:text-[#C21E2E] transition-colors">@s.ScheduleName</strong>
                                    </td>

                                    <td class="border-l border-gray-50 ps-4">
                                        <span class="font-serif text-xs text-gray-700">@(s.Asset != null ? s.Asset.AssetName : "—")</span>
                                    </td>

                                    <td class="border-l border-gray-50 ps-4">
                                        <span class="inline-flex items-center text-[9px] font-bold uppercase tracking-widest bg-gray-100 text-gray-700 px-2 py-1 border shadow-sm">
                                            @s.Frequency
                                        </span>
                                    </td>

                                    <td class="border-l border-gray-50 ps-4">
                                        <span class="inline-flex items-center text-[9px] font-bold uppercase tracking-widest bg-gray-100 text-gray-700 px-2 py-1 border shadow-sm">
                                            @s.SkillRequired
                                        </span>
                                    </td>

                                    <td class="border-l border-gray-50 ps-4">
                                        <span class="font-mono text-xs font-bold text-gray-900">@s.NextDueDate.ToString("dd MMM yyyy")</span>
                                    </td>

                                    <td class="border-l border-gray-50 ps-4">
                                        <span class="font-mono text-xs text-gray-500">@(s.LastCompletedDate.HasValue ? s.LastCompletedDate.Value.ToString("dd MMM yyyy") : "Never")</span>
                                    </td>

                                    <td class="border-l border-gray-50 ps-4">
                                        <span class="inline-flex items-center text-[8px] font-bold uppercase tracking-widest px-2 py-1 border shadow-sm @stateColor">
                                            @s.Status
                                        </span>
                                    </td>

                                    <td class="pe-6 border-l border-gray-50 text-end">
                                        <div class="flex justify-end gap-1">
                                            @if (s.Status == "Active")
                                            {
                                                <form method="post" action="@Url.Action("PauseSchedule", "Maintenance", new { id = s.Id })" class="m-0 p-0 inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="inline-flex items-center justify-center w-8 h-8 bg-white border border-gray-300 text-gray-500 hover:border-yellow-600 hover:text-yellow-600 hover:bg-yellow-50 transition-colors shadow-sm" title="Pause">
                                                        <i class="bi bi-pause text-xs"></i>
                                                    </button>
                                                </form>
                                            }
                                            else if (s.Status == "Paused")
                                            {
                                                <form method="post" action="@Url.Action("ResumeSchedule", "Maintenance", new { id = s.Id })" class="m-0 p-0 inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="inline-flex items-center justify-center w-8 h-8 bg-white border border-gray-300 text-green-600 hover:border-green-600 hover:bg-green-50 transition-colors shadow-sm" title="Resume">
                                                        <i class="bi bi-play-fill text-xs"></i>
                                                    </button>
                                                </form>
                                            }

                                            @if (s.Status != "Cancelled")
                                            {
                                                <form method="post" action="@Url.Action("CancelSchedule", "Maintenance", new { id = s.Id })" onsubmit="return confirm('Cancel this schedule?')" class="m-0 p-0 inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="inline-flex items-center justify-center w-8 h-8 bg-white border border-gray-300 text-[#C21E2E] hover:border-[#C21E2E] hover:bg-red-50 transition-colors shadow-sm" title="Cancel">
                                                        <i class="bi bi-x-lg text-xs"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="text-center py-16 text-muted">
                        <i class="bi bi-calendar3 text-gray-200 text-6xl d-block mb-4"></i>
                        <h4 class="text-serif font-bold text-gray-400 uppercase tracking-[3px] mb-2">No schedules set up yet</h4>
                        <a href="@Url.Action("AddSchedule", "Maintenance")" class="inline-block mt-3 bg-[#1a1a1a] text-white px-6 py-2 text-[9px] font-bold uppercase tracking-[2px] hover:bg-gray-800 transition-all">
                            Add First Schedule
                        </a>
                    </div>
                }
            </div>

            @* Footer *@
            <div class="p-4 bg-[#1a1a1a] border-t border-gray-800 flex justify-between items-center flex-shrink-0 relative z-10">
                <div class="text-[9px] uppercase tracking-[2px] font-bold text-gray-400 font-mono">
                    <i class="bi bi-shield-lock me-2 text-gray-500"></i> Automated Logistics Ledger
                </div>
            </div>
        </div>

    </div>
</div>

<style>
    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }

    .font-mono {
        font-family: 'Source Code Pro', monospace !important;
    }

    .table thead th {
        border-bottom: 2px solid #f8f9fa !important;
    }

    .table tbody tr {
        transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    .custom-scrollbar::-webkit-scrollbar {
        width: 5px;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #eee;
        border-radius: 10px;
    }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #C21E2E;
        }
</style>
@model List<Michaelhouse.Models.PreventiveSchedule>
@{
    ViewBag.Title = "Preventive Schedules";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="mb-10 d-flex justify-content-between align-items-end border-b border-gray-100 pb-8">
    <div>
        <div class="flex items-center gap-2 mb-3">
            <div class="h-1 w-8 bg-[#C21E2E]"></div>
            <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Maintenance</h5>
        </div>
        <h2 class="text-4xl font-serif font-bold text-gray-900 tracking-tight">Preventive Schedules</h2>
        <p class="text-gray-400 text-[10px] uppercase tracking-widest font-bold mt-2">Recurring maintenance tasks</p>
    </div>
    <div>
        <form method="post" action="@Url.Action("RunScheduledJobs", "Maintenance")" style="display:inline" onsubmit="return confirm('Run all due jobs now?')">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-warning me-2">Run Due Jobs Now</button>
        </form>
        <a href="@Url.Action("AddSchedule", "Maintenance")" class="btn btn-dark">+ Add Schedule</a>
    </div>
</div>

<!-- Stats -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h6 class="text-muted small text-uppercase fw-bold">Active Schedules</h6>
                <h3 class="fw-bold">@ViewBag.TotalSchedules</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h6 class="text-muted small text-uppercase fw-bold">Due Within 7 Days</h6>
                <h3 class="fw-bold text-warning">@ViewBag.DueSoon</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h6 class="text-muted small text-uppercase fw-bold">Overdue</h6>
                <h3 class="fw-bold text-danger">@ViewBag.Overdue</h3>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h6 class="text-muted small text-uppercase fw-bold">Paused</h6>
                <h3 class="fw-bold">@ViewBag.Paused</h3>
            </div>
        </div>
    </div>
</div>

<!-- Table -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-0">
        <h5 class="mb-0 fw-bold"><i class="bi bi-calendar3 me-2"></i>All Schedules</h5>
        <span class="text-muted small">@Model.Count schedule(s)</span>
    </div>
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Status</th>
                        <th>Schedule Name</th>
                        <th>Asset</th>
                        <th>Frequency</th>
                        <th>Skill</th>
                        <th>Next Due</th>
                        <th>Last Done</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td><span class="badge bg-@(s.ComplianceStatus=="Green"?"success":s.ComplianceStatus=="Yellow"?"warning":"danger") rounded-pill">●</span></td>
                            <td><strong>@s.ScheduleName</strong></td>
                            <td>@(s.Asset != null ? s.Asset.AssetName : "—")</td>
                            <td><span class="badge bg-secondary">@s.Frequency</span></td>
                            <td><span class="badge bg-secondary">@s.SkillRequired</span></td>
                            <td>@s.NextDueDate.ToString("dd MMM yyyy")</td>
                            <td>@(s.LastCompletedDate.HasValue ? s.LastCompletedDate.Value.ToString("dd MMM yyyy") : "Never")</td>
                            <td><span class="badge bg-@(s.Status=="Active"?"success":s.Status=="Paused"?"warning":"secondary")">@s.Status</span></td>
                            <td>
                                <div class="btn-group">
                                    @if (s.Status == "Active")
                                    {
                                        <form method="post" action="@Url.Action("PauseSchedule", "Maintenance", new { id = s.Id })" style="display:inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pause"></i></button>
                                        </form>
                                    }
                                    else if (s.Status == "Paused")
                                    {
                                        <form method="post" action="@Url.Action("ResumeSchedule", "Maintenance", new { id = s.Id })" style="display:inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-success"><i class="bi bi-play"></i></button>
                                        </form>
                                    }
                                    @if (s.Status != "Cancelled")
                                    {
                                        <form method="post" action="@Url.Action("CancelSchedule", "Maintenance", new { id = s.Id })" onsubmit="return confirm('Cancel this schedule?')" style="display:inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-x-lg"></i></button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-calendar3 fs-1 d-block mb-2"></i>
                <p>No schedules set up yet.</p>
                <a href="@Url.Action("AddSchedule", "Maintenance")" class="btn btn-primary btn-sm">Add First Schedule</a>
            </div>
        }
    </div>
</div>
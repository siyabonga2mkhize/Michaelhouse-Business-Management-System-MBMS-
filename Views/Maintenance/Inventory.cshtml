@model List<Michaelhouse.Models.MaintenanceInventory>
@{
    ViewBag.Title = "Inventory";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="mb-10 d-flex justify-content-between align-items-end border-b border-gray-100 pb-8">
    <div>
        <div class="flex items-center gap-2 mb-3">
            <div class="h-1 w-8 bg-[#C21E2E]"></div>
            <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Maintenance</h5>
        </div>
        <h2 class="text-4xl font-serif font-bold text-gray-900 tracking-tight">Inventory</h2>
        <p class="text-gray-400 text-[10px] uppercase tracking-widest font-bold mt-2">Parts and materials</p>
    </div>
    <a href="@Url.Action("AddInventory", "Maintenance")" class="btn btn-dark">+ Add Item</a>
</div>

<!-- Stats -->
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h6 class="text-muted small text-uppercase fw-bold">Total Items</h6>
                <h3 class="fw-bold">@ViewBag.TotalItems</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h6 class="text-muted small text-uppercase fw-bold">Low Stock Alerts</h6>
                <h3 class="fw-bold text-danger">@ViewBag.LowStock</h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h6 class="text-muted small text-uppercase fw-bold">Total Value</h6>
                <h3 class="fw-bold">R@(string.Format("{0:N0}", ViewBag.TotalValue))</h3>
            </div>
        </div>
    </div>
</div>

<!-- Filter -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" action="@Url.Action("Inventory", "Maintenance")" class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label small fw-bold text-uppercase text-muted">Search</label>
                <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Item name..." />
            </div>
            <div class="col-md-4">
                <label class="form-label small fw-bold text-uppercase text-muted">Category</label>
                <select name="category" class="form-select">
                    <option value="">All</option>
                    @foreach (var cat in new[] { "Plumbing", "Electrical", "HVAC", "Grounds", "Pool", "Safety", "General" })
                    {
                        <option value="@cat" @(ViewBag.Category == cat ? "selected" : "")>@cat</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-dark w-100">Filter</button>
            </div>
        </form>
    </div>
</div>

<!-- Table -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-0">
        <h5 class="mb-0 fw-bold"><i class="bi bi-boxes me-2"></i>Stock Items</h5>
        <span class="text-muted small">@Model.Count item(s)</span>
    </div>
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Item Name</th>
                        <th>Category</th>
                        <th>Stock Level</th>
                        <th>Min Stock</th>
                        <th>Unit Cost</th>
                        <th>Total Value</th>
                        <th>Supplier</th>
                        <th>Status</th>
                        <th>Restock</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        var isLow = item.StockLevel <= item.MinimumStock;
                        <tr class="@(isLow ? "table-danger" : "")">
                            <td><strong>@item.ItemName</strong> @if (isLow)
                            {<span class="text-danger" title="Low stock"><i class="bi bi-exclamation-circle"></i></span>}</td>
                            <td><span class="badge bg-secondary">@item.Category</span></td>
                            <td><span class="fw-bold @(isLow?"text-danger":"")">@item.StockLevel</span> @item.Unit</td>
                            <td>@item.MinimumStock @item.Unit</td>
                            <td>R@item.UnitCost.ToString("N2")</td>
                            <td>R@((item.StockLevel * item.UnitCost).ToString("N2"))</td>
                            <td>@item.Supplier</td>
                            <td><span class="badge bg-@(isLow?"danger":"success")">@(isLow?"Low":"OK")</span></td>
                            <td>
                                <div class="d-flex gap-1">
                                    <input type="number" id="qty_@item.Id" value="10" min="1" class="form-control form-control-sm" style="width:60px;" />
                                    <button onclick="restock(@item.Id)" class="btn btn-sm btn-success"><i class="bi bi-plus-lg"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-boxes fs-1 d-block mb-2"></i>
                <p>No inventory items found.</p>
                <a href="@Url.Action("AddInventory", "Maintenance")" class="btn btn-primary btn-sm">Add First Item</a>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function restock(id) {
            var qty = document.getElementById('qty_' + id).value;
            if (!qty || qty <= 0) { alert('Enter valid quantity.'); return; }
            fetch('@Url.Action("Restock", "Maintenance")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'id=' + id + '&quantity=' + qty
            }).then(r => r.json()).then(data => { if (data.success) location.reload(); });
        }
    </script>
}
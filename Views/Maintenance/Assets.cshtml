@model List<Michaelhouse.Models.Asset>
@{
    ViewBag.Title = "Asset Register";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* --- FULL SCREEN VIEWPORT CONTAINER --- *@
<div class="flex flex-col h-full w-full overflow-hidden bg-gray-50/30">

    @* --- INSTITUTIONAL HEADER --- *@
    <div class="mb-6 d-flex justify-content-between align-items-end border-b border-gray-200 pb-6 flex-shrink-0 px-8 pt-8 bg-white shadow-sm relative z-10">
        <div>
            <div class="flex items-center gap-2 mb-3">
                <div class="h-[2px] w-8 bg-[#C21E2E]"></div>
                <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Maintenance</h5>
            </div>
            <h2 class="text-5xl font-serif font-bold text-gray-900 tracking-tight">Asset Register</h2>
            <p class="text-[11px] font-mono text-gray-400 uppercase tracking-widest mt-2 mb-0">All physical assets campus-wide</p>
        </div>
        <div class="flex gap-3">
            <a href="@Url.Action("RegisterAsset", "Maintenance")" class="inline-flex items-center justify-center bg-[#C21E2E] text-white px-8 py-3 text-[10px] font-bold uppercase tracking-[3px] hover:bg-red-700 hover:shadow-[0_0_15px_rgba(194,30,46,0.4)] transition-all duration-300">
                <i class="bi bi-plus-square me-2 text-sm"></i> Register Asset
            </a>
        </div>
    </div>

    @* --- SCROLLABLE DATA SECTION --- *@
    <div class="flex-grow min-h-0 overflow-y-auto custom-scrollbar px-8 pb-10 pt-4 flex flex-col gap-6">

        @* --- STATS ROW --- *@
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div class="bg-white border border-gray-200 shadow-sm p-6 relative overflow-hidden group hover:border-gray-400 transition-colors duration-300">
                <i class="bi bi-qr-code absolute -right-4 -bottom-4 text-7xl text-gray-50 opacity-50 group-hover:scale-110 transition-transform"></i>
                <div class="relative z-10">
                    <h6 class="text-[9px] uppercase tracking-[3px] font-bold text-gray-400 mb-2">Total Assets</h6>
                    <h3 class="font-mono text-4xl font-bold text-gray-900 mb-0">@ViewBag.TotalAssets</h3>
                </div>
            </div>
            <div class="bg-white border border-gray-200 shadow-sm p-6 relative overflow-hidden group border-b-4 border-b-[#C21E2E] hover:border-gray-400 transition-colors duration-300">
                <i class="bi bi-exclamation-triangle absolute -right-4 -bottom-4 text-7xl text-red-50 opacity-50 group-hover:scale-110 transition-transform"></i>
                <div class="relative z-10">
                    <h6 class="text-[9px] uppercase tracking-[3px] font-bold text-[#C21E2E] mb-2">Poor Condition</h6>
                    <h3 class="font-mono text-4xl font-bold text-[#C21E2E] mb-0">@ViewBag.PoorCondition</h3>
                </div>
            </div>
            <div class="bg-white border border-gray-200 shadow-sm p-6 relative overflow-hidden group border-b-4 border-b-yellow-500 hover:border-gray-400 transition-colors duration-300">
                <i class="bi bi-tools absolute -right-4 -bottom-4 text-7xl text-yellow-50 opacity-50 group-hover:scale-110 transition-transform"></i>
                <div class="relative z-10">
                    <h6 class="text-[9px] uppercase tracking-[3px] font-bold text-yellow-700 mb-2">Under Repair</h6>
                    <h3 class="font-mono text-4xl font-bold text-yellow-600 mb-0">@ViewBag.UnderRepair</h3>
                </div>
            </div>
        </div>

        @* --- FILTER BAR --- *@
        <div class="bg-white shadow-sm border border-gray-200 p-5 relative z-10">
            <form method="get" action="@Url.Action("Assets", "Maintenance")" class="flex flex-col md:flex-row gap-4 items-end m-0">
                <div class="flex-grow w-full md:w-auto">
                    <label class="block text-[9px] uppercase tracking-[2px] font-bold text-gray-500 mb-2">Search</label>
                    <input type="text" name="search" value="@ViewBag.Search" class="w-full border border-gray-300 px-4 py-2 text-sm focus:outline-none focus:border-[#C21E2E] transition-colors font-mono bg-gray-50/50" placeholder="Asset name or building..." />
                </div>
                <div class="w-full md:w-48">
                    <label class="block text-[9px] uppercase tracking-[2px] font-bold text-gray-500 mb-2">Category</label>
                    <select name="category" class="w-full border border-gray-300 px-4 py-2 text-sm focus:outline-none focus:border-[#C21E2E] transition-colors bg-gray-50/50">
                        <option value="">All</option>
                        @foreach (var cat in new[] { "Electrical", "Plumbing", "HVAC", "Grounds", "Sports", "Building", "Safety", "IT", "Kitchen" })
                        {
                            <option value="@cat" @(ViewBag.Category == cat ? "selected" : "")>@cat</option>
                        }
                    </select>
                </div>
                <div class="w-full md:w-48">
                    <label class="block text-[9px] uppercase tracking-[2px] font-bold text-gray-500 mb-2">Condition</label>
                    <select name="condition" class="w-full border border-gray-300 px-4 py-2 text-sm focus:outline-none focus:border-[#C21E2E] transition-colors bg-gray-50/50">
                        <option value="">All</option>
                        <option value="Good" @(ViewBag.Condition == "Good" ? "selected" : "")>Good</option>
                        <option value="Fair" @(ViewBag.Condition == "Fair" ? "selected" : "")>Fair</option>
                        <option value="Poor" @(ViewBag.Condition == "Poor" ? "selected" : "")>Poor</option>
                    </select>
                </div>
                <div class="w-full md:w-auto">
                    <button type="submit" class="w-full md:w-auto bg-[#1a1a1a] text-white px-8 py-2 text-[10px] font-bold uppercase tracking-[2px] hover:bg-gray-800 transition-all h-[38px]">
                        Filter
                    </button>
                </div>
            </form>
        </div>

        @* --- ASSET TABLE --- *@
        <div class="bg-white shadow-sm border border-gray-100 flex flex-col flex-grow min-h-0 relative overflow-hidden group">

            @* Ghost Watermark *@
            <i class="bi bi-hdd-stack absolute -right-12 -bottom-12 text-9xl text-black opacity-[0.02] transition-transform duration-1000 group-hover:-rotate-12 group-hover:scale-[1.2] pointer-events-none z-0"></i>

            @* Table Header *@
            <div class="p-6 border-b border-gray-100 bg-gray-50/50 flex justify-between items-center relative z-10 flex-shrink-0">
                <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-900 mb-0"><i class="bi bi-qr-code me-2 text-gray-400"></i> Registered Assets</h5>
                <span class="text-[10px] font-mono text-gray-500 uppercase tracking-widest">@Model.Count asset(s)</span>
            </div>

            @* Table Container *@
            <div class="table-responsive flex-grow overflow-y-auto custom-scrollbar relative z-10">
                @if (Model.Any())
                {
                    <table class="table table-hover mb-0 align-middle w-full">
                        <thead class="sticky top-0 z-20 bg-white shadow-sm">
                            <tr class="text-[9px] uppercase tracking-[4px] font-bold text-gray-400 border-b border-gray-200 bg-gray-50/80">
                                <th class="ps-6 py-4">Asset Code</th>
                                <th class="border-l border-gray-100 ps-4">Asset Name</th>
                                <th class="border-l border-gray-100 ps-4">Category</th>
                                <th class="border-l border-gray-100 ps-4">Location</th>
                                <th class="border-l border-gray-100 ps-4">Condition</th>
                                <th class="border-l border-gray-100 ps-4">Health</th>
                                <th class="border-l border-gray-100 ps-4">Status</th>
                                <th class="pe-6 border-l border-gray-100 text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody class="text-gray-700">
                            @foreach (var a in Model)
                            {
                                string conditionColor = a.ConditionRating == "Good" ? "bg-green-100 text-green-800 border-green-200" :
                                                        a.ConditionRating == "Fair" ? "bg-yellow-100 text-yellow-800 border-yellow-200" :
                                                        "bg-red-100 text-[#C21E2E] border-red-200";

                                string healthColor = a.HealthScore > 70 ? "bg-[#10b981]" :
                                                     a.HealthScore > 40 ? "bg-yellow-500" : "bg-[#C21E2E]";

                                string statusColor = a.Status == "Active" ? "bg-green-50 text-green-700 border-green-200" :
                                                     a.Status == "Under Repair" ? "bg-yellow-50 text-yellow-700 border-yellow-200" :
                                                     "bg-gray-50 text-gray-600 border-gray-200";

                                <tr class="hover:bg-gray-50/80 transition-all duration-300 border-b border-gray-50 last:border-0 group/row">
                                    <td class="ps-6 py-4">
                                        <code class="font-mono text-sm font-bold text-[#C21E2E] bg-transparent">@a.QrCode</code>
                                    </td>

                                    <td class="border-l border-gray-50 ps-4">
                                        <strong class="font-serif text-sm text-gray-900 group-hover/row:text-[#C21E2E] transition-colors">@a.AssetName</strong>
                                        @if (a.FaultCount > 3)
                                        {
                                            <i class="bi bi-exclamation-circle-fill text-[#C21E2E] ms-2 text-xs" title="High fault count"></i>
                                        }
                                    </td>

                                    <td class="border-l border-gray-50 ps-4">
                                        <span class="inline-flex items-center text-[9px] font-bold uppercase tracking-widest bg-gray-100 text-gray-700 px-2 py-1 border shadow-sm">
                                            @a.Category
                                        </span>
                                    </td>

                                    <td class="border-l border-gray-50 ps-4">
                                        <span class="font-serif text-xs text-gray-700"><i class="bi bi-geo-alt me-1 text-gray-400"></i>@a.LocationBuilding</span>
                                    </td>

                                    <td class="border-l border-gray-50 ps-4">
                                        <span class="inline-flex items-center text-[8px] font-bold uppercase tracking-widest px-2 py-1 border shadow-sm @conditionColor">
                                            @a.ConditionRating
                                        </span>
                                    </td>

                                    <td class="border-l border-gray-50 ps-4">
                                        <div class="flex items-center gap-2">
                                            <div class="w-16 h-1.5 bg-gray-200 overflow-hidden shadow-inner">
                                                <div class="h-full @healthColor" style="width:@a.HealthScore%"></div>
                                            </div>
                                            <span class="text-[9px] font-mono font-bold text-gray-600">@a.HealthScore%</span>
                                        </div>
                                    </td>

                                    <td class="border-l border-gray-50 ps-4">
                                        <span class="inline-flex items-center text-[8px] font-bold uppercase tracking-widest px-2 py-1 border shadow-sm @statusColor">
                                            @a.Status
                                        </span>
                                    </td>

                                    <td class="pe-6 border-l border-gray-50 text-end">
                                        <div class="flex justify-end gap-1">
                                            <a href="@Url.Action("AssetDetail", "Maintenance", new { id = a.Id })" class="inline-flex items-center justify-center w-8 h-8 bg-white border border-gray-300 text-gray-500 hover:border-gray-800 hover:text-gray-800 transition-colors shadow-sm" title="View Details">
                                                <i class="bi bi-eye text-xs"></i>
                                            </a>
                                            <a href="@Url.Action("EditAsset", "Maintenance", new { id = a.Id })" class="inline-flex items-center justify-center w-8 h-8 bg-white border border-gray-300 text-gray-500 hover:border-gray-800 hover:text-gray-800 transition-colors shadow-sm" title="Edit Asset">
                                                <i class="bi bi-pencil text-xs"></i>
                                            </a>
                                            <a href="@Url.Action("QrCode", "Maintenance", new { id = a.Id })" target="_blank" class="inline-flex items-center justify-center w-8 h-8 bg-[#1a1a1a] border border-[#1a1a1a] text-white hover:bg-[#C21E2E] hover:border-[#C21E2E] transition-colors shadow-sm" title="View QR Code">
                                                <i class="bi bi-qr-code text-xs"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="text-center py-16 text-muted">
                        <i class="bi bi-cubes text-gray-200 text-6xl d-block mb-4"></i>
                        <h4 class="text-serif font-bold text-gray-400 uppercase tracking-[3px] mb-2">No assets found</h4>
                        <a href="@Url.Action("RegisterAsset", "Maintenance")" class="inline-block mt-3 bg-[#1a1a1a] text-white px-6 py-2 text-[9px] font-bold uppercase tracking-[2px] hover:bg-gray-800 transition-all">
                            Register First Asset
                        </a>
                    </div>
                }
            </div>

            @* Footer *@
            <div class="p-4 bg-[#1a1a1a] border-t border-gray-800 flex justify-between items-center flex-shrink-0 relative z-10">
                <div class="text-[9px] uppercase tracking-[2px] font-bold text-gray-400 font-mono">
                    <i class="bi bi-shield-lock me-2 text-gray-500"></i> Asset Infrastructure Records
                </div>
            </div>
        </div>

    </div>
</div>

<style>
    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }

    .font-mono {
        font-family: 'Source Code Pro', monospace !important;
    }

    .table thead th {
        border-bottom: 2px solid #f8f9fa !important;
    }

    .table tbody tr {
        transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    .custom-scrollbar::-webkit-scrollbar {
        width: 5px;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #eee;
        border-radius: 10px;
    }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #C21E2E;
        }
</style>
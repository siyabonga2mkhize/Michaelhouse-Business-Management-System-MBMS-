@model List<Michaelhouse.Models.MaintenanceStaff>
@{
    ViewBag.Title = "Staff Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* --- FULL SCREEN VIEWPORT CONTAINER --- *@
<div class="flex flex-col h-full w-full overflow-hidden bg-gray-50/30">

    @* --- HEADER --- *@
    <div class="mb-6 d-flex justify-content-between align-items-end border-b border-gray-200 pb-6 flex-shrink-0 px-8 pt-8 bg-white shadow-sm relative z-10">
        <div>
            <div class="flex items-center gap-2 mb-3">
                <div class="h-[2px] w-8 bg-[#C21E2E]"></div>
                <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Maintenance</h5>
            </div>
            <h2 class="text-5xl font-serif font-bold text-gray-900 tracking-tight">Staff Management</h2>
            <p class="text-[11px] font-mono text-gray-400 uppercase tracking-widest mt-2 mb-0">Manage maintenance team</p>
        </div>
        <div class="flex gap-3">
            <a href="@Url.Action("AddStaff", "Maintenance")" class="inline-flex items-center justify-center bg-[#C21E2E] text-white px-8 py-3 text-[10px] font-bold uppercase tracking-[3px] hover:bg-red-700 hover:shadow-[0_0_15px_rgba(194,30,46,0.4)] transition-all duration-300">
                <i class="bi bi-plus-square me-2 text-sm"></i> Add Staff
            </a>
        </div>
    </div>

    @* --- SCROLLABLE DATA SECTION --- *@
    <div class="flex-grow min-h-0 overflow-y-auto custom-scrollbar px-8 pb-10 pt-4 flex flex-col gap-6">

        @* --- FILTER BAR --- *@
        <div class="bg-white shadow-sm border border-gray-200 p-5 relative z-10">
            <form method="get" action="@Url.Action("Staff", "Maintenance")" class="flex flex-col md:flex-row gap-4 items-end m-0">
                <div class="flex-grow w-full md:w-auto">
                    <label class="block text-[9px] uppercase tracking-[2px] font-bold text-gray-500 mb-2">Search</label>
                    <input type="text" name="search" value="@ViewBag.Search" class="w-full border border-gray-300 px-4 py-2 text-sm focus:outline-none focus:border-[#C21E2E] transition-colors font-mono bg-gray-50/50" placeholder="Name or staff number..." />
                </div>
                <div class="w-full md:w-48">
                    <label class="block text-[9px] uppercase tracking-[2px] font-bold text-gray-500 mb-2">Skill</label>
                    <select name="skill" class="w-full border border-gray-300 px-4 py-2 text-sm focus:outline-none focus:border-[#C21E2E] transition-colors bg-gray-50/50">
                        <option value="">All Skills</option>
                        @foreach (var s in new[] { "Plumbing", "Electrical", "HVAC", "Grounds", "Pool", "IT", "General" })
                        {
                            <option value="@s" @(ViewBag.Skill == s ? "selected" : "")>@s</option>
                        }
                    </select>
                </div>
                <div class="w-full md:w-48">
                    <label class="block text-[9px] uppercase tracking-[2px] font-bold text-gray-500 mb-2">Status</label>
                    <select name="status" class="w-full border border-gray-300 px-4 py-2 text-sm focus:outline-none focus:border-[#C21E2E] transition-colors bg-gray-50/50">
                        <option value="">All Statuses</option>
                        @foreach (var s in new[] { "Available", "On Job", "Off Shift" })
                        {
                            <option value="@s" @(ViewBag.Status == s ? "selected" : "")>@s</option>
                        }
                    </select>
                </div>
                <div class="w-full md:w-auto">
                    <button type="submit" class="w-full md:w-auto bg-[#1a1a1a] text-white px-8 py-2 text-[10px] font-bold uppercase tracking-[2px] hover:bg-gray-800 transition-all h-[38px]">
                        Filter
                    </button>
                </div>
            </form>
        </div>

        @* --- STAFF TABLE --- *@
        <div class="bg-white shadow-sm border border-gray-100 flex flex-col flex-grow min-h-0 relative overflow-hidden">

            <div class="p-6 border-b border-gray-100 bg-gray-50/50 flex justify-between items-center relative z-10 flex-shrink-0">
                <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-900 mb-0"><i class="bi bi-people me-2 text-gray-400"></i> Maintenance Team</h5>
                <span class="text-[10px] font-mono text-gray-500 uppercase tracking-widest">@Model.Count staff member(s)</span>
            </div>

            <div class="table-responsive flex-grow overflow-y-auto custom-scrollbar relative z-10">
                @if (Model.Any())
                {
                    <table class="table table-hover mb-0 align-middle w-full">
                        <thead class="sticky top-0 z-20 bg-white shadow-sm">
                            <tr class="text-[9px] uppercase tracking-[4px] font-bold text-gray-400 border-b border-gray-200 bg-gray-50/80">
                                <th class="ps-6 py-4">Staff No.</th>
                                <th class="border-l border-gray-100 ps-4">Name</th>
                                <th class="border-l border-gray-100 ps-4">Skill</th>
                                <th class="border-l border-gray-100 ps-4">Shift</th>
                                <th class="border-l border-gray-100 ps-4">Phone</th>
                                <th class="border-l border-gray-100 ps-4">Status</th>
                                <th class="border-l border-gray-100 ps-4">Jobs Done</th>
                                <th class="pe-6 border-l border-gray-100 text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody class="text-gray-700">
                            @foreach (var s in Model)
                            {
                                var completed = ViewData["completed_" + s.Id] ?? 0;
                                var active = ViewData["active_" + s.Id] ?? 0;

                                string statusClass = s.CurrentStatus == "Available" ? "bg-green-100 text-green-800 border-green-200" :
                                                     s.CurrentStatus == "On Job" ? "bg-yellow-100 text-yellow-800 border-yellow-200" :
                                                     "bg-gray-100 text-gray-600 border-gray-200";

                                <tr class="hover:bg-gray-50/80 transition-all duration-300 border-b border-gray-50 last:border-0 group/row">
                                    <td class="ps-6 py-4">
                                        <code class="font-mono text-sm font-bold text-[#C21E2E] bg-transparent">@s.StaffNumber</code>
                                    </td>

                                    <td class="border-l border-gray-50 ps-4">
                                        <div class="flex items-center gap-3">
                                            <div class="bg-[#1a1a1a] text-white rounded-full flex items-center justify-center w-8 h-8 font-bold text-xs flex-shrink-0 shadow-sm">
                                                @s.FullName.Substring(0, 1)
                                            </div>
                                            <div>
                                                <strong class="font-serif text-sm text-gray-900 block leading-tight group-hover/row:text-[#C21E2E] transition-colors">@s.FullName</strong>
                                                <span class="text-[10px] font-mono text-gray-500">@s.Email</span>
                                            </div>
                                        </div>
                                    </td>

                                    <td class="border-l border-gray-50 ps-4">
                                        <span class="inline-flex items-center text-[9px] font-bold uppercase tracking-widest bg-gray-100 text-gray-700 px-2 py-1 border shadow-sm">
                                            @s.SkillType
                                        </span>
                                    </td>

                                    <td class="border-l border-gray-50 ps-4">
                                        <span class="font-mono text-xs text-gray-700">@s.ShiftStart.ToString(@"hh\:mm") – @s.ShiftEnd.ToString(@"hh\:mm")</span>
                                    </td>

                                    <td class="border-l border-gray-50 ps-4">
                                        <span class="font-mono text-xs text-gray-700">@s.Phone</span>
                                    </td>

                                    <td class="border-l border-gray-50 ps-4">
                                        <span class="inline-flex items-center text-[8px] font-bold uppercase tracking-widest px-2 py-1 border shadow-sm @statusClass">
                                            @s.CurrentStatus
                                        </span>
                                    </td>

                                    <td class="border-l border-gray-50 ps-4">
                                        <div class="text-[11px] font-mono">
                                            <span class="text-green-600 font-bold">@completed</span> <span class="text-gray-400">total</span> ·
                                            <span class="text-yellow-600 font-bold">@active</span> <span class="text-gray-400">active</span>
                                        </div>
                                    </td>

                                    <td class="pe-6 border-l border-gray-50 text-end">
                                        <div class="flex justify-end gap-1">
                                            <a href="@Url.Action("EditStaff", "Maintenance", new { id = s.Id })" class="inline-flex items-center justify-center w-8 h-8 bg-white border border-gray-300 text-gray-500 hover:border-gray-800 hover:text-gray-800 transition-colors shadow-sm" title="Edit Staff">
                                                <i class="bi bi-pencil text-xs"></i>
                                            </a>
                                            <button onclick="updateStatus(@s.Id,'Available')" class="inline-flex items-center justify-center w-8 h-8 bg-white border border-gray-300 text-green-600 hover:border-green-600 hover:bg-green-50 transition-colors shadow-sm" title="Mark Available">
                                                <i class="bi bi-check-lg text-xs"></i>
                                            </button>
                                            <form method="post" action="@Url.Action("DeactivateStaff", "Maintenance", new { id = s.Id })" onsubmit="return confirm('Deactivate @s.FullName?')" class="m-0 p-0 inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="inline-flex items-center justify-center w-8 h-8 bg-white border border-gray-300 text-[#C21E2E] hover:border-[#C21E2E] hover:bg-red-50 transition-colors shadow-sm" title="Deactivate">
                                                    <i class="bi bi-person-x text-xs"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="text-center py-16 text-muted">
                        <i class="bi bi-people text-gray-200 text-6xl d-block mb-4"></i>
                        <h4 class="text-serif font-bold text-gray-400 uppercase tracking-[3px] mb-2">No staff found</h4>
                        <a href="@Url.Action("AddStaff", "Maintenance")" class="inline-block mt-3 bg-[#1a1a1a] text-white px-6 py-2 text-[9px] font-bold uppercase tracking-[2px] hover:bg-gray-800 transition-all">
                            Add First Staff Member
                        </a>
                    </div>
                }
            </div>

            @* Footer *@
            <div class="p-4 bg-[#1a1a1a] border-t border-gray-800 flex justify-between items-center flex-shrink-0 relative z-10">
                <div class="text-[9px] uppercase tracking-[2px] font-bold text-gray-400 font-mono">
                    <i class="bi bi-shield-lock me-2 text-gray-500"></i> Maintenance Team Records
                </div>
            </div>
        </div>

    </div>
</div>

<style>
    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }

    .font-mono {
        font-family: 'Source Code Pro', monospace !important;
    }

    .table thead th {
        border-bottom: 2px solid #f8f9fa !important;
    }

    .table tbody tr {
        transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    .custom-scrollbar::-webkit-scrollbar {
        width: 5px;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #eee;
        border-radius: 10px;
    }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #C21E2E;
        }
</style>

@section Scripts {
    <script>
        function updateStatus(id, status) {
            fetch('@Url.Action("UpdateStatus", "Maintenance")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'id=' + id + '&status=' + status
            }).then(r => r.json()).then(data => { if (data.success) location.reload(); });
        }
    </script>
}
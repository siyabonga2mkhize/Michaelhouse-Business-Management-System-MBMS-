@model Michaelhouse.Models.MaintenanceStaff
@{
    ViewBag.Title = "Edit Staff Member";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="mb-10 d-flex justify-content-between align-items-end border-b border-gray-100 pb-8">
    <div>
        <div class="flex items-center gap-2 mb-3">
            <div class="h-1 w-8 bg-[#C21E2E]"></div>
            <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Maintenance</h5>
        </div>
        <h2 class="text-4xl font-serif font-bold text-gray-900 tracking-tight">Edit Staff Member</h2>
        <p class="text-gray-400 text-[10px] uppercase tracking-widest font-bold mt-2">@Model.FullName · @Model.StaffNumber</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                @using (Html.BeginForm("EditStaff", "Maintenance", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.Id)
                    @Html.HiddenFor(m => m.StaffNumber)
                    @Html.HiddenFor(m => m.DateJoined)

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase text-muted">Full Name *</label>
                            @Html.TextBoxFor(m => m.FullName, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.FullName, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase text-muted">Email *</label>
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase text-muted">Phone *</label>
                            @Html.TextBoxFor(m => m.Phone, new { @class = "form-control" })
                            @Html.ValidationMessageFor(m => m.Phone, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase text-muted">Skill Type *</label>
                            @Html.DropDownListFor(m => m.SkillType,
                                new SelectList(new[] { "Plumbing", "Electrical", "HVAC", "Grounds", "Pool", "IT", "General" }, Model.SkillType),
                                new { @class = "form-select" })
                            @Html.ValidationMessageFor(m => m.SkillType, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase text-muted">Shift Start *</label>
                            @Html.TextBoxFor(m => m.ShiftStart, new { @class = "form-control", type = "time" })
                            @Html.ValidationMessageFor(m => m.ShiftStart, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase text-muted">Shift End *</label>
                            @Html.TextBoxFor(m => m.ShiftEnd, new { @class = "form-control", type = "time" })
                            @Html.ValidationMessageFor(m => m.ShiftEnd, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-uppercase text-muted">Status</label>
                            @Html.DropDownListFor(m => m.CurrentStatus,
                                new SelectList(new[] { "Available", "On Job", "Off Shift" }, Model.CurrentStatus),
                                new { @class = "form-select" })
                        </div>
                        <div class="col-md-6">
                            <div class="form-check mt-4">
                                @Html.CheckBoxFor(m => m.IsActive, new { @class = "form-check-input" })
                                <label class="form-check-label" for="IsActive">Active</label>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-dark"><i class="bi bi-save me-1"></i> Save Changes</button>
                        <a href="@Url.Action("Staff", "Maintenance")" class="btn btn-outline-secondary ms-2"><i class="bi bi-arrow-left me-1"></i> Back</a>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0">
                <h5 class="mb-0 fw-bold"><i class="bi bi-person-badge me-2"></i>Staff Record</h5>
            </div>
            <div class="card-body">
                <ul class="list-unstyled">
                    <li class="d-flex justify-content-between border-bottom py-2"><span class="text-muted">Staff Number</span><code class="text-danger">@Model.StaffNumber</code></li>
                    <li class="d-flex justify-content-between border-bottom py-2"><span class="text-muted">Date Joined</span>@Model.DateJoined.ToString("dd MMM yyyy")</li>
                    <li class="d-flex justify-content-between py-2"><span class="text-muted">Login Username</span><code>@Model.FullName.ToLower().Replace(" ", ".")</code></li>
                </ul>
                <div class="alert alert-secondary mt-3">
                    <i class="bi bi-info-circle me-1"></i> Changing skill type affects auto‑assignment.
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .font-serif {
            font-family: 'Playfair Display', serif !important;
        }
    </style>
}
@model Michaelhouse.Models.JobCard
@{
    ViewBag.Title = "Report Fault from Scan";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="mb-10 d-flex justify-content-between align-items-end border-b border-gray-100 pb-8">
    <div>
        <div class="flex items-center gap-2 mb-3">
            <div class="h-1 w-8 bg-[#C21E2E]"></div>
            <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Maintenance</h5>
        </div>
        <h2 class="text-4xl font-serif font-bold text-gray-900 tracking-tight">Report Fault from Scan</h2>
        <p class="text-gray-400 text-[10px] uppercase tracking-widest font-bold mt-2">
            Asset: <strong>@ViewBag.AssetName</strong> · @ViewBag.Location
        </p>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                @using (Html.BeginForm("ReportFaultFromScan", "Maintenance", FormMethod.Post, new { @class = "row g-3" }))
                {
                    @Html.AntiForgeryToken()
                    @Html.HiddenFor(m => m.AssetId)

                    <div class="col-12">
                        <div class="alert alert-success">
                            <i class="bi bi-qr-code me-2"></i>
                            Reporting fault for: <strong>@ViewBag.AssetName</strong> at <strong>@ViewBag.Location</strong>
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label small fw-bold text-uppercase text-muted">Title *</label>
                        @Html.TextBoxFor(m => m.Title, new { @class = "form-control", placeholder = "e.g. Broken light, leaking pipe" })
                        @Html.ValidationMessageFor(m => m.Title, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-12">
                        <label class="form-label small fw-bold text-uppercase text-muted">Priority *</label>
                        @Html.DropDownListFor(m => m.Priority,
                            new SelectList(new[] { "Emergency", "High", "Medium", "Low" }),
                            "-- Select Priority --",
                            new { @class = "form-select" })
                        @Html.ValidationMessageFor(m => m.Priority, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-12">
                        <label class="form-label small fw-bold text-uppercase text-muted">Description *</label>
                        @Html.TextAreaFor(m => m.Description, new { @class = "form-control", rows = 4, placeholder = "Describe exactly what you found..." })
                        @Html.ValidationMessageFor(m => m.Description, "", new { @class = "text-danger small" })
                    </div>

                    <div class="col-12">
                        <button type="submit" class="btn btn-dark"><i class="bi bi-save me-1"></i> Submit Fault Report</button>
                        <a href="@Url.Action("AssetDetail", "Maintenance", new { id = Model.AssetId })" class="btn btn-outline-secondary ms-2"><i class="bi bi-arrow-left me-1"></i> Back to Asset</a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .font-serif {
            font-family: 'Playfair Display', serif !important;
        }
    </style>
}
@model Michaelhouse.Models.JobCard
@{
    ViewBag.Title = "Job Card Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="mb-10 d-flex justify-content-between align-items-end border-b border-gray-100 pb-8">
    <div>
        <div class="flex items-center gap-2 mb-3">
            <div class="h-1 w-8 bg-[#C21E2E]"></div>
            <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Maintenance</h5>
        </div>
        <h2 class="text-4xl font-serif font-bold text-gray-900 tracking-tight">@Model.Title</h2>
        <p class="text-gray-400 text-[10px] uppercase tracking-widest font-bold mt-2">
            <code class="text-danger">@Model.JobReference</code> · Created @Model.DateCreated.ToString("dd MMM yyyy HH:mm")
        </p>
    </div>
    <div>
        @if (Model.Status != "Completed" && Model.Status != "Cancelled")
        {
            <a href="@Url.Action("CompleteJobCard", "Maintenance", new { id = Model.Id })" class="btn btn-success me-2"><i class="bi bi-check-circle me-1"></i> Complete</a>
        }
        <a href="@Url.Action("JobCards", "Maintenance")" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i> Back</a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0">
                <h5 class="mb-0 fw-bold"><i class="bi bi-info-circle me-2"></i>Job Information</h5>
            </div>
            <div class="card-body">
                <ul class="list-unstyled">
                    <li class="d-flex justify-content-between border-bottom py-2"><span class="text-muted">Reference</span><code class="text-danger">@Model.JobReference</code></li>
                    <li class="d-flex justify-content-between border-bottom py-2"><span class="text-muted">Type</span><span class="badge bg-@(Model.JobType=="Reactive"?"danger":"success")">@Model.JobType</span></li>
                    <li class="d-flex justify-content-between border-bottom py-2"><span class="text-muted">Priority</span><span class="badge bg-@(Model.Priority=="Emergency"?"danger":Model.Priority=="High"?"warning":Model.Priority=="Medium"?"info":"secondary")">@Model.Priority</span></li>
                    <li class="d-flex justify-content-between border-bottom py-2"><span class="text-muted">Status</span><span class="badge bg-@(Model.Status=="Completed"?"success":Model.Status=="In Progress"||Model.Status=="Assigned"?"warning":"secondary")">@Model.Status</span></li>
                    <li class="d-flex justify-content-between border-bottom py-2"><span class="text-muted">Asset</span>@(Model.Asset != null ? Model.Asset.AssetName : "—")</li>
                    <li class="d-flex justify-content-between border-bottom py-2"><span class="text-muted">Location</span>@(Model.Asset != null ? Model.Asset.LocationBuilding : "—")</li>
                    <li class="d-flex justify-content-between border-bottom py-2"><span class="text-muted">Assigned To</span>@(Model.AssignedTo != null ? Model.AssignedTo.FullName : "Unassigned")</li>
                    @if (Model.DueDate.HasValue)
                    {
                        var overdue = Model.DueDate.Value < DateTime.Now && Model.Status != "Completed";
                        <li class="d-flex justify-content-between border-bottom py-2">
                            <span class="text-muted">Due Date</span><span class="@(overdue ? "text-danger fw-bold" : "")">
                                @Model.DueDate.Value.ToString("dd MMM yyyy HH:mm") @if (overdue)
                                {<text>⚠️</text>}
                            </span>
                        </li>
                    }
                    @if (Model.ResponseTimeMinutes.HasValue)
                    {
                        <li class="d-flex justify-content-between py-2"><span class="text-muted">Response Time</span><span class="text-success fw-bold">@Model.ResponseTimeMinutes mins</span></li>
                    }
                    @if (Model.TotalCost.HasValue)
                    {
                        <li class="d-flex justify-content-between border-bottom py-2">
                            <span class="text-muted">Parts Cost</span>
                            <span>R@(Model.PartsCost?.ToString("N2") ?? "0.00")</span>
                        </li>
                        <li class="d-flex justify-content-between border-bottom py-2">
                            <span class="text-muted">Labour Cost</span>
                            <span>R@(Model.LabourCost?.ToString("N2") ?? "0.00")</span>
                        </li>
                        <li class="d-flex justify-content-between py-2">
                            <span class="text-muted">Total Cost</span>
                            <span class="fw-bold">R@(Model.TotalCost?.ToString("N2") ?? "0.00")</span>
                        </li>
                    }
                </ul>

                @if (Model.AssignedToId == null && Model.Status != "Completed" && Model.Status != "Cancelled")
                {
                    <button onclick="autoAssign(@Model.Id)" class="btn btn-warning w-100 mt-2"><i class="bi bi-robot me-1"></i> Auto-Assign Worker</button>
                    <div id="assignResult" class="mt-2 small" style="display:none;"></div>
                }
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Model.Description))
        {
            <div class="card border-0 shadow-sm mt-3">
                <div class="card-body">
                    <h6 class="fw-bold"><i class="bi bi-quote me-2"></i>Description</h6>
                    <p class="text-muted">@Model.Description</p>
                </div>
            </div>
        }
    </div>
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0">
                <h5 class="mb-0 fw-bold"><i class="bi bi-camera me-2"></i>Photo Evidence</h5>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <div class="border rounded">
                            <div class="bg-light p-2 small text-muted text-uppercase fw-bold">Before — Fault Evidence</div>
                            @if (!string.IsNullOrEmpty(Model.PhotoBefore))
                            {
                                <img src="~/Content/JobPhotos/@Model.PhotoBefore" class="img-fluid" />
                            }
                            else
                            {
                                <div class="text-center py-4"><i class="bi bi-image fs-1 text-secondary"></i><p class="small text-muted">No before photo</p></div>
                            }
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="border rounded">
                            <div class="bg-light p-2 small text-muted text-uppercase fw-bold">After — Repair Complete</div>
                            @if (!string.IsNullOrEmpty(Model.PhotoAfter))
                            {
                                <img src="~/Content/JobPhotos/@Model.PhotoAfter" class="img-fluid" />
                            }
                            else
                            {
                                <div class="text-center py-4"><i class="bi bi-image fs-1 text-secondary"></i><p class="small text-muted">No after photo yet</p></div>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.Status == "Completed")
        {
            <div class="card border-0 shadow-sm mt-3 border-success">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-check-circle me-2"></i>Completed</h5>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-4"><span class="text-muted small">Completed On</span><br />@(Model.DateCompleted.HasValue ? Model.DateCompleted.Value.ToString("dd MMM yyyy HH:mm") : "—")</div>
                        <div class="col-4"><span class="text-muted small">Final Condition</span><br /><span class="badge bg-secondary">@Model.FinalCondition</span></div>
                        <div class="col-4"><span class="text-muted small">Response Time</span><br /><span class="fw-bold text-success">@(Model.ResponseTimeMinutes.HasValue ? Model.ResponseTimeMinutes + " mins" : "—")</span></div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.CompletionNotes))
                    {
                        <div class="alert alert-success mt-3"><i class="bi bi-quote me-1"></i> @Model.CompletionNotes</div>
                    }
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        function autoAssign(jobCardId) {
            var btn = event.target;
            btn.disabled = true;
            btn.innerHTML = '<i class="bi bi-arrow-repeat me-1"></i> Finding worker...';
            fetch('@Url.Action("AutoAssign", "Maintenance")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'jobCardId=' + jobCardId
            })
            .then(r => r.json())
            .then(data => {
                var result = document.getElementById('assignResult');
                result.style.display = 'block';
                if (data.success) {
                    result.className = 'alert alert-success mt-2';
                    result.innerHTML = '<strong>' + data.workerName + '</strong> assigned. Skill: ' + data.workerSkill + ' · Phone: ' + data.workerPhone;
                    setTimeout(function() { location.reload(); }, 1500);
                } else {
                    result.className = 'alert alert-danger mt-2';
                    result.textContent = data.message;
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-robot me-1"></i> Auto-Assign Worker';
                }
            });
        }
    </script>
}
@section Styles {
    <style>
        .font-serif {
            font-family: 'Playfair Display', serif !important;
        }
    </style>
}
@model Michaelhouse.Models.JobCard
@{
    ViewBag.Title = "Job Card Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@* --- FULL SCREEN VIEWPORT CONTAINER --- *@
<div class="flex flex-col h-full w-full overflow-hidden bg-gray-50/30">

    @* --- HEADER --- *@
    <div class="mb-6 d-flex justify-content-between align-items-end border-b border-gray-200 pb-6 flex-shrink-0 px-8 pt-8 bg-white shadow-sm relative z-10">
        <div>
            <div class="flex items-center gap-2 mb-3">
                <div class="h-[2px] w-8 bg-[#C21E2E]"></div>
                <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Maintenance</h5>
            </div>
            <h2 class="text-5xl font-serif font-bold text-gray-900 tracking-tight">@Model.Title</h2>
            <p class="text-[11px] font-mono text-gray-400 uppercase tracking-widest mt-2 mb-0">
                <span class="text-[#C21E2E] font-bold">@Model.JobReference</span> · Created @Model.DateCreated.ToString("dd MMM yyyy HH:mm")
            </p>
        </div>
        <div class="flex gap-3">
            <a href="@Url.Action("JobCards", "Maintenance")" class="inline-flex items-center justify-center bg-white border border-gray-300 text-gray-700 px-6 py-3 text-[10px] font-bold uppercase tracking-[2px] hover:bg-gray-50 hover:border-gray-400 transition-all duration-300 shadow-sm">
                <i class="bi bi-arrow-left me-2 text-sm"></i> Back
            </a>
            @if (Model.Status != "Completed" && Model.Status != "Cancelled")
            {
                <a href="@Url.Action("CompleteJobCard", "Maintenance", new { id = Model.Id })" class="inline-flex items-center justify-center bg-[#10b981] text-white px-8 py-3 text-[10px] font-bold uppercase tracking-[3px] hover:bg-green-600 hover:shadow-[0_0_15px_rgba(16,185,129,0.4)] transition-all duration-300">
                    <i class="bi bi-check-circle me-2 text-sm"></i> Complete Job
                </a>
            }
        </div>
    </div>

    @* --- SCROLLABLE DATA SECTION --- *@
    <div class="flex-grow min-h-0 overflow-y-auto custom-scrollbar px-8 pb-10 pt-4 flex flex-col">

        <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">

            @* --- LEFT COLUMN: JOB INFORMATION --- *@
            <div class="lg:col-span-4 flex flex-col gap-6">

                <div class="bg-white shadow-sm border border-gray-100 flex flex-col">
                    <div class="p-5 border-b border-gray-100 bg-[#1a1a1a]">
                        <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-white mb-0"><i class="bi bi-info-circle me-2 text-gray-500"></i> Job Information</h5>
                    </div>

                    <div class="p-6 flex flex-col gap-1">
                        <div class="flex justify-between items-center py-3 border-b border-gray-50">
                            <span class="text-[10px] uppercase tracking-[2px] font-bold text-gray-400">Reference</span>
                            <code class="font-mono text-xs font-bold text-[#C21E2E] bg-transparent">@Model.JobReference</code>
                        </div>

                        @{
                            string typeColor = Model.JobType == "Reactive" ? "bg-red-50 text-red-700 border-red-200" : "bg-green-50 text-green-700 border-green-200";
                            string priorityColor = Model.Priority == "Emergency" ? "bg-red-100 text-[#C21E2E] border-red-200" :
                                                   Model.Priority == "High" ? "bg-yellow-100 text-yellow-800 border-yellow-200" :
                                                   Model.Priority == "Medium" ? "bg-blue-50 text-blue-700 border-blue-200" : "bg-gray-50 text-gray-600 border-gray-200";
                            string statusColor = Model.Status == "Completed" ? "bg-green-100 text-green-800 border-green-200" :
                                                 (Model.Status == "In Progress" || Model.Status == "Assigned") ? "bg-yellow-100 text-yellow-800 border-yellow-200" : "bg-gray-100 text-gray-600 border-gray-200";
                        }

                        <div class="flex justify-between items-center py-3 border-b border-gray-50">
                            <span class="text-[10px] uppercase tracking-[2px] font-bold text-gray-400">Type</span>
                            <span class="inline-flex items-center text-[8px] font-bold uppercase tracking-widest px-2 py-1 border shadow-sm @typeColor">@Model.JobType</span>
                        </div>

                        <div class="flex justify-between items-center py-3 border-b border-gray-50">
                            <span class="text-[10px] uppercase tracking-[2px] font-bold text-gray-400">Priority</span>
                            <span class="inline-flex items-center text-[8px] font-bold uppercase tracking-widest px-2 py-1 border shadow-sm @priorityColor">@Model.Priority</span>
                        </div>

                        <div class="flex justify-between items-center py-3 border-b border-gray-50">
                            <span class="text-[10px] uppercase tracking-[2px] font-bold text-gray-400">Status</span>
                            <span class="inline-flex items-center text-[8px] font-bold uppercase tracking-widest px-2 py-1 border shadow-sm @statusColor">@Model.Status</span>
                        </div>

                        <div class="flex justify-between items-center py-3 border-b border-gray-50">
                            <span class="text-[10px] uppercase tracking-[2px] font-bold text-gray-400">Asset</span>
                            <span class="font-serif text-sm text-gray-800">@(Model.Asset != null ? Model.Asset.AssetName : "—")</span>
                        </div>

                        <div class="flex justify-between items-center py-3 border-b border-gray-50">
                            <span class="text-[10px] uppercase tracking-[2px] font-bold text-gray-400">Location</span>
                            <span class="font-serif text-sm text-gray-800">@(Model.Asset != null ? Model.Asset.LocationBuilding : "—")</span>
                        </div>

                        <div class="flex justify-between items-center py-3 border-b border-gray-50">
                            <span class="text-[10px] uppercase tracking-[2px] font-bold text-gray-400">Assigned To</span>
                            <span class="font-serif text-sm text-gray-800">@(Model.AssignedTo != null ? Model.AssignedTo.FullName : "Unassigned")</span>
                        </div>

                        @if (Model.DueDate.HasValue)
                        {
                            var overdue = Model.DueDate.Value < DateTime.Now && Model.Status != "Completed";
                            <div class="flex justify-between items-center py-3 border-b border-gray-50">
                                <span class="text-[10px] uppercase tracking-[2px] font-bold text-gray-400">Due Date</span>
                                <span class="font-mono text-sm @(overdue ? "text-[#C21E2E] font-bold" : "text-gray-800")">
                                    @Model.DueDate.Value.ToString("dd MMM yyyy HH:mm") @(overdue ? "⚠️" : "")
                                </span>
                            </div>
                        }

                        @if (Model.ResponseTimeMinutes.HasValue)
                        {
                            <div class="flex justify-between items-center py-3 border-b border-gray-50">
                                <span class="text-[10px] uppercase tracking-[2px] font-bold text-gray-400">Response Time</span>
                                <span class="font-mono text-sm font-bold text-[#10b981]">@Model.ResponseTimeMinutes mins</span>
                            </div>
                        }

                        @if (Model.TotalCost.HasValue)
                        {
                            <div class="flex justify-between items-center py-3 border-b border-gray-50">
                                <span class="text-[10px] uppercase tracking-[2px] font-bold text-gray-400">Parts Cost</span>
                                <span class="font-mono text-sm text-gray-800">R@(Model.PartsCost?.ToString("N2") ?? "0.00")</span>
                            </div>
                            <div class="flex justify-between items-center py-3 border-b border-gray-50">
                                <span class="text-[10px] uppercase tracking-[2px] font-bold text-gray-400">Labour Cost</span>
                                <span class="font-mono text-sm text-gray-800">R@(Model.LabourCost?.ToString("N2") ?? "0.00")</span>
                            </div>
                            <div class="flex justify-between items-center py-3 border-b border-gray-50">
                                <span class="text-[10px] uppercase tracking-[2px] font-bold text-gray-400">Total Cost</span>
                                <span class="font-mono text-sm font-bold text-gray-900">R@(Model.TotalCost?.ToString("N2") ?? "0.00")</span>
                            </div>
                        }
                    </div>

                    @if (Model.AssignedToId == null && Model.Status != "Completed" && Model.Status != "Cancelled")
                    {
                        <div class="p-6 bg-gray-50 border-t border-gray-100">
                            <button onclick="autoAssign(@Model.Id)" class="w-full bg-yellow-500 text-yellow-900 px-6 py-3 text-[10px] font-bold uppercase tracking-[2px] hover:bg-yellow-400 transition-all shadow-sm">
                                <i class="bi bi-robot me-2"></i> Auto-Assign Worker
                            </button>
                            <div id="assignResult" class="hidden"></div>
                        </div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <div class="bg-white shadow-sm border border-gray-100 flex flex-col">
                        <div class="p-5 border-b border-gray-100 bg-gray-50/50">
                            <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-900 mb-0"><i class="bi bi-quote me-2 text-gray-400"></i> Description</h5>
                        </div>
                        <div class="p-6">
                            <p class="font-serif italic text-sm text-gray-600 mb-0 leading-relaxed">"@Model.Description"</p>
                        </div>
                    </div>
                }
            </div>

            @* --- RIGHT COLUMN: EVIDENCE & COMPLETION --- *@
            <div class="lg:col-span-8 flex flex-col gap-6">

                @* Photo Evidence *@
                <div class="bg-white shadow-sm border border-gray-100 flex flex-col">
                    <div class="p-5 border-b border-gray-100 bg-gray-50/50">
                        <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-900 mb-0"><i class="bi bi-camera me-2 text-gray-400"></i> Photo Evidence</h5>
                    </div>
                    <div class="p-6">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                            @* Before Photo *@
                            <div class="border border-gray-200 bg-white shadow-sm flex flex-col">
                                <div class="bg-gray-100 p-3 text-[9px] font-bold uppercase tracking-[2px] text-gray-500 text-center border-b border-gray-200">
                                    Before — Fault Evidence
                                </div>
                                <div class="p-2 flex-grow flex items-center justify-center bg-gray-50/30 min-h-[250px]">
                                    @if (!string.IsNullOrEmpty(Model.PhotoBefore))
                                    {
                                        <img src="~/Content/JobPhotos/@Model.PhotoBefore" class="max-w-full max-h-[300px] object-contain border border-gray-200 p-1 bg-white" />
                                    }
                                    else
                                    {
                                        <div class="text-center py-10 text-gray-300">
                                            <i class="bi bi-image text-5xl mb-2 block"></i>
                                            <p class="text-[10px] font-mono uppercase tracking-widest m-0">No before photo</p>
                                        </div>
                                    }
                                </div>
                            </div>

                            @* After Photo *@
                            <div class="border border-gray-200 bg-white shadow-sm flex flex-col">
                                <div class="bg-gray-100 p-3 text-[9px] font-bold uppercase tracking-[2px] text-gray-500 text-center border-b border-gray-200">
                                    After — Repair Complete
                                </div>
                                <div class="p-2 flex-grow flex items-center justify-center bg-gray-50/30 min-h-[250px]">
                                    @if (!string.IsNullOrEmpty(Model.PhotoAfter))
                                    {
                                        <img src="~/Content/JobPhotos/@Model.PhotoAfter" class="max-w-full max-h-[300px] object-contain border border-gray-200 p-1 bg-white" />
                                    }
                                    else
                                    {
                                        <div class="text-center py-10 text-gray-300">
                                            <i class="bi bi-image text-5xl mb-2 block"></i>
                                            <p class="text-[10px] font-mono uppercase tracking-widest m-0">No after photo yet</p>
                                        </div>
                                    }
                                </div>
                            </div>

                        </div>
                    </div>
                </div>

                @* Completion Details *@
                @if (Model.Status == "Completed")
                {
                    <div class="bg-green-50 shadow-sm border border-green-200 flex flex-col">
                        <div class="p-5 border-b border-green-200 bg-[#10b981]">
                            <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-white mb-0"><i class="bi bi-check-circle me-2 text-green-200"></i> Completed Operation</h5>
                        </div>
                        <div class="p-6">
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-4">
                                <div>
                                    <span class="text-[9px] uppercase tracking-[2px] font-bold text-green-800/60 block mb-1">Completed On</span>
                                    <strong class="font-mono text-sm text-green-900">@(Model.DateCompleted.HasValue ? Model.DateCompleted.Value.ToString("dd MMM yyyy HH:mm") : "—")</strong>
                                </div>
                                <div>
                                    <span class="text-[9px] uppercase tracking-[2px] font-bold text-green-800/60 block mb-1">Final Condition</span>
                                    <span class="inline-flex items-center text-[9px] font-bold uppercase tracking-widest bg-white text-green-800 px-3 py-1 border border-green-200 shadow-sm">
                                        @Model.FinalCondition
                                    </span>
                                </div>
                                <div>
                                    <span class="text-[9px] uppercase tracking-[2px] font-bold text-green-800/60 block mb-1">Response Time</span>
                                    <strong class="font-mono text-sm text-green-700">@(Model.ResponseTimeMinutes.HasValue ? Model.ResponseTimeMinutes + " mins" : "—")</strong>
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(Model.CompletionNotes))
                            {
                                <div class="bg-white border-l-4 border-green-500 p-4 mt-4 shadow-sm">
                                    <p class="font-serif italic text-sm text-gray-700 m-0"><i class="bi bi-quote text-green-300 me-1"></i>@Model.CompletionNotes</p>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<style>
    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }

    .font-mono {
        font-family: 'Source Code Pro', monospace !important;
    }

    .custom-scrollbar::-webkit-scrollbar {
        width: 5px;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #eee;
        border-radius: 10px;
    }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #C21E2E;
        }
</style>

@section Scripts {
    <script>
        function autoAssign(jobCardId) {
            var btn = event.target;

            // Handle if the user clicked the icon inside the button
            if (btn.tagName.toLowerCase() === 'i') {
                btn = btn.parentElement;
            }

            btn.disabled = true;
            btn.innerHTML = '<i class="bi bi-arrow-repeat me-2 animate-spin inline-block"></i> Finding worker...';

            fetch('@Url.Action("AutoAssign", "Maintenance")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: 'jobCardId=' + jobCardId
            })
            .then(r => r.json())
            .then(data => {
                var result = document.getElementById('assignResult');
                result.classList.remove('hidden');

                if (data.success) {
                    result.className = 'bg-green-50 border-l-4 border-green-500 p-3 text-green-800 text-xs font-mono mt-3 shadow-sm block';
                    result.innerHTML = '<strong>' + data.workerName + '</strong> assigned.<br/>Skill: ' + data.workerSkill + ' · Phone: ' + data.workerPhone;
                    setTimeout(function() { location.reload(); }, 1500);
                } else {
                    result.className = 'bg-red-50 border-l-4 border-[#C21E2E] p-3 text-[#C21E2E] text-xs font-mono mt-3 shadow-sm block';
                    result.textContent = data.message;
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bi bi-robot me-2"></i> Auto-Assign Worker';
                }
            });
        }
    </script>
}
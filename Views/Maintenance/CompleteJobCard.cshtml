@model Michaelhouse.Models.JobCard
@{
    ViewBag.Title = "Complete Job Card";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="mb-10 d-flex justify-content-between align-items-end border-b border-gray-100 pb-8">
    <div>
        <div class="flex items-center gap-2 mb-3">
            <div class="h-1 w-8 bg-[#C21E2E]"></div>
            <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Maintenance</h5>
        </div>
        <h2 class="text-4xl font-serif font-bold text-gray-900 tracking-tight">Complete Job Card</h2>
        <p class="text-gray-400 text-[10px] uppercase tracking-widest font-bold mt-2">@Model.JobReference · @Model.Title</p>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                @using (Html.BeginForm("CompleteJobCard", "Maintenance", new { id = Model.Id }, FormMethod.Post, new { enctype = "multipart/form-data" }))
                {
                    @Html.AntiForgeryToken()
                    <div class="row g-3">
                        <!-- ══════════════════════════════════════════════════════ -->
                        <!-- PHOTO SECTION WITH CAMERA INTEGRATION                -->
                        <!-- ══════════════════════════════════════════════════════ -->
                        <div class="col-12">
                            <label class="form-label small fw-bold text-uppercase text-muted">After Photo (Proof) *</label>

                            <!-- Camera Button -->
                            <button type="button" class="btn btn-outline-secondary mb-2" onclick="openCamera()">
                                <i class="bi bi-camera me-1"></i> Open Camera
                            </button>

                            <!-- Video element for camera -->
                            <video id="videoElement" width="100%" style="max-width:400px; border-radius:8px; background:#000; display:none;" autoplay></video>

                            <!-- Capture button -->
                            <button id="captureBtn" type="button" class="btn btn-primary mt-2" style="display:none;" onclick="capturePhoto()">
                                <i class="bi bi-camera me-1"></i> Capture Photo
                            </button>

                            <!-- File upload as fallback -->
                            <div class="border p-3 text-center mt-2" style="cursor:pointer; background:#f8f9fa;" onclick="document.getElementById('photoInput').click();">
                                <input type="file" name="photoAfter" id="photoInput" accept="image/*" style="display:none" onchange="previewPhoto(this)" />
                                <div id="uploadPlaceholder">
                                    <i class="bi bi-cloud-upload fs-2 d-block mb-2 text-secondary"></i>
                                    <span class="text-muted">Click to upload a photo</span>
                                </div>
                                <img id="photoPreview" src="#" alt="Preview" style="display:none;max-width:100%;border-radius:8px;margin-top:10px;" />
                            </div>

                            <!-- Hidden field for base64 photo data -->
                            <input type="hidden" id="photoData" name="photoData" />
                        </div>

                        <div class="col-12">
                            <label class="form-label small fw-bold text-uppercase text-muted">Completion Notes *</label>
                            <textarea name="completionNotes" class="form-control" rows="4" placeholder="Describe exactly what you did..." required></textarea>
                        </div>

                        <div class="col-12">
                            <label class="form-label small fw-bold text-uppercase text-muted">Final Condition *</label>
                            <div class="row g-2">
                                @foreach (var opt in new[] {
                                    ("Fixed", "Fully repaired and working", "success"),
                                    ("Repaired Temporarily", "Short fix — needs permanent repair", "warning"),
                                    ("Needs Further Work", "Bigger problem — more help needed", "danger"),
                                    ("Replaced", "Old part replaced with new one", "info")
                                })
                                {
                                    <div class="col-md-6">
                                        <div class="border rounded p-2" style="background:#f8f9fa;">
                                            <label class="d-block">
                                                <input type="radio" name="finalCondition" value="@opt.Item1" required />
                                                <strong class="text-@opt.Item3">@opt.Item1</strong>
                                                <span class="text-muted small d-block ms-3">@opt.Item2</span>
                                            </label>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-success mt-3">
                        <i class="bi bi-info-circle me-2"></i> Completing will: calculate response time, update asset health score, free the worker's status, and notify the reporter.
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-success"><i class="bi bi-check-circle me-1"></i> Mark Job Complete</button>
                        <a href="@Url.Action("JobCardDetail", "Maintenance", new { id = Model.Id })" class="btn btn-outline-secondary ms-2"><i class="bi bi-arrow-left me-1"></i> Back</a>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0">
                <h5 class="mb-0 fw-bold"><i class="bi bi-clipboard me-2"></i>Job Summary</h5>
            </div>
            <div class="card-body">
                <ul class="list-unstyled">
                    <li class="d-flex justify-content-between border-bottom py-2"><span class="text-muted">Reference</span><code class="text-danger">@Model.JobReference</code></li>
                    <li class="d-flex justify-content-between border-bottom py-2"><span class="text-muted">Asset</span>@(Model.Asset != null ? Model.Asset.AssetName : "—")</li>
                    <li class="d-flex justify-content-between border-bottom py-2"><span class="text-muted">Location</span>@(Model.Asset != null ? Model.Asset.LocationBuilding : "—")</li>
                    <li class="d-flex justify-content-between border-bottom py-2"><span class="text-muted">Priority</span><span class="badge bg-@(Model.Priority=="Emergency"?"danger":Model.Priority=="High"?"warning":Model.Priority=="Medium"?"info":"secondary")">@Model.Priority</span></li>
                    <li class="d-flex justify-content-between border-bottom py-2"><span class="text-muted">Assigned To</span>@(Model.AssignedTo != null ? Model.AssignedTo.FullName : "—")</li>
                    <li class="d-flex justify-content-between py-2"><span class="text-muted">Time Open</span><span id="timeOpen" class="fw-bold text-danger">—</span></li>
                </ul>
                @if (!string.IsNullOrEmpty(Model.PhotoBefore))
                {
                    <div class="border rounded mt-3">
                        <div class="bg-light p-2 small text-muted text-uppercase fw-bold">Before Photo</div>
                        <img src="~/Content/JobPhotos/@Model.PhotoBefore" class="img-fluid" />
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // ── Camera Integration ──────────────────────────────────────────────
        let stream = null;

        function openCamera() {
            const video = document.getElementById('videoElement');
            if (navigator.mediaDevices && navigator.mediaDevices.getUserMedia) {
                navigator.mediaDevices.getUserMedia({ video: true })
                    .then(function (s) {
                        stream = s;
                        video.srcObject = s;
                        video.play();
                        video.style.display = 'block';
                        document.getElementById('captureBtn').style.display = 'inline';
                        document.getElementById('cameraBtn').style.display = 'none';
                    })
                    .catch(function (err) {
                        alert('Camera not available: ' + err.message);
                    });
            } else {
                alert('Camera not supported in this browser.');
            }
        }

        function capturePhoto() {
            const video = document.getElementById('videoElement');
            const canvas = document.createElement('canvas');
            canvas.width = video.videoWidth;
            canvas.height = video.videoHeight;
            const ctx = canvas.getContext('2d');
            ctx.drawImage(video, 0, 0, canvas.width, canvas.height);
            const dataUrl = canvas.toDataURL('image/png');

            // Show preview
            document.getElementById('photoPreview').src = dataUrl;
            document.getElementById('photoPreview').style.display = 'block';
            document.getElementById('uploadPlaceholder').style.display = 'none';

            // Set hidden input for base64 data
            document.getElementById('photoData').value = dataUrl;

            // Stop camera
            if (stream) {
                stream.getTracks().forEach(track => track.stop());
                video.srcObject = null;
                video.style.display = 'none';
            }
            document.getElementById('captureBtn').style.display = 'none';
        }

        // ── File Upload Preview ─────────────────────────────────────────────
        function previewPhoto(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('photoPreview').src = e.target.result;
                    document.getElementById('photoPreview').style.display = 'block';
                    document.getElementById('uploadPlaceholder').style.display = 'none';
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        // ── Time Open Counter ──────────────────────────────────────────────
        var created = new Date('@Model.DateCreated.ToString("yyyy-MM-ddTHH:mm:ss")');
        function updateTime() {
            var diff = Math.floor((new Date() - created) / 60000);
            var hours = Math.floor(diff / 60);
            var mins = diff % 60;
            document.getElementById('timeOpen').textContent = hours > 0 ? hours + 'h ' + mins + 'm' : mins + ' mins';
        }
        updateTime();
        setInterval(updateTime, 30000);
    </script>
}

@section Styles {
    <style>
        .font-serif {
            font-family: 'Playfair Display', serif !important;
        }
    </style>
}
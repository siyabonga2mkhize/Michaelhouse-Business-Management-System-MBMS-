@model Michaelhouse.Models.Asset
@{
    ViewBag.Title = "Asset Detail";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="mb-10 d-flex justify-content-between align-items-end border-b border-gray-100 pb-8">
    <div>
        <div class="flex items-center gap-2 mb-3">
            <div class="h-1 w-8 bg-[#C21E2E]"></div>
            <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Maintenance</h5>
        </div>
        <h2 class="text-4xl font-serif font-bold text-gray-900 tracking-tight">@Model.AssetName</h2>
        <p class="text-gray-400 text-[10px] uppercase tracking-widest font-bold mt-2">
            <code class="text-danger">@Model.QrCode</code> · @Model.LocationBuilding
            @if (!string.IsNullOrEmpty(Model.LocationRoom))
            {<text>— @Model.LocationRoom</text>}
        </p>
    </div>
    <div>
        <!-- Report Fault button (NEW) -->
        <a href="@Url.Action("ReportFaultFromScan", "Maintenance", new { assetId = Model.Id })" class="btn btn-outline-danger me-2">
            <i class="bi bi-exclamation-triangle me-1"></i> Report Fault
        </a>
        <a href="@Url.Action("QrCode", "Maintenance", new { id = Model.Id })" target="_blank" class="btn btn-outline-secondary me-2">
            <i class="bi bi-qr-code me-1"></i> QR Code
        </a>
        <a href="@Url.Action("EditAsset", "Maintenance", new { id = Model.Id })" class="btn btn-dark">
            <i class="bi bi-pencil me-1"></i> Edit Asset
        </a>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0">
                <h5 class="mb-0 fw-bold"><i class="bi bi-info-circle me-2"></i>Asset Details</h5>
            </div>
            <div class="card-body">
                <div class="text-center mb-3">
                    <img src="@Url.Action("QrCode", "Maintenance", new { id = Model.Id })" alt="QR Code" style="width:150px;" />
                    <div class="small text-muted">Scan to report a fault</div>
                    <code class="text-danger">@Model.QrCode</code>
                </div>
                <ul class="list-unstyled">
                    <li class="d-flex justify-content-between border-bottom py-2"><span class="text-muted">Category</span><span class="badge bg-secondary">@Model.Category</span></li>
                    <li class="d-flex justify-content-between border-bottom py-2"><span class="text-muted">Building</span>@Model.LocationBuilding</li>
                    @if (!string.IsNullOrEmpty(Model.LocationRoom))
                    {
                        <li class="d-flex justify-content-between border-bottom py-2"><span class="text-muted">Room</span>@Model.LocationRoom</li>
                    }
                    <li class="d-flex justify-content-between border-bottom py-2"><span class="text-muted">Condition</span><span class="badge bg-@(Model.ConditionRating=="Good"?"success":Model.ConditionRating=="Fair"?"warning":"danger")">@Model.ConditionRating</span></li>
                    <li class="d-flex justify-content-between border-bottom py-2"><span class="text-muted">Status</span><span class="badge bg-@(Model.Status=="Active"?"success":Model.Status=="Under Repair"?"warning":"secondary")">@Model.Status</span></li>
                    <li class="d-flex justify-content-between border-bottom py-2"><span class="text-muted">Fault Count</span><span class="fw-bold @(Model.FaultCount > 3 ? "text-danger" : "")">@Model.FaultCount</span></li>
                    <li class="d-flex justify-content-between py-2"><span class="text-muted">Registered</span>@Model.DateRegistered.ToString("dd MMM yyyy")</li>
                </ul>
                <div class="mt-3">
                    <div class="d-flex justify-content-between"><span class="text-muted small">Health Score</span><span class="fw-bold text-@(Model.HealthScore > 70 ? "success" : Model.HealthScore > 40 ? "warning" : "danger")">@Model.HealthScore%</span></div>
                    <div class="progress" style="height:8px;">
                        <div class="progress-bar bg-@(Model.HealthScore > 70 ? "success" : Model.HealthScore > 40 ? "warning" : "danger")" style="width:@Model.HealthScore%"></div>
                    </div>
                </div>
                @if (!string.IsNullOrEmpty(Model.Description))
                {
                    <div class="alert alert-secondary mt-3"><i class="bi bi-quote me-1"></i> @Model.Description</div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 d-flex justify-content-between">
                <h5 class="mb-0 fw-bold"><i class="bi bi-clock-history me-2"></i>Job History</h5>
                <a href="@Url.Action("JobCards", "Maintenance")" class="btn btn-sm btn-outline-secondary">New Job</a>
            </div>
            <div class="card-body p-0">
                @if (ViewBag.JobHistory != null && ((List<Michaelhouse.Models.JobCard>)ViewBag.JobHistory).Any())
                {
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Reference</th>
                                <th>Title</th>
                                <th>Priority</th>
                                <th>Status</th>
                                <th>Assigned To</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var j in (List<Michaelhouse.Models.JobCard>)ViewBag.JobHistory)
                            {
                                <tr>
                                    <td><code class="text-danger">@j.JobReference</code></td>
                                    <td>@j.Title</td>
                                    <td><span class="badge bg-@(j.Priority=="Emergency"?"danger":j.Priority=="High"?"warning":j.Priority=="Medium"?"info":"secondary")">@j.Priority</span></td>
                                    <td><span class="badge bg-@(j.Status=="Completed"?"success":j.Status=="In Progress"||j.Status=="Assigned"?"warning":"secondary")">@j.Status</span></td>
                                    <td>@(j.AssignedTo != null ? j.AssignedTo.FullName : "Unassigned")</td>
                                    <td>@j.DateCreated.ToString("dd MMM yyyy")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-clipboard fs-1 d-block mb-2"></i>
                        <p>No job cards yet for this asset.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .font-serif {
            font-family: 'Playfair Display', serif !important;
        }
    </style>
}
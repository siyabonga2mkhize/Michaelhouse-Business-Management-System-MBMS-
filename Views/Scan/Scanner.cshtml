﻿@{
    ViewBag.Title = "Scan Asset QR Code";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container py-4">
    <h2 class="font-serif fw-bold">Scan Asset QR Code</h2>
    <p class="text-muted">Point your camera at the QR code on any asset to report a fault.</p>

    <div id="reader" style="width:100%; max-width:400px; margin: 20px auto;"></div>
    <div id="result" class="mt-3"></div>
</div>

@section Styles {
    <style>
        #reader video {
            border-radius: 12px;
            border: 2px solid #C21E2E;
        }

        #reader {
            border: none !important;
            border-radius: 0 !important;
        }

        #reader__scan_region {
            border: 2px solid #C21E2E !important;
            background-color: #000;
        }

        #reader button {
            background-color: #1a1a1a !important;
            color: white !important;
            font-family: 'Source Code Pro', monospace !important;
            font-size: 9px !important;
            font-weight: bold !important;
            text-transform: uppercase !important;
            letter-spacing: 2px !important;
            padding: 8px 16px !important;
            border: none !important;
            cursor: pointer !important;
            transition: background-color 0.2s !important;
            margin-top: 10px !important;
        }

            #reader button:hover {
                background-color: #C21E2E !important;
            }

        #reader select {
            font-family: 'Source Code Pro', monospace !important;
            font-size: 11px !important;
            padding: 6px !important;
            border: 1px solid #ddd !important;
            outline: none !important;
            margin-bottom: 10px !important;
            width: 100%;
        }

        #reader a {
            color: #C21E2E !important;
            text-decoration: none !important;
            font-family: 'Source Code Pro', monospace;
            font-size: 10px;
        }
    </style>
}

@section Scripts {
    @* Use the same local script as the student scanner *@
    <script src="@Url.Content("~/Scripts/html5-qrcode.min.js")"></script>
    <script>
        (function () {
            const readerDiv = document.getElementById("reader");
            const resultDiv = document.getElementById("result");

            if (!readerDiv) {
                resultDiv.innerHTML = '<div class="alert alert-danger">Scanner initialization failed.</div>';
                return;
            }

            let isScanning = true;

            function onScanSuccess(decodedText, decodedResult) {
                if (!isScanning) return;

                // Only redirect if the scanned URL is from this site (security)
                if (decodedText.indexOf(window.location.origin) === 0) {
                    isScanning = false;
                    html5QrcodeScanner.pause(true); // freeze camera

                    // Show success feedback
                    resultDiv.innerHTML = '<div class="alert alert-success"><i class="bi bi-check-circle-fill me-2"></i>Scan Successful. Redirecting...</div>';

                    // Redirect to the scanned URL (which points to /Scan/Index/{assetCode})
                    window.location.href = decodedText;
                } else {
                    // Invalid QR Code (not a local URL)
                    html5QrcodeScanner.pause(true);
                    resultDiv.innerHTML = '<div class="alert alert-danger"><i class="bi bi-x-octagon-fill me-2"></i>Invalid QR Code: Unrecognized protocol.</div>';

                    setTimeout(() => {
                        resultDiv.innerHTML = '';
                        html5QrcodeScanner.resume();
                        isScanning = true;
                    }, 2500);
                }
            }

            function onScanError(errorMessage) {
                // Ignore – background noise
                // console.warn(errorMessage);
            }

            var html5QrcodeScanner = new Html5QrcodeScanner("reader", {
                fps: 10,
                qrbox: 250,
                rememberLastUsedCamera: true,
                showTorchButtonIfSupported: true
            });

            html5QrcodeScanner.render(onScanSuccess, onScanError);
        })();
    </script>
}
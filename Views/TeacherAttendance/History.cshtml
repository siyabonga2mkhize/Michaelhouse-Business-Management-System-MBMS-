@model IEnumerable<Michaelhouse.Models.TeacherAttendance>

@{
    ViewBag.Title = "Attendance History";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-clock-history me-2"></i>Attendance History</h2>
        <a href="@Url.Action("Index", "TeacherAttendance")" class="btn btn-outline-primary">
            <i class="bi bi-arrow-left me-2"></i>Back to Check In/Out
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">Date</th>
                        <th>Check In</th>
                        <th>Check Out</th>
                        <th>Duration</th>
                        <th>Status</th>
                        <th>Verified</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted py-4">
                                No attendance records found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 align-middle">@item.Date.ToString("dd MMM yyyy")</td>
                                <td class="align-middle">
                                    @(item.SignInTime?.ToString("HH:mm") ?? "-")
                                </td>
                                <td class="align-middle">
                                    @(item.SignOutTime?.ToString("HH:mm") ?? "-")
                                </td>
                                <td class="align-middle">
                                    @if (item.SignInTime != null && item.SignOutTime != null)
                                    {
                                        var duration = item.SignOutTime.Value - item.SignInTime.Value;
                                        <span>@duration.Hoursh @duration.Minutesm</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">-</span>
                                    }
                                </td>
                                <td class="align-middle">
                                    <span class="badge @(item.Status == TeacherStatus.Present ? "bg-success" : item.Status == TeacherStatus.Leave ? "bg-warning" : "bg-secondary")">
                                        @item.Status
                                    </span>
                                </td>
                                <td class="align-middle">
                                    @if (item.IsVerified)
                                    {
                                        <i class="bi bi-check-circle-fill text-success"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle-fill text-danger"></i>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

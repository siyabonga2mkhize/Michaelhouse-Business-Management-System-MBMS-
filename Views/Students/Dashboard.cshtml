@using Michaelhouse.Models.Enums
@using Michaelhouse.Services
@{
    ViewBag.Title = "Student Dashboard";
    var student = (Michaelhouse.Models.Student)ViewBag.Student;
    var reg = (Michaelhouse.Models.Registration)ViewBag.Registration;
    var subjects = (List<Michaelhouse.Models.StudentSubject>)ViewBag.Subjects;
    var streamEnr = (Michaelhouse.Models.StreamEnrolment)ViewBag.StreamEnrolment;

    // Fixes the DynamicProxy name issue for the student
    string studentName = student != null ? student.Name : "Student Record";
    // Fixes the DynamicProxy name issue for the guardian
    string guardianName = (student != null && student.Parent != null) ? student.Parent.Name : "Guardian Unspecified";
}

<div class="relative mb-12 border-b border-gray-100 bg-gray-50/30 py-12 px-4 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none"
         style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 24px 24px;"></div>

    <i class="bi bi-mortarboard absolute -right-8 -bottom-10 text-black/5 text-[15rem] rotate-12"></i>

    <div class="max-w-6xl mx-auto relative z-10 flex justify-between align-items-end">
        <div>
            <div class="flex items-center gap-2 mb-3">
                <div class="h-1 w-8 bg-[#C21E2E]"></div>
                <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Student Portal</h5>
            </div>
            <h2 class="text-4xl font-serif font-bold text-gray-900 tracking-tight">Greetings, @(student != null && student.FirstName != null ? student.FirstName : "Student")</h2>
            <p class="text-gray-400 text-[10px] uppercase tracking-widest font-bold mt-2">
                @if (reg != null)
                {
                    <text>Grade @reg.GradeEnrolling</text>
                    if (streamEnr != null && streamEnr.Stream != AcademicStream.None)
                    {
                        <text> &bull; @RegistrationService.GetStreamName(streamEnr.Stream) Faculty</text>
                    }
                }
            </p>
        </div>
        <div class="text-end">
            <span class="px-4 py-1.5 border border-amber-200 bg-amber-50 text-amber-600 text-[9px] font-bold uppercase tracking-[2px]">
                @(reg != null && reg.Status == RegistrationStatus.Completed ? "Formalized Enrollment" : "Registration Pending")
            </span>
        </div>
    </div>
</div>

<div class="max-w-6xl mx-auto px-4 pb-20">
    <div class="row g-5">

        <div class="col-lg-4">
            <div class="bg-white border-l-4 border-gray-900 shadow-sm p-8 mb-8 relative overflow-hidden">
                <i class="bi bi-person-vcard absolute -right-4 -top-4 text-black/5 text-8xl"></i>
                <h6 class="text-[10px] uppercase tracking-[3px] font-bold text-gray-400 mb-6">Personal Dossier</h6>

                <div class="space-y-4 relative z-10">
                    <div>
                        <label class="text-[9px] uppercase tracking-widest font-bold text-gray-400 block mb-1">Legal Name</label>
                        <p class="text-sm font-bold text-gray-900 mb-0">@studentName</p>
                    </div>
                    <div>
                        <label class="text-[9px] uppercase tracking-widest font-bold text-gray-400 block mb-1">Institutional ID</label>
                        <p class="text-sm font-monospace text-gray-600 mb-0">@(student != null && student.IdNumber != null ? student.IdNumber : "—")</p>
                    </div>
                    <div>
                        <label class="text-[9px] uppercase tracking-widest font-bold text-gray-400 block mb-1">Home Language</label>
                        <p class="text-sm font-bold text-gray-800 mb-0">@(student != null && student.HomeLanguage != null ? student.HomeLanguage : "—")</p>
                    </div>
                </div>
            </div>

            @if (streamEnr != null && streamEnr.Stream != AcademicStream.None)
            {
                string icon = RegistrationService.GetStreamIcon(streamEnr.Stream);
                string name = RegistrationService.GetStreamName(streamEnr.Stream);

                <div class="bg-white border border-[#C21E2E] p-8 text-center relative overflow-hidden shadow-lg">
                    <i class="bi @icon absolute -right-6 -bottom-6 text-black/5 text-9xl"></i>
                    <div class="relative z-10">
                        <div class="h-12 w-12 bg-red-50 text-[#C21E2E] rounded-full flex items-center justify-center mx-auto mb-4">
                            <i class="bi @icon text-2xl"></i>
                        </div>
                        <h5 class="font-serif font-bold text-gray-900 mb-1">@name</h5>
                        <p class="text-[9px] uppercase tracking-widest font-bold text-gray-400 mb-4">Faculty Allocation</p>
                        <span class="text-[10px] font-bold uppercase tracking-widest px-3 py-1 bg-gray-900 text-white">
                            @(streamEnr.TakesMathematics ? "Core Mathematics" : "Mathematical Literacy")
                        </span>
                    </div>
                </div>
            }
        </div>

        <div class="col-lg-8">
            <div class="bg-white border border-gray-100 shadow-sm overflow-hidden">
                <div class="p-4 border-b border-gray-100 bg-gray-50/50 d-flex justify-content-between align-items-center">
                    <h6 class="text-[10px] uppercase tracking-[3px] font-bold text-gray-900 mb-0">Current Curriculum Package</h6>
                    @if (subjects != null)
                    {
                        <span class="text-[9px] font-bold uppercase text-gray-400">@subjects.Count Modules Active</span>
                    }
                </div>

                @if (subjects != null && subjects.Any())
                {
                    var compulsory = subjects.Where(s => s.IsCompulsory).ToList();
                    var langAndMaths = subjects.Where(s => !s.IsCompulsory && s.Stream == AcademicStream.None).ToList();
                    var streamSubs = subjects.Where(s => s.Stream != AcademicStream.None).ToList();

                    <div class="divide-y divide-gray-50">
                        @if (compulsory.Any())
                        {
                            <div class="bg-gray-50/30 px-6 py-2 border-b border-gray-50">
                                <span class="text-[8px] font-bold uppercase tracking-[3px] text-gray-400">Core Requirements</span>
                            </div>
                            foreach (var ss in compulsory)
                            {
                                <div class="p-4 px-8 d-flex justify-content-between align-items-center group">
                                    <span class="text-sm font-bold text-gray-700 uppercase tracking-tight group-hover:text-[#C21E2E] transition-colors">@(ss.Subject != null && ss.Subject.Name != null ? ss.Subject.Name : "Module")</span>
                                    <span class="text-[8px] font-bold uppercase tracking-widest text-gray-300 border border-gray-100 px-2 py-0.5">Core</span>
                                </div>
                            }
                        }

                        @if (langAndMaths.Any())
                        {
                            <div class="bg-gray-50/30 px-6 py-2 border-y border-gray-50">
                                <span class="text-[8px] font-bold uppercase tracking-[3px] text-gray-400">Language & Analytics</span>
                            </div>
                            foreach (var ss in langAndMaths)
                            {
                                bool isMaths = ss.Subject != null && RegistrationService.MathsOptions.Contains(ss.Subject.Name);
                                <div class="p-4 px-8 d-flex justify-content-between align-items-center group">
                                    <span class="text-sm font-bold text-gray-700 uppercase tracking-tight group-hover:text-[#C21E2E] transition-colors">@(ss.Subject != null && ss.Subject.Name != null ? ss.Subject.Name : "Module")</span>>>
                                    <span class="text-[8px] font-bold uppercase tracking-widest text-[#C21E2E] border border-[#C21E2E] px-2 py-0.5">@(isMaths ? "Mathematics" : "Language")</span>
                                </div>
                            }
                        }

                        @if (streamSubs.Any())
                        {
                            <div class="bg-gray-50/30 px-6 py-2 border-y border-gray-50">
                                <span class="text-[8px] font-bold uppercase tracking-[3px] text-gray-400">Faculty Electives</span>
                            </div>
                            foreach (var ss in streamSubs)
                            {
                                <div class="p-4 px-8 d-flex justify-content-between align-items-center group">
                                    <span class="text-sm font-bold text-gray-700 uppercase tracking-tight group-hover:text-[#C21E2E] transition-colors">@(ss.Subject != null && ss.Subject.Name != null ? ss.Subject.Name : "Module")</span>
                                    <span class="text-[8px] font-bold uppercase tracking-widest text-green-600 border border-green-100 px-2 py-0.5 bg-green-50/30">Elective</span>
                                </div>
                            }
                        }
                    </div>
                }
                else
                {
                    <div class="p-20 text-center text-gray-400 italic font-serif">
                        <i class="bi bi-journal-x text-4xl block mb-3 opacity-20"></i>
                        Academic record not yet initialized.
                    </div>
                }
            </div>

            <div class="mt-8 bg-gray-900 p-6 shadow-sm d-flex justify-content-between align-items-center relative overflow-hidden">
                <i class="bi bi-people absolute -right-4 -bottom-4 text-white/5 text-6xl"></i>
                <div class="relative z-10">
                    <h6 class="text-[9px] uppercase tracking-[3px] font-bold text-gray-500 mb-1">Associated Guardian</h6>
                    <p class="text-sm font-bold text-white mb-0">@guardianName</p>
                </div>
                <div class="text-end relative z-10">
                    <p class="text-[10px] font-monospace text-gray-400 mb-0">@(student != null && student.Parent != null && student.Parent.Contact != null ? student.Parent.Contact : "Contact Missing")</p>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }

    .divide-y > * + * {
        border-top-width: 1px;
    }
</style>
@section Scripts {
    <script>
       // --- CRITICAL DASHBOARD EMERGENCY OVERRIDE ---
function checkEmergencyOverride() {
    var role = '@Session["UserRole"]';
    if (role !== 'Student') return;
        }

        // Start the loop 5 seconds after the page loads, and repeat every 10 seconds.
        $(document).ready(function () {
            setTimeout(checkEmergencyOverride, 5000);
            setInterval(checkEmergencyOverride, 10000);
        });
    </script>
}
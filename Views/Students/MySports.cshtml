@model IEnumerable<Michaelhouse.Models.TeamMembership>
@{
    ViewBag.Title = "My Sports";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var list = Model.ToList();
}

<div class="relative mb-8 border-b border-gray-100 bg-gray-50/30 py-8 px-4 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none"
         style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 24px 24px;"></div>
    <i class="bi bi-trophy absolute -right-8 -bottom-10 text-black/5 text-[12rem] rotate-12"></i>

    <div class="max-w-4xl mx-auto relative z-10">
        <div class="flex items-center gap-2 mb-3">
            <div class="h-1 w-8 bg-[#C21E2E]"></div>
            <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Student Portal</h5>
        </div>
        <h2 class="text-3xl font-serif font-bold text-gray-900 tracking-tight">My Sports & Teams</h2>
        <p class="text-gray-400 text-[10px] uppercase tracking-widest font-bold mt-2">
            Manage your sport participation
        </p>
    </div>
</div>

<div class="max-w-4xl mx-auto px-4 pb-20">

    <div class="bg-blue-50 border-l-4 border-blue-500 p-4 mb-6">
        <h6 class="text-[10px] uppercase tracking-widest font-bold text-blue-700 mb-1">
            <i class="bi bi-info-circle me-1"></i>How sports work
        </h6>
        <p class="text-sm text-blue-800 mb-0">
            To join a sport, contact your coach or the Sports Director. Team placement is approved by school sports staff.
            Your active memberships are shown below.
        </p>
    </div>

    <div class="bg-white border border-gray-100 shadow-sm overflow-hidden">
        <div class="p-4 border-b border-gray-100 bg-gray-50/50">
            <h6 class="text-[10px] uppercase tracking-[3px] font-bold text-gray-900 mb-0">
                Active Memberships (@list.Count(m => m.EndDate == null))
            </h6>
        </div>

        @if (!list.Any())
        {
            <div class="p-12 text-center">
                <i class="bi bi-trophy text-5xl block mb-3 text-gray-300"></i>
                <p class="text-gray-500 mb-0">You are not currently a member of any team.</p>
            </div>
        }
        else
        {
            <div class="divide-y divide-gray-50">
                @foreach (var m in list)
                {
                    <div class="p-4 flex justify-between items-center">
                        <div>
                            <div class="flex items-center gap-2 mb-1">
                                @if (m.EndDate == null && m.Status == Michaelhouse.Models.Enums.TeamMembershipStatus.Active)
                                {<span class="text-[8px] font-bold uppercase tracking-widest px-2 py-0.5 bg-green-500 text-white">Active</span> }
                                else if (m.Status == Michaelhouse.Models.Enums.TeamMembershipStatus.Pending)
                                { <span class="text-[8px] font-bold uppercase tracking-widest px-2 py-0.5 bg-amber-500 text-white">Pending Approval</span> }
                                else if (m.EndDate != null || m.Status == Michaelhouse.Models.Enums.TeamMembershipStatus.Left)
                                { <span class="text-[8px] font-bold uppercase tracking-widest px-2 py-0.5 bg-gray-300 text-gray-700">Left</span> }
                                else
                                { <span class="text-[8px] font-bold uppercase tracking-widest px-2 py-0.5 bg-gray-700 text-white">@m.Status</span>}
                            </div>
                            <p class="text-sm font-bold text-gray-900 mb-0">@(m.Team?.Name ?? "Team")</p>
                            <p class="text-[10px] uppercase tracking-widest font-bold text-gray-400 mb-0">
                                @(m.Team?.Sport?.Name ?? m.Team?.SportName ?? "")
                                @if (m.Team?.Coach != null)
                                {<text> &bull; Coach: @m.Team.Coach.Name @m.Team.Coach.Surname</text>}
                            </p>
                        </div>
                        <div class="text-right">
                            <p class="text-[9px] text-gray-400 mb-0">Since @m.StartDate.ToString("dd MMM yyyy")</p>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<style>
    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }

    .divide-y > * + * {
        border-top-width: 1px;
    }
</style>
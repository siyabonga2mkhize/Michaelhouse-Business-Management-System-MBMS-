@model IEnumerable<Michaelhouse.Models.StudentDietaryRecord>
@{
    ViewBag.Title = "My Dietary Information";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var pending = ViewBag.PendingRequests as List<Michaelhouse.Models.DietaryChangeRequest> ?? new List<Michaelhouse.Models.DietaryChangeRequest>();
    var list = Model.ToList();
}

<div class="relative mb-8 border-b border-gray-100 bg-gray-50/30 py-8 px-4 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none"
         style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 24px 24px;"></div>
    <i class="bi bi-shield-check absolute -right-8 -bottom-10 text-black/5 text-[12rem] rotate-12"></i>

    <div class="max-w-4xl mx-auto relative z-10 flex justify-between items-end">
        <div>
            <div class="flex items-center gap-2 mb-3">
                <div class="h-1 w-8 bg-[#C21E2E]"></div>
                <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Student Portal</h5>
            </div>
            <h2 class="text-3xl font-serif font-bold text-gray-900 tracking-tight">Dietary Information</h2>
            <p class="text-gray-400 text-[10px] uppercase tracking-widest font-bold mt-2">
                Your allergies, medical restrictions and preferences
            </p>
        </div>
        <a href="@Url.Action("RequestDietaryChange", "Students")"
           class="bg-[#C21E2E] text-white px-6 py-3 text-[10px] font-bold uppercase tracking-widest hover:bg-black">
            <i class="bi bi-plus-circle me-2"></i>Request Change
        </a>
    </div>
</div>

<div class="max-w-4xl mx-auto px-4 pb-20">

    <div class="bg-blue-50 border-l-4 border-blue-500 p-4 mb-6">
        <h6 class="text-[10px] uppercase tracking-widest font-bold text-blue-700 mb-1">
            <i class="bi bi-info-circle me-1"></i>How this works
        </h6>
        <p class="text-sm text-blue-800 mb-0">
            Changes to allergies or medical restrictions require review by the Dietitian before they take effect.
            Until then, your <strong>current approved information remains the official record</strong> for meal safety.
        </p>
    </div>

    @if (pending.Any())
    {
        <div class="bg-white border border-gray-100 shadow-sm overflow-hidden mb-6">
            <div class="p-4 border-b border-gray-100 bg-amber-50">
                <h6 class="text-[10px] uppercase tracking-[3px] font-bold text-amber-800 mb-0">
                    <i class="bi bi-clock-history me-1"></i>Pending Requests (@pending.Count)
                </h6>
            </div>
            <div class="divide-y divide-gray-50">
                @foreach (var p in pending)
                {
                    <div class="p-4 flex justify-between items-start">
                        <div>
                            <div class="flex items-center gap-2 mb-1">
                                <span class="text-[8px] font-bold uppercase tracking-widest px-2 py-0.5 bg-amber-500 text-white">Pending</span>
                                <span class="text-[8px] font-bold uppercase tracking-widest px-2 py-0.5 bg-gray-700 text-white">@p.RecordType</span>
                                @if (p.SafetyReviewRequired)
                                {<span class="text-[8px] font-bold uppercase tracking-widest px-2 py-0.5 bg-red-600 text-white">Safety Review</span>}
                            </div>
                            <p class="text-sm text-gray-900 font-bold mb-0">@(p.RequestedDescription ?? "—")</p>
                            @if (!string.IsNullOrEmpty(p.Reason))
                            {<p class="text-xs text-gray-500 mt-1 mb-0"><em>@p.Reason</em></p>}
                            <p class="text-[9px] text-gray-400 mt-1 mb-0">
                                Submitted @p.SubmittedAt.ToString("dd MMM yyyy HH:mm")
                            </p>
                        </div>
                        @using (Html.BeginForm("WithdrawDietaryRequest", "Students", new { id = p.Id }, FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <button type="submit" class="text-[9px] font-bold uppercase tracking-widest text-red-600 hover:text-red-800"
                                    onclick="return confirm('Withdraw this request?');">
                                Withdraw
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    }

    <div class="bg-white border border-gray-100 shadow-sm overflow-hidden">
        <div class="p-4 border-b border-gray-100 bg-gray-50/50">
            <h6 class="text-[10px] uppercase tracking-[3px] font-bold text-gray-900 mb-0">
                Approved Records (@list.Count(r => r.IsActive && r.Status == Michaelhouse.Models.Enums.DietaryRequestStatus.Approved))
            </h6>
        </div>

        @if (!list.Any())
        {
            <div class="p-12 text-center">
                <i class="bi bi-shield-check text-5xl block mb-3 text-green-400"></i>
                <p class="text-gray-500 text-lg font-bold mb-2">No dietary records on file.</p>
                <p class="text-gray-400 text-sm mb-6">You have no allergies, medical restrictions or dietary preferences recorded.</p>
                <a href="@Url.Action("RequestDietaryChange", "Students")"
                   class="inline-block bg-[#C21E2E] text-white px-6 py-3 text-[10px] font-bold uppercase tracking-widest hover:bg-black">
                    Add Your First Dietary Information
                </a>
            </div>
        }
        else
        {
            <div class="divide-y divide-gray-50">
                @foreach (var r in list)
                {
                    <div class="p-4 flex justify-between items-start">
                        <div>
                            <div class="flex items-center gap-2 mb-1">
                                @if (r.IsActive && r.Status == Michaelhouse.Models.Enums.DietaryRequestStatus.Approved)
                                {<span class="text-[8px] font-bold uppercase tracking-widest px-2 py-0.5 bg-green-500 text-white">Active</span> }
                                else if (r.Status == Michaelhouse.Models.Enums.DietaryRequestStatus.Pending)
                                { <span class="text-[8px] font-bold uppercase tracking-widest px-2 py-0.5 bg-amber-500 text-white">Pending</span> }
                                else if (r.Status == Michaelhouse.Models.Enums.DietaryRequestStatus.Rejected)
                                { <span class="text-[8px] font-bold uppercase tracking-widest px-2 py-0.5 bg-red-600 text-white">Rejected</span> }
                                else
                                { <span class="text-[8px] font-bold uppercase tracking-widest px-2 py-0.5 bg-gray-300 text-gray-700">@r.Status</span>}
                                <span class="text-[8px] font-bold uppercase tracking-widest px-2 py-0.5 bg-gray-700 text-white">@r.RecordType</span>
                            </div>
                            <p class="text-sm font-bold text-gray-900 mb-0">
                                @(r.Allergen != null ? r.Allergen.Name : (r.DietaryCategory != null ? r.DietaryCategory.Name : r.CustomDescription))
                            </p>
                            @if (!string.IsNullOrEmpty(r.ReviewNotes))
                            {<p class="text-xs text-gray-500 mt-1 mb-0"><em>@r.ReviewNotes</em></p>}
                        </div>
                        <div class="text-right">
                            <p class="text-[9px] text-gray-400 mb-0">
                                @if (r.ApprovedAt.HasValue)
                                {<text>Approved @r.ApprovedAt.Value.ToString("dd MMM yyyy")</text> }
                            else
                            { <text>Requested @r.RequestedAt.ToString("dd MMM yyyy")</text>}
                            </p>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<style>
    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }

    .divide-y > * + * {
        border-top-width: 1px;
    }
</style>
@{
    ViewBag.Title = "Request Dietary Change";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var allergens = ViewBag.Allergens as List<Michaelhouse.Models.Allergen> ?? new List<Michaelhouse.Models.Allergen>();
    var categories = ViewBag.Categories as List<Michaelhouse.Models.DietaryCategory> ?? new List<Michaelhouse.Models.DietaryCategory>();
}

<div class="relative mb-8 border-b border-gray-100 bg-gray-50/30 py-8 px-4 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none"
         style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 24px 24px;"></div>
    <i class="bi bi-clipboard-plus absolute -right-8 -bottom-10 text-black/5 text-[12rem] rotate-12"></i>

    <div class="max-w-2xl mx-auto relative z-10">
        <div class="flex items-center gap-2 mb-3">
            <div class="h-1 w-8 bg-[#C21E2E]"></div>
            <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Student Portal</h5>
        </div>
        <h2 class="text-3xl font-serif font-bold text-gray-900 tracking-tight">Request Dietary Change</h2>
        <p class="text-gray-400 text-[10px] uppercase tracking-widest font-bold mt-2">
            All requests are reviewed by a Dietitian
        </p>
    </div>
</div>

<div class="max-w-2xl mx-auto px-4 pb-20">

    <div class="bg-blue-50 border-l-4 border-blue-500 p-4 mb-6">
        <h6 class="text-[10px] uppercase tracking-widest font-bold text-blue-700 mb-1">
            <i class="bi bi-info-circle me-1"></i>Important
        </h6>
        <p class="text-sm text-blue-800 mb-0">
            Allergy and medical restriction changes require <strong>safety review</strong> before they affect your meal plan.
            Your existing approved restrictions remain in effect until the new request is approved.
        </p>
    </div>

    @using (Html.BeginForm("RequestDietaryChange", "Students", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="bg-white border border-gray-100 shadow-sm overflow-hidden mb-6">
            <div class="p-4 border-b border-gray-100 bg-gray-50/50">
                <h6 class="text-[10px] uppercase tracking-[3px] font-bold text-gray-900 mb-0">
                    <i class="bi bi-clipboard-plus me-2 text-[#C21E2E]"></i>Request Details
                </h6>
            </div>

            <div class="p-6 space-y-5">
                <div>
                    <label class="block text-[9px] uppercase tracking-widest font-bold text-gray-400 mb-2">Record Type *</label>
                    <select name="recordType" id="recordType" required
                            class="w-full border border-gray-200 py-3 px-4 text-sm"
                            onchange="updateFormVisibility();">
                        <option value="0">Allergy (Safety Review)</option>
                        <option value="1">Medical Restriction (Safety Review)</option>
                        <option value="2">Dietary Preference</option>
                        <option value="3">Religious / Cultural</option>
                        <option value="4">Food Dislike</option>
                    </select>
                </div>

                <div id="allergenRow" style="display:none;">
                    <label class="block text-[9px] uppercase tracking-widest font-bold text-gray-400 mb-2">Which Allergen?</label>
                    <select name="allergenId" class="w-full border border-gray-200 py-3 px-4 text-sm">
                        <option value="">— Select Allergen —</option>
                        @foreach (var a in allergens)
                        {
                            <option value="@a.Id">@a.Name</option>
                        }
                    </select>
                </div>

                <div id="categoryRow" style="display:none;">
                    <label class="block text-[9px] uppercase tracking-widest font-bold text-gray-400 mb-2">Which Dietary Category?</label>
                    <select name="categoryId" class="w-full border border-gray-200 py-3 px-4 text-sm">
                        <option value="">— Select Category —</option>
                        @foreach (var c in categories)
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="block text-[9px] uppercase tracking-widest font-bold text-gray-400 mb-2">
                        Description <span id="descHint" class="text-gray-400 font-normal">(optional)</span>
                    </label>
                    <input type="text" name="customDescription"
                           class="w-full border border-gray-200 py-3 px-4 text-sm"
                           placeholder="e.g. Peanuts, shellfish, lactose intolerance" />
                </div>

                <div>
                    <label class="block text-[9px] uppercase tracking-widest font-bold text-gray-400 mb-2">
                        Reason <span class="text-gray-400 font-normal">(optional but recommended)</span>
                    </label>
                    <textarea name="reason" rows="3" class="w-full border border-gray-200 py-3 px-4 text-sm"
                              placeholder="e.g. Recently diagnosed by doctor, symptoms after eating..."></textarea>
                </div>
            </div>
        </div>

        <div class="bg-white border border-gray-100 p-4 flex justify-between items-center">
            <a href="@Url.Action("MyDietary", "Students")"
               class="text-[10px] font-bold uppercase tracking-widest text-gray-500 hover:text-[#C21E2E]">
                <i class="bi bi-arrow-left me-2"></i>Cancel
            </a>
            <button type="submit"
                    class="bg-[#C21E2E] text-white px-8 py-3 text-[10px] font-bold uppercase tracking-widest hover:bg-black">
                <i class="bi bi-send me-2"></i>Submit Request
            </button>
        </div>
    }

    <script>
        function updateFormVisibility() {
            var type = document.getElementById('recordType').value;
            document.getElementById('allergenRow').style.display = (type === '0') ? 'block' : 'none';
            document.getElementById('categoryRow').style.display = (type === '2') ? 'block' : 'none';

            var hint = document.getElementById('descHint');
            if (type === '0') hint.textContent = '(describe if not in list above)';
            else if (type === '1') hint.textContent = '(required for medical restriction)';
            else if (type === '2') hint.textContent = '(describe if not in list above)';
            else hint.textContent = '(required)';
        }
        document.addEventListener('DOMContentLoaded', updateFormVisibility);
    </script>
</div>

<style>
    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }
</style>
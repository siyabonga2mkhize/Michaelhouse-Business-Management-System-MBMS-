@using Michaelhouse.Models
@model List<ParentAttendanceViewModel>
@{
    ViewBag.Title = "My Children's Attendance";
    var summary = ViewBag.AttendanceSummary as List<Michaelhouse.Models.ParentAttendanceSummaryViewModel>;
}

<div class="container mx-auto px-4 py-6">
    <div class="bg-white shadow overflow-hidden rounded-lg">
        <div class="px-4 py-5 sm:px-6 bg-gray-50 border-b">
            <h4 class="text-lg font-medium text-gray-900">Attendance Records – My Children</h4>
        </div>
        <div class="p-4">
            @* Filter form *@
            @using (Html.BeginForm("ChildrenAttendance", "Parents", FormMethod.Get, new { @class = "grid grid-cols-1 md:grid-cols-5 gap-4 mb-6 items-end" }))
            {
                <div>
                    <label class="block text-sm font-medium text-gray-700">Select Child</label>
                    <select name="studentId" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
                        <option value="">All Children</option>
                        @foreach (var s in ViewBag.Students as List<Student>)
                        {
                            <option value="@s.StudentId" selected="@(ViewBag.SelectedStudentId == s.StudentId)">@s.FirstName @s.LastName</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700">Subject</label>
                    <select name="subjectId" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
                        <option value="">All Subjects</option>
                        @foreach (var sub in ViewBag.Subjects as List<Subject>)
                        {
                            <option value="@sub.SubjectId" selected="@(ViewBag.SelectedSubjectId == sub.SubjectId)">@sub.Name</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700">From Date</label>
                    <input type="date" name="fromDate" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" value="@Request.QueryString["fromDate"]" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700">To Date</label>
                    <input type="date" name="toDate" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" value="@Request.QueryString["toDate"]" />
                </div>
                <div class="flex gap-2">
                    <button type="submit" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded text-sm w-full">Filter</button>
                    <a href="@Url.Action("ChildrenAttendance", "Parents")" class="bg-gray-300 hover:bg-gray-400 text-gray-800 px-4 py-2 rounded text-sm text-center w-full">Reset</a>
                </div>
            }
            @if (ViewBag.NoChildren == true)
            {
                <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 mb-4">
                    <p class="text-sm text-yellow-700">No children linked to your account.</p>
                </div>
            }
            else if (summary == null || !summary.Any())
            {
                <div class="bg-blue-50 border-l-4 border-blue-400 p-4 mb-4">
                    <p class="text-sm text-blue-700">No attendance records found for the selected criteria.</p>
                </div>
            }
            else
            {
                @* ========== SUMMARY TABLE ========== *@
                <div class="mb-8">
                    <h5 class="text-md font-medium text-gray-900 mb-2">Attendance Summary by Subject</h5>
                    <p class="text-sm text-gray-500 mb-3">Click on a subject name to see detailed records</p>
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200 border">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Student</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Grade</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Subject</th>
                                    <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Total Classes</th>
                                    <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Present</th>
                                    <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Late</th>
                                    <th class="px-6 py-3 text-center text-xs font-medium text-gray-500 uppercase">Absent</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Attendance %</th>
                                </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-gray-200">
                                @foreach (var item in summary)
                                {
                                    <tr>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@item.StudentName</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@item.GradeLevel</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-blue-600 hover:text-blue-800 cursor-pointer">
                                            <a href="#" class="subject-detail-link"
                                               data-studentid="@item.StudentId"
                                               data-subjectid="@item.SubjectId"
                                               data-studentname="@item.StudentName"
                                               data-subjectname="@item.SubjectName">
                                                @item.SubjectName
                                            </a>
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-center text-gray-900">@item.TotalClasses</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-center text-green-600">@item.PresentCount</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-center text-yellow-600">@item.LateCount</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-center text-red-600">@item.AbsentCount</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm">
                                            <div class="w-full bg-gray-200 rounded-full h-2.5">
                                                <div class="h-2.5 rounded-full @(item.AttendancePercentage >= 75 ? "bg-green-600" : item.AttendancePercentage >= 50 ? "bg-yellow-500" : "bg-red-600")" style="width: @item.AttendancePercentage%"></div>
                                            </div>
                                            <span class="text-xs text-gray-500 ml-2">@item.AttendancePercentage%</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                @* ========== DETAILED LOG TABLE ========== *@
                <div>
                    <h5 class="text-md font-medium text-gray-900 mb-2">Detailed Attendance Log</h5>
                    <div class="overflow-x-auto">
                        <table class="min-w-full divide-y divide-gray-200 border">
                            <thead class="bg-gray-50">
                                <tr>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Student</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Date</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Subject</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Status</th>
                                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Recorded By</th>
                                </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-gray-200">
                                @foreach (var att in Model)
                                {
                                    <tr>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@att.StudentName</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@att.Date.ToString("dd MMM yyyy")</td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-900">@att.SubjectName</td>
                                        <td class="px-6 py-4 whitespace-nowrap">
                                            @if (att.Status == AttendanceStatus.Present)
                                            {
                                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-green-100 text-green-800">Present</span>
                                            }
                                            else if (att.Status == AttendanceStatus.Absent)
                                            {
                                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-red-100 text-red-800">Absent</span>
                                            }
                                            else if (att.Status == AttendanceStatus.Late)
                                            {
                                                <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full bg-yellow-100 text-yellow-800">Late</span>
                                            }
                                        </td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500">@att.RecordedBy</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@* Custom Modal (same as admin version) *@
<div id="attendanceModal" class="fixed inset-0 z-50 hidden overflow-y-auto" aria-labelledby="modal-title" role="dialog" aria-modal="true">
    <div class="flex items-center justify-center min-h-screen px-4 pt-4 pb-20 text-center sm:block sm:p-0">
        <div class="fixed inset-0 bg-gray-500 bg-opacity-75 transition-opacity" aria-hidden="true"></div>
        <span class="hidden sm:inline-block sm:align-middle sm:h-screen" aria-hidden="true">&#8203;</span>
        <div class="inline-block align-bottom bg-white rounded-lg text-left overflow-hidden shadow-xl transform transition-all sm:my-8 sm:align-middle sm:max-w-lg sm:w-full">
            <div class="bg-white px-4 pt-5 pb-4 sm:p-6 sm:pb-4">
                <div class="sm:flex sm:items-start">
                    <div class="mt-3 text-center sm:mt-0 sm:ml-4 sm:text-left w-full">
                        <h3 class="text-lg leading-6 font-medium text-gray-900" id="modalTitle">Attendance Details</h3>
                        <div class="mt-2" id="modalContent">
                            <p class="text-sm text-gray-500">Loading...</p>
                        </div>
                    </div>
                </div>
            </div>
            <div class="bg-gray-50 px-4 py-3 sm:px-6 sm:flex sm:flex-row-reverse">
                <button type="button" class="mt-3 w-full inline-flex justify-center rounded-md border border-gray-300 shadow-sm px-4 py-2 bg-white text-base font-medium text-gray-700 hover:bg-gray-50 focus:outline-none sm:mt-0 sm:ml-3 sm:w-auto sm:text-sm" id="closeModalBtn">Close</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Modal handling (vanilla JS)
        const modal = document.getElementById('attendanceModal');
        const modalTitle = document.getElementById('modalTitle');
        const modalContent = document.getElementById('modalContent');
        const closeModalBtn = document.getElementById('closeModalBtn');

        function openModal() { modal.classList.remove('hidden'); }
        function closeModal() {
            modal.classList.add('hidden');
            modalContent.innerHTML = '<p class="text-sm text-gray-500">Loading...</p>';
        }

        closeModalBtn.addEventListener('click', closeModal);
        modal.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });

        // Attach click handlers to subject links
        document.querySelectorAll('.subject-detail-link').forEach(link => {
            link.addEventListener('click', function(e) {
                e.preventDefault();
                const studentId = this.dataset.studentid;
                const subjectId = this.dataset.subjectid;
                const studentName = this.dataset.studentname;
                const subjectName = this.dataset.subjectname;

                modalTitle.innerText = `Attendance: ${studentName} - ${subjectName}`;
                modalContent.innerHTML = '<div class="flex justify-center"><div class="animate-spin rounded-full h-8 w-8 border-b-2 border-gray-900"></div></div>';
                openModal();

                fetch(`@Url.Action("GetChildSubjectAttendanceDetails", "Parents")?studentId=${studentId}&subjectId=${subjectId}`)
                    .then(response => response.text())
                    .then(html => { modalContent.innerHTML = html; })
                    .catch(() => { modalContent.innerHTML = '<p class="text-red-500">Error loading data.</p>'; });
            });
        });
    </script>
}
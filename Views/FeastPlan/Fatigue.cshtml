@using Michaelhouse.Models.Cafeteria
@using Michaelhouse.Services
@model EventFeastPlan
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Feast Plan — Menu Fatigue";
    var rows = ViewBag.Rows as List<FatigueRow> ?? new List<FatigueRow>();
    bool canEdit = ViewBag.CanEdit == true;
    bool hasDemo = ViewBag.HasDemo == true;
    int flagged = rows.Count(r => r.Fatigue.Flagged);
}

<div class="container-fluid py-4">

    @Html.Partial("_Steps", 5)

    @Html.Partial("_PlanHeader", Model)

    <div class="mb-3">
        <h2 class="h4 mb-1">Step 5 — Menu Fatigue Score</h2>
        <p class="text-muted mb-2">
            Every dish gets a score from 0 to 100 from how often it was served in the
            <strong>@FeastRules.FatigueWindowDays days before the event</strong> (meal collections, earlier events) and how much
            was left uneaten (leftover records). A dish scoring <strong>above @FeastRules.FatigueFlagScore</strong>, or
            <strong>already served @FeastRules.FatigueFlagServings times</strong> in that period, is flagged and the system suggests the
            lowest-scoring suitable replacement. An accepted swap recalculates the plan.
        </p>
        <details class="small text-muted">
            <summary>How the score is worked out (assumptions the SRS leaves open)</summary>
            <ul class="mb-0">
                <li>Frequency points: @FeastRules.PointsPerServing for each time served in the window, at most @FeastRules.MaxServingPoints.</li>
                <li>Waste points: the share of the dish that was left over (leftover ÷ prepared) × @FeastRules.MaxWastePoints.</li>
                <li>Score = frequency points + waste points, at most 100. "Served" means a different day on which it was collected or served.</li>
                <li>A replacement is an active meal with a recipe, colour and texture tags, not already on the plan, used in the same buffet section before, and suitable for the same dietary group.</li>
            </ul>
        </details>
    </div>

    @if (flagged == 0)
    {
        <div class="alert alert-success">No dish on this plan is flagged for menu fatigue.</div>
    }
    else
    {
        <div class="alert alert-warning">
            <strong>@flagged dish@(flagged == 1 ? "" : "es") flagged.</strong> Accept a suggested replacement, or keep the dish.
        </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Dish</th>
                        <th>For</th>
                        <th class="text-end">Served (28 days)</th>
                        <th class="text-end">Left over</th>
                        <th class="text-end">Score</th>
                        <th>Suggested replacement</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in rows)
                    {
                        <tr class="@(r.Fatigue.Flagged ? "table-warning" : "")">
                            <td>
                                <div class="fw-semibold">@r.Item.DishName</div>
                                <div class="small text-muted">@r.Item.Section@(r.Item.Source != "Buffet" && !string.IsNullOrEmpty(r.Item.Source) ? " · " + r.Item.Source : "")</div>
                            </td>
                            <td>@FeastPlanService.CategoryLabel(r.Item.Category)</td>
                            <td class="text-end">@r.Fatigue.TimesServed</td>
                            <td class="text-end">
                                @if (r.Fatigue.LeftoverRecords > 0)
                                {
                                    @((r.Fatigue.LeftoverFraction * 100m).ToString("0.#"))<text>%</text>
                                }
                                else
                                {
                                    <span class="text-muted">no records</span>
                                }
                            </td>
                            <td class="text-end">
                                <span class="badge @(r.Fatigue.Flagged ? "bg-warning text-dark" : "bg-success")">@r.Fatigue.Score</span>
                            </td>
                            <td>
                                @if (!r.Fatigue.Flagged)
                                {
                                    <span class="text-muted">Not flagged</span>
                                }
                                else
                                {
                                    <div class="small mb-1">@r.Reason</div>
                                    if (!r.CanSwap)
                                    {
                                        <span class="text-muted small">A cultural favourite isn't swapped.</span>
                                    }
                                    else if (r.Suggestion == null)
                                    {
                                        <span class="text-muted small">No suitable replacement found in the meal library.</span>
                                    }
                                    else
                                    {
                                        <div>
                                            <strong>@r.Suggestion.Meal.Name</strong>
                                            <span class="small text-muted">score @r.Suggestion.Fatigue.Score · @r.Suggestion.Colour, @r.Suggestion.Texture</span>
                                        </div>
                                        if (canEdit)
                                        {
                                            using (Html.BeginForm("AcceptSwap", "FeastPlan", FormMethod.Post, new { @class = "mt-1" }))
                                            {
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@Model.Id" />
                                                <input type="hidden" name="itemId" value="@r.Item.Id" />
                                                <input type="hidden" name="menuItemId" value="@r.Suggestion.Meal.Id" />
                                                <input type="hidden" name="kind" value="Fatigue" />
                                                <button type="submit" class="btn btn-sm btn-outline-primary">Accept swap and recalculate</button>
                                            }
                                        }
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (canEdit)
    {
        <div class="card border-info-subtle mb-4">
            <div class="card-body d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div class="small">
                    <strong>Demo data.</strong> Until real meal collections and leftover records exist, the scores here are 0.
                    Sample leftover history (clearly marked as demo data) shows how the scoring and flags work.
                </div>
                <div class="d-flex gap-2">
                    @using (Html.BeginForm("DemoHistory", "FeastPlan", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <input type="hidden" name="returnTo" value="Fatigue" />
                        <button type="submit" name="mode" value="add" class="btn btn-sm btn-outline-secondary">Add sample history</button>
                        if (hasDemo)
                        {
                            <button type="submit" name="mode" value="remove" class="btn btn-sm btn-outline-danger">Remove sample history</button>
                        }
                    }
                </div>
            </div>
        </div>
    }

    <div class="d-flex flex-wrap justify-content-between gap-2">
        <a class="btn btn-outline-secondary" href="@Url.Action("Quantities", "FeastPlan", new { id = Model.Id })">
            <i class="bi bi-arrow-left"></i> Back to step 4
        </a>
        @if (canEdit)
        {
            using (Html.BeginForm("Advance", "FeastPlan", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="fromStep" value="5" />
                <button type="submit" class="btn btn-primary">Next: colour and texture balance <i class="bi bi-arrow-right"></i></button>
            }
        }
    </div>
</div>

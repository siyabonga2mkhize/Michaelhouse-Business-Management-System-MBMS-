@using Michaelhouse.Models.Cafeteria
@using Michaelhouse.Services
@model EventFeastPlan
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Feast Plan — Consumption and Waste";
    var rows = ViewBag.Rows as List<WasteRow> ?? new List<WasteRow>();
    bool canEdit = ViewBag.CanEdit == true;
    bool hasRun = ViewBag.HasRun == true;
    bool hasDemo = ViewBag.HasDemo == true;
}

<div class="container-fluid py-4">

    @Html.Partial("_Steps", 7)

    @Html.Partial("_PlanHeader", Model)

    <div class="mb-3">
        <h2 class="h4 mb-1">Step 7 — Maximum consumption, less waste</h2>
        <p class="text-muted mb-2">
            The Meal Coordinator asks the system to make sure as much of the food as possible is eaten and nothing is prepared
            unnecessarily. The system uses the kitchen's leftover records: a dish that was left over before is trimmed by its
            recorded leftover rate (never by more than @FeastRules.MaxWasteTrimPercent.ToString("0")%), and the buffer is still added.
            A dish with no leftover records is left as it is. Nothing is invented.
        </p>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Dish</th>
                        <th class="text-end">Guests covered</th>
                        <th class="text-end">Leftover history</th>
                        <th class="text-end">Now</th>
                        <th class="text-end">After optimising</th>
                        <th class="text-end">Fewer portions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in rows)
                    {
                        <tr>
                            <td class="fw-semibold">@r.Item.DishName</td>
                            <td class="text-end">@r.Item.GuestsCovered</td>
                            <td class="text-end">
                                @if (r.HasHistory)
                                {
                                    <span>@r.LeftoverPercent.ToString("0.#")% left over (@r.LeftoverRecords record@(r.LeftoverRecords == 1 ? "" : "s"))</span>
                                }
                                else
                                {
                                    <span class="text-muted">no records</span>
                                }
                            </td>
                            <td class="text-end">@r.CurrentQuantity</td>
                            <td class="text-end fw-semibold">@(r.Item.OptimisedForWaste ? r.CurrentQuantity : r.OptimisedQuantity)</td>
                            <td class="text-end">
                                @if (r.Item.OptimisedForWaste)
                                {
                                    <span class="badge bg-success">applied</span>
                                }
                                else if (r.PortionsSaved > 0)
                                {
                                    <span>@r.PortionsSaved</span>
                                }
                                else
                                {
                                    <span class="text-muted">0</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (hasRun)
    {
        <div class="alert alert-success">The waste optimisation has been run for this plan. The quantities above are final unless you run it again.</div>
    }

    @if (canEdit)
    {
        <div class="d-flex flex-wrap gap-2 mb-4">
            @using (Html.BeginForm("OptimiseWaste", "FeastPlan", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <button type="submit" class="btn btn-warning">
                    <i class="bi bi-recycle"></i> Optimise for maximum consumption and less waste
                </button>
            }
            @using (Html.BeginForm("DemoHistory", "FeastPlan", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="returnTo" value="Waste" />
                <button type="submit" name="mode" value="add" class="btn btn-outline-secondary">Add sample history (demo)</button>
                if (hasDemo)
                {
                    <button type="submit" name="mode" value="remove" class="btn btn-outline-danger">Remove sample history</button>
                }
            }
        </div>
    }

    <div class="d-flex flex-wrap justify-content-between gap-2">
        <a class="btn btn-outline-secondary" href="@Url.Action("Balance", "FeastPlan", new { id = Model.Id })">
            <i class="bi bi-arrow-left"></i> Back to step 6
        </a>
        @if (canEdit)
        {
            using (Html.BeginForm("Advance", "FeastPlan", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="fromStep" value="7" />
                <button type="submit" class="btn btn-primary" @(hasRun ? "" : "disabled")>Next: review the plan <i class="bi bi-arrow-right"></i></button>
            }
        }
    </div>
</div>

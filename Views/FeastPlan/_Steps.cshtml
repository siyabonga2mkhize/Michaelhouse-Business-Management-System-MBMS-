@model int
@*
    UC19 step indicator. Model = the current SRS step (1–8).
*@
@{
    var steps = new[]
    {
        "Retrieve RSVPs",
        "Combine with event",
        "Calculate quantities",
        "Generate proposed plan",
        "Coordinator review",
        "Manager decision",
        "Edit & recalculate",
        "Approved & sent"
    };
}
<ol class="list-unstyled d-flex flex-wrap gap-2 mb-4 small">
    @for (int i = 0; i < steps.Length; i++)
    {
        int n = i + 1;
        string css = n == Model
            ? "bg-primary text-white border-primary fw-semibold"
            : n < Model
                ? "bg-success-subtle text-success-emphasis border-success-subtle"
                : "bg-body-tertiary text-body-secondary";
        <li class="border rounded-pill px-3 py-1 @css">@n. @steps[i]</li>
    }
</ol>

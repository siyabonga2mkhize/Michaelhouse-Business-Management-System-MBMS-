@using Michaelhouse.Services
@model FeastPlanSource
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Feast Plan — Event Details";
    var evt = Model.Event;
    decimal buffer = ViewBag.Buffer;
}

<div class="container-fluid py-4">

    @Html.Partial("_Steps", 2)

    <div class="mb-4">
        <h1 class="h3 mb-1">Step 2 — Combine with event details</h1>
        <p class="text-muted mb-0">The RSVP headcount combined with the event and the meals on its buffet.</p>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-lg-5">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white fw-semibold">Event</div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-5">Event</dt>
                        <dd class="col-sm-7">@evt.EventName</dd>

                        <dt class="col-sm-5">Type</dt>
                        <dd class="col-sm-7">@evt.EventType</dd>

                        <dt class="col-sm-5">Date</dt>
                        <dd class="col-sm-7">@evt.EventDate.ToString("dddd dd MMMM yyyy")</dd>

                        <dt class="col-sm-5">Time</dt>
                        <dd class="col-sm-7">@evt.StartTime.ToString(@"hh\:mm")–@evt.EndTime.ToString(@"hh\:mm")</dd>

                        <dt class="col-sm-5">Venue</dt>
                        <dd class="col-sm-7">@(evt.Venue != null ? evt.Venue.Name : "—")</dd>

                        <dt class="col-sm-5">Menu template</dt>
                        <dd class="col-sm-7">@(evt.MenuTemplate != null ? evt.MenuTemplate.Name : "—")</dd>

                        <dt class="col-sm-5">Expected headcount</dt>
                        <dd class="col-sm-7">@evt.ExpectedHeadcount</dd>

                        <dt class="col-sm-5">Attending (RSVPs)</dt>
                        <dd class="col-sm-7 fw-semibold">@Model.TotalGuests</dd>

                        @if (!string.IsNullOrWhiteSpace(evt.SpecialInstructions))
                        {
                            <dt class="col-sm-5">Special instructions</dt>
                            <dd class="col-sm-7">@evt.SpecialInstructions</dd>
                        }
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-lg-7">
            <div class="card shadow-sm h-100">
                <div class="card-header bg-white fw-semibold">Dishes on the event's buffet</div>
                <div class="card-body p-0">
                    @if (Model.Dishes.Count == 0)
                    {
                        <div class="alert alert-warning m-3">
                            This event has no active buffet meals. You can still generate the plan and add dishes when editing it,
                            but it can't be sent for approval without dishes.
                        </div>
                    }
                    else
                    {
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Dish</th>
                                    <th>Section</th>
                                    <th>Prepared for</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in FeastPlanService.InOrder(Model.Dishes))
                                {
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                @Html.Partial("_DishPhoto", d.DishName)
                                                <span>@d.DishName</span>
                                            </div>
                                        </td>
                                        <td>@d.Section</td>
                                        <td>@FeastPlanService.CategoryLabel(d.Category)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
                <div class="card-footer bg-white small text-muted">
                    Main dishes go to the vegetarian, halal or standard guests, depending on the meal.
                    Desserts, sides, starters and drinks are common and cover everyone.
                    The coordinator can change this when editing the plan.
                </div>
            </div>
        </div>
    </div>

    @{
        var prerequisites = ViewBag.Prerequisites as List<FeastPrerequisite> ?? new List<FeastPrerequisite>();
        bool allMet = prerequisites.All(p => p.Met);
    }

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white fw-semibold">Conditions for this use case</div>
        <ul class="list-group list-group-flush">
            @foreach (var p in prerequisites)
            {
                <li class="list-group-item d-flex justify-content-between align-items-start gap-3">
                    <span>
                        <i class="bi @(p.Met ? "bi-check-circle-fill text-success" : "bi-x-circle-fill text-danger") me-1"></i>@p.Text
                    </span>
                    <span class="small text-muted text-end">@p.Detail</span>
                </li>
            }
        </ul>
        @if (!allMet)
        {
            <div class="card-footer bg-white small">
                The plan can't be started until every condition is met.
                @if (prerequisites.Any(p => !p.Met && p.Text.Contains("colour and texture")))
                {
                    <a href="@Url.Action("Tags", "FeastPlan")">Tag the meals with colour and texture</a>
                }
            </div>
        }
    </div>

    <form method="post" action="@Url.Action("Generate", "FeastPlan")" class="card shadow-sm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@evt.Id" />
        <div class="card-body d-flex flex-wrap align-items-end justify-content-between gap-3">
            <div>
                <label for="buffer" class="form-label fw-semibold mb-1">Buffer</label>
                <div class="input-group" style="max-width: 12rem;">
                    <input type="number" class="form-control" id="buffer" name="buffer" min="0" max="100" step="0.5"
                           value="@buffer.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" />
                    <span class="input-group-text">%</span>
                </div>
                <div class="form-text">Added to every dish and rounded up. Default 5%.</div>
            </div>
            <div class="d-flex gap-2">
                <a class="btn btn-outline-secondary" href="@Url.Action("Rsvps", "FeastPlan", new { id = evt.Id })">
                    <i class="bi bi-arrow-left"></i> Back
                </a>
                <button type="submit" class="btn btn-primary" @(allMet ? "" : "disabled")>
                    Next: cultural favourites <i class="bi bi-arrow-right"></i>
                </button>
            </div>
        </div>
    </form>
</div>

@using Michaelhouse.Models.Cafeteria
@using Michaelhouse.Services
@model EventFeastPlan
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Feast Plan — Edit";

    var meals = ViewBag.Meals as List<MenuItem> ?? new List<MenuItem>();
    var items = FeastPlanService.InOrder(Model.Items);
    // A cultural favourite is chosen in step 3, not here
    var categories = ((FeastDishCategory[])Enum.GetValues(typeof(FeastDishCategory))).Where(c => c != FeastDishCategory.Favourite).ToArray();
    string rowVersion = Model.RowVersion != null ? Convert.ToBase64String(Model.RowVersion) : "";
}

<div class="container-fluid py-4">

    @Html.Partial("_Steps", 9)

    @Html.Partial("_PlanHeader", Model)

    @if (Model.Status == FeastPlanStatus.ChangesRequested && !string.IsNullOrWhiteSpace(Model.ManagerComments))
    {
        <div class="alert alert-info">
            <strong>Changes requested by the Cafeteria Manager:</strong> @Model.ManagerComments
        </div>
    }

    <p class="text-muted">
        Change which guests each dish is for, remove or add dishes, or change the buffer.
        Quantities aren't typed in. They are recalculated from the RSVPs when you save, and the plan goes back to review (step 8).
    </p>

    <form method="post" action="@Url.Action("Edit", "FeastPlan")">
        @Html.AntiForgeryToken()
        <input type="hidden" name="Id" value="@Model.Id" />
        <input type="hidden" name="RowVersion" value="@rowVersion" />

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white fw-semibold">Dishes</div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Dish</th>
                                <th>Section</th>
                                <th style="min-width: 12rem;">Prepared for</th>
                                <th class="text-end">Current total</th>
                                <th class="text-center">Remove</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < items.Count; i++)
                            {
                                var item = items[i];
                                <tr>
                                    <td class="fw-semibold">
                                        @item.DishName
                                        <input type="hidden" name="Items[@i].Id" value="@item.Id" />
                                    </td>
                                    <td>@item.Section</td>
                                    <td>
                                        @if (item.Category == FeastDishCategory.Favourite)
                                        {
                                            <input type="hidden" name="Items[@i].Category" value="@item.Category" />
                                            <span class="badge bg-info text-dark">@FeastPlanService.CategoryLabel(item.Category)</span>
                                        }
                                        else
                                        {
                                            <select class="form-select form-select-sm" name="Items[@i].Category" aria-label="Prepared for">
                                                @foreach (var c in categories)
                                                {
                                                    <option value="@c" @(c == item.Category ? "selected" : "")>@FeastPlanService.CategoryLabel(c)</option>
                                                }
                                            </select>
                                        }
                                    </td>
                                    <td class="text-end">@item.TotalQuantity</td>
                                    <td class="text-center">
                                        <input class="form-check-input" type="checkbox" name="Items[@i].Remove" value="true" aria-label="Remove @item.DishName" />
                                    </td>
                                </tr>
                            }
                            @if (items.Count == 0)
                            {
                                <tr><td colspan="5" class="text-muted p-3">No dishes yet. Add one below.</td></tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white fw-semibold">Add a dish from the meal library (optional)</div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-5">
                        <label for="AddMenuItemId" class="form-label">Meal</label>
                        <select class="form-select" id="AddMenuItemId" name="AddMenuItemId">
                            <option value="">— none —</option>
                            @foreach (var m in meals)
                            {
                                <option value="@m.Id">@m.Name (@m.DietaryClassification)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label for="AddCategory" class="form-label">Prepared for</label>
                        <select class="form-select" id="AddCategory" name="AddCategory">
                            @foreach (var c in categories)
                            {
                                <option value="@c">@FeastPlanService.CategoryLabel(c)</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label for="AddSection" class="form-label">Section</label>
                        <input type="text" class="form-control" id="AddSection" name="AddSection" maxlength="50" placeholder="Main, Dessert…" />
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label for="BufferPercent" class="form-label fw-semibold">Buffer</label>
                        <div class="input-group">
                            <input type="number" class="form-control" id="BufferPercent" name="BufferPercent" min="0" max="100" step="0.5" required
                                   value="@Model.BufferPercent.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)" />
                            <span class="input-group-text">%</span>
                        </div>
                    </div>
                    <div class="col-md-9">
                        <label for="CoordinatorNotes" class="form-label fw-semibold">Meal Coordinator's notes</label>
                        <textarea class="form-control" id="CoordinatorNotes" name="CoordinatorNotes" rows="2" maxlength="1000">@Model.CoordinatorNotes</textarea>
                    </div>
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-between">
            <a class="btn btn-outline-secondary" href="@Url.Action("Review", "FeastPlan", new { id = Model.Id })">
                <i class="bi bi-arrow-left"></i> Cancel
            </a>
            <button type="submit" class="btn btn-primary">
                <i class="bi bi-calculator"></i> Recalculate and review again
            </button>
        </div>
    </form>
</div>

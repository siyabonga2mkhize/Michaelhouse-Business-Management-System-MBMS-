@using Michaelhouse.Models.Cafeteria
@using Michaelhouse.Services
@model List<TagRow>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Meal Library — Colour and Texture Tags";
    int untagged = Model.Count(t => t.Tag == null);
}

<div class="container-fluid py-4">

    <div class="mb-3">
        <h1 class="h3 mb-1">Colour and texture tags</h1>
        <p class="text-muted mb-0">
            The Generate Feast Plan use case needs every meal in the meal library to carry a colour and a texture tag
            (dietary tags are already held on the meal and its recipe). They are used to check the visual and textural balance
            of each buffet section and to suggest swaps.
        </p>
    </div>

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            @if (untagged == 0)
            {
                <span class="badge bg-success">Every active meal is tagged</span>
            }
            else
            {
                <span class="badge bg-danger">@untagged meal@(untagged == 1 ? "" : "s") without a tag</span>
            }
        </div>
        @if (untagged > 0)
        {
            using (Html.BeginForm("StarterTags", "FeastPlan", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-secondary btn-sm">
                    Add starter tags to the untagged meals
                </button>
            }
        }
    </div>

    @using (Html.BeginForm("Tags", "FeastPlan", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="card shadow-sm mb-4">
            <div class="table-responsive">
                <table class="table table-sm align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Meal</th>
                            <th>Dietary classification</th>
                            <th style="width:14rem">Colour</th>
                            <th style="width:14rem">Texture</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in Model)
                        {
                            <tr class="@(row.Tag == null ? "table-warning" : "")">
                                <td class="fw-semibold">@row.Meal.Name</td>
                                <td>@row.Meal.DietaryClassification</td>
                                <td>
                                    <select class="form-select form-select-sm" name="colour_@row.Meal.Id">
                                        <option value="">—</option>
                                        @foreach (var c in MenuItemBuffetTag.Colours)
                                        {
                                            <option value="@c" @(row.Tag != null && row.Tag.Colour == c ? "selected" : "")>@c</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <select class="form-select form-select-sm" name="texture_@row.Meal.Id">
                                        <option value="">—</option>
                                        @foreach (var t in MenuItemBuffetTag.Textures)
                                        {
                                            <option value="@t" @(row.Tag != null && row.Tag.Texture == t ? "selected" : "")>@t</option>
                                        }
                                    </select>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="d-flex justify-content-between">
            <a class="btn btn-outline-secondary" href="@Url.Action("Index", "FeastPlan")">
                <i class="bi bi-arrow-left"></i> Feast plans
            </a>
            <button type="submit" class="btn btn-primary">Save tags</button>
        </div>
    }
</div>

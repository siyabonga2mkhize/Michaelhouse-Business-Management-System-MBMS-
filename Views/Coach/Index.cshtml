@using System.Linq
@using Michaelhouse.Models
@{
    ViewBag.Title = "My Fixtures";

    var upcoming = ViewBag.Upcoming as List<SportEvent> ?? new List<SportEvent>();
    var past = ViewBag.Past as List<SportEvent> ?? new List<SportEvent>();
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1 class="h3 mb-1">My Fixtures</h1>
            <p class="text-muted mb-0">
                Declare trainings and matches. The Meal Coordinator uses this data to plan the week's menu.
            </p>
        </div>
        <a href="@Url.Action("Create", "Coach")" class="btn btn-primary">
            + Add Fixture
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="alert alert-info">
        <strong>How this works:</strong>
        The system uses your fixtures to determine which houses need elevated nutrition
        and which days should have match-day menus. Nothing here generates a menu —
        the Meal Coordinator decides that.
    </div>

    <!-- UPCOMING -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white">
            <strong>Upcoming</strong>
            <span class="badge bg-primary ms-2">@upcoming.Count</span>
        </div>

        <div class="card-body p-0">
            @if (!upcoming.Any())
            {
                <div class="p-4 text-muted">
                    No upcoming fixtures. Add your first match or training session.
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Type</th>
                                <th>Sport</th>
                                <th>Residence</th>
                                <th>Details</th>
                                <th>Intensity</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ev in upcoming)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold">@ev.ScheduledDate.ToString("ddd dd MMM")</div>
                                        <div class="small text-muted">@ev.StartTime.ToString(@"hh\:mm")</div>
                                    </td>
                                    <td>
                                        @if (ev.EventType == "Match")
                                        {
                                            <span class="badge bg-danger">Match</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">Training</span>
                                        }
                                    </td>
                                    <td>@ev.Sport</td>
                                    <td>@(ev.Residence != null ? ev.Residence.Name : "-")</td>
                                    <td>
                                        @if (ev.EventType == "Match")
                                        {
                                            <div>vs @ev.Opponent</div>
                                            <div class="small text-muted">
                                                @(ev.IsHome ? "Home" : "Away")
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="small text-muted">@ev.DurationMinutes min</div>
                                        }
                                    </td>
                                    <td>
                                        <span class="small">@ev.Intensity</span>
                                    </td>
                                    <td class="text-end">
                                        <a href="@Url.Action("Edit", "Coach", new { id = ev.Id })"
                                           class="btn btn-sm btn-outline-secondary">
                                            Edit
                                        </a>
                                        <form action="@Url.Action("Cancel", "Coach", new { id = ev.Id })"
                                              method="post"
                                              style="display:inline;"
                                              onsubmit="return confirm('Cancel this fixture?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                Cancel
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- RECENT HISTORY -->
    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <strong>Recent History</strong>
        </div>
        <div class="card-body p-0">
            @if (!past.Any())
            {
                <div class="p-4 text-muted">No past fixtures yet.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Date</th>
                                <th>Type</th>
                                <th>Sport</th>
                                <th>Residence</th>
                                <th>Details</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var ev in past)
                            {
                                <tr>
                                    <td class="small text-muted">@ev.ScheduledDate.ToString("dd MMM yyyy")</td>
                                    <td>
                                        <span class="small">@ev.EventType</span>
                                    </td>
                                    <td class="small">@ev.Sport</td>
                                    <td class="small">@(ev.Residence != null ? ev.Residence.Name : "-")</td>
                                    <td class="small text-muted">
                                        @(ev.EventType == "Match" ? "vs " + ev.Opponent : ev.DurationMinutes + " min")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

</div>

@using System.Linq
@using Michaelhouse.Models
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "My Fixtures";

    var upcoming = ViewBag.Upcoming as List<SportEvent> ?? new List<SportEvent>();
    var past = ViewBag.Past as List<SportEvent> ?? new List<SportEvent>();
    var playerCounts = ViewBag.PlayerCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
    int matches = upcoming.Count(e => e.EventType == "Match");
}

@* --- FULL SCREEN VIEWPORT CONTAINER --- *@
<div class="flex flex-col h-full w-full overflow-hidden bg-gray-50/30">

    @* --- INSTITUTIONAL HEADER --- *@
    <div class="mb-6 d-flex justify-content-between align-items-end border-b border-gray-200 pb-6 flex-shrink-0 px-8 pt-8 bg-white shadow-sm relative z-10 flex-wrap gap-4">
        <div>
            <div class="flex items-center gap-2 mb-3">
                <div class="h-[2px] w-8 bg-[#C21E2E]"></div>
                <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Sport & Fixtures</h5>
            </div>
            <h2 class="text-5xl font-serif font-bold text-gray-900 tracking-tight mb-0">My Fixtures</h2>
            <p class="text-[11px] font-mono text-gray-500 uppercase tracking-widest mt-2 mb-0">
                Declare trainings and matches. The menu and meal plans are built around them.
            </p>
        </div>
        <div class="flex flex-wrap gap-3">
            <a href="@Url.Action("Index", "CoachSquad")" class="inline-flex items-center justify-center bg-white border border-gray-300 text-gray-700 px-6 py-3 text-[10px] font-bold uppercase tracking-[2px] hover:bg-gray-50 hover:border-gray-400 transition-all duration-300 shadow-sm text-decoration-none">
                <i class="bi bi-people me-2 text-sm"></i> My Sports
            </a>
            <a href="@Url.Action("Create", "Coach")" class="inline-flex items-center justify-center bg-[#1a1a1a] text-white px-8 py-3 text-[10px] font-bold uppercase tracking-[3px] hover:bg-black hover:shadow-[0_0_15px_rgba(0,0,0,0.3)] transition-all duration-300 text-decoration-none">
                <i class="bi bi-plus-lg me-2 text-sm align-middle"></i> Add Fixture
            </a>
        </div>
    </div>

    @* --- SCROLLABLE DATA SECTION --- *@
    <div class="flex-grow min-h-0 overflow-y-auto custom-scrollbar px-8 pb-16 pt-2 flex flex-col gap-8">

        @* --- SUMMARY TILES --- *@
        <div class="grid grid-cols-3 gap-3 sm:gap-4">
            <div class="bg-white border border-gray-200 p-3 sm:p-5 shadow-sm">
                <span class="block text-[8px] sm:text-[9px] uppercase tracking-[2px] sm:tracking-[3px] font-bold text-gray-400 mb-2">Upcoming</span>
                <span class="font-mono text-2xl sm:text-3xl font-bold text-gray-900">@upcoming.Count</span>
            </div>
            <div class="bg-white border border-gray-200 p-3 sm:p-5 shadow-sm">
                <span class="block text-[8px] sm:text-[9px] uppercase tracking-[2px] sm:tracking-[3px] font-bold text-gray-400 mb-2">Matches</span>
                <span class="font-mono text-2xl sm:text-3xl font-bold text-[#C21E2E]">@matches</span>
            </div>
            <div class="bg-white border border-gray-200 p-3 sm:p-5 shadow-sm">
                <span class="block text-[8px] sm:text-[9px] uppercase tracking-[2px] sm:tracking-[3px] font-bold text-gray-400 mb-2">Trainings</span>
                <span class="font-mono text-2xl sm:text-3xl font-bold text-gray-900">@(upcoming.Count - matches)</span>
            </div>
        </div>

        @* --- HOW THIS WORKS --- *@
        <div class="bg-blue-50/60 border-l-4 border-[#1a1a1a] p-5 shadow-sm">
            <span class="block text-[9px] uppercase tracking-[3px] font-bold text-gray-900 mb-2"><i class="bi bi-info-circle me-1"></i> How this works</span>
            <p class="font-serif text-sm text-gray-700 mb-0">
                Players come from the sports parents select on their children's profiles (see
                <a href="@Url.Action("Index", "CoachSquad")" class="text-[#C21E2E] font-bold hover:underline">My Sports</a>) — you never list them.
                When the Cafeteria Manager generates the week's menu, your matches, the day before each match and your training
                sessions add suitable meal options for those players, and their meal plans recommend them.
            </p>
        </div>

        @* --- UPCOMING LEDGER --- *@
        <div class="bg-white border-2 border-gray-200 shadow-sm flex flex-col relative overflow-hidden">

            <div class="p-5 border-b border-gray-200 bg-[#1a1a1a] flex justify-between items-center">
                <div>
                    <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-white mb-0">
                        <i class="bi bi-calendar-event me-2 text-gray-400"></i> Upcoming Fixtures (@upcoming.Count)
                    </h5>
                    <span class="text-[8px] font-mono text-gray-400 uppercase tracking-widest mt-1 block">Trainings & matches still to come</span>
                </div>
            </div>

            <div class="table-responsive">
                @if (!upcoming.Any())
                {
                    <div class="p-20 text-center">
                        <i class="bi bi-calendar-plus text-gray-200 text-6xl d-block mb-3"></i>
                        <h4 class="font-serif font-bold text-gray-400 uppercase tracking-[3px] mb-2">No Upcoming Fixtures</h4>
                        <span class="text-[10px] font-mono text-gray-400 uppercase tracking-widest">Add your first match or training session.</span>
                    </div>
                }
                else
                {
                    <table class="table align-middle mb-0 w-full whitespace-nowrap">
                        <thead class="bg-gray-50/90">
                            <tr class="text-[9px] uppercase tracking-[4px] font-bold text-gray-500 border-b-2 border-gray-200">
                                <th class="ps-6 py-4">Date & Time</th>
                                <th class="border-l border-gray-100 ps-4">Type</th>
                                <th class="border-l border-gray-100 ps-4">Sport</th>
                                <th class="border-l border-gray-100 ps-4">House</th>
                                <th class="border-l border-gray-100 ps-4 text-end">Players</th>
                                <th class="border-l border-gray-100 ps-4">Details</th>
                                <th class="border-l border-gray-100 ps-4">Intensity</th>
                                <th class="pe-6 border-l border-gray-100 text-end">Action</th>
                            </tr>
                        </thead>
                        <tbody class="text-gray-700">
                            @foreach (var ev in upcoming)
                            {
                                bool isMatch = ev.EventType == "Match";
                                <tr class="hover:bg-gray-50/80 transition-colors border-b border-gray-50 last:border-0 h-20">
                                    <td class="ps-6 py-3">
                                        <span class="font-serif font-bold text-gray-900 block">@ev.ScheduledDate.ToString("ddd, dd MMM")</span>
                                        <span class="font-mono text-[11px] text-gray-500">@ev.StartTime.ToString(@"hh\:mm")–@ev.StartTime.Add(TimeSpan.FromMinutes(ev.DurationMinutes)).ToString(@"hh\:mm")</span>
                                    </td>
                                    <td class="border-l border-gray-50 ps-4">
                                        @if (isMatch)
                                        {
                                            <span class="inline-flex items-center text-[8px] font-bold uppercase tracking-widest bg-[#C21E2E] text-white px-2 py-1">Match</span>
                                        }
                                        else
                                        {
                                            <span class="inline-flex items-center text-[8px] font-bold uppercase tracking-widest bg-gray-100 text-gray-700 border border-gray-200 px-2 py-1">Training</span>
                                        }
                                    </td>
                                    <td class="border-l border-gray-50 ps-4 font-serif font-bold text-gray-900">@ev.Sport</td>
                                    <td class="border-l border-gray-50 ps-4 font-mono text-xs text-gray-600 uppercase tracking-wider">@(ev.Residence != null ? ev.Residence.Name : "All players")</td>
                                    <td class="border-l border-gray-50 ps-4 text-end font-mono font-bold text-base text-gray-900">
                                        @(playerCounts.ContainsKey(ev.Id) ? playerCounts[ev.Id] : 0)
                                        <span class="block text-[8px] font-mono text-gray-400 uppercase tracking-widest font-normal">Available</span>
                                    </td>
                                    <td class="border-l border-gray-50 ps-4">
                                        @if (isMatch)
                                        {
                                            <span class="font-serif text-sm text-gray-900 block">vs @ev.Opponent</span>
                                            <span class="text-[9px] font-mono text-gray-400 uppercase tracking-widest">@(ev.IsHome ? "Home" : "Away")</span>
                                        }
                                        else
                                        {
                                            <span class="font-mono text-xs text-gray-500">@ev.DurationMinutes min</span>
                                        }
                                    </td>
                                    <td class="border-l border-gray-50 ps-4 text-[10px] font-mono uppercase tracking-widest text-gray-600">@ev.Intensity</td>
                                    <td class="pe-6 border-l border-gray-50 text-end whitespace-nowrap">
                                        <a href="@Url.Action("Edit", "Coach", new { id = ev.Id })" class="inline-flex items-center justify-center bg-white border border-gray-300 text-gray-700 px-4 py-2 text-[9px] font-bold uppercase tracking-[2px] hover:bg-gray-50 transition-colors text-decoration-none">
                                            <i class="bi bi-pencil me-1.5"></i> Edit
                                        </a>
                                        <form action="@Url.Action("Cancel", "Coach", new { id = ev.Id })" method="post" class="inline m-0" onsubmit="return confirm('Cancel this fixture?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="inline-flex items-center justify-center bg-white border border-[#C21E2E] text-[#C21E2E] px-4 py-2 text-[9px] font-bold uppercase tracking-[2px] hover:bg-red-50 transition-colors">
                                                <i class="bi bi-x-lg me-1.5"></i> Cancel
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

        @* --- RECENT HISTORY --- *@
        <div class="bg-white border-2 border-gray-200 shadow-sm flex flex-col relative overflow-hidden">

            <div class="p-4 bg-gray-100 flex justify-between items-center border-b border-gray-200">
                <span class="text-[10px] font-mono font-bold uppercase tracking-[4px] text-gray-700">
                    <i class="bi bi-clock-history me-2 text-gray-500"></i> Recent History
                </span>
                <span class="text-[8px] font-mono uppercase tracking-widest text-gray-400">Past Fixtures</span>
            </div>

            <div class="table-responsive">
                @if (!past.Any())
                {
                    <div class="p-12 text-center bg-gray-50 text-[10px] font-mono uppercase tracking-widest text-gray-400">
                        No past fixtures yet.
                    </div>
                }
                else
                {
                    <table class="table align-middle mb-0 w-full whitespace-nowrap">
                        <thead class="bg-gray-50/90">
                            <tr class="text-[9px] uppercase tracking-[4px] font-bold text-gray-400 border-b border-gray-200">
                                <th class="ps-6 py-3">Date</th>
                                <th class="border-l border-gray-100 ps-4">Type</th>
                                <th class="border-l border-gray-100 ps-4">Sport</th>
                                <th class="border-l border-gray-100 ps-4">House</th>
                                <th class="border-l border-gray-100 pe-6 ps-4">Details</th>
                            </tr>
                        </thead>
                        <tbody class="text-gray-600 text-sm">
                            @foreach (var ev in past)
                            {
                                <tr class="hover:bg-gray-50/50 transition-colors border-b border-gray-50 last:border-0 h-14">
                                    <td class="ps-6 py-3 font-mono text-xs text-gray-900 font-bold">@ev.ScheduledDate.ToString("ddd, dd MMM yyyy")</td>
                                    <td class="border-l border-gray-50 ps-4 text-[9px] font-mono font-bold uppercase tracking-widest text-gray-500">@ev.EventType</td>
                                    <td class="border-l border-gray-50 ps-4 font-serif font-bold text-gray-900">@ev.Sport</td>
                                    <td class="border-l border-gray-50 ps-4 font-mono text-xs text-gray-500 uppercase tracking-wider">@(ev.Residence != null ? ev.Residence.Name : "All players")</td>
                                    <td class="border-l border-gray-50 pe-6 ps-4 font-mono text-xs text-gray-500">
                                        @(ev.EventType == "Match" ? "vs " + ev.Opponent : ev.DurationMinutes + " min")
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>

    </div>
</div>

<style>
    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }

    .font-mono {
        font-family: 'Source Code Pro', monospace !important;
    }

    .table thead th {
        border-bottom: 2px solid #e5e7eb !important;
        vertical-align: middle;
        padding-top: .9rem;
        padding-bottom: .9rem;
    }

    .custom-scrollbar::-webkit-scrollbar {
        width: 5px;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #d1d5db;
        border-radius: 10px;
    }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #C21E2E;
        }
</style>

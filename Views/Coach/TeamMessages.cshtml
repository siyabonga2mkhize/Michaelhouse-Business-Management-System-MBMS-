@model IEnumerable<Michaelhouse.Models.CoachMessage>
@{
    ViewBag.Title = "Team Messages";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var team = ViewBag.Team as Michaelhouse.Models.Team;
    var list = Model.ToList();
}

<div class="relative mb-8 border-b border-gray-100 bg-gray-50/30 py-8 px-4 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none"
         style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 24px 24px;"></div>
    <i class="bi bi-chat-dots absolute -right-8 -bottom-10 text-black/5 text-[12rem] rotate-12"></i>

    <div class="max-w-3xl mx-auto relative z-10">
        <div class="flex items-center gap-2 mb-3">
            <div class="h-1 w-8 bg-[#C21E2E]"></div>
            <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Coach Portal</h5>
        </div>
        <h2 class="text-3xl font-serif font-bold text-gray-900 tracking-tight">Team Messages</h2>
        <p class="text-gray-400 text-[10px] uppercase tracking-widest font-bold mt-2">@(team != null ? team.Name : "")</p>
    </div>
</div>

<div class="max-w-3xl mx-auto px-4 pb-20">

    <div class="bg-white border border-gray-100 shadow-sm overflow-hidden mb-6">
        <div class="p-4 border-b border-gray-100 bg-gray-50/50">
            <h6 class="text-[10px] uppercase tracking-[3px] font-bold text-gray-900 mb-0">
                <i class="bi bi-send me-2 text-[#C21E2E]"></i>Send New Message
            </h6>
        </div>

        @using (Html.BeginForm("SendTeamMessage", "Coach", new { id = team.TeamID }, FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <div class="p-6 space-y-4">
                <div>
                    <label class="block text-[9px] uppercase tracking-widest font-bold text-gray-400 mb-2">Subject *</label>
                    <input type="text" name="subject" required class="w-full border border-gray-200 py-3 px-4 text-sm" />
                </div>
                <div>
                    <label class="block text-[9px] uppercase tracking-widest font-bold text-gray-400 mb-2">Message *</label>
                    <textarea name="body" rows="4" required class="w-full border border-gray-200 py-3 px-4 text-sm"></textarea>
                </div>
                <label class="flex items-center gap-2 text-xs text-gray-700">
                    <input type="checkbox" name="isUrgent" value="true" class="form-checkbox" /> Mark as urgent
                </label>
                <div class="flex justify-end">
                    <button type="submit" class="bg-[#C21E2E] text-white px-8 py-3 text-[10px] font-bold uppercase tracking-widest hover:bg-black">
                        <i class="bi bi-send me-2"></i>Send to Team
                    </button>
                </div>
            </div>
        }
    </div>

    <h6 class="text-[10px] uppercase tracking-[3px] font-bold text-gray-900 mb-3">Message History (@list.Count)</h6>

    @if (!list.Any())
    {
        <div class="bg-white border border-gray-100 p-8 text-center text-gray-400 text-sm">
            No messages sent yet.
        </div>
    }
    else
    {
        <div class="space-y-3">
            @foreach (var m in list)
            {
                <div class="bg-white border border-gray-100 shadow-sm p-5">
                    <div class="flex justify-between items-start mb-2">
                        <div class="flex items-center gap-2">
                            @if (m.IsUrgent)
                            {<span class="text-[8px] font-bold uppercase tracking-widest px-2 py-0.5 bg-red-600 text-white">Urgent</span>}
                            <strong class="text-sm text-gray-900">@m.Subject</strong>
                        </div>
                        <span class="text-[9px] text-gray-400">@m.SentAt.ToString("dd MMM yyyy HH:mm")</span>
                    </div>
                    <p class="text-sm text-gray-700 mb-0">@m.Body</p>
                </div>
            }
        </div>
    }
</div>

<style>
    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }
</style>
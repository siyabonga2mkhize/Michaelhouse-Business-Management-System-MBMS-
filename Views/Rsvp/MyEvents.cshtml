@model List<Michaelhouse.Services.EventInvitation>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "My Event Invitations";
}

@* --- FULL SCREEN VIEWPORT CONTAINER --- *@
<div class="flex flex-col h-full w-full overflow-hidden bg-gray-50/30">

    @* --- INSTITUTIONAL HEADER --- *@
    <div class="mb-6 d-flex justify-content-between align-items-end border-b border-gray-200 pb-6 flex-shrink-0 px-8 pt-8 bg-white shadow-sm relative z-10">
        <div>
            <div class="flex items-center gap-2 mb-3">
                <div class="h-[2px] w-8 bg-[#C21E2E]"></div>
                <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Hospitality & Catering</h5>
            </div>
            <h2 class="text-5xl font-serif font-bold text-gray-900 tracking-tight mb-0">My Event Invitations</h2>
            <p class="text-[11px] font-mono text-gray-500 uppercase tracking-widest mt-2 mb-0">
                Events you're invited to. Open one to RSVP or change your answer while RSVPs are open.
            </p>
        </div>
        <div class="flex gap-3">
            <span class="inline-flex items-center bg-gray-100 border border-gray-300 px-4 py-2 shadow-xs text-[10px] font-bold uppercase tracking-[2px] text-gray-700">
                <i class="bi bi-envelope me-2 text-sm text-[#C21E2E]"></i> @Model.Count Invitation@(Model.Count == 1 ? "" : "s")
            </span>
        </div>
    </div>

    @* --- SCROLLABLE DATA SECTION --- *@
    <div class="flex-grow min-h-0 overflow-y-auto custom-scrollbar px-8 pb-16 pt-2 flex flex-col gap-4">

        @if (Model.Count == 0)
        {
            <div class="bg-white border-2 border-gray-200 shadow-sm p-16 text-center text-muted flex flex-col items-center justify-center">
                <i class="bi bi-envelope-open text-gray-300 text-6xl d-block mb-3"></i>
                <h4 class="font-serif font-bold text-gray-600 uppercase tracking-[2px] mb-1">No Pending Invitations</h4>
                <p class="text-[10px] font-mono text-gray-400 uppercase tracking-widest mb-0">
                    You currently have no active event invitations on your dossier.
                </p>
            </div>
        }

        @foreach (var inv in Model)
        {
            var evt = inv.Event;
            bool open = inv.Status.AcceptingResponses;
            string answer = inv.Response == null ? null
                : inv.Response.ResponseStatus == "Attending" ? "You're Attending" : "You're Not Attending";

            string statusBadgeClass = open ? "bg-green-50 text-green-700 border-green-200"
                : inv.Status.State == Michaelhouse.Services.RsvpState.ScheduledToOpen ? "bg-blue-50 text-blue-700 border-blue-200"
                : "bg-gray-100 text-gray-600 border-gray-200";

            <div class="bg-white border-2 border-gray-200 hover:border-[#C21E2E] shadow-xs hover:shadow-md transition-all duration-300 p-6 flex flex-col md:flex-row justify-between items-start md:items-center gap-6 relative overflow-hidden group">

                @* Event Information *@
                <div class="flex flex-col flex-grow">
                    <h3 class="font-serif font-bold text-xl text-gray-900 group-hover:text-[#C21E2E] transition-colors mb-1">
                        @evt.EventName
                    </h3>

                    <div class="text-xs font-mono text-gray-500 uppercase tracking-wider mb-4 leading-relaxed">
                        <span>
                            <i class="bi bi-calendar-event me-1 text-gray-400"></i> @evt.EventDate.ToString("dddd, dd MMMM yyyy")
                        </span>
                        <span class="mx-2 text-gray-300">|</span>
                        <span>
                            <i class="bi bi-clock me-1 text-gray-400"></i> @evt.StartTime.ToString(@"hh\:mm") – @evt.EndTime.ToString(@"hh\:mm")
                        </span>
                        @if (evt.Venue != null)
                        {
                            <span class="mx-2 text-gray-300">|</span>
                            <span><i class="bi bi-geo-alt me-1 text-gray-400"></i> @evt.Venue.Name</span>
                        }
                    </div>

                    @* Status Badges *@
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="inline-flex items-center text-[9px] font-mono font-bold uppercase tracking-widest px-2.5 py-1 border shadow-2xs @statusBadgeClass">
                            RSVP @inv.Status.Label — @inv.Status.Detail
                        </span>

                        @if (answer != null)
                        {
                            <span class="inline-flex items-center text-[9px] font-mono font-bold uppercase tracking-widest px-2.5 py-1 border shadow-2xs bg-amber-50 text-amber-800 border-amber-200">
                                <i class="bi bi-person-check me-1"></i> @answer
                            </span>
                        }
                    </div>
                </div>

                @* Call to Action *@
                <div class="flex-shrink-0 w-full md:w-auto mt-2 md:mt-0">
                    @if (open && inv.Response == null)
                    {
                        <a href="@Url.Action("Event", "Rsvp", new { id = evt.Id })" class="w-full md:w-auto inline-flex items-center justify-center bg-[#C21E2E] text-white px-8 py-3.5 text-[10px] font-bold uppercase tracking-[2px] hover:bg-red-700 hover:shadow-[0_0_15px_rgba(194,30,46,0.4)] transition-all duration-300 shadow-sm text-decoration-none">
                            RSVP Now
                        </a>
                    }
                    else
                    {
                        <a href="@Url.Action("Event", "Rsvp", new { id = evt.Id })" class="w-full md:w-auto inline-flex items-center justify-center bg-white border border-gray-300 text-gray-700 px-8 py-3.5 text-[10px] font-bold uppercase tracking-[2px] hover:bg-gray-50 hover:border-gray-900 transition-all duration-300 shadow-sm text-decoration-none">
                            @(open ? "View / Change RSVP" : "View Details")
                        </a>
                    }
                </div>
            </div>
        }

    </div>
</div>

<style>
    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }

    .font-mono {
        font-family: 'Source Code Pro', monospace !important;
    }

    .custom-scrollbar::-webkit-scrollbar {
        width: 5px;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #d1d5db;
        border-radius: 10px;
    }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #C21E2E;
        }
</style>
@model Michaelhouse.Models.Bed
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Create Bed";
}
<div class="container py-4">
    <h2>Create Bed</h2>
    @using (Html.BeginForm()) {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        <div class="form-group">@Html.LabelFor(m => m.RoomId) @Html.DropDownListFor(m => m.RoomId, (SelectList)ViewBag.Rooms, "Select room", new { @class = "form-control" })</div>
        <div class="form-group">@Html.LabelFor(m => m.BedNumber) @Html.TextBoxFor(m => m.BedNumber, new { @class = "form-control" }) @Html.ValidationMessageFor(m => m.BedNumber, "", new { @class = "text-danger" })</div>
        <div class="form-group">@Html.LabelFor(m => m.Status) @Html.DropDownListFor(m => m.Status, new SelectList(new[] { "Available", "Maintenance", "Reserved" }), new { @class = "form-control" })</div>
        <button type="submit" class="btn btn-primary">Save</button>
        <a href="@Url.Action("Index")" class="btn btn-default">Cancel</a>
    }
</div>

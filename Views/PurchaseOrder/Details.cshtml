@model Michaelhouse.Models.PurchaseOrder
@using Michaelhouse.Models

@{
    ViewBag.Title = "Procurement Dossier";
    string statusColor = Model.Status == PurchaseOrderStatus.Received ? "#10b981"
                       : Model.Status == PurchaseOrderStatus.Sent ? "#C21E2E"
                       : Model.Status == PurchaseOrderStatus.Cancelled ? "#9ca3af" : "#f59e0b";
}

@* --- FULL SCREEN VIEWPORT CONTAINER --- *@
<div class="flex flex-col h-full w-full overflow-hidden">

    @* --- INSTITUTIONAL HEADER --- *@
    <div class="mb-10 d-flex justify-content-between align-items-end border-b border-gray-100 pb-8 flex-shrink-0">
        <div>
            <div class="flex items-center gap-2 mb-3">
                <div class="h-[2px] w-8 bg-[#C21E2E]"></div>
                <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Logistics & Supply</h5>
            </div>
            <div class="flex items-center gap-4">
                <h2 class="text-5xl font-serif font-bold text-gray-900 tracking-tight">PO: @Model.PoNumber</h2>
                <span class="px-3 py-1 text-[10px] font-bold uppercase tracking-widest border mt-2"
                      style="color: @statusColor; border-color: @statusColor;">
                    @Model.Status
                </span>
            </div>
        </div>
        <div class="text-right">
            <a href="@Url.Action("Index")" class="inline-block bg-white border border-gray-200 px-6 py-2 text-[9px] font-bold uppercase tracking-[2px] hover:bg-gray-50 transition-all shadow-sm">
                <i class="bi bi-arrow-left me-2"></i> Return to Ledger
            </a>
        </div>
    </div>

    @* --- SCROLLABLE DOSSIER CONTENT --- *@
    <div class="flex-grow min-h-0 overflow-y-auto custom-scrollbar pr-2">
        <div class="row g-5">

            @* --- LEFT SIDE: ARCHIVAL METADATA --- *@
            <div class="col-lg-4">
                @* Supplier Card *@
                <div class="bg-white shadow-sm border border-gray-100 overflow-hidden relative mb-6">
                    <div class="p-6 border-b border-gray-100 bg-gray-50/50">
                        <h5 class="text-[10px] uppercase tracking-[3px] font-bold text-gray-900 mb-0">01. Vendor Identity</h5>
                    </div>
                    <div class="p-6">
                        <h3 class="text-serif font-bold text-xl text-gray-900 mb-4">@Model.Supplier.Name</h3>
                        <div class="space-y-3">
                            <div class="flex justify-between border-b border-gray-50 pb-1">
                                <span class="text-[9px] uppercase font-bold text-gray-400">Liaison</span>
                                <span class="text-xs font-semibold text-gray-700">@Model.Supplier.ContactPerson</span>
                            </div>
                            <div class="flex justify-between border-b border-gray-50 pb-1">
                                <span class="text-[9px] uppercase font-bold text-gray-400">Communication</span>
                                <span class="text-[11px] font-mono text-gray-700 lowercase">@Model.Supplier.Email</span>
                            </div>
                            <div class="flex justify-between border-b border-gray-50 pb-1">
                                <span class="text-[9px] uppercase font-bold text-gray-400">Registry Phone</span>
                                <span class="text-xs font-mono text-gray-700">@Model.Supplier.Phone</span>
                            </div>
                        </div>
                    </div>
                </div>

                @* Timeline Card *@
                <div class="bg-white shadow-sm border border-gray-100 overflow-hidden relative">
                    <div class="p-6 border-b border-gray-100 bg-gray-50/50">
                        <h5 class="text-[10px] uppercase tracking-[3px] font-bold text-gray-900 mb-0">02. Logistics Timeline</h5>
                    </div>
                    <div class="p-6 space-y-4">
                        <div>
                            <p class="text-[9px] uppercase font-bold text-gray-400 mb-1">Origination Date</p>
                            <p class="text-sm font-serif italic text-gray-800">@Model.CreatedAt.ToString("dd MMMM yyyy HH:mm")</p>
                        </div>
                        <div>
                            <p class="text-[9px] uppercase font-bold text-gray-400 mb-1">Target Delivery</p>
                            <p class="text-sm font-serif italic text-gray-800">@(Model.ExpectedDelivery?.ToString("dd MMMM yyyy") ?? "Awaiting Schedule")</p>
                        </div>
                        <div>
                            <p class="text-[9px] uppercase font-bold text-gray-400 mb-1">Dispatch Status</p>
                            <p class="text-sm font-mono @(Model.SentAt.HasValue ? "text-green-600" : "text-amber-600")">
                                @(Model.SentAt?.ToString("dd MMM yyyy HH:mm") ?? "Awaiting Authorization")
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            @* --- RIGHT SIDE: ORDER LEDGER --- *@
            <div class="col-lg-8">
                <div class="bg-white shadow-sm border border-gray-100 overflow-hidden relative mb-6">
                    @* Archival Dot Grid Header *@
                    <div class="p-8 border-b border-gray-100 d-flex justify-content-between align-items-center relative bg-white overflow-hidden">
                        <div class="absolute inset-0 opacity-[0.05] pointer-events-none"
                             style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 20px 20px;"></div>
                        <div class="relative z-10">
                            <h5 class="text-xs uppercase tracking-[4px] font-bold text-gray-900 mb-0">Asset Procurement Items</h5>
                        </div>
                        <div class="relative z-10 text-right">
                            <p class="text-[9px] uppercase font-bold text-gray-400 mb-0">Total Fiscal Value</p>
                            <h4 class="text-2xl font-mono font-bold text-gray-900">ZAR @Model.TotalAmount.ToString("N2")</h4>
                        </div>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle w-full">
                            <thead>
                                <tr class="text-[9px] uppercase tracking-[4px] font-bold text-gray-400 border-b bg-gray-50/30">
                                    <th class="ps-8 py-4">Item Identity</th>
                                    <th class="text-center">Req. Qty</th>
                                    <th class="text-center">Rec. Qty</th>
                                    <th class="text-end">Unit Cost</th>
                                    <th class="pe-8 text-end">Line Total</th>
                                </tr>
                            </thead>
                            <tbody class="text-gray-700">
                                @foreach (var item in Model.LineItems)
                                {
                                    <tr class="border-b border-gray-50 last:border-0">
                                        <td class="ps-8 py-4">
                                            <div class="fw-bold text-gray-900">@item.Product.Name</div>
                                            <div class="text-[9px] text-gray-400 uppercase tracking-tighter">@item.Product.Category.Name</div>
                                        </td>
                                        <td class="text-center font-mono text-sm">@item.QuantityOrdered</td>
                                        <td class="text-center">
                                            @if (Model.Status == PurchaseOrderStatus.Received)
                                            {
                                                <span class="text-green-600 font-bold font-mono">@item.QuantityReceived</span>
                                            }
                                            else
                                            {
                                                <span class="text-gray-300">—</span>
                                            }
                                        </td>
                                        <td class="text-end font-mono text-xs text-gray-500">@item.UnitCost.ToString("N2")</td>
                                        <td class="pe-8 text-end font-mono font-bold text-gray-900">@item.TotalCost.ToString("N2")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                @* --- ADMINISTRATIVE ACTIONS --- *@
                <div class="flex justify-end gap-3 mt-8 pb-10">
                    @if (Model.Status == PurchaseOrderStatus.Draft)
                    {
                        using (Html.BeginForm("Approve", "PurchaseOrder", new { id = Model.PurchaseOrderId }, FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <button type="submit" class="bg-black text-white px-8 py-3 text-[10px] font-bold uppercase tracking-[3px] hover:bg-[#C21E2E] transition-all shadow-xl"
                                    onclick="return confirm('Authorize and dispatch this dossier?');">
                                <i class="bi bi-shield-check me-2"></i> Authorize & Dispatch
                            </button>
                        }
                    }

                    @if (Model.Status == PurchaseOrderStatus.Sent)
                    {
                        <button type="button" class="bg-[#C21E2E] text-white px-8 py-3 text-[10px] font-bold uppercase tracking-[3px] hover:bg-black transition-all shadow-xl"
                                data-bs-toggle="modal" data-bs-target="#receiveModal">
                            <i class="bi bi-box-seam me-2"></i> Log Fulfillment
                        </button>
                    }

                    @if (Model.Status == PurchaseOrderStatus.Draft || Model.Status == PurchaseOrderStatus.Sent)
                    {
                        using (Html.BeginForm("Cancel", "PurchaseOrder", new { id = Model.PurchaseOrderId }, FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <button type="submit" class="border border-red-200 text-red-600 px-8 py-3 text-[10px] font-bold uppercase tracking-[3px] hover:bg-red-50 transition-all"
                                    onclick="return confirm('Void this procurement dossier?');">
                                <i class="bi bi-x-circle me-2"></i> Void Order
                            </button>
                        }
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@* --- MODAL: LOG FULFILLMENT --- *@
@if (Model.Status == PurchaseOrderStatus.Sent)
{
    <div class="modal fade" id="receiveModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 rounded-0 shadow-2xl">
                <div class="p-8 border-b border-gray-100 bg-[#1a1a1a] text-white">
                    <h5 class="text-xs uppercase tracking-[4px] font-bold mb-0">Record Goods Receipt</h5>
                </div>
                @using (Html.BeginForm("Receive", "PurchaseOrder", new { id = Model.PurchaseOrderId }, FormMethod.Post))
                {
                    @Html.AntiForgeryToken()
                    <div class="modal-body p-8 bg-white">
                        <p class="text-sm text-gray-500 mb-6 font-serif italic">Inventory levels will be adjusted automatically upon confirmation.</p>
                        <div class="mb-3">
                            <label class="text-[9px] uppercase tracking-[2px] font-bold text-gray-400 d-block mb-2">Registry Notes</label>
                            <textarea name="notes" class="w-full p-4 bg-gray-50 border-0 outline-none text-sm font-serif italic" rows="3" placeholder="Condition of delivery..."></textarea>
                        </div>
                    </div>
                    <div class="modal-footer border-t border-gray-100 p-6 bg-gray-50/50">
                        <button type="button" class="text-[9px] font-bold uppercase tracking-[2px] text-gray-400 px-4" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="bg-black text-white px-8 py-3 text-[10px] font-bold uppercase tracking-[3px]">Seal Record</button>
                    </div>
                }
            </div>
        </div>
    </div>
}

<style>
    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }

    .font-mono {
        font-family: 'Source Code Pro', monospace !important;
    }

    .text-serif {
        font-family: 'Playfair Display', serif;
    }

    /* Internal scrollbar custom styling */
    .custom-scrollbar::-webkit-scrollbar {
        width: 4px;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #eee;
        border-radius: 10px;
    }
</style>
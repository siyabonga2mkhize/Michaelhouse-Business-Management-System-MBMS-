@using Michaelhouse.Models
@{
    ViewBag.Title = "New Procurement Order";
    var suppliers = (List<Supplier>)ViewBag.Suppliers;
    var selectedSupplier = (Supplier)ViewBag.SelectedSupplier;
}

<div class="mb-10 d-flex justify-content-between align-items-end border-b border-gray-100 pb-8">
    <div>
        <div class="flex items-center gap-2 mb-3">
            <div class="h-[2px] w-8 bg-[#C21E2E]"></div>
            <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Logistics & Supply</h5>
        </div>
        <h2 class="text-5xl font-serif font-bold text-gray-900 tracking-tight">New Procurement Order</h2>
    </div>
    <a href="@Url.Action("Index", "PurchaseOrder")"
       class="inline-block bg-white border border-gray-200 px-6 py-2 text-[9px] font-bold uppercase tracking-[2px] hover:bg-gray-50 transition-all shadow-sm">
        <i class="bi bi-arrow-left me-2"></i> Back to Orders
    </a>
</div>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger border-0 shadow-sm mb-6 text-sm">
        <i class="bi bi-exclamation-triangle me-2"></i>@TempData["Error"]
    </div>
}

@using (Html.BeginForm("Create", "PurchaseOrder", FormMethod.Post, new { id = "poForm" }))
{
    @Html.AntiForgeryToken()

    <div class="row g-6">

        <!-- Left column: supplier + notes -->
        <div class="col-lg-4">

            <div class="bg-white border border-gray-100 shadow-sm p-6 mb-6">
                <h6 class="text-[10px] uppercase tracking-[3px] font-bold text-gray-400 mb-4">1. Select Supplier</h6>

                <div class="mb-4">
                    <label class="form-label text-[10px] font-bold uppercase tracking-widest text-gray-500">Supplier</label>
                    <select id="supplierSelect" name="supplierId"
                            class="form-select text-sm border-gray-200"
                            onchange="loadSupplierProducts(this.value)" required>
                        <option value="">— Choose a supplier —</option>
                        @foreach (var s in suppliers)
                        {
                            <option value="@s.SupplierId"
                                    @(selectedSupplier != null && s.SupplierId == selectedSupplier.SupplierId ? "selected" : "")>
                                @s.Name
                            </option>
                        }
                    </select>
                </div>

                <div id="supplierMeta" class="text-[10px] text-gray-400 hidden">
                    <!-- Populated by JS -->
                </div>
            </div>

            <div class="bg-white border border-gray-100 shadow-sm p-6 mb-6">
                <h6 class="text-[10px] uppercase tracking-[3px] font-bold text-gray-400 mb-4">2. Notes (optional)</h6>
                <textarea name="notes" rows="4"
                          class="form-control text-sm border-gray-200"
                          placeholder="e.g. Urgent delivery required, specific instructions..."></textarea>
            </div>

            <!-- Order Summary -->
            <div class="bg-[#1a1a1a] p-6 shadow-lg">
                <p class="text-[9px] uppercase tracking-widest font-bold text-gray-500 mb-3">Order Summary</p>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-[11px] text-gray-400">Line Items</span>
                    <span id="summaryCount" class="text-[11px] font-bold text-white">0</span>
                </div>
                <div class="d-flex justify-content-between border-t border-gray-700 pt-3 mt-3">
                    <span class="text-[11px] text-gray-400">Estimated Total</span>
                    <span id="summaryTotal" class="font-serif font-bold text-white text-lg">ZAR 0.00</span>
                </div>
                <button type="submit" id="submitBtn"
                        class="w-100 mt-5 bg-[#C21E2E] text-white py-3 text-[9px] font-bold uppercase tracking-[2px] border-0 hover:bg-red-800 transition-all disabled:opacity-40"
                        disabled
                        onclick="return confirm('Create this purchase order as Draft?')">
                    <i class="bi bi-file-earmark-plus me-2"></i> Create Draft PO
                </button>
            </div>
        </div>

        <!-- Right column: product lines -->
        <div class="col-lg-8">
            <div class="bg-white border border-gray-100 shadow-sm overflow-hidden">
                <div class="p-6 border-b border-gray-100 d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-[10px] uppercase tracking-[3px] font-bold text-gray-400 mb-1">3. Select Products</h6>
                        <p class="text-[9px] text-gray-300 font-bold uppercase tracking-widest mb-0">
                            Set quantity to 0 to exclude an item
                        </p>
                    </div>
                    <span id="lowStockBadge" class="hidden px-3 py-1 text-[8px] font-bold uppercase tracking-widest border border-red-600 text-red-600">
                        <i class="bi bi-exclamation-triangle me-1"></i> Low stock items highlighted
                    </span>
                </div>

                <!-- Loading state -->
                <div id="productsLoading" class="py-16 text-center text-gray-300 hidden">
                    <div class="spinner-border spinner-border-sm me-2 opacity-30"></div>
                    <span class="text-[10px] uppercase tracking-widest font-bold">Loading products…</span>
                </div>

                <!-- Empty / prompt state -->
                <div id="productsEmpty" class="py-16 text-center text-gray-300">
                    <i class="bi bi-truck" style="font-size:2.5rem;opacity:0.15;"></i>
                    <p class="text-[10px] uppercase tracking-widest font-bold mt-4 mb-0">Select a supplier to load their products</p>
                </div>

                <!-- Product table -->
                <div id="productsTable" class="hidden">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0 align-middle">
                            <thead>
                                <tr class="text-[9px] uppercase tracking-[3px] font-bold text-gray-400 border-b bg-gray-50/30">
                                    <th class="ps-6 py-4">Product</th>
                                    <th>Category</th>
                                    <th class="text-center">Current Stock</th>
                                    <th class="text-center" style="width:120px;">Quantity</th>
                                    <th class="text-end pe-6">Unit Cost</th>
                                    <th class="text-end pe-6">Line Total</th>
                                </tr>
                            </thead>
                            <tbody id="productRows">
                                <!-- Populated by JS -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }

    .font-mono {
        font-family: 'Source Code Pro', monospace !important;
    }

    .hidden {
        display: none !important;
    }
</style>

@section Scripts {
    <script>
    var allProducts = [];

    function loadSupplierProducts(supplierId) {
        var empty   = document.getElementById('productsEmpty');
        var loading = document.getElementById('productsLoading');
        var table   = document.getElementById('productsTable');
        var badge   = document.getElementById('lowStockBadge');

        if (!supplierId) {
            empty.classList.remove('hidden');
            loading.classList.add('hidden');
            table.classList.add('hidden');
            badge.classList.add('hidden');
            updateSummary();
            return;
        }

        empty.classList.add('hidden');
        table.classList.add('hidden');
        loading.classList.remove('hidden');
        badge.classList.add('hidden');

        fetch('@Url.Action("GetSupplierProducts", "PurchaseOrder")?supplierId=' + supplierId)
            .then(function(r) { return r.json(); })
            .then(function(products) {
                allProducts = products;
                renderProducts(products);
                loading.classList.add('hidden');
                if (products.length === 0) {
                    empty.classList.remove('hidden');
                    empty.querySelector('p').textContent = 'No products linked to this supplier.';
                } else {
                    table.classList.remove('hidden');
                    var hasLow = products.some(function(p) { return p.isLowStock; });
                    if (hasLow) badge.classList.remove('hidden');
                }
                updateSummary();
            })
            .catch(function() {
                loading.classList.add('hidden');
                empty.classList.remove('hidden');
                empty.querySelector('p').textContent = 'Failed to load products. Please try again.';
            });
    }

    function renderProducts(products) {
        var tbody = document.getElementById('productRows');
        tbody.innerHTML = '';

        products.forEach(function(p, i) {
            var rowClass = p.isLowStock ? 'bg-red-50/40' : '';
            var stockBadge = p.currentStock === 0
                ? "<span class='px-2 py-1 text-[8px] font-bold uppercase border border-red-600 text-red-600'>Depleted</span>"
                : p.isLowStock
                    ? "<span class='px-2 py-1 text-[8px] font-bold uppercase border border-amber-500 text-amber-600'>" + p.currentStock + " units</span>"
                    : "<span class='text-[11px] font-bold text-gray-400 font-mono'>" + p.currentStock + "</span>";

            // Default quantity: either the min order qty, or enough to bring stock to 2x reorder
            var suggestedQty = p.isLowStock
                ? Math.max(p.minOrderQty, p.reorderLevel * 2 - p.currentStock)
                : p.minOrderQty;

            tbody.innerHTML +=
                "<tr class='border-b border-gray-50 last:border-0 " + rowClass + "' id='row-" + i + "'>" +
                "  <input type='hidden' name='productIds' value='" + p.productId + "' />" +
                "  <input type='hidden' name='unitCosts'  id='cost-" + i + "' value='" + p.unitCost + "' />" +
                "  <td class='ps-6 py-4'>" +
                "    <div class='fw-bold text-gray-900 text-sm'>" + p.productName + "</div>" +
                "    <div class='text-[9px] text-gray-300 font-mono'>MH-PRD-" + p.productId + "</div>" +
                "  </td>" +
                "  <td><span class='font-serif italic text-sm text-gray-500'>" + p.category + "</span></td>" +
                "  <td class='text-center'>" + stockBadge + "</td>" +
                "  <td class='text-center'>" +
                "    <input type='number' name='quantities' id='qty-" + i + "'" +
                "           class='form-control form-control-sm text-center border-gray-200 font-mono fw-bold'" +
                "           style='width:80px;margin:auto;'" +
                "           value='" + suggestedQty + "' min='0' step='1'" +
                "           oninput='updateRow(" + i + ")' />" +
                "  </td>" +
                "  <td class='text-end pe-6 font-mono text-[11px] font-bold text-gray-600'>ZAR " + p.unitCost.toFixed(2) + "</td>" +
                "  <td class='text-end pe-6 font-mono text-[11px] font-bold text-gray-900' id='total-" + i + "'>" +
                "    ZAR " + (suggestedQty * p.unitCost).toFixed(2) +
                "  </td>" +
                "</tr>";
        });
    }

    function updateRow(i) {
        var qty  = parseFloat(document.getElementById('qty-' + i).value)  || 0;
        var cost = parseFloat(document.getElementById('cost-' + i).value) || 0;
        document.getElementById('total-' + i).textContent = 'ZAR ' + (qty * cost).toFixed(2);
        updateSummary();
    }

    function updateSummary() {
        var totalAmt   = 0;
        var lineCount  = 0;
        var submitBtn  = document.getElementById('submitBtn');

        for (var i = 0; i < allProducts.length; i++) {
            var qtyEl  = document.getElementById('qty-'  + i);
            var costEl = document.getElementById('cost-' + i);
            if (!qtyEl || !costEl) continue;
            var qty  = parseFloat(qtyEl.value)  || 0;
            var cost = parseFloat(costEl.value) || 0;
            if (qty > 0) {
                totalAmt  += qty * cost;
                lineCount += 1;
            }
        }

        document.getElementById('summaryCount').textContent = lineCount;
        document.getElementById('summaryTotal').textContent = 'ZAR ' + totalAmt.toFixed(2);

        var hasSuplier = document.getElementById('supplierSelect').value !== '';
        submitBtn.disabled = !(lineCount > 0 && hasSuplier);
    }

    // Auto-load if supplier was pre-selected via query string
    (function () {
        var sel = document.getElementById('supplierSelect');
        if (sel && sel.value) loadSupplierProducts(sel.value);
    })();
    </script>
}

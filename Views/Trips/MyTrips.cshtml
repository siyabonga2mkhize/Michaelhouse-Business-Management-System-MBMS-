@model IEnumerable<Michaelhouse.Models.ViewModels.DriverTripVM>

<h2 class="font-serif text-3xl mb-6">My Trips</h2>

@foreach (var trip in Model)
{
    <div class="card mb-4 shadow-sm">
        <div class="card-body">
            <h5 class="fw-bold">@trip.Destination</h5>

            <p class="text-muted">
                @trip.StartTime.ToString("dd MMM yyyy HH:mm")
                –
                @trip.EndTime.ToString("dd MMM yyyy HH:mm")
            </p>

            <p>
                <strong>Vehicle:</strong> @trip.VehicleNumber
                (<span>@trip.Capacity seats</span>)
            </p>

            <h6 class="mt-3">Student Manifest</h6>

            <ul class="mb-0">
                @foreach (var s in trip.Students)
                {
                    <li>@s</li>
                }
            </ul>
        </div>
    </div>
}
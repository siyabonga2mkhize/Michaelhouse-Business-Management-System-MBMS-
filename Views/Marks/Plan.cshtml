@model dynamic
@using Michaelhouse.Models
@{
    ViewBag.Title = "Plan Assessment";
    var assignments = ViewBag.Assignments as List<Michaelhouse.Models.TeacherSubjectGrade>;
    var terms = ViewBag.Terms as IEnumerable<object>;
    var types = ViewBag.AssessmentTypes as string[];
}
<link rel="stylesheet" href="~/Content/academic.css" />

<div class="ac-page" style="max-width:900px;">

    @if (TempData["Error"] != null)
    {
        <div class="ac-alert ac-alert-error" style="border-radius:0; font-weight:700; text-transform:uppercase; font-size:11px; tracking-widest;">✕ @TempData["Error"]</div>
    }

    <div class="ac-header">
        <div class="ac-header-left">
            <div class="ac-eyebrow">Academic Records — Faculty Portal</div>
            <h1 class="ac-title">Provision Assessment</h1>
            <p class="ac-subtitle">Define formal test parameters, examination weightings, and academic scheduling.</p>
        </div>
        <div class="ac-header-actions">
            <a href="@Url.Action("Index", "Marks")" class="btn btn-ghost">
                <i class="bi bi-arrow-left me-1"></i> Back to Ledger
            </a>
        </div>
    </div>

    <div class="ac-card">
        <div class="ac-card-header">
            <span class="ac-card-title">Assessment Specification</span>
            <i class="bi bi-file-earmark-medical text-gray-400"></i>
        </div>
        <div class="ac-card-body" style="padding: 40px;">

            @using (Html.BeginForm("Plan", "Marks", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="ac-form-grid" style="margin-bottom:32px;">

                    <div class="ac-field span-2">
                        <label class="ac-label">Academic Subject & Grade Allocation *</label>
                        <select name="subjectId" id="subjectSelect" class="ac-select" required onchange="updateGradeStream(this)">
                            <option value="">— Select Allocation —</option>
                            @if (assignments != null)
                            {
                                foreach (var a in assignments)
                                {
                                    <option value="@a.SubjectId"
                                            data-grade="@a.Grade"
                                            data-stream="@((int)a.Stream)">
                                        @a.Subject?.Name — Grade @a.Grade
                                        @(a.Stream != Michaelhouse.Models.Enums.AcademicStream.None ? $" ({a.Stream})" : "")
                                    </option>
                                }
                            }
                        </select>
                        <input type="hidden" name="grade" id="hiddenGrade" value="" />
                        <input type="hidden" name="stream" id="hiddenStream" value="0" />
                    </div>

                    <div class="ac-field span-2">
                        <label class="ac-label">Official Assessment Title *</label>
                        <input type="text" name="title" class="ac-input" required
                               placeholder="e.g. TERMINAL EXAMINATION, CLASS TEST 1" maxlength="200" />
                    </div>

                    <div class="ac-field">
                        <label class="ac-label">Assessment Category *</label>
                        <select name="assessmentType" class="ac-select" required>
                            @if (types != null)
                            {
                                foreach (var t in types)
                                {
                                    <option value="@t">@t</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="ac-field">
                        <label class="ac-label">Academic Term *</label>
                        <select name="term" class="ac-select" required>
                            @if (terms != null)
                            {
                                foreach (var t in terms)
                                {
                                    var type = t.GetType();
                                    var valueProp = type.GetProperty("Value");
                                    var textProp = type.GetProperty("Text");
                                    var value = valueProp != null ? valueProp.GetValue(t, null) : t;
                                    var text = textProp != null ? textProp.GetValue(t, null) : t;
                                    <option value="@value">@text</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="ac-field">
                        <label class="ac-label">Academic Year *</label>
                        <input type="number" name="academicYear" class="ac-input"
                               value="@DateTime.Now.Year" min="2020" max="2040" required />
                    </div>

                    <div class="ac-field">
                        <label class="ac-label">Sitting Date *</label>
                        <input type="date" name="scheduledDate" class="ac-input" required
                               value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                    </div>

                    <div class="ac-field">
                        <label class="ac-label">Total Raw Marks *</label>
                        <input type="number" name="totalMarks" class="ac-input font-monospace"
                               min="1" max="1000" step="0.5" placeholder="100" required />
                    </div>

                    <div class="ac-field">
                        <label class="ac-label">Term Weighting (%) *</label>
                        <input type="number" name="weightingPercent" id="weightingInput" class="ac-input font-monospace"
                               min="1" max="100" step="1" placeholder="30"
                               required oninput="updateWeightBar(this.value)" />

                        <div class="ac-progress" style="margin-top:12px; height: 4px; background: #f0f0f0;">
                            <div id="weightBar" class="ac-progress-bar" style="width:0%; background: var(--mh-red);"></div>
                        </div>
                        <p id="weightNote" class="text-[10px] uppercase tracking-wider font-bold mt-2 text-gray-400">Contribution to final mark</p>
                    </div>

                    <div class="ac-field span-3">
                        <label class="ac-label">Administrative Notes</label>
                        <textarea name="notes" class="ac-textarea" style="min-height: 100px;"
                                  placeholder="Contextual instructions for invigilators or internal staff..."></textarea>
                    </div>

                </div>

                <div style="display:flex; gap:16px; justify-content:flex-end; padding-top:24px; border-top:1px solid var(--mh-border);">
                    <a href="@Url.Action("Index", "Marks")" class="btn btn-ghost" style="border:none; color: #999;">Discard</a>
                    <button type="submit" class="btn btn-primary" style="padding: 14px 40px; box-shadow: var(--shadow);">
                        <i class="bi bi-shield-check me-2"></i> Finalize Assessment
                    </button>
                </div>
            }
        </div>
    </div>
</div>

<script>
    function updateGradeStream(select) {
        var opt = select.options[select.selectedIndex];
        document.getElementById('hiddenGrade').value = opt.dataset.grade || '';
        document.getElementById('hiddenStream').value = opt.dataset.stream || '0';
    }

    function updateWeightBar(val) {
        var pct = Math.min(Math.max(parseFloat(val) || 0, 0), 100);
        var bar = document.getElementById('weightBar');
        var note = document.getElementById('weightNote');

        bar.style.width = pct + '%';

        if (pct > 50) {
            bar.style.background = '#C21E2E'; // Michaelhouse Red for heavy weight
            note.style.color = '#C21E2E';
            note.innerText = "Significant Weighting Applied";
        } else {
            bar.style.background = '#1a1a1a'; // Charcoal for standard
            note.style.color = '#999';
            note.innerText = "Contribution to final mark";
        }
    }
</script>

<style>
    .ac-select, .ac-input {
        background-color: #fdfdfd;
        transition: all 0.2s ease;
    }

        .ac-select:hover, .ac-input:hover {
            border-color: #999;
        }

        .ac-textarea::placeholder, .ac-input::placeholder {
            color: #ccc;
            text-transform: uppercase;
            font-size: 10px;
            letter-spacing: 1px;
        }
</style>
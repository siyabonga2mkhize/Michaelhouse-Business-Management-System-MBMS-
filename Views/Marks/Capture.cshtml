@model List<Michaelhouse.Services.StudentMarkEntry>
@using Michaelhouse.Models.Enums
@using Michaelhouse.Services
@{
    var assessment = ViewBag.Assessment as Michaelhouse.Models.Assessment;

    // --- PROXY-PROOF DATA EXTRACTION ---
    // We extract these to local strings to force EF to resolve the values
    // and prevent the "System.Data.Entity.DynamicProxies" strings.
    string aTitle = assessment?.Title?.ToString() ?? "Untitled Assessment";
    string sName = assessment?.Subject?.Name?.ToString() ?? "Subject Unspecified";
    string aType = assessment?.AssessmentType?.ToString() ?? "General Assessment";
    string aGrade = assessment?.Grade.ToString() ?? "—";
    string aTerm = assessment?.Term.ToString() ?? "—";
    string aYear = assessment?.AcademicYear.ToString() ?? "—";
    string aDate = assessment?.ScheduledDate.ToString("dd MMMM yyyy") ?? "—";
    string totalMax = assessment?.TotalMarks.ToString("0.##") ?? "0";
    string weight = assessment?.WeightingPercent.ToString() ?? "0";

    ViewBag.Title = "Mark Capture — " + aTitle;
    bool closed = assessment?.MarksCaptureClosed ?? false;
}

<link rel="stylesheet" href="~/Content/academic.css" />

<div class="ac-page">

    @if (TempData["Success"] != null)
    {
        <div class="ac-alert ac-alert-success" style="border-radius:0; font-weight:700; text-transform:uppercase; font-size:10px; letter-spacing:1px;">
            <i class="bi bi-check-circle-fill me-2"></i> @TempData["Success"]
        </div>
    }

    <div class="ac-header">
        <div class="ac-header-left">
            <div class="ac-eyebrow">
                Mark Ledger — @sName Grade @aGrade
            </div>
            <h1 class="ac-title">@aTitle</h1>
            <p class="ac-subtitle">
                <span class="font-bold text-gray-900 uppercase tracking-tighter">@aType</span> &nbsp;·&nbsp;
                Term @aTerm, @aYear &nbsp;·&nbsp;
                @aDate &nbsp;·&nbsp;
                Out of <strong class="text-[#C21E2E]">@totalMax</strong> &nbsp;·&nbsp;
                Weighting: <strong>@weight%</strong>
            </p>
        </div>
        <div class="ac-header-actions">
            <a href="@Url.Action("Index", "Marks")" class="btn btn-ghost">
                <i class="bi bi-arrow-left me-1"></i> Back to Archive
            </a>
        </div>
    </div>

    @if (closed)
    {
        <div class="ac-alert border-l-4 border-gray-900 bg-gray-50 text-gray-900 mb-8" style="border-radius:0;">
            <i class="bi bi-lock-fill me-2 text-[#C21E2E]"></i> This ledger has been <strong>Sealed</strong>. Marks are currently in read-only mode.
        </div>
    }

    <div class="row g-4 mb-10">
        <div class="col-md-3">
            <div class="ac-stat">
                <div class="ac-stat-val">@Model.Count</div>
                <div class="ac-stat-lbl">TOTAL ENROLLMENT</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="ac-stat">
                <div class="ac-stat-val" id="capturedCount">@Model.Count(m => m.MarksObtained.HasValue)</div>
                <div class="ac-stat-lbl">MARKS CAPTURED</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="ac-stat">
                <div class="ac-stat-val" id="absentCount">@Model.Count(m => m.IsAbsent)</div>
                <div class="ac-stat-lbl">ABSENT / EXCUSED</div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="ac-stat" style="border-color: #C21E2E;">
                <div class="ac-stat-val text-[#C21E2E]" id="avgDisplay">—</div>
                <div class="ac-stat-lbl">CLASS AVERAGE</div>
            </div>
        </div>
    </div>

    <div class="ac-card">
        <div class="ac-card-header">
            <span class="ac-card-title">Mark Capture Ledger</span>
            @if (!closed)
            {
                <span class="text-[10px] font-bold uppercase tracking-widest text-gray-400">
                    <i class="bi bi-keyboard me-2"></i> Use 'Enter' to navigate down
                </span>
            }
        </div>

        @using (Html.BeginForm("Capture", "Marks", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="assessmentId" value="@(assessment?.AssessmentId ?? 0)" />

            <div class="ac-table-wrap">
                <table class="ac-table" id="markTable">
                    <thead>
                        <tr>
                            <th style="width:60px;" class="ps-4">#</th>
                            <th>Student Candidate</th>
                            <th style="width:100px; text-align:center;">Absent</th>
                            <th style="width:150px; text-align:right;">Raw Score <span class="text-[9px] opacity-50">/ @totalMax</span></th>
                            <th style="width:120px; text-align:right;">Percent</th>
                            <th class="pe-4">Institutional Comment</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-50">
                        @{ int rowNum = 0; }
                        @foreach (var entry in Model)
                        {
                            rowNum++;
                            string rowId = entry.StudentId.ToString();
                            <tr id="row-@rowId" class="group transition-colors hover:bg-red-50/30">
                                <td class="ps-4 text-[11px] font-monospace text-gray-400">@rowNum.ToString("D2")</td>
                                <td>
                                    <div class="font-bold text-gray-900">@(entry.StudentName ?? "Unknown Student")</div>
                                    @if (entry.AlreadyCaptured && !entry.IsAbsent)
                                    {
                                        <span class="text-[8px] font-bold uppercase tracking-widest text-green-600 border border-green-100 bg-green-50 px-2 py-0.5 mt-1 d-inline-block">Captured</span>
                                    }
                                </td>
                                <td style="text-align:center;">
                                    <input type="checkbox" name="absent_@rowId" id="absent_@rowId" class="absent-check"
                                           @(entry.IsAbsent ? "checked" : "") @(closed ? "disabled" : "") onchange="toggleAbsent('@rowId')" />
                                </td>
                                <td style="text-align:right;">
                                    <input type="number" name="mark_@rowId" id="mark_@rowId" class="mark-input font-monospace"
                                           value="@(entry.MarksObtained.HasValue ? entry.MarksObtained.Value.ToString("0.##") : "")"
                                           min="0" max="@totalMax" step="0.5"
                                           @(entry.IsAbsent || closed ? "disabled" : "") oninput="updatePct('@rowId', @totalMax)" />
                                </td>
                                <td style="text-align:right;">
                                    <span id="pct_@rowId" class="font-monospace font-bold text-sm text-gray-400">
                                        @if (entry.MarksObtained.HasValue && !entry.IsAbsent)
                                        {
                                            var p = Math.Round((double)entry.MarksObtained.Value / (double)(assessment?.TotalMarks ?? 1) * 100, 1);
                                            @(p.ToString("0.0") + "%")
                                        }
                                        else if (entry.IsAbsent)
                                        { <text>ABS</text> }
                                    else
                                    { <text>—</text>}
                                    </span>
                                </td>
                                <td class="pe-4">
                                    <input type="text" name="comment_@rowId" class="comment-input bg-transparent border-0 border-b border-gray-100 focus:border-[#C21E2E] rounded-0 text-xs w-100"
                                           value="@(entry.TeacherComment ?? "")" placeholder="Internal notes..." maxlength="300" @(closed ? "disabled" : "") />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            if (!closed)
            {
                <div class="p-8 flex justify-end gap-3 bg-gray-50 border-t border-gray-100">
                    <button type="submit" name="closeCapture" value="false" class="bg-white border border-gray-300 text-gray-700 px-8 py-3 text-[10px] font-bold uppercase tracking-widest hover:bg-gray-100 transition-all">
                        <i class="bi bi-save me-2"></i> Save Progress
                    </button>
                    <button type="submit" name="closeCapture" value="true" class="bg-[#1a1a1a] text-white px-10 py-3 text-[10px] font-bold uppercase tracking-widest hover:bg-[#C21E2E] transition-all shadow-lg"
                            onclick="return confirm('Seal this ledger? You will not be able to modify these results after sealing.')">
                        <i class="bi bi-shield-lock me-2"></i> Seal Assessment Results
                    </button>
                </div>
            }
        }
    </div>
</div>

<script>
    var totalMarks = parseFloat("@totalMax") || 100;

    function toggleAbsent(id) {
        var cb = document.getElementById('absent_' + id);
        var input = document.getElementById('mark_' + id);
        var pct = document.getElementById('pct_' + id);
        if (cb.checked) {
            input.disabled = true;
            input.value = '';
            pct.textContent = 'ABS';
            pct.style.color = '#999';
        } else {
            input.disabled = false;
            pct.textContent = '—';
        }
        recalcAvg();
    }

    function updatePct(id, total) {
        var input = document.getElementById('mark_' + id);
        var pct = document.getElementById('pct_' + id);
        var val = parseFloat(input.value);
        if (!isNaN(val) && total > 0) {
            var p = (val / total * 100).toFixed(1);
            pct.textContent = p + '%';
            pct.style.color = p >= 40 ? '#166534' : '#C21E2E';
        } else {
            pct.textContent = '—';
            pct.style.color = '#999';
        }
        recalcAvg();
    }

    function recalcAvg() {
        var rows = document.querySelectorAll('#markTable tbody tr');
        var sum = 0, count = 0, absCnt = 0, capCnt = 0;
        rows.forEach(function(row) {
            var id = row.id.replace('row-', '');
            var absent = document.getElementById('absent_' + id);
            var markEl = document.getElementById('mark_' + id);
            if (absent && absent.checked) { absCnt++; return; }
            if (markEl) {
                var v = parseFloat(markEl.value);
                if (!isNaN(v)) { sum += v; count++; capCnt++; }
            }
        });
        document.getElementById('avgDisplay').textContent =
            count > 0 ? (sum / count).toFixed(1) + ' / ' + totalMarks : '—';
        document.getElementById('capturedCount').textContent = capCnt;
        document.getElementById('absentCount').textContent = absCnt;
    }

    recalcAvg();

    document.querySelectorAll('.mark-input').forEach(function(inp, idx, all) {
        inp.addEventListener('keydown', function(e) {
            if (e.key === 'Enter') {
                e.preventDefault();
                if (all[idx + 1]) all[idx + 1].focus();
            }
        });
    });
</script>

<style>
    .mark-input {
        width: 80px;
        border-radius: 0;
        border: 1px solid #eee;
        padding: 5px;
        text-align: right;
    }

        .mark-input:focus {
            border-color: #C21E2E;
            outline: none;
            background: #fff5f5;
        }

    .absent-check {
        width: 18px;
        height: 18px;
        accent-color: #C21E2E;
        cursor: pointer;
    }

    .comment-input:focus {
        outline: none;
    }
</style>
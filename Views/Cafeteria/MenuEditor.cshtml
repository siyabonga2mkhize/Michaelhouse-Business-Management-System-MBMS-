@model Michaelhouse.Models.WeeklyMenu
@{
    ViewBag.Title = "Menu Editor";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var mealSlots = ViewBag.MealSlots as List<Michaelhouse.Models.MealSlot> ?? new List<Michaelhouse.Models.MealSlot>();
    var menuItems = ViewBag.MenuItems as List<Michaelhouse.Models.MenuItem> ?? new List<Michaelhouse.Models.MenuItem>();
    var validation = ViewBag.Validation as Michaelhouse.Services.MenuValidationResult;
    var role = ViewBag.Role as string;
    int selectedMealId = 0;
    if (ViewBag.SelectedMealId != null) { selectedMealId = (int)ViewBag.SelectedMealId; }

    var gridSlots = mealSlots.Where(s =>
        s.Name != "Sports Meal" && s.Name != "Event Meal")
        .OrderBy(s => s.DisplayOrder).ToList();

    var days = Model.Days.OrderBy(d => d.Date).ToList();

    var dayMap = new Dictionary<DateTime, Michaelhouse.Models.MenuDay>();
    foreach (var d in days)
    {
        dayMap[d.Date.Date] = d;
    }

    Michaelhouse.Models.MenuMeal selectedMeal = null;
    if (selectedMealId > 0)
    {
        foreach (var d in days)
        {
            var m = d.Meals.FirstOrDefault(x => x.Id == selectedMealId);
            if (m != null)
            {
                selectedMeal = m;
                break;
            }
        }
    }

    var canEdit = role == "MealCoordinator" && Model.Status != "Published";
}

<div class="relative mb-6 border-b border-gray-100 bg-gray-50/30 py-6 px-4 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none"
         style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 24px 24px;"></div>
    <i class="bi bi-calendar3 absolute -right-8 -bottom-10 text-black/5 text-[10rem] rotate-12"></i>

    <div class="max-w-7xl mx-auto relative z-10 flex justify-between items-end">
        <div>
            <div class="flex items-center gap-2 mb-3">
                <div class="h-1 w-8 bg-[#C21E2E]"></div>
                <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Menu Editor</h5>
            </div>
            <h2 class="text-3xl font-serif font-bold text-gray-900 tracking-tight">@Model.WeekNumber</h2>
            <p class="text-gray-400 text-[10px] uppercase tracking-widest font-bold mt-2">
                @Model.StartDate.ToString("dd MMM") – @Model.EndDate.ToString("dd MMM yyyy")
                &bull; Status:
                @if (Model.Status == "Published")
                {<span class="text-green-600 font-bold">Published</span> }
                else if (Model.Status == "ChefApproved")
                { <span class="text-blue-600 font-bold">Chef Approved</span> }
                else
                { <span class="text-amber-600 font-bold">@Model.Status</span>}
            </p>
        </div>
        <div class="flex gap-2">
            <a href="@Url.Action("MenuIssues", "Cafeteria", new { id = Model.WeeklyMenuID })"
               class="bg-white border border-gray-200 px-5 py-3 text-[10px] font-bold uppercase tracking-widest text-gray-700 hover:border-[#C21E2E] hover:text-[#C21E2E]">
                <i class="bi bi-clipboard-check me-2"></i>Validation
            </a>
            <a href="@Url.Action("WeeklyMenu", "Cafeteria")"
               class="bg-gray-200 text-gray-700 px-5 py-3 text-[10px] font-bold uppercase tracking-widest hover:bg-gray-300">
                <i class="bi bi-arrow-left me-2"></i>Back
            </a>
        </div>
    </div>
</div>

<div class="max-w-7xl mx-auto px-4 pb-20">

    @* ─── INSTRUCTIONS ──────────────────────────────────────── *@
    <div class="bg-blue-50 border-l-4 border-blue-500 p-4 mb-6">
        <h6 class="text-[10px] uppercase tracking-widest font-bold text-blue-700 mb-2">
            <i class="bi bi-info-circle me-1"></i>How to use the grid
        </h6>
        <div class="text-xs text-blue-800 space-y-1">
            <p class="mb-1"><strong>Empty cell (+ Add)</strong> — click anywhere on the cell to create a meal for that slot. A default title is applied automatically.</p>
            <p class="mb-0"><strong>Filled cell</strong> — click to open the editor panel below, where you can add components (dishes) and alternatives.</p>
        </div>
    </div>

    @* ─── VALIDATION BANNER ──────────────────────────────────── *@
    @if (validation != null && validation.CriticalCount > 0)
    {
        <div class="bg-red-50 border-l-4 border-red-500 p-4 mb-6">
            <h6 class="text-[10px] uppercase tracking-widest font-bold text-red-700 mb-1">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>
                @validation.CriticalCount critical issue(s) must be resolved before publishing
            </h6>
            <a href="@Url.Action("MenuIssues", "Cafeteria", new { id = Model.WeeklyMenuID })"
               class="text-xs text-red-800 underline">Review issues →</a>
        </div>
    }

    @* ─── THE GRID ───────────────────────────────────────────── *@
    <div class="bg-white border border-gray-100 shadow-sm overflow-hidden mb-8">
        <div class="overflow-x-auto">
            <table class="w-full" style="min-width: 1000px;">
                <thead class="bg-gray-50/50">
                    <tr>
                        <th class="text-left px-4 py-3 text-[9px] font-bold uppercase tracking-widest text-gray-400" style="width: 130px;">
                            Meal Slot
                        </th>
                        @for (int i = 0; i < 7; i++)
                        {
                            var dayDate = Model.StartDate.Date.AddDays(i);
                            <th class="text-center px-3 py-3 text-[9px] font-bold uppercase tracking-widest text-gray-400">
                                <div>@dayDate.ToString("ddd")</div>
                                <div class="text-[8px] font-normal normal-case text-gray-400">@dayDate.ToString("dd MMM")</div>
                            </th>
                        }
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    @foreach (var slot in gridSlots)
                    {
                        <tr>
                            <td class="px-4 py-3 text-xs font-bold text-gray-700 align-middle bg-gray-50/30">
                                @slot.Name
                            </td>
                            @for (int i = 0; i < 7; i++)
                            {
                                var dayDate = Model.StartDate.Date.AddDays(i);

                                Michaelhouse.Models.MenuDay day = null;
                                dayMap.TryGetValue(dayDate, out day);

                                Michaelhouse.Models.MenuMeal meal = null;
                                if (day != null)
                                {
                                    meal = day.Meals.FirstOrDefault(m => m.MealSlotId == slot.Id);
                                }

                                <td class="p-1 align-middle">
                                    @if (meal != null)
                                    {
                                        // FILLED CELL — click anywhere to open panel
                                        var compCount = meal.Components != null ? meal.Components.Count : 0;
                                        var altCount = meal.Alternatives != null ? meal.Alternatives.Count : 0;
                                        var isSelected = selectedMealId == meal.Id;

                                        <a href="@Url.Action("MenuEditor", "Cafeteria", new { id = Model.WeeklyMenuID, sel = meal.Id })"
                                           class="block h-full border @(isSelected ? "border-[#C21E2E] bg-red-50" : "border-gray-200 bg-white hover:border-[#C21E2E] hover:bg-gray-50") p-3 transition-all text-left">
                                            <p class="text-[11px] font-bold text-gray-900 mb-1 truncate">
                                                @(string.IsNullOrWhiteSpace(meal.Title) ? "Untitled meal" : meal.Title)
                                            </p>
                                            <p class="text-[9px] uppercase tracking-widest mb-0 @(compCount == 0 ? "text-red-500 font-bold" : "text-gray-400")">
                                                @if (compCount == 0)
                                                {
                                                    <i class="bi bi-exclamation-circle me-1"></i><text>Needs components</text>
                                                }
                                                else
                                                {
                                                    <text>@compCount item@(compCount == 1 ? "" : "s")</text>
                                                    if (altCount > 0)
                                                    { <text> &bull; @altCount alt</text>}
                                            }
                                            </p>
                                            @if (isSelected)
                                            {
                                                <p class="text-[8px] text-[#C21E2E] font-bold uppercase tracking-widest mt-1 mb-0">
                                                    <i class="bi bi-chevron-down"></i> Editor below
                                                </p>
                                            }
                                        </a>
                                    }
                                    else if (canEdit)
                                    {
                                        // EMPTY CELL — whole cell is the add button
                                        <form method="post" action="@Url.Action("AddMenuMeal", "Cafeteria")" class="block m-0 p-0">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="weeklyMenuId" value="@Model.WeeklyMenuID" />
                                            <input type="hidden" name="date" value="@dayDate.ToString("yyyy-MM-dd")" />
                                            <input type="hidden" name="mealSlotId" value="@slot.Id" />
                                            <input type="hidden" name="title" value="" />
                                            <input type="hidden" name="notes" value="" />
                                            <button type="submit"
                                                    class="w-full h-full py-4 border border-dashed border-gray-300 text-gray-400 text-[10px] font-bold uppercase tracking-widest hover:border-[#C21E2E] hover:text-[#C21E2E] hover:bg-red-50/30 transition-all">
                                                + Add @slot.Name
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-gray-300 text-[9px] block text-center py-3">—</span>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @* ─── SELECTED MEAL PANEL ─────────────────────────────────── *@
    @if (selectedMeal != null)
    {
        var sDay = days.FirstOrDefault(d => d.Id == selectedMeal.MenuDayId);
        var sSlot = gridSlots.FirstOrDefault(s => s.Id == selectedMeal.MealSlotId);

        <div id="editor-panel" class="bg-white border-2 border-[#C21E2E] shadow-lg overflow-hidden">
            <div class="p-4 border-b border-gray-100 bg-red-50 flex justify-between items-center">
                <div>
                    <h6 class="text-[10px] uppercase tracking-[3px] font-bold text-[#C21E2E] mb-0">
                        <i class="bi bi-pencil-square me-2"></i>Editing:
                        @(sDay != null ? sDay.Date.ToString("dddd, dd MMM") : "") &bull; @(sSlot != null ? sSlot.Name : "")
                    </h6>
                </div>
                <a href="@Url.Action("MenuEditor", "Cafeteria", new { id = Model.WeeklyMenuID })"
                   class="text-[10px] font-bold uppercase tracking-widest text-gray-400 hover:text-black">Close Panel</a>
            </div>

            @* Meal title *@
            <div class="p-6 border-b border-gray-100">
                <form method="post" action="@Url.Action("AddMenuMeal", "Cafeteria")">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="weeklyMenuId" value="@Model.WeeklyMenuID" />
                    <input type="hidden" name="date" value="@(sDay != null ? sDay.Date.ToString("yyyy-MM-dd") : DateTime.Now.ToString("yyyy-MM-dd"))" />
                    <input type="hidden" name="mealSlotId" value="@selectedMeal.MealSlotId" />
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                        <div class="md:col-span-2">
                            <label class="block text-[9px] uppercase tracking-widest font-bold text-gray-400 mb-2">Meal Title</label>
                            <input type="text" name="title" value="@selectedMeal.Title"
                                   class="w-full border border-gray-200 py-2 px-3 text-sm" placeholder="e.g. Sunday Breakfast" />
                        </div>
                        <div>
                            <label class="block text-[9px] uppercase tracking-widest font-bold text-gray-400 mb-2">Notes (optional)</label>
                            <input type="text" name="notes" value="@selectedMeal.Notes"
                                   class="w-full border border-gray-200 py-2 px-3 text-sm" />
                        </div>
                    </div>
                    @if (canEdit)
                    {
                        <div class="mt-3 flex justify-end">
                            <button type="submit" class="bg-gray-900 text-white px-5 py-2 text-[10px] font-bold uppercase tracking-widest hover:bg-black">
                                <i class="bi bi-save me-1"></i>Save Title
                            </button>
                        </div>
                    }
                </form>
            </div>

            @* Components + Alternatives side by side *@
            <div class="grid grid-cols-1 md:grid-cols-2" style="divide-y: 1px solid #f3f4f6;">
                <div class="p-6 md:border-r border-gray-100">
                    <div class="flex items-center justify-between mb-3">
                        <h6 class="text-[10px] uppercase tracking-widest font-bold text-gray-900 mb-0">Components (dishes served)</h6>
                        <span class="text-[9px] text-gray-400">@(selectedMeal.Components != null ? selectedMeal.Components.Count : 0)</span>
                    </div>

                    @if (selectedMeal.Components == null || !selectedMeal.Components.Any())
                    {
                        <div class="bg-amber-50 border-l-4 border-amber-500 p-3 mb-4">
                            <p class="text-xs text-amber-800 mb-0">Add at least one component so students know what's being served.</p>
                        </div>
                    }
                    else
                    {
                        <div class="space-y-2 mb-4">
                            @foreach (var c in selectedMeal.Components.OrderBy(x => x.DisplayOrder))
                            {
                                <div class="flex items-center justify-between bg-gray-50 px-3 py-2 border border-gray-100">
                                    <div>
                                        <p class="text-xs font-bold text-gray-900 mb-0">@(c.MenuItem != null ? c.MenuItem.Name : "—")</p>
                                        <p class="text-[9px] text-gray-400 uppercase tracking-widest mb-0">@c.ComponentType</p>
                                    </div>
                                    @if (canEdit)
                                    {
                                        <form method="post" action="@Url.Action("DeleteMenuComponent", "Cafeteria", new { id = c.Id })" class="inline m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="text-[10px] text-red-500 hover:text-red-800"
                                                    onclick="return confirm('Remove this component?');">
                                                ✕
                                            </button>
                                        </form>
                                    }
                                </div>
                            }
                        </div>
                    }

                    @if (canEdit)
                    {
                        <form method="post" action="@Url.Action("AddMenuComponent", "Cafeteria")" class="border-t border-gray-100 pt-4">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="menuMealId" value="@selectedMeal.Id" />
                            <div class="space-y-2">
                                <select name="menuItemId" required class="w-full border border-gray-200 py-2 px-3 text-sm">
                                    <option value="">— Select dish —</option>
                                    @foreach (var mi in menuItems)
                                    {
                                        <option value="@mi.Id">@mi.Name (@mi.Category)</option>
                                    }
                                </select>
                                <select name="componentType" class="w-full border border-gray-200 py-2 px-3 text-sm">
                                    <option value="0">Main</option>
                                    <option value="2">Protein</option>
                                    <option value="3">Side</option>
                                    <option value="4">Drink</option>
                                    <option value="5">Dessert</option>
                                    <option value="8">Fruit</option>
                                    <option value="9">Bread</option>
                                </select>
                                <button type="submit" class="w-full bg-[#C21E2E] text-white py-2 text-[10px] font-bold uppercase tracking-widest hover:bg-black">
                                    <i class="bi bi-plus-circle me-1"></i>Add Component
                                </button>
                            </div>
                        </form>
                    }
                </div>

                <div class="p-6">
                    <div class="flex items-center justify-between mb-3">
                        <h6 class="text-[10px] uppercase tracking-widest font-bold text-gray-900 mb-0">Alternatives</h6>
                        <span class="text-[9px] text-gray-400">@(selectedMeal.Alternatives != null ? selectedMeal.Alternatives.Count : 0)</span>
                    </div>

                    @if (selectedMeal.Alternatives == null || !selectedMeal.Alternatives.Any())
                    {
                        <p class="text-xs text-gray-400 mb-3">Optional. Add vegetarian, gluten-free, or allergy-friendly options.</p>
                    }
                    else
                    {
                        <div class="space-y-2 mb-4">
                            @foreach (var a in selectedMeal.Alternatives)
                            {
                                <div class="flex items-center justify-between bg-gray-50 px-3 py-2 border border-gray-100">
                                    <div>
                                        <p class="text-xs font-bold text-gray-900 mb-0">@(a.MenuItem != null ? a.MenuItem.Name : "—")</p>
                                        <p class="text-[9px] text-gray-400 mb-0">@a.Reason</p>
                                    </div>
                                    @if (canEdit)
                                    {
                                        <form method="post" action="@Url.Action("DeleteMenuAlternative", "Cafeteria", new { id = a.Id })" class="inline m-0">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="text-[10px] text-red-500 hover:text-red-800"
                                                    onclick="return confirm('Remove this alternative?');">
                                                ✕
                                            </button>
                                        </form>
                                    }
                                </div>
                            }
                        </div>
                    }

                    @if (canEdit)
                    {
                        <form method="post" action="@Url.Action("AddMenuAlternative", "Cafeteria")" class="border-t border-gray-100 pt-4">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="menuMealId" value="@selectedMeal.Id" />
                            <div class="space-y-2">
                                <select name="menuItemId" required class="w-full border border-gray-200 py-2 px-3 text-sm">
                                    <option value="">— Select dish —</option>
                                    @foreach (var mi in menuItems)
                                    {
                                        <option value="@mi.Id">@mi.Name (@mi.Category)</option>
                                    }
                                </select>
                                <input type="text" name="reason" class="w-full border border-gray-200 py-2 px-3 text-sm"
                                       placeholder="Reason (e.g. Vegetarian, Gluten-free)" />
                                <button type="submit" class="w-full bg-[#C21E2E] text-white py-2 text-[10px] font-bold uppercase tracking-widest hover:bg-black">
                                    <i class="bi bi-plus-circle me-1"></i>Add Alternative
                                </button>
                            </div>
                        </form>
                    }
                </div>
            </div>

            @if (canEdit)
            {
                <div class="p-4 bg-gray-50 border-t border-gray-100 flex justify-end">
                    <form method="post" action="@Url.Action("DeleteMenuMeal", "Cafeteria", new { id = selectedMeal.Id })" class="inline m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="text-[10px] font-bold uppercase tracking-widest text-red-600 hover:text-red-800"
                                onclick="return confirm('Delete this entire meal (all components and alternatives)?');">
                            <i class="bi bi-trash me-1"></i>Delete Whole Meal
                        </button>
                    </form>
                </div>
            }
        </div>

        @* Auto-scroll to the editor panel after click *@
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                var p = document.getElementById('editor-panel');
                if (p) { p.scrollIntoView({ behavior: 'smooth', block: 'start' }); }
            });
        </script>
    }
    else
    {
        <div class="bg-gray-50 border border-dashed border-gray-200 p-8 text-center">
            <i class="bi bi-hand-index-thumb text-4xl block mb-2 text-gray-300"></i>
            <p class="text-gray-500 text-sm mb-0">Click any cell in the grid above to start editing.</p>
            <p class="text-gray-400 text-xs mt-1 mb-0">Empty cells add a new meal. Filled cells open the editor below.</p>
        </div>
    }
</div>

<style>
    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }

    .divide-y > div + div {
        border-top: 1px solid #f3f4f6;
    }
</style>
@model Michaelhouse.Models.ViewModels.ScheduleMenuInputViewModel

@{
Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Schedule Menus";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet" />

<div class="container-fluid py-4">

    <div class="row mb-4">
        <div class="col">
            <h1 class="h3">Schedule Menus</h1>
            <p class="text-muted">
                Generate a proposed cafeteria menu for the selected period.
            </p>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @Html.ValidationSummary(
        true,
        "",
        new { @class = "alert alert-danger" })

    @using (Html.BeginForm(
        "Generate",
        "Cafeteria",
        FormMethod.Post,
        new { @class = "needs-validation" }))
    {
        @Html.AntiForgeryToken()

        <div class="card shadow-sm mb-4">

            <div class="card-header">
                <strong>Menu Period</strong>
            </div>

            <div class="card-body">

                <div class="row g-3">

                    <div class="col-md-4">
                        @Html.LabelFor(
                            x => x.StartDate,
                            new { @class = "form-label" })

                        @Html.TextBoxFor(
                            x => x.StartDate,
                            "{0:yyyy-MM-dd}",
                            new
                            {
                                @class = "form-control",
                                type = "date",
                                required = "required"
                            })

                        @Html.ValidationMessageFor(
                            x => x.StartDate,
                            "",
                            new { @class = "text-danger" })
                    </div>

                    <div class="col-md-4">
                        @Html.LabelFor(
                            x => x.EndDate,
                            new { @class = "form-label" })

                        @Html.TextBoxFor(
                            x => x.EndDate,
                            "{0:yyyy-MM-dd}",
                            new
                            {
                                @class = "form-control",
                                type = "date",
                                required = "required"
                            })

                        @Html.ValidationMessageFor(
                            x => x.EndDate,
                            "",
                            new { @class = "text-danger" })
                    </div>

                    <div class="col-md-4">
                        @Html.LabelFor(
                            x => x.StaffMeals,
                            new { @class = "form-label" })

                        @Html.TextBoxFor(
                            x => x.StaffMeals,
                            new
                            {
                                @class = "form-control",
                                type = "number",
                                min = "0",
                                required = "required"
                            })

                        @Html.ValidationMessageFor(
                            x => x.StaffMeals,
                            "",
                            new { @class = "text-danger" })
                    </div>

                    <div class="col-12">
                        @Html.LabelFor(
                            x => x.SpecialEventNotes,
                            new { @class = "form-label" })

                        @Html.TextAreaFor(
                            x => x.SpecialEventNotes,
                            4,
                            100,
                            new
                            {
                                @class = "form-control",
                                placeholder =
                                    "Enter special event, dietary, sporting " +
                                    "or menu requirements..."
                            })

                        @Html.ValidationMessageFor(
                            x => x.SpecialEventNotes,
                            "",
                            new { @class = "text-danger" })
                    </div>

                </div>

            </div>
        </div>

        <div class="card shadow-sm mb-4">

            <div class="card-header">
                <strong>Boarding Houses &amp; Sports</strong>
            </div>

            <div class="card-body">

                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>
                                <th>Boarding House</th>
                                <th>Students</th>
                                <th>In Season</th>
                                <th>Active Sport</th>
                                <th>Match Date</th>
                            </tr>
                        </thead>

                        <tbody>

                            @if (Model.BoardingHouses != null &&
                                 Model.BoardingHouses.Any())
                            {
                                for (int i = 0;
                                     i < Model.BoardingHouses.Count;
                                     i++)
                                {
                                    <tr>

                                        <td>
                                            @Html.HiddenFor(
                                                x => x.BoardingHouses[i].Id)

                                            @Html.HiddenFor(
                                                x => x.BoardingHouses[i].Name)

                                            @Model.BoardingHouses[i].Name
                                        </td>

                                        <td>
                                            <span class="student-count"
                                                  data-student-count="@Model.BoardingHouses[i].StudentCount">
                                                @Model.BoardingHouses[i].StudentCount
                                            </span>

                                            @Html.HiddenFor(
                                                x => x.BoardingHouses[i].StudentCount)
                                        </td>

                                        <td>
                                            <div class="form-check form-switch">

                                                @Html.CheckBoxFor(
                                                    x => x.BoardingHouses[i].IsInSeason,
                                                    new
                                                    {
                                                        @class =
                                                            "form-check-input sports-toggle",
                                                        data_house =
                                                            Model.BoardingHouses[i].Id
                                                    })

                                            </div>
                                        </td>

                                        <td>
                                            @Html.TextBoxFor(
                                                x => x.BoardingHouses[i].ActiveSport,
                                                new
                                                {
                                                    @class =
                                                        "form-control sport-name",
                                                    placeholder =
                                                        "e.g. Rugby, Cricket, Water Polo",
                                                    disabled =
                                                        !Model.BoardingHouses[i].IsInSeason
                                                        ? "disabled"
                                                        : null
                                                })
                                        </td>

                                        <td>
                                            @Html.TextBoxFor(
                                                x => x.BoardingHouses[i].MatchDate,
                                                "{0:yyyy-MM-dd}",
                                                new
                                                {
                                                    @class =
                                                        "form-control match-date",
                                                    type = "date",
                                                    disabled =
                                                        !Model.BoardingHouses[i].IsInSeason
                                                        ? "disabled"
                                                        : null
                                                })
                                        </td>

                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5"
                                        class="text-center text-muted">
                                        No boarding houses are available.
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

            </div>
        </div>

        <div class="card shadow-sm mb-4">

            <div class="card-body">

                <div class="row">

                    <div class="col-md-4">
                        <div class="border rounded p-3">

                            <div class="small text-muted">
                                Estimated base portions
                            </div>

                            <div id="basePortions"
                                 class="display-6">
                                0
                            </div>

                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="border rounded p-3">

                            <div class="small text-muted">
                                Sports uplift
                            </div>

                            <div id="sportsUplift"
                                 class="display-6">
                                0
                            </div>

                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="border rounded p-3">

                            <div class="small text-muted">
                                Estimated total portions
                            </div>

                            <div id="totalPortions"
                                 class="display-6">
                                0
                            </div>

                        </div>
                    </div>

                </div>

            </div>
        </div>

        <div class="d-flex justify-content-end">

            <button type="submit"
                    class="btn btn-primary btn-lg">

                Generate Proposed Menu

            </button>

        </div>
    }

</div>

<script>
    (function () {

        function calculatePortions() {

            var staffInput =
                document.getElementById("StaffMeals");

            var staffMeals =
                parseInt(staffInput ? staffInput.value : "0", 10) || 0;

            var normalStudents = 0;
            var sportsStudents = 0;

            document
                .querySelectorAll(".sports-toggle")
                .forEach(function (checkbox) {

                    var row = checkbox.closest("tr");

                    if (!row) {
                        return;
                    }

                    var studentElement =
                        row.querySelector(".student-count");

                    var students =
                        parseInt(
                            studentElement
                                ? studentElement.getAttribute(
                                    "data-student-count")
                                : "0",
                            10) || 0;

                    if (checkbox.checked) {
                        sportsStudents += students;
                    }
                    else {
                        normalStudents += students;
                    }

                });

            /*
             * 1.3x means the squad requires an additional 30%.
             *
             * Base:
             * staff + normal students + sports students
             *
             * Uplift:
             * sports students * 0.30
             */
            var base =
                staffMeals +
                normalStudents +
                sportsStudents;

            var uplift =
                Math.ceil(sportsStudents * 0.30);

            var total =
                base + uplift;

            document.getElementById("basePortions")
                .textContent = base;

            document.getElementById("sportsUplift")
                .textContent = uplift;

            document.getElementById("totalPortions")
                .textContent = total;
        }

        document
            .querySelectorAll(".sports-toggle")
            .forEach(function (checkbox) {

                checkbox.addEventListener(
                    "change",
                    function () {

                        var row =
                            checkbox.closest("tr");

                        var sportInput =
                            row.querySelector(".sport-name");

                        var dateInput =
                            row.querySelector(".match-date");

                        if (checkbox.checked) {

                            sportInput.disabled = false;
                            sportInput.focus();

                            if (dateInput) {
                                dateInput.disabled = false;
                            }

                        }
                        else {

                            sportInput.disabled = true;
                            sportInput.value = "";

                            if (dateInput) {
                                dateInput.disabled = true;
                                dateInput.value = "";
                            }

                        }

                        calculatePortions();
                    });
            });

        var staffInput =
            document.getElementById("StaffMeals");

        if (staffInput) {
            staffInput.addEventListener(
                "input",
                calculatePortions);
        }

        calculatePortions();

    })();
</script>
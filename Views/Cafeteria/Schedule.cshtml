@model Michaelhouse.Models.ViewModels.ScheduleMenuInputViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Schedule Menus";
}

@* --- FULL SCREEN VIEWPORT CONTAINER --- *@
<div class="flex flex-col h-full w-full overflow-hidden bg-gray-50/30">

    @* --- INSTITUTIONAL HEADER --- *@
    <div class="mb-6 d-flex justify-content-between align-items-end border-b border-gray-200 pb-6 flex-shrink-0 px-8 pt-8 bg-white shadow-sm relative z-10">
        <div>
            <h2 class="text-5xl font-serif font-bold text-gray-900 tracking-tight mb-0">Schedule Menus</h2>
            <p class="text-[11px] font-mono text-gray-400 uppercase tracking-widest mt-2 mb-0">Generate a proposed cafeteria menu for the selected period.</p>
        </div>
        <div class="flex gap-3">
            <a href="@Url.Action("Dashboard", "Cafeteria")" class="inline-flex items-center justify-center bg-white border border-gray-300 text-gray-700 px-6 py-3 text-[10px] font-bold uppercase tracking-[2px] hover:bg-gray-50 hover:border-gray-400 transition-all duration-300 shadow-sm">
                <i class="bi bi-arrow-left me-2 text-sm"></i> Back
            </a>
        </div>
    </div>

    @* --- SCROLLABLE DATA SECTION --- *@
    <div class="flex-grow min-h-0 overflow-y-auto custom-scrollbar px-8 pb-10 pt-4 flex flex-col">

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="bg-green-50 border-l-4 border-green-500 p-4 text-green-700 shadow-sm flex items-center mb-6">
                <span class="text-xs font-bold uppercase tracking-widest">@TempData["SuccessMessage"]</span>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="bg-red-50 border-l-4 border-[#C21E2E] p-4 text-[#C21E2E] shadow-sm flex items-center mb-6">
                <span class="text-xs font-bold uppercase tracking-widest">@TempData["ErrorMessage"]</span>
            </div>
        }

        @Html.ValidationSummary(true, "", new { @class = "bg-red-50 border-l-4 border-[#C21E2E] p-4 text-[#C21E2E] shadow-sm mb-6 text-sm font-serif" })

        @using (Html.BeginForm("Generate", "Cafeteria", FormMethod.Post, new { @class = "flex flex-col gap-8 flex-grow" }))
        {
            @Html.AntiForgeryToken()

            <div class="grid grid-cols-1 xl:grid-cols-12 gap-8">

                @* --- LEFT: MENU PERIOD --- *@
                <div class="xl:col-span-8 flex flex-col gap-6">
                    <div class="bg-white shadow-sm border border-gray-100 flex flex-col relative overflow-hidden group">

                        <div class="p-5 border-b border-gray-100 bg-[#1a1a1a] relative z-10">
                            <strong class="text-[10px] uppercase tracking-[4px] font-bold text-white mb-0">Menu Period</strong>
                        </div>

                        <div class="p-8 relative z-10 grid grid-cols-1 md:grid-cols-2 gap-8">

                            @* Dates *@
                            <div>
                                @Html.LabelFor(x => x.StartDate, new { @class = "block text-[9px] uppercase tracking-[2px] font-bold text-gray-500 mb-2" })
                                @Html.TextBoxFor(x => x.StartDate, "{0:yyyy-MM-dd}", new { @class = "w-full border-b-2 border-gray-200 py-3 outline-none focus:border-[#C21E2E] font-mono text-sm text-gray-900 transition-colors bg-transparent", type = "date", required = "required" })
                                @Html.ValidationMessageFor(x => x.StartDate, "", new { @class = "text-[#C21E2E] text-[9px] font-bold uppercase mt-2 block tracking-widest" })
                            </div>

                            <div>
                                @Html.LabelFor(x => x.EndDate, new { @class = "block text-[9px] uppercase tracking-[2px] font-bold text-gray-500 mb-2" })
                                @Html.TextBoxFor(x => x.EndDate, "{0:yyyy-MM-dd}", new { @class = "w-full border-b-2 border-gray-200 py-3 outline-none focus:border-[#C21E2E] font-mono text-sm text-gray-900 transition-colors bg-transparent", type = "date", required = "required" })
                                @Html.ValidationMessageFor(x => x.EndDate, "", new { @class = "text-[#C21E2E] text-[9px] font-bold uppercase mt-2 block tracking-widest" })
                            </div>

                            @* Numbers *@
                            <div>
                                @Html.LabelFor(x => x.StaffMeals, new { @class = "block text-[9px] uppercase tracking-[2px] font-bold text-gray-500 mb-2" })
                                @Html.TextBoxFor(x => x.StaffMeals, new { @class = "w-full border-b-2 border-gray-200 py-3 outline-none focus:border-[#C21E2E] font-mono text-xl font-bold text-gray-900 transition-colors bg-transparent", type = "number", min = "0", required = "required", id = "StaffMeals" })
                                @Html.ValidationMessageFor(x => x.StaffMeals, "", new { @class = "text-[#C21E2E] text-[9px] font-bold uppercase mt-2 block tracking-widest" })
                            </div>

                            <div>
                                @Html.LabelFor(x => x.OptionsPerSlot, new { @class = "block text-[9px] uppercase tracking-[2px] font-bold text-gray-500 mb-2" })
                                @Html.TextBoxFor(x => x.OptionsPerSlot, new { @class = "w-full border-b-2 border-gray-200 py-3 outline-none focus:border-[#C21E2E] font-mono text-xl font-bold text-gray-900 transition-colors bg-transparent", type = "number", min = "1", max = "6", required = "required" })
                                <div class="text-[9px] font-mono text-gray-400 mt-2 uppercase tracking-widest leading-relaxed">
                                    Choices per breakfast, lunch and dinner. Students pick one in their meal plan.
                                </div>
                                @Html.ValidationMessageFor(x => x.OptionsPerSlot, "", new { @class = "text-[#C21E2E] text-[9px] font-bold uppercase mt-2 block tracking-widest" })
                            </div>

                            @* Notes *@
                            <div class="md:col-span-2 border-t border-gray-100 pt-6">
                                @Html.LabelFor(x => x.SpecialEventNotes, new { @class = "block text-[9px] uppercase tracking-[2px] font-bold text-gray-500 mb-2" })
                                @Html.TextAreaFor(x => x.SpecialEventNotes, 4, 100, new { @class = "w-full border border-gray-200 p-4 outline-none focus:border-[#C21E2E] font-serif text-sm text-gray-900 transition-colors bg-gray-50/50 resize-y", placeholder = "Enter special event, dietary, sporting or menu requirements..." })
                                @Html.ValidationMessageFor(x => x.SpecialEventNotes, "", new { @class = "text-[#C21E2E] text-[9px] font-bold uppercase mt-2 block tracking-widest" })
                            </div>
                        </div>
                    </div>
                </div>

                @* --- RIGHT: PORTION TELEMETRY --- *@
                <div class="xl:col-span-4 flex flex-col gap-6">
                    <div class="bg-white shadow-sm border border-gray-100 flex flex-col">

                        <div class="p-6 flex flex-col gap-4">
                            @* Base Portions *@
                            <div class="bg-gray-50 border border-gray-200 p-4 text-center">
                                <div class="text-[9px] uppercase tracking-[2px] font-bold text-gray-500 block mb-1">Estimated base portions</div>
                                <div id="basePortions" class="font-mono text-3xl font-bold text-gray-900">0</div>
                            </div>

                            @* Sports Uplift *@
                            <div class="bg-gray-50 border border-gray-200 p-4 text-center">
                                <div class="text-[9px] uppercase tracking-[2px] font-bold text-gray-500 block mb-1">Sports uplift</div>
                                <div id="sportsUplift" class="font-mono text-3xl font-bold text-gray-900">0</div>
                            </div>

                            @* Total Portions *@
                            <div class="bg-gray-50 border border-gray-200 p-4 text-center">
                                <div class="text-[9px] uppercase tracking-[2px] font-bold text-gray-500 block mb-1">Estimated total portions</div>
                                <div id="totalPortions" class="font-mono text-4xl font-bold text-gray-900">0</div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            @* --- BOTTOM: BOARDING HOUSES & SPORTS --- *@
            <div class="bg-white shadow-sm border border-gray-100 flex flex-col relative overflow-hidden group mt-4">
                <div class="p-5 border-b border-gray-100 bg-[#1a1a1a] relative z-10 flex justify-between items-center">
                    <strong class="text-[10px] uppercase tracking-[4px] font-bold text-white mb-0">Boarding Houses & Sports</strong>
                </div>

                <div class="table-responsive relative z-10">
                    <table class="table table-hover mb-0 align-middle w-full">
                        <thead class="bg-gray-50/80 border-b border-gray-200">
                            <tr class="text-[9px] uppercase tracking-[4px] font-bold text-gray-400">
                                <th class="ps-8 py-4">Boarding House</th>
                                <th class="border-l border-gray-100 ps-4 text-center">Students</th>
                                <th class="border-l border-gray-100 ps-4 text-center">In Season</th>
                                <th class="border-l border-gray-100 ps-4">Active Sport</th>
                                <th class="border-l border-gray-100 pe-8 ps-4">Match Date</th>
                            </tr>
                        </thead>
                        <tbody class="text-gray-700">
                            @if (Model.BoardingHouses != null && Model.BoardingHouses.Any())
                            {
                                for (int i = 0; i < Model.BoardingHouses.Count; i++)
                                {
                                    <tr class="hover:bg-gray-50/80 transition-all duration-300 border-b border-gray-50 last:border-0 group/row">
                                        <td class="ps-8 py-4">
                                            @Html.HiddenFor(x => x.BoardingHouses[i].Id)
                                            @Html.HiddenFor(x => x.BoardingHouses[i].Name)
                                            <strong class="font-serif text-sm text-gray-900">@Model.BoardingHouses[i].Name</strong>
                                        </td>

                                        <td class="border-l border-gray-50 ps-4 text-center">
                                            <span class="student-count inline-flex items-center text-[10px] font-mono font-bold bg-gray-100 text-gray-700 px-3 py-1 shadow-sm" data-student-count="@Model.BoardingHouses[i].StudentCount">
                                                @Model.BoardingHouses[i].StudentCount
                                            </span>
                                            @Html.HiddenFor(x => x.BoardingHouses[i].StudentCount)
                                        </td>

                                        <td class="border-l border-gray-50 ps-4 text-center">
                                            <div class="flex justify-center items-center h-full">
                                                @Html.CheckBoxFor(x => x.BoardingHouses[i].IsInSeason, new { @class = "w-5 h-5 text-[#C21E2E] focus:ring-[#C21E2E] border-gray-300 rounded cursor-pointer sports-toggle", data_house = Model.BoardingHouses[i].Id })
                                            </div>
                                        </td>

                                        <td class="border-l border-gray-50 ps-4">
                                            @Html.TextBoxFor(x => x.BoardingHouses[i].ActiveSport, new { @class = "w-full border-b-2 border-gray-200 py-2 outline-none focus:border-[#C21E2E] font-serif text-sm text-gray-900 transition-colors bg-transparent disabled:opacity-30 sport-name", placeholder = "e.g. Rugby, Cricket, Water Polo", disabled = !Model.BoardingHouses[i].IsInSeason ? "disabled" : null })
                                        </td>

                                        <td class="border-l border-gray-50 pe-8 ps-4">
                                            @Html.TextBoxFor(x => x.BoardingHouses[i].MatchDate, "{0:yyyy-MM-dd}", new { @class = "w-full border-b-2 border-gray-200 py-2 outline-none focus:border-[#C21E2E] font-mono text-sm text-gray-900 transition-colors bg-transparent disabled:opacity-30 match-date", type = "date", disabled = !Model.BoardingHouses[i].IsInSeason ? "disabled" : null })
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="5" class="text-center py-10 text-muted">
                                        <span class="text-[10px] font-mono text-gray-400 uppercase tracking-widest">No boarding houses are available.</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <div class="flex justify-end mt-4">
                <button type="submit" class="bg-[#10b981] text-white px-8 py-4 text-[12px] font-bold uppercase tracking-[3px] hover:bg-green-600 hover:shadow-[0_0_20px_rgba(16,185,129,0.4)] transition-all duration-300">
                    Generate Proposed Menu
                </button>
            </div>
        }
    </div>
</div>

<style>
    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }

    .font-mono {
        font-family: 'Source Code Pro', monospace !important;
    }

    .table thead th {
        border-bottom: 2px solid #f8f9fa !important;
    }

    .table tbody tr {
        transition: all 0.3s cubic-bezier(0.165, 0.84, 0.44, 1);
    }

    .custom-scrollbar::-webkit-scrollbar {
        width: 5px;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #eee;
        border-radius: 10px;
    }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #C21E2E;
        }
</style>

@section Scripts {
    <script>
        (function () {
            function calculatePortions() {
                var staffInput = document.getElementById("StaffMeals");
                var staffMeals = parseInt(staffInput ? staffInput.value : "0", 10) || 0;

                var normalStudents = 0;
                var sportsStudents = 0;

                document.querySelectorAll(".sports-toggle").forEach(function (checkbox) {
                    var row = checkbox.closest("tr");
                    if (!row) return;

                    var studentElement = row.querySelector(".student-count");
                    var students = parseInt(studentElement ? studentElement.getAttribute("data-student-count") : "0", 10) || 0;

                    if (checkbox.checked) {
                        sportsStudents += students;
                    } else {
                        normalStudents += students;
                    }
                });

                /*
                 * 1.3x means the squad requires an additional 30%.
                 * Base: staff + normal students + sports students
                 * Uplift: sports students * 0.30
                 */
                var base = staffMeals + normalStudents + sportsStudents;
                var uplift = Math.ceil(sportsStudents * 0.30);
                var total = base + uplift;

                document.getElementById("basePortions").textContent = base;
                document.getElementById("sportsUplift").textContent = uplift;
                document.getElementById("totalPortions").textContent = total;
            }

            document.querySelectorAll(".sports-toggle").forEach(function (checkbox) {
                checkbox.addEventListener("change", function () {
                    var row = checkbox.closest("tr");
                    var sportInput = row.querySelector(".sport-name");
                    var dateInput = row.querySelector(".match-date");

                    if (checkbox.checked) {
                        sportInput.disabled = false;
                        sportInput.focus();
                        if (dateInput) {
                            dateInput.disabled = false;
                        }
                    } else {
                        sportInput.disabled = true;
                        sportInput.value = "";
                        if (dateInput) {
                            dateInput.disabled = true;
                            dateInput.value = "";
                        }
                    }
                    calculatePortions();
                });
            });

            var staffInput = document.getElementById("StaffMeals");
            if (staffInput) {
                staffInput.addEventListener("input", calculatePortions);
            }

            calculatePortions();
        })();
    </script>
}
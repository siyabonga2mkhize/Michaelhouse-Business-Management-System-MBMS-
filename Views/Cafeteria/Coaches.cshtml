@model IEnumerable<Michaelhouse.Models.Coach>

@{
    ViewBag.Title = "Coaches";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var coaches = Model as List<Michaelhouse.Models.Coach> ?? new List<Michaelhouse.Models.Coach>();
}

<div class="relative mb-8 border-b border-gray-100 bg-gray-50/30 py-8 px-4 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none"
         style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 24px 24px;"></div>
    <i class="bi bi-people absolute -right-8 -bottom-10 text-black/5 text-[12rem] rotate-12"></i>

    <div class="max-w-6xl mx-auto relative z-10">
        <div class="flex items-center gap-2 mb-3">
            <div class="h-1 w-8 bg-[#C21E2E]"></div>
            <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Sports Director</h5>
        </div>
        <h2 class="text-3xl font-serif font-bold text-gray-900 tracking-tight">Coaches</h2>
        <p class="text-gray-400 text-[10px] uppercase tracking-widest font-bold mt-2">
            @coaches.Count coaches registered
        </p>
    </div>
</div>

<div class="max-w-6xl mx-auto px-4 pb-20">

    @* ─── ACTION BUTTONS ──────────────────────────────────────── *@
    <div class="flex justify-end mb-6">
        <a href="@Url.Action("AddCoach")" class="bg-[#C21E2E] text-white px-6 py-3 text-[10px] font-bold uppercase tracking-widest hover:bg-black transition-all">
            <i class="bi bi-person-plus me-2"></i>Add New Coach
        </a>
    </div>

    @* ─── COACHES GRID ────────────────────────────────────────── *@
    @if (!coaches.Any())
    {
        <div class="bg-white border border-gray-100 p-12 text-center">
            <i class="bi bi-people text-6xl block mb-4 text-gray-300"></i>
            <p class="text-gray-500 text-lg font-bold mb-2">No coaches registered yet.</p>
            <p class="text-gray-400 text-sm mb-6">Add coaches to link them with their teams.</p>
            <a href="@Url.Action("AddCoach")" class="inline-block bg-[#C21E2E] text-white px-6 py-3 text-[10px] font-bold uppercase tracking-widest hover:bg-black transition-all">
                Add First Coach
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var coach in coaches.OrderBy(c => c.Sport).ThenBy(c => c.Surname))
            {
                <div class="col-lg-4 col-md-6">
                    <div class="bg-white border border-gray-100 shadow-sm overflow-hidden h-full">
                        @* ─── COACH HEADER ─────────────────────────── *@
                        <div class="bg-gray-900 p-5 relative overflow-hidden">
                            <i class="bi bi-person-circle absolute -right-4 -bottom-6 text-white/5 text-8xl"></i>
                            <div class="relative z-10">
                                <div class="text-[9px] uppercase tracking-widest font-bold text-gray-400 mb-1">@coach.Sport</div>
                                <h5 class="text-lg font-serif font-bold text-white mb-0">@coach.Name @coach.Surname</h5>
                            </div>
                        </div>

                        @* ─── COACH INFO ──────────────────────────── *@
                        <div class="p-5">
                            <div class="space-y-3 mb-4">
                                <div>
                                    <div class="text-[9px] uppercase tracking-widest font-bold text-gray-400 mb-1">Team</div>
                                    <div class="text-sm font-bold text-[#C21E2E]">@(string.IsNullOrEmpty(coach.Team) ? "Not assigned" : coach.Team)</div>
                                </div>
                                <div>
                                    <div class="text-[9px] uppercase tracking-widest font-bold text-gray-400 mb-1">Email</div>
                                    <div class="text-xs text-gray-600 break-all">@coach.Email</div>
                                </div>
                                <div>
                                    <div class="text-[9px] uppercase tracking-widest font-bold text-gray-400 mb-1">Phone</div>
                                    <div class="text-xs text-gray-600">@coach.Phone</div>
                                </div>
                            </div>

                            <div class="flex justify-between items-center pt-3 border-t border-gray-50">
                                <div class="text-[9px] uppercase tracking-widest font-bold text-gray-400">
                                    Added: @coach.CreatedDate.ToString("dd MMM yyyy")
                                </div>
                                @if (coach.IsActive)
                                {
                                    <span class="text-[9px] font-bold uppercase tracking-widest text-green-600">✓ Active</span>
                                }
                                else
                                {
                                    <span class="text-[9px] font-bold uppercase tracking-widest text-red-600">✗ Inactive</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }
</style>
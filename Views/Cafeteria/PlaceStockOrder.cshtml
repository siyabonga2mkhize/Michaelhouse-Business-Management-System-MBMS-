@{
    ViewBag.Title = "Place Stock Order";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var suppliers = ViewBag.Suppliers as List<Michaelhouse.Models.Supplier> ?? new List<Michaelhouse.Models.Supplier>();
    var lowStockItems = ViewBag.LowStockItems as List<Michaelhouse.Models.InventoryItem> ?? new List<Michaelhouse.Models.InventoryItem>();
}

<div class="relative mb-8 border-b border-gray-100 bg-gray-50/30 py-8 px-4 overflow-hidden">
    <div class="max-w-4xl mx-auto relative z-10">
        <div class="flex items-center gap-2 mb-3">
            <div class="h-1 w-8 bg-[#C21E2E]"></div>
            <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Cafeteria Manager</h5>
        </div>
        <h2 class="text-3xl font-serif font-bold text-gray-900 tracking-tight">Place Stock Order</h2>
        <p class="text-gray-400 text-[10px] uppercase tracking-widest font-bold mt-2">
            Order food items from approved suppliers
        </p>
    </div>
</div>

<div class="max-w-4xl mx-auto px-4 pb-20">

    @* ─── LOW STOCK ALERTS ────────────────────────────────────── *@
    @if (lowStockItems.Any())
    {
        <div class="bg-amber-50 border-l-4 border-amber-500 p-4 mb-6">
            <h6 class="text-[9px] uppercase tracking-widest font-bold text-amber-600 mb-2">⚠️ Items Below Reorder Level</h6>
            <div class="flex flex-wrap gap-2">
                @foreach (var item in lowStockItems)
                {
                    <span class="text-[10px] font-bold px-3 py-1 bg-white text-amber-700 border border-amber-300">
                        @item.ItemName: <strong>@item.QuantityInStock @item.Unit</strong> (min @item.ReorderLevel)
                    </span>
                }
            </div>
        </div>
    }

    @* ─── ORDER FORM ──────────────────────────────────────────── *@
    @using (Html.BeginForm("PlaceStockOrder", "Cafeteria", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="bg-white border border-gray-100 shadow-sm overflow-hidden mb-6">
            <div class="p-4 border-b border-gray-100 bg-gray-50/50">
                <h6 class="text-[10px] uppercase tracking-[3px] font-bold text-gray-900 mb-0">
                    <i class="bi bi-cart me-2 text-[#C21E2E]"></i>Order Details
                </h6>
            </div>

            <div class="p-6 space-y-4">

                <div>
                    <label class="text-[9px] uppercase tracking-widest font-bold text-gray-400 block mb-2">Supplier *</label>
                    <select name="SupplierId" required class="w-full border border-gray-200 py-3 px-4 text-sm">
                        <option value="">-- Select supplier --</option>
                        @foreach (var s in suppliers)
                        {
                            <option value="@s.SupplierId">@s.Name — @s.Products</option>
                        }
                    </select>
                </div>

                <div>
                    <label class="text-[9px] uppercase tracking-widest font-bold text-gray-400 block mb-2">Items to Order *</label>
                    <textarea name="Items" required rows="3" class="w-full border border-gray-200 py-3 px-4 text-sm" placeholder="e.g., Chicken Breast 100kg, Rice 50kg, Vegetables 40kg"></textarea>
                    <p class="text-[9px] text-gray-400 mt-1">List the items and quantities you need</p>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="text-[9px] uppercase tracking-widest font-bold text-gray-400 block mb-2">Total Quantity *</label>
                        <input type="number" name="Quantity" required value="1" class="w-full border border-gray-200 py-3 px-4 text-sm" />
                    </div>
                    <div class="col-md-6">
                        <label class="text-[9px] uppercase tracking-widest font-bold text-gray-400 block mb-2">Estimated Total Cost (R) *</label>
                        <input type="number" step="0.01" name="TotalCost" required value="0.00" class="w-full border border-gray-200 py-3 px-4 text-sm" />
                    </div>
                </div>

                <div>
                    <label class="text-[9px] uppercase tracking-widest font-bold text-gray-400 block mb-2">Expected Delivery Date</label>
                    <input type="date" name="ExpectedDelivery" class="w-full border border-gray-200 py-3 px-4 text-sm" />
                </div>

                <div>
                    <label class="text-[9px] uppercase tracking-widest font-bold text-gray-400 block mb-2">Notes (optional)</label>
                    <textarea name="Notes" rows="2" class="w-full border border-gray-200 py-3 px-4 text-sm" placeholder="Any special instructions for the supplier"></textarea>
                </div>
            </div>
        </div>

        <div class="bg-white border border-gray-100 p-4 flex justify-between items-center">
            <a href="@Url.Action("StockOrders")" class="text-[10px] font-bold uppercase tracking-widest text-gray-500 hover:text-[#C21E2E] transition-colors">
                <i class="bi bi-arrow-left me-2"></i>Cancel
            </a>
            <button type="submit" class="bg-[#C21E2E] text-white px-8 py-3 text-[10px] font-bold uppercase tracking-widest hover:bg-black transition-all">
                <i class="bi bi-send me-2"></i>Place Order
            </button>
        </div>
    }
</div>

<style>
    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }
</style>
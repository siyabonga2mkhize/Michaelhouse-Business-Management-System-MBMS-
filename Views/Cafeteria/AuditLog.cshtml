@model IEnumerable<Michaelhouse.Models.CafeteriaAuditLog>
@{
    ViewBag.Title = "Audit Log";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var list = Model.ToList();
}

<div class="relative mb-8 border-b border-gray-100 bg-gray-50/30 py-8 px-4 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none"
         style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 24px 24px;"></div>
    <i class="bi bi-shield-check absolute -right-8 -bottom-10 text-black/5 text-[12rem] rotate-12"></i>

    <div class="max-w-6xl mx-auto relative z-10">
        <div class="flex items-center gap-2 mb-3">
            <div class="h-1 w-8 bg-[#C21E2E]"></div>
            <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Cafeteria</h5>
        </div>
        <h2 class="text-3xl font-serif font-bold text-gray-900 tracking-tight">Audit Log</h2>
        <p class="text-gray-400 text-[10px] uppercase tracking-widest font-bold mt-2">
            Last 200 actions
        </p>
    </div>
</div>

<div class="max-w-6xl mx-auto px-4 pb-20">
    @if (!list.Any())
    {
        <div class="bg-white border border-gray-100 p-12 text-center">
            <i class="bi bi-clock-history text-5xl block mb-3 text-gray-300"></i>
            <p class="text-gray-500 mb-0">No audit records yet.</p>
        </div>
    }
    else
    {
        <div class="bg-white border border-gray-100 shadow-sm overflow-hidden">
            <table class="w-full">
                <thead class="bg-gray-50/50">
                    <tr>
                        <th class="text-left px-4 py-3 text-[9px] font-bold uppercase tracking-widest text-gray-400">When</th>
                        <th class="text-left px-4 py-3 text-[9px] font-bold uppercase tracking-widest text-gray-400">User</th>
                        <th class="text-left px-4 py-3 text-[9px] font-bold uppercase tracking-widest text-gray-400">Action</th>
                        <th class="text-left px-4 py-3 text-[9px] font-bold uppercase tracking-widest text-gray-400">Details</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-50">
                    @foreach (var l in list)
                    {
                        <tr>
                            <td class="px-4 py-3 text-xs text-gray-500 whitespace-nowrap">@l.Timestamp.ToString("dd MMM HH:mm:ss")</td>
                            <td class="px-4 py-3 text-xs text-gray-700">@l.UserName</td>
                            <td class="px-4 py-3">
                                <span class="text-[8px] font-bold uppercase tracking-widest px-2 py-0.5 bg-gray-700 text-white">@l.Action</span>
                            </td>
                            <td class="px-4 py-3 text-xs text-gray-500">
                                @if (!string.IsNullOrEmpty(l.NewValue))
                                {<span>→ @l.NewValue</span>}
                                @if (!string.IsNullOrEmpty(l.Reason))
                                {<span class="italic">(@l.Reason)</span>}
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

<style>
    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }

    .divide-y > * + * {
        border-top-width: 1px;
    }
</style>
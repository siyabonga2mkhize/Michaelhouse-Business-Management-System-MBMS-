@model IEnumerable<Michaelhouse.Models.Event>

@{
    ViewBag.Title = "Events";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var events = Model as List<Michaelhouse.Models.Event> ?? new List<Michaelhouse.Models.Event>();
    var today = DateTime.Now.Date;
}

<div class="relative mb-8 border-b border-gray-100 bg-gray-50/30 py-8 px-4 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none"
         style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 24px 24px;"></div>
    <i class="bi bi-calendar-event absolute -right-8 -bottom-10 text-black/5 text-[12rem] rotate-12"></i>

    <div class="max-w-6xl mx-auto relative z-10">
        <div class="flex items-center gap-2 mb-3">
            <div class="h-1 w-8 bg-[#C21E2E]"></div>
            <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Cafeteria</h5>
        </div>
        <h2 class="text-3xl font-serif font-bold text-gray-900 tracking-tight">Events & Feasts</h2>
        <p class="text-gray-400 text-[10px] uppercase tracking-widest font-bold mt-2">
            Manage special events requiring catering
        </p>
    </div>
</div>

<div class="max-w-6xl mx-auto px-4 pb-20">

    @* ─── SUMMARY & ACTIONS ──────────────────────────────────── *@
    <div class="flex flex-wrap gap-3 items-center mb-6">
        <span class="text-[9px] font-bold uppercase tracking-widest px-3 py-1 bg-gray-900 text-white">Total: @events.Count</span>
        <span class="text-[9px] font-bold uppercase tracking-widest px-3 py-1 border border-blue-200 text-blue-600 bg-blue-50">Planned: @events.Count(e => e.Status == "Planned")</span>
        <span class="text-[9px] font-bold uppercase tracking-widest px-3 py-1 border border-green-200 text-green-600 bg-green-50">Confirmed: @events.Count(e => e.Status == "Confirmed")</span>
        <span class="text-[9px] font-bold uppercase tracking-widest px-3 py-1 border border-gray-200 text-gray-500 bg-gray-50">Completed: @events.Count(e => e.Status == "Completed")</span>
        <a href="@Url.Action("CreateEvent")" class="ml-auto bg-[#C21E2E] text-white px-5 py-2 text-[10px] font-bold uppercase tracking-widest hover:bg-black transition-all">
            <i class="bi bi-plus-circle me-2"></i>Schedule Event
        </a>
    </div>

    @* ─── EVENTS LIST ─────────────────────────────────────────── *@
    @if (!events.Any())
    {
        <div class="bg-white border border-gray-100 p-12 text-center">
            <i class="bi bi-calendar-x text-6xl block mb-4 text-gray-300"></i>
            <p class="text-gray-500 text-lg font-bold mb-2">No events scheduled yet.</p>
            <p class="text-gray-400 text-sm mb-6">Create an event to open it for RSVPs.</p>
            <a href="@Url.Action("CreateEvent")" class="inline-block bg-[#C21E2E] text-white px-6 py-3 text-[10px] font-bold uppercase tracking-widest hover:bg-black transition-all">
                Schedule First Event
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var ev in events.OrderBy(e => e.Date))
            {
                bool isPast = ev.Date < today;
                string statusColor = ev.Status == "Completed" ? "gray" : (ev.Status == "Confirmed" ? "green" : "blue");

                <div class="col-lg-6">
                    <div class="bg-white border border-gray-100 shadow-sm overflow-hidden h-full @(isPast ? "opacity-60" : "")">
                        <div class="bg-gray-900 p-4">
                            <div class="flex justify-between items-start">
                                <div>
                                    <h5 class="text-base font-serif font-bold text-white mb-1">@ev.Name</h5>
                                    <p class="text-[10px] uppercase tracking-widest font-bold text-gray-400 mb-0">
                                        @ev.Date.ToString("dd MMM yyyy") @if (!string.IsNullOrEmpty(ev.Time))
                                        {<text>&bull; @ev.Time</text>}
                                    </p>
                                </div>
                                <span class="text-[9px] font-bold uppercase tracking-widest px-2 py-0.5 bg-@statusColor-500 text-white">@ev.Status</span>
                            </div>
                        </div>

                        <div class="p-4">
                            <div class="row g-2 mb-3">
                                <div class="col-6">
                                    <div class="text-[9px] uppercase tracking-widest font-bold text-gray-400 mb-1">Location</div>
                                    <div class="text-sm text-gray-700">@(string.IsNullOrEmpty(ev.Location) ? "TBD" : ev.Location)</div>
                                </div>
                                <div class="col-6">
                                    <div class="text-[9px] uppercase tracking-widest font-bold text-gray-400 mb-1">Expected Guests</div>
                                    <div class="text-sm font-bold text-[#C21E2E]">@ev.ExpectedGuests</div>
                                </div>
                                <div class="col-6">
                                    <div class="text-[9px] uppercase tracking-widest font-bold text-gray-400 mb-1">Meal Type</div>
                                    <div class="text-sm text-gray-700">@(string.IsNullOrEmpty(ev.MealType) ? "TBD" : ev.MealType)</div>
                                </div>
                                <div class="col-6">
                                    <div class="text-[9px] uppercase tracking-widest font-bold text-gray-400 mb-1">Special Needs</div>
                                    <div class="text-xs text-gray-600">@(string.IsNullOrEmpty(ev.SpecialRequirements) ? "None" : ev.SpecialRequirements)</div>
                                </div>
                            </div>

                            <div class="flex gap-2 pt-3 border-t border-gray-50">
                                <a href="@Url.Action("ViewRSVPs", new { id = ev.EventID })"
                                   class="flex-1 text-center text-[9px] font-bold uppercase tracking-widest text-gray-500 hover:text-[#C21E2E] px-3 py-2 border border-gray-200 hover:border-[#C21E2E] transition-all">
                                    <i class="bi bi-people me-1"></i>View RSVPs
                                </a>
                                <a href="@Url.Action("FeastPlan", new { id = ev.EventID })"
                                   class="flex-1 text-center text-[9px] font-bold uppercase tracking-widest text-[#C21E2E] hover:bg-red-50 px-3 py-2 border border-[#C21E2E] transition-all">
                                    <i class="bi bi-clipboard-check me-1"></i>Feast Plan
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }
</style>
@model IEnumerable<Michaelhouse.Models.Recipe>

@{
    ViewBag.Title = "Master Recipe Database";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var recipes = Model as List<Michaelhouse.Models.Recipe> ?? new List<Michaelhouse.Models.Recipe>();
    var grouped = recipes.GroupBy(r => r.Category ?? "Other").OrderBy(g => g.Key);
}

<div class="relative mb-8 border-b border-gray-100 bg-gray-50/30 py-8 px-4 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none"
         style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 24px 24px;"></div>
    <i class="bi bi-book absolute -right-8 -bottom-10 text-black/5 text-[12rem] rotate-12"></i>

    <div class="max-w-6xl mx-auto relative z-10">
        <div class="flex items-center gap-2 mb-3">
            <div class="h-1 w-8 bg-[#C21E2E]"></div>
            <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Master Recipe Database</h5>
        </div>
        <h2 class="text-3xl font-serif font-bold text-gray-900 tracking-tight">Recipes</h2>
        <p class="text-gray-400 text-[10px] uppercase tracking-widest font-bold mt-2">
            @recipes.Count recipes available to the kitchen
        </p>
    </div>
</div>

<div class="max-w-6xl mx-auto px-4 pb-20">

    @* ─── ACTION BUTTONS ──────────────────────────────────────── *@
    <div class="flex justify-between items-center mb-6">
        <div class="text-[10px] text-gray-500 uppercase tracking-widest font-bold">
            All Recipes — Seeded and Added Manually
        </div>
        <a href="@Url.Action("AddRecipe")" class="bg-[#C21E2E] text-white px-6 py-3 text-[10px] font-bold uppercase tracking-widest hover:bg-black transition-all">
            <i class="bi bi-plus-circle me-2"></i>Add New Recipe
        </a>
    </div>

    @if (!recipes.Any())
    {
        <div class="bg-white border border-gray-100 p-12 text-center">
            <i class="bi bi-book text-6xl block mb-4 text-gray-300"></i>
            <p class="text-gray-500 text-lg font-bold mb-2">No recipes in the database yet.</p>
            <p class="text-gray-400 text-sm mb-6">Add your first recipe to get started.</p>
            <a href="@Url.Action("AddRecipe")" class="inline-block bg-[#C21E2E] text-white px-6 py-3 text-[10px] font-bold uppercase tracking-widest hover:bg-black transition-all">
                Add Recipe
            </a>
        </div>
    }
    else
    {
        foreach (var group in grouped)
        {
            <div class="mb-8">
                <div class="flex items-center gap-3 mb-4">
                    <div class="h-1 w-6 bg-[#C21E2E]"></div>
                    <h4 class="text-[11px] uppercase tracking-[4px] font-bold text-gray-900 mb-0">@group.Key</h4>
                    <span class="text-[9px] font-bold uppercase tracking-widest px-2 py-0.5 bg-gray-100 text-gray-500">@group.Count()</span>
                </div>

                <div class="row g-4">
                    @foreach (var recipe in group.OrderBy(r => r.Name))
                    {
                        <div class="col-lg-6">
                            <div class="bg-white border border-gray-100 shadow-sm p-5 h-full flex flex-col">
                                <div class="flex justify-between items-start mb-3">
                                    <h5 class="text-base font-serif font-bold text-gray-900 mb-0">@recipe.Name</h5>
                                    @if (!recipe.IsActive)
                                    {
                                        <span class="text-[8px] font-bold uppercase tracking-widest px-2 py-0.5 bg-red-50 text-red-500 border border-red-200">Inactive</span>
                                    }
                                </div>

                                @* ─── Nutrition Grid ─────────────────────────── *@
                                <div class="grid grid-cols-4 gap-2 mb-3 text-center">
                                    <div class="bg-gray-50 py-2">
                                        <div class="text-[8px] uppercase tracking-widest font-bold text-gray-400">Cal</div>
                                        <div class="text-xs font-bold text-gray-800">@recipe.Calories</div>
                                    </div>
                                    <div class="bg-red-50 py-2">
                                        <div class="text-[8px] uppercase tracking-widest font-bold text-gray-400">Prot</div>
                                        <div class="text-xs font-bold text-red-700">@recipe.Protein g</div>
                                    </div>
                                    <div class="bg-blue-50 py-2">
                                        <div class="text-[8px] uppercase tracking-widest font-bold text-gray-400">Carb</div>
                                        <div class="text-xs font-bold text-blue-700">@recipe.Carbs g</div>
                                    </div>
                                    <div class="bg-amber-50 py-2">
                                        <div class="text-[8px] uppercase tracking-widest font-bold text-gray-400">Fat</div>
                                        <div class="text-xs font-bold text-amber-700">@recipe.Fats g</div>
                                    </div>
                                </div>

                                @* ─── Tags ───────────────────────────────────── *@
                                <div class="flex flex-wrap gap-1 mb-3">
                                    @if (!string.IsNullOrEmpty(recipe.Tags))
                                    {
                                        foreach (var tag in recipe.Tags.Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries))
                                        {
                                            <span class="text-[8px] font-bold uppercase tracking-widest px-2 py-0.5 bg-green-50 text-green-700 border border-green-200">@tag.Trim()</span>
                                        }
                                    }
                                </div>

                                @* ─── Allergens ──────────────────────────────── *@
                                @if (!string.IsNullOrEmpty(recipe.Allergens) && recipe.Allergens.ToLower() != "none")
                                {
                                    <div class="mb-3">
                                        <span class="text-[8px] font-bold uppercase tracking-widest px-2 py-0.5 bg-red-50 text-red-600 border border-red-200">
                                            ⚠️ @recipe.Allergens
                                        </span>
                                    </div>
                                }

                                @* ─── Spacer ────────────────────────────────── *@
                                <div class="flex-grow"></div>

                                @* ─── Actions ────────────────────────────────── *@
                                <div class="flex gap-2 pt-3 border-t border-gray-50">
                                    <a href="@Url.Action("EditRecipe", new { id = recipe.RecipeID })"
                                       class="flex-1 text-center text-[9px] font-bold uppercase tracking-widest text-gray-500 hover:text-[#C21E2E] px-3 py-2 border border-gray-200 hover:border-[#C21E2E] transition-all">
                                        <i class="bi bi-pencil me-1"></i>Edit
                                    </a>
                                    @using (Html.BeginForm("DeleteRecipe", "Cafeteria", new { id = recipe.RecipeID }, FormMethod.Post, new { @class = "flex-1" }))
                                    {
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="w-full text-[9px] font-bold uppercase tracking-widest text-red-500 hover:bg-red-50 px-3 py-2 border border-red-200 transition-all"
                                                onclick="return confirm('Remove this recipe from the active list?');">
                                            <i class="bi bi-trash me-1"></i>Remove
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

<style>
    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }
</style>
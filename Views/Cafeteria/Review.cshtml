@using Michaelhouse.Models.Cafeteria
@using Michaelhouse.Services
@model Michaelhouse.Models.ViewModels.ProposedMenuViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Review Menu";

    var userRole = Session["UserRole"] as string;
    var isCoordinator = userRole == "CafeteriaManager" || userRole == "Admin";
    var isChef = userRole == "Chef";

    var menuItems = (ViewBag.MenuItems as IEnumerable<MenuItem>) ?? Enumerable.Empty<MenuItem>();
    var coverage = ViewBag.Coverage as MenuCoverageReport;

    var allItems = Model.ScheduleItems ?? new List<Michaelhouse.Models.ViewModels.MenuScheduleItemDisplay>();

    Func<string, int> slotOrder = s => s == "Breakfast" ? 1 : s == "Lunch" ? 2 : s == "Dinner" ? 3 : 4;

    // Options grouped by day, then by meal slot
    var days = allItems
        .GroupBy(x => x.Date.Date)
        .OrderBy(g => g.Key)
        .ToList();

    // Chef sign-off is no longer required before acceptance
    var canAccept = Model.MenuStatus != MenuStatus.Accepted
                    && Model.MenuStatus != MenuStatus.Rejected;

    var showCoordinatorActions = isCoordinator && Model.MenuStatus != MenuStatus.Accepted;

    // Portions per slot = all its options together
    var slotTotals = allItems
        .GroupBy(x => new { x.Date, x.MealSlot })
        .Select(g => g.Sum(x => x.CalculatedPortions))
        .ToList();

    string portionsLabel = "—";
    if (slotTotals.Any())
    {
        int minPortions = slotTotals.Min();
        int maxPortions = slotTotals.Max();
        portionsLabel = minPortions == maxPortions
            ? minPortions.ToString()
            : minPortions.ToString() + "–" + maxPortions.ToString();
    }

    var optionCounts = allItems
        .GroupBy(x => new { x.Date, x.MealSlot })
        .Select(g => g.Count())
        .ToList();

    string optionsLabel = !optionCounts.Any() ? "—"
        : optionCounts.Min() == optionCounts.Max() ? optionCounts.Min().ToString()
        : optionCounts.Min() + "–" + optionCounts.Max();

    int slotsWithWarnings = coverage != null ? coverage.SlotsWithWarnings : 0;
    int totalSlots = coverage != null ? coverage.Slots.Count : 0;
}

@* --- FULL SCREEN VIEWPORT CONTAINER --- *@
<div class="flex flex-col h-full w-full overflow-hidden bg-gray-50/30">

    @* --- INSTITUTIONAL HEADER --- *@
    <div class="mb-6 d-flex justify-content-between align-items-end border-b border-gray-200 pb-6 flex-shrink-0 px-8 pt-8 bg-white shadow-sm relative z-10">
        <div>
            <div class="flex items-center gap-2 mb-3">
                <div class="h-[2px] w-8 bg-[#C21E2E]"></div>
                <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Meal Coordinator</h5>
            </div>
            <div class="flex items-center gap-4">
                <h2 class="text-5xl font-serif font-bold text-gray-900 tracking-tight mb-0">Proposed Menu</h2>
                <span class="inline-flex items-center text-[10px] font-bold uppercase tracking-widest px-3 py-1.5 border shadow-sm mt-2 bg-blue-50 text-blue-700 border-blue-200">
                    @Model.MenuStatus
                </span>
            </div>
            <p class="text-[11px] font-mono text-gray-500 uppercase tracking-widest mt-3 mb-0">
                @Model.StartDate.ToString("dd MMM yyyy") - @Model.EndDate.ToString("dd MMM yyyy")
                <span class="mx-2 text-gray-300">|</span> <strong>@optionsLabel</strong> options/meal
                <span class="mx-2 text-gray-300">|</span> <strong>@portionsLabel</strong> portions/meal
                <span class="mx-2 text-gray-300">|</span> <strong>@Model.StaffMeals</strong> staff meals
            </p>
        </div>
        <div class="flex gap-3">
            <button onclick="window.history.back();" class="inline-flex items-center justify-center bg-white border border-gray-300 text-gray-700 px-6 py-3 text-[10px] font-bold uppercase tracking-[2px] hover:bg-gray-50 hover:border-gray-400 transition-all duration-300 shadow-sm">
                <i class="bi bi-arrow-left me-2 text-sm"></i> Go Back
            </button>
        </div>
    </div>

    @* --- SCROLLABLE DATA SECTION --- *@
    <div class="flex-grow min-h-0 overflow-y-auto custom-scrollbar px-8 pb-10 pt-4 flex flex-col gap-6">

        @* --- SYSTEM ALERTS --- *@
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="bg-green-50 border-l-4 border-green-500 p-4 text-green-700 shadow-sm flex items-center">
                <i class="bi bi-check-circle-fill me-3 text-xl"></i>
                <span class="text-xs font-bold uppercase tracking-widest">@TempData["SuccessMessage"]</span>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="bg-red-50 border-l-4 border-[#C21E2E] p-4 text-[#C21E2E] shadow-sm flex items-center">
                <i class="bi bi-x-circle-fill me-3 text-xl"></i>
                <span class="text-xs font-bold uppercase tracking-widest">@TempData["ErrorMessage"]</span>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.RejectionReason))
        {
            <div class="bg-red-50 border-l-4 border-[#C21E2E] p-4 shadow-sm flex items-start">
                <i class="bi bi-exclamation-octagon-fill text-[#C21E2E] me-3 text-xl mt-0.5"></i>
                <div>
                    <strong class="text-sm font-serif text-[#C21E2E] block mb-1">Rejection reason:</strong>
                    <span class="text-xs font-mono text-red-900 uppercase tracking-widest">@Model.RejectionReason</span>
                </div>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.SpecialEventNotes))
        {
            <div class="bg-blue-50 border-l-4 border-blue-500 p-4 shadow-sm flex items-start">
                <i class="bi bi-info-circle-fill text-blue-500 me-3 text-xl mt-0.5"></i>
                <div>
                    <strong class="text-sm font-serif text-blue-900 block mb-1">Special event notes:</strong>
                    <span class="text-xs font-mono text-blue-800 uppercase tracking-widest">@Model.SpecialEventNotes</span>
                </div>
            </div>
        }

        <div class="bg-gray-50 border border-gray-200 p-4 shadow-inner text-xs font-mono text-gray-600 uppercase tracking-widest leading-relaxed">
            <i class="bi bi-lightbulb me-2 text-gray-400 text-sm align-middle"></i>
            This menu lists the <strong>options</strong> for each meal. Students choose one option per meal in their meal plan, and only see the options that suit their dietary profile. Portions per option are an estimate until meal plans are in.
        </div>

        @* --- TELEMETRY STATS --- *@
        <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
            <div class="bg-white border border-gray-200 shadow-sm p-6 relative overflow-hidden group">
                <h6 class="text-[9px] uppercase tracking-[3px] font-bold text-gray-400 mb-2">Options / Meal</h6>
                <h3 class="font-mono text-4xl font-bold text-gray-900 mb-0">@optionsLabel</h3>
            </div>

            <div class="bg-white border border-gray-200 shadow-sm p-6 relative overflow-hidden group">
                <h6 class="text-[9px] uppercase tracking-[3px] font-bold text-gray-400 mb-2">Portions / Meal</h6>
                <h3 class="font-mono text-4xl font-bold text-gray-900 mb-0">@portionsLabel</h3>
                <span class="text-[9px] font-mono text-gray-500 uppercase tracking-widest mt-2 block">incl. @Model.StaffMeals staff</span>
            </div>

            <div class="bg-white border border-gray-200 shadow-sm p-6 relative overflow-hidden group">
                <h6 class="text-[9px] uppercase tracking-[3px] font-bold text-gray-400 mb-2">Students</h6>
                <h3 class="font-mono text-4xl font-bold text-gray-900 mb-0">@(coverage != null ? coverage.TotalStudents : 0)</h3>
                <span class="text-[9px] font-mono text-gray-500 uppercase tracking-widest mt-2 block">@(coverage != null ? coverage.Groups.Count(g => !g.IsUnrestricted) : 0) dietary group(s)</span>
            </div>

            <div class="bg-white border border-gray-200 shadow-sm p-6 relative overflow-hidden group border-b-4 @(slotsWithWarnings > 0 ? "border-b-yellow-500" : "border-b-[#10b981]")">
                <h6 class="text-[9px] uppercase tracking-[3px] font-bold text-gray-400 mb-2">Dietary Coverage</h6>
                <h3 class="font-mono text-4xl font-bold mb-0 @(slotsWithWarnings > 0 ? "text-yellow-600" : "text-[#10b981]")">
                    @(totalSlots - slotsWithWarnings)/@totalSlots
                </h3>
                <span class="text-[9px] font-mono text-gray-500 uppercase tracking-widest mt-2 block">meals where every group has a choice</span>
            </div>
        </div>

        @if (coverage != null && coverage.Groups.Any(g => !g.IsUnrestricted))
        {
            <div class="bg-white shadow-sm border border-gray-100 p-4 flex flex-wrap items-center gap-2">
                <strong class="text-[10px] uppercase tracking-[2px] font-bold text-gray-500 me-2">Student dietary groups:</strong>
                @foreach (var g in coverage.Groups)
                {
                    <span class="inline-flex items-center text-[9px] font-bold uppercase tracking-widest px-2 py-1 shadow-sm @(g.IsUnrestricted ? "bg-gray-50 text-gray-700 border border-gray-200" : "bg-gray-200 text-gray-800 border border-gray-300")">
                        @g.Label: @g.StudentCount
                    </span>
                }
            </div>
        }

        @if (slotsWithWarnings > 0)
        {
            <div class="bg-yellow-50 border-l-4 border-yellow-500 p-5 shadow-sm flex flex-col gap-2">
                <div class="flex items-center text-yellow-800">
                    <i class="bi bi-exclamation-triangle-fill me-3 text-xl"></i>
                    <strong class="text-sm font-serif">@slotsWithWarnings meal(s) don't give every dietary group — or every group of players with a match or training that day — a suitable option.</strong>
                </div>
                <p class="text-xs font-mono text-yellow-700 uppercase tracking-widest mb-0 ms-8">Review the warnings below and modify options as needed.</p>

                <details class="mt-3 ms-8 group/details">
                    <summary class="text-[10px] font-bold uppercase tracking-[2px] text-yellow-800 cursor-pointer hover:text-yellow-900 transition-colors list-none flex items-center">
                        <i class="bi bi-chevron-right me-2 transition-transform group-open/details:rotate-90"></i> Show all warnings
                    </summary>
                    <ul class="mt-3 mb-0 flex flex-col gap-2 ps-0 list-none">
                        @foreach (var slot in coverage.Slots.Where(s => s.Warnings.Any()))
                        {
                            foreach (var w in slot.Warnings)
                            {
                                <li class="text-[10px] font-mono text-yellow-900 bg-yellow-100/50 p-2 border border-yellow-200/50 uppercase tracking-widest">
                                    <i class="bi bi-dot me-1"></i> Warning: @w
                                </li>
                            }
                        }
                    </ul>
                </details>
            </div>
        }
        else if (coverage != null && totalSlots > 0)
        {
            <div class="bg-green-50 border-l-4 border-green-500 p-4 text-green-800 shadow-sm flex items-center">
                <i class="bi bi-check-circle-fill me-3 text-xl"></i>
                <span class="text-sm font-serif font-bold">Every meal gives every dietary group, and every group of players with a match or training, at least one suitable option.</span>
            </div>
        }

        @* --- MENU OPTIONS LEDGER --- *@
        <div class="bg-white shadow-sm border border-gray-100 flex flex-col relative overflow-hidden group flex-grow">
            <div class="p-5 border-b border-gray-100 bg-[#1a1a1a] flex justify-between items-center relative z-10">
                <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-white mb-0"><i class="bi bi-card-list me-2 text-gray-500"></i> Menu Options</h5>
                <span class="text-[10px] font-mono text-gray-400 uppercase tracking-widest">@allItems.Count option(s)</span>
            </div>

            <div class="table-responsive flex-grow overflow-y-auto custom-scrollbar relative z-10">
                <table class="table align-middle mb-0 w-full">
                    <thead class="sticky top-0 z-20 bg-gray-50/90 backdrop-blur-sm shadow-sm">
                        <tr class="text-[9px] uppercase tracking-[4px] font-bold text-gray-500 border-b border-gray-200">
                            <th class="ps-6 py-4" style="width: 250px;">Option</th>
                            <th class="border-l border-gray-100 ps-4">Suitable for</th>
                            <th class="border-l border-gray-100 ps-4 text-center" style="width: 130px;">Est. Portions</th>
                            <th class="border-l border-gray-100 ps-4" style="width: 220px;">Nutrition</th>
                            @if (showCoordinatorActions)
                            {
                                <th class="border-l border-gray-100 text-end pe-6" style="width: 100px;">Action</th>
                            }
                        </tr>
                    </thead>
                    <tbody class="text-gray-700">
                        @foreach (var day in days)
                        {
                            <tr class="bg-gray-100 border-y border-gray-200">
                                <td colspan="@(showCoordinatorActions ? 5 : 4)" class="ps-6 py-3 font-serif font-bold text-sm text-gray-900 uppercase tracking-widest">
                                    <i class="bi bi-calendar-day me-2 text-gray-500"></i> @day.Key.ToString("dddd, dd MMM yyyy")
                                </td>
                            </tr>

                            foreach (var slotGroup in day.GroupBy(x => x.MealSlot).OrderBy(g => slotOrder(g.Key)))
                            {
                                MealSlot slotEnum;
                                Enum.TryParse(slotGroup.Key, out slotEnum);
                                var slotCoverage = coverage != null ? coverage.For(day.Key, slotEnum) : null;

                                // Institutional Color Coding for Slots
                                var accent = slotGroup.Key == "Breakfast" ? "#0ea5e9" : slotGroup.Key == "Lunch" ? "#3b82f6" : "#f59e0b";
                                var accentBg = slotGroup.Key == "Breakfast" ? "bg-sky-50" : slotGroup.Key == "Lunch" ? "bg-blue-50" : "bg-amber-50";

                                <tr class="@accentBg border-y border-gray-100">
                                    <td colspan="@(showCoordinatorActions ? 5 : 4)" class="ps-6 py-2" style="border-left: 4px solid @accent;">
                                        <div class="flex flex-wrap items-center gap-3">
                                            <span class="font-bold text-[10px] uppercase tracking-[3px] text-gray-800">@slotGroup.Key</span>
                                            <span class="text-[9px] font-mono text-gray-500 uppercase tracking-widest">@slotGroup.Count() option(s) · @slotGroup.Sum(x => x.CalculatedPortions) portions</span>

                                            @if (slotCoverage != null)
                                            {
                                                if (slotCoverage.Warnings.Any())
                                                {
                                                    <span class="inline-flex items-center text-[8px] font-bold uppercase tracking-widest bg-yellow-100 text-yellow-800 px-2 py-0.5 border border-yellow-200 shadow-sm">
                                                        @slotCoverage.StudentsWithOption of @slotCoverage.TotalStudents students covered
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="inline-flex items-center text-[8px] font-bold uppercase tracking-widest bg-green-100 text-green-800 px-2 py-0.5 border border-green-200 shadow-sm">
                                                        All groups covered
                                                    </span>
                                                }
                                            }
                                        </div>
                                        @if (slotCoverage != null && slotCoverage.Warnings.Any())
                                        {
                                            <div class="mt-2 flex flex-col gap-1">
                                                @foreach (var w in slotCoverage.Warnings)
                                                {
                                                    <div class="text-[9px] font-mono text-[#C21E2E] uppercase tracking-widest"><i class="bi bi-exclamation-triangle me-1"></i> Warning: @w</div>
                                                }
                                            </div>
                                        }
                                    </td>
                                </tr>

                                foreach (var item in slotGroup.OrderBy(x => x.Id))
                                {
                                    var optionCoverage = slotCoverage != null ? slotCoverage.Options.FirstOrDefault(o => o.ScheduleItemId == item.Id) : null;
                                    var reason = item.TagReason ?? "";
                                    var isMatchContext = reason.StartsWith("Match-day") || reason.StartsWith("Pre-match");

                                    <tr class="hover:bg-white transition-colors border-b border-gray-50 bg-gray-50/30">
                                        <td class="ps-6 py-4" style="border-left: 4px solid @accent;">
                                            <div class="font-serif font-bold text-sm text-gray-900 mb-1">@item.MenuItemName</div>
                                            <div class="text-[9px] font-mono uppercase tracking-[2px] text-gray-500">@item.DietaryClassification</div>
                                        </td>

                                        <td class="border-l border-gray-50 ps-4 py-4">
                                            <div class="flex flex-col gap-2">
                                                @if (optionCoverage != null)
                                                {
                                                    <div class="flex flex-wrap gap-1">
                                                        @foreach (var label in optionCoverage.SuitableFor)
                                                        {
                                                            <span class="inline-flex items-center text-[8px] font-bold uppercase tracking-widest bg-green-50 text-green-700 px-2 py-0.5 border border-green-200 shadow-sm">@label</span>
                                                        }
                                                    </div>
                                                    <div class="text-[9px] font-mono text-gray-400 uppercase tracking-widest">
                                                        @optionCoverage.StudentsSuited of @(slotCoverage.TotalStudents) students
                                                    </div>
                                                }
                                                @if (isMatchContext)
                                                {
                                                    <div>
                                                        <span class="inline-flex items-center text-[8px] font-bold uppercase tracking-widest bg-indigo-50 text-indigo-700 px-2 py-0.5 border border-indigo-200 shadow-sm">
                                                            <i class="bi bi-trophy me-1"></i> Match context
                                                        </span>
                                                    </div>
                                                }
                                                @if (!string.IsNullOrEmpty(reason))
                                                {
                                                    <div class="text-[9px] font-serif italic text-gray-600 mt-1 border-l-2 border-gray-200 pl-2">@reason</div>
                                                }
                                            </div>
                                        </td>

                                        <td class="border-l border-gray-50 ps-4 text-center">
                                            <span class="font-mono text-lg font-bold text-gray-900">@item.CalculatedPortions</span>
                                        </td>

                                        <td class="border-l border-gray-50 ps-4">
                                            <div class="flex flex-col gap-1">
                                                <span class="font-mono text-xs font-bold text-gray-700">@item.CaloriesPerPortion.ToString("0") <span class="text-[9px] font-normal text-gray-400 uppercase tracking-widest">kcal</span></span>
                                                <span class="font-mono text-xs font-bold text-blue-700">@item.ProteinGramsPerPortion.ToString("0.0") <span class="text-[9px] font-normal text-gray-400 uppercase tracking-widest">g protein</span></span>
                                                @if (item.NutritionCategory != NutritionCategory.Standard && Enum.IsDefined(typeof(NutritionCategory), item.NutritionCategory))
                                                {
                                                    <div class="mt-1">
                                                        <span class="inline-flex items-center text-[8px] font-bold uppercase tracking-widest bg-gray-100 text-gray-700 px-2 py-0.5 border border-gray-200 shadow-sm">@item.NutritionCategory</span>
                                                    </div>
                                                }
                                            </div>
                                        </td>

                                        @if (showCoordinatorActions)
                                        {
                                            <td class="pe-6 border-l border-gray-50 text-end">
                                                <button type="button" class="inline-flex items-center justify-center bg-white border border-gray-300 text-gray-700 px-4 py-2 text-[9px] font-bold uppercase tracking-[1px] hover:border-gray-800 hover:bg-gray-50 transition-colors shadow-sm w-full" onclick="openUc12Modal('modifyModal-@item.Id')">
                                                    <i class="bi bi-pencil-square me-1"></i> Modify
                                                </button>
                                            </td>
                                        }
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @* --- BOTTOM ACTION PANELS --- *@
        @if (showCoordinatorActions)
        {
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mt-2">
                <form action="@Url.Action("Accept", "Cafeteria")" method="post" class="m-0 h-full">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@Model.Id" />
                    <button type="submit" class="w-full h-full bg-[#10b981] text-white px-8 py-5 text-[11px] font-bold uppercase tracking-[3px] hover:bg-green-600 hover:shadow-[0_0_20px_rgba(16,185,129,0.4)] transition-all duration-300 disabled:opacity-50 disabled:cursor-not-allowed" disabled="@(!canAccept)" onclick="return confirm('@(slotsWithWarnings > 0 ? "Some meals do not give every dietary or sports group a suitable option. Accept anyway?" : "Accept this menu?")');">
                        <i class="bi bi-check-circle me-2 text-lg align-middle"></i> Accept Menu
                    </button>
                </form>

                <button type="button" class="w-full h-full bg-transparent border-2 border-[#C21E2E] text-[#C21E2E] px-8 py-5 text-[11px] font-bold uppercase tracking-[3px] hover:bg-red-50 hover:shadow-sm transition-all duration-300" onclick="openUc12Modal('rejectModal')">
                    <i class="bi bi-x-octagon me-2 text-lg align-middle"></i> Reject & Regenerate
                </button>
            </div>
        }

        @if (isChef)
        {
            <div class="bg-white shadow-sm border border-gray-100 p-6 flex justify-between items-center mt-2">
                <div>
                    <strong class="font-serif text-lg text-gray-900 block mb-1">Chef Workspace</strong>
                    <span class="text-[10px] font-mono text-gray-500 uppercase tracking-widest">Kitchen review is optional at this stage.</span>
                </div>
                <a href="@Url.Action("ChefReview", "Cafeteria", new { id = Model.Id })" class="inline-flex items-center justify-center bg-[#1a1a1a] text-white px-8 py-4 text-[11px] font-bold uppercase tracking-[3px] hover:bg-black hover:shadow-[0_0_15px_rgba(0,0,0,0.3)] transition-all duration-300">
                    <i class="bi bi-journal-text me-2 text-sm align-middle"></i> Open Kitchen Review
                </a>
            </div>
        }

    </div>
</div>

@* --- MODALS --- *@
@if (showCoordinatorActions)
{
    foreach (var item in allItems)
    {
        var sameDayIds = allItems.Where(x => x.Date.Date == item.Date.Date && x.Id != item.Id).Select(x => x.MenuItemId).ToList();
        var slotItems = menuItems
            .Where(mi => (item.MealSlot == "Breakfast" && mi.IsBreakfastItem)
                      || (item.MealSlot == "Lunch" && mi.IsLunchItem)
                      || (item.MealSlot == "Dinner" && mi.IsDinnerItem))
            .Where(mi => !sameDayIds.Contains(mi.Id))
            .ToList();

        <div class="uc12-modal" id="modifyModal-@item.Id" aria-hidden="true">
            <div class="uc12-modal-dialog">
                <div class="uc12-modal-content">
                    <div class="uc12-modal-header bg-[#1a1a1a] text-white border-b-0">
                        <h5 class="uc12-modal-title text-[10px] uppercase tracking-[3px] font-bold m-0 py-2">
                            <i class="bi bi-pencil-square me-2 text-gray-400"></i> Modify @item.MealSlot Option — @item.Date.ToString("ddd dd MMM")
                        </h5>
                        <button type="button" class="uc12-modal-close text-gray-400 hover:text-white transition-colors" onclick="closeUc12Modal('modifyModal-@item.Id')" aria-label="Close">
                            <i class="bi bi-x-lg text-sm"></i>
                        </button>
                    </div>

                    <form action="@Url.Action("ModifyItem", "Cafeteria")" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <div class="uc12-modal-body p-6 bg-gray-50 flex flex-col gap-5">
                            <input type="hidden" name="scheduleItemId" value="@item.Id" />

                            <div class="bg-white border border-gray-200 p-4 shadow-sm text-center">
                                <span class="text-[9px] uppercase tracking-[2px] font-bold text-gray-400 block mb-1">Currently Selected</span>
                                <strong class="font-serif text-lg text-[#C21E2E]">@item.MenuItemName</strong>
                            </div>

                            <div>
                                <label class="block text-[9px] uppercase tracking-[2px] font-bold text-gray-500 mb-2">Replacement @item.MealSlot.ToLower() Option</label>
                                <select name="newMenuItemId" class="w-full border border-gray-200 p-3 outline-none focus:border-[#C21E2E] font-serif text-sm text-gray-900 transition-colors bg-white shadow-sm" required>
                                    <option value="">Select new dish...</option>
                                    @foreach (var mi in slotItems)
                                    {
                                        <option value="@mi.Id" @(mi.Id == item.MenuItemId ? "selected" : "")>@mi.Name (@mi.DietaryClassification)</option>
                                    }
                                </select>
                                <p class="text-[9px] font-mono text-gray-400 mt-2 uppercase tracking-widest"><i class="bi bi-info-circle me-1"></i> Only dishes not already scheduled today are listed.</p>
                            </div>

                            <div>
                                <label class="block text-[9px] uppercase tracking-[2px] font-bold text-gray-500 mb-2">Estimated Portions</label>
                                <input type="number" name="newPortions" value="@item.CalculatedPortions" min="1" class="w-full border border-gray-200 p-3 outline-none focus:border-[#C21E2E] font-mono text-lg font-bold text-gray-900 transition-colors bg-white shadow-sm" required />
                                <p class="text-[9px] font-mono text-gray-400 mt-2 uppercase tracking-widest"><i class="bi bi-calculator me-1"></i> An estimate for planning; actual numbers come from student meal plans.</p>
                            </div>
                        </div>

                        <div class="uc12-modal-footer bg-white border-t border-gray-200 p-4">
                            <button type="button" class="bg-transparent border border-gray-300 text-gray-600 px-6 py-3 text-[10px] font-bold uppercase tracking-[2px] hover:bg-gray-50 transition-all shadow-sm" onclick="closeUc12Modal('modifyModal-@item.Id')">
                                Cancel
                            </button>
                            <button type="submit" class="bg-[#1a1a1a] text-white px-6 py-3 text-[10px] font-bold uppercase tracking-[2px] hover:bg-black transition-all shadow-sm">
                                <i class="bi bi-save me-1"></i> Save Change
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    }

    <div class="uc12-modal" id="rejectModal" aria-hidden="true">
        <div class="uc12-modal-dialog">
            <div class="uc12-modal-content border-t-4 border-t-[#C21E2E]">
                <div class="uc12-modal-header bg-white border-b border-gray-100">
                    <h5 class="uc12-modal-title text-sm font-serif font-bold text-gray-900 m-0 py-2">
                        <i class="bi bi-x-octagon text-[#C21E2E] me-2"></i> Reject & Regenerate Menu
                    </h5>
                    <button type="button" class="uc12-modal-close text-gray-400 hover:text-[#C21E2E] transition-colors" onclick="closeUc12Modal('rejectModal')" aria-label="Close">
                        <i class="bi bi-x-lg text-sm"></i>
                    </button>
                </div>
                <form action="@Url.Action("Reject", "Cafeteria")" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <div class="uc12-modal-body p-6 bg-gray-50 flex flex-col gap-4">
                        <input type="hidden" name="id" value="@Model.Id" />

                        <div>
                            <label class="block text-[9px] uppercase tracking-[2px] font-bold text-gray-500 mb-2">Reason for rejection *</label>
                            <textarea name="reason" class="w-full border border-gray-200 p-4 outline-none focus:border-[#C21E2E] font-serif text-sm text-gray-900 transition-colors bg-white resize-y shadow-sm" rows="5" required maxlength="2000" placeholder="Explain what needs to change..."></textarea>
                        </div>

                        <div class="bg-yellow-50 border-l-4 border-yellow-500 p-3 mt-2 shadow-sm">
                            <span class="text-[10px] font-mono text-yellow-800 uppercase tracking-widest leading-relaxed">
                                <i class="bi bi-exclamation-triangle-fill text-yellow-600 me-1"></i> Rejecting preserves the rejected proposal in the archive and generates a new one for the exact same period.
                            </span>
                        </div>
                    </div>
                    <div class="uc12-modal-footer bg-white border-t border-gray-200 p-4">
                        <button type="button" class="bg-transparent border border-gray-300 text-gray-600 px-6 py-3 text-[10px] font-bold uppercase tracking-[2px] hover:bg-gray-50 transition-all shadow-sm" onclick="closeUc12Modal('rejectModal')">
                            Cancel
                        </button>
                        <button type="submit" class="bg-[#C21E2E] text-white px-6 py-3 text-[10px] font-bold uppercase tracking-[2px] hover:bg-red-700 transition-all shadow-sm">
                            Reject & Regenerate
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}

<style>
    .font-serif { font-family: 'Playfair Display', serif !important; }
    .font-mono { font-family: 'Source Code Pro', monospace !important; }
    .custom-scrollbar::-webkit-scrollbar { width: 5px; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #eee; border-radius: 10px; }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #C21E2E; }

    /* Custom high-end modal overrides */
    .uc12-modal {
        position: fixed;
        inset: 0;
        z-index: 2000;
        display: none;
        width: 100%;
        height: 100%;
        overflow-y: auto;
        background: rgba(0,0,0,0.65);
        backdrop-filter: blur(4px);
        -webkit-backdrop-filter: blur(4px);
        padding: 40px 15px;
    }

    .uc12-modal.uc12-modal-open {
        display: block;
        animation: modalFadeIn 0.3s cubic-bezier(0.165, 0.84, 0.44, 1) forwards;
    }

    .uc12-modal-dialog {
        position: relative;
        max-width: 600px;
        margin: 0 auto;
        transform: translateY(20px);
        animation: modalSlideUp 0.4s cubic-bezier(0.165, 0.84, 0.44, 1) forwards;
    }

    .uc12-modal-content {
        background: #fff;
        border-radius: 0; /* Sharp corners */
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5); /* Deep shadow */
        overflow: hidden;
    }

    .uc12-modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem 1.5rem;
    }

    .uc12-modal-close {
        border: 0;
        background: transparent;
        padding: 0;
        cursor: pointer;
    }

    .uc12-modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
    }

    keyframes modalFadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    keyframes modalSlideUp {
        from { transform: translateY(20px); }
        to { transform: translateY(0); }
    }
</style>

<script>
    function openUc12Modal(id) {
        var m = document.getElementById(id);
        if (!m) return;
        m.classList.add("uc12-modal-open");
        document.body.style.overflow = "hidden";
    }
    function closeUc12Modal(id) {
        var m = document.getElementById(id);
        if (!m) return;
        m.classList.remove("uc12-modal-open");
        document.body.style.overflow = "";
    }
    document.addEventListener("click", function (e) {
        if (e.target.classList.contains("uc12-modal")) closeUc12Modal(e.target.id);
    });
    document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") {
            var m = document.querySelector(".uc12-modal.uc12-modal-open");
            if (m) closeUc12Modal(m.id);
        }
    });
</script>
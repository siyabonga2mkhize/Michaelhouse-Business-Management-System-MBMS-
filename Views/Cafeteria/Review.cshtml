@using Michaelhouse.Models.Cafeteria
@model Michaelhouse.Models.ViewModels.ProposedMenuViewModel

@{
Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Review Menu";

    var userRole = Session["UserRole"] as string;
    var isCoordinator = userRole == "CafeteriaManager" || userRole == "Admin";
    var isChef = userRole == "Chef";

    var menuItems = ViewBag.MenuItems as IEnumerable<MenuItem>;

    var scheduleItems = Model.ScheduleItems != null
        ? Model.ScheduleItems
            .OrderBy(x => x.Date)
            .ThenBy(x =>
                x.MealSlot == "Breakfast" ? 1 :
                x.MealSlot == "Lunch" ? 2 :
                x.MealSlot == "Dinner" ? 3 : 4)
        : Enumerable.Empty<Michaelhouse.Models.ViewModels.MenuScheduleItemDisplay>();

    var canAccept = Model.IsKitchenReady
                    && Model.MenuStatus != MenuStatus.Accepted
                    && Model.MenuStatus != MenuStatus.Rejected;

    var showCoordinatorActions = isCoordinator && Model.MenuStatus != MenuStatus.Accepted;
    var showChefBanner = isCoordinator && Model.MenuStatus == MenuStatus.PendingReview && Model.IsKitchenReady;
    var showWaitingBanner = isCoordinator && Model.MenuStatus == MenuStatus.PendingReview && !Model.IsKitchenReady;

    var portions = 0;
    if (Model.ScheduleItems != null && Model.ScheduleItems.Any())
    {
        portions = Model.ScheduleItems.Select(x => x.CalculatedPortions).FirstOrDefault();
    }
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-start mb-4">
        <div>
            <h1 class="h3 mb-1">Proposed Menu</h1>
            <p class="text-muted mb-0">
                @Model.StartDate.ToString("dd MMM yyyy") - @Model.EndDate.ToString("dd MMM yyyy")
                - <strong>@portions</strong> portions per meal
            </p>
        </div>
        <div class="d-flex align-items-center gap-2">
            @if (Model.IsKitchenReady && Model.MenuStatus != MenuStatus.Accepted)
            {
            <span class="badge bg-success fs-6">Kitchen Ready</span>
            }
            <span class="badge bg-primary fs-6">@Model.MenuStatus</span>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.RejectionReason))
    {
    <div class="alert alert-warning">
        <strong>Rejection reason:</strong> @Model.RejectionReason
    </div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.SpecialEventNotes))
    {
    <div class="alert alert-info">
        <strong>Special event notes:</strong> @Model.SpecialEventNotes
    </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="small text-muted text-uppercase">Staff meals</div>
                    <div class="display-6">@Model.StaffMeals</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="small text-muted text-uppercase">Confirmed</div>
                    <div class="display-6 text-success">@Model.ConfirmedCount</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="small text-muted text-uppercase">Needs Substitution</div>
                    <div class="display-6 text-warning">@Model.NeedsSubstitutionCount</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow-sm h-100">
                <div class="card-body">
                    <div class="small text-muted text-uppercase">Needs Review</div>
                    <div class="display-6 text-danger">@Model.NeedsReviewCount</div>
                </div>
            </div>
        </div>
    </div>

    @if (showChefBanner)
    {
    <div class="alert alert-success">
        <strong>Chef has marked this menu Kitchen Ready.</strong> You can now accept it.
    </div>
    }

    @if (showWaitingBanner)
    {
    <div class="alert alert-info">
        <strong>Chef review in progress</strong> - Accept is locked until the Chef signs off.
    </div>
    }

    <div class="card shadow-sm mb-4">
        <div class="card-header bg-white">
            <strong>Weekly Menu</strong>
            <span class="text-muted small ms-2">@Model.ScheduleItems.Count item(s)</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 120px;">Date</th>
                            <th style="width: 100px;">Meal</th>
                            <th>Item</th>
                            <th style="width: 190px;">Nutrition</th>
                            <th style="width: 170px;">Status</th>
                            @if (showCoordinatorActions)
                            {
                            <th style="width: 90px;"></th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in scheduleItems)
                        {
                            var mealClass = "";
                            var badgeText = "";
                            var badgeClass = "";
                            var reasonText = "";
                            var showReason = false;

                            if (item.MealSlot == "Breakfast") { mealClass = "border-start border-4 border-info"; }
                            if (item.MealSlot == "Lunch") { mealClass = "border-start border-4 border-primary"; }
                            if (item.MealSlot == "Dinner") { mealClass = "border-start border-4 border-warning"; }

                            if (item.StatusText != "Confirmed")
                            {
                                badgeText = item.StatusText;
                                badgeClass = item.StatusCssClass;
                                reasonText = item.TagReason ?? "";
                                showReason = true;
                            }

                            if ((item.TagReason ?? "").Contains("Match-day") || (item.TagReason ?? "").Contains("Pre-match"))
                            {
                                badgeText = "Match context";
                                badgeClass = "bg-info text-dark";
                            }

                        <tr class="@mealClass">
                            <td>
                                <div class="fw-bold">@item.Date.ToString("ddd dd MMM")</div>
                            </td>
                            <td>
                                <span class="fw-bold text-uppercase small">@item.MealSlot</span>
                            </td>
                            <td>
                                <div class="fw-bold">@item.MenuItemName</div>
                                <div class="small text-muted">@item.DietaryClassification</div>
                            </td>
                            <td class="small text-muted">
                                @item.CaloriesPerPortion.ToString("0") kcal,
                                @item.ProteinGramsPerPortion.ToString("0.0") g protein
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(badgeText))
                                    {
                                <span class="badge @badgeClass">@badgeText</span>
                                    }
                            </td>
                            @if (showCoordinatorActions)
                                {
                            <td class="text-end">
                                <button type="button"
                                        class="btn btn-sm btn-outline-primary"
                                        onclick="openUc12Modal('modifyModal-@item.Id')">
                                    Modify
                                </button>
                            </td>
                                }
                        </tr>
                            if (showReason && !string.IsNullOrWhiteSpace(reasonText))
                            {
                        <tr class="@mealClass">
                            <td></td>
                            <td colspan="5" class="pt-0 pb-2">
                                <div class="small text-muted fst-italic">@reasonText</div>
                            </td>
                        </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @if (showCoordinatorActions)
    {
    <div class="card shadow-sm mt-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <form action="@Url.Action("Accept", "Cafeteria")" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <button type="submit"
                                class="btn btn-success w-100"
                                disabled="@(!canAccept)"
                                onclick="return confirm('Accept this menu?');">
                            Accept Menu
                        </button>
                    </form>
                </div>
                <div class="col-md-6">
                    <button type="button"
                            class="btn btn-danger w-100"
                            onclick="openUc12Modal('rejectModal')">
                        Reject and Regenerate
                    </button>
                </div>
            </div>
        </div>
    </div>
    }

    @if (isChef)
    {
    <div class="card shadow-sm mt-4">
        <div class="card-body d-flex justify-content-between align-items-center">
            <div>
                <strong>Chef workspace</strong>
                <div class="small text-muted">Resolve flagged items on the Kitchen Review page.</div>
            </div>
            <a href="@Url.Action("ChefReview", "Cafeteria", new { id = Model.Id })"
               class="btn btn-primary">
                Open Kitchen Review
            </a>
        </div>
    </div>
    }

</div>

@if (showCoordinatorActions && Model.ScheduleItems != null)
{
    foreach (var item in Model.ScheduleItems)
    {
<div class="uc12-modal" id="modifyModal-@item.Id" aria-hidden="true">
    <div class="uc12-modal-dialog">
        <div class="uc12-modal-content">
            <div class="uc12-modal-header">
                <h5 class="uc12-modal-title">Modify Menu Item</h5>
                <button type="button"
                        class="uc12-modal-close"
                        onclick="closeUc12Modal('modifyModal-@item.Id')"
                        aria-label="Close">
                    x
                </button>
            </div>
            <form action="@Url.Action("ModifyItem", "Cafeteria")" method="post">
                @Html.AntiForgeryToken()
                <div class="uc12-modal-body">
                    <input type="hidden" name="scheduleItemId" value="@item.Id" />
                    <div class="mb-3">
                        <label class="form-label">Replacement dish</label>
                        <select name="newMenuItemId" class="form-select" required>
                            <option value="">Select dish...</option>
                            @if (menuItems != null)
                                    {
                                        foreach (var mi in menuItems)
                                        {
                            <option value="@mi.Id">@mi.Name</option>
                                        }
                                    }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Portions</label>
                        <input type="number"
                               name="newPortions"
                               value="@item.CalculatedPortions"
                               min="1"
                               class="form-control"
                               required />
                    </div>
                </div>
                <div class="uc12-modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            onclick="closeUc12Modal('modifyModal-@item.Id')">
                        Cancel
                    </button>
                    <button type="submit" class="btn btn-primary">Save Modification</button>
                </div>
            </form>
        </div>
    </div>
</div>
    }
}

@if (showCoordinatorActions)
{
<div class="uc12-modal" id="rejectModal" aria-hidden="true">
    <div class="uc12-modal-dialog">
        <div class="uc12-modal-content">
            <div class="uc12-modal-header">
                <h5 class="uc12-modal-title">Reject Menu</h5>
                <button type="button"
                        class="uc12-modal-close"
                        onclick="closeUc12Modal('rejectModal')"
                        aria-label="Close">
                    x
                </button>
            </div>
            <form action="@Url.Action("Reject", "Cafeteria")" method="post">
                @Html.AntiForgeryToken()
                <div class="uc12-modal-body">
                    <input type="hidden" name="id" value="@Model.Id" />
                    <div class="mb-3">
                        <label class="form-label">Reason for rejection</label>
                        <textarea name="reason"
                                  class="form-control"
                                  rows="5"
                                  required
                                  maxlength="2000"
                                  placeholder="Explain what needs to change..."></textarea>
                    </div>
                    <div class="alert alert-warning mb-0">
                        Rejecting preserves the rejected proposal and generates a new one for the same period.
                    </div>
                </div>
                <div class="uc12-modal-footer">
                    <button type="button"
                            class="btn btn-secondary"
                            onclick="closeUc12Modal('rejectModal')">
                        Cancel
                    </button>
                    <button type="submit" class="btn btn-danger">Reject and Regenerate</button>
                </div>
            </form>
        </div>
    </div>
</div>
}

<script>
    function openUc12Modal(id) {
        var m = document.getElementById(id);
        if (!m) return;
        m.classList.add("uc12-modal-open");
        document.body.style.overflow = "hidden";
    }
    function closeUc12Modal(id) {
        var m = document.getElementById(id);
        if (!m) return;
        m.classList.remove("uc12-modal-open");
        document.body.style.overflow = "";
    }
    document.addEventListener("click", function (e) {
        if (e.target.classList.contains("uc12-modal")) closeUc12Modal(e.target.id);
    });
    document.addEventListener("keydown", function (e) {
        if (e.key === "Escape") {
            var m = document.querySelector(".uc12-modal.uc12-modal-open");
            if (m) closeUc12Modal(m.id);
        }
    });
</script>

<style>
    .uc12-modal {
        position: fixed;
        inset: 0;
        z-index: 2000;
        display: none;
        width: 100%;
        height: 100%;
        overflow-y: auto;
        background: rgba(0,0,0,0.55);
        padding: 40px 15px;
    }

        .uc12-modal.uc12-modal-open {
            display: block;
        }

    .uc12-modal-dialog {
        position: relative;
        max-width: 600px;
        margin: 0 auto;
    }

    .uc12-modal-content {
        background: #fff;
        border-radius: 0.5rem;
        box-shadow: 0 1rem 3rem rgba(0,0,0,0.35);
    }

    .uc12-modal-header {
        display: flex;
        justify-content: space-between;
        padding: 1rem;
        border-bottom: 1px solid #dee2e6;
    }

    .uc12-modal-title {
        margin: 0;
        font-size: 1.25rem;
        font-weight: 500;
    }

    .uc12-modal-close {
        border: 0;
        background: transparent;
        font-size: 1.5rem;
        padding: 0.25rem 0.5rem;
        cursor: pointer;
        opacity: 0.6;
    }

        .uc12-modal-close:hover {
            opacity: 1;
        }

    .uc12-modal-body {
        padding: 1rem;
    }

    .uc12-modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 0.5rem;
        padding: 0.75rem 1rem;
        border-top: 1px solid #dee2e6;
    }

    .table-hover tbody tr:hover {
        background: #f8f9fa;
    }
</style>
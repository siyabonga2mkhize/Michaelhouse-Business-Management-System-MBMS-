@model Michaelhouse.Models.InventoryItem

@{
    ViewBag.Title = "Add Inventory Item";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="relative mb-8 border-b border-gray-100 bg-gray-50/30 py-8 px-4 overflow-hidden">
    <div class="max-w-3xl mx-auto relative z-10">
        <div class="flex items-center gap-2 mb-3">
            <div class="h-1 w-8 bg-[#C21E2E]"></div>
            <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Cafeteria Manager</h5>
        </div>
        <h2 class="text-3xl font-serif font-bold text-gray-900 tracking-tight">Add Inventory Item</h2>
        <p class="text-gray-400 text-[10px] uppercase tracking-widest font-bold mt-2">
            Add a new food item to track in inventory
        </p>
    </div>
</div>

<div class="max-w-3xl mx-auto px-4 pb-20">

    @using (Html.BeginForm("AddInventoryItem", "Cafeteria", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="bg-white border border-gray-100 shadow-sm overflow-hidden mb-6">
            <div class="p-4 border-b border-gray-100 bg-gray-50/50">
                <h6 class="text-[10px] uppercase tracking-[3px] font-bold text-gray-900 mb-0">
                    <i class="bi bi-box me-2 text-[#C21E2E]"></i>Item Details
                </h6>
            </div>

            <div class="p-6 space-y-4">

                <div>
                    <label class="text-[9px] uppercase tracking-widest font-bold text-gray-400 block mb-2">Item Name *</label>
                    <input type="text" name="ItemName" required class="w-full border border-gray-200 py-3 px-4 text-sm" placeholder="e.g., Chicken Breast" />
                </div>

                <div>
                    <label class="text-[9px] uppercase tracking-widest font-bold text-gray-400 block mb-2">Category *</label>
                    <select name="Category" required class="w-full border border-gray-200 py-3 px-4 text-sm">
                        <option value="">-- Select category --</option>
                        <option value="Food">Food</option>
                        <option value="Beverage">Beverage</option>
                        <option value="Kitchen Supply">Kitchen Supply</option>
                    </select>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="text-[9px] uppercase tracking-widest font-bold text-gray-400 block mb-2">Quantity In Stock *</label>
                        <input type="number" name="QuantityInStock" value="0" required class="w-full border border-gray-200 py-3 px-4 text-sm" />
                    </div>
                    <div class="col-md-6">
                        <label class="text-[9px] uppercase tracking-widest font-bold text-gray-400 block mb-2">Unit *</label>
                        <select name="Unit" required class="w-full border border-gray-200 py-3 px-4 text-sm">
                            <option value="kg">kg</option>
                            <option value="L">L</option>
                            <option value="pieces">pieces</option>
                            <option value="bags">bags</option>
                            <option value="boxes">boxes</option>
                            <option value="packs">packs</option>
                            <option value="rolls">rolls</option>
                        </select>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="text-[9px] uppercase tracking-widest font-bold text-gray-400 block mb-2">Reorder Level *</label>
                        <input type="number" name="ReorderLevel" value="10" required class="w-full border border-gray-200 py-3 px-4 text-sm" />
                        <p class="text-[9px] text-gray-400 mt-1">System flags item when stock drops below this</p>
                    </div>
                    <div class="col-md-6">
                        <label class="text-[9px] uppercase tracking-widest font-bold text-gray-400 block mb-2">Unit Price (R) *</label>
                        <input type="number" step="0.01" name="UnitPrice" value="0.00" required class="w-full border border-gray-200 py-3 px-4 text-sm" />
                    </div>
                </div>

                <div>
                    <label class="text-[9px] uppercase tracking-widest font-bold text-gray-400 block mb-2">Supplier</label>
                    <input type="text" name="Supplier" class="w-full border border-gray-200 py-3 px-4 text-sm" placeholder="e.g., FreshDirect Foods" />
                </div>

                <div>
                    <label class="text-[9px] uppercase tracking-widest font-bold text-gray-400 block mb-2">SKU (optional)</label>
                    <input type="text" name="SKU" class="w-full border border-gray-200 py-3 px-4 text-sm" placeholder="e.g., FOOD-CHK-001" />
                </div>
            </div>
        </div>

        <div class="bg-white border border-gray-100 p-4 flex justify-between items-center">
            <a href="@Url.Action("Inventory")" class="text-[10px] font-bold uppercase tracking-widest text-gray-500 hover:text-[#C21E2E] transition-colors">
                <i class="bi bi-arrow-left me-2"></i>Cancel
            </a>
            <button type="submit" class="bg-[#C21E2E] text-white px-8 py-3 text-[10px] font-bold uppercase tracking-widest hover:bg-black transition-all">
                <i class="bi bi-save me-2"></i>Save Item
            </button>
        </div>
    }
</div>

<style>
    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }
</style>
@using System.Linq
@using Michaelhouse.Models.ViewModels
@model ProductionPlanViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Kitchen Requirements";

    bool hasSelections = Model.IsMenuPublished && Model.SubmittedPlanCount > 0 && Model.WeekTotalIngredients.Any();
    var problems = Model.Warnings.Where(w => w.Severity != KitchenWarningSeverity.Info).ToList();
}

@helper Status(IngredientLineViewModel line)
{
    if (line.Status == IngredientAvailability.Available)
    {
        <span class="badge bg-success">Available</span>
    }
    else if (line.Status == IngredientAvailability.Insufficient)
    {
        <span class="badge bg-warning text-dark">Insufficient</span>
        <div class="small text-danger">short @KitchenQuantity.Format(line.Shortfall, line.Unit)</div>
    }
    else
    {
        <span class="badge bg-danger">Not available</span>
    }
}

@helper Table(IEnumerable<IngredientLineViewModel> lines)
{
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Ingredient</th>
                    <th class="text-end">Required</th>
                    <th class="text-end">Available</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var line in lines)
                {
                    <tr>
                        <td><strong>@line.IngredientName</strong></td>
                        <td class="text-end">@KitchenQuantity.Format(line.TotalRequired, line.Unit)</td>
                        <td class="text-end">@KitchenQuantity.Format(line.StockAvailable, line.Unit)</td>
                        <td>@Status(line)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<div class="container-fluid py-4">

    <div class="d-flex justify-content-between align-items-start mb-4 flex-wrap gap-2">
        <div>
            <h1 class="h3 mb-1">Kitchen Requirements</h1>
            <p class="text-muted mb-0">
                @Model.WeekStart.ToString("dd MMM yyyy") – @Model.WeekEnd.ToString("dd MMM yyyy")
                · calculated from students' submitted meal plans
            </p>
        </div>
        <div class="d-flex gap-2">
            <a href="@Url.Action("Review", "Cafeteria", new { id = Model.MenuId })" class="btn btn-outline-secondary">Back to Menu</a>
            @if (hasSelections)
            {
                <a href="@Url.Action("ProductionPlan", "Cafeteria", new { id = Model.MenuId })" class="btn btn-primary">Open Kitchen Plan</a>
            }
        </div>
    </div>

    @if (!Model.IsMenuPublished)
    {
        <div class="alert alert-info">
            Kitchen requirements are calculated from what students choose, so they appear once this menu is
            published and students have submitted their meal plans.
        </div>
    }
    else if (!hasSelections)
    {
        <div class="alert alert-info">
            No student has submitted a meal plan for this week yet, so there are no requirements to calculate.
            @if (Model.UnsubmittedPlansWithPicks > 0)
            {
                <span>@Model.UnsubmittedPlansWithPicks student(s) have chosen meals but not submitted.</span>
            }
        </div>
    }
    else
    {
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <div class="card shadow-sm h-100"><div class="card-body">
                    <div class="small text-muted text-uppercase">Submitted meal plans</div>
                    <div class="display-6">@Model.SubmittedPlanCount</div>
                    <div class="small text-muted">of @Model.StudentCount students</div>
                </div></div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm h-100"><div class="card-body">
                    <div class="small text-muted text-uppercase">Portions to prepare</div>
                    <div class="display-6">@Model.TotalMeals</div>
                    <div class="small text-muted">incl. @Model.StaffMeals staff per meal</div>
                </div></div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm h-100"><div class="card-body">
                    <div class="small text-muted text-uppercase">Ingredients</div>
                    <div class="display-6">@Model.WeekTotalIngredients.Count</div>
                </div></div>
            </div>
            <div class="col-md-3">
                <div class="card shadow-sm h-100"><div class="card-body">
                    <div class="small text-muted text-uppercase">Availability problems</div>
                    <div class="display-6 @(problems.Any() ? "text-danger" : "text-success")">@problems.Count</div>
                </div></div>
            </div>
        </div>

        if (problems.Any())
        {
            <div class="alert alert-danger">
                <strong>Some ingredients may stop meals being prepared.</strong>
                <ul class="mb-0 mt-1 small">
                    @foreach (var w in problems.OrderByDescending(w => w.Severity))
                    {
                        <li><strong>@w.When:</strong> @w.Message <span class="text-muted">Affects: @string.Join(", ", w.AffectedMeals)</span></li>
                    }
                </ul>
            </div>
        }

        if (Model.UnsubmittedPlansWithPicks > 0)
        {
            <div class="alert alert-light border small">
                @Model.UnsubmittedPlansWithPicks student(s) have chosen meals but not submitted — they aren't counted.
            </div>
        }

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white"><strong>Week total</strong> <span class="text-muted small ms-2">compared with current stock — nothing is reserved or deducted</span></div>
            <div class="card-body p-0">
                @Table(Model.WeekTotalIngredients)
            </div>
        </div>

        foreach (var day in Model.Days.Where(d => d.DayTotalIngredients.Any()))
        {
            <details class="card shadow-sm mb-2">
                <summary class="card-header bg-white">
                    <strong>@day.Date.ToString("dddd dd MMM")</strong>
                    <span class="text-muted small ms-2">@day.Slots.Sum(s => s.Portions) portions</span>
                    @if (!day.SelectionsFinal)
                    {
                        <span class="text-warning small ms-2">students can still change these meals</span>
                    }
                </summary>
                <div class="card-body p-0">
                    @Table(day.DayTotalIngredients)
                </div>
            </details>
        }
    }

</div>

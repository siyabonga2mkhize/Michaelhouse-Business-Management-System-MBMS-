@{
    ViewBag.Title = "Schedule Weekly Menu";
    Layout = "~/Views/Shared/_Layout.cshtml";

    var today = DateTime.Today;
    int diff = (7 - (int)today.DayOfWeek) % 7;
    if (diff == 0) { diff = 7; }
    var defaultStart = today.AddDays(diff);
    var defaultEnd = defaultStart.AddDays(6);

    var culture = System.Globalization.CultureInfo.InvariantCulture;
    int weekNum = culture.Calendar.GetWeekOfYear(
        defaultStart,
        System.Globalization.CalendarWeekRule.FirstFourDayWeek,
        DayOfWeek.Monday);
    var nextWeekNumber = "W" + weekNum.ToString("D2");
}

<div class="relative mb-8 border-b border-gray-100 bg-gray-50/30 py-8 px-4 overflow-hidden">
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none"
         style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 24px 24px;"></div>
    <i class="bi bi-calendar-plus absolute -right-8 -bottom-10 text-black/5 text-[12rem] rotate-12"></i>

    <div class="max-w-2xl mx-auto relative z-10">
        <div class="flex items-center gap-2 mb-3">
            <div class="h-1 w-8 bg-[#C21E2E]"></div>
            <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Cafeteria</h5>
        </div>
        <h2 class="text-3xl font-serif font-bold text-gray-900 tracking-tight">Schedule Weekly Menu</h2>
        <p class="text-gray-400 text-[10px] uppercase tracking-widest font-bold mt-2">
            Sunday to Saturday &bull; Boarding school week
        </p>
    </div>
</div>

<div class="max-w-2xl mx-auto px-4 pb-20">

    <div class="bg-blue-50 border-l-4 border-blue-500 p-4 mb-6">
        <h6 class="text-[10px] uppercase tracking-widest font-bold text-blue-700 mb-1">
            <i class="bi bi-info-circle me-1"></i>What happens next
        </h6>
        <p class="text-xs text-blue-800 mb-0">
            After saving, you'll be taken to the Menu Editor where you build each day's meals.
            The Chef is automatically notified to review.
        </p>
    </div>

    @using (Html.BeginForm("CreateWeeklyMenu", "Cafeteria", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <div class="bg-white border border-gray-100 shadow-sm overflow-hidden mb-6">
            <div class="p-4 border-b border-gray-100 bg-gray-50/50">
                <h6 class="text-[10px] uppercase tracking-[3px] font-bold text-gray-900 mb-0">
                    <i class="bi bi-calendar3 me-2 text-[#C21E2E]"></i>Menu Week
                </h6>
            </div>

            <div class="p-6 space-y-5">
                <div>
                    <label class="block text-[9px] uppercase tracking-widest font-bold text-gray-400 mb-2">Week Number *</label>
                    <input type="text" name="WeekNumber" value="@nextWeekNumber" required
                           class="w-full border border-gray-200 py-3 px-4 text-sm"
                           placeholder="e.g. W40" />
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-[9px] uppercase tracking-widest font-bold text-gray-400 mb-2">Start Date (Sunday) *</label>
                        <input type="date" name="StartDate" value="@defaultStart.ToString("yyyy-MM-dd")" required
                               class="w-full border border-gray-200 py-3 px-4 text-sm" />
                    </div>
                    <div>
                        <label class="block text-[9px] uppercase tracking-widest font-bold text-gray-400 mb-2">End Date (Saturday) *</label>
                        <input type="date" name="EndDate" value="@defaultEnd.ToString("yyyy-MM-dd")" required
                               class="w-full border border-gray-200 py-3 px-4 text-sm" />
                    </div>
                </div>
            </div>
        </div>

        <div class="bg-white border border-gray-100 p-4 flex justify-between items-center">
            <a href="@Url.Action("WeeklyMenu", "Cafeteria")"
               class="text-[10px] font-bold uppercase tracking-widest text-gray-500 hover:text-[#C21E2E]">
                <i class="bi bi-arrow-left me-2"></i>Cancel
            </a>
            <button type="submit"
                    class="bg-[#C21E2E] text-white px-8 py-3 text-[10px] font-bold uppercase tracking-widest hover:bg-black">
                <i class="bi bi-check2-circle me-2"></i>Create & Open Editor
            </button>
        </div>
    }
</div>

<style>
    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }
</style>
@using System.Linq
@using Michaelhouse.Models.ViewModels
@model ProductionPlanViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Kitchen Plan";

    var problems = Model.Warnings.Where(w => w.Severity != KitchenWarningSeverity.Info)
        .OrderByDescending(w => w.Severity)
        .ToList();
    var notes = Model.Warnings.Where(w => w.Severity == KitchenWarningSeverity.Info).ToList();
}

@helper Availability(IngredientLineViewModel line)
{
    if (line.Status == IngredientAvailability.Available)
    {
        <span class="inline-flex items-center text-[8px] font-bold uppercase tracking-widest bg-green-50 text-green-700 px-2 py-0.5 border border-green-200 shadow-sm">Available</span>
    }
    else if (line.Status == IngredientAvailability.Insufficient)
    {
        <span class="inline-flex items-center text-[8px] font-bold uppercase tracking-widest bg-yellow-50 text-yellow-700 px-2 py-0.5 border border-yellow-200 shadow-sm">Insufficient</span>
    }
    else
    {
        <span class="inline-flex items-center text-[8px] font-bold uppercase tracking-widest bg-red-50 text-[#C21E2E] px-2 py-0.5 border border-red-200 shadow-sm">Not Available</span>
    }
}

@helper CheckTable(IEnumerable<IngredientLineViewModel> lines, bool showMeals)
{
    <div class="overflow-x-auto bg-white border border-gray-200">
        <table class="table align-middle mb-0 w-full">
            <thead class="bg-gray-100">
                <tr class="text-[9px] uppercase tracking-[3px] font-bold text-gray-500 border-b border-gray-200">
                    <th class="ps-4 py-2.5">Ingredient</th>
                    <th class="text-end border-l border-gray-200 ps-4">Required</th>
                    <th class="text-end border-l border-gray-200 ps-4">Available</th>
                    <th class="border-l border-gray-200 ps-4">Status</th>
                    @if (showMeals)
                    {
                        <th class="border-l border-gray-200 pe-4 ps-4">Needed for</th>
                    }
                </tr>
            </thead>
            <tbody class="text-gray-700 text-xs">
                @foreach (var line in lines)
                {
                    <tr class="border-b border-gray-100 last:border-0 hover:bg-gray-50/80 transition-colors">
                        <td class="ps-4 py-2 font-serif font-bold text-gray-900">@line.IngredientName</td>
                        <td class="text-end border-l border-gray-100 ps-4 font-mono font-bold text-gray-900">@KitchenQuantity.Format(line.TotalRequired, line.Unit)</td>
                        <td class="text-end border-l border-gray-100 ps-4 font-mono text-gray-500">@KitchenQuantity.Format(line.StockAvailable, line.Unit)</td>
                        <td class="border-l border-gray-100 ps-4">
                            <div class="flex items-center gap-2">
                                @Availability(line)
                                @if (line.Status == IngredientAvailability.Insufficient)
                                {
                                    <span class="text-[9px] font-mono text-[#C21E2E] font-bold uppercase tracking-wider">Short @KitchenQuantity.Format(line.Shortfall, line.Unit)</span>
                                }
                            </div>
                        </td>
                        @if (showMeals)
                        {
                            <td class="border-l border-gray-100 pe-4 ps-4 text-[10px] font-mono text-gray-500 uppercase tracking-wider">
                                @string.Join(", ", line.AffectedMeals)
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@* --- FULL SCREEN VIEWPORT CONTAINER --- *@
<div class="flex flex-col h-full w-full overflow-hidden bg-gray-100/60">

    @* --- INSTITUTIONAL HEADER --- *@
    <div class="mb-6 d-flex justify-content-between align-items-end border-b border-gray-200 pb-6 flex-shrink-0 px-8 pt-8 bg-white shadow-sm relative z-10">
        <div>
            <div class="flex items-center gap-2 mb-3">
                <div class="h-[2px] w-8 bg-[#C21E2E]"></div>
                <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Culinary Operations</h5>
            </div>
            <div class="flex items-center gap-4">
                <h2 class="text-5xl font-serif font-bold text-gray-900 tracking-tight mb-0">Kitchen Plan</h2>
                @if (Model.HasIngredientProblems)
                {
                    <span class="inline-flex items-center text-[10px] font-bold uppercase tracking-widest px-3 py-1.5 border shadow-sm mt-2 bg-red-50 text-[#C21E2E] border-red-200">
                        @problems.Count Ingredient Problem(s)
                    </span>
                }
                else if (Model.TotalMeals > 0)
                {
                    <span class="inline-flex items-center text-[10px] font-bold uppercase tracking-widest px-3 py-1.5 border shadow-sm mt-2 bg-green-50 text-green-700 border-green-200">
                        Ingredients Available
                    </span>
                }
                @if (Model.IsProductionConfirmed)
                {
                    <span class="inline-flex items-center text-[10px] font-bold uppercase tracking-widest px-3 py-1.5 border shadow-sm mt-2 bg-green-100 text-green-800 border-green-300">
                        <i class="bi bi-shield-check me-1.5"></i> Confirmed
                    </span>
                }
            </div>
            <p class="text-[11px] font-mono text-gray-500 uppercase tracking-widest mt-3 mb-0">
                @Model.WeekStart.ToString("dd MMM") – @Model.WeekEnd.ToString("dd MMM yyyy")
                <span class="mx-2 text-gray-300">|</span> <strong>@Model.TotalMeals</strong> portions to prepare
                <span class="mx-2 text-gray-300">|</span> <strong>@Model.SubmittedPlanCount</strong> of <strong>@Model.StudentCount</strong> plans submitted
            </p>
        </div>
        <div class="flex gap-3">
            <a href="@Url.Action("ChefIndex", "Cafeteria")" class="inline-flex items-center justify-center bg-white border border-gray-300 text-gray-700 px-6 py-3 text-[10px] font-bold uppercase tracking-[2px] hover:bg-gray-50 hover:border-gray-400 transition-all duration-300 shadow-sm">
                <i class="bi bi-arrow-left me-2 text-sm"></i> Back To Kitchen
            </a>
        </div>
    </div>

    @* --- SCROLLABLE DATA SECTION --- *@
    <div class="flex-grow min-h-0 overflow-y-auto custom-scrollbar px-8 pb-32 pt-2 flex flex-col gap-10 relative">

        @* --- SYSTEM ALERTS --- *@
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="bg-green-50 border-l-4 border-green-500 p-4 text-green-700 shadow-sm flex items-center">
                <i class="bi bi-check-circle-fill me-3 text-xl"></i>
                <span class="text-xs font-bold uppercase tracking-widest">@TempData["SuccessMessage"]</span>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="bg-red-50 border-l-4 border-[#C21E2E] p-4 text-[#C21E2E] shadow-sm flex items-center">
                <i class="bi bi-x-circle-fill me-3 text-xl"></i>
                <span class="text-xs font-bold uppercase tracking-widest">@TempData["ErrorMessage"]</span>
            </div>
        }

        @if (!Model.IsMenuPublished)
        {
            <div class="bg-yellow-50 border-l-4 border-yellow-500 p-4 text-yellow-800 shadow-sm flex items-center">
                <i class="bi bi-exclamation-triangle-fill me-3 text-xl"></i>
                <span class="text-xs font-mono uppercase tracking-widest">
                    This menu hasn't been published yet. The kitchen plan fills in as students submit meal plans.
                </span>
            </div>
        }
        else if (Model.SubmittedPlanCount == 0)
        {
            <div class="bg-blue-50 border-l-4 border-blue-500 p-4 text-blue-800 shadow-sm flex items-center">
                <i class="bi bi-info-circle-fill me-3 text-xl"></i>
                <span class="text-xs font-mono uppercase tracking-widest">
                    No student has submitted a meal plan for this week yet, so there is nothing to prepare.
                </span>
            </div>
        }

        <div class="bg-white border-l-4 border-l-gray-900 border border-gray-200 p-4 shadow-sm text-xs font-mono text-gray-600 uppercase tracking-widest leading-relaxed">
            <i class="bi bi-info-circle me-2 text-gray-500"></i>
            Portions represent confirmed students in <strong>submitted</strong> plans.
            @if (Model.StaffMeals > 0)
            {
                <span class="ms-1">Includes <strong>@Model.StaffMeals</strong> staff meals mapped to the top-chosen dish.</span>
            }
            @if (Model.UnsubmittedPlansWithPicks > 0)
            {
                <span class="ms-1 font-bold text-gray-800">(@Model.UnsubmittedPlansWithPicks unsubmitted plans excluded).</span>
            }
        </div>

        @* --- CRITICAL WARNINGS OVERVIEW --- *@
        @if (problems.Any())
        {
            <div class="bg-red-50 border border-red-200 p-5 shadow-sm">
                <div class="flex items-center text-[#C21E2E] mb-3">
                    <i class="bi bi-exclamation-octagon-fill text-xl me-2"></i>
                    <strong class="font-serif text-base">Not ready: Ingredient shortfalls may prevent meal production.</strong>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3 ps-7">
                    @foreach (var w in problems)
                    {
                        <div class="bg-white border border-red-200 p-3 shadow-xs">
                            <span class="text-[10px] font-mono font-bold uppercase tracking-widest text-[#C21E2E] block mb-1">@w.When</span>
                            <div class="text-xs font-serif text-gray-900 mb-1">@w.Message</div>
                            <span class="text-[9px] font-mono text-gray-500 uppercase tracking-widest block">Affects: @string.Join(", ", w.AffectedMeals)</span>
                        </div>
                    }
                </div>
            </div>
        }
        else if (Model.TotalMeals > 0)
        {
            <div class="bg-green-50 border border-green-200 p-4 shadow-sm flex items-center text-green-900">
                <i class="bi bi-check-circle-fill text-xl text-[#10b981] me-3"></i>
                <strong class="font-serif text-sm">All ingredients for the chosen meals are fully stocked and available.</strong>
            </div>
        }

        @if (notes.Any())
        {
            <div class="bg-white border border-gray-200 p-4 shadow-xs flex flex-col gap-1.5">
                @foreach (var n in notes)
                {
                    <div class="text-[10px] font-mono text-gray-700 uppercase tracking-widest">
                        <strong class="text-gray-900">@n.When:</strong> @n.Message
                    </div>
                }
            </div>
        }

        @* --- DAY BLOCKS --- *@
        @foreach (var day in Model.Days)
        {
            <div class="bg-white border-2 border-gray-200 shadow-md flex flex-col relative overflow-hidden">

                @* Day Header Container (Command Style) *@
                <div class="p-5 bg-[#1a1a1a] text-white flex justify-between items-center relative z-10 flex-wrap gap-3 border-b-2 border-b-[#C21E2E]">
                    <div class="flex items-center gap-3">
                        <div class="bg-white/10 p-2.5 text-center min-w-[50px] border border-white/20">
                            <span class="block text-[9px] font-mono uppercase tracking-widest text-gray-300">@day.Date.ToString("ddd")</span>
                            <span class="block font-mono font-bold text-xl leading-none text-white mt-0.5">@day.Date.ToString("dd")</span>
                        </div>
                        <div>
                            <span class="text-2xl font-serif font-bold text-white tracking-wide block">@day.Date.ToString("dddd, dd MMMM yyyy")</span>
                            <span class="text-[9px] font-mono uppercase tracking-[2px] text-gray-400">Daily Kitchen Operations Ledger</span>
                        </div>
                    </div>

                    <div class="flex items-center gap-3">
                        @if (day.SelectionsFinal)
                        {
                            <span class="text-[9px] font-mono font-bold uppercase tracking-widest text-emerald-300 bg-emerald-950/80 px-3 py-1.5 border border-emerald-700 shadow-xs">
                                <i class="bi bi-lock me-1"></i> Selections Final
                            </span>
                        }
                        else
                        {
                            <span class="text-[9px] font-mono font-bold uppercase tracking-widest text-amber-300 bg-amber-950/80 px-3 py-1.5 border border-amber-700 shadow-xs">
                                Open until end of @day.SelectionCutoff.AddDays(-1).ToString("ddd dd MMM")
                            </span>
                        }

                        @if (day.IsIssued)
                        {
                            <a class="text-[9px] font-mono font-bold uppercase tracking-widest text-green-300 bg-emerald-950 border border-green-600 px-3 py-1.5 text-decoration-none shadow-xs hover:bg-emerald-900 transition-colors" href="@Url.Action("IssueIngredients", "Cafeteria", new { id = Model.MenuId, date = day.Date.ToString("yyyy-MM-dd") })">
                                <i class="bi bi-box-seam me-1"></i> Ingredients Issued@(day.IssuedAt.HasValue ? " " + Michaelhouse.Services.SchoolClock.FromUtc(day.IssuedAt.Value).ToString("ddd HH:mm") : "")@(day.IssuedBy != null ? " by " + day.IssuedBy : "")
                            </a>
                        }
                        else if (day.Slots.Any(s => s.Tasks.Any()))
                        {
                            <a class="inline-flex items-center justify-center bg-white text-gray-900 px-4 py-1.5 text-[9px] font-bold uppercase tracking-[2px] hover:bg-gray-100 transition-colors shadow-xs text-decoration-none" href="@Url.Action("IssueIngredients", "Cafeteria", new { id = Model.MenuId, date = day.Date.ToString("yyyy-MM-dd") })">
                                <i class="bi bi-box-seam me-1.5"></i> Issue Ingredients
                            </a>
                        }
                    </div>
                </div>

                @* Meal Slots Grid / Stack *@
                <div class="p-6 bg-gray-50/70 flex flex-col gap-6">
                    @foreach (var slot in day.Slots)
                    {
                        var slotAccent = slot.MealSlot == "Breakfast" ? "#0ea5e9" : slot.MealSlot == "Lunch" ? "#2563eb" : "#d97706";
                        var slotBg = slot.MealSlot == "Breakfast" ? "bg-sky-50/40" : slot.MealSlot == "Lunch" ? "bg-blue-50/40" : "bg-amber-50/40";
                        var slotBorder = slot.MealSlot == "Breakfast" ? "border-sky-200" : slot.MealSlot == "Lunch" ? "border-blue-200" : "border-amber-200";

                        <div class="bg-white border @slotBorder shadow-sm relative overflow-hidden" style="border-left: 6px solid @slotAccent;">

                            @* Meal Slot Sub-Header *@
                            <div class="p-4 border-b border-gray-100 @slotBg flex justify-between items-center flex-wrap gap-2">
                                <div class="flex items-center gap-3">
                                    <span class="font-serif font-bold text-base text-gray-900 uppercase tracking-wider">@slot.MealSlot</span>
                                    <span class="inline-flex items-center text-[9px] font-mono font-bold uppercase tracking-widest px-2.5 py-0.5 bg-white border border-gray-200 text-gray-700 shadow-2xs">
                                        Serve: @slot.ServeTime.ToString(@"hh\:mm")
                                    </span>
                                </div>
                                <div class="font-mono text-xs uppercase tracking-wider text-gray-600">
                                    Demand: <strong class="text-[#C21E2E] font-bold text-sm">@slot.Portions</strong> portions
                                </div>
                            </div>

                            @* Slot Content *@
                            <div class="p-5 flex flex-col gap-4">
                                @if (!slot.Tasks.Any())
                                {
                                    <div class="p-4 bg-gray-50 border border-dashed border-gray-200 text-center text-[10px] font-mono text-gray-400 uppercase tracking-widest italic">
                                        No student selections recorded for this meal slot.
                                    </div>
                                }
                                else
                                {
                                    <div class="grid grid-cols-1 gap-3">
                                        @foreach (var task in slot.Tasks)
                                        {
                                            var stClass = "bg-gray-100 text-gray-700 border-gray-200";
                                            if (task.Station == "Grill") { stClass = "bg-red-50 text-red-800 border-red-200"; }
                                            else if (task.Station == "Stove") { stClass = "bg-blue-50 text-blue-800 border-blue-200"; }
                                            else if (task.Station == "Oven") { stClass = "bg-amber-50 text-amber-800 border-amber-200"; }
                                            else if (task.Station == "Cold Prep") { stClass = "bg-emerald-50 text-emerald-800 border-emerald-200"; }

                                            var problemCount = task.Ingredients.Count(i => i.Status != IngredientAvailability.Available);

                                            <div class="bg-white border border-gray-200 p-4 shadow-xs hover:border-gray-300 transition-colors">
                                                <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-center">

                                                    @* Monospace Timeline *@
                                                    <div class="md:col-span-3 flex items-center gap-3 bg-gray-50 p-2.5 border border-gray-200">
                                                        <div class="font-mono text-xs font-bold text-gray-900">
                                                            @task.StartTime.ToString(@"hh\:mm")
                                                            <span class="block text-[8px] uppercase tracking-widest text-gray-400 font-normal">Start</span>
                                                        </div>
                                                        <i class="bi bi-arrow-right text-gray-400 text-xs mx-auto"></i>
                                                        <div class="font-mono text-xs font-bold text-gray-900 text-right">
                                                            @task.ReadyTime.ToString(@"hh\:mm")
                                                            <span class="block text-[8px] uppercase tracking-widest text-gray-400 font-normal">Ready</span>
                                                        </div>
                                                    </div>

                                                    @* Dish Identity *@
                                                    <div class="md:col-span-4">
                                                        <div class="font-serif font-bold text-sm text-gray-900">@task.DishName</div>
                                                        <div class="text-[9px] font-mono text-gray-400 uppercase tracking-wider mt-0.5">
                                                            @task.PrepMinutes min prep + @task.CookMinutes min cook
                                                        </div>
                                                    </div>

                                                    @* Station Badge *@
                                                    <div class="md:col-span-2">
                                                        <span class="inline-flex items-center text-[9px] font-bold uppercase tracking-widest px-2.5 py-1 border @stClass">
                                                            @task.Station
                                                        </span>
                                                    </div>

                                                    @* Portion Counter *@
                                                    <div class="md:col-span-1 text-right">
                                                        <div class="font-mono font-bold text-base text-gray-900 leading-none">@task.Portions</div>
                                                        <span class="block text-[8px] font-mono uppercase tracking-widest text-gray-400 mt-1">Total</span>
                                                        @if (task.StaffPortions > 0)
                                                        {
                                                            <span class="block text-[8px] font-mono text-gray-500">(@task.StudentPortions + @task.StaffPortions)</span>
                                                        }
                                                    </div>

                                                    @* Status Indicator *@
                                                    <div class="md:col-span-2 text-right">
                                                        @if (!task.HasRecipe)
                                                        {
                                                            <span class="inline-flex items-center text-[8px] font-bold uppercase tracking-widest bg-yellow-50 text-yellow-800 border border-yellow-200 px-2.5 py-1">No Recipe</span>
                                                        }
                                                        else if (problemCount > 0)
                                                        {
                                                            <span class="inline-flex items-center text-[8px] font-bold uppercase tracking-widest bg-red-50 text-[#C21E2E] border border-red-200 px-2.5 py-1">@problemCount Problem(s)</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="inline-flex items-center text-[8px] font-bold uppercase tracking-widest bg-green-50 text-green-700 border border-green-200 px-2.5 py-1">Ready</span>
                                                        }
                                                    </div>
                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(task.Instructions))
                                                {
                                                    <div class="mt-3 p-3 bg-gray-50 border-l-2 border-l-gray-400 border border-gray-200 text-xs font-serif text-gray-700 whitespace-pre-line">
                                                        @task.Instructions
                                                    </div>
                                                }

                                                @if (task.Ingredients.Any())
                                                {
                                                    <div class="mt-3 pt-2.5 border-t border-dashed border-gray-200">
                                                        <button type="button" class="text-[9px] font-mono font-bold uppercase tracking-widest text-[#C21E2E] hover:underline cursor-pointer bg-transparent border-0 p-0" onclick="toggleBom(this)">
                                                            ▸ Show Ingredients (@task.Ingredients.Count)
                                                        </button>

                                                        <div class="pp-bom hidden mt-2.5">
                                                            <table class="table table-sm align-middle mb-0 w-full text-xs border border-gray-200">
                                                                <thead class="bg-gray-100">
                                                                    <tr class="text-[8px] uppercase tracking-widest font-bold text-gray-500 border-b border-gray-200">
                                                                        <th class="ps-3 py-1.5">Ingredient</th>
                                                                        <th class="text-end">Per Portion</th>
                                                                        <th class="text-end">For @task.Portions</th>
                                                                        <th class="text-end">Available</th>
                                                                        <th class="pe-3 text-end">Status</th>
                                                                    </tr>
                                                                </thead>
                                                                <tbody class="text-gray-700">
                                                                    @foreach (var ing in task.Ingredients)
                                                                    {
                                                                        <tr class="border-b border-gray-100 last:border-0 hover:bg-gray-50/50">
                                                                            <td class="ps-3 py-1 font-serif">@ing.IngredientName</td>
                                                                            <td class="text-end font-mono text-gray-500">@KitchenQuantity.Format(ing.QuantityPerPortion, ing.Unit)</td>
                                                                            <td class="text-end font-mono font-bold text-gray-900">@KitchenQuantity.Format(ing.TotalRequired, ing.Unit)</td>
                                                                            <td class="text-end font-mono text-gray-500">@KitchenQuantity.Format(ing.StockAvailable, ing.Unit)</td>
                                                                            <td class="pe-3 text-end">@Availability(ing)</td>
                                                                        </tr>
                                                                    }
                                                                </tbody>
                                                            </table>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    </div>
                                }

                                @if (slot.NotSelectedOptions.Any())
                                {
                                    <div class="text-[9px] font-mono text-gray-400 uppercase tracking-widest mt-1">
                                        Not chosen by students: @string.Join(", ", slot.NotSelectedOptions)
                                    </div>
                                }
                                @if (slot.StudentsWithoutPick > 0)
                                {
                                    <div class="text-[9px] font-mono text-amber-700 uppercase tracking-widest mt-0.5">
                                        @slot.StudentsWithoutPick student(s) with submitted plans omitted selections here.
                                    </div>
                                }

                                @if (slot.Ingredients.Any())
                                {
                                    <div class="mt-3 pt-3 border-t border-gray-200">
                                        <h6 class="text-[9px] uppercase tracking-[3px] font-bold text-gray-500 mb-2">@slot.MealSlot Ingredient Totals</h6>
                                        @CheckTable(slot.Ingredients, true)
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                @* Day Totals Footer *@
                @if (day.DayTotalIngredients.Any())
                {
                    <div class="p-6 bg-gray-100 border-t-2 border-gray-200">
                        <h6 class="text-[10px] uppercase tracking-[3px] font-bold text-gray-800 mb-3">Day Total Ingredients — @day.Date.ToString("dddd")</h6>
                        @CheckTable(day.DayTotalIngredients, true)
                    </div>
                }
            </div>
        }

        @* --- FULL WEEK AGGREGATE LEDGER --- *@
        @if (Model.WeekTotalIngredients.Any())
        {
            <div class="bg-white border-2 border-gray-200 shadow-md flex flex-col relative overflow-hidden">
                <div class="p-5 bg-[#1a1a1a] text-white flex justify-between items-center border-b-2 border-b-[#C21E2E]">
                    <div>
                        <h5 class="text-[10px] uppercase tracking-[4px] font-bold mb-0">Week Aggregate — All Ingredients</h5>
                        <span class="text-[8px] font-mono text-gray-400 uppercase tracking-widest mt-0.5 block">Sum total of every planned meal versus current stock</span>
                    </div>
                </div>
                <div class="p-6 bg-gray-50">
                    @CheckTable(Model.WeekTotalIngredients, false)
                </div>
            </div>
        }

        @* --- STICKY CHEF CONFIRMATION ACTION BAR --- *@
        @if (!Model.IsProductionConfirmed)
        {
            <div class="fixed bottom-0 left-0 right-0 bg-white/95 backdrop-blur-md border-t border-gray-200 p-4 md:px-8 z-50 shadow-[0_-10px_30px_rgba(0,0,0,0.05)] flex flex-col md:flex-row justify-between items-center gap-4 transition-all">
                <div class="text-[10px] font-mono uppercase tracking-widest text-gray-500">
                    <strong class="text-gray-900 text-xs">Chef Authorization.</strong>
                    @if (problems.Any())
                    {
                        <span class="text-[#C21E2E] font-bold block md:inline md:ms-2">@problems.Count ingredient problem(s) still open.</span>
                    }
                    else
                    {
                        <span class="block md:inline md:ms-2">Review requirements before finalizing execution.</span>
                    }
                </div>

                <form action="@Url.Action("ConfirmProduction", "Cafeteria", new { id = Model.MenuId })" method="post" class="m-0 w-full md:w-auto">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="w-full md:w-auto bg-[#10b981] border-2 border-[#10b981] text-white px-8 py-3.5 text-[10px] font-bold uppercase tracking-[2px] hover:bg-green-600 hover:border-green-600 hover:shadow-[0_0_15px_rgba(16,185,129,0.3)] transition-all shadow-sm" onclick="return confirm('@(problems.Any() ? "Some ingredients are insufficient or not available. Confirm the kitchen plan anyway?" : "Confirm the kitchen plan for this week?")');">
                        Confirm Kitchen Plan
                    </button>
                </form>
            </div>
        }
        else
        {
            <div class="fixed bottom-0 left-0 right-0 bg-gray-100 border-t border-gray-200 p-4 md:px-8 z-50 text-center">
                <span class="text-[10px] font-mono uppercase tracking-widest text-gray-700 font-bold">
                    <i class="bi bi-shield-check me-1 text-[#10b981]"></i> Kitchen Plan Confirmed
                    @if (Model.ConfirmedAt.HasValue)
                    {
                        <text>on @Michaelhouse.Services.SchoolClock.FromUtc(Model.ConfirmedAt.Value).ToString("dd MMM yyyy HH:mm")</text>
                    }
                    @if (problems.Any())
                    {
                        <span class="text-[#C21E2E] ms-2">(@problems.Count open ingredient problems remaining)</span>
                    }
                </span>
            </div>
        }

    </div>
</div>

<style>
    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }

    .font-mono {
        font-family: 'Source Code Pro', monospace !important;
    }

    .table thead th {
        border-bottom: 2px solid #e5e7eb !important;
    }

    .custom-scrollbar::-webkit-scrollbar {
        width: 5px;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #d1d5db;
        border-radius: 10px;
    }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #C21E2E;
        }
</style>

@section Scripts {
    <script>
        function toggleBom(el) {
            var bom = el.parentElement.querySelector('.pp-bom');
            if (!bom) return;

            var isHidden = bom.classList.contains('hidden');
            if (isHidden) {
                bom.classList.remove('hidden');
            } else {
                bom.classList.add('hidden');
            }

            var count = el.textContent.match(/\d+/);
            var n = count ? count[0] : '';
            el.textContent = (isHidden ? '▾ Hide' : '▸ Show') + ' Ingredients (' + n + ')';
        }
    </script>
}
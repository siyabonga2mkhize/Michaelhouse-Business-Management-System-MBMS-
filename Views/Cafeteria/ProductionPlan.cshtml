@using System.Linq
@using Michaelhouse.Models.ViewModels
@model ProductionPlanViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Kitchen Plan";
}

<style>
    .pp-shell {
        max-width: 1200px;
        margin: 0 auto;
    }

    .pp-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        padding-bottom: 1.25rem;
        margin-bottom: 1.5rem;
        border-bottom: 1px solid #eaeaea;
    }

        .pp-header h1 {
            font-size: 1.9rem;
            margin: 0 0 .35rem 0;
        }

    .pp-meta {
        color: #888;
        font-size: .82rem;
    }

        .pp-meta strong {
            color: #333;
        }

    .pp-day {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        margin-bottom: 1.25rem;
        overflow: hidden;
    }

    .pp-day-header {
        padding: .85rem 1.25rem;
        background: #f9fafb;
        border-bottom: 1px solid #e5e7eb;
        font-weight: 700;
        font-size: .95rem;
        display: flex;
        justify-content: space-between;
    }

        .pp-day-header .count {
            font-size: .78rem;
            color: #6b7280;
            font-weight: 500;
        }

    .pp-slot {
        padding: 1rem 1.25rem;
        border-bottom: 1px solid #f3f4f6;
    }

        .pp-slot:last-child {
            border-bottom: none;
        }

    .pp-slot-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: .85rem;
    }

    .pp-slot-name {
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: #6b7280;
    }

    .pp-serve {
        font-size: .8rem;
        color: #4b5563;
        font-weight: 600;
    }

        .pp-serve strong {
            color: #C21E2E;
        }

    .pp-task {
        background: #fafafa;
        border: 1px solid #f3f4f6;
        border-radius: 8px;
        padding: .85rem .95rem;
        margin-bottom: .5rem;
    }

    .pp-task-top {
        display: grid;
        grid-template-columns: 100px 80px 1fr 100px 80px 80px;
        gap: .75rem;
        align-items: center;
        margin-bottom: .55rem;
    }

    .pp-time-cell {
        font-family: 'Courier New', monospace;
        font-weight: 700;
        color: #111827;
        font-size: .85rem;
    }

        .pp-time-cell small {
            display: block;
            font-size: .62rem;
            color: #9ca3af;
            font-weight: 500;
            letter-spacing: .04em;
            text-transform: uppercase;
        }

    .pp-dish {
        font-weight: 600;
        font-size: .92rem;
        color: #111827;
    }

    .pp-dish-meta {
        font-size: .72rem;
        color: #9ca3af;
        margin-top: 2px;
    }

    .pp-station {
        display: inline-block;
        padding: .2rem .55rem;
        border-radius: 4px;
        font-size: .68rem;
        font-weight: 700;
        letter-spacing: .04em;
        text-transform: uppercase;
    }

        .pp-station.gr {
            background: #fee2e2;
            color: #991b1b;
        }

        .pp-station.st {
            background: #dbeafe;
            color: #1e40af;
        }

        .pp-station.ov {
            background: #fef3c7;
            color: #92400e;
        }

        .pp-station.cp {
            background: #d1fae5;
            color: #065f46;
        }

        .pp-station.ln {
            background: #f3f4f6;
            color: #4b5563;
        }

    .pp-bom-toggle {
        font-size: .72rem;
        color: #C21E2E;
        font-weight: 600;
        cursor: pointer;
        user-select: none;
        display: inline-block;
    }

        .pp-bom-toggle:hover {
            text-decoration: underline;
        }

    .pp-bom {
        margin-top: .6rem;
        padding-top: .6rem;
        border-top: 1px dashed #e5e7eb;
    }

        .pp-bom table {
            width: 100%;
            font-size: .78rem;
            border-collapse: collapse;
        }

        .pp-bom th {
            text-align: left;
            font-size: .65rem;
            font-weight: 700;
            letter-spacing: .06em;
            text-transform: uppercase;
            color: #9ca3af;
            padding: .35rem 0;
            border-bottom: 1px solid #f3f4f6;
        }

        .pp-bom td {
            padding: .4rem 0;
            border-bottom: 1px solid #f3f4f6;
            color: #4b5563;
        }

            .pp-bom td.num {
                text-align: right;
                font-weight: 600;
                color: #111827;
            }

            .pp-bom td.unit {
                color: #9ca3af;
                padding-left: .35rem;
            }

        .pp-bom tr:last-child td {
            border-bottom: none;
        }

    .stock-ok {
        color: #065f46;
        font-weight: 700;
    }

    .stock-low {
        color: #991b1b;
        font-weight: 700;
    }

    /* ── UC12: per-house breakdown ───────────────────────────── */
    .pp-houses {
        margin-top: .65rem;
        padding-top: .65rem;
        border-top: 1px dashed #e5e7eb;
    }

    .pp-houses-title {
        font-size: .7rem;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: #6b7280;
        margin-bottom: .5rem;
    }

    .pp-events {
        color: #C21E2E;
        text-transform: none;
        letter-spacing: 0;
        font-weight: 600;
        margin-left: .4rem;
    }

    .pp-house-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
        gap: .5rem;
    }

    .pp-house {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 6px;
        padding: .5rem .65rem;
    }

    .pp-house-name {
        font-size: .75rem;
        font-weight: 600;
        color: #374151;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .pp-house-count {
        font-size: 1.1rem;
        font-weight: 700;
        color: #C21E2E;
        line-height: 1.1;
        margin: .15rem 0;
    }

    .pp-house-detail {
        font-size: .65rem;
        color: #9ca3af;
    }

    .pp-day-total {
        margin-top: .75rem;
        padding: .75rem 1rem;
        background: #f9fafb;
        border-radius: 8px;
        border: 1px solid #e5e7eb;
    }

    .pp-day-total-title {
        font-size: .72rem;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: #6b7280;
        margin-bottom: .35rem;
    }

    .pp-day-total table {
        width: 100%;
        font-size: .78rem;
    }

    .pp-day-total td {
        padding: .3rem 0;
        color: #4b5563;
    }

        .pp-day-total td.num {
            text-align: right;
            font-weight: 600;
            color: #111827;
        }

        .pp-day-total td.unit {
            color: #9ca3af;
            padding-left: .35rem;
        }

    .pp-week-total {
        margin-top: 2rem;
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        overflow: hidden;
    }

    .pp-week-total-header {
        padding: .85rem 1.25rem;
        background: #f9fafb;
        border-bottom: 1px solid #e5e7eb;
        font-weight: 700;
    }

    .pp-week-total-table {
        width: 100%;
        font-size: .85rem;
        border-collapse: collapse;
    }

        .pp-week-total-table th {
            text-align: left;
            padding: .65rem 1.25rem;
            font-size: .68rem;
            font-weight: 700;
            letter-spacing: .06em;
            text-transform: uppercase;
            color: #6b7280;
            background: #f9fafb;
            border-bottom: 1px solid #e5e7eb;
        }

        .pp-week-total-table td {
            padding: .55rem 1.25rem;
            border-bottom: 1px solid #f3f4f6;
        }

            .pp-week-total-table td.num {
                text-align: right;
                font-weight: 600;
            }

        .pp-week-total-table tr:last-child td {
            border-bottom: none;
        }

    .pp-actions {
        position: sticky;
        bottom: 0;
        background: rgba(255,255,255,0.96);
        backdrop-filter: blur(8px);
        border-top: 1px solid #e5e7eb;
        padding: 1rem 1.25rem;
        margin: 2rem -1.5rem -1.5rem -1.5rem;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .pp-actions .info {
            font-size: .82rem;
            color: #6b7280;
        }

            .pp-actions .info strong {
                color: #111827;
            }

    /* ── Kitchen plan: availability ─────────────────────────── */
    .av {
        display: inline-block;
        font-size: .68rem;
        font-weight: 700;
        padding: .15rem .5rem;
        border-radius: 999px;
        white-space: nowrap;
    }

        .av.ok {
            background: #d1fae5;
            color: #065f46;
        }

        .av.short {
            background: #fef3c7;
            color: #92400e;
        }

        .av.none {
            background: #fee2e2;
            color: #991b1b;
        }

    .pp-check {
        width: 100%;
        font-size: .8rem;
        border-collapse: collapse;
        margin-top: .5rem;
    }

        .pp-check th {
            text-align: left;
            font-size: .66rem;
            text-transform: uppercase;
            letter-spacing: .04em;
            color: #6b7280;
            padding: .35rem .5rem;
            border-bottom: 1px solid #e5e7eb;
        }

        .pp-check td {
            padding: .35rem .5rem;
            border-bottom: 1px solid #f3f4f6;
            vertical-align: top;
        }

        .pp-check .num {
            text-align: right;
            white-space: nowrap;
        }

        .pp-check .meals {
            color: #6b7280;
            font-size: .72rem;
        }

    .pp-warnings {
        border-radius: 10px;
        padding: 1rem 1.25rem;
        margin-bottom: 1.25rem;
    }

        .pp-warnings.bad {
            background: #fef2f2;
            border: 1px solid #fecaca;
        }

        .pp-warnings.good {
            background: #ecfdf5;
            border: 1px solid #a7f3d0;
        }

        .pp-warnings ul {
            margin: .5rem 0 0 0;
            padding-left: 1.1rem;
            font-size: .85rem;
        }

        .pp-warnings li {
            margin-bottom: .35rem;
        }

        .pp-warnings .when {
            font-weight: 700;
        }

        .pp-warnings .affects {
            display: block;
            color: #6b7280;
            font-size: .76rem;
        }

    .pp-instructions {
        font-size: .76rem;
        color: #374151;
        background: #f9fafb;
        border-radius: 6px;
        padding: .4rem .6rem;
        margin: .25rem 0 .35rem 0;
        white-space: pre-line;
    }

    .pp-not-chosen {
        font-size: .76rem;
        color: #6b7280;
        margin-top: .35rem;
    }

    .pp-final {
        font-size: .72rem;
        font-weight: 600;
    }
</style>

@helper Availability(IngredientLineViewModel line)
{
    if (line.Status == IngredientAvailability.Available)
    {
        <span class="av ok">Available</span>
    }
    else if (line.Status == IngredientAvailability.Insufficient)
    {
        <span class="av short">Insufficient</span>
    }
    else
    {
        <span class="av none">Not available</span>
    }
}

@helper CheckTable(IEnumerable<IngredientLineViewModel> lines, bool showMeals)
{
    <table class="pp-check">
        <thead>
            <tr>
                <th>Ingredient</th>
                <th class="num">Required</th>
                <th class="num">Available</th>
                <th>Status</th>
                @if (showMeals)
                {
                    <th>Needed for</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var line in lines)
            {
                <tr>
                    <td>@line.IngredientName</td>
                    <td class="num">@KitchenQuantity.Format(line.TotalRequired, line.Unit)</td>
                    <td class="num">@KitchenQuantity.Format(line.StockAvailable, line.Unit)</td>
                    <td>
                        @Availability(line)
                        @if (line.Status == IngredientAvailability.Insufficient)
                        {
                            <span class="stock-low" style="font-size:.7rem;">short @KitchenQuantity.Format(line.Shortfall, line.Unit)</span>
                        }
                    </td>
                    @if (showMeals)
                    {
                        <td class="meals">@string.Join(", ", line.AffectedMeals)</td>
                    }
                </tr>
            }
        </tbody>
    </table>
}

@{
    var problems = Model.Warnings.Where(w => w.Severity != KitchenWarningSeverity.Info)
        .OrderByDescending(w => w.Severity)
        .ToList();
    var notes = Model.Warnings.Where(w => w.Severity == KitchenWarningSeverity.Info).ToList();
}

<div class="container-fluid py-4">
    <div class="pp-shell">

        <div class="pp-header">
            <div>
                <h1>Kitchen Plan</h1>
                <div class="pp-meta">
                    @Model.WeekStart.ToString("dd MMM") – @Model.WeekEnd.ToString("dd MMM yyyy")
                    &nbsp;·&nbsp;
                    <strong>@Model.TotalMeals</strong> portions to prepare
                    &nbsp;·&nbsp;
                    from <strong>@Model.SubmittedPlanCount</strong> of <strong>@Model.StudentCount</strong> students' submitted meal plans
                </div>
            </div>
            <div class="d-flex gap-2 align-items-center">
                @if (Model.HasIngredientProblems)
                {
                    <span class="badge bg-danger fs-6">@problems.Count ingredient problem(s)</span>
                }
                else if (Model.TotalMeals > 0)
                {
                    <span class="badge bg-success fs-6">Ingredients available</span>
                }
                @if (Model.IsProductionConfirmed)
                {
                    <span class="badge bg-success fs-6">Confirmed</span>
                }
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success">@TempData["SuccessMessage"]</div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
        }

        @if (!Model.IsMenuPublished)
        {
            <div class="alert alert-warning">
                This menu hasn't been published, so students can't choose from it yet. The kitchen plan fills in as students submit meal plans.
            </div>
        }
        else if (Model.SubmittedPlanCount == 0)
        {
            <div class="alert alert-info">
                No student has submitted a meal plan for this week yet, so there is nothing to prepare.
            </div>
        }

        <div class="alert alert-light border small">
            Portions are the number of students who chose each meal in their <strong>submitted</strong> meal plans.
            @if (Model.StaffMeals > 0)
            {
                <span>The menu's <strong>@Model.StaffMeals</strong> staff meals per meal are added to that meal's most chosen dish.</span>
            }
            @if (Model.UnsubmittedPlansWithPicks > 0)
            {
                <span><strong>@Model.UnsubmittedPlansWithPicks</strong> student(s) have chosen meals but not submitted — they aren't counted.</span>
            }
            Availability compares what's required with the ingredient stock on record; nothing is reserved or deducted.
        </div>

        @* ── Readiness ─────────────────────────────────────────── *@
        @if (problems.Any())
        {
            <div class="pp-warnings bad">
                <strong><i class="bi bi-exclamation-triangle me-1"></i>Not ready: some ingredients may stop meals being prepared.</strong>
                <ul>
                    @foreach (var w in problems)
                    {
                        <li>
                            <span class="when">@w.When:</span> @w.Message
                            <span class="affects">Affects: @string.Join(", ", w.AffectedMeals)</span>
                        </li>
                    }
                </ul>
            </div>
        }
        else if (Model.TotalMeals > 0)
        {
            <div class="pp-warnings good">
                <strong><i class="bi bi-check-circle me-1"></i>All ingredients for the chosen meals are available.</strong>
            </div>
        }

        @if (notes.Any())
        {
            <div class="alert alert-secondary small">
                @foreach (var n in notes)
                {
                    <div><strong>@n.When:</strong> @n.Message</div>
                }
            </div>
        }

        @foreach (var day in Model.Days)
        {
            <div class="pp-day">
                <div class="pp-day-header">
                    <span>@day.Date.ToString("dddd, dd MMMM yyyy")</span>
                    @if (day.SelectionsFinal)
                    {
                        <span class="pp-final text-success"><i class="bi bi-lock"></i> Selections final</span>
                    }
                    else
                    {
                        <span class="pp-final text-warning">Students can change these meals until the end of @day.SelectionCutoff.AddDays(-1).ToString("ddd dd MMM")</span>
                    }
                    @if (day.IsIssued)
                    {
                        <a class="pp-final text-success" href="@Url.Action("IssueIngredients", "Cafeteria", new { id = Model.MenuId, date = day.Date.ToString("yyyy-MM-dd") })">
                            <i class="bi bi-box-seam"></i> Ingredients issued@(day.IssuedAt.HasValue ? " " + Michaelhouse.Services.SchoolClock.FromUtc(day.IssuedAt.Value).ToString("ddd HH:mm") : "")@(day.IssuedBy != null ? " by " + day.IssuedBy : "")
                        </a>
                    }
                    else if (day.Slots.Any(s => s.Tasks.Any()))
                    {
                        <a class="btn btn-sm btn-outline-secondary" href="@Url.Action("IssueIngredients", "Cafeteria", new { id = Model.MenuId, date = day.Date.ToString("yyyy-MM-dd") })">
                            <i class="bi bi-box-seam"></i> Issue ingredients
                        </a>
                    }
                </div>

                @foreach (var slot in day.Slots)
                {
                    <div class="pp-slot">
                        <div class="pp-slot-header">
                            <span class="pp-slot-name">@slot.MealSlot</span>
                            <span class="pp-serve">
                                Serve at <strong>@slot.ServeTime.ToString(@"hh\:mm")</strong>
                                · <strong>@slot.Portions</strong> portions
                            </span>
                        </div>

                        @if (!slot.Tasks.Any())
                        {
                            <div class="text-muted small">No student has chosen a meal here yet — nothing to prepare.</div>
                        }

                        @foreach (var task in slot.Tasks)
                        {
                            var stClass = "ln";
                            if (task.Station == "Grill") { stClass = "gr"; }
                            else if (task.Station == "Stove") { stClass = "st"; }
                            else if (task.Station == "Oven") { stClass = "ov"; }
                            else if (task.Station == "Cold Prep") { stClass = "cp"; }

                            var problemCount = task.Ingredients.Count(i => i.Status != IngredientAvailability.Available);

                            <div class="pp-task">
                                <div class="pp-task-top">
                                    <div class="pp-time-cell">
                                        @task.StartTime.ToString(@"hh\:mm")
                                        <small>Start</small>
                                    </div>
                                    <div class="pp-time-cell">
                                        @task.ReadyTime.ToString(@"hh\:mm")
                                        <small>Ready</small>
                                    </div>
                                    <div>
                                        <div class="pp-dish">@task.DishName</div>
                                        <div class="pp-dish-meta">
                                            @task.PrepMinutes min prep + @task.CookMinutes min cook
                                        </div>
                                    </div>
                                    <div><span class="pp-station @stClass">@task.Station</span></div>
                                    <div style="text-align:right; font-size:.9rem; font-weight:700;">
                                        @task.Portions
                                        <small style="display:block; font-size:.62rem; color:#9ca3af; text-transform:uppercase; letter-spacing:.04em; font-weight:400;">portions</small>
                                        @if (task.StaffPortions > 0)
                                        {
                                            <small style="display:block; font-size:.62rem; color:#6b7280; font-weight:400;">@task.StudentPortions students + @task.StaffPortions staff</small>
                                        }
                                    </div>
                                    <div style="text-align:right; font-size:.75rem;">
                                        @if (!task.HasRecipe)
                                        {
                                            <span class="av short">No recipe</span>
                                        }
                                        else if (problemCount > 0)
                                        {
                                            <span class="av none">@problemCount problem(s)</span>
                                        }
                                        else
                                        {
                                            <span class="av ok">Ready</span>
                                        }
                                    </div>
                                </div>

                                @if (!string.IsNullOrWhiteSpace(task.Instructions))
                                {
                                    <div class="pp-instructions">@task.Instructions</div>
                                }

                                @if (task.Ingredients.Any())
                                {
                                    <span class="pp-bom-toggle" onclick="toggleBom(this)">▸ Show ingredients (@task.Ingredients.Count)</span>

                                    <div class="pp-bom" style="display:none;">
                                        <table>
                                            <thead>
                                                <tr>
                                                    <th>Ingredient</th>
                                                    <th style="text-align:right;">Per portion</th>
                                                    <th style="text-align:right;">For @task.Portions portions</th>
                                                    <th style="text-align:right;">Available</th>
                                                    <th style="text-align:right;">Status</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var ing in task.Ingredients)
                                                {
                                                    <tr>
                                                        <td>@ing.IngredientName</td>
                                                        <td class="num">@KitchenQuantity.Format(ing.QuantityPerPortion, ing.Unit)</td>
                                                        <td class="num">@KitchenQuantity.Format(ing.TotalRequired, ing.Unit)</td>
                                                        <td class="num">@KitchenQuantity.Format(ing.StockAvailable, ing.Unit)</td>
                                                        <td class="num">@Availability(ing)</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            </div>
                        }

                        @if (slot.NotSelectedOptions.Any())
                        {
                            <div class="pp-not-chosen">
                                Not chosen by anyone — nothing to prepare: @string.Join(", ", slot.NotSelectedOptions)
                            </div>
                        }
                        @if (slot.StudentsWithoutPick > 0)
                        {
                            <div class="pp-not-chosen">
                                @slot.StudentsWithoutPick student(s) with a submitted plan didn't choose a meal here.
                            </div>
                        }

                        @if (slot.Ingredients.Any())
                        {
                            <div class="mt-2">
                                <div style="font-size:.72rem; font-weight:700; text-transform:uppercase; letter-spacing:.04em; color:#374151;">
                                    @slot.MealSlot ingredients — total for this meal
                                </div>
                                @CheckTable(slot.Ingredients, true)
                            </div>
                        }
                    </div>
                }

                @if (day.DayTotalIngredients.Any())
                {
                    <div class="pp-slot" style="background:#fcfcfc;">
                        <div class="pp-day-total">
                            <div class="pp-day-total-title">Day total — @day.Date.ToString("dddd")</div>
                            @CheckTable(day.DayTotalIngredients, true)
                        </div>
                    </div>
                }
            </div>
        }

        @if (Model.WeekTotalIngredients.Any())
        {
            <div class="pp-week-total">
                <div class="pp-week-total-header">
                    Week total — all ingredients
                    <span class="text-muted small ms-2">Every chosen meal this week together, compared with current stock.</span>
                </div>
                <div style="padding: 0 1.25rem 1rem 1.25rem;">
                    @CheckTable(Model.WeekTotalIngredients, false)
                </div>
            </div>
        }

        @if (!Model.IsProductionConfirmed)
        {
            <div class="pp-actions">
                <div class="info">
                    <strong>Chef confirmation.</strong>
                    @if (problems.Any())
                    {
                        <span class="text-danger">@problems.Count ingredient problem(s) still open.</span>
                    }
                    else
                    {
                        <span>Review the plan, then confirm.</span>
                    }
                </div>
                <form action="@Url.Action("ConfirmProduction", "Cafeteria", new { id = Model.MenuId })" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit"
                            class="btn @(problems.Any() ? "btn-outline-danger" : "btn-success") btn-lg"
                            onclick="return confirm('@(problems.Any() ? "Some ingredients are insufficient or not available. Confirm the kitchen plan anyway?" : "Confirm the kitchen plan for this week?")');">
                        Confirm Kitchen Plan
                    </button>
                </form>
            </div>
        }
        else
        {
            <div class="alert @(problems.Any() ? "alert-warning" : "alert-success") mt-4">
                <strong>Kitchen plan confirmed</strong>
                @if (Model.ConfirmedAt.HasValue)
                {
                    <text>on @Michaelhouse.Services.SchoolClock.FromUtc(Model.ConfirmedAt.Value).ToString("dd MMM yyyy HH:mm")</text>
                }
                @if (problems.Any())
                {
                    <text> — but @problems.Count ingredient problem(s) are still open.</text>
                }
            </div>
        }

        <div class="mt-4">
            <a href="@Url.Action("ChefIndex", "Cafeteria")" class="btn btn-outline-secondary">
                ← Back to Kitchen
            </a>
        </div>

    </div>
</div>

<script>
    function toggleBom(el) {
        var bom = el.parentElement.querySelector('.pp-bom');
        if (!bom) return;

        var isOpen = bom.style.display !== 'none';
        bom.style.display = isOpen ? 'none' : 'block';

        var count = el.textContent.match(/\d+/);
        var n = count ? count[0] : '';
        el.textContent = (isOpen ? '▸' : '▾') + ' ' + (isOpen ? 'Show' : 'Hide') + ' ingredients (' + n + ')';
    }
</script>

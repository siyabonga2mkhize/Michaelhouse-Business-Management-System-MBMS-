@model List<Michaelhouse.Models.AttendanceRecordViewModel>
@{
    var subject = ViewBag.Subject as Michaelhouse.Models.Subject;
    ViewBag.Title = $"Attendance Records – {subject.Name}";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Attendance Register – @subject.Name</h2>
        <a href="@Url.Action("Index", "Attendances")" class="btn btn-outline-secondary">Back to Subjects</a>
    </div>

    @using (Html.BeginForm("ViewRegister", "Attendances", FormMethod.Get, new { @class = "row g-3 mb-4 align-items-end" }))
    {
        <input type="hidden" name="subjectId" value="@subject.SubjectId" />
        <div class="col-md-3">
            <label class="form-label">Student</label>
            <select name="studentId" class="form-select">
                <option value="">All Students</option>
                @foreach (var s in ViewBag.Students as List<Michaelhouse.Models.Student>)
                {
                    <option value="@s.StudentId" @((ViewBag.SelectedStudentId == s.StudentId) ? "selected=\"selected\"" : "")>@s.FirstName @s.LastName</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label">From Date</label>
            <input type="date" name="fromDate" class="form-control" value="@(ViewBag.FromDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-2">
            <label class="form-label">To Date</label>
            <input type="date" name="toDate" class="form-control" value="@(ViewBag.ToDate?.ToString("yyyy-MM-dd"))" />
        </div>
        <div class="col-md-2">
            <button type="submit" class="btn btn-primary">Filter</button>
        </div>
        <div class="col-md-2">
            <a href="@Url.Action("ViewRegister", new { subjectId = subject.SubjectId })" class="btn btn-secondary">Reset</a>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>Student</th>
                    <th>Status</th>
                    <th>Recorded By</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    foreach (var att in Model)
                    {
                        <tr>
                            <td>@att.Date.ToString("dd MMM yyyy")</td>
                            <td>
                                @att.StudentName
                        </td>
                        <td>
                            @if (att.Status == Michaelhouse.Models.AttendanceStatus.Present)
                            {
                                <span class="badge bg-success">Present</span>
                            }
                            else if (att.Status == Michaelhouse.Models.AttendanceStatus.Absent)
                            {
                                <span class="badge bg-danger">Absent</span>
                            }
                            else if (att.Status == Michaelhouse.Models.AttendanceStatus.Late)
                            {
                                <span class="badge bg-warning text-dark">Late</span>
                            }
                        </td>
                        <td>
                            @att.RecordedBy
                    </td>
                </tr>
            }
        }
        else
        {
            <tr>
                <td colspan="4" class="text-center text-muted">No attendance records found.</td>
            </tr>
        }
            </tbody>
        </table>
    </div>
</div>
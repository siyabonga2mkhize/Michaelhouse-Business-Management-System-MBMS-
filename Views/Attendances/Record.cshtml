@model IEnumerable<Michaelhouse.Models.Student>

@{
    ViewData["Title"] = "Record Student Attendance";
}

<div class="container">
    <h2 class="text-danger">Record Attendance: @ViewBag.SubjectName</h2>
    <p class="text-muted">Date: @DateTime.Today.ToShortDateString()</p>

    <form asp-action="Save" method="post">
        <input type="hidden" name="subjectId" value="@ViewBag.SubjectId" />

        <table class="table table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Student Number</th>
                    <th>Full Name</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @{ int i = 0; }
                @foreach (var student in Model)
                {
                    <tr>
                        <td>@student.StudentNumber</td>
                        <td>@student.FullName</td>
                        <td>
                            <div class="btn-group" role="group">
                                <input type="radio" class="btn-check" name="attendanceRecords[@student.StudentId]" 
                                       id="present_@student.StudentId" value="Present" checked>
                                <label class="btn btn-outline-success" for="present_@student.StudentId">Present</label>

                                <input type="radio" class="btn-check" name="attendanceRecords[@student.StudentId]" 
                                       id="absent_@student.StudentId" value="Absent">
                                <label class="btn btn-outline-danger" for="absent_@student.StudentId">Absent</label>

                                <input type="radio" class="btn-check" name="attendanceRecords[@student.StudentId]" 
                                       id="late_@student.StudentId" value="Late">
                                <label class="btn btn-outline-warning" for="late_@student.StudentId">Late</label>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="form-group mt-3">
            <button type="submit" class="btn btn-primary btn-lg">Submit Attendance</button>
            <a asp-action="Index" asp-controller="Home" class="btn btn-secondary btn-lg">Cancel</a>
        </div>
    </form>
</div>
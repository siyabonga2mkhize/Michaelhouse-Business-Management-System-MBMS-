@model Michaelhouse.Models.MarkAttendanceViewModel
@{
    ViewBag.Title = "Mark Register – " + Model.SubjectName;
}

@* --- FULL SCREEN VIEWPORT CONTAINER --- *@
<div class="flex flex-col h-full w-full overflow-hidden">

    @* --- INSTITUTIONAL HEADER --- *@
    <div class="mb-6 d-flex justify-content-between align-items-end border-b border-gray-100 pb-6 flex-shrink-0 px-8 pt-8">
        <div>
            <div class="flex items-center gap-2 mb-3">
                <div class="h-[2px] w-8 bg-[#C21E2E]"></div>
                <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Academic Registry</h5>
            </div>
            <h2 class="text-5xl font-serif font-bold text-[#C21E2E] tracking-tight">@Model.SubjectName</h2>
            <p class="text-[11px] font-mono text-gray-400 uppercase tracking-widest mt-2 mb-0">Record for @Model.Date.ToString("dddd, dd MMMM yyyy")</p>
        </div>
        <div class="flex gap-3">
            <a href="@Url.Action("Index", "Attendances")" class="inline-block bg-white border border-gray-200 px-6 py-2 text-[9px] font-bold uppercase tracking-[2px] hover:bg-gray-50 transition-all shadow-sm text-gray-600">
                <i class="bi bi-arrow-left me-2"></i> Return to Subjects
            </a>
        </div>
    </div>

    @* --- SCROLLABLE DATA SECTION --- *@
    @using (Html.BeginForm("SaveRegister", "Attendances", FormMethod.Post, new { @class = "flex flex-col flex-grow min-h-0 px-8 pb-8" }))
    {
        @Html.AntiForgeryToken()
        <input type="hidden" name="SubjectId" value="@Model.SubjectId" />
        <input type="hidden" name="Date" value="@Model.Date.ToString("yyyy-MM-dd")" />

        <div class="bg-white shadow-sm border border-gray-100 overflow-hidden relative flex flex-col flex-grow min-h-0">

            @* Archival Dot Grid Header & Bulk Controls *@
            <div class="p-6 border-b border-gray-100 d-flex justify-content-between align-items-center relative bg-white overflow-hidden flex-shrink-0">
                <div class="absolute inset-0 opacity-[0.05] pointer-events-none"
                     style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 20px 20px;"></div>

                <div class="relative z-10">
                    <h5 class="text-[11px] uppercase tracking-[4px] font-bold text-gray-900 mb-1">Official Attendance Roster</h5>
                    <p class="text-[9px] text-gray-400 font-bold uppercase tracking-widest mb-0 font-mono">Cohort Size: @Model.Students.Count Students</p>
                </div>

                <div class="relative z-10 flex gap-2">
                    <button type="button" onclick="markAll('Present')" class="bg-green-50 text-green-700 border border-green-200 px-4 py-2 text-[9px] font-bold uppercase tracking-[2px] hover:bg-green-100 transition-all shadow-sm">
                        <i class="bi bi-check-all me-1"></i> Mark All Present
                    </button>
                    <button type="button" onclick="markAll('Absent')" class="bg-red-50 text-[#C21E2E] border border-red-200 px-4 py-2 text-[9px] font-bold uppercase tracking-[2px] hover:bg-red-100 transition-all shadow-sm">
                        <i class="bi bi-x-circle me-1"></i> Mark All Absent
                    </button>
                </div>
            </div>

            @* Table Container (Scrolls Internally) *@
            <div class="table-responsive flex-grow overflow-y-auto custom-scrollbar">
                <table class="table align-middle w-full mb-0">
                    <thead class="sticky top-0 z-10 bg-white">
                        <tr class="text-[9px] uppercase tracking-[4px] font-bold text-gray-400 border-b bg-gray-50/80">
                            <th class="ps-8 py-4 w-16 text-center">#</th>
                            <th>Student Identity</th>
                            <th class="text-center bg-green-50/30 w-32 border-l border-gray-100">Present</th>
                            <th class="text-center bg-red-50/30 w-32 border-l border-gray-100">Absent</th>
                            <th class="text-center bg-amber-50/30 w-32 border-l border-gray-100 pe-6">Late</th>
                        </tr>
                    </thead>
                    <tbody class="text-gray-700">
                        @for (int i = 0; i < Model.Students.Count; i++)
                        {
                            var student = Model.Students[i];
                            <tr class="student-row border-b border-gray-50 last:border-0 transition-colors">
                                <td class="ps-8 py-3 text-center text-[10px] font-mono text-gray-400">
                                    @(i + 1)
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="bg-gray-100 rounded-full w-8 h-8 flex items-center justify-center font-bold text-[#C21E2E] font-serif text-sm border border-gray-200 shadow-sm flex-shrink-0">
                                            @student.FullName.Substring(0, 1).ToUpper()
                                        </div>
                                        <span class="font-serif font-bold text-gray-900 text-sm">@student.FullName</span>
                                    </div>
                                    <input type="hidden" name="Students[@i].StudentId" value="@student.StudentId" />
                                    <input type="hidden" name="Students[@i].FullName" value="@student.FullName" />
                                </td>
                                <td class="text-center border-l border-gray-50">
                                    <input type="radio" name="Students[@i].AttendanceStatus" value="Present"
                                           class="status-radio w-5 h-5 accent-[#10b981] cursor-pointer"
                                           @(student.AttendanceStatus == "Present" ? "checked" : "") />
                                </td>
                                <td class="text-center border-l border-gray-50">
                                    <input type="radio" name="Students[@i].AttendanceStatus" value="Absent"
                                           class="status-radio w-5 h-5 accent-[#C21E2E] cursor-pointer"
                                           @(student.AttendanceStatus == "Absent" ? "checked" : "") />
                                </td>
                                <td class="text-center border-l border-gray-50 pe-6">
                                    <input type="radio" name="Students[@i].AttendanceStatus" value="Late"
                                           class="status-radio w-5 h-5 accent-[#f59e0b] cursor-pointer"
                                           @(student.AttendanceStatus == "Late" ? "checked" : "") />
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* Institutional Footer Actions *@
            <div class="p-6 bg-[#1a1a1a] border-t border-gray-800 flex justify-between items-center flex-shrink-0">
                <div class="text-[9px] uppercase tracking-[2px] font-bold text-gray-400 font-mono">
                    <i class="bi bi-shield-lock me-2 text-gray-500"></i> Faculty Record Signature
                </div>
                <div class="flex gap-3">
                    <a href="@Url.Action("Index", "Attendances")" class="text-[9px] font-bold uppercase tracking-[2px] text-gray-400 hover:text-white px-4 py-3 transition-colors">
                        Discard Draft
                    </a>
                    <button type="submit" class="bg-[#C21E2E] text-white px-8 py-3 text-[10px] font-bold uppercase tracking-[3px] hover:bg-white hover:text-[#C21E2E] transition-all shadow-xl" onclick="return confirm('Commit this official attendance record?');">
                        <i class="bi bi-journal-check me-2"></i> Commit Register
                    </button>
                </div>
            </div>
        </div>
    }
</div>

<style>
    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }

    .font-mono {
        font-family: 'Source Code Pro', monospace !important;
    }

    /* Internal scrollbar custom styling */
    .custom-scrollbar::-webkit-scrollbar {
        width: 5px;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #eee;
        border-radius: 10px;
    }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #C21E2E;
        }
</style>

@section Scripts {
    <script>
        function markAll(status) {
            document.querySelectorAll('input[type="radio"][value="' + status + '"]').forEach(function (r) {
                r.checked = true;
                highlightRow(r);
            });
        }

        document.querySelectorAll('.status-radio').forEach(function (radio) {
            radio.addEventListener('change', function () {
                highlightRow(this);
            });
        });

        function highlightRow(radio) {
            var row = radio.closest('tr');
            // Tailwind-compatible hex colors for row highlighting
            if (radio.value === 'Present') row.style.backgroundColor = '#f0fdf4'; // green-50
            else if (radio.value === 'Absent') row.style.backgroundColor = '#fef2f2'; // red-50
            else if (radio.value === 'Late') row.style.backgroundColor = '#fffbeb'; // amber-50
            else row.style.backgroundColor = '';
        }

        // Initialise on page load
        document.querySelectorAll('.status-radio:checked').forEach(highlightRow);
    </script>
}
@model IEnumerable<Michaelhouse.Models.Subject>

<div class="container mt-4">
    <h2 class="mb-4"><i class="bi bi-journal-check me-2"></i>Select a Class</h2>
    <p class="text-muted">Choose the subject you are currently teaching to start the register.</p>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm h-100">
                    <div class="card-body">
                        <h5 class="card-title text-primary">@item.SubjectName</h5>
                        <h6 class="card-subtitle mb-2 text-muted">Code: @item.SubjectCode</h6>
                        <hr />
                        <p class="card-text">
                            <strong>Grade:</strong> @item.GradeLevel <br />
                            <strong>Status:</strong> Ready for Register
                        </p>
                        <a href="@Url.Action("MarkRegister", "Attendances", new { subjectId = item.SubjectId })"
                           class="btn btn-outline-primary w-100">
                            <i class="bi bi-pencil-square me-2"></i>Mark Attendance
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
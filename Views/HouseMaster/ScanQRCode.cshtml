@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Scan Student QR";
    var student = ViewBag.ScannedStudent as Michaelhouse.Models.Student;
    var assignment = ViewBag.ActiveAssignment as Michaelhouse.Models.ResidenceAssignment;
    string status = ViewBag.CurrentStatus as string;
    string statusLabel = ViewBag.CurrentStatusLabel as string;
    DateTime? lastCheckIn = ViewBag.LastCheckIn as DateTime?;
    DateTime? lastCheckOut = ViewBag.LastCheckOut as DateTime?;
    DateTime? holidayDeparture = ViewBag.HolidayDeparture as DateTime?;
    string suspensionDetails = ViewBag.SuspensionDetails as string;
    bool canCheckIn = ViewBag.CanCheckIn == true;
    bool canCheckOut = ViewBag.CanCheckOut == true;
    bool canHolidayDeparture = ViewBag.CanHolidayDeparture == true;
    bool canHolidayReturn = ViewBag.CanHolidayReturn == true;
    bool canSuspend = ViewBag.CanSuspend == true;
    bool canReinstate = ViewBag.CanReinstate == true;
    bool actionsLocked = ViewBag.ActionsLocked == true;
}

<div class="container py-4">
    <div class="row">
        <div class="col-md-5">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h3 class="mb-0">Scan Student QR</h3>
                    <small class="text-muted">Use the camera to scan the student's permanent QR identity.</small>
                </div>
                <div class="card-body">
                    <div id="qr-reader" class="border rounded mb-3" style="width:100%; min-height:280px;"></div>
                    <div id="qr-reader-status" class="small text-muted mb-3">Camera scanner ready.</div>

                    @using (Html.BeginForm("ScanQRCode", "HouseMaster", FormMethod.Post, new { id = "scanForm" }))
                    {
                        @Html.AntiForgeryToken()
                        <div class="form-group">
                            <label for="qrCodeValue">QR Code Value</label>
                            <input id="qrCodeValue" name="qrCodeValue" class="form-control" placeholder="Camera scan will fill this field" />
                        </div>
                        <button type="submit" class="btn btn-primary btn-block">Verify Student</button>
                    }
                </div>
            </div>
        </div>

        <div class="col-md-7">
            @if (TempData["Error"] != null)
            {
                <div class="alert alert-danger">@TempData["Error"]</div>
            }
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success">@TempData["Success"]</div>
            }

            @if (student != null)
            {
                var badgeClass = status == "Inside" ? "success" :
                    status == "Outside" ? "danger" :
                    status == "OnHoliday" ? "warning" :
                    status == "WeekendLeave" ? "primary" :
                    status == "Suspended" ? "warning" : "dark";
                var statusIcon = status == "Inside" ? "🟢" :
                    status == "Outside" ? "🔴" :
                    status == "OnHoliday" ? "🟡" :
                    status == "WeekendLeave" ? "🔵" :
                    status == "Suspended" ? "🟠" : "⚫";

                <div class="card shadow-sm">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <div>
                            <h3 class="mb-0">Student Verification</h3>
                            <small class="text-muted">No action has been performed yet.</small>
                        </div>
                        <span class="badge badge-@badgeClass p-2">@statusIcon @statusLabel</span>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-sm-6">
                                <dl>
                                    <dt>Full Name</dt>
                                    <dd>@student.Name</dd>
                                    <dt>Student Number</dt>
                                    <dd>@(student.StudentNumber ?? "Not captured")</dd>
                                    <dt>Grade</dt>
                                    <dd>@student.GradeLevel</dd>
                                    <dt>Current Status</dt>
                                    <dd>@statusIcon @statusLabel</dd>
                                </dl>
                            </div>
                            <div class="col-sm-6">
                                <dl>
                                    <dt>Residence</dt>
                                    <dd>@(assignment?.Residence?.Name ?? "Not assigned")</dd>
                                    <dt>Room Number</dt>
                                    <dd>@(assignment?.Room?.RoomNumber ?? "Not assigned")</dd>
                                    <dt>Bed Number</dt>
                                    <dd>@(assignment?.Bed?.BedNumber ?? "Not assigned")</dd>
                                    <dt>Assigned House Master</dt>
                                    <dd>@(assignment?.Residence?.HouseMaster?.FullName ?? "Not assigned")</dd>
                                </dl>
                            </div>
                        </div>

                        <div class="row border-top pt-3">
                            <div class="col-sm-6">
                                <dl>
                                    <dt>Last Check-In Time</dt>
                                    <dd>@(lastCheckIn?.ToLocalTime().ToString("g") ?? "None recorded")</dd>
                                    <dt>Last Check-Out Time</dt>
                                    <dd>@(lastCheckOut?.ToLocalTime().ToString("g") ?? "None recorded")</dd>
                                </dl>
                            </div>
                            <div class="col-sm-6">
                                <dl>
                                    <dt>Holiday Departure Date</dt>
                                    <dd>@(holidayDeparture?.ToLocalTime().ToString("g") ?? "Not on holiday")</dd>
                                    <dt>Suspension Details</dt>
                                    <dd>@(string.IsNullOrWhiteSpace(suspensionDetails) ? "None" : suspensionDetails)</dd>
                                </dl>
                            </div>
                        </div>

                        @if (assignment == null || actionsLocked)
                        {
                            <div class="alert alert-secondary mt-3">No boarding actions are available for this student.</div>
                        }
                        else
                        {
                            <div class="border-top pt-3">
                                <div class="row">
                                    <div class="col-md-6 mb-2">
                                        @using (Html.BeginForm("CheckIn", "HouseMaster", FormMethod.Post))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="studentId" value="@student.StudentId" />
                                            <button type="submit" class="btn btn-success btn-block" @(canCheckIn ? "" : "disabled")>Check In</button>
                                        }
                                    </div>
                                    <div class="col-md-6 mb-2">
                                        @using (Html.BeginForm("CheckOut", "HouseMaster", FormMethod.Post))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="studentId" value="@student.StudentId" />
                                            <button type="submit" class="btn btn-danger btn-block" @(canCheckOut ? "" : "disabled")>Check Out</button>
                                        }
                                    </div>
                                    <div class="col-md-6 mb-2">
                                        @using (Html.BeginForm("HolidayDeparture", "HouseMaster", FormMethod.Post))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="studentId" value="@student.StudentId" />
                                            <button type="submit" class="btn btn-warning btn-block" @(canHolidayDeparture ? "" : "disabled")>Holiday Departure</button>
                                        }
                                    </div>
                                    <div class="col-md-6 mb-2">
                                        @using (Html.BeginForm("HolidayReturn", "HouseMaster", FormMethod.Post))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="studentId" value="@student.StudentId" />
                                            <button type="submit" class="btn btn-primary btn-block" @(canHolidayReturn ? "" : "disabled")>Holiday Return</button>
                                        }
                                    </div>
                                </div>

                                <div class="card mt-3">
                                    <div class="card-body">
                                        <h5>Suspend Student</h5>
                                        @using (Html.BeginForm("SuspendStudent", "HouseMaster", FormMethod.Post))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="studentId" value="@student.StudentId" />
                                            <div class="form-group">
                                                <label>Reason</label>
                                                <textarea name="suspensionReason" class="form-control" rows="2" required></textarea>
                                            </div>
                                            <div class="form-group">
                                                <label>Expected Return Date</label>
                                                <input name="expectedReturnDate" type="datetime-local" class="form-control" />
                                            </div>
                                            <button type="submit" class="btn btn-warning" @(canSuspend ? "" : "disabled") onclick="return confirm('Suspend this student?');">Suspend Student</button>
                                        }
                                    </div>
                                </div>

                                <div class="mt-3">
                                    @using (Html.BeginForm("ReinstateStudent", "HouseMaster", FormMethod.Post))
                                    {
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="studentId" value="@student.StudentId" />
                                        <button type="submit" class="btn btn-info" @(canReinstate ? "" : "disabled") onclick="return confirm('Reinstate this student?');">Reinstate Student</button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<script src="@Url.Content("~/Scripts/html5-qrcode.min.js")"></script>
<script>
    (function () {
        var input = document.getElementById("qrCodeValue");
        var form = document.getElementById("scanForm");
        var status = document.getElementById("qr-reader-status");

        if (!window.Html5Qrcode) {
            status.textContent = "Camera QR scanner could not load. You can still paste the QR value manually.";
            return;
        }

        var scanner = new Html5Qrcode("qr-reader");
        scanner.start(
            { facingMode: "environment" },
            { fps: 10, qrbox: { width: 250, height: 250 } },
            function (decodedText) {
                input.value = decodedText;
                status.textContent = "QR code scanned. Verifying student...";
                scanner.stop().finally(function () { form.submit(); });
            },
            function () { }
        ).catch(function () {
            status.textContent = "Camera access was not available. Paste the QR value manually.";
        });
    })();
</script>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Scan Student QR";
    var student = ViewBag.ScannedStudent as Michaelhouse.Models.Student;
    var assignment = ViewBag.ActiveAssignment as Michaelhouse.Models.ResidenceAssignment;
}

<section class="p-8 max-w-5xl mx-auto">
    <div class="mb-6">
        <h1 class="text-4xl font-serif font-bold">Scan Student QR</h1>
        <p class="text-sm text-gray-500 mt-1">Process residence movement using the student's permanent QR identity.</p>
    </div>

    <div class="bg-white rounded shadow p-6 mb-6">
        @using (Html.BeginForm("ScanQRCode", "HouseMaster", FormMethod.Post, new { @class = "flex flex-col md:flex-row gap-3" }))
        {
            @Html.AntiForgeryToken()
            <input name="qrCodeValue" class="flex-1 px-4 py-2 border rounded shadow-sm" placeholder="Scan or paste permanent student QR value" autofocus />
            <button type="submit" class="px-5 py-2 bg-[#C21E2E] text-white rounded">Find Student</button>
        }
    </div>

    @if (student != null)
    {
        <div class="bg-white rounded shadow p-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <div class="text-sm text-gray-500 uppercase">Student</div>
                    <div class="text-2xl font-bold">@student.Name</div>
                    <div class="text-sm text-gray-600">Student Number: @(student.StudentNumber ?? "Not captured")</div>
                    <div class="text-sm text-gray-600">Grade: @student.GradeLevel</div>
                </div>
                <div>
                    <div class="text-sm text-gray-500 uppercase">Residence Status</div>
                    @if (assignment != null)
                    {
                        <div class="text-lg font-semibold">@assignment.Residence.Name</div>
                        <div class="text-sm text-gray-600">Room @assignment.Room.RoomNumber, Bed @assignment.Bed.BedNumber</div>
                        <div class="text-sm text-gray-600">Current Status: @assignment.Status</div>
                    }
                    else
                    {
                        <div class="text-lg font-semibold text-[#C21E2E]">No active residence assignment</div>
                    }
                </div>
            </div>

            @if (assignment != null)
            {
                <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mt-6">
                    @using (Html.BeginForm("CheckIn", "HouseMaster", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="studentId" value="@student.StudentId" />
                        <button type="submit" class="w-full px-4 py-2 bg-[#C21E2E] text-white rounded">Check In</button>
                    }

                    @using (Html.BeginForm("CheckOut", "HouseMaster", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="studentId" value="@student.StudentId" />
                        <button type="submit" class="w-full px-4 py-2 border rounded">Check Out</button>
                    }

                    @using (Html.BeginForm("EmergencyRollCallScan", "HouseMaster", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="studentId" value="@student.StudentId" />
                        <button type="submit" class="w-full px-4 py-2 border rounded">Roll Call Present</button>
                    }

                    @using (Html.BeginForm("HolidayDeparture", "HouseMaster", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="studentId" value="@student.StudentId" />
                        <button type="submit" class="w-full px-4 py-2 border rounded">Holiday Departure</button>
                    }

                    @using (Html.BeginForm("HolidayReturn", "HouseMaster", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="studentId" value="@student.StudentId" />
                        <button type="submit" class="w-full px-4 py-2 border rounded">Holiday Return</button>
                    }

                    @using (Html.BeginForm("VisitorReturn", "HouseMaster", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="studentId" value="@student.StudentId" />
                        <button type="submit" class="w-full px-4 py-2 border rounded">Visitor Return</button>
                    }
                </div>

                <div class="mt-8 border-t pt-6">
                    <h2 class="text-xl font-semibold mb-3">Visitor Sign Out</h2>
                    @using (Html.BeginForm("VisitorSignOut", "HouseMaster", FormMethod.Post, new { @class = "space-y-3" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="studentId" value="@student.StudentId" />
                        <input name="destination" class="w-full px-4 py-2 border rounded" placeholder="Destination" />
                        <input name="expectedReturnTime" type="datetime-local" class="w-full px-4 py-2 border rounded" />
                        <input name="reason" class="w-full px-4 py-2 border rounded" placeholder="Reason" />
                        <button type="submit" class="px-4 py-2 bg-[#C21E2E] text-white rounded">Record Visitor Sign Out</button>
                    }
                </div>
            }
        </div>
    }
</section>

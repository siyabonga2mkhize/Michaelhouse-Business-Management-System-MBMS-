@model List<Michaelhouse.Models.ResidenceAssignment>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Emergency Roll Call";
}

<section class="p-8 max-w-6xl mx-auto">
    <h1 class="text-3xl font-serif font-bold mb-4">Emergency Roll Call — @ViewBag.Residence</h1>

    <div class="bg-white rounded shadow overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Present</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Student</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Room</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Bed</th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-100">
                @foreach(var a in Model){
                    <tr>
                        <td class="px-6 py-4"><input type="checkbox" name="present_@a.StudentId" /></td>
                        <td class="px-6 py-4">@a.Student.Name</td>
                        <td class="px-6 py-4">@a.Room.RoomNumber</td>
                        <td class="px-6 py-4">@a.Bed.BedNumber</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="mt-4 flex gap-2">
        <button class="px-4 py-2 bg-[#C21E2E] text-white rounded">Mark Present</button>
        <button class="px-4 py-2 border rounded">Export Report</button>
    </div>
</section>
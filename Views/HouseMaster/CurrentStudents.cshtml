@model List<Michaelhouse.Models.ResidenceAssignment>
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Current Students";
}

<section class="p-8 max-w-6xl mx-auto">
    <h1 class="text-3xl font-serif font-bold mb-4">Current Students — @ViewBag.Residence</h1>

    <div class="bg-white rounded shadow overflow-hidden">
        <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-gray-50">
                <tr>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Student</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Room</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Bed</th>
                    <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase">Contact</th>
                    <th class="px-6 py-3"></th>
                </tr>
            </thead>
            <tbody class="bg-white divide-y divide-gray-100">
                @foreach(var a in Model){
                    <tr>
                        <td class="px-6 py-4">@a.Student.Name</td>
                        <td class="px-6 py-4">@a.Room.RoomNumber</td>
                        <td class="px-6 py-4">@a.Bed.BedNumber</td>
                        <td class="px-6 py-4">@a.Student.Parent?.Contact</td>
                        <td class="px-6 py-4 text-right">
                            <form method="post" action="@Url.Action("CheckOut", "HouseMaster")" class="inline">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="studentId" value="@a.StudentId" />
                                <button class="px-3 py-1 bg-red-600 text-white rounded">Check Out</button>
                            </form>
                            <a class="ml-2 px-3 py-1 border rounded" href="#">Transfer</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>
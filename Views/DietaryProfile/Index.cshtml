@using System.Linq
@using Michaelhouse.Services
@model Michaelhouse.Models.ViewModels.DietaryProfileViewModel

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "My Dietary Profile";

    var selectedAllergies = new System.Collections.Generic.HashSet<string>(
        Model.SelectedAllergies ?? new System.Collections.Generic.List<string>(),
        System.StringComparer.OrdinalIgnoreCase);

    var selectedMedical = new System.Collections.Generic.HashSet<string>(
        Model.SelectedMedicalRestrictions ?? new System.Collections.Generic.List<string>(),
        System.StringComparer.OrdinalIgnoreCase);

    var preference = string.IsNullOrWhiteSpace(Model.DietaryPreference)
        ? DietaryProfileService.PreferenceNone
        : Model.DietaryPreference;
}

@* --- FULL SCREEN VIEWPORT CONTAINER --- *@
<div class="flex flex-col h-full w-full overflow-hidden bg-gray-50/30">

    @* --- INSTITUTIONAL HEADER --- *@
    <div class="mb-6 d-flex justify-content-between align-items-end border-b border-gray-200 pb-6 flex-shrink-0 px-8 pt-8 bg-white shadow-sm relative z-10">
        <div>
            <div class="flex items-center gap-2 mb-3">
                <div class="h-[2px] w-8 bg-[#C21E2E]"></div>
                <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Student Identity & Operations</h5>
            </div>
            <h2 class="text-5xl font-serif font-bold text-gray-900 tracking-tight mb-0">My Dietary Profile</h2>
            <p class="text-[11px] font-mono text-gray-500 uppercase tracking-widest mt-2 mb-0 leading-relaxed max-w-2xl">
                The kitchen utilizes this profile to automatically filter unsuitable meal options from your planner and issue safety alerts during collection.
                @if (Model.UpdatedAt.HasValue)
                {
                    <span class="block mt-1 text-[#C21E2E] font-bold">Record Last Updated: @Model.UpdatedAt.Value.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</span>
                }
            </p>
        </div>
        <div class="flex gap-3">
            <a href="@Url.Action("Index", "StudentMealPlan")" class="inline-flex items-center justify-center bg-white border border-gray-300 text-gray-700 px-6 py-3 text-[10px] font-bold uppercase tracking-[2px] hover:bg-gray-50 hover:border-gray-400 transition-all duration-300 shadow-sm text-decoration-none">
                <i class="bi bi-arrow-left me-2 text-sm"></i> Back To Planner
            </a>
        </div>
    </div>

    @* --- SCROLLABLE DATA SECTION --- *@
    <div class="flex-grow min-h-0 overflow-y-auto custom-scrollbar px-8 pb-32 pt-4 flex flex-col w-full">

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="max-w-4xl mx-auto w-full bg-red-50 border-l-4 border-[#C21E2E] p-4 text-[#C21E2E] shadow-sm text-sm font-serif mb-6">
                <div class="flex items-center mb-1">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <strong>Please resolve the validation errors below:</strong>
                </div>
                @Html.ValidationSummary(false, "", new { @class = "text-xs font-mono mb-0 list-disc pl-5" })
            </div>
        }

        @* --- DOSSIER FORM MODULE --- *@
        <form action="@Url.Action("Save", "DietaryProfile")" method="post" class="max-w-4xl mx-auto w-full flex flex-col gap-8 m-0">
            @Html.AntiForgeryToken()

            @* 1. PREFERENCE *@
            <div class="bg-white shadow-sm border border-gray-100 flex flex-col relative overflow-hidden group">
                <div class="p-4 border-b border-gray-100 bg-[#1a1a1a] flex justify-between items-center relative z-10">
                    <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-white mb-0"><i class="bi bi-person-hearts me-2 text-gray-400"></i> Section 01. Dietary Preference</h5>
                </div>

                <div class="p-8">
                    <p class="text-[11px] font-mono text-gray-500 uppercase tracking-widest leading-relaxed mb-6 border-l-2 border-gray-300 pl-4 py-1">
                        A lifestyle or religious choice. <strong class="text-gray-900">Do not</strong> use this section for allergies or medical restrictions.
                    </p>

                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                        @foreach (var option in DietaryProfileService.PreferenceOptions)
                        {
                            var id = "pref_" + option.Code;
                            var isChecked = string.Equals(preference, option.Code, System.StringComparison.OrdinalIgnoreCase);
                            <label class="flex items-center p-4 border-2 transition-all duration-200 cursor-pointer @(isChecked ? "border-[#C21E2E] bg-red-50/20" : "border-gray-200 bg-white hover:border-gray-400")">
                                <input type="radio" name="DietaryPreference" id="@id" value="@option.Code" class="w-4 h-4 text-[#C21E2E] border-gray-300 focus:ring-[#C21E2E]"
                                       @(isChecked ? "checked" : "")
                                       data-other-target="@(option.Code == DietaryProfileService.OtherCode ? "prefOtherBox" : "")" />
                                <span class="ml-3 font-serif font-bold text-sm text-gray-900 select-none">@option.Label</span>
                            </label>
                        }
                    </div>

                    <div id="prefOtherBox" class="mt-6 pt-6 border-t border-gray-100" style="display:none;">
                        <label class="block text-[9px] uppercase tracking-[2px] font-bold text-gray-500 mb-2" for="DietaryPreferenceOther">Describe Custom Preference</label>
                        <input type="text" id="DietaryPreferenceOther" name="DietaryPreferenceOther" class="w-full border-b-2 border-gray-200 py-3 outline-none focus:border-[#C21E2E] font-serif text-sm text-gray-900 transition-colors bg-gray-50/50" maxlength="200" value="@Model.DietaryPreferenceOther" placeholder="Details of your preference..." />
                    </div>
                </div>
            </div>

            @* 2. ALLERGIES *@
            <div class="bg-white shadow-sm border border-gray-100 flex flex-col relative overflow-hidden group">
                <div class="p-4 border-b border-gray-100 bg-[#1a1a1a] flex justify-between items-center relative z-10">
                    <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-white mb-0"><i class="bi bi-shield-exclamation me-2 text-[#C21E2E]"></i> Section 02. Food Allergies</h5>
                </div>

                <div class="p-8">
                    <p class="text-[11px] font-mono text-gray-500 uppercase tracking-widest leading-relaxed mb-6 border-l-2 border-red-300 pl-4 py-1">
                        Foods that cause an allergic reaction. The system automatically restricts meals containing these ingredients from your selection planner.
                    </p>

                    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3">
                        @foreach (var option in DietaryProfileService.AllergyOptions)
                        {
                            var id = "allergy_" + option.Code.Replace(" ", "");
                            var isChecked = selectedAllergies.Contains(option.Code);
                            <label class="flex items-center p-3 border transition-all duration-200 cursor-pointer @(isChecked ? "border-[#C21E2E] bg-red-50/10" : "border-gray-200 bg-white hover:bg-gray-50")">
                                <input type="checkbox" name="SelectedAllergies" id="@id" value="@option.Code" class="w-4 h-4 text-[#C21E2E] border-gray-300 rounded focus:ring-[#C21E2E]"
                                       @(isChecked ? "checked" : "")
                                       data-other-target="@(option.Code == DietaryProfileService.OtherCode ? "allergyOtherBox" : "")" />
                                <span class="ml-3 font-serif font-bold text-sm text-gray-900 select-none">@option.Label</span>
                            </label>
                        }
                    </div>

                    <div id="allergyOtherBox" class="mt-6 pt-6 border-t border-gray-100" style="display:none;">
                        <label class="block text-[9px] uppercase tracking-[2px] font-bold text-gray-500 mb-2" for="OtherAllergies">Other Allergies (Comma-Separated)</label>
                        <input type="text" id="OtherAllergies" name="OtherAllergies" class="w-full border-b-2 border-gray-200 py-3 outline-none focus:border-[#C21E2E] font-serif text-sm text-gray-900 transition-colors bg-gray-50/50" maxlength="300" value="@Model.OtherAllergies" placeholder="e.g. Kiwi, Mustard" />
                    </div>
                </div>
            </div>

            @* 3. MEDICAL RESTRICTIONS *@
            <div class="bg-white shadow-sm border border-gray-100 flex flex-col relative overflow-hidden group">
                <div class="p-4 border-b border-gray-100 bg-[#1a1a1a] flex justify-between items-center relative z-10">
                    <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-white mb-0"><i class="bi bi-hospital me-2 text-blue-400"></i> Section 03. Medical Restrictions</h5>
                </div>

                <div class="p-8">
                    <p class="text-[11px] font-mono text-gray-500 uppercase tracking-widest leading-relaxed mb-6 border-l-2 border-blue-300 pl-4 py-1">
                        Medically mandated limitations. <strong class="text-gray-900">Lactose, Gluten, and Coeliac restrictions strictly enforce meal filtering</strong>. Other conditions generate operational alerts for kitchen staff and the Dietitian.
                    </p>

                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3">
                        @foreach (var option in DietaryProfileService.MedicalRestrictionOptions)
                        {
                            var id = "medical_" + option.Code;
                            var isChecked = selectedMedical.Contains(option.Code);
                            <label class="flex items-center p-3 border transition-all duration-200 cursor-pointer @(isChecked ? "border-[#C21E2E] bg-red-50/10" : "border-gray-200 bg-white hover:bg-gray-50")">
                                <input type="checkbox" name="SelectedMedicalRestrictions" id="@id" value="@option.Code" class="w-4 h-4 text-[#C21E2E] border-gray-300 rounded focus:ring-[#C21E2E]"
                                       @(isChecked ? "checked" : "")
                                       data-other-target="@(option.Code == DietaryProfileService.OtherCode ? "medicalOtherBox" : "")" />
                                <span class="ml-3 font-serif font-bold text-sm text-gray-900 select-none">@option.Label</span>
                            </label>
                        }
                    </div>

                    <div id="medicalOtherBox" class="mt-6 pt-6 border-t border-gray-100" style="display:none;">
                        <label class="block text-[9px] uppercase tracking-[2px] font-bold text-gray-500 mb-2" for="MedicalRestrictionOther">Medical Condition Details</label>
                        <input type="text" id="MedicalRestrictionOther" name="MedicalRestrictionOther" class="w-full border-b-2 border-gray-200 py-3 outline-none focus:border-[#C21E2E] font-serif text-sm text-gray-900 transition-colors bg-gray-50/50" maxlength="200" value="@Model.MedicalRestrictionOther" placeholder="Describe the medical dietary restriction..." />
                    </div>
                </div>
            </div>

            @* 4. NOTES *@
            <div class="bg-white shadow-sm border border-gray-100 flex flex-col relative overflow-hidden group">
                <div class="p-4 border-b border-gray-100 bg-[#1a1a1a] flex justify-between items-center relative z-10">
                    <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-white mb-0"><i class="bi bi-journal-text me-2 text-gray-400"></i> Section 04. Ancillary Information</h5>
                </div>

                <div class="p-8">
                    <label class="block text-[9px] uppercase tracking-[2px] font-bold text-gray-500 mb-3" for="DietaryNotes">Additional Dietary Directives</label>
                    <textarea id="DietaryNotes" name="DietaryNotes" class="w-full border border-gray-200 p-4 outline-none focus:border-[#C21E2E] font-serif text-sm text-gray-900 bg-gray-50/50 resize-y shadow-inner" rows="4" maxlength="1000" placeholder="Anything else the Dietitian or culinary operations team should know regarding your consumption patterns...">@Model.DietaryNotes</textarea>
                </div>

                @* FORM ACTIONS *@
                <div class="bg-gray-50 border-t border-gray-100 p-5 flex justify-end items-center gap-4 relative z-10">
                    <a href="@Url.Action("Index", "StudentMealPlan")" class="bg-transparent border border-gray-300 text-gray-600 px-6 py-3.5 text-[10px] font-bold uppercase tracking-[2px] hover:bg-gray-100 transition-colors shadow-sm text-decoration-none">
                        Discard Changes
                    </a>
                    <button type="submit" class="bg-[#10b981] border border-[#10b981] text-white px-8 py-3.5 text-[10px] font-bold uppercase tracking-[2px] hover:bg-green-600 hover:shadow-[0_0_15px_rgba(16,185,129,0.3)] transition-all shadow-sm">
                        <i class="bi bi-save me-1.5 text-sm align-text-bottom"></i> Update Profile
                    </button>
                </div>
            </div>

        </form>

    </div>
</div>

<style>
    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }

    .font-mono {
        font-family: 'Source Code Pro', monospace !important;
    }

    .custom-scrollbar::-webkit-scrollbar {
        width: 5px;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #d1d5db;
        border-radius: 10px;
    }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #C21E2E;
        }
</style>

@section Scripts {
    <script>
        // Show each "Other" text box only while its "Other" option is selected.
        // The server still validates; this is only a convenience UI toggle.
        (function () {
            var boxes = ["prefOtherBox", "allergyOtherBox", "medicalOtherBox"];

            function refresh() {
                boxes.forEach(function (boxId) {
                    var trigger = document.querySelector('[data-other-target="' + boxId + '"]');
                    var box = document.getElementById(boxId);
                    if (trigger && box) {
                        box.style.display = trigger.checked ? "block" : "none";
                    }
                });

                // Add styling for radio buttons
                document.querySelectorAll('input[type="radio"][name="DietaryPreference"]').forEach(function (radio) {
                    var parent = radio.closest('label');
                    if (radio.checked) {
                        parent.classList.add('border-[#C21E2E]', 'bg-red-50/20');
                        parent.classList.remove('border-gray-200', 'bg-white');
                    } else {
                        parent.classList.remove('border-[#C21E2E]', 'bg-red-50/20');
                        parent.classList.add('border-gray-200', 'bg-white');
                    }
                });

                // Add styling for checkboxes
                document.querySelectorAll('input[type="checkbox"][name="SelectedAllergies"], input[type="checkbox"][name="SelectedMedicalRestrictions"]').forEach(function (checkbox) {
                    var parent = checkbox.closest('label');
                    if (checkbox.checked) {
                        parent.classList.add('border-[#C21E2E]', 'bg-red-50/10');
                        parent.classList.remove('border-gray-200', 'bg-white');
                    } else {
                        parent.classList.remove('border-[#C21E2E]', 'bg-red-50/10');
                        parent.classList.add('border-gray-200', 'bg-white');
                    }
                });
            }

            document.querySelectorAll('input[name="DietaryPreference"], input[name="SelectedAllergies"], input[name="SelectedMedicalRestrictions"]')
                .forEach(function (input) {
                    input.addEventListener("change", refresh);
                });

            refresh();
        })();
    </script>
}
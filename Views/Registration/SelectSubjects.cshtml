@using Michaelhouse.Models.Enums
@using Michaelhouse.Services
@{
    ViewBag.Title = "Select Subjects";
    int appId = (int)ViewBag.AppId;
    int regId = (int)ViewBag.RegistrationId;
    int grade = (int)ViewBag.Grade;
    string stuName = ViewBag.StudentName?.ToString() ?? "Student";

    string existingLang = ViewBag.ExistingLanguage?.ToString();
    string existingMaths = ViewBag.ExistingMaths?.ToString();
    var existingStream = ViewBag.ExistingStream is AcademicStream es ? es : AcademicStream.None;
    var existingStreamSubs = ViewBag.ExistingStreamSubjects as List<string> ?? new List<string>();
}

<div class="mb-10 d-flex justify-content-between align-items-end border-b border-gray-100 pb-8">
    <div>
        <div class="flex items-center gap-2 mb-3">
            <div class="h-1 w-8 bg-[#C21E2E]"></div>
            <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Academic Planning</h5>
        </div>
        <h2 class="text-4xl font-serif font-bold text-gray-900 tracking-tight">Curriculum Selection</h2>
        <p class="text-xs text-gray-400 mt-2 uppercase tracking-widest font-bold">@stuName &mdash; Grade @grade Pathway</p>
    </div>
</div>

<div class="mb-12 flex items-center justify-between max-w-3xl border-b border-gray-100 pb-4">
    <div class="flex items-center gap-3">
        <div class="h-6 w-6 rounded-full bg-[#1a1a1a] text-white flex items-center justify-center text-[10px] font-bold">1</div>
        <span class="text-[10px] uppercase tracking-widest font-bold text-gray-900">Language</span>
    </div>
    <i class="bi bi-chevron-right text-gray-300"></i>
    <div class="flex items-center gap-3">
        <div class="h-6 w-6 rounded-full bg-[#1a1a1a] text-white flex items-center justify-center text-[10px] font-bold">2</div>
        <span class="text-[10px] uppercase tracking-widest font-bold text-gray-900">Mathematics</span>
    </div>
    <i class="bi bi-chevron-right text-gray-300"></i>
    <div class="flex items-center gap-3">
        <div class="h-6 w-6 rounded-full bg-[#1a1a1a] text-white flex items-center justify-center text-[10px] font-bold">3</div>
        <span class="text-[10px] uppercase tracking-widest font-bold text-gray-900">Stream</span>
    </div>
    <i class="bi bi-chevron-right text-gray-300"></i>
    <div class="flex items-center gap-3">
        <div class="h-6 w-6 rounded-full bg-[#1a1a1a] text-white flex items-center justify-center text-[10px] font-bold">4</div>
        <span class="text-[10px] uppercase tracking-widest font-bold text-gray-900">Electives</span>
    </div>
</div>

@using (Html.BeginForm("SelectSubjects", "Registration", FormMethod.Post, new { id = "subjectForm", @class = "space-y-12" }))
{
    @Html.AntiForgeryToken()
    <input type="hidden" name="appId" value="@appId" />
    <input type="hidden" name="registrationId" value="@regId" />

    <div class="row g-5">

        <div class="col-lg-8 space-y-12">

            <div class="bg-gray-50 border border-gray-200 p-8 relative overflow-hidden">
                <i class="bi bi-lock absolute -right-6 -bottom-6 text-black/5 text-8xl rotate-12"></i>
                <h5 class="text-[10px] uppercase tracking-[3px] font-bold text-gray-500 mb-6 flex items-center gap-2">
                    <i class="bi bi-shield-check text-[#C21E2E]"></i> Core Requirements
                </h5>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 relative z-10">
                    @foreach (var sub in RegistrationService.CompulsorySubjects)
                    {
                        <div class="bg-white border border-gray-200 p-4 flex justify-between items-center opacity-75">
                            <span class="text-sm font-bold text-gray-600">@sub</span>
                            <span class="text-[9px] uppercase tracking-widest font-bold text-gray-400">Fixed</span>
                        </div>
                    }
                </div>
            </div>

            <div>
                <h5 class="text-[10px] uppercase tracking-[3px] font-bold text-gray-900 mb-4 border-b border-gray-100 pb-2">
                    Step 1: First Additional Language
                </h5>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    @foreach (var lang in RegistrationService.LanguageChoices)
                    {
                        bool sel = existingLang == lang;
                        <label class="subject-card group cursor-pointer">
                            <input type="radio" name="languageChoice" value="@lang" class="peer sr-only lang-radio" @(sel ? "checked" : "") required />
                            <div class="p-5 border-2 border-gray-100 bg-white hover:border-gray-300 peer-checked:border-[#1a1a1a] peer-checked:bg-gray-50 transition-all relative">
                                <div class="absolute top-4 right-4 h-4 w-4 rounded-full border-2 border-gray-200 peer-checked:border-[#1a1a1a] peer-checked:bg-[#1a1a1a] flex items-center justify-center transition-colors">
                                    <div class="h-1.5 w-1.5 bg-white rounded-full opacity-0 peer-checked:opacity-100"></div>
                                </div>
                                <span class="text-sm font-bold text-gray-800 d-block mt-1">@lang</span>
                            </div>
                        </label>
                    }
                </div>
            </div>

            <div>
                <h5 class="text-[10px] uppercase tracking-[3px] font-bold text-gray-900 mb-4 border-b border-gray-100 pb-2">
                    Step 2: Mathematics Protocol
                </h5>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    @{
                        bool mathsSel = existingMaths == "Mathematics";
                        bool mathLitSel = existingMaths == "Mathematical Literacy";
                    }

                    <label class="subject-card group cursor-pointer">
                        <input type="radio" name="mathsChoice" value="Mathematics" class="peer sr-only maths-radio" @(mathsSel ? "checked" : "") required />
                        <div class="p-5 border-2 border-gray-100 bg-white hover:border-gray-300 peer-checked:border-[#1a1a1a] peer-checked:bg-gray-50 transition-all relative h-full">
                            <div class="absolute top-4 right-4 h-4 w-4 rounded-full border-2 border-gray-200 peer-checked:border-[#1a1a1a] peer-checked:bg-[#1a1a1a] flex items-center justify-center transition-colors">
                                <div class="h-1.5 w-1.5 bg-white rounded-full opacity-0 peer-checked:opacity-100"></div>
                            </div>
                            <span class="text-sm font-bold text-gray-800 d-block mt-1">Core Mathematics</span>
                            <span class="text-[10px] text-gray-400 mt-2 d-block italic">Unrestricted stream access</span>
                        </div>
                    </label>

                    <label class="subject-card group cursor-pointer">
                        <input type="radio" name="mathsChoice" value="Mathematical Literacy" class="peer sr-only maths-radio" @(mathLitSel ? "checked" : "") required />
                        <div class="p-5 border-2 border-gray-100 bg-white hover:border-gray-300 peer-checked:border-[#1a1a1a] peer-checked:bg-gray-50 transition-all relative h-full">
                            <div class="absolute top-4 right-4 h-4 w-4 rounded-full border-2 border-gray-200 peer-checked:border-[#1a1a1a] peer-checked:bg-[#1a1a1a] flex items-center justify-center transition-colors">
                                <div class="h-1.5 w-1.5 bg-white rounded-full opacity-0 peer-checked:opacity-100"></div>
                            </div>
                            <span class="text-sm font-bold text-gray-800 d-block mt-1">Mathematical Literacy</span>
                            <span class="text-[10px] text-gray-400 mt-2 d-block italic">Restricted stream access</span>
                        </div>
                    </label>
                </div>
                <div id="mathlit-warning" class="mt-4 p-4 bg-amber-50 border-l-2 border-amber-500 hidden transition-all">
                    <p class="text-[11px] text-amber-800 italic mb-0">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        Selecting Mathematical Literacy restricts your stream options to Arts, Humanities, or Commerce.
                    </p>
                </div>
            </div>

            <div>
                <h5 class="text-[10px] uppercase tracking-[3px] font-bold text-gray-900 mb-4 border-b border-gray-100 pb-2">
                    Step 3: Academic Faculty
                </h5>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    @{
                        var streams = new[]
                        {
                            new { Val = AcademicStream.ArtsAndCulture,            Icon = "bi-palette",   Name = "Arts & Culture",           Subs = "Music, Visual Arts, Drama",           MathLitOk = true  },
                            new { Val = AcademicStream.HumanAndSocialStudies,   Icon = "bi-globe",     Name = "Humanities",              Subs = "Geography, History,Tourism",                  MathLitOk = true  },
                            new { Val = AcademicStream.Sciences,                Icon = "bi-flask",     Name = "Sciences",                Subs = "Physics, Life Sciences,Chemistry",              MathLitOk = false },
                            new { Val = AcademicStream.Commerce,                Icon = "bi-graph-up",  Name = "Commerce",                Subs = "Accounting, Economics,Business Studies",               MathLitOk = true  },
                            new { Val = AcademicStream.EngineeringAndTechnology,Icon = "bi-cpu",       Name = "Engineering & Tech",      Subs = "EGD, IT, Coding & Robotics",          MathLitOk = false }
                        };
                    }
                    @foreach (var s in streams)
                    {
                        bool isSel = existingStream == s.Val;
                        <div class="stream-option" data-stream="@((int)s.Val)" data-mathlitok="@s.MathLitOk.ToString().ToLower()">
                            <label class="subject-card group cursor-pointer w-full h-full block">
                                <input type="radio" name="stream" value="@((int)s.Val)" class="peer sr-only stream-radio" @(isSel ? "checked" : "") required />
                                <div class="p-5 border-2 border-gray-100 bg-white hover:border-gray-300 peer-checked:border-[#C21E2E] peer-checked:bg-red-50/30 transition-all relative h-full peer-disabled:opacity-40 peer-disabled:bg-gray-100 peer-disabled:cursor-not-allowed">

                                    <div class="flex items-center gap-3 mb-2">
                                        <i class="bi @s.Icon text-xl text-gray-400 peer-checked:text-[#C21E2E]"></i>
                                        <span class="text-sm font-bold text-gray-900 peer-checked:text-[#C21E2E]">@s.Name</span>
                                    </div>
                                    <span class="text-[10px] text-gray-500 leading-relaxed italic d-block">@s.Subs</span>

                                    @if (!s.MathLitOk)
                                    {
                                        <div class="mt-3">
                                            <span class="text-[8px] uppercase tracking-widest font-bold text-gray-400 border border-gray-200 px-2 py-1">Core Math Required</span>
                                        </div>
                                    }
                                </div>
                            </label>
                        </div>
                    }
                </div>
            </div>

            <div>
                <h5 class="text-[10px] uppercase tracking-[3px] font-bold text-gray-900 mb-4 border-b border-gray-100 pb-2">
                    Step 4: Elective Specializations
                </h5>
                <div class="bg-gray-50 border border-gray-200 p-8 min-h-[150px]" id="stream-subjects-body">
                    <div class="text-center text-gray-400 py-6">
                        <i class="bi bi-arrow-up-circle text-2xl mb-2 block opacity-50"></i>
                        <p class="text-[10px] uppercase tracking-widest font-bold mb-0">Select a Faculty to view electives</p>
                    </div>
                </div>
            </div>

            <div class="pt-8 border-t border-gray-100">
                <button type="submit" class="bg-[#1a1a1a] text-white px-12 py-4 font-bold uppercase tracking-[4px] text-[11px] hover:bg-[#C21E2E] transition-all active:scale-[0.98] shadow-lg" id="saveBtn">
                    Finalize Curriculum
                </button>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="bg-[#1a1a1a] text-white p-8 shadow-2xl sticky top-24 relative overflow-hidden">
                <i class="bi bi-file-earmark-ruled absolute -right-6 -bottom-6 text-white/5 text-9xl rotate-12"></i>

                <div class="relative z-10">
                    <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-500 mb-8 border-b border-gray-700 pb-4">
                        Curriculum Transcript
                    </h5>

                    <ul class="space-y-6" id="subject-summary">
                        <div>
                            <span class="text-[8px] uppercase tracking-[2px] font-bold text-gray-500 block mb-1">Core Requirements</span>
                        <li class="text-sm font-serif italic mb-1">English Home Language</li>
                        <li class="text-sm font-serif italic">Life Orientation</li>
                </div>

                <div>
                    <span class="text-[8px] uppercase tracking-[2px] font-bold text-gray-500 block mb-1">Language</span>
                    <li class="text-sm font-bold text-white transition-all" id="sum-lang"><span class="text-gray-600 font-normal italic font-serif">Pending selection...</span></li>
                </div>

                <div>
                    <span class="text-[8px] uppercase tracking-[2px] font-bold text-gray-500 block mb-1">Mathematics</span>
                    <li class="text-sm font-bold text-white transition-all" id="sum-maths"><span class="text-gray-600 font-normal italic font-serif">Pending selection...</span></li>
                </div>

                <div>
                    <div class="flex justify-between items-center mb-1">
                        <span class="text-[8px] uppercase tracking-[2px] font-bold text-[#C21E2E]">Faculty Electives</span>
                        <span class="text-[10px] font-bold text-gray-500" id="total-count">0 / 3</span>
                    </div>
                    <ul class="space-y-2 text-sm font-bold text-white transition-all" id="sum-electives">
                        <li class="text-gray-600 font-normal italic font-serif">Pending faculty selection...</li>
                    </ul>
                </div>
                </ul>
            </div>
        </div>
    </div>
    </div>
}

<style>
    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }
    /* Hide default radio buttons visually but keep them functional */
    input[type="radio"], input[type="checkbox"] {
        position: absolute;
        opacity: 0;
    }
</style>

@section Scripts {
    <script>
        // ── Data & Initialization ──
        var streamData = {
            // These strings MUST match the C# RegistrationService dictionary exactly!
            1: { name: "Arts & Culture", subs: ["Music", "Visual Arts", "Dramatic Arts"], mathLitOk: true },
            2: { name: "Humanities", subs: ["Geography", "History", "Tourism"], mathLitOk: true },
            3: { name: "Sciences", subs: ["Physics", "Chemistry", "Life Sciences (Biology)"], mathLitOk: false },
            4: { name: "Commerce", subs: ["Accounting", "Economics", "Business Studies"], mathLitOk: true },
            5: { name: "Engineering & Tech", subs: ["Engineering Graphics and Design", "Computer Applications Technology", "Information Technology", "Coding and Robotics"], mathLitOk: false }
        };

        var existingStreamSubs = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(existingStreamSubs));
        var currentStream    = @((int)existingStream);
        var currentMaths     = '@(existingMaths ?? "")';

        // ── Helpers ──
        function getVal(name) {
            var r = document.querySelector(`input[name="${name}"]:checked`);
            return r ? r.value : null;
        }

        // ── Render Stream Subjects ──
        function renderStreamSubjects(streamId) {
            var body = document.getElementById('stream-subjects-body');
            if (!streamId || !streamData[streamId]) {
                body.innerHTML = `
                    <div class="text-center text-gray-400 py-6">
                        <i class="bi bi-arrow-up-circle text-2xl mb-2 block opacity-50"></i>
                        <p class="text-[10px] uppercase tracking-widest font-bold mb-0">Select a Faculty to view electives</p>
                    </div>`;
                updateSummary();
                return;
            }

            var data   = streamData[streamId];
            var subs   = data.subs;
            var needed = 3;

            var html = `<div class="mb-6"><span class="bg-[#1a1a1a] text-white text-[9px] uppercase tracking-widest font-bold px-3 py-1">Required: Select ${needed}</span></div>`;
            html += `<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">`;

            subs.forEach(function(sub) {
                var safeId  = 'ss_' + sub.replace(/[^a-zA-Z0-9]/g, '_');
                var checked = existingStreamSubs.indexOf(sub) !== -1 ? 'checked' : '';

                // Custom Checkbox UI
                html += `
                    <label class="cursor-pointer group">
                        <input type="checkbox" name="streamSubjects" value="${sub}" id="${safeId}" class="peer sr-only stream-sub-cb" ${checked} />
                        <div class="p-4 border-2 border-gray-200 bg-white flex items-center gap-3 peer-checked:border-[#C21E2E] peer-checked:bg-red-50/20 transition-all peer-disabled:opacity-50">
                            <div class="h-4 w-4 border-2 border-gray-300 peer-checked:border-[#C21E2E] peer-checked:bg-[#C21E2E] flex items-center justify-center transition-colors">
                                <i class="bi bi-check text-white text-[10px] opacity-0 peer-checked:opacity-100"></i>
                            </div>
                            <span class="text-xs font-bold text-gray-800">${sub}</span>
                        </div>
                    </label>
                `;
            });
            html += `</div>`;

            if (subs.length === needed) {
                html += `<p class="text-[10px] text-gray-400 mt-4 italic"><i class="bi bi-info-circle me-1"></i> Subjects auto-selected based on faculty requirements.</p>`;
            }

            body.innerHTML = html;

            if (subs.length === needed) {
                document.querySelectorAll('.stream-sub-cb').forEach(cb => cb.checked = true);
            }

            document.querySelectorAll('.stream-sub-cb').forEach(cb => {
                cb.addEventListener('change', function() {
                    enforceMax(needed);
                    updateSummary();
                });
            });

            enforceMax(needed);
            updateSummary();
        }

        function enforceMax(max) {
            var cbs = document.querySelectorAll('.stream-sub-cb');
            var checked = document.querySelectorAll('.stream-sub-cb:checked').length;
            cbs.forEach(cb => { if (!cb.checked) cb.disabled = checked >= max; });
        }

        // ── Handle Maths Logic ──
        function handleMathsChange() {
            var maths = getVal("mathsChoice");

            var warning = document.getElementById('mathlit-warning');
            if(maths === 'Mathematical Literacy') {
                warning.classList.remove('hidden');
            } else {
                warning.classList.add('hidden');
            }

            document.querySelectorAll('.stream-option').forEach(function(opt) {
                var mathLitOk = opt.dataset.mathlitok === 'true';
                var radio     = opt.querySelector('input[type=radio]');

                if (maths === 'Mathematical Literacy' && !mathLitOk) {
                    radio.disabled = true;
                    if (radio.checked) {
                        radio.checked = false;
                        renderStreamSubjects(null);
                    }
                } else {
                    radio.disabled = false;
                }
            });

            updateSummary();
        }

        // ── Live Summary Transcript ──
        function updateSummary() {
            var lang  = getVal("languageChoice");
            var maths = getVal("mathsChoice");
            var streamSubs = Array.from(document.querySelectorAll('.stream-sub-cb:checked')).map(cb => cb.value);

            document.getElementById('sum-lang').innerHTML = lang || '<span class="text-gray-600 font-normal italic font-serif">Pending selection...</span>';
            document.getElementById('sum-maths').innerHTML = maths || '<span class="text-gray-600 font-normal italic font-serif">Pending selection...</span>';

            var elList = document.getElementById('sum-electives');
            if(streamSubs.length === 0) {
                elList.innerHTML = '<li class="text-gray-600 font-normal italic font-serif">Pending faculty selection...</li>';
            } else {
                elList.innerHTML = streamSubs.map(s => `<li>${s}</li>`).join('');
            }

            var totalStr = streamSubs.length;
            var cnt = document.getElementById('total-count');
            cnt.textContent = `${totalStr} / 3`;
            cnt.className = `text-[10px] font-bold ${totalStr === 3 ? 'text-green-500' : 'text-gray-500'}`;
        }

        // ── Event Listeners ──
        document.addEventListener('DOMContentLoaded', function() {
            document.querySelectorAll('.lang-radio').forEach(r => r.addEventListener('change', updateSummary));

            document.querySelectorAll('.maths-radio').forEach(r => r.addEventListener('change', function() {
                handleMathsChange();
                document.querySelectorAll('.stream-radio').forEach(sr => sr.checked = false);
                renderStreamSubjects(null);
            }));

            document.querySelectorAll('.stream-radio').forEach(r => r.addEventListener('change', function() {
                renderStreamSubjects(parseInt(this.value));
            }));

            handleMathsChange();
            if (currentStream > 0) renderStreamSubjects(currentStream);
            updateSummary();
        });

        // ── Validation ──
        document.getElementById('subjectForm').addEventListener('submit', function(e) {
            var lang   = getVal("languageChoice");
            var maths  = getVal("mathsChoice");
            var stream = getVal("stream");
            var subs   = document.querySelectorAll('.stream-sub-cb:checked').length;

            if (!lang)        { e.preventDefault(); alert('Please select a Language.'); return; }
            if (!maths)       { e.preventDefault(); alert('Please select a Mathematics pathway.'); return; }
            if (!stream)      { e.preventDefault(); alert('Please select an Academic Faculty.'); return; }
            if (subs !== 3)   { e.preventDefault(); alert('Please select exactly 3 electives.'); return; }
        });
    </script>
}
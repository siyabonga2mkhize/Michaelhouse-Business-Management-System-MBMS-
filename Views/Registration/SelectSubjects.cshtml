@using System.Collections.Generic
@{
    ViewBag.Title = "Select Subjects";
    int appId = (int)ViewBag.AppId;
    int regId = (int)ViewBag.RegistrationId;
    int grade = (int)ViewBag.Grade;
    string stuName = ViewBag.StudentName?.ToString() ?? "Student";
    var groupA = (List<string>)ViewBag.ElectiveGroupA;
    var groupB = (List<string>)ViewBag.ElectiveGroupB;
    var compulsory = (List<string>)ViewBag.CompulsorySubjects;
    var selected = (List<string>)ViewBag.SelectedSubjects ?? new List<string>();
}

<div class="page-header">
    <h3 class="mb-0">
        <i class="bi bi-journal-bookmark me-2 text-warning"></i>Subject Selection — Grade @grade
    </h3>
    <small class="text-muted">Select subjects for @stuName</small>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        @using (Html.BeginForm("SelectSubjects", "Registration", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="appId" value="@appId" />
            <input type="hidden" name="registrationId" value="@regId" />

            <!-- Compulsory -->
            <div class="card mb-4">
                <div class="card-header bg-secondary text-white">
                    <i class="bi bi-lock-fill me-2"></i>Compulsory Subjects
                    <small class="opacity-75 ms-2">— automatically included</small>
                </div>
                <ul class="list-group list-group-flush">
                    @foreach (var sub in compulsory)
                    {
                        <li class="list-group-item d-flex align-items-center gap-3">
                            <span class="badge bg-secondary"><i class="bi bi-check-lg"></i></span>
                            <span class="fw-semibold">@sub</span>
                            <span class="badge bg-light text-dark ms-auto">Compulsory</span>
                        </li>
                    }
                </ul>
            </div>

            <!-- Group A — language (pick 1) -->
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <i class="bi bi-translate me-2"></i>Group A — Language
                    <span class="badge bg-warning text-dark ms-2">Choose 1</span>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        @foreach (var sub in groupA)
                        {
                            bool isSel = selected.Contains(sub);
                            <div class="col-md-6">
                                <div class="subject-card @(isSel ? "selected" : "")">
                                    <input type="radio" name="groupASubject"
                                           value="@sub" id="a_@sub.Replace(" ","_").Replace("/","_")"
                                           @(isSel ? "checked" : "") required />
                                    <label for="a_@sub.Replace(" ","_").Replace("/","_")" class="subject-label">
                                        @sub
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Group B — electives (pick 2) -->
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <i class="bi bi-book me-2"></i>Group B — Elective Subjects
                    <span class="badge bg-warning text-dark ms-2">Choose exactly 2</span>
                </div>
                <div class="card-body">
                    <div id="groupBAlert" class="alert alert-info small mb-3">
                        <i class="bi bi-info-circle me-1"></i>
                        Selected: <strong id="countDisplay">0</strong> / 2
                    </div>
                    <div class="row g-3">
                        @foreach (var sub in groupB)
                        {
                            bool isSel = selected.Contains(sub);
                            <div class="col-md-6">
                                <div class="subject-card @(isSel ? "selected" : "")">
                                    <input type="checkbox" class="grp-b"
                                           name="groupBSubjects" value="@sub"
                                           id="b_@sub.Replace(" ","_").Replace("/","_")"
                                           @(isSel ? "checked" : "") />
                                    <label for="b_@sub.Replace(" ","_").Replace("/","_")" class="subject-label">
                                        @sub
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="d-flex gap-3">
                <button type="submit" class="btn btn-primary btn-lg px-5">
                    <i class="bi bi-check-circle me-2"></i>Save Subjects & Continue
                </button>
            </div>
        }
    </div>

    <!-- Summary Panel -->
    <div class="col-lg-4">
        <div class="card border-warning mb-3">
            <div class="card-header bg-warning text-dark fw-semibold">
                <i class="bi bi-lightbulb-fill me-2"></i>Subject Rules
            </div>
            <div class="card-body small">
                <ul class="ps-3 mb-0">
                    <li>@compulsory.Count compulsory subjects (fixed)</li>
                    <li>1 language from Group A</li>
                    <li>2 electives from Group B</li>
                    <li><strong>Total: 5 subjects</strong></li>
                </ul>
            </div>
        </div>

        <div class="card">
            <div class="card-header fw-semibold"><i class="bi bi-list-check me-2"></i>My Selection</div>
            <ul class="list-group list-group-flush">
                @foreach (var sub in compulsory)
                {
                    <li class="list-group-item small">
                        <span class="badge bg-secondary me-2">Fixed</span>@sub
                    </li>
                }
                <li class="list-group-item small" id="sum-a">
                    <span class="badge bg-primary me-2">Lang</span>
                    <span class="text-muted">None selected</span>
                </li>
                <li class="list-group-item small" id="sum-b1">
                    <span class="badge bg-success me-2">Elec</span>
                    <span class="text-muted">None selected</span>
                </li>
                <li class="list-group-item small" id="sum-b2">
                    <span class="badge bg-success me-2">Elec</span>
                    <span class="text-muted">None selected</span>
                </li>
            </ul>
        </div>
    </div>
</div>

<style>
    .subject-card {
        border: 2px solid #e0e0e0;
        border-radius: 8px;
        padding: 12px 16px;
        cursor: pointer;
        transition: all 0.15s;
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .subject-card:hover {
            border-color: #1a3c5e;
            background: #f0f4f8;
        }

        .subject-card.selected,
        .subject-card:has(input:checked) {
            border-color: #1a3c5e;
            background: #e8f0f7;
        }

    .subject-label {
        cursor: pointer;
        font-weight: 500;
        margin: 0;
        flex: 1;
    }
</style>

@section Scripts {
    <script>
    function update() {
        var checked = document.querySelectorAll('.grp-b:checked');
        var count   = checked.length;
        document.getElementById('countDisplay').innerText = count;

        var alert = document.getElementById('groupBAlert');
        alert.className = 'alert small mb-3 ' + (count === 2 ? 'alert-success' : 'alert-info');

        // Disable unchecked when max reached
        document.querySelectorAll('.grp-b').forEach(function(cb) {
            if (!cb.checked) cb.disabled = (count >= 2);
        });

        // Update summary
        var names = Array.from(checked).map(function(cb){ return cb.value; });
        var b1 = document.getElementById('sum-b1');
        var b2 = document.getElementById('sum-b2');
        b1.innerHTML = '<span class="badge bg-success me-2">Elec</span>' + (names[0] || '<span class="text-muted">None selected</span>');
        b2.innerHTML = '<span class="badge bg-success me-2">Elec</span>' + (names[1] || '<span class="text-muted">None selected</span>');
    }

    function updateA() {
        var r = document.querySelector('input[name="groupASubject"]:checked');
        var el = document.getElementById('sum-a');
        el.innerHTML = '<span class="badge bg-primary me-2">Lang</span>' +
            (r ? r.value : '<span class="text-muted">None selected</span>');
    }

    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('.grp-b').forEach(function(cb){ cb.addEventListener('change', update); });
        document.querySelectorAll('input[name="groupASubject"]').forEach(function(r){ r.addEventListener('change', updateA); });
        update(); updateA();
    });

    document.querySelector('form').addEventListener('submit', function(e) {
        if (document.querySelectorAll('.grp-b:checked').length !== 2) {
            e.preventDefault();
            alert('Please select exactly 2 subjects from Group B.');
        }
    });
    </script>
}

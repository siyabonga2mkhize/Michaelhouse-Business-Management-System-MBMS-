@using Michaelhouse.Models
@{
    ViewBag.Title = "Registration Complete";
    var student = (Student)ViewBag.Student;
    var reg = (Registration)ViewBag.Reg;
    var subjects = (List<StudentSubject>)ViewBag.Subjects;

    // Helper to prevent the proxy string issue
    string studentDisplay = student != null ? student.Name : "the student";
    string studentFirst = student != null ? student.FirstName : "the student";
}

<div class="text-center py-4">
    <i class="bi bi-patch-check-fill text-success" style="font-size:4rem;"></i>
    <h2 class="mt-3">Registration Complete!</h2>
    <p class="text-muted lead">
        @studentDisplay has been successfully enrolled in Grade @(reg?.GradeEnrolling.ToString() ?? "—") at Michaelhouse.
    </p>
</div>

<div class="row justify-content-center">
    <div class="col-lg-7">

        <div class="card mb-4">
            <div class="card-header bg-success text-white">
                <i class="bi bi-envelope-check me-2"></i>Login Credentials Sent
            </div>
            <div class="card-body">
                <p>
                    A student account has been created for <strong>@studentDisplay</strong>.
                    The login credentials have been emailed to your registered email address.
                </p>
                <div class="alert alert-warning small mb-0">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    Please ask @studentFirst to log in and change the temporary password immediately.
                </div>
            </div>
        </div>

        @if (subjects != null && subjects.Any())
        {
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <i class="bi bi-journal-bookmark me-2"></i>Subject Package — Grade @(reg?.GradeEnrolling.ToString() ?? "—")
                </div>
                <ul class="list-group list-group-flush">
                    @foreach (var ss in subjects)
                    {
                        <li class="list-group-item d-flex justify-content-between">
                            <span class="fw-semibold">@(ss.Subject != null ? ss.Subject.SubjectName : "Unknown Subject")</span>

                            @if (ss.IsElective)
                            {<span class="badge bg-primary">Elective</span> }
                            else
                            { <span class="badge bg-secondary">Compulsory</span>}
                        </li>
                    }
                </ul>
            </div>
        }

        <div class="card border-primary">
            <div class="card-body small">
                <h6 class="fw-bold mb-3"><i class="bi bi-info-circle me-2"></i>What Happens Next</h6>
                <div class="d-flex gap-2 mb-2">
                    <span class="badge bg-primary mt-1 flex-shrink-0">1</span>
                    <span>The school will contact you with orientation details and term dates.</span>
                </div>
                <div class="d-flex gap-2 mb-2">
                    <span class="badge bg-primary mt-1 flex-shrink-0">2</span>
                    <span>A confirmation letter will be emailed to you.</span>
                </div>
                <div class="d-flex gap-2">
                    <span class="badge bg-primary mt-1 flex-shrink-0">3</span>
                    <span>Booklists and uniform information will be provided before the school year begins.</span>
                </div>
            </div>
        </div>

        <div class="text-center mt-4">
            <a href="@Url.Action("Index", "Applications")" class="btn btn-outline-primary">
                <i class="bi bi-grid-1x2 me-2"></i>Back to My Applications
            </a>
        </div>

    </div>
</div>
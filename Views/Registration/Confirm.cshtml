@using Michaelhouse.Models
@using Michaelhouse.Models.Enums
@{
    ViewBag.Title = "Confirm Registration";
    int appId = (int)ViewBag.AppId;
    var student = (Student)ViewBag.Student;
    var reg = (Registration)ViewBag.Reg;
    var subjects = (List<StudentSubject>)ViewBag.Subjects;
    bool needsSubs = (bool)ViewBag.NeedsSubjects;

    // --- LOGIC HELPERS ---
    // Fixes the DynamicProxy name issue
    string studentName = student != null ? student.Name : "Student";
    string parentName = (student?.Parent != null) ? student.Parent.Name : "—";

    // Clean Age Calculation to avoid the "{ expected" error
    int age = 0;
    if (student != null)
    {
        age = DateTime.Today.Year - student.DOB.Year;
        if (student.DOB.Date > DateTime.Today.AddYears(-age)) { age--; }
    }
}

<div class="page-header">
    <h3 class="mb-0"><i class="bi bi-clipboard-check me-2 text-warning"></i>Confirm Registration</h3>
    <small class="text-muted">Review all details before completing registration for @studentName</small>
</div>

@if (needsSubs)
{
    <div class="alert alert-warning d-flex align-items-center justify-content-between">
        <span>
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Subjects not yet selected.</strong> Please select subjects before completing registration.
        </span>
        <a href="@Url.Action("SelectSubjects", "Registration", new { appId })"
           class="btn btn-warning btn-sm ms-3">
            <i class="bi bi-book me-1"></i>Select Subjects
        </a>
    </div>
}

<div class="row g-4">
    <div class="col-lg-6">

        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <i class="bi bi-person-fill me-2"></i>Student Details
            </div>
            <div class="card-body p-0">
                <table class="table table-sm table-borderless mb-0">
                    <tr><td class="text-muted ps-3 py-2">Full Name</td><td class="fw-semibold">@studentName</td></tr>
                    <tr><td class="text-muted ps-3 py-2">Date of Birth</td><td>@(student != null ? student.DOB.ToString("dd MMM yyyy") : "—")</td></tr>
                    <tr><td class="text-muted ps-3 py-2">Age</td><td>@age years</td></tr>
                    <tr><td class="text-muted ps-3 py-2">ID / Passport</td><td>@(student?.IdNumber ?? "—")</td></tr>
                    <tr><td class="text-muted ps-3 py-2">Home Language</td><td>@(student?.HomeLanguage ?? "—")</td></tr>
                    <tr><td class="text-muted ps-3 py-2">Previous School</td><td>@(student?.PreviousSchool ?? "—")</td></tr>
                    <tr class="border-top">
                        <td class="text-muted ps-3 py-2">Grade Enrolling</td>
                        <td><span class="badge bg-primary fs-6">Grade @reg.GradeEnrolling</span></td>
                    </tr>
                </table>
            </div>
        </div>

        <div class="card">
            <div class="card-header bg-primary text-white">
                <i class="bi bi-people-fill me-2"></i>Parent / Guardian
            </div>
            <div class="card-body p-0">
                <table class="table table-sm table-borderless mb-0">
                    <tr><td class="text-muted ps-3 py-2">Name</td><td class="fw-semibold">@parentName</td></tr>
                    <tr><td class="text-muted ps-3 py-2">Relationship</td><td>@(student?.Parent?.Relationship ?? "—")</td></tr>
                    <tr><td class="text-muted ps-3 py-2">Cell</td><td>@(student?.Parent?.CellPhone ?? "—")</td></tr>
                    <tr><td class="text-muted ps-3 py-2">Email</td><td>@(student?.Parent?.Contact ?? "—")</td></tr>
                    <tr><td class="text-muted ps-3 py-2">Address</td><td>@(student?.Parent?.PhysicalAddress ?? "—")</td></tr>
                </table>
            </div>
        </div>

    </div>

    <div class="col-lg-6">

        <div class="card mb-4">
            <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                <span><i class="bi bi-journal-bookmark me-2"></i>Subjects for Grade @reg.GradeEnrolling</span>
                @if (reg.GradeEnrolling >= 10 && !needsSubs)
                {
                    <a href="@Url.Action("SelectSubjects", "Registration", new { appId })"
                       class="btn btn-sm btn-outline-light">
                        <i class="bi bi-pencil me-1"></i>Change
                    </a>
                }
            </div>
            @if (subjects != null && subjects.Any())
            {
                <ul class="list-group list-group-flush">
                    @foreach (var ss in subjects)
                    {
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <span>@(ss?.Subject?.Name ?? "Unknown Subject")</span>
                            @if (ss?.Subject != null && !ss.Subject.IsCompulsory)
                            {
                                <span class="badge bg-primary">Elective</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Compulsory</span>
                            }
                        </li>
                    }
                </ul>
            }
            else
            {
                <div class="card-body text-muted small">No subjects assigned yet.</div>
            }
        </div>

        @if (!needsSubs && reg.Status != RegistrationStatus.Completed)
        {
            <div class="card border-success">
                <div class="card-header bg-success text-white">
                    <i class="bi bi-check-circle-fill me-2"></i>Ready to Complete
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        By completing registration you confirm that all the above details are correct.
                        A student account will be created automatically and login credentials will be emailed to you.
                    </p>
                    @using (Html.BeginForm("CompleteRegistration", "Registration", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="appId" value="@appId" />
                        <input type="hidden" name="registrationId" value="@reg.RegistrationId" />
                        <button type="submit" class="btn btn-success btn-lg w-100"
                                onclick="return confirm('Confirm registration? A student account will be created and credentials emailed to you.')">
                            <i class="bi bi-mortarboard me-2"></i>Complete Registration
                        </button>
                    }
                </div>
            </div>
        }
        else if (reg.Status == RegistrationStatus.Completed)
        {
            <div class="card border-success text-center py-3">
                <div class="card-body">
                    <i class="bi bi-patch-check-fill text-success" style="font-size:3rem;"></i>
                    <h5 class="mt-3 text-success">Registration Complete!</h5>
                    <p class="text-muted small">Completed on @(reg.CompletedAt?.ToString("dd MMM yyyy") ?? "—")</p>
                    <a href="@Url.Action("Complete", "Registration", new { appId })"
                       class="btn btn-outline-success">
                        View Summary
                    </a>
                </div>
            </div>
        }

    </div>
</div>
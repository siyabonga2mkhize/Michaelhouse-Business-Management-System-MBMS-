@model IEnumerable<Michaelhouse.Models.DriverApplication>
@{
    ViewBag.Title = "Driver Applications Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Quick Stats for the Hero Cards (Safely handling nulls and status strings)
    var awaiting = Model.Count(a => a.Status == "Pending" || string.IsNullOrEmpty(a.Status));
    var flagged = Model.Count(a => a.Status == "Flagged");
    var approvedToday = Model.Count(a => a.Status == "Approved" && a.DateSubmitted.HasValue && a.DateSubmitted.Value.Date == DateTime.Today);
}

<div class="mb-10 d-flex justify-content-between align-items-end border-b border-gray-100 pb-8 animate-fade-in">
    <div>
        <div class="flex items-center gap-2 mb-3">
            <div class="h-1 w-8 bg-[#C21E2E]"></div>
            <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Transport Division</h5>
        </div>
        <h2 class="text-4xl font-serif font-bold text-gray-900 tracking-tight">Driver Applications Dashboard</h2>
    </div>
    <div class="text-right">
        <p class="text-[9px] font-bold uppercase tracking-widest text-gray-400 mb-1">System Status</p>
        <span class="flex items-center gap-2 text-[10px] font-bold text-green-600 uppercase tracking-tighter">
            <span class="h-2 w-2 rounded-full bg-green-500 animate-pulse"></span> Neural Engine Online
        </span>
    </div>
</div>

<div class="row g-4 mb-12 animate-fade-in">
    <div class="col-md-4">
        <div class="bg-[#1a1a1a] text-white p-8 shadow-xl relative overflow-hidden group">
            <i class="bi bi-inbox-fill absolute -right-4 -bottom-4 text-white/5 text-8xl rotate-12 transition-transform group-hover:scale-110"></i>
            <p class="text-[10px] uppercase tracking-[3px] font-bold text-gray-500 mb-2 relative z-10">Awaiting Decision</p>
            <h3 class="text-4xl font-bold relative z-10">@awaiting</h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="bg-white border border-gray-100 p-8 shadow-sm relative overflow-hidden group">
            <i class="bi bi-flag-fill absolute -right-4 -bottom-4 text-amber-500/5 text-8xl rotate-12"></i>
            <p class="text-[10px] uppercase tracking-[3px] font-bold text-amber-600 mb-2 relative z-10">Flagged For Review</p>
            <h3 class="text-4xl font-bold text-gray-900 relative z-10">@flagged</h3>
        </div>
    </div>
    <div class="col-md-4">
        <div class="bg-white border border-gray-100 p-8 shadow-sm relative overflow-hidden group">
            <i class="bi bi-check-all absolute -right-4 -bottom-4 text-green-600/5 text-8xl rotate-12"></i>
            <p class="text-[10px] uppercase tracking-[3px] font-bold text-green-600 mb-2 relative z-10">Approved Today</p>
            <h3 class="text-4xl font-bold text-gray-900 relative z-10">@approvedToday</h3>
        </div>
    </div>
</div>

<div class="bg-white shadow-sm border border-gray-100 overflow-hidden relative animate-fade-in">

    <div class="p-8 border-b border-gray-100 d-flex justify-content-between align-items-center relative bg-white overflow-hidden">
        <div class="absolute inset-0 opacity-[0.03] pointer-events-none"
             style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 20px 20px;"></div>

        <div class="relative z-10">
            <h5 class="text-xs uppercase tracking-[4px] font-bold text-gray-900 mb-0">Incoming Applications</h5>
        </div>

        <div class="relative z-10 flex gap-4">
            <div class="relative">
                <i class="bi bi-filter absolute left-0 top-1/2 -translate-y-1/2 text-gray-300"></i>
                <input type="text" id="dashboardSearch"
                       class="ps-6 pr-4 py-2 border-0 border-b border-gray-100 focus:border-[#C21E2E] outline-none bg-transparent text-[11px] font-bold uppercase tracking-widest transition-all"
                       placeholder="Search Applications..." onkeyup="filterDashboard()" />
            </div>
        </div>
    </div>

    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle" id="dashTable">
            <thead>
                <tr class="text-[10px] uppercase tracking-[3px] font-bold text-gray-400 border-b">
                    <th class="ps-8 py-5">Application ID</th>
                    <th>Applicant Name</th>
                    <th>Contact Lead</th>
                    <th>AI Rec</th>
                    <th>Submission Date</th>
                    <th>Status</th>
                    <th class="pe-8 text-end">Action</th>
                </tr>
            </thead>
            <tbody class="text-gray-700 border-0">
                @foreach (var app in Model.OrderByDescending(a => a.DateSubmitted))
                {
                    string aiColor = app.AiRecommendation == "APPROVE" ? "text-green-500"
                                   : app.AiRecommendation == "REJECT" ? "text-red-500" : "text-amber-500";

                    string statusColor = app.Status == "Approved" ? "bg-green-100 text-green-800"
                                       : app.Status == "Rejected" ? "bg-red-100 text-red-800"
                                       : app.Status == "Flagged" ? "bg-amber-100 text-amber-800"
                                       : "bg-gray-100 text-gray-800";

                    <tr class="group border-b border-gray-50 last:border-0 hover:bg-[#fcfcfc] transition-colors">
                        <td class="ps-8 py-4">
                            <span class="text-[11px] font-bold text-gray-400 font-mono">#DRV-@app.Id</span>
                        </td>

                        <td>
                            <div class="fw-bold text-gray-900">@app.FullName</div>
                            <div class="text-[9px] text-gray-400 uppercase tracking-tighter">Licence: @app.LicenceNumber</div>
                        </td>

                        <td class="text-sm">
                            <div class="text-gray-800">@app.PhoneNumber</div>
                            <div class="text-[9px] text-gray-400">@app.Email</div>
                        </td>

                        <td>
                            @if (!string.IsNullOrEmpty(app.AiRecommendation))
                            {
                                <div class="flex items-center gap-2">
                                    <i class="bi bi-robot @aiColor text-sm"></i>
                                    <span class="text-[10px] font-bold uppercase tracking-widest @aiColor">@app.AiRecommendation</span>
                                </div>
                            }
                            else
                            {
                                <span class="text-[10px] text-gray-300 italic">Processing...</span>
                            }
                        </td>

                        <td class="text-xs text-gray-500 font-mono">
                            @(app.DateSubmitted?.ToString("dd MMM yyyy") ?? "—")
                        </td>

                        <td>
                            <span class="px-3 py-1 rounded-full text-[9px] font-bold uppercase tracking-widest @statusColor">
                                @(app.Status ?? "Pending")
                            </span>
                        </td>

                        <td class="pe-8 text-end">
                            <a href="@Url.Action("Details", "DriverApplications", new { id = app.Id })"
                               class="inline-block bg-gray-50 text-gray-400 px-4 py-2 text-[9px] font-bold uppercase tracking-[2px] hover:bg-[#C21E2E] hover:text-white transition-all shadow-sm">
                                Open File
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }

    .font-mono {
        font-family: 'Source Code Pro', monospace !important;
    }

    .table thead th {
        border: none !important;
    }

    .table tbody tr {
        transition: all 0.2s;
    }

        .table tbody tr:hover {
            transform: scale(1.002);
        }

    .animate-fade-in {
        animation: fadeIn 0.6s ease-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

@section Scripts {
    <script>
        function filterDashboard() {
            var q = document.getElementById('dashboardSearch').value.toLowerCase();
            document.querySelectorAll('#dashTable tbody tr').forEach(function (r) {
                r.style.display = r.innerText.toLowerCase().includes(q) ? '' : 'none';
            });
        }
    </script>
}
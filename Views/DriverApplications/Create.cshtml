@model Michaelhouse.Models.DriverApplication
@{
    ViewBag.Title = "Driver Enrollment";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Driver Enrollment — Michaelhouse</title>

    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,700;1,400&family=Montserrat:wght@400;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <script src="https://cdn.tailwindcss.com"></script>

    <style>
        :root {
            --mh-red: #C21E2E;
        }

        body {
            font-family: 'Montserrat', sans-serif;
            background-color: #fff;
            overflow-x: hidden;
        }

        h1, h2, h5, .font-serif {
            font-family: 'Playfair Display', serif !important;
        }

        @@keyframes coverSettling {
            0% {
                transform: scale(1.1);
                opacity: 0;
            }

            100% {
                transform: scale(1);
                opacity: 1;
            }
        }

        @@keyframes formArrival {
            0% {
                opacity: 0;
                transform: translateY(30px);
            }

            100% {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .animate-cover {
            animation: coverSettling 1.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        .animate-form {
            opacity: 0;
            animation: formArrival 1s cubic-bezier(0.16, 1, 0.3, 1) 0.5s forwards;
        }

        .bg-image {
            background-image: url('https://images.unsplash.com/photo-1449960232330-35197b56c91f?auto=format&fit=crop&q=80&w=1500');
            background-size: cover;
            background-position: center;
        }

        .form-input-focus:focus {
            border-color: var(--mh-red) !important;
            outline: none;
            box-shadow: none;
        }

        /* Validation styling */
        .input-validation-error {
            border-color: #C21E2E !important;
            background-color: #fff5f5 !important;
        }

        .field-validation-error {
            display: block;
            color: #C21E2E;
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 700;
            margin-top: 4px;
        }

        .dossier-card {
            border: 1px solid #f0f0f0;
            padding: 1.25rem;
            background: #fff;
            transition: all 0.3s ease;
        }

            .dossier-card:hover {
                border-color: var(--mh-red);
                box-shadow: 0 10px 30px rgba(0,0,0,0.02);
            }

        input[type="file"]::file-selector-button {
            background: #1a1a1a;
            color: white;
            border: none;
            padding: 6px 12px;
            font-size: 9px;
            text-transform: uppercase;
            font-weight: 700;
            letter-spacing: 1px;
            cursor: pointer;
            margin-right: 1rem;
            transition: background 0.3s;
        }

            input[type="file"]::file-selector-button:hover {
                background: var(--mh-red);
            }

        .custom-scrollbar::-webkit-scrollbar {
            width: 4px;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #eee;
        }
    </style>
</head>
<body class="antialiased">

    <div class="flex flex-col md:flex-row min-h-screen">

        <!-- LEFT COVER PANEL -->
        <div class="hidden md:flex md:w-5/12 bg-image relative items-center justify-center p-16 sticky top-0 h-screen animate-cover">
            <div class="absolute inset-0 bg-[#C21E2E]/20 mix-blend-multiply"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-black/95 via-black/40 to-transparent"></div>
            <div class="relative z-10 text-white text-center">
                <div class="mb-8"><i class="bi bi-truck-front text-6xl opacity-80"></i></div>
                <h1 class="text-6xl font-bold mb-6 leading-tight tracking-tighter">Logistics<br />Fleet.</h1>
                <div class="h-1 w-12 bg-white mx-auto mb-8"></div>
                <p class="text-xl text-white/80 italic font-serif leading-relaxed px-6 max-w-md mx-auto">
                    "Safe transit is the silent pulse of our institutional excellence."
                </p>
            </div>
        </div>

        <!-- RIGHT FORM PANEL -->
        <div class="w-full md:w-7/12 flex items-center justify-center p-8 lg:p-24 bg-white animate-form custom-scrollbar">
            <div class="w-full max-w-xl">

                <div class="mb-12">
                    <img src="@Url.Content("~/Content/logo.svg.png")" alt="Michaelhouse Crest" class="h-20 mb-8 object-contain" />
                    <h2 class="text-3xl text-gray-900 font-bold uppercase tracking-tight">Personnel Application</h2>
                    <div class="h-1 w-12 bg-[#C21E2E] mt-4"></div>
                </div>

                @using (Html.BeginForm("Create", "DriverApplications", FormMethod.Post, new { enctype = "multipart/form-data", @class = "space-y-12" }))
                {
                    @Html.AntiForgeryToken()

                    <!-- VALIDATION SUMMARY -->
                    if (!ViewData.ModelState.IsValid)
                    {
                        <div class="border border-[#C21E2E] bg-red-50 p-4 mb-4">
                            <p class="text-[10px] uppercase tracking-[3px] font-bold text-[#C21E2E] mb-3">
                                <i class="bi bi-exclamation-triangle-fill me-1"></i> Please correct the following errors:
                            </p>
                            @Html.ValidationSummary(false, "", new { @class = "text-[11px] text-[#C21E2E] list-disc list-inside space-y-1 pl-1" })
                        </div>
                    }

                    <!-- SECTION 1 — Biographic Profile -->
                    <div class="space-y-8">
                        <p class="text-[10px] uppercase tracking-[4px] font-bold text-[#C21E2E] border-b border-gray-100 pb-2">01. Biographic Profile</p>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                            <div class="col-span-2">
                                <label class="block text-[10px] uppercase tracking-[2px] font-bold text-gray-400 mb-2">Full Legal Name</label>
                                @Html.TextBoxFor(m => m.FullName, new { @class = "w-full p-3 border border-gray-100 rounded-none form-input-focus text-sm bg-gray-50/30", placeholder = "As per Identity Document" })
                                @Html.ValidationMessageFor(m => m.FullName)
                            </div>

                            <div>
                                <label class="block text-[10px] uppercase tracking-[2px] font-bold text-gray-400 mb-2">National ID</label>
                                @Html.TextBoxFor(m => m.IDNumber, new { @class = "w-full p-3 border border-gray-100 rounded-none form-input-focus text-sm bg-gray-50/30", placeholder = "13-Digit Number" })
                                @Html.ValidationMessageFor(m => m.IDNumber)
                            </div>

                            <div>
                                <label class="block text-[10px] uppercase tracking-[2px] font-bold text-gray-400 mb-2">Phone Number</label>
                                @Html.TextBoxFor(m => m.PhoneNumber, new { @class = "w-full p-3 border border-gray-100 rounded-none form-input-focus text-sm bg-gray-50/30", placeholder = "e.g. 0821234567" })
                                @Html.ValidationMessageFor(m => m.PhoneNumber)
                            </div>

                            <div class="col-span-2">
                                <label class="block text-[10px] uppercase tracking-[2px] font-bold text-gray-400 mb-2">Email Address</label>
                                @Html.TextBoxFor(m => m.Email, new { @class = "w-full p-3 border border-gray-100 rounded-none form-input-focus text-sm bg-gray-50/30", placeholder = "you@example.com" })
                                @Html.ValidationMessageFor(m => m.Email)
                            </div>

                        </div>
                    </div>

                    <!-- SECTION 2 — Certification & Permits -->
                    <div class="space-y-8">
                        <p class="text-[10px] uppercase tracking-[4px] font-bold text-[#C21E2E] border-b border-gray-100 pb-2">02. Certification & Permits</p>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                            <div>
                                <label class="block text-[10px] uppercase tracking-[2px] font-bold text-gray-400 mb-2">Licence Number</label>
                                @Html.TextBoxFor(m => m.LicenceNumber, new { @class = "w-full p-3 border border-gray-100 rounded-none form-input-focus text-sm bg-gray-50/30", placeholder = "Code B / EB / C1" })
                                @Html.ValidationMessageFor(m => m.LicenceNumber)
                            </div>

                            <div>
                                <label class="block text-[10px] uppercase tracking-[2px] font-bold text-gray-400 mb-2">Licence Expiry</label>
                                @Html.TextBoxFor(m => m.LicenceExpiryDate, "{0:yyyy-MM-dd}", new { type = "date", @class = "w-full p-3 border border-gray-100 rounded-none form-input-focus text-sm bg-gray-50/30" })
                                @Html.ValidationMessageFor(m => m.LicenceExpiryDate)
                            </div>

                            <div class="col-span-2 pt-2">
                                <label class="flex items-center gap-3 cursor-pointer group">
                                    @Html.CheckBoxFor(m => m.HasPDP, new { @class = "w-4 h-4 accent-[#C21E2E]" })
                                    <span class="text-[11px] uppercase font-bold tracking-[2px] text-gray-400 group-hover:text-gray-900 transition-colors">
                                        Professional Driving Permit (PrDP)
                                    </span>
                                </label>
                            </div>

                        </div>
                    </div>

                    <!-- SECTION 3 — Digital Dossier Attachments -->
                    <div class="space-y-8">
                        <p class="text-[10px] uppercase tracking-[4px] font-bold text-[#C21E2E] border-b border-gray-100 pb-2">03. Digital Dossier Attachments</p>

                        <div class="grid grid-cols-1 gap-4">
                            <div class="dossier-card flex flex-col md:flex-row md:items-center justify-between gap-4">
                                <span class="text-[10px] font-bold uppercase text-gray-400 tracking-widest">Certified Identity Document</span>
                                <input type="file" name="idFile" required class="text-[10px]" />
                            </div>
                            <div class="dossier-card flex flex-col md:flex-row md:items-center justify-between gap-4">
                                <span class="text-[10px] font-bold uppercase text-gray-400 tracking-widest">Valid Driving Licence</span>
                                <input type="file" name="licenceFile" required class="text-[10px]" />
                            </div>
                        </div>
                    </div>

                    <!-- SUBMIT -->
                    <div class="pt-10">
                        <button type="submit" class="w-full bg-[#C21E2E] text-white py-4 font-bold uppercase tracking-[4px] text-[11px] hover:bg-black transition-all shadow-xl active:scale-[0.98]">
                            Submit Formal Application
                        </button>

                        <p class="text-center mt-8 text-gray-400 text-[11px]">
                            Already part of the fleet?
                            <a href="@Url.Action("Login", "Account")" class="text-[#C21E2E] font-bold uppercase tracking-widest ml-2 hover:underline">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                            </a>
                        </p>
                    </div>
                }

                <footer class="mt-20 text-gray-300 text-[9px] uppercase tracking-[4px] text-center md:text-left leading-relaxed">
                    &copy; @DateTime.Now.Year Michaelhouse Logistics & Transport Division.<br />
                    BALGOWAN, KWAZULU-NATAL, SOUTH AFRICA.
                </footer>

            </div>
        </div>
    </div>
</body>
</html>
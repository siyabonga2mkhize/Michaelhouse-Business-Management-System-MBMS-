@model Michaelhouse.Models.DriverApplication
@{
    ViewBag.Title = "Application Details";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Ensures navbar and sidebar appear

    bool isPublic = ViewBag.IsPublicViewer == true;
    bool isPending = Model.Status == "Pending" || string.IsNullOrEmpty(Model.Status) || Model.Status == "Flagged";
    bool isApproved = Model.Status == "Approved";
    bool isRejected = Model.Status == "Rejected";
    string token = Request.QueryString["token"];

    var sessionRole = Session["UserRole"]?.ToString();
    var isAdminOrTransport = (sessionRole == "Admin" || sessionRole == "TransportManager");
}

@if (isAdminOrTransport)
{
    // AI Theme Logic
    string themeColor = Model.AiRecommendation == "APPROVE" ? "#10b981" :
                        Model.AiRecommendation == "REJECT" ? "#ef4444" : "#f59e0b";
    string aiBgClass = Model.AiRecommendation == "APPROVE" ? "bg-green-50/50" :
                       Model.AiRecommendation == "REJECT" ? "bg-red-50/50" : "bg-amber-50/50";

    <div class="mb-10 d-flex justify-content-between align-items-end border-b border-gray-100 pb-8 animate-fade-in">
        <div>
            <div class="flex items-center gap-3 mb-3">
                <span class="bg-[#C21E2E] text-white text-[9px] font-bold uppercase tracking-[3px] px-3 py-1">Secure Dossier</span>
                <span class="text-gray-300">/</span>
                <span class="text-gray-400 text-[10px] uppercase tracking-widest font-bold">Transport File: DRV-@Model.Id</span>
            </div>
            <h2 class="text-5xl font-serif font-bold text-gray-900 tracking-tight">@Model.FullName</h2>
        </div>
        <div class="flex items-center gap-4">
            <span class="px-4 py-2 text-[10px] uppercase tracking-widest font-bold rounded-full
                  @(isApproved ? "bg-green-100 text-green-800 border border-green-200" :
                    isRejected ? "bg-red-100 text-red-800 border border-red-200" :
                    "bg-amber-100 text-amber-800 border border-amber-200")">
                @(Model.Status ?? "Pending Review")
            </span>
        </div>
    </div>

    <div class="row g-5 animate-fade-in">
        @* ─── SIDEBAR: PROFILE & DOCUMENTS ─── *@
        <div class="col-lg-4">
            <div class="space-y-8 sticky top-24">
                <div class="bg-[#FBFBFB] p-8 border border-gray-100 relative overflow-hidden shadow-sm">
                    <i class="bi bi-person-badge absolute -right-4 -top-4 text-black/5 text-7xl"></i>
                    <h5 class="text-[10px] uppercase tracking-[3px] font-bold text-gray-400 mb-8">Applicant Profile</h5>

                    <div class="space-y-6 relative z-10">
                        <div class="border-b border-gray-100 pb-3">
                            <label class="block text-[9px] uppercase font-bold text-gray-300 tracking-widest mb-1">National ID</label>
                            <p class="text-sm font-bold text-gray-800">@Model.IDNumber</p>
                        </div>
                        <div class="border-b border-gray-100 pb-3">
                            <label class="block text-[9px] uppercase font-bold text-gray-300 tracking-widest mb-1">Contact Lead</label>
                            <p class="text-sm font-bold text-gray-800">@Model.PhoneNumber</p>
                            <p class="text-[11px] text-gray-400 tracking-tighter">
                                <a href="mailto:@Model.Email" class="hover:text-[#C21E2E] transition-colors">@Model.Email</a>
                            </p>
                        </div>
                        <div>
                            <label class="block text-[9px] uppercase font-bold text-gray-300 tracking-widest mb-1">Licence Status</label>
                            <p class="text-sm font-bold text-gray-800">No. @Model.LicenceNumber</p>
                            <p class="text-[11px] @(Model.LicenceExpiryDate < DateTime.Now ? "text-red-500 font-bold" : "text-gray-400") tracking-tighter">
                                Exp: @Model.LicenceExpiryDate.ToString("dd MMM yyyy")
                                @(Model.HasPDP ? " | PrDP Valid" : " | No PrDP")
                            </p>
                        </div>
                    </div>
                </div>

                <div>
                    <h5 class="text-[10px] uppercase tracking-[3px] font-bold text-gray-400 mb-4 ps-2">Verification Documents</h5>
                    <div class="space-y-2">
                        @if (Model.Documents != null && Model.Documents.Any())
                        {
                            foreach (var doc in Model.Documents)
                            {
                                <a href="@doc.FilePath" target="_blank"
                                   class="flex items-center justify-between p-4 bg-white border border-gray-100 hover:border-[#C21E2E] hover:shadow-sm transition-all group">
                                    <div>
                                        <p class="text-[10px] font-bold uppercase mb-0 text-gray-700">@doc.DocumentType</p>
                                    </div>
                                    <i class="bi bi-file-earmark-check text-gray-200 group-hover:text-[#C21E2E] transition-colors"></i>
                                </a>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>

        @* ─── MAIN CONTENT: AI REVIEW & ADJUDICATION ─── *@
        <div class="col-lg-8">
            @* AI Review Analysis *@
            <div class="mb-12 relative group">
                <div class="flex items-center gap-2 mb-4">
                    <div class="h-1 w-8 bg-[#C21E2E]"></div>
                    <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-900">Neural Review Analysis</h5>
                </div>

                <div class="relative border border-gray-100 p-10 overflow-hidden @aiBgClass transition-all duration-500 shadow-sm">
                    <div class="absolute inset-0 opacity-[0.04] pointer-events-none"
                         style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 24px 24px;"></div>

                    <i class="bi bi-cpu absolute -right-8 -bottom-12 text-black/5 text-[15rem] rotate-12 transition-transform group-hover:scale-110 duration-1000"></i>

                    <div class="relative z-10">
                        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-10">
                            <div>
                                <span class="text-[9px] uppercase tracking-[3px] font-bold text-gray-400 block mb-2">Automated Recommendation</span>
                                <h4 class="text-2xl font-bold tracking-tighter uppercase" style="color: @themeColor">
                                    <i class="bi bi-robot me-2"></i> @(string.IsNullOrEmpty(Model.AiRecommendation) ? "Processing..." : Model.AiRecommendation)
                                </h4>
                            </div>

                            <div class="md:text-end">
                                <span class="text-[9px] uppercase tracking-[3px] font-bold text-gray-400 block mb-2">System Confidence</span>
                                <div class="flex items-center gap-3">
                                    <div class="h-1.5 w-40 bg-gray-200/50 rounded-full overflow-hidden">
                                        <div class="h-full transition-all duration-1000 delay-300"
                                             style="width: @(Model.AiScore ?? 0)%; background-color: @themeColor"></div>
                                    </div>
                                    <span class="text-xs font-bold text-gray-500">@(Model.AiScore ?? 0)%</span>
                                </div>
                            </div>
                        </div>

                        <div class="relative mb-10">
                            <i class="bi bi-quote absolute -left-8 -top-4 text-gray-200/50 text-5xl"></i>
                            <div class="text-lg leading-relaxed italic font-serif text-gray-700 ps-6 border-l-4"
                                 style="border-color: @themeColor">
                                "@(string.IsNullOrEmpty(Model.AiReviewSummary) ? "Awaiting system processing..." : Model.AiReviewSummary)"
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            @* Final Adjudication Form *@
            @if (isPending)
            {
                <div class="bg-white border border-gray-100 p-10 shadow-sm border-t-4 border-t-gray-900">
                    <h4 class="text-3xl font-serif font-bold text-gray-900 mb-10">Final Adjudication</h4>

                    @using (Html.BeginForm("Review", "DriverApplications", new { id = Model.Id }, FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()
                        <div class="row g-4 mb-10">
                            <div class="col-md-4">
                                <input type="radio" class="btn-check" name="decision" id="dec_approve" value="Approved" required />
                                <label class="w-full py-5 text-center border border-gray-100 cursor-pointer hover:border-green-500 block font-bold uppercase tracking-[2px] text-[10px] transition-all" for="dec_approve">
                                    Approve Driver
                                </label>
                            </div>
                            <div class="col-md-4">
                                <input type="radio" class="btn-check" name="decision" id="dec_flag" value="Flagged" />
                                <label class="w-full py-5 text-center border border-gray-100 cursor-pointer hover:border-amber-500 block font-bold uppercase tracking-[2px] text-[10px] transition-all" for="dec_flag">
                                    Waitlist / Flag
                                </label>
                            </div>
                            <div class="col-md-4">
                                <input type="radio" class="btn-check" name="decision" id="dec_reject" value="Rejected" />
                                <label class="w-full py-5 text-center border border-gray-100 cursor-pointer hover:border-red-500 block font-bold uppercase tracking-[2px] text-[10px] transition-all" for="dec_reject">
                                    Decline Applicant
                                </label>
                            </div>
                        </div>

                        <div class="mb-10">
                            <label class="text-[10px] uppercase font-bold text-gray-400 tracking-widest mb-4 block ps-1">Manager Remarks</label>
                            <textarea name="adminNotes" class="w-full p-5 bg-gray-50 border-0 focus:ring-1 focus:ring-[#C21E2E] outline-none text-md italic font-serif leading-relaxed"
                                      rows="4" placeholder="Enter final remarks (will be shared with the applicant if rejected)...">@Model.AdminNotes</textarea>
                        </div>

                        <button type="submit" class="bg-gray-900 text-white px-16 py-4 font-bold uppercase tracking-[4px] text-[11px] hover:bg-[#C21E2E] transition-all shadow-lg">
                            Seal & Finalize Decision
                        </button>
                    }
                </div>
            }

            @* Post-Approval Actions *@
            @if (isApproved)
            {
                <div class="bg-gray-50 border border-gray-200 p-10 mt-8">
                    <h4 class="text-xl font-serif font-bold text-gray-900 mb-6">Post-Approval Workflow</h4>
                    <div class="flex flex-col md:flex-row gap-4">
                        @using (Html.BeginForm("ScheduleAndSendInterview", "DriverApplications", new { id = Model.Id }, FormMethod.Get, new { @class = "flex-1" }))
                        {
                            <button type="submit" class="w-full py-4 bg-white border border-gray-200 text-gray-900 text-[10px] uppercase font-bold tracking-widest hover:border-blue-500 hover:text-blue-600 transition-all shadow-sm">
                                <i class="bi bi-calendar-event me-2"></i> Schedule Interview
                            </button>
                        }
                        @using (Html.BeginForm("CreateDriverAccount", "DriverApplications", new { id = Model.Id }, FormMethod.Post, new { @class = "flex-1" }))
                        {
                            @Html.AntiForgeryToken()
                            <button type="submit" class="w-full py-4 bg-gray-900 text-white border border-gray-900 text-[10px] uppercase font-bold tracking-widest hover:bg-[#C21E2E] transition-all shadow-sm"
                                    onclick="return confirm('Provision system credentials for this driver?')">
                                <i class="bi bi-person-plus-fill me-2"></i> Provision Account
                            </button>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="max-w-4xl mx-auto px-4 py-10 animate-fade-in">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-6 mb-10 border-b border-gray-100 pb-6">
            <div>
                <p class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400 mb-2">Transport Division</p>
                <h1 class="text-3xl font-serif font-bold text-gray-900 leading-tight">My Application</h1>
            </div>
            <div>
                <span class="px-4 py-2 text-xs font-bold uppercase tracking-wider rounded-full bg-gray-100 text-gray-600">
                    Status: @(Model.Status ?? "Pending")
                </span>
            </div>
        </div>

        @if (isPending)
        {
            <div class="bg-amber-50 border-l-4 border-amber-500 p-4 mb-8">
                <p class="text-amber-800 text-sm font-bold"><i class="bi bi-info-circle me-2"></i>Under Review</p>
                <p class="text-amber-700 text-xs mt-1">Your application is currently being reviewed. We will contact you at <strong>@Model.Email</strong> once a decision is made.</p>
            </div>
        }
        else if (isApproved)
        {
            <div class="bg-green-50 border-l-4 border-green-500 p-4 mb-8">
                <p class="text-green-800 text-sm font-bold"><i class="bi bi-check-circle me-2"></i>Approved!</p>
                <p class="text-green-700 text-xs mt-1">Congratulations! Your application is approved. We will be in touch regarding your interview.</p>
            </div>
        }
        else if (isRejected)
        {
            <div class="bg-red-50 border-l-4 border-red-500 p-4 mb-8">
                <p class="text-red-800 text-sm font-bold"><i class="bi bi-x-circle me-2"></i>Application Unsuccessful</p>
                <p class="text-red-700 text-xs mt-1">Unfortunately, your application was not successful at this time.</p>
                @if (!string.IsNullOrEmpty(Model.AdminNotes))
                {
                    <p class="text-red-700 text-xs mt-2 italic">Note from Admin: "@Model.AdminNotes"</p>
                }
            </div>
        }

        <div class="bg-white border border-gray-100 shadow-sm p-8 mb-6 rounded-sm">
            <h3 class="text-sm font-bold text-[#C21E2E] uppercase tracking-widest mb-6 border-b pb-2">Provided Information</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="text-[10px] text-gray-400 uppercase font-bold">Full Name</label>
                    <p class="font-semibold">@Model.FullName</p>
                </div>
                <div>
                    <label class="text-[10px] text-gray-400 uppercase font-bold">Licence No.</label>
                    <p class="font-semibold">@Model.LicenceNumber</p>
                </div>
                <div>
                    <label class="text-[10px] text-gray-400 uppercase font-bold">Expiry Date</label>
                    <p class="font-semibold">@Model.LicenceExpiryDate.ToString("dd MMM yyyy")</p>
                </div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(token))
        {
            <div class="bg-gray-50 border border-gray-200 p-4 rounded text-center text-xs text-gray-500">
                <p>
                    Save this link to check your status later:
                    <a href="@Url.Action("PublicDetails", "DriverApplications", new { id = Model.Id, token = token }, protocol: Request.Url.Scheme)" class="text-blue-600 underline">Your Unique Application Link</a>
                </p>
            </div>
        }
    </div>
}

<style>
    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }

    .btn-check {
        position: absolute;
        clip: rect(0,0,0,0);
        pointer-events: none;
    }

        .btn-check:checked + label {
            border-color: #1a1a1a !important;
            background: #1a1a1a;
            color: white;
            box-shadow: 0 10px 20px rgba(0,0,0,0.1);
        }

    .animate-fade-in {
        animation: fadeIn 0.8s ease-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>
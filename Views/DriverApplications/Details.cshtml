@if (User.IsInRole("Admin"))
{
    <hr />
    <h4>Admin Actions</h4>
    using (Html.BeginForm("SendInterviewInvitation", "DriverApplications", new { id = Model.Id }, FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-info">Send Interview Invitation Email</button>
    }
    <br />
    using (Html.BeginForm("CreateDriverAccount", "DriverApplications", new { id = Model.Id }, FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-success">Create Driver Account (After Interview)</button>
    }
}   
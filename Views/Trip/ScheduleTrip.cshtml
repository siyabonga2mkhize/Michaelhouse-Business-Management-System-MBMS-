@model List<Michaelhouse.Models.Student>
@{
    var tripRequest = ViewBag.TripRequest as Michaelhouse.Models.TripRequest;
    if (tripRequest == null)
    {
        <div class="alert alert-danger">Trip request not found or has been removed.</div>
        return;
    }
    var selectedGrade = ViewBag.SelectedGrade as int?;
    var selectedSubject = ViewBag.SelectedSubject as int?;
    var grades = ViewBag.Grades as List<int>;
    var subjects = ViewBag.Subjects as List<Michaelhouse.Models.Subject>;
    ViewBag.Title = "Schedule Students for Trip";
}

<h2>Schedule Students for @tripRequest?.Title</h2>

@using (Html.BeginForm("CreateSchedule", "Trip", FormMethod.Post))
{
    @Html.AntiForgeryToken()
    <input type="hidden" name="tripRequestId" value="@ViewBag.TripRequestId" />

    <div class="form-group">
        <label>Scheduled Date</label>
        <input type="date" name="scheduledDate" class="form-control" required
               value="@(tripRequest?.DepartureTime.ToString("yyyy-MM-dd"))" />
        <small class="form-text text-muted">Default is departure date. You can change if needed.</small>
    </div>

    <!-- Filters -->
    <div class="row mb-3">
        <div class="col-md-4">
            <label class="form-label">Filter by Grade</label>
            <select id="gradeFilter" class="form-select">
                <option value="">All Grades</option>
                @foreach (var g in grades ?? new List<int>())
                {
                    <option value="@g" @(selectedGrade == g ? "selected" : "")>Grade @g</option>
                }
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label">Filter by Subject</label>
            <select id="subjectFilter" class="form-select">
                <option value="">All Subjects</option>
                @foreach (var sub in subjects ?? new List<Michaelhouse.Models.Subject>())
                {
                    <option value="@sub.SubjectId" @(selectedSubject == sub.SubjectId ? "selected" : "")>@sub.Name</option>
                }
            </select>
        </div>
        <div class="col-md-4 d-flex align-items-end">
            <button type="button" id="applyFilters" class="btn btn-secondary">Apply Filters</button>
        </div>
    </div>

    <!-- Student List -->
    <div id="studentList">
        @Html.Partial("_StudentCheckboxList", Model)
    </div>

    <button type="submit" class="btn btn-primary mt-3">Create Schedule</button>
}

@section Scripts {
    <script>
        // AJAX reload of student list when filters change
        document.getElementById("applyFilters").addEventListener("click", function () {
            var grade = document.getElementById("gradeFilter").value;
            var subject = document.getElementById("subjectFilter").value;
            var tripRequestId = @tripRequest?.Id;

            var url = '@Url.Action("GetFilteredStudents", "Trip")' +
                '?tripRequestId=' + tripRequestId +
                '&gradeFilter=' + grade +
                '&subjectFilter=' + subject;

            fetch(url)
                .then(response => response.text())
                .then(html => {
                    document.getElementById("studentList").innerHTML = html;
                })
                .catch(err => console.error(err));
        });
    </script>
}
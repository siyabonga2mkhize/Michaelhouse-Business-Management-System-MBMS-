@model List<Michaelhouse.Models.Student>
@{
    var tripRequest = ViewBag.TripRequest as Michaelhouse.Models.TripRequest;
    if (tripRequest == null)
    {
        <div class="flex items-center justify-center h-full w-full">
            <div class="text-center">
                <i class="bi bi-exclamation-triangle text-[#C21E2E] text-6xl mb-4 d-block"></i>
                <h3 class="text-2xl font-serif font-bold text-gray-800 uppercase tracking-widest">Requisition Unavailable</h3>
                <p class="text-sm text-gray-500">This excursion request could not be located in the active registry.</p>
                <a href="@Url.Action("Index")" class="mt-6 inline-block bg-gray-900 text-white px-6 py-2 text-[9px] font-bold uppercase tracking-[2px] hover:bg-[#C21E2E]">Return to Ledger</a>
            </div>
        </div>
        return;
    }

    var selectedGrade = ViewBag.SelectedGrade as int?;
    var selectedSubject = ViewBag.SelectedSubject as int?;
    var grades = ViewBag.Grades as List<int>;
    var subjects = ViewBag.Subjects as List<Michaelhouse.Models.Subject>;
    ViewBag.Title = "Passenger Manifest Configuration";

    var remaining = ViewBag.RemainingCapacity != null ? (int)ViewBag.RemainingCapacity : 0;
    var max = ViewBag.MaxStudents != null ? (int)ViewBag.MaxStudents : 0;
}

@* --- FULL SCREEN VIEWPORT CONTAINER --- *@
<div class="flex flex-col h-full w-full overflow-hidden">

    @* --- INSTITUTIONAL HEADER --- *@
    <div class="mb-8 d-flex justify-content-between align-items-end border-b border-gray-100 pb-6 flex-shrink-0">
        <div>
            <div class="flex items-center gap-2 mb-3">
                <div class="h-[2px] w-8 bg-[#C21E2E]"></div>
                <h5 class="text-[10px] uppercase tracking-[4px] font-bold text-gray-400">Logistics & Transport</h5>
            </div>
            <h2 class="text-5xl font-serif font-bold text-gray-900 tracking-tight">Manifest Configuration</h2>
            <p class="text-[11px] font-mono text-gray-400 uppercase tracking-widest mt-1">Ref: EX-@tripRequest.Id • @tripRequest.Title</p>
        </div>
        <div class="flex gap-3">
            <a href="@Url.Action("Index")" class="inline-block bg-white border border-gray-200 px-6 py-2 text-[9px] font-bold uppercase tracking-[2px] hover:bg-gray-50 transition-all shadow-sm">
                <i class="bi bi-arrow-left me-2"></i> Return to Ledger
            </a>
        </div>
    </div>

    @* --- SCROLLABLE CONTENT AREA --- *@
    <div class="flex-grow min-h-0 overflow-y-auto custom-scrollbar pr-2">
        @using (Html.BeginForm("CreateSchedule", "Trip", FormMethod.Post, new { @class = "h-full" }))
        {
            @Html.AntiForgeryToken()
            <input type="hidden" name="tripRequestId" value="@ViewBag.TripRequestId" />

            <div class="row g-5">

                @* --- LEFT SIDE: CONFIGURATION & FILTERS --- *@
                <div class="col-lg-4">
                    <div class="bg-white shadow-sm border border-gray-100 overflow-hidden relative mb-6">
                        <div class="p-6 border-b border-gray-100 bg-gray-50/50">
                            <h5 class="text-[10px] uppercase tracking-[3px] font-bold text-gray-900 mb-0">01. Departure Parameters</h5>
                        </div>
                        <div class="p-8 space-y-8">

                            @* Capacity Alert Banner *@
                            @if (remaining <= 0)
                            {
                                <div class="bg-red-50 border-l-4 border-[#C21E2E] p-4 text-[#C21E2E]">
                                    <h6 class="text-[10px] font-bold uppercase tracking-[2px] mb-1"><i class="bi bi-x-octagon-fill me-2"></i>Manifest Full</h6>
                                    <p class="text-xs font-serif italic mb-0">Maximum capacity reached. No further additions permitted.</p>
                                </div>
                            }
                            else if (remaining < max)
                            {
                                <div class="bg-amber-50 border-l-4 border-amber-500 p-4 text-amber-700">
                                    <h6 class="text-[10px] font-bold uppercase tracking-[2px] mb-1"><i class="bi bi-exclamation-triangle-fill me-2"></i>Partial Capacity</h6>
                                    <p class="text-xs font-serif italic mb-0"><span class="font-mono font-bold">@remaining</span> out of <span class="font-mono font-bold">@max</span> seats remaining in transport registry.</p>
                                </div>
                            }
                            else
                            {
                                <div class="bg-green-50 border-l-4 border-[#10b981] p-4 text-green-700">
                                    <h6 class="text-[10px] font-bold uppercase tracking-[2px] mb-1"><i class="bi bi-check-circle-fill me-2"></i>Maximum Availability</h6>
                                    <p class="text-xs font-serif italic mb-0">Registry open. Maximum transport limit: <span class="font-mono font-bold">@max</span> pax.</p>
                                </div>
                            }

                            <div>
                                <label class="text-[9px] uppercase font-bold text-gray-400 mb-2 block">Scheduled Departure Date</label>
                                <input type="date" name="scheduledDate" class="w-full border-b-2 border-gray-100 py-2 outline-none focus:border-[#C21E2E] font-mono text-sm text-gray-900 transition-colors" required
                                       value="@(tripRequest.DepartureTime.ToString("yyyy-MM-dd"))" />
                                <small class="text-[9px] text-gray-400 mt-2 block font-serif italic">Defaults to requested date. Adjust if logistics dictate otherwise.</small>
                            </div>

                            <div class="border-t border-gray-50 pt-6">
                                <h6 class="text-[10px] uppercase font-bold text-gray-400 mb-4 tracking-[2px]">Filter Student Registry</h6>

                                <div class="space-y-4">
                                    <div>
                                        <select id="gradeFilter" class="w-full border-b-2 border-gray-100 py-2 outline-none focus:border-[#C21E2E] text-sm font-serif italic text-gray-700">
                                            <option value="">-- All Academic Grades --</option>
                                            @foreach (var g in grades ?? new List<int>())
                                            {
                                                <option value="@g" @((selectedGrade == g) ? "selected=\"selected\"" : "")>Grade @g</option>
                                            }
                                        </select>
                                    </div>
                                    <div>
                                        <select id="subjectFilter" class="w-full border-b-2 border-gray-100 py-2 outline-none focus:border-[#C21E2E] text-sm font-serif italic text-gray-700">
                                            <option value="">-- All Subject Clusters --</option>
                                            @foreach (var sub in subjects ?? new List<Michaelhouse.Models.Subject>())
                                            {
                                                <option value="@sub.SubjectId" @((selectedSubject == sub.SubjectId) ? "selected=\"selected\"" : "")>@sub.Name</option>
                                            }
                                        </select>
                                    </div>
                                    <button type="button" id="applyFilters" class="w-full bg-gray-900 text-white py-3 text-[9px] font-bold uppercase tracking-[2px] hover:bg-[#C21E2E] transition-all mt-2">
                                        Apply Filters
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                @* --- RIGHT SIDE: STUDENT MANIFEST --- *@
                <div class="col-lg-8">
                    <div class="bg-white shadow-sm border border-gray-100 overflow-hidden relative mb-6 flex flex-col">

                        @* Archival Dot Grid Header with Controls *@
                        <div class="p-6 border-b border-gray-100 d-flex justify-content-between align-items-center relative bg-white overflow-hidden">
                            <div class="absolute inset-0 opacity-[0.05] pointer-events-none"
                                 style="background-image: radial-gradient(#000 1px, transparent 1px); background-size: 20px 20px;"></div>

                            <div class="relative z-10">
                                <h5 class="text-xs uppercase tracking-[4px] font-bold text-gray-900 mb-0">02. Passenger Selection</h5>
                            </div>

                            <div class="relative z-10 flex gap-2">
                                <button type="button" id="selectAllBtn" class="bg-white border border-green-500 text-green-700 px-4 py-2 text-[9px] font-bold uppercase tracking-[2px] hover:bg-green-50 transition-all shadow-sm">
                                    <i class="bi bi-check-all me-1"></i> Select All
                                </button>
                                <button type="button" id="clearAllBtn" class="bg-white border border-gray-300 text-gray-500 px-4 py-2 text-[9px] font-bold uppercase tracking-[2px] hover:bg-gray-100 transition-all shadow-sm">
                                    <i class="bi bi-eraser me-1"></i> Clear
                                </button>
                            </div>
                        </div>

                        @* Dynamic Partial View Container *@
                        <div class="p-6 bg-gray-50/30 border-b border-gray-100 min-h-[300px]">
                            <div id="studentList">
                                @Html.Partial("_StudentCheckboxList", Model)
                            </div>
                        </div>

                        @* Footer Controls *@
                        <div class="p-6 bg-[#1a1a1a] text-white flex justify-between items-center">
                            <div id="capacityMessage" class="text-[10px] uppercase font-bold tracking-[2px] text-gray-400 font-mono">
                                Calculating manifest capability...
                            </div>
                            <button type="submit" class="bg-[#C21E2E] text-white px-8 py-3 text-[10px] font-bold uppercase tracking-[3px] hover:bg-white hover:text-[#C21E2E] transition-all shadow-xl">
                                <i class="bi bi-shield-check me-2"></i> Authorize Manifest
                            </button>
                        </div>
                    </div>
                </div>

            </div>
        }
    @{
        var existingSchedule = ViewBag.ExistingSchedule as Michaelhouse.Models.TripSchedule;
    }

    @if (existingSchedule != null)
    {
        <div class="mt-6 text-center">
            <a href="@Url.Action("GenerateQRCodes", "Trip", new { scheduleId = existingSchedule.Id })"
               class="inline-block bg-[#C21E2E] text-white px-8 py-3 text-[10px] font-bold uppercase tracking-[3px] hover:bg-gray-900 transition-all shadow-xl">
                <i class="bi bi-qr-code me-2"></i> Generate Student QR Codes
            </a>
        </div>
    }
    </div>
</div>

<style>
    .font-serif {
        font-family: 'Playfair Display', serif !important;
    }

    .font-mono {
        font-family: 'Source Code Pro', monospace !important;
    }

    /* Internal scrollbar custom styling */
    .custom-scrollbar::-webkit-scrollbar {
        width: 5px;
    }

    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #eee;
        border-radius: 10px;
    }

        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #C21E2E;
        }
</style>

@section Scripts {
    <script>
        // Helper to refresh event listeners after student list updates
        function attachCheckboxHandlers() {
            var checkboxes = document.querySelectorAll('#studentList input[type="checkbox"]');
            checkboxes.forEach(function(cb) {
                cb.removeEventListener('change', enforceLimit);
                cb.addEventListener('change', enforceLimit);
            });
            updateCapacityMessage();
        }

        // Select All (up to remaining capacity)
        function selectAll() {
            var checkboxes = document.querySelectorAll('#studentList input[type="checkbox"]');
            var alreadyChecked = document.querySelectorAll('#studentList input[type="checkbox"]:checked').length;
            var remainingSeats = remaining - alreadyChecked;
            var selected = 0;
            for (var i = 0; i < checkboxes.length && selected < remainingSeats; i++) {
                if (!checkboxes[i].checked) {
                    checkboxes[i].checked = true;
                    selected++;
                }
            }
            updateCapacityMessage();
            if (selected < (checkboxes.length - alreadyChecked) && selected === remainingSeats) {
                alert('Only ' + remainingSeats + ' more student(s) could be selected due to trip capacity.');
            }
        }

        // Clear All
        function clearAll() {
            var checkboxes = document.querySelectorAll('#studentList input[type="checkbox"]');
            checkboxes.forEach(function(cb) {
                cb.checked = false;
            });
            updateCapacityMessage();
        }

        // AJAX reload of student list when filters change
        document.getElementById("applyFilters").addEventListener("click", function () {
            var grade = document.getElementById("gradeFilter").value;
            var subject = document.getElementById("subjectFilter").value;
            var tripRequestId = @(tripRequest?.Id ?? 0);

            var url = '@Url.Action("GetFilteredStudents", "Trip")' +
                '?tripRequestId=' + tripRequestId +
                '&gradeFilter=' + grade +
                '&subjectFilter=' + subject;

            // Optional loading state
            document.getElementById("studentList").innerHTML = '<div class="text-center py-10 text-gray-400 font-serif italic"><i class="bi bi-arrow-repeat animate-spin me-2"></i> Querying Registry...</div>';

            fetch(url)
                .then(response => response.text())
                .then(html => {
                    document.getElementById("studentList").innerHTML = html;
                    attachCheckboxHandlers(); // re-attach after AJAX
                })
                .catch(err => console.error(err));
        });

        // Capacity & limit enforcement
        var remaining = @remaining;
        var max = @max;
        var capacityMsg = document.getElementById('capacityMessage');

        function updateCapacityMessage() {
            var selected = document.querySelectorAll('#studentList input[type="checkbox"]:checked').length;
            var left = remaining - selected;
            if (left < 0) left = 0;
            if (remaining === max) {
                capacityMsg.innerHTML = '<span class="text-white">' + selected + '</span> of ' + max + ' allocated. Capacity remaining: <span class="text-white">' + left + '</span>.';
            } else {
                capacityMsg.innerHTML = '<span class="text-white">' + selected + '</span> new additions. Remaining allowance: <span class="text-white">' + left + '</span> (Limit: ' + max + ').';
            }
        }

        function enforceLimit(event) {
            var selected = document.querySelectorAll('#studentList input[type="checkbox"]:checked').length;
            if (selected > remaining) {
                event.target.checked = false;
                alert('Maximum vehicle threshold reached. Cannot exceed ' + remaining + ' additional student(s).');
            }
            updateCapacityMessage();
        }

        // Attach handlers initially
        attachCheckboxHandlers();

        // Button events
        document.getElementById("selectAllBtn").addEventListener("click", selectAll);
        document.getElementById("clearAllBtn").addEventListener("click", clearAll);
    </script>
}
@{
    Layout = null;
    int scheduleId = ViewBag.ScheduleId;
    string type = ViewBag.Type;          // "before" or "after"
    string title = ViewBag.Title;
    string instruction = ViewBag.Instruction;
}
<!DOCTYPE html>
<html>
<head>
    <title>@title</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        body {
            background: #f8f9fa;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .scanner-container {
            max-width: 500px;
            margin: 2rem auto;
        }

        #qr-reader {
            width: 100%;
        }

        #status-message {
            margin-top: 1rem;
            font-size: 0.9rem;
        }

        .btn-back {
            margin-top: 1.5rem;
        }
    </style>
</head>
<body>
    <div class="container scanner-container text-center">
        <div class="card shadow">
            <div class="card-body">
                <h3><i class="bi bi-qr-code-scan"></i> @title</h3>
                <p class="text-muted">@instruction</p>
                <p class="small text-warning"><i class="bi bi-info-circle"></i> Hold the student's QR code in front of the camera. After each successful scan, the student will be marked.</p>

                <div id="qr-reader"></div>
                <div id="status-message" class="text-success"></div>

                <a href="@Url.Action("Manifest", "Trip", new { scheduleId = scheduleId })" class="btn btn-secondary btn-back">
                    <i class="bi bi-arrow-left"></i> Back to Manifest
                </a>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/html5-qrcode@2.3.8/dist/html5-qrcode.min.js"></script>
    <script>
        const origin = window.location.origin;

        function onScanSuccess(decodedText, decodedResult) {
            // The QR code should contain a URL to /Trip/MarkAttendance?token=...
            if (decodedText.startsWith(origin + "/Trip/MarkAttendance")) {
                // Mark the student by opening the URL in a new tab or the same window?
                // We'll use fetch to silently mark, but the existing MarkAttendance redirects to a success page.
                // To keep the scanner open, we can call the URL via fetch and show a message.
                fetch(decodedText, { method: 'GET', credentials: 'same-origin' })
                    .then(response => {
                        if (response.ok) {
                            document.getElementById("status-message").innerHTML = '<i class="bi bi-check-circle-fill"></i> Attendance recorded! Ready for next student.';
                            setTimeout(() => document.getElementById("status-message").innerHTML = '', 2000);
                        } else {
                            document.getElementById("status-message").className = "text-danger";
                            document.getElementById("status-message").innerHTML = '<i class="bi bi-exclamation-triangle"></i> Failed. Maybe already scanned or invalid token.';
                            setTimeout(() => {
                                document.getElementById("status-message").className = "text-success";
                                document.getElementById("status-message").innerHTML = '';
                            }, 3000);
                        }
                    })
                    .catch(err => {
                        console.error(err);
                        document.getElementById("status-message").className = "text-danger";
                        document.getElementById("status-message").innerHTML = '<i class="bi bi-exclamation-triangle"></i> Network error.';
                    });
            } else {
                alert("Invalid QR code – not an attendance code.");
            }
        }

        function onScanError(error) {
            // ignore, keep scanning
        }

        const html5QrcodeScanner = new Html5QrcodeScanner("qr-reader", { fps: 10, qrbox: 250, rememberLastUsedCamera: true });
        html5QrcodeScanner.render(onScanSuccess, onScanError);
    </script>
</body>
</html>
@model List<Michaelhouse.Models.Student>
@{
    Layout = null;
    var scheduleId = ViewBag.ScheduleId;
}
<!DOCTYPE html>
<html>
<head>
    <title>Attendance Check‑In</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
    <div class="container py-5">
        <div class="card shadow mx-auto" style="max-width: 400px;">
            <div class="card-body text-center">
                <h3 class="card-title">Excursion Check‑In</h3>
                <p class="text-muted">Select your name to mark attendance</p>

                <select id="studentSelect" class="form-select mb-3">
                    <option value="">-- Choose your name --</option>
                    @foreach (var s in Model)
                    {
                        <option value="@s.StudentId">@s.FirstName @s.LastName</option>
                    }
                </select>

                <div class="btn-group w-100">
                    <button onclick="markAttendance('before')" class="btn btn-primary">Departure</button>
                    <button onclick="markAttendance('after')" class="btn btn-success">Return</button>
                </div>

                <div id="result" class="mt-3"></div>
            </div>
        </div>
    </div>

    <script>
        function markAttendance(type) {
            var studentId = document.getElementById("studentSelect").value;
            if (!studentId) {
                alert("Please select your name.");
                return;
            }
            fetch('@Url.Action("MarkAttendanceByStudent", "Trip")', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ scheduleId: @scheduleId, studentId: parseInt(studentId), type: type })
            })
            .then(response => response.json())
            .then(data => {
                document.getElementById("result").innerHTML = '<div class="alert alert-success">' + data.message + '</div>';
            })
            .catch(err => {
                document.getElementById("result").innerHTML = '<div class="alert alert-danger">Error. Try again.</div>';
            });
        }
    </script>
</body>
</html>
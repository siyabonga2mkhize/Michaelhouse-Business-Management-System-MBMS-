@model IEnumerable<Michaelhouse.Models.Student>

@{
    ViewBag.Title = "Class List";
}

<div class="container mt-4">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="@Url.Action("Index")">All Classes</a></li>
            <li class="breadcrumb-item active">@ViewBag.ClassName</li>
        </ol>
    </nav>

    <div class="card shadow-sm">
        <div class="card-header bg-info text-white d-flex justify-content-between align-items-center">
            <h4 class="mb-0">
                <i class="bi bi-people-fill me-2"></i>Students in @ViewBag.ClassName
            </h4>
            <span class="badge bg-light text-dark">Total: @Model.Count()</span>
        </div>
        <div class="card-body">
            @if (!Model.Any())
            {
                <div class="alert alert-warning">
                    No students are currently assigned to this class.
                    Go to the <strong>Students</strong> section to assign them.
                </div>
            }
            else
            {
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>Student Name</th>
                            <th>Gender</th>
                            <th>Grade Level</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var student in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@student.LastName</strong>, @student.FirstName
                                </td>
                                <td>@student.Gender</td>
                                <td>@student.GradeLevel</td>
                                <td class="text-end">
                                    <a href="@Url.Action("Details", "Students", new { id = student.StudentId })"
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i> Profile
                                    </a>
                                    <a href="@Url.Action("Edit", "Students", new { id = student.StudentId })"
                                       class="btn btn-sm btn-outline-secondary">
                                        <i class="bi bi-pencil"></i> Edit
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
        <div class="card-footer bg-white">
            <a href="@Url.Action("Index")" class="btn btn-secondary">Back to Classes</a>
        </div>
    </div>
</div>
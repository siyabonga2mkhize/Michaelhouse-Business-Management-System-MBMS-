@model Michaelhouse.Models.SchoolClass

@{
    ViewBag.Title = "Create New Class";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow border-primary">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-door-open-fill me-2"></i>Add New Class</h4>
                </div>
                <div class="card-body">
                    @using (Html.BeginForm())
                    {
                        @Html.AntiForgeryToken()
                        @Html.ValidationSummary(true, "", new { @class = "text-danger" })

                        <div class="mb-3">
                            @Html.LabelFor(model => model.ClassName, "Class Name (e.g., Grade 12A)", new { @class = "form-label fw-bold" })
                            @Html.EditorFor(model => model.ClassName, new { htmlAttributes = new { @class = "form-control", placeholder = "Enter class name..." } })
                            @Html.ValidationMessageFor(model => model.ClassName, "", new { @class = "text-danger" })
                        </div>

                        <div class="mb-3">
                            @Html.LabelFor(model => model.GradeLevel, "Grade Level", new { @class = "form-label fw-bold" })
                            @Html.EditorFor(model => model.GradeLevel, new { htmlAttributes = new { @class = "form-control", type = "number", min = "8", max = "12" } })
                            @Html.ValidationMessageFor(model => model.GradeLevel, "", new { @class = "text-danger" })
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between">
                            @Html.ActionLink("Back to List", "Index", null, new { @class = "btn btn-outline-secondary" })
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-save me-1"></i> Save Class
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>